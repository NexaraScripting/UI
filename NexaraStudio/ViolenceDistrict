local currentVisualCategory = "Survivor"
local categoryButtons = {}
local isInitialCategorySelect = true

local visualCategories = {
    { Id = "Survivor", Name = "Survivor" },
    { Id = "Killer", Name = "Killer" },
    { Id = "Objectives", Name = "Objectives" },
    { Id = "World", Name = "World" },
}

local function selectVisualCategory(catId)
    currentVisualCategory = catId

    local showSurv = (catId == "Survivor")
    local showKiller = (catId == "Killer")
    local showObj = (catId == "Objectives")
    local showWorld = (catId == "World")

    secSurv1.Box.Visible = showSurv
    secSurv2.Box.Visible = showSurv
    secSurvCam.Box.Visible = showSurv
    secSurvSkill.Box.Visible = showSurv

    secKiller1.Box.Visible = showKiller
    secKiller2.Box.Visible = showKiller

    secObj1.Box.Visible = showObj
    secObj2.Box.Visible = showObj

    secWorld1.Box.Visible = showWorld

    for _, btnData in ipairs(categoryButtons) do
        local isSelected = (btnData.Id == catId)
        if isSelected then
            TweenService:Create(btnData.Button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.45,
                TextColor3 = Window.Theme.Text
            }):Play()
            btnData.Indicator.Visible = true
            if not isInitialCategorySelect then
                btnData.Indicator.Size = UDim2.new(0, 0, 0, 2)
            end
            TweenService:Create(btnData.Indicator, TweenInfo.new(0.24, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                Size = UDim2.new(0.7, 0, 0, 2)
            }):Play()
        else
            TweenService:Create(btnData.Button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1,
                TextColor3 = Window.Theme.SubText
            }):Play()
            if btnData.Indicator.Visible then
                local shrinkTw = TweenService:Create(btnData.Indicator, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 2)
                })
