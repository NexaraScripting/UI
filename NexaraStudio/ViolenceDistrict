                                    hl.OutlineColor = cCol
                                end
                            end
                            hl.FillTransparency = 1 - (0.25 * effGenChams)
                            hl.OutlineTransparency = 1 - (0.60 * effGenChams)
                            if not hl.Enabled then hl.Enabled = true end
