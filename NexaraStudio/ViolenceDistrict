-- ======== AUTO SKILL CHECK (100% Great Zone + Generator / Healing / Bear Trap Support) ========
do
local skillCheckTriggered = false
local lastTriggeredGoalRot = nil
local lastLineRot = nil

local function StepAutoSkillCheck()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if not pg then return end
        local scPrompt = pg:FindFirstChild("SkillCheckPromptGui") or pg:FindFirstChild("SkillCheckPromptGui-con")
        local check = scPrompt and scPrompt:FindFirstChild("Check")
        if check and check.Visible then
            local line = check:FindFirstChild("Line")
            if not line then return end

            -- Resolve active goal: Bear Trap uses TrapGoal/TrapPerfect, Generators & Healing use Goal
            local trapGoal = check:FindFirstChild("TrapGoal")
            local trapPerf = check:FindFirstChild("TrapPerfect")
            local stdGoal = check:FindFirstChild("Goal")

            local activeGoal = nil
            if trapGoal and trapGoal.Visible then
                activeGoal = trapGoal
            elseif trapPerf and trapPerf.Visible then
                activeGoal = trapPerf
            elseif stdGoal and stdGoal.Visible then
                activeGoal = stdGoal
            else
                activeGoal = stdGoal or trapGoal or trapPerf
            end

            if activeGoal then
                local gRot = activeGoal.Rotation
                local lRot = line.Rotation

                -- Reset trigger lock if needle wraps or goal jumps to a new angle (KingScourge / Merciless / Trap continuous checks)
                if lastTriggeredGoalRot ~= nil and math.abs(gRot - lastTriggeredGoalRot) > 0.5 then
                    skillCheckTriggered = false
                end
                if lastLineRot ~= nil and (lRot < lastLineRot - 15) then
                    skillCheckTriggered = false
                end
                lastLineRot = lRot

                local diff = (lRot - gRot) % 360
                local isGreat = (diff >= 103.0 and diff <= 115.0) or (lRot >= gRot + 103.0 and lRot <= gRot + 115.0)

                if isGreat and not skillCheckTriggered then
                    skillCheckTriggered = true
                    lastTriggeredGoalRot = gRot
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.spawn(function()
                        task.wait(0.015)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                    end)
                end
            end
        else
            skillCheckTriggered = false
            lastTriggeredGoalRot = nil
            lastLineRot = nil
        end
end

