    pcall(function()
        local remItems = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Items")
        local remFl = remItems and remItems:FindFirstChild("Flashlight")
        local gotBlinded = remFl and remFl:FindFirstChild("GotBlinded")
        if gotBlinded and gotBlinded:IsA("RemoteEvent") then
            table.insert(ScriptConnections, gotBlinded.OnClientEvent:Connect(function()
                if Config.BlindProgressEnabled then
                    blindProgress = 1
                    blindHoldUntil = os.clock() + 1.0
                end
            end))
        end
