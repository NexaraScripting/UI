local function IsPalletDropped(model, prim)
    if not model or BrokenPallets[model] then return false end
    if DroppedPallets[model] then return true end
    if model:GetAttribute("Dropped") == true or model:GetAttribute("isDropped") == true or model:GetAttribute("isdropped") == true or model:GetAttribute("State") == "Dropped" then
        DroppedPallets[model] = true
        return true
    end
    local pPart = prim or model.PrimaryPart or model:FindFirstChild("PrimaryPartPallet") or model:FindFirstChildWhichIsA("BasePart")
    if pPart and math.abs(pPart.CFrame.UpVector.Y) < 0.45 then
        DroppedPallets[model] = true
        return true
    end
    return false
end

local function KillerHasContainment()
    for _, p in ipairs(Players:GetPlayers()) do
        if IsKiller(p) then
            local perks = (CachedPlayerData[p] and CachedPlayerData[p].Perks) or GetPlayerPerks(p)
            for _, perk in ipairs(perks) do
                local clean = tostring(perk):lower():gsub("%s+", ""):gsub("[^%a]", "")
                if clean:find("containment") or clean:find("bamboozle") then
                    return true, 16
                end
            end
            local char = p.Character
            if char then
                for _, s in ipairs(char:GetChildren()) do
                    local sn = s.Name:lower():gsub("%s+", "")
                    if sn:find("containment") or sn:find("bamboozle") then
                        return true, 16
                    end
                end
            end
            for _, attrName in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "containment", "Containment"}) do
                local val = tostring(p:GetAttribute(attrName) or (char and char:GetAttribute(attrName)) or ""):lower()
                if val:find("containment") or val:find("bamboozle") or val == "true" then
                    return true, 16
                end
            end
        end
    end
    if IsKiller(LocalPlayer) then
        local char = LocalPlayer.Character
        if char then
            for _, s in ipairs(char:GetChildren()) do
                local sn = s.Name:lower():gsub("%s+", "")
                if sn:find("containment") or sn:find("bamboozle") then
                    return true, 16
                end
            end
        end
        return false, 0
    end
    return false, 0
end

local function FindNearestWindow(posOrPart)
    local targetPos = nil
    if typeof(posOrPart) == "Instance" then
        if posOrPart:IsA("BasePart") then
            targetPos = posOrPart.Position
        elseif posOrPart:IsA("Model") then
            local prim = posOrPart.PrimaryPart or posOrPart:FindFirstChildWhichIsA("BasePart") or posOrPart:GetPivot()
            targetPos = typeof(prim) == "CFrame" and prim.Position or (prim and prim.Position)
        end
    elseif typeof(posOrPart) == "Vector3" then
        targetPos = posOrPart
    elseif typeof(posOrPart) == "CFrame" then
        targetPos = posOrPart.Position
    end

    if not targetPos then return nil, nil end

    local bestWin = nil
    local bestPart = nil
    local bestDist = 18.0
    for _, item in ipairs(CachedWindows) do
        local win = item.Model or item.Part
        local root = item.VaultLedge or item.Part
        if root and root.Parent then
            local d = (root.Position - targetPos).Magnitude
            if d < bestDist then
                bestDist = d
                bestWin = win
                bestPart = root
            end
        end
    end
    return bestWin, bestPart
end

local function MarkWindowBlocked(posOrPart, duration)
    local dur = tonumber(duration) or 16
    local exp = os.clock() + dur
    local targetPos = nil

    if typeof(posOrPart) == "Vector3" then
        targetPos = posOrPart
    elseif typeof(posOrPart) == "CFrame" then
        targetPos = posOrPart.Position
    elseif typeof(posOrPart) == "Instance" then
        if posOrPart:IsA("BasePart") then
            targetPos = posOrPart.Position
        elseif posOrPart:IsA("Model") then
            local p = posOrPart.PrimaryPart or posOrPart:FindFirstChildWhichIsA("BasePart") or posOrPart:GetPivot()
            targetPos = typeof(p) == "CFrame" and p.Position or (p and p.Position)
        end
        BlockedWindows[posOrPart] = exp
        if posOrPart.Parent and posOrPart.Parent:IsA("Model") then
            BlockedWindows[posOrPart.Parent] = exp
        end
    end

    local win, part = FindNearestWindow(posOrPart)
    if win then BlockedWindows[win] = exp end
    if part then BlockedWindows[part] = exp end
    if targetPos then
        table.insert(BlockedWindowPositions, { Pos = targetPos, Expire = exp })
    end
    if part and part.Position then
        table.insert(BlockedWindowPositions, { Pos = part.Position, Expire = exp })
    end
end

local function OnKillerVault(cfOrPart, maybePart)
    local hasCont, dur = KillerHasContainment()
    if hasCont then
        local target = maybePart or cfOrPart
        MarkWindowBlocked(target, dur > 0 and dur or 16)
    end
end

local function GetWindowBlockTime(win, rootPart, ledgePart)
    local now = os.clock()
    -- 1. Direct instance checks
    if win and BlockedWindows[win] and BlockedWindows[win] > now then
        return true, BlockedWindows[win] - now
    end
    if rootPart and BlockedWindows[rootPart] and BlockedWindows[rootPart] > now then
        return true, BlockedWindows[rootPart] - now
    end
    if ledgePart and BlockedWindows[ledgePart] and BlockedWindows[ledgePart] > now then
        return true, BlockedWindows[ledgePart] - now
    end

    -- 2. Spatial coordinate proximity check (matches regardless of model pointer or re-cache)
    local checkPos = (ledgePart and ledgePart.Position) or (rootPart and rootPart.Position)
    if checkPos then
        for i = #BlockedWindowPositions, 1, -1 do
            local entry = BlockedWindowPositions[i]
            if entry.Expire <= now then
                table.remove(BlockedWindowPositions, i)
            elseif (entry.Pos - checkPos).Magnitude < 8.0 then
                return true, entry.Expire - now
            end
        end
    end

    -- 3. Game CollectionService tag "Blocked"
    local cs = game:GetService("CollectionService")
    if (win and cs:HasTag(win, "Blocked")) or (rootPart and cs:HasTag(rootPart, "Blocked")) or (ledgePart and cs:HasTag(ledgePart, "Blocked")) then
        return true, 16
    end

    -- 4. In-game attributes
    local attr = (win and (win:GetAttribute("Blocked") or win:GetAttribute("IsBlocked"))) or (rootPart and rootPart:GetAttribute("Blocked"))
    if attr == true then
        return true, 16
    elseif type(attr) == "number" and attr > now then
        return true, attr - now
    end

    return false, 0
end

