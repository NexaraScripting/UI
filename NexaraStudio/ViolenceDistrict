        if item and item ~= "None" and item ~= "" then
            PlayerItemCache[player] = item
        elseif not IsInLobby() and PlayerItemCache[player] and not IsKiller(player) then
            item = PlayerItemCache[player]
        else
            item = nil
        end

        local isItemReady, qtyStr = true, ""
        if item and item ~= "None" and item ~= "" then
            local itemInst = char:FindFirstChild(item) or (bp and bp:FindFirstChild(item))
            if not itemInst then
                for _, c in ipairs(char:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end
            if not itemInst and bp then
                for _, c in ipairs(bp:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end

            local uses = itemInst and (itemInst:GetAttribute("uses") or itemInst:GetAttribute("Uses") or itemInst:GetAttribute("charges") or itemInst:GetAttribute("Charges") or itemInst:GetAttribute("charge") or itemInst:GetAttribute("Charge"))
            local maxUses = itemInst and (itemInst:GetAttribute("MaxUses") or itemInst:GetAttribute("maxUses") or itemInst:GetAttribute("MaxCharges") or itemInst:GetAttribute("maxCharges"))
            local rem = itemInst and (itemInst:GetAttribute("remaining") or itemInst:GetAttribute("Remaining"))
            if not rem and itemInst and (item == "Flashlight" or item:find("Flashlight")) then
                local arm = itemInst:FindFirstChild("Right Arm") or itemInst:FindFirstChild("RightHand")
                local flInner = (arm and arm:FindFirstChild("Flashlight")) or itemInst:FindFirstChild("Flashlight", true)
                if flInner then
                    rem = flInner:GetAttribute("remaining") or flInner:GetAttribute("Remaining")
                end
            end

            local usesNum, maxUsesNum = tonumber(uses), tonumber(maxUses)
            if item == "Twist of Fate" or item:find("Twist") then
                local shots = itemInst and itemInst:GetAttribute("shots")
                local maxShots = itemInst and itemInst:GetAttribute("MaxShots") or 3
                local tofState = itemInst and itemInst:GetAttribute("tofState")
                local sCount = tonumber(shots) or (tofState == "cooldown" and 0 or 3)
                qtyStr = string.format(" [%d/%d]", sCount, maxShots)
            elseif usesNum then
                if item == "Bandage" or item:find("Bandage") then
                    local pct = math.clamp(math.floor((usesNum / 20.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif maxUsesNum then
                    qtyStr = string.format(" [%d/%d]", usesNum, maxUsesNum)
                else
                    qtyStr = string.format(" [%d uses]", usesNum)
                end
            elseif rem and tonumber(rem) then
                local remNum = tonumber(rem)
                if item == "Flashlight" or item:find("Flashlight") then
                    local pct = math.clamp(math.floor((remNum / 20.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif remNum > 0 then
                    qtyStr = string.format(" (%.1fs)", remNum)
                end
            end

            local cdSec = GetItemCooldown(player, item)
            if (item == "Twist of Fate" or item:find("Twist")) and itemInst then
                local tofState = itemInst:GetAttribute("tofState")
                local tofDur = tonumber(itemInst:GetAttribute("tofStateDur")) or 80
                local tofStart = tonumber(itemInst:GetAttribute("tofStateStart")) or 0
                if tofState == "cooldown" then
                    local remTof = math.max(0, math.ceil(tofDur - (workspace:GetServerTimeNow() - tofStart)))
                    if remTof > 0 then cdSec = remTof end
                end
            end
            local itemStr = "Item: " .. item .. qtyStr

            if cdSec > 0 then
                isItemReady = false
                itemStr = itemStr .. string.format(" (CD %ds)", cdSec)
            elseif (rem and tonumber(rem) and tonumber(rem) <= 0) or (uses and tonumber(uses) and tonumber(uses) <= 0) then
                isItemReady = false
                itemStr = itemStr .. " [Empty]"
            else
                isItemReady = true
            end
            table.insert(details, itemStr)
        else
            isItemReady = nil
        end

        local otherDetails = {}
        if player == LocalPlayer then
            local debuff = player.PlayerGui:FindFirstChild("Survivor") and player.PlayerGui.Survivor:FindFirstChild("statuseffects") and player.PlayerGui.Survivor.statuseffects:FindFirstChild("Debuff")
            local winded = debuff and debuff:FindFirstChild("Winded")
            if winded and winded.Visible then
                table.insert(details, "Exhausted")
                table.insert(otherDetails, "Exhausted")
            end
        end

        -- Only show Wiggle if they are ACTUALLY being carried by the killer!
        local isCarried = char:GetAttribute("IsCarried") or char:GetAttribute("BeingCarried") or char:GetAttribute("IsBeingCarried")
        if isCarried then
            local carryTime = tonumber(char:GetAttribute("RemainingCarryTime"))
            if carryTime and carryTime > 0 then
                local wStr = string.format("Wiggling: %.1fs", carryTime)
                table.insert(details, wStr)
                table.insert(otherDetails, wStr)
            end
        end

        -- Only show Hook % if actually hooked
        local isHooked = char:GetAttribute("IsHooked") or char:GetAttribute("HookProgressDepleting")
        local hookProg = tonumber(char:GetAttribute("HookedProgress"))
        if isHooked and hookProg and hookProg < 100 then
            local hStr = string.format("Hook: %d%%", math.floor(hookProg))
            table.insert(details, hStr)
            table.insert(otherDetails, hStr)
        end

        local otherStr = #otherDetails > 0 and table.concat(otherDetails, " | ") or nil
        return (#details > 0 and table.concat(details, " | ") or nil), isItemReady, item, qtyStr, otherStr
    end
end
end

-- ======== BACKGROUND DATA CACHING (PREVENTS ESP STUTTER & LAG) ========
local _PruneDeadDrawings = nil
CachedPlayerData = {}
local CachedGenerators = {}
local CachedPallets = {}
local CachedWindows = {}
local CachedGates = {}
local lastMapScan = 0

-- Objective & World State Tracking & Cleanup
local GenDrawings = {}
local PalletDrawings = {}
local WindowDrawings = {}
local GateDrawings = {}
local TrapDrawings = {}
local GenAuras = {}
local PalletAuras = {}
local WindowAuras = {}
local WindowAdornments = {}
local TrapAuras = {}
local DroppedPallets = {}
local BrokenPallets = {}

local function MarkPalletBroken(model)
    if not model then return end
    BrokenPallets[model] = true
    DroppedPallets[model] = nil
    local hl = PalletAuras[model]
    if hl then
        pcall(function()
            hl.Enabled = false
            hl:Destroy()
        end)
        PalletAuras[model] = nil
    end
    local txt = PalletDrawings[model]
    if txt then
        pcall(function()
            txt.Visible = false
            txt:Remove()
        end)
        PalletDrawings[model] = nil
    end
end

local function IsPalletBroken(model, prim)
    if not model or not model.Parent or not model:IsDescendantOf(Workspace) then
        return true
    end
    if BrokenPallets[model] then
        return true
    end

    -- 1. Game State Attributes (Set by Violence District PalletVisualsClient & Server)
    local state = model:GetAttribute("PalletState") or model:GetAttribute("State")
    if state == "Broken" or state == "Destroyed" then
        BrokenPallets[model] = true
        return true
    end
    if model:GetAttribute("BrokenAt") ~= nil or model:GetAttribute("Destroyed") == true or model:GetAttribute("Broken") == true
       or model:GetAttribute("isBroken") == true or model:GetAttribute("isDestroyed") == true then
        BrokenPallets[model] = true
        return true
    end

    -- 2. Visual Model Check (Newpallet structure: Intact vs Broken)
    local intact = model:FindFirstChild("Intact")
    if intact then
        local pIntact = intact:FindFirstChild("Pallet") or intact:FindFirstChildWhichIsA("BasePart")
        if pIntact and (pIntact.Transparency >= 0.85 or pIntact.LocalTransparencyModifier >= 0.85) then
            BrokenPallets[model] = true
            return true
        end
    end

    local broken = model:FindFirstChild("Broken")
    if broken then
        local pBroken = broken:FindFirstChild("Pallet_Broken")
        if pBroken and pBroken.Transparency < 0.85 and pBroken.LocalTransparencyModifier < 0.85 then
            BrokenPallets[model] = true
            return true
        end
    end

    return false
end

local function UpdateBackgroundCache()
    pcall(function()
        local inLobby = IsInLobby()
        local now = os.clock()
        
        -- In Lobby: immediately bypass player perks/items scan and purge match objects
        if inLobby then
            CurrentKillerPlayer = nil
            if #CachedGenerators > 0 then table.clear(CachedGenerators) end
            if #CachedPallets > 0 then table.clear(CachedPallets) end
            if #CachedWindows > 0 then table.clear(CachedWindows) end
            if #CachedGates > 0 then table.clear(CachedGates) end
            table.clear(BrokenPallets)
            table.clear(DroppedPallets)
            for _, hl in pairs(GenAuras) do pcall(function() hl:Destroy() end) end
            table.clear(GenAuras)
            for _, hl in pairs(PalletAuras) do pcall(function() hl:Destroy() end) end
            table.clear(PalletAuras)
            for _, txt in pairs(PalletDrawings) do pcall(function() txt:Remove() end) end
            table.clear(PalletDrawings)
            for _, txt in pairs(WindowDrawings) do pcall(function() txt:Remove() end) end
            table.clear(WindowDrawings)
            for _, hl in pairs(WindowAuras) do pcall(function() hl:Destroy() end) end
            table.clear(WindowAuras)
            for _, bha in pairs(WindowAdornments) do pcall(function() bha:Destroy() end) end
            table.clear(WindowAdornments)
            for _, txt in pairs(GateDrawings) do pcall(function() txt:Remove() end) end
            table.clear(GateDrawings)
            for _, txt in pairs(TrapDrawings) do pcall(function() txt:Remove() end) end
            table.clear(TrapDrawings)
            for _, hl in pairs(TrapAuras) do pcall(function() hl:Destroy() end) end
            table.clear(TrapAuras)
            return
        end

        -- Cache killer player and player perks/skills every 0.3s (fast iteration over players only)
        local foundKiller = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and not inLobby and not IsPlayerDead(p) and not IsPlayerInLobby(p) then
                if (p.Team and p.Team.Name == "Killer") or (p.Character and (p.Character:GetAttribute("SelectedKiller") ~= nil or p.Character:GetAttribute("MorphedKiller") ~= nil or p.Character:GetAttribute("Butcher") == true or p.Character:GetAttribute("Killer") == true or p.Character:GetAttribute("isKiller") == true)) then
                    foundKiller = p
                    break
                end
            end
        end
        if not foundKiller then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and not inLobby and not IsPlayerDead(p) and not IsPlayerInLobby(p) then
                    if IsKiller(p) then
                        foundKiller = p
                        break
                    end
                end
            end
        end
        CurrentKillerPlayer = (not inLobby) and foundKiller or nil

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if not inLobby and (IsPlayerDead(p) or IsPlayerInLobby(p)) then
                    CachedPlayerData[p] = nil
                    PlayerItemCache[p] = nil
                    ClearPlayerCooldowns(p)
                else
                    local isK = IsKiller(p)
                    if isK then
                        PlayerItemCache[p] = nil
                    end
                    local perks = (Config.ESP_SurvivorPerks or Config.ESP_KillerPerks) and GetPlayerPerks(p) or nil
                    local skill, isReady, itemNm, itemQty, otherDet = GetPlayerSkillInfo(p)
                    if isK and type(skill) == "string" then
                        if skill:find("^Skill:") then
                            skill = skill:gsub("^Skill:%s*", "[SKILL] ")
                        elseif not skill:find("^%[SKILL%]") then
                            skill = "[SKILL] " .. skill
                        end
                        skill = skill:gsub("%s*|%s*CHASING", ""):gsub("%[CHASING%]", "")
                    end
                    local entry = CachedPlayerData[p]
                    if not entry then
                        entry = {}
                        CachedPlayerData[p] = entry
                    end
                    entry.IsKiller = isK
                    entry.Perks = perks or {}
                    entry.PerksFormatted = (perks and #perks > 0) and table.concat(perks, " | ") or ""
                    entry.SkillInfo = skill or false
                    entry.ItemReady = (not isK) and (isReady == true) or false
                    entry.ItemName = not isK and itemNm or nil
                    entry.ItemQtyStr = not isK and itemQty or nil
                    entry.OtherDetails = not isK and otherDet or nil
                    entry.DisplayName = p.DisplayName
                end
            end
        end

        -- Clean up disconnected / dead / lobby players from cache
        for p in pairs(CachedPlayerData) do
            if not p or not p.Parent or (not inLobby and (IsPlayerDead(p) or IsPlayerInLobby(p))) then
                CachedPlayerData[p] = nil
                PlayerItemCache[p] = nil
            end
        end



        -- If map objects are already cached for this match, never re-scan GetDescendants
        if #CachedGenerators > 0 and #CachedPallets > 0 then
            return
        end

        if now - lastMapScan < 5.0 then
            return
        end
        lastMapScan = now

        local map = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("map")
        local gens, pallets, windows, gates = {}, {}, {}, {}
        local winSeen = {}
        local genSeen = {}
        local palletSeen = {}

        local function isNearExistingVault(pos)
            for _, w in ipairs(windows) do
                if w.Part and (w.Part.Position - pos).Magnitude < 4.0 then
                    return true
                end
            end
            return false
        end

        local function registerVault(container, refPart, sillType)
            if not refPart or not refPart:IsA("BasePart") then return end
            -- Reject gigantic building structures (must be actual vault part or trigger)
            if refPart.Size.X > 10 or refPart.Size.Y > 10 or refPart.Size.Z > 10 then return end
            -- Reject non-vault objects (generators, pallets, gates, lockers, crates)
            local cName = container and container.Name:lower() or (refPart.Parent and refPart.Parent.Name:lower() or "")
            if cName:find("gen") or cName:find("pallet") or cName:find("gate") or cName:find("locker") or cName:find("barrel") or cName:find("crate") then
                return
            end
            if (refPart.Name == "Part" or refPart.Name == "Union" or refPart.Name == "MeshPart") and not (cName:find("window") or cName:find("vault")) then
                return
            end
            -- Reject any vault that is on or directly beside a generator (< 5 studs)
            for _, g in ipairs(gens) do
                if g.Part and (g.Part.Position - refPart.Position).Magnitude < 5.0 then
                    return
                end
            end
            if isNearExistingVault(refPart.Position) then return end
            table.insert(windows, {
                Model = container or refPart.Parent,
                Part = refPart,
                VaultLedge = refPart,
                SillType = sillType or "Auto"
            })
        end

        local function findBestVaultPart(container, triggerPart)
            if not container then return triggerPart, "Trigger" end
            -- Priority 1: Specifically named bottom / ledge / sill parts
            local bottom = container:FindFirstChild("Bottom") or container:FindFirstChild("Ledge") or container:FindFirstChild("Sill") or container:FindFirstChild("VaultLedge") or container:FindFirstChild("VaultSill")
            if bottom and bottom:IsA("BasePart") and bottom.Size.X <= 10 and bottom.Size.Y <= 10 and bottom.Size.Z <= 10 then
                return bottom, "Bottom"
            end

            -- Priority 2: Horizontal sill part (low height, wide)
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("BasePart") and c.Size.Y <= 1.8 and math.max(c.Size.X, c.Size.Z) >= 2.5 and math.max(c.Size.X, c.Size.Z) <= 8 then
                    local cName = c.Name:lower()
                    if not cName:find("invis") and not cName:find("trigger") and not cName:find("collision") then
                        return c, "Sill"
                    end
                end
            end

            -- Priority 3: Trigger part itself
            if triggerPart and triggerPart:IsA("BasePart") and triggerPart.Size.X <= 10 and triggerPart.Size.Y <= 10 and triggerPart.Size.Z <= 10 then
                return triggerPart, "Trigger"
            end

            -- Priority 4: Look for any child part with "trigger" or "vault" or "bottom"
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("BasePart") and c.Size.X <= 10 and c.Size.Y <= 10 and c.Size.Z <= 10 then
                    local cName = c.Name:lower()
                    if cName:find("bottom") or cName:find("ledge") or cName:find("sill") then
                        return c, "Bottom"
                    elseif cName:find("trigger") or cName:find("vault") then
                        return c, "Trigger"
                    end
                end
            end

            -- Priority 5: inviswall (height > 2.5)
            local invis = container:FindFirstChild("inviswall") or container:FindFirstChild("InvisWall") or container:FindFirstChild("Invis")
            if invis and invis:IsA("BasePart") and invis.Size.X <= 10 and invis.Size.Y <= 10 and invis.Size.Z <= 10 then
                return invis, "InvisWall"
            end

            -- Fallback to triggerPart or container.PrimaryPart if reasonably sized
            if triggerPart and triggerPart:IsA("BasePart") then return triggerPart, "Trigger" end
            local prim = container.PrimaryPart or container:FindFirstChildWhichIsA("BasePart")
            if prim and prim.Size.X <= 10 and prim.Size.Y <= 10 and prim.Size.Z <= 10 then
                return prim, "Auto"
            end
            return nil, nil
        end

        -- 1. Universal Multi-Map Vault Detection: CollectionService tags
        pcall(function()
            local CollectionService = game:GetService("CollectionService")
            for _, tag in ipairs({"VaultPoint", "Vault", "Window", "VaultLedge", "VaultSpot", "WindowVault", "window", "vault"}) do
                for _, vt in ipairs(CollectionService:GetTagged(tag)) do
                    local directPart = vt:IsA("BasePart") and vt or vt:FindFirstChildWhichIsA("BasePart")
                    local container = nil
                    if vt:IsA("Model") then
                        container = vt
                    elseif vt.Parent and vt.Parent:IsA("Model") then
                        container = vt.Parent
                    end
                    if container and (container == Workspace or container.Name == "Map" or container.Name:lower():find("house") or container.Name:lower():find("building") or container.Name:lower():find("ruin") or (container.Name:lower() == "model" and not container:FindFirstChild("Bottom") and not container:FindFirstChild("VaultTrigger"))) then
                        container = nil
                    end
                    if not container or not winSeen[container] then
                        if container then winSeen[container] = true end
                        local bestPart, sillType = findBestVaultPart(container, directPart)
                        if bestPart then
                            registerVault(container, bestPart, sillType)
                        end
                    end
                end
            end

            -- Universal Multi-Map Pallet Detection: CollectionService tags
            for _, tag in ipairs({"PalletPoint", "PalletPointSlide", "Pallet", "Pallets", "DroppablePallet", "InteractablePallet"}) do
                for _, p in ipairs(CollectionService:GetTagged(tag)) do
                    local model = p:IsA("Model") and p or p:FindFirstAncestorOfClass("Model") or (p.Parent and p.Parent:IsA("Model") and p.Parent)
                    if model and not palletSeen[model] and not IsPalletBroken(model) then
                        palletSeen[model] = true
                        local intact = model:FindFirstChild("Intact")
                        local intactPallet = intact and (intact:FindFirstChild("Pallet") or intact:FindFirstChildWhichIsA("BasePart"))
                        local bestPart = intactPallet
                                      or model:FindFirstChild("PrimaryPartPallet")
                                      or model:FindFirstChild("Wood")
                                      or model:FindFirstChild("PalletWood")
                                      or model:FindFirstChild("Plank")
                                      or model.PrimaryPart
                        if not bestPart then
                            for _, c in ipairs(model:GetChildren()) do
                                if c:IsA("BasePart") and c.Transparency < 0.95 then
                                    bestPart = c
                                    break
                                end
                            end
                        end
                        if not bestPart then
                            bestPart = p:IsA("BasePart") and p or model:FindFirstChildWhichIsA("BasePart")
                        end
                        if bestPart then
                            local woodTarget = intact or model:FindFirstChild("Wood") or model:FindFirstChild("PalletWood") or intactPallet or model
                            table.insert(pallets, { Model = model, Part = bestPart, PalletWood = woodTarget })
                        end
                    end
                end
            end

            -- Generators CollectionService tag
            for _, g in ipairs(CollectionService:GetTagged("Generator")) do
                if not genSeen[g] then
                    genSeen[g] = true
                    local part = g:FindFirstChild("RootPart") or g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gens, { Model = g, Part = part }) end
                end
            end
        end)

        local searchRoots = {}
        if map then
            table.insert(searchRoots, map)
        else
            table.insert(searchRoots, Workspace)
        end

        for _, rootObj in ipairs(searchRoots) do
            for _, d in ipairs(rootObj:GetDescendants()) do
                -- Generator detection
                if d:IsA("Model") and not genSeen[d] and (d.Name == "Generator" or d.Name:lower() == "generator" or d:GetAttribute("RepairProgress") ~= nil) then
                    genSeen[d] = true
                    local part = d:FindFirstChild("RootPart") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gens, { Model = d, Part = part }) end
                end

                -- Pallet detection across all maps (ignore crate containers, ignore destroyed pallets)
                if d:IsA("Model") and not palletSeen[d] then
                    local dName = d.Name:lower()
                    local pName = d.Parent and d.Parent.Name:lower() or ""
                    local isCrate = dName:find("crate") or dName:find("container") or dName:find("stack")
                    if not isCrate then
                        local isPallet = (pName == "pallets" or pName == "pallet") or
                                         (dName:find("pallet") ~= nil) or
                                         (d:FindFirstChild("PrimaryPartPallet") ~= nil) or
                                         (d:FindFirstChild("DropPrompt", true) ~= nil) or
                                         (d:FindFirstChild("PalletPoint") ~= nil) or
                                         (d:FindFirstChild("PalletPointSlide") ~= nil)
                        if isPallet and not IsPalletBroken(d) then
                            palletSeen[d] = true
                            local intact = d:FindFirstChild("Intact")
                            local intactPallet = intact and (intact:FindFirstChild("Pallet") or intact:FindFirstChildWhichIsA("BasePart"))
                            local bestPart = intactPallet
                                          or d:FindFirstChild("PrimaryPartPallet")
                                          or d:FindFirstChild("Wood")
                                          or d:FindFirstChild("PalletWood")
                                          or d:FindFirstChild("Plank")
                                          or d.PrimaryPart
                            if not bestPart then
                                for _, c in ipairs(d:GetChildren()) do
                                    if c:IsA("BasePart") and c.Transparency < 0.95 then
                                        bestPart = c
                                        break
                                    end
                                end
                            end
                            if not bestPart then
                                bestPart = d:FindFirstChildWhichIsA("BasePart")
                            end
                            if bestPart then
                                local woodTarget = intact or d:FindFirstChild("Wood") or d:FindFirstChild("PalletWood") or intactPallet or d
                                table.insert(pallets, { Model = d, Part = bestPart, PalletWood = woodTarget })
                            end
                        end
                    end
                end

                -- Window / Vault detection across all maps (handle models named Window or Vault, NEVER entire building models)
                if d:IsA("Model") and not winSeen[d] then
                    local dName = d.Name:lower()
                    local pName = d.Parent and d.Parent.Name:lower() or ""
                    local hasDirectTrigger = d:FindFirstChild("VaultTrigger") ~= nil
                    local hasDirectBottom = d:FindFirstChild("Bottom") ~= nil or d:FindFirstChild("Ledge") ~= nil
                    local isWindowName = (dName == "window" or dName:find("vault") ~= nil or pName == "windows" or pName == "vaults" or pName == "vaultpoints")
                    local isWindow = (isWindowName and (hasDirectTrigger or hasDirectBottom)) or (hasDirectTrigger and hasDirectBottom)
                    if isWindow then
                        winSeen[d] = true
                        local trigger = d:FindFirstChild("VaultTrigger")
                        local bestPart, sillType = findBestVaultPart(d, trigger)
                        if bestPart then
                            registerVault(d, bestPart, sillType)
                        end
                    end
                end
            end

            for _, d in ipairs(rootObj:GetChildren()) do
                if d:IsA("Model") and d.Name == "Gate" then
                    local part = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gates, { Model = d, Part = part }) end
                end
            end
        end
        CachedGenerators = gens
        CachedPallets = pallets
        CachedWindows = windows
        CachedGates = gates
    end)
end

