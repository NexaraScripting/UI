-- Hook Window:CreateTab to enhance AddToggle for colored toggles:
-- 1. Anchors Toggle switch at the far right edge (UDim2.new(1, -34, 0.5, -9)) to match all other toggles perfectly
-- 2. Places ColorBadge directly in front of the Toggle switch (UDim2.new(1, -58, 0.5, -7))
-- 3. Keeps Toggle switch button standard Accent/theme color (does NOT change to the ESP color)
local origCreateTab = Window.CreateTab
function Window:CreateTab(tabName, tabIcon)
    local TabObj = origCreateTab(self, tabName, tabIcon)
    local al = TabObj.ActiveLine or (TabObj.Button and TabObj.Button:FindFirstChild("ActiveLine"))
    if al then
        al.AnchorPoint = Vector2.new(0.5, 1)
        al.Position = UDim2.new(0.5, 0, 1, 0)
        al:GetPropertyChangedSignal("Position"):Connect(function()
            if al.Position ~= UDim2.new(0.5, 0, 1, 0) then
                al.AnchorPoint = Vector2.new(0.5, 1)
                al.Position = UDim2.new(0.5, 0, 1, 0)
            end
        end)
    end
    local origCreateColumn = TabObj.CreateColumn
    function TabObj:CreateColumn()
        local ColObj = origCreateColumn(self)
        local origCreateSection = ColObj.CreateSection
        function ColObj:CreateSection(secTitle)
            local SecObj = origCreateSection(self, secTitle)
            local origAddToggle = SecObj.AddToggle
            function SecObj:AddToggle(toggleOpts)
                if not toggleOpts or toggleOpts.Color == nil then
                    return origAddToggle(self, toggleOpts)
                end

                toggleOpts = toggleOpts or {}
                local tName = toggleOpts.Name or "Toggle"
                local tFlag = toggleOpts.Flag or tName
                local tDefault = toggleOpts.Default or false
                local tCallback = toggleOpts.Callback or function() end
                local customColor = toggleOpts.Color
                local currentColor = customColor or Window.Theme.Accent

                local Row = Instance.new("Frame")
                Row.Name = "ToggleRow_" .. tName
                Row.Size = UDim2.new(1, 0, 0, 20)
                Row.BackgroundTransparency = 1
                Row.Parent = self.Container

                local Trigger = Instance.new("TextButton")
                Trigger.Name = "Trigger"
                Trigger.Size = UDim2.new(1, 0, 1, 0)
                Trigger.BackgroundTransparency = 1
                Trigger.Text = ""
                Trigger.Parent = Row

                local Label = Instance.new("TextLabel")
                Label.Name = "Label"
                Label.Size = UDim2.new(1, -64, 1, 0)
                Label.Position = UDim2.fromOffset(0, 0)
                Label.BackgroundTransparency = 1
                Label.Text = tName
                Label.TextColor3 = Window.Theme.Text
                Label.TextSize = 11
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.FontFace = GetPreferredFont()
                Label.Parent = Trigger

                local Pill = Instance.new("Frame")
                Pill.Name = "Pill"
                Pill.Size = UDim2.fromOffset(34, 18)
                Pill.Position = UDim2.new(1, -34, 0.5, -9)
                local offPillColor = Color3.fromRGB(40, 52, 46)
                Pill.BackgroundColor3 = tDefault and Window.Theme.Accent or offPillColor
                Pill.BorderSizePixel = 0
                Pill.Parent = Trigger

                local PillCorner = Instance.new("UICorner")
                PillCorner.CornerRadius = UDim.new(1, 0)
                PillCorner.Parent = Pill

                local PillStroke = Instance.new("UIStroke")
                PillStroke.Color = Color3.fromRGB(30, 40, 36)
                PillStroke.Thickness = 1
                PillStroke.Parent = Pill

                local Knob = Instance.new("Frame")
                Knob.Name = "Knob"
                Knob.Size = UDim2.fromOffset(14, 14)
                Knob.AnchorPoint = Vector2.new(0, 0.5)
                local posOn = UDim2.new(1, -16, 0.5, 0)
                local posOff = UDim2.new(0, 2, 0.5, 0)
                Knob.Position = tDefault and posOn or posOff
                local knobColorOn = Color3.fromRGB(22, 22, 22)
                local knobColorOff = Color3.fromRGB(115, 140, 130)
                Knob.BackgroundColor3 = tDefault and knobColorOn or knobColorOff
                Knob.BorderSizePixel = 0
                Knob.Parent = Pill

                local KnobCorner = Instance.new("UICorner")
                KnobCorner.CornerRadius = UDim.new(1, 0)
                KnobCorner.Parent = Knob

                local state = tDefault
                local ToggleItem = { State = state, Color = currentColor, Name = tName, Flag = tFlag }

                local function SetState(val, silent)
                    state = val
                    ToggleItem.State = state
                    local targetPillCol = state and Window.Theme.Accent or offPillColor
                    local targetKnobCol = state and knobColorOn or knobColorOff
                    local targetPos = state and posOn or posOff

                    TweenService:Create(Pill, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundColor3 = targetPillCol
                    }):Play()
                    TweenService:Create(Knob, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = targetPos,
                        BackgroundColor3 = targetKnobCol
                    }):Play()

                    Window.ConfigValues[tFlag] = state
                    tCallback(state, ToggleItem.Color)
                    if not silent and Window.OnSilentAutoSave then
                        Window.OnSilentAutoSave()
                    end
                end

                Window:OnAccentChanged(function(newAccent)
                    if state then
                        TweenService:Create(Pill, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundColor3 = newAccent
                        }):Play()
                    end
                end)

                local lastToggleTick = 0
                local function DoToggle()
                    if os.clock() - lastToggleTick < 0.08 then return end
                    lastToggleTick = os.clock()
                    SetState(not state)
                end
                Trigger.MouseButton1Click:Connect(DoToggle)

                local ColorBadge = Instance.new("TextButton")
                ColorBadge.Name = "ColorBadge"
                ColorBadge.Size = UDim2.fromOffset(18, 14)
                ColorBadge.Position = UDim2.new(1, -58, 0.5, -7)
                ColorBadge.BackgroundColor3 = currentColor
                ColorBadge.BorderSizePixel = 0
                ColorBadge.Text = ""
                ColorBadge.ZIndex = 5
                ColorBadge.Parent = Row

                local BadgeCorner = Instance.new("UICorner")
                BadgeCorner.CornerRadius = UDim.new(0, 3)
                BadgeCorner.Parent = ColorBadge

                local BadgeStroke = Instance.new("UIStroke")
                BadgeStroke.Color = Window.Theme.Outline
                BadgeStroke.Thickness = 1
                BadgeStroke.Parent = ColorBadge

                ColorBadge.MouseButton1Click:Connect(function()
                    Nexara:OpenColorPicker(ColorBadge, ToggleItem.Color, function(newCol)
                        ToggleItem.Color = newCol
                        ColorBadge.BackgroundColor3 = newCol
                        Window.ConfigValues[tFlag .. "_Color"] = { math.floor(newCol.R * 255), math.floor(newCol.G * 255), math.floor(newCol.B * 255) }
                        tCallback(ToggleItem.State, newCol)
                        if Window.OnSilentAutoSave then Window.OnSilentAutoSave() end
                    end)
                end)

                function ToggleItem:Set(val, silent)
                    SetState(val, silent)
                end
                function ToggleItem:SetColor(newCol, silent)
                    ToggleItem.Color = newCol
                    ColorBadge.BackgroundColor3 = newCol
                    Window.ConfigValues[tFlag .. "_Color"] = { math.floor(newCol.R * 255), math.floor(newCol.G * 255), math.floor(newCol.B * 255) }
                    if not silent then tCallback(ToggleItem.State, newCol) end
                end

                Window.ConfigFlags[tFlag] = ToggleItem
                return ToggleItem
            end
            return SecObj
        end
        return ColObj
    end
    return TabObj
end



