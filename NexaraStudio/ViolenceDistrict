                    if knob then
                        knob.BackgroundColor3 = isOn and Color3.fromRGB(10, 12, 18) or Color3.fromRGB(132, 142, 162)
                    end
                elseif desc.BackgroundTransparency < 0.95 and desc.Parent and (desc.Parent.Name == "QuickCard" or desc.Parent.Name == "CustomCard" or desc.Parent.Name == "Frame") then
                    desc.BackgroundColor3 = pal.Element
                end
            elseif desc:IsA("TextButton") or desc:IsA("TextBox") then
                local nm = desc.Name
                if nm == "Button" or nm == "Track" or nm == "Field" or nm == "BindButton" or nm == "Btn" or nm:find("^Button_") or nm:find("^Btn_") then
                    if desc.Text ~= "Unload" then
