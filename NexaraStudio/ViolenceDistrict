local CachedNativeParryClient = nil
local LastParryScanTick = 0

function AutoParry.GetNativeParryClient()
    if IsInLobby() then return nil end
    if CachedNativeParryClient and CachedNativeParryClient.tool and CachedNativeParryClient.tool.Parent then
        return CachedNativeParryClient
    end
    local now = os.clock()
    if now - LastParryScanTick < 3.0 then
        return CachedNativeParryClient
    end
    LastParryScanTick = now
    
    if getgc then
        for _, v in ipairs(getgc(true)) do
            if type(v) == "table" and rawget(v, "lockDuration") == 0.8 and rawget(v, "animationId") and type(v.Parry) == "function" then
                CachedNativeParryClient = v
                return v
            end
        end
    end
    return nil
end

function AutoParry.CanSurvivorParry()
    if not Config.AutoParry_Enabled or IsInLobby() or IsPlayerInLobby(LocalPlayer) then return false end
    if IsKiller(LocalPlayer) or IsPlayerDead(LocalPlayer) then return false end
    
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return false end
    
    -- 1. Check 1-parry-per-hook nerf (Dead Hard mechanic): ParrySpent attribute
    if char:GetAttribute("ParrySpent") == true then
        return false
    end
    
    -- 2. Check game's native ParryClient state
    local native = AutoParry.GetNativeParryClient()
    if native then
        if native.isParryOnCooldown or native.isParryResolving then
            return false
        end
        if not native:CanUse() then
            return false
        end
    end
    
    -- 3. Check health threshold: locked if Health < 50%
    if hum.Health < hum.MaxHealth * 0.5 then return false end
    
    -- 4. Check survivor busy states
    if char:GetAttribute("Trapped") or char:GetAttribute("IsCarried") or char:GetAttribute("IsHooked") or char:GetAttribute("Ragdolled") then
        return false
    end
    
    local cs = game:GetService("CollectionService")
    if cs:HasTag(char, "Silenced") or cs:HasTag(root, "doing action") then
        return false
    end
    
    -- 5. Interaction checks
    local inter = char:FindFirstChild("CheckInterractable")
    if inter then
        for _, act in ipairs({"isVaulting", "isSliding", "isDroppingPallet", "isRepairing", "isHealing", "isUnhooking", "isExiting"}) do
            if inter:GetAttribute(act) == true then
                return false
            end
        end
    end
    
    -- 6. Check Parrying Dagger model/tool in Character or Backpack
    local toolInChar = char:FindFirstChild("Parrying Dagger")
    local toolInBp = LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Parrying Dagger")
    if not toolInChar and not (toolInBp and Config.AutoParry_AutoEquip) then
        return false
    end
    
    -- 7. Legacy item cooldown check
    if GetItemCooldown(LocalPlayer, "Parrying Dagger") > 0 then
        return false
    end
    
    return true, char, hum, root, toolInChar or toolInBp
end

function AutoParry.FindCurrentKiller()
    if CurrentKillerPlayer and CurrentKillerPlayer.Parent and CurrentKillerPlayer.Character and not IsPlayerDead(CurrentKillerPlayer) then
        return CurrentKillerPlayer
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and IsKiller(p) and not IsPlayerDead(p) and not IsPlayerInLobby(p) then
            return p
        end
    end
    return nil
end

function AutoParry.GetKillerFacingVector(killerChar, killerRoot)
    -- 1. Try replicated CamLook attribute (exact camera aim vector)
    local attr = killerChar:GetAttribute("CamLook")
    if attr and typeof(attr) == "string" then
        local x, y, z = attr:match("([^,]+),%s*([^,]+),%s*([^,]+)")
        if x and y and z then
            local v = Vector3.new(tonumber(x), 0, tonumber(z))
            if v.Magnitude > 0.05 then
                return v.Unit
            end
        end
    end
    -- 2. Try Head CFrame (actual animated head direction)
    local head = killerChar:FindFirstChild("Head")
    if head then
        local v = Vector3.new(head.CFrame.LookVector.X, 0, head.CFrame.LookVector.Z)
        if v.Magnitude > 0.05 then
            return v.Unit
        end
    end
    -- 3. Try Torso CFrame
    local torso = killerChar:FindFirstChild("Torso")
    if torso then
        local v = Vector3.new(torso.CFrame.LookVector.X, 0, torso.CFrame.LookVector.Z)
        if v.Magnitude > 0.05 then
            return v.Unit
        end
    end
    -- 4. Fallback to HumanoidRootPart
    local hrpLook = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z)
    return hrpLook.Magnitude > 0.05 and hrpLook.Unit or killerRoot.CFrame.LookVector
end

function AutoParry.EvaluateKillerAttack(killerChar, myRoot)
    local killerHum = killerChar:FindFirstChildOfClass("Humanoid")
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    if not killerHum or not killerRoot then return false, "no_root" end
    
    -- Ignore if killer is incapacitated or carrying
    if killerChar:GetAttribute("IsStunned") or killerChar:GetAttribute("Immobile") or killerChar:GetAttribute("IsCarrying") then
        return false, "killer_disabled"
    end
    
    -- 1. Radius / Distance Check
    local dist = (killerRoot.Position - myRoot.Position).Magnitude
    local maxRadius = Config.AutoParry_Radius or 13
    if dist > maxRadius then
        return false, "out_of_radius"
    end
    
    -- 2. Strict Horizontal Facing Angle Check
    local killerDir = AutoParry.GetKillerFacingVector(killerChar, killerRoot)
    local toMe = Vector3.new(myRoot.Position.X - killerRoot.Position.X, 0, myRoot.Position.Z - killerRoot.Position.Z)
    if toMe.Magnitude < 0.1 then
        return false, "zero_dist"
    end
    local toMeDir = toMe.Unit
    local dot = killerDir:Dot(toMeDir)
    local facingAngle = math.deg(math.acos(math.clamp(dot, -1, 1)))
    
    -- Killer MUST be facing towards us (within 55 degrees cone)!
    -- If Killer's back is turned or looking away, DO NOT PARRY!
    if facingAngle > 55 then
        return false, "killer_facing_away"
    end
    
    -- 3. Line of Sight / Wall Check
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { killerChar, LocalPlayer.Character, workspace.CurrentCamera }
    local rayResult = workspace:Raycast(killerRoot.Position, myRoot.Position - killerRoot.Position, rayParams)
    if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
        return false, "wall_blocked"
    end
    
    -- 4. Animation Inspection: STRICT Action Priority + Exact Name/ID matching
    local animator = killerHum:FindFirstChildOfClass("Animator")
    if not animator then return false, "no_animator" end
    
    local isLungeHolding = false
    local isCommittedSwing = false
    
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if track.IsPlaying and track.Speed > 0 then
            -- MUST be Action priority (Action, Action2, Action3, Action4).
            -- Locomotion, Walk, Run, Idle are Core/Movement/Idle and NEVER attacks!
            local prio = track.Priority
            local isActionPriority = (prio == Enum.AnimationPriority.Action 
                or prio == Enum.AnimationPriority.Action2 
                or prio == Enum.AnimationPriority.Action3 
                or prio == Enum.AnimationPriority.Action4)
                
            if isActionPriority then
                local rawName = track.Name
                local lowerName = rawName:lower()
                local assetId = (track.Animation and track.Animation.AnimationId and tostring(track.Animation.AnimationId):match("%d+")) or ""
                
                -- Check Hold Track (Feint)
                if AutoParry.StrictHolds[rawName] or AutoParry.StrictHolds[lowerName] or AutoParry.StrictHoldIds[assetId] or lowerName:find("lungehold") then
                    isLungeHolding = true
                end
                
                -- Check Attack Track (Committed Swing)
                local isAttackMatch = AutoParry.StrictAttacks[rawName] 
                    or AutoParry.StrictAttacks[lowerName] 
                    or AutoParry.StrictAttackIds[assetId]
                    or (rawName:sub(1, 6):lower() == "attack" and not lowerName:find("hold"))
                    
                if isAttackMatch then
                    -- Active swing window: must be within the first 0.65s of the swing
                    if track.TimePosition <= 0.65 then
                        isCommittedSwing = true
                    end
                end
            end
        end
    end
    
    -- Anti-Feint: If killer is only holding M1 without releasing swing, WAIT!
    if isLungeHolding and not isCommittedSwing then
        return false, "feint_lunge_hold"
    end
    
    if not isCommittedSwing then
        return false, "not_swinging"
    end
    
    return true, "valid_swing", killerRoot, dist
end

function AutoParry.ExecuteParry(killerRoot)
    local canParry, char, hum, root, dagger = AutoParry.CanSurvivorParry()
    if not canParry then return end
    
    local now = os.clock()
    if now - AutoParry.LastParryTick < 1.2 then return end
    AutoParry.LastParryTick = now
    
    -- Auto-Equip if in backpack
    if dagger and dagger.Parent == LocalPlayer.Backpack then
        hum:EquipTool(dagger)
        task.wait(0.02)
    end
    
    -- Auto-Face killer so parry connects with proper angle
    if Config.AutoParry_AutoFace and killerRoot and root then
        local toKiller = (killerRoot.Position - root.Position) * Vector3.new(1, 0, 1)
        if toKiller.Magnitude > 0.1 then
            root.CFrame = CFrame.new(root.Position, root.Position + toKiller.Unit)
        end
    end
    
    -- 1. Try invoking game's native ParryClient method if available
    local nativeInvoked = false
    local native = AutoParry.GetNativeParryClient()
    if native and native:CanUse() then
        pcall(function()
            native:Parry()
            nativeInvoked = true
        end)
    end
    
    -- 2. Hardware Input simulation fallback (only if native wasn't called)
    if not nativeInvoked then
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendMouseButtonEvent(100, 100, 1, true, game, 0)
            task.delay(0.03, function()
                vim:SendMouseButtonEvent(100, 100, 1, false, game, 0)
            end)
        end)
    end
    
    -- 3. Explicit Animation: ONLY play if Parry is genuinely valid and NOT on cooldown
    pcall(function()
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            local alreadyPlaying = false
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                if t.Animation and tostring(t.Animation.AnimationId):find("109133187196613") then
                    alreadyPlaying = true
                    break
                end
            end
            if not alreadyPlaying then
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://109133187196613"
                local track = animator:LoadAnimation(anim)
                track.Priority = Enum.AnimationPriority.Action4
                track:Play()
                task.delay(1.2, function()
                    pcall(function() anim:Destroy() end)
                end)
            end
        end
    end)
    
    -- 4. Direct Remote Event Backup: Ensure server registers parry
    pcall(function()
        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
        local items = remotes and remotes:FindFirstChild("Items")
        local daggerFolder = items and items:FindFirstChild("Parrying Dagger")
        local parryEvt = daggerFolder and daggerFolder:FindFirstChild("parry")
        if parryEvt then
            parryEvt:FireServer(char)
        end
    end)
end

function AutoParry.UpdateRadiusVisual()
    local lines = AutoParry.Radius3DLines
    if not Config.AutoParry_ShowRadius or not Config.AutoParry_Enabled or IsInLobby() or IsPlayerInLobby(LocalPlayer) or IsCutsceneActive() then
        if lines then
            for _, l in ipairs(lines) do
                if l.Visible then l.Visible = false end
            end
        end
        return
    end

    local canParry, _, _, root, _ = AutoParry.CanSurvivorParry()
    if not canParry or not root or not root.Parent then
        if lines then
            for _, l in ipairs(lines) do
                if l.Visible then l.Visible = false end
            end
        end
        return
    end

    if #lines == 0 then
        for i = 1, 64 do
            local line = Drawing.new("Line")
            line.Thickness = 2.5
            line.Transparency = 1
            line.Color = Config.Color_AutoParry_Radius or Color3.fromRGB(0, 255, 230)
            line.Visible = false
            lines[i] = line
        end
    end

    local rad = tonumber(Config.AutoParry_Radius) or 13
    local col = Config.Color_AutoParry_Radius or Color3.fromRGB(0, 255, 230)
    local step = 0.098174770424681 -- (math.pi * 2) / 64

    local groundY = root.Position.Y - 2.6
    pcall(function()
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { LocalPlayer.Character or root.Parent }
        local hit = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), rp)
        if hit then
            groundY = hit.Position.Y + 0.1
        end
    end)

    local center = Vector3.new(root.Position.X, groundY, root.Position.Z)
    local vpX, vpY = Camera.ViewportSize.X, Camera.ViewportSize.Y

    for i = 1, 64 do
        local a1 = (i - 1) * step
        local a2 = i * step

        local w1 = center + Vector3.new(math.cos(a1) * rad, 0, math.sin(a1) * rad)
        local w2 = center + Vector3.new(math.cos(a2) * rad, 0, math.sin(a2) * rad)

        local s1, on1 = Camera:WorldToViewportPoint(w1)
        local s2, on2 = Camera:WorldToViewportPoint(w2)

        local l = lines[i]
        if s1.Z > 0.05 and s2.Z > 0.05 and (on1 or on2 or (s1.X >= -120 and s1.X <= vpX + 120 and s1.Y >= -120 and s1.Y <= vpY + 120)) then
            l.From = Vector2.new(s1.X, s1.Y)
            l.To = Vector2.new(s2.X, s2.Y)
            l.Color = col
            l.Thickness = 2.5
            l.Visible = true
        else
            l.Visible = false
        end
    end
end

function AutoParry.Update()
    -- Instant Lobby & Cutscene bypass: Zero CPU / Zero GC overhead in lobby
    if IsInLobby() or IsPlayerInLobby(LocalPlayer) or not Config.AutoParry_Enabled or IsCutsceneActive() then
        return
    end
    
    local canParry, _, _, root, _ = AutoParry.CanSurvivorParry()
    if not canParry then
        return
    end
    
    -- Check Killer & Evaluate Attack
    local killerPlayer = AutoParry.FindCurrentKiller()
    if not killerPlayer or not killerPlayer.Character then return end
    
    local isValid, _reason, killerRoot, _dist = AutoParry.EvaluateKillerAttack(killerPlayer.Character, root)
    if isValid then
        AutoParry.ExecuteParry(killerRoot)
    end
end

