                local keyCode = input.KeyCode

                if inputType == Enum.UserInputType.Keyboard and (keyCode == Enum.KeyCode.Backspace or keyCode == Enum.KeyCode.Escape) then
                    keyName = "None"
                    Config.Tof_AimKeyType = "None"
                    Config.Tof_AimKeyCode = nil
                elseif inputType == Enum.UserInputType.MouseButton3 then
                    keyName = "MB3"
                    Config.Tof_AimKeyType = "Mouse"
                    Config.Tof_AimKeyCode = Enum.UserInputType.MouseButton3
                elseif inputType == Enum.UserInputType.Keyboard and keyCode ~= Enum.KeyCode.Unknown then
                    keyName = keyCode.Name
                    Config.Tof_AimKeyType = "Keyboard"
                    Config.Tof_AimKeyCode = keyCode
