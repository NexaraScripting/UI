local PerkIconCache = {}
local function GetPerkIcon(perkName, desiredTier)
    if not perkName or perkName == "" or perkName == "---" then return nil end
    local tierStr = tostring(desiredTier or 3)
    local cacheKey = perkName .. "_" .. tierStr
    if PerkIconCache[cacheKey] then return PerkIconCache[cacheKey] end

    local clean = perkName:lower():gsub("%s+", ""):gsub("[^%a]", "")
    local rs = game:GetService("ReplicatedStorage")
    local tiersToCheck = { tierStr }
    for _, t in ipairs({"3", "2", "1"}) do
        if t ~= tierStr then table.insert(tiersToCheck, t) end
    end

    -- 1. Search ReplicatedStorage.Perks (Survivor Perks)
    if rs:FindFirstChild("Perks") then
        for _, pFolder in ipairs(rs.Perks:GetChildren()) do
            local pClean = pFolder.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if pClean == clean then
                for _, tier in ipairs(tiersToCheck) do
                    local tObj = pFolder:FindFirstChild(tier)
                    if tObj and (tObj:IsA("ImageLabel") or tObj:IsA("ImageButton")) and tObj.Image ~= "" then
                        PerkIconCache[cacheKey] = tObj.Image
                        return tObj.Image
                    end
                end
            end
        end
    end

    -- 2. Search ReplicatedStorage.Killers (Killer Perks)
    if rs:FindFirstChild("Killers") then
        for _, kFolder in ipairs(rs.Killers:GetChildren()) do
            local kPerks = kFolder:FindFirstChild("Perks")
            if kPerks then
                for _, pFolder in ipairs(kPerks:GetChildren()) do
                    local pClean = pFolder.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                    if pClean == clean then
                        for _, tier in ipairs(tiersToCheck) do
                            local tObj = pFolder:FindFirstChild(tier)
                            if tObj and (tObj:IsA("ImageLabel") or tObj:IsA("ImageButton")) and tObj.Image ~= "" then
                                PerkIconCache[cacheKey] = tObj.Image
                                return tObj.Image
                            end
                        end
                        for _, c in ipairs(pFolder:GetChildren()) do
                            if (c:IsA("ImageLabel") or c:IsA("ImageButton")) and c.Image ~= "" then
                                PerkIconCache[cacheKey] = c.Image
                                return c.Image
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

local ItemIconCache = {}
local function GetItemIcon(itemName)
    if not itemName or itemName == "" or itemName == "No Item" or itemName == "None" then return nil end
    if ItemIconCache[itemName] then return ItemIconCache[itemName] end
    if ItemIcons[itemName] then
        ItemIconCache[itemName] = ItemIcons[itemName]
        return ItemIcons[itemName]
    end

    local rs = game:GetService("ReplicatedStorage")
    if rs:FindFirstChild("Items") then
        local itLower = itemName:lower()
        for _, it in ipairs(rs.Items:GetChildren()) do
            local nLower = it.Name:lower()
            if nLower == itLower or itLower:find(nLower) or nLower:find(itLower) then
                for _, c in ipairs(it:GetDescendants()) do
                    if (c:IsA("ImageLabel") or c:IsA("ImageButton")) and c.Image ~= "" and not c.Image:find("Placeholder") then
                        ItemIconCache[itemName] = c.Image
                        return c.Image
                    elseif c:IsA("Decal") and c.Texture ~= "" then
                        ItemIconCache[itemName] = c.Texture
                        return c.Texture
                    end
                end
            end
        end
    end

    return nil
end

local function ResolveKillerType(player)
    if not player then return "The Killer" end
    local char = player.Character
    if char then
        if char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") or char:GetAttribute("corpsecharge") then
            return "Cure"
        elseif char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("Spears") or char:GetAttribute("spearmode") then
            return "Veil"
        elseif char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") then
            return "Stalker"
        elseif char:FindFirstChild("Katana") or char:FindFirstChild("Sword") then
            return "Slasher"
        end
    end
    local kAttr = player:GetAttribute("SelectedKiller") or (char and char:GetAttribute("SelectedKiller"))
    if kAttr and type(kAttr) == "string" and kAttr ~= "" then
        local clean = kAttr:lower():gsub("%s+", ""):gsub("[^%a]", "")
        if clean:sub(1, 3) == "the" and #clean > 3 then clean = clean:sub(4) end
        local map = {
            cure = "Cure", veil = "Veil", masked = "Masked", stalker = "Stalker",
            killer = "Killer", hidden = "Hidden", abysswalker = "Abysswalker", slasher = "Slasher"
        }
        if map[clean] then return map[clean] end
        return kAttr
    end
    return "The Killer"
end

local function GetKillerPortrait(kName)
    if not kName then return KillerPortraits["killer"] end
    local clean = tostring(kName):lower():gsub("%s+", ""):gsub("[^%a]", "")
    if clean:sub(1, 3) == "the" and #clean > 3 then clean = clean:sub(4) end
    if KillerPortraits[clean] then return KillerPortraits[clean] end

    local rs = game:GetService("ReplicatedStorage")
    if rs:FindFirstChild("Killers") then
        for _, kf in ipairs(rs.Killers:GetChildren()) do
            local kfClean = kf.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if kfClean == clean or kfClean:find(clean, 1, true) or clean:find(kfClean, 1, true) then
                local frame = kf:FindFirstChild("Frame")
                if frame then
                    for _, d in ipairs(frame:GetDescendants()) do
                        if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" and not d.Image:find("Placeholder") and not d.Image:find("8012052454") and not d.Image:find("13662414759") and not d.Image:find("106695569058121") then
                            return d.Image
                        end
                    end
                end
            end
        end
    end
    return KillerPortraits["killer"]
end

local function SetupKillerAvatar(row, kName, plr)
    local avatarBox = row.AvatarBox
    local avatarImg = row.AvatarImg
    local avatarText = row.AvatarText

    -- Fast-path: If this row is already rendering this exact killer model, keep it
    if row._renderedKiller == kName and row._renderedVpf and row._renderedVpf.Parent == avatarBox then
        avatarImg.Visible = false
        avatarText.Visible = false
        row._renderedVpf.Visible = true
        return
    end

    if row._renderedVpf then
        pcall(function() row._renderedVpf:Destroy() end)
        row._renderedVpf = nil
    end
    local oldVpf = avatarBox:FindFirstChild("KillerViewport")
    if oldVpf then pcall(function() oldVpf:Destroy() end) end

    local clean = tostring(kName or "Veil"):lower():gsub("%s+", ""):gsub("[^%a]", "")
    if clean:sub(1, 3) == "the" and #clean > 3 then clean = clean:sub(4) end

    local rs = game:GetService("ReplicatedStorage")
    local kFolder = nil
    if rs:FindFirstChild("Killers") then
        for _, kf in ipairs(rs.Killers:GetChildren()) do
            local kfClean = kf.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if kfClean == clean or kfClean:find(clean, 1, true) or clean:find(kfClean, 1, true) then
                kFolder = kf
                break
            end
        end
    end

    -- Always prefer canonical ReplicatedStorage.Killers[k].Model (clean static pose, Archivable=true)
    local sourceModel = kFolder and kFolder:FindFirstChild("Model")
    if not sourceModel and plr and plr.Character and plr.Character:FindFirstChild("Head") then
        pcall(function() plr.Character.Archivable = true end)
        sourceModel = plr.Character
    end

    if sourceModel then
        local ok, vpf = pcall(function()
            if not sourceModel.Archivable then
                pcall(function() sourceModel.Archivable = true end)
            end
            local clone = sourceModel:Clone()
            if not clone and kFolder and kFolder:FindFirstChild("Model") then
                kFolder.Model.Archivable = true
                clone = kFolder.Model:Clone()
            end
            if not clone then return nil end

            local head = clone:FindFirstChild("Head") or clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart")
            if not head then
                clone:Destroy()
                return nil
            end

            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.Anchored = true
                    d.CanCollide = false
                elseif d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("ParticleEmitter") or d:IsA("BillboardGui") or d:IsA("Highlight") then
                    d:Destroy()
                end
            end

            local newVpf = Instance.new("ViewportFrame")
            newVpf.Name = "KillerViewport"
            newVpf.Size = UDim2.new(1, 0, 1, 0)
            newVpf.Position = UDim2.new(0, 0, 0, 0)
            newVpf.BackgroundTransparency = 1
            newVpf.BorderSizePixel = 0
            newVpf.LightColor = Color3.fromRGB(255, 245, 245)
            newVpf.Ambient = Color3.fromRGB(175, 175, 185)
            Instance.new("UICorner", newVpf).CornerRadius = UDim.new(0, 6)

            clone.Parent = newVpf

            local cam = Instance.new("Camera")
            cam.FieldOfView = 40
            local look = head.CFrame.LookVector
            local horizLook = Vector3.new(look.X, 0, look.Z)
            if horizLook.Magnitude > 0.05 then
                horizLook = horizLook.Unit
            else
                horizLook = Vector3.new(0, 0, -1)
            end

            local targetPos = head.Position + Vector3.new(0, -0.1, 0)
            local camPos = targetPos + (horizLook * 3.2) + Vector3.new(0, 0.2, 0)
            cam.CFrame = CFrame.new(camPos, targetPos)
            cam.Parent = newVpf

            newVpf.CurrentCamera = cam
            newVpf.LightDirection = (-horizLook + Vector3.new(0.2, 0.5, 0)).Unit
            newVpf.Parent = avatarBox
            return newVpf
        end)

        if ok and vpf then
            row._renderedKiller = kName
            row._renderedVpf = vpf
            avatarImg.Visible = false
            avatarText.Visible = false
            return
        end
    end

    -- Fallback if model could not be cloned or setup
    local portrait = GetKillerPortrait(kName)
    if portrait and portrait ~= "" then
        avatarImg.Image = portrait
        avatarImg.ScaleType = Enum.ScaleType.Fit
        avatarImg.Visible = true
        avatarText.Visible = false
    elseif plr and plr.UserId then
        avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"
        avatarImg.ScaleType = Enum.ScaleType.Fit
        avatarImg.Visible = true
        avatarText.Visible = false
    end
end

local KillerPowerIconCache = {}
local function GetKillerPowerIcon(kName)
    if not kName then return nil end
    local clean = tostring(kName):lower():gsub("%s+", ""):gsub("[^%a]", "")
    if clean:sub(1, 3) == "the" and #clean > 3 then clean = clean:sub(4) end
    if KillerPowerIcons[kName] then return KillerPowerIcons[kName] end
    for k, v in pairs(KillerPowerIcons) do
        if k:lower() == clean then return v end
    end
    if KillerPowerIconCache[clean] then return KillerPowerIconCache[clean] end

    local rs = game:GetService("ReplicatedStorage")
    if rs:FindFirstChild("Killers") then
        local kFolder = rs.Killers:FindFirstChild(kName) or rs.Killers:FindFirstChild("The " .. kName)
        if not kFolder then
            for _, kf in ipairs(rs.Killers:GetChildren()) do
                if kf.Name:lower():gsub("%s+", ""):gsub("[^%a]", "") == clean then
                    kFolder = kf
                    break
                end
            end
        end
        if kFolder and kFolder:FindFirstChild("Frame") then
            for _, c in ipairs(kFolder.Frame:GetDescendants()) do
                if (c:IsA("ImageLabel") or c:IsA("ImageButton")) and c.Image ~= "" and not c.Image:find("Placeholder") and not c.Image:find("8012052454") and not c.Image:find("13662414759") then
                    if not (c.Name:lower():find("icon") or c.Name:lower():find("portrait") or c.Name:lower():find("head") or c.Name == "Background") then
                        KillerPowerIconCache[clean] = c.Image
                        return c.Image
                    end
                end
            end
        end
    end

    return nil
end

