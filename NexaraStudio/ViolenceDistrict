local function ClearPlayerCooldowns(player)
    if not player then return end
    local pName = typeof(player) == "Instance" and player.Name or tostring(player)
    PlayerItemCooldowns[pName] = nil
    for k in pairs(PlayerItemCooldowns) do
        if typeof(k) == "string" and k:sub(1, #pName + 1) == pName .. "_" then
            PlayerItemCooldowns[k] = nil
        end
    end
    PlayerItemCache[player] = nil
end

local function SetItemCooldown(player, itemName, duration)
    if not player or not itemName or not duration then return end
    if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return end
    local endTime = os.clock() + tonumber(duration)
    local pName = typeof(player) == "Instance" and player.Name or tostring(player)
    PlayerItemCooldowns[pName .. "_" .. itemName] = endTime
    if not PlayerItemCooldowns[pName] then
        PlayerItemCooldowns[pName] = {}
    end
    PlayerItemCooldowns[pName][itemName] = endTime
end

local function GetItemCooldown(player, itemName)
    if not player or not itemName then return 0 end
    if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return 0 end
    local now = os.clock()
    local pName = typeof(player) == "Instance" and player.Name or tostring(player)
    local t = PlayerItemCooldowns[pName .. "_" .. itemName]
    if not t and PlayerItemCooldowns[pName] then
        t = PlayerItemCooldowns[pName][itemName]
    end
    if t and t > now then
        return math.ceil(t - now)
    end
    return 0
end

-- Listen for Activatecdremote (used by both Killer & Survivor perks)
