    function TofCombat.StepHitmarker(dt)
        local lines = TofCombat.HitmarkerLines
        if not lines or #lines == 0 then return end
        if TofCombat.HitmarkerAlpha and TofCombat.HitmarkerAlpha > 0.01 then
            local stepDt = (type(dt) == "number" and dt) or 0.016
            TofCombat.HitmarkerAlpha = math.max(0, TofCombat.HitmarkerAlpha - (stepDt * 3.8))
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local vp = cam.ViewportSize
            local cx, cy = vp.X * 0.5, vp.Y * 0.5;

            local isModeOnKiller = (Config.HitmarkerMode ~= "Screen Center")
            if isModeOnKiller then
                local targetWorld = nil
                local tp = TofCombat.HitmarkerTargetPart
                if tp and tp.Parent then
                    targetWorld = tp.Position
                elseif typeof(TofCombat.HitmarkerWorldPos) == "Vector3" then
                    targetWorld = TofCombat.HitmarkerWorldPos
                end

                if targetWorld then
                    local sPos, onScreen = cam:WorldToViewportPoint(targetWorld)
                    if onScreen and sPos.Z > 0 then
                        cx, cy = sPos.X, sPos.Y
                    else
                        for _, l in ipairs(lines) do
                            if l.Visible then l.Visible = false end
                        end
                        return
                    end
                end
            end

            local gap = 4.5
            local len = 11.5
            local col = TofCombat.HitmarkerIsCrit and Color3.fromRGB(255, 65, 65) or (Config.Color_Hitmarker or Color3.fromRGB(255, 255, 255))
            local a = TofCombat.HitmarkerAlpha

            lines[1].From = Vector2.new(cx - gap, cy - gap)
            lines[1].To = Vector2.new(cx - len, cy - len)

            lines[2].From = Vector2.new(cx + gap, cy - gap)
            lines[2].To = Vector2.new(cx + len, cy - len)

            lines[3].From = Vector2.new(cx - gap, cy + gap)
            lines[3].To = Vector2.new(cx - len, cy + len)

            lines[4].From = Vector2.new(cx + gap, cy + gap)
            lines[4].To = Vector2.new(cx + len, cy + len)

            for _, l in ipairs(lines) do
                l.Color = col
                l.Transparency = a
                if not l.Visible then l.Visible = true end
            end
        else
            TofCombat.HitmarkerWorldPos = nil
            TofCombat.HitmarkerTargetPart = nil
            for _, l in ipairs(lines) do
                if l.Visible then l.Visible = false end
            end
        end
    end

    function TofCombat.GetGunCooldown()
        local char = LocalPlayer.Character
        local tof = char and char:FindFirstChild("Twist of Fate")
        if not tof then
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            tof = bp and bp:FindFirstChild("Twist of Fate")
        end
        if not tof then return false, 0, 0 end
        local state = tof:GetAttribute("tofState")
        local dur = tonumber(tof:GetAttribute("tofStateDur")) or 80
        local start = tonumber(tof:GetAttribute("tofStateStart")) or 0
        local shots = tonumber(tof:GetAttribute("shots")) or 0
        if state == "cooldown" or shots <= 0 then
            local now = workspace:GetServerTimeNow()
            local remaining = math.max(0, math.ceil(dur - (now - start)))
            if remaining > 0 then
                return true, remaining, shots
            end
        end
        return false, 0, shots
    end

    function TofCombat.UpdateTargetVelocities()
        local now = os.clock()
        local validPlrs = {}
        for _, p in ipairs(Players:GetPlayers()) do
            validPlrs[p] = true
            local char = p.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
            if root and root:IsA("BasePart") then
                local pos = root.Position
                local record = TofCombat.TargetVelocities[p]
                if not record then
                    TofCombat.TargetVelocities[p] = {
                        lastPos = pos,
                        lastTime = now,
                        smoothVel = Vector3.zero,
                    }
                else
                    local elapsed = now - record.lastTime
                    if elapsed >= 0.015 then
                        local instVel = (pos - record.lastPos) / elapsed
                        if instVel.Magnitude < 55 then
                            record.smoothVel = record.smoothVel:Lerp(instVel, 0.65)
                        else
                            record.smoothVel = Vector3.zero
                        end
                        record.lastPos = pos
                        record.lastTime = now
                    end
                end
            else
                TofCombat.TargetVelocities[p] = nil
            end
        end
        for p in pairs(TofCombat.TargetVelocities) do
            if not validPlrs[p] then
                TofCombat.TargetVelocities[p] = nil
            end
        end
    end

    function TofCombat.GetPlayerVelocity(p, char)
        -- 1. Exact Humanoid MoveDirection & Speed (Replicated smoothly by Roblox engine, zero network jitter!)
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local moveDir = hum and hum.MoveDirection
            if moveDir and moveDir.Magnitude > 0.05 then
                local speed = tonumber(char:GetAttribute("Speed")) or (hum and hum.WalkSpeed) or 18.7
                local bl = tonumber(char:GetAttribute("BloodLust")) or 0
                if bl > 0 then
                    speed = speed + (bl * 0.8)
                end
                return moveDir.Unit * speed
            end
        end

        -- 2. AssemblyLinearVelocity from RootPart
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        if root and root:IsA("BasePart") then
            local rVel = root.AssemblyLinearVelocity
            if rVel and rVel.Magnitude > 0.4 then
                return rVel
            end
        end

        -- 3. Smoothed Position Differential
        if p and TofCombat.TargetVelocities[p] then
            local vel = TofCombat.TargetVelocities[p].smoothVel
            if vel and vel.Magnitude > 0.4 then
                return vel
            end
        end

        return Vector3.zero
    end

    function TofCombat.BuildTargetOptions()
        local opts = { "Auto (Killer)" }
        local killerOpts = {}
        local otherOpts = {}

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local isK = IsKiller(p)
                if isK then
                    local char = p.Character
                    local kName = p:GetAttribute("SelectedKiller") or (char and char:GetAttribute("SelectedKiller")) or "Killer"
                    if char then
                        if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") then
                            kName = "Veil"
                        elseif char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") or char:GetAttribute("corpsecharge") then
                            kName = "Cure"
                        elseif char:GetAttribute("StalkerStage2Remaining") ~= nil or char:GetAttribute("Stage") ~= nil or char:GetAttribute("StalkStage") ~= nil or char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") then
                            kName = "Stalker"
                        elseif char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") then
                            kName = "Hidden"
                        elseif char:FindFirstChild("Katana") or char:FindFirstChild("Sword") or char:FindFirstChild("pamela") or char:GetAttribute("Pursuit") ~= nil or char:GetAttribute("LakeMist") ~= nil then
                            kName = "Slasher"
                        elseif char:FindFirstChild("Abysswalker") or char:GetAttribute("corrupt") ~= nil then
                            kName = "Abysswalker"
                        elseif char:FindFirstChild("Mask") or char:GetAttribute("Mask") ~= nil then
                            kName = "Masked"
                        elseif char:FindFirstChild("Beartrap") or (char:FindFirstChild("Weapon") and char.Weapon:FindFirstChild("Main")) or char:GetAttribute("PlacingTrap") ~= nil or char:GetAttribute("ChainLatched") ~= nil or char:GetAttribute("ChainThrowUntil") ~= nil or kName == "Butcher" then
                            kName = "Butcher"
                        end
                    end
                    table.insert(killerOpts, string.format("%s [Killer - %s]", p.Name, tostring(kName)))
                else
                    table.insert(otherOpts, p.Name)
                end
            end
        end

        table.sort(killerOpts)
        table.sort(otherOpts)
        for _, v in ipairs(killerOpts) do table.insert(opts, v) end
        for _, v in ipairs(otherOpts) do table.insert(opts, v) end
        return opts
    end

    function TofCombat.RefreshTargetDropdown()
        if not TofCombat.TargetDropdown then return end
        pcall(function()
            local opts = TofCombat.BuildTargetOptions()
            local cur = Config.Tof_TargetMode or "Auto (Killer)"
            local found = false
            local curRawName = cur:match("^([^%s%[]+)")
            for _, o in ipairs(opts) do
                if o == cur then
                    found = true
                    break
                elseif curRawName and cur ~= "Auto (Killer)" and o:match("^([^%s%[]+)") == curRawName then
                    cur = o
                    Config.Tof_TargetMode = o
                    found = true
                    break
                end
            end
            if not found then
                cur = "Auto (Killer)"
                Config.Tof_TargetMode = cur
            end
            TofCombat.TargetDropdown:Refresh(opts, cur)
        end)
    end

    function TofCombat.GetPreferredBasePart(char)
        if not char then return nil end
        return char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChildWhichIsA("BasePart")
    end

    function TofCombat.GetTarget(maxFov)
        local cam = Workspace.CurrentCamera
        if not cam then return nil, nil end
        local vp = cam.ViewportSize
        local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
        local bestTarget, bestPart = nil, nil
        local bestDist = maxFov or Config.Tof_FOV or 250
        local fovLimit = bestDist

        -- 0. Explicit Player / Killer Selection Override
        local mode = Config.Tof_TargetMode or "Auto (Killer)"
        if mode ~= "Auto (Killer)" then
            local targetName = mode:match("^([^%s%[]+)")
            if targetName then
                local sp = Players:FindFirstChild(targetName)
                if sp and sp ~= LocalPlayer and sp.Character and not IsPlayerDead(sp) then
                    local part = TofCombat.GetPreferredBasePart(sp.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= fovLimit then
                                return sp, part
                            end
                        end
                    end
                end
            end
        end

        -- 1. Prioritize Killer
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                if IsKiller(p) then
                    local part = TofCombat.GetPreferredBasePart(p.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= bestDist then
                                bestDist = d2d
                                bestTarget = p
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end

        if bestTarget and bestPart then
            return bestTarget, bestPart
        end

        -- 2. Fallback: if killer is not yet identified by IsKiller (e.g. testing, lobby, or custom killer)
        bestDist = fovLimit
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                local isCandidate = false
                if IsInLobby() then
                    isCandidate = true
                elseif p.Team and LocalPlayer.Team and p.Team ~= LocalPlayer.Team then
                    isCandidate = true
                elseif not p.Team or p.Team.Name ~= "Survivors" then
                    isCandidate = true
                end

                if isCandidate then
                    local part = TofCombat.GetPreferredBasePart(p.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= bestDist then
                                bestDist = d2d
                                bestTarget = p
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
        return bestTarget, bestPart
    end

    -- Verified Server Bullet Origin: Server spawns Twist of Fate raycast at HRP.CFrame * Vector3(0.7, 1.375, -2.5) regardless of client gun animation
    TofCombat.ServerOriginLocalOffset = Vector3.new(0.7, 1.375, -2.5)
    TofCombat.BulletSpeed = 300

    -- Solves exact server aim point targeting the pure Torso/Body while bypassing Accessory.Handles
    function TofCombat.GetOptimalHitPosition(tChar, fallbackPart, shootOrigin)
        if not tChar then return fallbackPart and fallbackPart.Position or shootOrigin end
        local hrp = tChar:FindFirstChild("HumanoidRootPart")
        local torso = tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso") or hrp or fallbackPart
        if not torso then return fallbackPart and fallbackPart.Position or shootOrigin end

        -- Pure center of the body / chest (Torso in R6 is 2x2x1, chest center is at torso.Position + (0, 0.05, 0))
        local torsoCenter = torso.Position + Vector3.new(0, 0.05, 0)

        -- Bullet Flight Time & Motion Lead Prediction (Accounts for Target Velocity + Ping/Replication Delay)
        local velLead = Vector3.zero
        if Config.Tof_Prediction ~= false then
            local targetPlr = Players:GetPlayerFromCharacter(tChar)
            local targetVel = TofCombat.GetPlayerVelocity(targetPlr, tChar)
            local targetSpeed = targetVel.Magnitude

            if targetSpeed > 0.5 then
                local clampedSpeed = math.min(targetSpeed, 22)
                local velDir = targetVel / targetSpeed
                local effVel = velDir * clampedSpeed
                effVel = Vector3.new(effVel.X, math.clamp(effVel.Y, -4, 4), effVel.Z)

                local dist0 = (torsoCenter - shootOrigin).Magnitude
                local bulletSpeed = math.clamp(tonumber(TofCombat.BulletSpeed) or 300, 100, 1500)
                local ping = TofCombat.CachedPing or 0.045
                local repDelay = TofCombat.ServerReplicationDelay or (ping * 0.75)

                local tFlight = (dist0 / bulletSpeed) + repDelay
                local rawLead = effVel * tFlight

                -- Clamp lead tightly within central Torso width (Torso is 2 studs wide; clamp to 0.3 studs to prevent drifting into arms)
                local horizLead = Vector3.new(rawLead.X, 0, rawLead.Z)
                if horizLead.Magnitude > 0.3 then
                    horizLead = horizLead.Unit * 0.3
                end
                velLead = Vector3.new(horizLead.X, math.clamp(rawLead.Y, -0.15, 0.15), horizLead.Z)
            end
        end

        -- Candidates located squarely on the Torso/Body (avoiding limb edges and accessory handles)
        local candidates = {
            torso.Position + Vector3.new(0, -0.05, 0), -- Mid-chest (dead center of body)
            torso.Position,                             -- Dead center of Torso
            hrp and hrp.Position or torso.Position,     -- HumanoidRootPart center
            torso.Position + Vector3.new(0, -0.25, 0), -- Mid-lower torso
            torso.Position + Vector3.new(0, 0.15, 0),  -- Upper chest
        }

        local rpChar = RaycastParams.new()
        rpChar.FilterType = Enum.RaycastFilterType.Include
        rpChar.FilterDescendantsInstances = { tChar }

        local rpWorld = RaycastParams.new()
        rpWorld.FilterType = Enum.RaycastFilterType.Exclude
        rpWorld.FilterDescendantsInstances = { LocalPlayer.Character, Workspace.CurrentCamera }

        local bestTorsoPt = nil
        local fallbackDirectPt = nil

        for _, rawPt in ipairs(candidates) do
            local dirVec = rawPt - shootOrigin
            local dist = dirVec.Magnitude
            if dist > 0.1 then
                local unitDir = dirVec / dist
                local charHit = Workspace:Raycast(shootOrigin, unitDir * (dist + 8), rpChar)
                -- Server requires hit.Instance.Parent == KillerCharacter (NOT an Accessory.Handle!)
                if charHit and charHit.Instance and charHit.Instance.Parent == tChar then
                    local pName = charHit.Instance.Name
                    local isPureBody = (pName == "Torso" or pName == "UpperTorso" or pName == "HumanoidRootPart")

                    if not fallbackDirectPt then
                        fallbackDirectPt = rawPt
                    end

                    local worldHit = Workspace:Raycast(shootOrigin, unitDir * (dist + 6), rpWorld)
                    if worldHit and worldHit.Instance and worldHit.Instance:IsDescendantOf(tChar) and worldHit.Instance.Parent == tChar then
                        if isPureBody then
                            bestTorsoPt = rawPt
                            break
                        end
                    end
                end
            end
        end

        local chosenBase = bestTorsoPt or fallbackDirectPt or (torso.Position + Vector3.new(0, -0.05, 0))
        local finalHitPos = chosenBase + velLead

        -- Wall occlusion check on predicted lead point (if lead point is occluded by wall but direct body is visible, fall back to body)
        if velLead.Magnitude > 0.3 then
            local rpWall = RaycastParams.new()
            rpWall.FilterType = Enum.RaycastFilterType.Exclude
            rpWall.FilterDescendantsInstances = { LocalPlayer.Character, tChar, Workspace.CurrentCamera }
            local toLead = finalHitPos - shootOrigin
            local wallHit = Workspace:Raycast(shootOrigin, toLead, rpWall)
            if wallHit and wallHit.Instance and wallHit.Instance.CanCollide and wallHit.Distance < (toLead.Magnitude - 1.5) then
                local toBase = chosenBase - shootOrigin
                local directHit = Workspace:Raycast(shootOrigin, toBase, rpWall)
                if not directHit or not directHit.Instance or not directHit.Instance.CanCollide or directHit.Distance >= (toBase.Magnitude - 1) then
                    finalHitPos = chosenBase
                end
            end
        end

        return finalHitPos
    end

    -- Checks if LocalPlayer is currently holding/equipping Twist of Fate
    function TofCombat.IsTwistOfFateActive()
        if IsPlayerDead(LocalPlayer) then
            return false
        end
        local char = LocalPlayer.Character
        if not char then return false end
        if char:FindFirstChild("Twist of Fate") then
            return true
        end
        return false
    end

    -- Checks if LocalPlayer is actively in a match (NOT Lobby/Spectator) AND currently holding/equipping Flashlight
    function TofCombat.IsFlashlightActive()
        if IsInLobby() or IsPlayerInLobby(LocalPlayer) or IsKiller(LocalPlayer) or IsPlayerDead(LocalPlayer) or IsCutsceneActive() then
            return false
        end
        local char = LocalPlayer.Character
        if not char then return false end
        if char:FindFirstChild("Flashlight") then
