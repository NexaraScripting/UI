local lastMaskAlertKey = ""
local lastMaskAlertTime = 0

local function TriggerMaskAlert(maskName, isActivated)
    if not Config.Alert_MaskChange then return end
    if IsInLobby() then return end
    if IsKiller(LocalPlayer) then return end

    local now = os.clock()
    local cacheKey = tostring(maskName) .. "_" .. tostring(isActivated)
    if lastMaskAlertKey == cacheKey and (now - lastMaskAlertTime) < 2.5 then
        return
    end
    lastMaskAlertKey = cacheKey
    lastMaskAlertTime = now

    local isMaskActive = (isActivated == true)
    local info = isMaskActive and (ResolveMaskInfo(maskName) or {
        Name = maskName or "Mask",
        Title = "THE MASKED: " .. tostring(maskName):upper(),
        Effect = "MASK POWER ACTIVE",
        Tip = "Beware killer ability!",
        Color = Color3.fromRGB(255, 120, 50),
        Icon = "rbxassetid://110441838520158"
    }) or ResolveMaskInfo("Richard") or {
        Name = "Richard",
        Animal = "Rooster",
        ModelName = "Richard",
        Title = "RICHARD (ROOSTER)",
        Effect = "MASK INACTIVE (30s COOLDOWN)",
        Tip = "Killer power is on cooldown for 30 seconds.",
        Color = Color3.fromRGB(150, 160, 175),
        Icon = "rbxassetid://110441838520158"
    }

    EnsureMaskAlertUI()
    if not MaskAlertBanner then return end

    MaskAlertToken = MaskAlertToken + 1
    local currentToken = MaskAlertToken

    local accentCol = isMaskActive and (info.Color or Color3.fromRGB(50, 220, 80)) or Color3.fromRGB(150, 160, 175)
    local subText = isMaskActive and ("[THE MASKED] " .. (info.Title or info.Name:upper())) or "[THE MASKED] POWER EXPIRED"
    local titleText = isMaskActive and info.Effect or "MASK INACTIVE (30s COOLDOWN)"
    local tipText = isMaskActive and ("⚠️ " .. (info.Tip or "Beware killer ability!")) or "Switched to Richard. Killer power on cooldown (30s)."

    MaskAlertSub.Text = subText
    MaskAlertSub.TextColor3 = accentCol
    MaskAlertTitle.Text = titleText
    MaskAlertTip.Text = tipText
    MaskAlertStroke.Color = accentCol

    -- Render 3D Mask model in ViewportFrame: when inactive/expired, ALWAYS switch to Richard (Rooster / ไก่)!
    local targetModelName = isMaskActive and (info.ModelName or info.Name) or "Richard"
    local has3d = SetupMaskViewport(MaskAlertVPF, targetModelName)
    if has3d and MaskAlertVPF then
        MaskAlertVPF.Visible = true
        if MaskAlertIcon then MaskAlertIcon.Visible = false end
    else
        if MaskAlertVPF then MaskAlertVPF.Visible = false end
        if MaskAlertIcon then
            local fallbackIcon = isMaskActive and (info.Icon or "rbxassetid://110441838520158") or "rbxassetid://110441838520158"
            MaskAlertIcon.Image = fallbackIcon
            MaskAlertIcon.Visible = true
        end
    end

    -- Toast notification
    pcall(function()
        if Nexara and Nexara.Notify then
            Nexara:Notify({
                Title = isActivated and ("⚠️ THE MASKED: " .. (info.Name or maskName):upper()) or "THE MASKED",
                Content = isActivated and (info.Effect .. "\n" .. (info.Tip or "")) or "Mask power expired (30s Cooldown)",
                Duration = isActivated and 5 or 3.5
            })
        end
    end)

    -- Sound cue
    pcall(function()
        local snd = Instance.new("Sound")
        snd.SoundId = isActivated and "rbxassetid://4590662766" or "rbxassetid://4590657391"
        snd.Volume = 0.65
        snd.Parent = game:GetService("SoundService")
        snd:Play()
        game:GetService("Debris"):AddItem(snd, 2)
    end)

    -- Smooth banner animation
    pcall(function()
        MaskAlertBanner.Visible = true
        MaskAlertBanner.Position = UDim2.new(0.5, 0, 0, 18)
        MaskAlertBanner.BackgroundTransparency = 1
        MaskAlertStroke.Transparency = 1
        if MaskAlertIcon then MaskAlertIcon.ImageTransparency = 1 end
        MaskAlertSub.TextTransparency = 1
        MaskAlertTitle.TextTransparency = 1
        MaskAlertTip.TextTransparency = 1

        local animIn = TweenService:Create(MaskAlertBanner, TweenInfo.new(0.32, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0, 78),
            BackgroundTransparency = 0.15
        })
        TweenService:Create(MaskAlertStroke, TweenInfo.new(0.32, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { Transparency = 0.1 }):Play()
        if MaskAlertIcon and MaskAlertIcon.Visible then
            TweenService:Create(MaskAlertIcon, TweenInfo.new(0.28, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { ImageTransparency = 0 }):Play()
        end
        TweenService:Create(MaskAlertSub, TweenInfo.new(0.28, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
        TweenService:Create(MaskAlertTitle, TweenInfo.new(0.28, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
        TweenService:Create(MaskAlertTip, TweenInfo.new(0.28, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
        animIn:Play()

        task.spawn(function()
            task.wait(isActivated and 5.5 or 3.5)
            if MaskAlertToken == currentToken and MaskAlertBanner and MaskAlertBanner.Parent then
                local animOut = TweenService:Create(MaskAlertBanner, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Position = UDim2.new(0.5, 0, 0, 18),
                    BackgroundTransparency = 1
                })
                TweenService:Create(MaskAlertStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
                if MaskAlertIcon and MaskAlertIcon.Visible then
                    TweenService:Create(MaskAlertIcon, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { ImageTransparency = 1 }):Play()
                end
                TweenService:Create(MaskAlertSub, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
                TweenService:Create(MaskAlertTitle, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
                TweenService:Create(MaskAlertTip, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
                animOut:Play()
                task.wait(0.32)
                if MaskAlertToken == currentToken and MaskAlertBanner then
                    MaskAlertBanner.Visible = false
                end
            end
        end)
    end)
end

function ClearPlayerCooldowns(player)
    if not player then return end
    local pName = typeof(player) == "Instance" and player.Name or tostring(player)
    PlayerItemCooldowns[pName] = nil
    for k in pairs(PlayerItemCooldowns) do
        if typeof(k) == "string" and k:sub(1, #pName + 1) == pName .. "_" then
            PlayerItemCooldowns[k] = nil
        end
    end
    PlayerItemCache[player] = nil
end

local function SetItemCooldown(player, itemName, duration)
    if not player or not itemName or not duration then return end
    if itemName == "Twist of Fate" then return end
    if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return end
    local endTime = os.clock() + (tonumber(duration) or 0)
    local pName = typeof(player) == "Instance" and player.Name or tostring(player)
    PlayerItemCooldowns[pName .. "_" .. itemName] = endTime
    if not PlayerItemCooldowns[pName] then
        PlayerItemCooldowns[pName] = {}
    end
    PlayerItemCooldowns[pName][itemName] = endTime
end

function GetItemCooldown(player, itemName)
    if not player or not itemName then return 0 end
    if itemName == "Twist of Fate" then return 0 end
    if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return 0 end
    local now = os.clock()
    local pName = typeof(player) == "Instance" and player.Name or tostring(player)
    local t = PlayerItemCooldowns[pName .. "_" .. itemName]
    if not t and PlayerItemCooldowns[pName] then
        t = PlayerItemCooldowns[pName][itemName]
    end
    if t and t > now then
        return math.ceil(t - now)
    end
    return 0
end

