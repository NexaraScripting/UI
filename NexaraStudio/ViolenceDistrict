-- ======== UNLOAD & CLEANUP SYSTEM ========
local function UnloadScript()
    ScriptRunning = false
    pcall(function() RunService:UnbindFromRenderStep("NexaraESP_Render") end)
    for _, conn in ipairs(ScriptConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(ScriptConnections)
    for _, esp in pairs(ESP_Objects) do
        pcall(function() esp:Remove() end)
    end
    table.clear(ESP_Objects)
    ClearDrawingsMap(GenDrawings)
    ClearDrawingsMap(PalletDrawings)
    ClearDrawingsMap(WindowDrawings)
    ClearDrawingsMap(GateDrawings)
    pcall(function() TopKillerSkillText:Remove() end)
    for _, hl in pairs(PalletAuras) do pcall(function() hl:Destroy() end) end
    for _, hl in pairs(WindowAuras) do pcall(function() hl:Destroy() end) end
    for _, bha in pairs(WindowAdornments) do pcall(function() bha:Destroy() end) end
    table.clear(PalletAuras)
    table.clear(WindowAuras)
    table.clear(WindowAdornments)
    
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if (d:IsA("Highlight") or d:IsA("BoxHandleAdornment") or d:IsA("SelectionBox")) and (d.Name:find("Nexara") or d.Name:find("Aura") or d.Name:find("WindowBox")) then
                d:Destroy()
            end
        end
    end)

    pcall(function()
        RestoreOriginalLighting()
    end)

    pcall(function()
        Camera.FieldOfView = 70
        local rs = game:GetService("ReplicatedStorage")
        local fMod = require(rs.Modules.FOVController)
        if fMod and fMod._nexara_orig_Set then
            fMod.Set = fMod._nexara_orig_Set
            fMod.Release = fMod._nexara_orig_Release
            fMod.IsOverrideActive = fMod._nexara_orig_IsOverrideActive
            fMod.IsTweening = fMod._nexara_orig_IsTweening
            fMod._nexara_orig_Set = nil
        end
    end)

    pcall(function()
        if not IsInLobby() then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end
    end)

    pcall(function()
        if Window then
            Window.Visible = false
            Window.UnlockMouse = false
            if Window.Gui then Window.Gui:Destroy() end
        end
        if _G.Nexara_CurrentWindow then
            _G.Nexara_CurrentWindow.Visible = false
            _G.Nexara_CurrentWindow.UnlockMouse = false
            if _G.Nexara_CurrentWindow.Gui then _G.Nexara_CurrentWindow.Gui:Destroy() end
            _G.Nexara_CurrentWindow = nil
        end
        if _G.Nexara_CurrentInstance and _G.Nexara_CurrentInstance.Connections then
            for _, conn in ipairs(_G.Nexara_CurrentInstance.Connections) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(_G.Nexara_CurrentInstance.Connections)
            _G.Nexara_CurrentInstance = nil
        end
        local function clean(p)
            if not p then return end
            for _, c in ipairs(p:GetChildren()) do
                if c.Name:find("NexaraStudio") or c.Name:find("Nexara") then
                    c:Destroy()
                end
            end
        end
        clean(game:GetService("CoreGui"))
        if gethui then pcall(function() clean(gethui()) end) end
        local lp = game:GetService("Players").LocalPlayer
        if lp and lp:FindFirstChild("PlayerGui") then clean(lp.PlayerGui) end
    end)

    _G.Nexara_VD_Cleanup = nil
    print("[Nexara Studio] Violence District unloaded successfully.")
end

