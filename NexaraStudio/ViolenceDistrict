local IsRestoringConfig = false
-- Hook all ConfigFlags items to force callbacks to execute on LoadConfigData even when silent=true is passed
local function WrapConfigFlagsForAutoLoad()
    if not Window or not Window.ConfigFlags then return end
    for flag, item in pairs(Window.ConfigFlags) do
        if item and type(item.Set) == "function" and not item._wrappedForCallbacks then
            local rawSet = item.Set
            item._wrappedForCallbacks = true
            item.Set = function(selfItem, val, silent)
                if silent or IsRestoringConfig then
                    local origAutoSave = Window.OnSilentAutoSave
                    Window.OnSilentAutoSave = nil
                    pcall(function()
                        rawSet(selfItem, val, false) -- Force silent=false so slider/toggle callbacks run without auto-saving during load
                    end)
                    Window.OnSilentAutoSave = origAutoSave
                else
                    pcall(function()
                        rawSet(selfItem, val, false)
                    end)
                    if Window.OnSilentAutoSave then
                        pcall(Window.OnSilentAutoSave)
                    end
                end
            end
        end
        if item and type(item.Open) == "function" and not item._wrappedForPopupPos then
            item._wrappedForPopupPos = true
            local rawOpen = item.Open
            item.Open = function(selfItem)
                rawOpen(selfItem)
                task.defer(function()
                    local gs = game:GetService("GuiService")
                    local insetY = (Window.Gui and Window.Gui.IgnoreGuiInset and gs:GetGuiInset().Y) or 0
                    if insetY > 0 then
                        pcall(function()
                            local btn, popup
                            for i = 1, 15 do
                                local ok, val = pcall(function() return debug.getupvalue(rawOpen, i) end)
                                if not ok then break end
                                if typeof(val) == "Instance" then
                                    local valName = tostring(val.Name)
                                    if valName == "Button" and val:IsA("TextButton") then
                                        btn = val
                                    elseif valName == "DropdownPopup" and val:IsA("ScrollingFrame") then
                                        popup = val
                                    end
                                end
                            end
                            if btn and popup and popup.Visible then
                                local targetY = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 2 + insetY
                                popup.Position = UDim2.fromOffset(btn.AbsolutePosition.X, targetY)
                            end
                        end)
                    end
                end)
            end
        end
    end
end

