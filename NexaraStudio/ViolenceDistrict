    end

    function TofCombat.UpdateTargetVelocities()
        local now = os.clock()
        local validPlrs = {}
        for _, p in ipairs(Players:GetPlayers()) do
            validPlrs[p] = true
            local char = p.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
            if root and root:IsA("BasePart") then
                local pos = root.Position
                local record = TofCombat.TargetVelocities[p]
                if not record then
                    TofCombat.TargetVelocities[p] = {
                        lastPos = pos,
                        lastTime = now,
                        smoothVel = Vector3.zero,
                    }
                else
                    local elapsed = now - record.lastTime
                    if elapsed >= 0.015 then
                        local instVel = (pos - record.lastPos) / elapsed
                        if instVel.Magnitude < 55 then
                            record.smoothVel = record.smoothVel:Lerp(instVel, 0.65)
                        else
                            record.smoothVel = Vector3.zero
                        end
                        record.lastPos = pos
                        record.lastTime = now
                    end
                end
            else
                TofCombat.TargetVelocities[p] = nil
            end
        end
        for p in pairs(TofCombat.TargetVelocities) do
            if not validPlrs[p] then
                TofCombat.TargetVelocities[p] = nil
            end
        end
    end

    function TofCombat.GetPlayerVelocity(p, char)
        -- 1. Exact Humanoid MoveDirection & Speed (Replicated smoothly by Roblox engine, zero network jitter!)
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local moveDir = hum and hum.MoveDirection
            if moveDir and moveDir.Magnitude > 0.05 then
                local speed = tonumber(char:GetAttribute("Speed")) or (hum and hum.WalkSpeed) or 18.7
                local bl = tonumber(char:GetAttribute("BloodLust")) or 0
                if bl > 0 then
                    speed = speed + (bl * 0.8)
                end
                return moveDir.Unit * speed
            end
        end

        -- 2. AssemblyLinearVelocity from RootPart
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        if root and root:IsA("BasePart") then
            local rVel = root.AssemblyLinearVelocity
            if rVel and rVel.Magnitude > 0.4 then
                return rVel
            end
        end

        -- 3. Smoothed Position Differential
        if p and TofCombat.TargetVelocities[p] then
            local vel = TofCombat.TargetVelocities[p].smoothVel
            if vel and vel.Magnitude > 0.4 then
                return vel
            end
        end

        return Vector3.zero
    end

    function TofCombat.BuildTargetOptions()
        local opts = { "Auto (Killer)" }
        local killerOpts = {}
        local otherOpts = {}

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local isK = IsKiller(p)
                if isK then
                    local char = p.Character
                    local kName = p:GetAttribute("SelectedKiller") or (char and char:GetAttribute("SelectedKiller")) or "Killer"
                    if char then
                        if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") then
                            kName = "Veil"
                        elseif char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") or char:GetAttribute("corpsecharge") then
                            kName = "Cure"
                        elseif char:GetAttribute("StalkerStage2Remaining") ~= nil or char:GetAttribute("Stage") ~= nil or char:GetAttribute("StalkStage") ~= nil or char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") then
                            kName = "Stalker"
                        elseif char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") then
                            kName = "Hidden"
                        elseif char:FindFirstChild("Katana") or char:FindFirstChild("Sword") or char:FindFirstChild("pamela") or char:GetAttribute("Pursuit") ~= nil or char:GetAttribute("LakeMist") ~= nil then
                            kName = "Slasher"
                        elseif char:FindFirstChild("Abysswalker") or char:GetAttribute("corrupt") ~= nil then
                            kName = "Abysswalker"
                        elseif char:FindFirstChild("Mask") or char:GetAttribute("Mask") ~= nil then
                            kName = "Masked"
                        elseif char:FindFirstChild("Beartrap") or (char:FindFirstChild("Weapon") and char.Weapon:FindFirstChild("Main")) or char:GetAttribute("PlacingTrap") ~= nil or char:GetAttribute("ChainLatched") ~= nil or char:GetAttribute("ChainThrowUntil") ~= nil or kName == "Butcher" then
                            kName = "Butcher"
                        end
                    end
                    table.insert(killerOpts, string.format("%s [Killer - %s]", p.Name, tostring(kName)))
                else
                    table.insert(otherOpts, p.Name)
                end
            end
        end

        table.sort(killerOpts)
        table.sort(otherOpts)
        for _, v in ipairs(killerOpts) do table.insert(opts, v) end
        for _, v in ipairs(otherOpts) do table.insert(opts, v) end
        return opts
    end

    function TofCombat.RefreshTargetDropdown()
        if not TofCombat.TargetDropdown then return end
        pcall(function()
            local opts = TofCombat.BuildTargetOptions()
            local cur = Config.Tof_TargetMode or "Auto (Killer)"
            local found = false
            local curRawName = cur:match("^([^%s%[]+)")
            for _, o in ipairs(opts) do
                if o == cur then
                    found = true
                    break
                elseif curRawName and cur ~= "Auto (Killer)" and o:match("^([^%s%[]+)") == curRawName then
                    cur = o
                    Config.Tof_TargetMode = o
                    found = true
                    break
                end
            end
            if not found then
                cur = "Auto (Killer)"
                Config.Tof_TargetMode = cur
            end
            TofCombat.TargetDropdown:Refresh(opts, cur)
        end)
    end

    function TofCombat.GetPreferredBasePart(char)
        if not char then return nil end
        return char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChildWhichIsA("BasePart")
    end

    function TofCombat.GetTarget(maxFov)
        local cam = Workspace.CurrentCamera
        if not cam then return nil, nil end
        local vp = cam.ViewportSize
        local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
        local bestTarget, bestPart = nil, nil
        local bestDist = maxFov or Config.Tof_FOV or 250
        local fovLimit = bestDist

        -- 0. Explicit Player / Killer Selection Override
        local mode = Config.Tof_TargetMode or "Auto (Killer)"
        if mode ~= "Auto (Killer)" then
            local targetName = mode:match("^([^%s%[]+)")
            if targetName then
                local sp = Players:FindFirstChild(targetName)
                if sp and sp ~= LocalPlayer and sp.Character and not IsPlayerDead(sp) then
                    local part = TofCombat.GetPreferredBasePart(sp.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= fovLimit then
                                return sp, part
                            end
                        end
                    end
                end
            end
        end

        -- 1. Prioritize Killer
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                if IsKiller(p) then
                    local part = TofCombat.GetPreferredBasePart(p.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= bestDist then
                                bestDist = d2d
                                bestTarget = p
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end

        if bestTarget and bestPart then
            return bestTarget, bestPart
        end

        -- 2. Fallback: if killer is not yet identified by IsKiller (e.g. testing, lobby, or custom killer)
        bestDist = fovLimit
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                local isCandidate = false
                if IsInLobby() then
                    isCandidate = true
                elseif p.Team and LocalPlayer.Team and p.Team ~= LocalPlayer.Team then
                    isCandidate = true
                elseif not p.Team or p.Team.Name ~= "Survivors" then
                    isCandidate = true
                end

                if isCandidate then
                    local part = TofCombat.GetPreferredBasePart(p.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= bestDist then
                                bestDist = d2d
                                bestTarget = p
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
        return bestTarget, bestPart
    end

    -- Verified Server Bullet Origin: Server spawns Twist of Fate raycast at HRP.CFrame * Vector3(0.7, 1.375, -2.5) regardless of client gun animation
    TofCombat.ServerOriginLocalOffset = Vector3.new(0.7, 1.375, -2.5)
    TofCombat.BulletSpeed = 300

    -- Solves exact server aim point targeting the pure Torso/Body while bypassing Accessory.Handles
    function TofCombat.GetOptimalHitPosition(tChar, fallbackPart, shootOrigin)
        if not tChar then return fallbackPart and fallbackPart.Position or shootOrigin end
        local hrp = tChar:FindFirstChild("HumanoidRootPart")
        local torso = tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso") or hrp or fallbackPart
        if not torso then return fallbackPart and fallbackPart.Position or shootOrigin end

        -- Pure center of the body / chest (Torso in R6 is 2x2x1, chest center is at torso.Position + (0, 0.05, 0))
        local torsoCenter = torso.Position + Vector3.new(0, 0.05, 0)

        -- Bullet Flight Time & Motion Lead Prediction (Accounts for Target Velocity + Ping/Replication Delay)
        local velLead = Vector3.zero
        if Config.Tof_Prediction ~= false then
            local targetPlr = Players:GetPlayerFromCharacter(tChar)
            local targetVel = TofCombat.GetPlayerVelocity(targetPlr, tChar)
            local targetSpeed = targetVel.Magnitude

            if targetSpeed > 0.5 then
                local clampedSpeed = math.min(targetSpeed, 22)
                local velDir = targetVel / targetSpeed
                local effVel = velDir * clampedSpeed
                effVel = Vector3.new(effVel.X, math.clamp(effVel.Y, -4, 4), effVel.Z)

                local dist0 = (torsoCenter - shootOrigin).Magnitude
                local bulletSpeed = math.clamp(tonumber(TofCombat.BulletSpeed) or 300, 100, 1500)
                local ping = TofCombat.CachedPing or 0.045
                local repDelay = TofCombat.ServerReplicationDelay or (ping * 0.75)

                local tFlight = (dist0 / bulletSpeed) + repDelay
                local rawLead = effVel * tFlight

                -- Clamp lead tightly within central Torso width (Torso is 2 studs wide; clamp to 0.3 studs to prevent drifting into arms)
                local horizLead = Vector3.new(rawLead.X, 0, rawLead.Z)
                if horizLead.Magnitude > 0.3 then
                    horizLead = horizLead.Unit * 0.3
                end
                velLead = Vector3.new(horizLead.X, math.clamp(rawLead.Y, -0.15, 0.15), horizLead.Z)
            end
        end

        -- Candidates located squarely on the Torso/Body (avoiding limb edges and accessory handles)
        local candidates = {
            torso.Position + Vector3.new(0, -0.05, 0), -- Mid-chest (dead center of body)
            torso.Position,                             -- Dead center of Torso
            hrp and hrp.Position or torso.Position,     -- HumanoidRootPart center
            torso.Position + Vector3.new(0, -0.25, 0), -- Mid-lower torso
            torso.Position + Vector3.new(0, 0.15, 0),  -- Upper chest
        }

        local rpChar = RaycastParams.new()
        rpChar.FilterType = Enum.RaycastFilterType.Include
        rpChar.FilterDescendantsInstances = { tChar }

        local rpWorld = RaycastParams.new()
        rpWorld.FilterType = Enum.RaycastFilterType.Exclude
        rpWorld.FilterDescendantsInstances = { LocalPlayer.Character, Workspace.CurrentCamera }

        local bestTorsoPt = nil
        local fallbackDirectPt = nil

        for _, rawPt in ipairs(candidates) do
            local dirVec = rawPt - shootOrigin
            local dist = dirVec.Magnitude
            if dist > 0.1 then
                local unitDir = dirVec / dist
                local charHit = Workspace:Raycast(shootOrigin, unitDir * (dist + 8), rpChar)
                -- Server requires hit.Instance.Parent == KillerCharacter (NOT an Accessory.Handle!)
                if charHit and charHit.Instance and charHit.Instance.Parent == tChar then
                    local pName = charHit.Instance.Name
                    local isPureBody = (pName == "Torso" or pName == "UpperTorso" or pName == "HumanoidRootPart")

                    if not fallbackDirectPt then
                        fallbackDirectPt = rawPt
                    end

                    local worldHit = Workspace:Raycast(shootOrigin, unitDir * (dist + 6), rpWorld)
                    if worldHit and worldHit.Instance and worldHit.Instance:IsDescendantOf(tChar) and worldHit.Instance.Parent == tChar then
                        if isPureBody then
                            bestTorsoPt = rawPt
                            break
                        end
                    end
                end
            end
        end

        local chosenBase = bestTorsoPt or fallbackDirectPt or (torso.Position + Vector3.new(0, -0.05, 0))
        local finalHitPos = chosenBase + velLead

        -- Wall occlusion check on predicted lead point (if lead point is occluded by wall but direct body is visible, fall back to body)
        if velLead.Magnitude > 0.3 then
            local rpWall = RaycastParams.new()
            rpWall.FilterType = Enum.RaycastFilterType.Exclude
            rpWall.FilterDescendantsInstances = { LocalPlayer.Character, tChar, Workspace.CurrentCamera }
            local toLead = finalHitPos - shootOrigin
            local wallHit = Workspace:Raycast(shootOrigin, toLead, rpWall)
            if wallHit and wallHit.Instance and wallHit.Instance.CanCollide and wallHit.Distance < (toLead.Magnitude - 1.5) then
                local toBase = chosenBase - shootOrigin
                local directHit = Workspace:Raycast(shootOrigin, toBase, rpWall)
                if not directHit or not directHit.Instance or not directHit.Instance.CanCollide or directHit.Distance >= (toBase.Magnitude - 1) then
                    finalHitPos = chosenBase
                end
            end
        end

        return finalHitPos
    end

    -- Checks if LocalPlayer is currently holding/equipping Twist of Fate
    function TofCombat.IsTwistOfFateActive()
        if IsPlayerDead(LocalPlayer) then
            return false
        end
        local char = LocalPlayer.Character
        if not char then return false end
        if char:FindFirstChild("Twist of Fate") then
            return true
        end
        return false
    end

    -- Checks if LocalPlayer is actively in a match (NOT Lobby/Spectator) AND currently holding/equipping Flashlight
    function TofCombat.IsFlashlightActive()
        if IsInLobby() or IsPlayerInLobby(LocalPlayer) or IsKiller(LocalPlayer) or IsPlayerDead(LocalPlayer) or IsCutsceneActive() then
            return false
        end
        local char = LocalPlayer.Character
        if not char then return false end
        if char:FindFirstChild("Flashlight") then
            return true
        end
        local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
        if bp and bp:FindFirstChild("Flashlight") then
            return true
        end
        return false
    end

    TofCombat.HrpHistory = TofCombat.HrpHistory or {}
    TofCombat.ServerReplicationDelay = TofCombat.ServerReplicationDelay or 0.045

    function TofCombat.RecordHrpHistory()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local now = os.clock()
        local hist = TofCombat.HrpHistory
        table.insert(hist, { t = now, cf = hrp.CFrame })
        if #hist > 65 then
            local cutoff = now - 0.75
            local keepIdx = 1
            for i = 1, #hist do
                if hist[i].t >= cutoff then
                    keepIdx = i
                    break
                end
            end
            if keepIdx > 1 then
                local newHist = {}
                for i = keepIdx, #hist do
                    newHist[#newHist + 1] = hist[i]
                end
                TofCombat.HrpHistory = newHist
            end
        end
    end

    function TofCombat.GetHistoricalHrpCFrame(targetClock)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local fallbackCF = hrp and hrp.CFrame or CFrame.identity
        local hist = TofCombat.HrpHistory
        if not hist or #hist == 0 then return fallbackCF end

        for i = #hist, 1, -1 do
            local e = hist[i]
            if e.t <= targetClock then
                local nextE = hist[i + 1]
                if nextE and (nextE.t - e.t) > 0.0001 then
                    local alpha = math.clamp((targetClock - e.t) / (nextE.t - e.t), 0, 1)
                    return e.cf:Lerp(nextE.cf, alpha)
                end
                return e.cf
            end
        end
        return hist[1].cf
    end

    -- Computes exact Server Bullet Origin (u3) in real-time
    function TofCombat.GetShootOrigin()
        local char = LocalPlayer.Character
        if not char then
            local cam = Workspace.CurrentCamera
            return cam and cam.CFrame.Position or Vector3.zero
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local offset = TofCombat.ServerOriginLocalOffset or Vector3.new(0.7, 1.375, -2.5)
            return hrp.CFrame:PointToWorldSpace(offset)
        end

        local head = char:FindFirstChild("Head")
        if head then return head.Position end

        local cam = Workspace.CurrentCamera
        return cam and cam.CFrame.Position or Vector3.zero
    end

    -- Returns the physical gun barrel muzzle world position on the Twist of Fate model (for visual Neon Laser Tracer)
    function TofCombat.GetGunMuzzlePosition()
        local char = LocalPlayer.Character
        local tof = char and char:FindFirstChild("Twist of Fate")
        if tof then
            local barrel = tof:FindFirstChild("barrel")
            if barrel then
                local eff = barrel:FindFirstChild("Effect")
                if eff and eff:IsA("Attachment") then
                    return eff.WorldPosition, eff
                elseif barrel:IsA("BasePart") then
                    return barrel.Position, barrel
                end
            end
            local smoke = tof:FindFirstChild("SmokePart")
            if smoke and smoke:IsA("BasePart") then
                return smoke.Position, smoke
            end
            local pp = tof:FindFirstChild("Primarypart") or tof.PrimaryPart
            if pp and pp:IsA("BasePart") then
                return pp.Position, pp
            end
        end
        return TofCombat.GetShootOrigin(), nil
    end

    -- Single-beam Glowing Neon Laser Tracer bound directly from the Twist of Fate gun barrel to the impact target
    function TofCombat.SpawnLaserTracer(startPos, endPos)
        pcall(function()
            local now = os.clock()
            if TofCombat.LastLaserSpawnClock and (now - TofCombat.LastLaserSpawnClock) < 0.25 then
                return
            end
            TofCombat.LastLaserSpawnClock = now

            -- Clear any existing laser so there are NEVER 2 beams at once
            for _, d in ipairs(Workspace:GetChildren()) do
                if d.Name == "Nexara_TofLaser" then
                    pcall(function() d:Destroy() end)
                end
            end

            local muzzlePos, muzzleRef = TofCombat.GetGunMuzzlePosition()
            local actualStart = muzzlePos or startPos
            local dist = (endPos - actualStart).Magnitude
            if dist < 0.5 then return end

            local col = Config.Color_Tof_Laser or Color3.fromRGB(255, 60, 60)

            local beamPart = Instance.new("Part")
            beamPart.Name = "Nexara_TofLaser"
            beamPart.Shape = Enum.PartType.Cylinder
            beamPart.Material = Enum.Material.Neon
            beamPart.Color = col
            beamPart.Transparency = 0.02
            beamPart.Anchored = true
            beamPart.CanCollide = false
            beamPart.CanQuery = false
            beamPart.CanTouch = false
            beamPart.CastShadow = false
            beamPart.Size = Vector3.new(dist, 0.11, 0.11)
            beamPart.CFrame = CFrame.lookAt((actualStart + endPos) / 2, endPos) * CFrame.Angles(0, math.rad(90), 0)
            beamPart.Parent = Workspace

            local dur = Config.Tof_LaserDuration or 0.6
            task.spawn(function()
                local startT = os.clock()
                while true do
                    local elapsed = os.clock() - startT
                    if elapsed >= dur or not beamPart.Parent then break end
                    if elapsed < 0.12 and muzzleRef and muzzleRef.Parent then
                        local curMuzzle = muzzleRef:IsA("Attachment") and muzzleRef.WorldPosition or muzzleRef.Position
                        local curDist = (endPos - curMuzzle).Magnitude
                        if curDist >= 0.5 then
                            beamPart.Size = Vector3.new(curDist, 0.11, 0.11)
                            beamPart.CFrame = CFrame.lookAt((curMuzzle + endPos) / 2, endPos) * CFrame.Angles(0, math.rad(90), 0)
                        end
                    end
                    local fade = elapsed / dur
                    beamPart.Transparency = 0.02 + (0.98 * (fade * fade))
                    task.wait()
                end
                pcall(function() beamPart:Destroy() end)
            end)
        end)
    end

    function TofCombat.StepAimbotAndFOV(dt)
        if IsInLobby() or IsCutsceneActive() then
            if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                TofCombat.FovCircle.Visible = false
            end
            return
        end

        if TofCombat.StepHitmarker then
            TofCombat.StepHitmarker(dt)
        end
        if TofCombat.StepHitLogs then
            TofCombat.StepHitLogs(dt)
        end

        local hasActiveGun = TofCombat.IsTwistOfFateActive()
        if not hasActiveGun then
            if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                TofCombat.FovCircle.Visible = false
            end
            return
        end

        pcall(function()
            TofCombat.CachedPing = math.clamp(LocalPlayer:GetNetworkPing(), 0.015, 0.12)
            TofCombat.RecordHrpHistory()
            TofCombat.UpdateTargetVelocities()
        end)
        local cam = Workspace.CurrentCamera
        if not cam then
            if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                TofCombat.FovCircle.Visible = false
            end
            return
        end

        local inMenu = (Window and Window.Visible) == true

        -- 1. FOV Circle & Real-time Cooldown/Ammo Status Indicator
        local c = TofCombat.FovCircle
        local isCD, remCD, shots = TofCombat.GetGunCooldown()

        if c then
            if Config.Tof_ShowFOV and hasActiveGun and not inMenu then
                local vp = cam.ViewportSize
                local center = Vector2.new(vp.X / 2, vp.Y / 2)
                c.Position = center
                c.Radius = Config.Tof_FOV or 250
                if isCD and remCD > 0 then
                    c.Color = Color3.fromRGB(255, 75, 75)
                    c.Transparency = 0.55
                else
                    c.Color = Config.Color_Tof_FOV or Color3.fromRGB(255, 175, 45)
                    c.Transparency = 1
                end
                if not c.Visible then c.Visible = true end
            else
                if c.Visible then c.Visible = false end
            end
        end

        local char = LocalPlayer.Character
        local isRightClickDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        local isCharAiming = (char and char:GetAttribute("Aiming") == true) or false
        local isAimHeld = (isRightClickDown or isCharAiming) and hasActiveGun and not inMenu

        if isAimHeld then
            if not TofCombat.IsAiming then
                TofCombat.IsAiming = true
                TofCombat.AimStartTime = os.clock()
            end
        else
            TofCombat.IsAiming = false
            TofCombat.AimStartTime = 0
        end

        if not hasActiveGun then
            return
        end

        if not char then return end

        -- NOTE: Do NOT override HRP.CFrame while aiming! Game's ShiftLock already rotates HRP to Camera.LookVector.
        -- Overriding HRP.CFrame locally desyncs client HRP from server HRP when walking or aiming at an angle!

        -- 3. Aimbot (Aiming is locked to Right Click; automatically pauses while gun is on cooldown)
        if Config.Tof_Aimbot and not inMenu and (not isCD or remCD <= 0) and shots > 0 then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local _, targetPart = TofCombat.GetTarget(Config.Tof_FOV)
                if targetPart then
                    local shootOrigin = TofCombat.GetShootOrigin()
                    local aimPos = TofCombat.GetOptimalHitPosition(targetPart.Parent, targetPart, shootOrigin)
                    local targetCF = CFrame.lookAt(cam.CFrame.Position, aimPos)
                    local smooth = math.clamp(Config.Tof_AimbotSmooth or 10, 1, 30)
                    local step = math.clamp((type(dt) == "number" and dt or 0.016) * smooth, 0.05, 1)
                    cam.CFrame = cam.CFrame:Lerp(targetCF, step)
                end
            end
        end
    end

    function TofCombat.Cleanup()
        if TofCombat.FovCircle then
            pcall(function() TofCombat.FovCircle:Remove() end)
            TofCombat.FovCircle = nil
        end
        if TofCombat.StatusText then
            pcall(function() TofCombat.StatusText:Remove() end)
            TofCombat.StatusText = nil
        end
        if TofCombat.AimChargeText then
            pcall(function() TofCombat.AimChargeText:Remove() end)
            TofCombat.AimChargeText = nil
        end
        if TofCombat.HitmarkerLines then
            for _, l in ipairs(TofCombat.HitmarkerLines) do
                pcall(function() l:Remove() end)
            end
            TofCombat.HitmarkerLines = {}
        end
        if TofCombat.ActiveHitLogs then
            for _, entry in ipairs(TofCombat.ActiveHitLogs) do
                if entry.drawing then
                    pcall(function() entry.drawing:Remove() end)
                end
            end
            TofCombat.ActiveHitLogs = {}
        end
        TofCombat.AimKeyRow = nil
        TofCombat.AimKeyBtn = nil
        TofCombat.TargetDropdown = nil
        pcall(function()
            for _, d in ipairs(Workspace:GetChildren()) do
                if d.Name == "Nexara_TofLaser" then d:Destroy() end
            end
            if Workspace.CurrentCamera then
                for _, d in ipairs(Workspace.CurrentCamera:GetChildren()) do
                    if d.Name == "Nexara_TofLaser" then d:Destroy() end
                end
            end
        end)
    end

    function TofCombat.HandleFireServer(self, oldNamecall, ...)
        local args = {...}
        local onVault = _G.Nexara_VD_OnKillerVault
        local nm = self.Name
        if (nm == "VaultCommit" or nm == "VaultEvent-jason" or nm == "VaultEvent") and onVault and IsKiller(LocalPlayer) then
            local target = args[1]
            if target then
                task.defer(function()
                    pcall(onVault, target)
                end)
            end
        elseif nm == "Fire" and self.Parent and self.Parent.Name == "Twist of Fate" then
            if not TofCombat.IsTwistOfFateActive() then
                return self.FireServer(self, ...)
            end

            TofCombat.LastFireTick = tick()
            TofCombat.LastFireClock = os.clock()
            local shootOrigin = TofCombat.GetShootOrigin()

            if Config.Tof_SilentAim then
                local _, targetPart = TofCombat.GetTarget(Config.Tof_FOV)
                if targetPart then
                    local tChar = targetPart.Parent
                    local hitPos = TofCombat.GetOptimalHitPosition(tChar, targetPart, shootOrigin)

                    local delta = hitPos - shootOrigin
                    if delta.Magnitude > 0.05 then
                        args[2] = delta.Unit
                    end

                    TofCombat.PendingLaserHitPos = hitPos
                    TofCombat.PendingLaserOrigin = shootOrigin
                    TofCombat.PendingLaserTick = tick()

                    return self.FireServer(self, table.unpack(args))
                end
            end

            if typeof(args[2]) == "Vector3" then
                TofCombat.PendingLaserHitPos = shootOrigin + (args[2] * 200)
                TofCombat.PendingLaserOrigin = shootOrigin
                TofCombat.PendingLaserTick = tick()
            end
        end

        return self.FireServer(self, ...)
    end
end

