-- Replicated Character Hooks: Catches item use on ANY survivor across the network!
local function SetupPlayerCooldownHooks(player)
    local function onChar(char)
        if not char then return end
        ClearPlayerCooldowns(player)
        PersistentPerksCache[player] = nil

        -- 1. Character Attribute: Fast Whitelist (ignores non-cooldown attributes like CamLook/CamPos/Speed)
        local TrackedCooldownAttrs = {
            Parry = true,
            IsStunned = true,
            LakeMist = true,
            Pursuit = true,
            Mask = true,
            Frenzy = true,
            FrenzyEnding = true,
            Stage = true,
            StalkStage = true,
            EvolveStage = true,
            prepareflask = true,
            overridelookscript = true,
            Aiming = true,
            ChainMove1CD = true,
            ChainThrows = true,
            ChainWindupAt = true
        }
        table.insert(ScriptConnections, char.AttributeChanged:Connect(function(attrName)
            if not TrackedCooldownAttrs[attrName] then return end
            if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return end
            if attrName == "Parry" and char:GetAttribute("Parry") == true then
                SetItemCooldown(player, "Parrying Dagger", 60)
            elseif attrName == "IsStunned" and char:GetAttribute("IsStunned") == true and IsKiller(player) then
                for _, p in ipairs(Players:GetPlayers()) do
                    if not IsKiller(p) and not IsPlayerDead(p) and not IsPlayerInLobby(p) then
                        local cd = GetItemCooldown(p, "Parrying Dagger")
                        if cd >= 57 then
                            SetItemCooldown(p, "Parrying Dagger", 90)
                        end
                    end
                end
            elseif attrName == "LakeMist" then
                local mActive = char:GetAttribute("LakeMist") == true
                if mActive and not LastSlasherMist then
                    LastSlasherMist = true
                    SlasherMistActiveEnd = os.clock() + 13
                    SlasherMistCooldownEnd = 0
                elseif not mActive and LastSlasherMist then
                    LastSlasherMist = false
                    SlasherMistActiveEnd = 0
                    SlasherMistCooldownEnd = os.clock() + 60
                end
            elseif attrName == "Pursuit" then
                local pActive = char:GetAttribute("Pursuit") == true
                if pActive and not LastSlasherPursuit then
                    LastSlasherPursuit = true
                    SlasherPursuitActiveEnd = os.clock() + 20
                    SlasherPursuitCooldownEnd = os.clock() + 100
                elseif not pActive and LastSlasherPursuit then
                    LastSlasherPursuit = false
                    SlasherPursuitActiveEnd = 0
                    SlasherPursuitCooldownEnd = os.clock() + 80
                end
            elseif attrName == "Mask" then
                local m = char:GetAttribute("Mask")
                if m and m ~= "Richard" and LastMaskedState == "Richard" then
