local function SetupMaskViewport(vpf, maskName)
    if not vpf then return false end
    local ok, success = pcall(function()
        vpf:ClearAllChildren()
        local rs = game:GetService("ReplicatedStorage")
        local kFolder = rs:FindFirstChild("Killers") and rs.Killers:FindFirstChild("Masked")
        local mModel = kFolder and kFolder:FindFirstChild("Model")
        if not mModel then return false end

        local targetAcc = nil
        local clean = tostring(maskName or ""):lower():gsub("%s+", ""):gsub("[^%a]", "")
        for _, c in ipairs(mModel:GetChildren()) do
            local cName = c.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if cName == clean or cName:find(clean, 1, true) or clean:find(cName, 1, true) then
                targetAcc = c
                break
            end
        end
        if not targetAcc then
            if clean:find("jake") or clean:find("cobra") or clean:find("snake") then targetAcc = mModel:FindFirstChild("Cobra")
            elseif clean:find("graham") or clean:find("rabbit") or clean:find("hare") then targetAcc = mModel:FindFirstChild("rabbit")
            elseif clean:find("swan") or clean:find("alex") or clean:find("duck") then targetAcc = mModel:FindFirstChild("alex")
            elseif clean:find("tony") or clean:find("tiger") then targetAcc = mModel:FindFirstChild("Tony")
            elseif clean:find("richter") or clean:find("rat") then targetAcc = mModel:FindFirstChild("Richter")
            elseif clean:find("brandon") or clean:find("panther") then targetAcc = mModel:FindFirstChild("Brandon")
            elseif clean:find("richard") or clean:find("rooster") or clean:find("chicken") then targetAcc = mModel:FindFirstChild("Richard")
            end
        end

        if targetAcc then
            local mp = targetAcc:FindFirstChildWhichIsA("MeshPart", true) or targetAcc:FindFirstChild("Handle") or targetAcc:FindFirstChildWhichIsA("BasePart", true)
            if mp then
                local clone = mp:Clone()
                clone.Transparency = 0
                for _, part in ipairs(clone:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0
                    end
                end
                -- Alex/Swan/Duck model coordinates are inverted 180 degrees in ReplicatedStorage compared to other masks
                local isAlex = (targetAcc.Name:lower() == "alex") or clean:find("alex") or clean:find("duck") or clean:find("swan")
                local rotY = isAlex and math.rad(-15) or math.rad(165)
                clone.CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(-6), rotY, 0)
                clone.Parent = vpf

                local cam = Instance.new("Camera")
                cam.FieldOfView = 34
                local sz = mp.Size.Magnitude
                cam.CFrame = CFrame.new(Vector3.new(0, 0.05, sz * 1.35), Vector3.new(0, 0, 0))
                cam.Parent = vpf
                vpf.CurrentCamera = cam
                vpf.Ambient = Color3.fromRGB(240, 240, 240)
                vpf.LightColor = Color3.fromRGB(255, 255, 255)
                vpf.LightDirection = Vector3.new(0, 0.5, -1).Unit
                return true
            end
        end
        return false
    end)
    return ok and success
end

