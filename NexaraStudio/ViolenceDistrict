-- We bind at Enum.RenderPriority.Last so our unlock runs strictly AFTER CameraModule / game scripts
local mouseUnlockBound = false
local function UpdateMouseUnlockBinding()
    if Window and Window.Visible then
        if not mouseUnlockBound then
            mouseUnlockBound = true
            pcall(function()
                RunService:BindToRenderStep("Nexara_MouseUnlock", Enum.RenderPriority.Camera.Value + 1, function()
                    if Window and Window.Visible then
                        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
                            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                        end
                        if not UserInputService.MouseIconEnabled then
                            UserInputService.MouseIconEnabled = true
                        end
                    end
                end)
            end)
        end
        if CameraHooks.modalGui then CameraHooks.modalGui.Enabled = true end
        if CameraHooks.modalBtn then CameraHooks.modalBtn.Visible = true; CameraHooks.modalBtn.Active = true end
        if modalUnlockBtn and modalUnlockBtn.Parent then
            modalUnlockBtn.Visible = true
            modalUnlockBtn.Active = true
        end
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    else
        if mouseUnlockBound then
            mouseUnlockBound = false
            pcall(function() RunService:UnbindFromRenderStep("Nexara_MouseUnlock") end)
        end
        if CameraHooks.modalGui then CameraHooks.modalGui.Enabled = false end
        if CameraHooks.modalBtn then CameraHooks.modalBtn.Visible = false; CameraHooks.modalBtn.Active = false end
        if modalUnlockBtn and modalUnlockBtn.Parent then
            modalUnlockBtn.Visible = false
            modalUnlockBtn.Active = false
        end
        if not IsInLobby() then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
            if CameraHooks.origSetMouseBehavior then
                pcall(function() CameraHooks.origSetMouseBehavior(Enum.MouseBehavior.LockCenter) end)
            end
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end
    end
end

