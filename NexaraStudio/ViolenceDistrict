                    HiddenMarkCooldownEnd = os.clock() + 17
                end))
            end
            local hlRem = hiddenRem:FindFirstChild("highlight")
            if hlRem then
                table.insert(ScriptConnections, hlRem.OnClientEvent:Connect(function()
                    HiddenMarkCooldownEnd = math.max(HiddenMarkCooldownEnd, os.clock() + 17)
                end))
            end
        end

        -- 2. The Slasher / Jason (LakeMist: 13s active + 60s CD & Pursuit: 20s active + 80s CD)
        local jasonRem = kRem:FindFirstChild("Jason")
        if jasonRem then
            local mistRem = jasonRem:FindFirstChild("LakeMist")
            if mistRem then
                table.insert(ScriptConnections, mistRem.OnClientEvent:Connect(function(state)
                    if state == true then
                        LastSlasherMist = true
                        SlasherMistActiveEnd = os.clock() + 13
                        SlasherMistCooldownEnd = 0
                    elseif state == false then
                        LastSlasherMist = false
                        SlasherMistActiveEnd = 0
                        SlasherMistCooldownEnd = os.clock() + 60
                    end
                end))
            end
            local pursuitRem = jasonRem:FindFirstChild("Pursuit")
            if pursuitRem then
                table.insert(ScriptConnections, pursuitRem.OnClientEvent:Connect(function(status)
                    if status == nil or status == "confirmed" or status == true then
                        LastSlasherPursuit = true
                        SlasherPursuitActiveEnd = os.clock() + 20
                        SlasherPursuitCooldownEnd = os.clock() + 100
                    end
                end))
            end
        end

        -- 3. The Stalker (Hunter Mode: 70s active & Evil's Grasp: 10s CD)
        local stalkerRem = kRem:FindFirstChild("Stalker")
        if stalkerRem then
            local evolRem = stalkerRem:FindFirstChild("EvolveStage") or stalkerRem:FindFirstChild("Evolve")
            if evolRem then
                table.insert(ScriptConnections, evolRem.OnClientEvent:Connect(function()
                    StalkerHunterEnd = os.clock() + 70
                end))
            end
            local updRem = stalkerRem:FindFirstChild("UpdateStalking")
            if updRem then
                table.insert(ScriptConnections, updRem.OnClientEvent:Connect(function(pct, stg, graspReady, isStalking)
                    local rawPct = tonumber(pct) or 0
                    StalkerStalkPct = math.clamp(math.floor(rawPct), 0, 100)
                    local nStg = tonumber(stg)
                    if nStg then
                        LastStalkerStage = nStg
                    end
                    if graspReady ~= nil then
                        StalkerGraspReady = (graspReady == true)
                    end
                    if isStalking ~= nil then
                        StalkerIsStalking = (isStalking == true)
                    end
                end))
            end
            local grabRem = stalkerRem:FindFirstChild("grab") or stalkerRem:FindFirstChild("StartGrabHitbox") or stalkerRem:FindFirstChild("GrabResult")
            if grabRem then
                table.insert(ScriptConnections, grabRem.OnClientEvent:Connect(function()
                    StalkerGraspCooldownEnd = os.clock() + 10
                end))
            end
        end

        -- 4. The Masked (Random Mask Power: 60s duration, 30s cooldown)
        local maskedRem = kRem:FindFirstChild("Masked")
        if maskedRem then
            local maskRem = maskedRem:FindFirstChild("Activatepower")
            if maskRem then
                table.insert(ScriptConnections, maskRem.OnClientEvent:Connect(function(maskName)
                    MaskedActiveEnd = os.clock() + 60
                    MaskedCooldownEnd = 0
                    local m = (maskName and typeof(maskName) == "string" and maskName ~= "") and maskName or "Cobra"
                    if LastMaskedState ~= m then
                        LastMaskedState = m
                        TriggerMaskAlert(m, true)
                    end
                end))
            end
            local deactRem = maskedRem:FindFirstChild("Deactivatepower")
            if deactRem then
                table.insert(ScriptConnections, deactRem.OnClientEvent:Connect(function()
                    local prev = LastMaskedState ~= "Richard" and LastMaskedState or nil
                    MaskedActiveEnd = 0
                    MaskedCooldownEnd = os.clock() + 30
                    LastMaskedState = "Richard"
                    if prev then TriggerMaskAlert(prev, false) end
                end))
            end
        end

        -- 5. Abysswalker (Dark Severance: 30s CD & Abyssal Burst: 30s CD)
        local abyssRem = kRem:FindFirstChild("Abysswalker")
        if abyssRem then
            local burstRem = abyssRem:FindFirstChild("corrupt")
            if burstRem then
                table.insert(ScriptConnections, burstRem.OnClientEvent:Connect(function()
                    LastAbyssBurst = true
                    AbyssBurstCooldownEnd = os.clock() + 30
                end))
            end
            -- visualize is the Wave projectile broadcast for Abyssal Burst (Skill 2)
            local waveRem = abyssRem:FindFirstChild("visualize")
            if waveRem then
                table.insert(ScriptConnections, waveRem.OnClientEvent:Connect(function()
                    LastAbyssBurst = true
                    AbyssBurstCooldownEnd = os.clock() + 30
                end))
            end
        end
        local soundPlayerRem = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("SoundPlayer")
        if soundPlayerRem then
            table.insert(ScriptConnections, soundPlayerRem.OnClientEvent:Connect(function(sndId)
                if sndId and tostring(sndId):find("70398808450410") then
                    LastAbyssBurst = true
                    AbyssBurstCooldownEnd = os.clock() + 30
                end
            end))
        end

        -- 6. The Killer (Classic Frenzy: 13s active, 20s CD after active ends)
        local killerRem = kRem:FindFirstChild("Killer")
        if killerRem then
            local actP = killerRem:FindFirstChild("ActivatePower")
            if actP then
                table.insert(ScriptConnections, actP.OnClientEvent:Connect(function()
                    LastKillerFrenzy = true
                    KillerFrenzyActiveEnd = os.clock() + 13
                    KillerFrenzyCooldownEnd = 0
                end))
            end
            local hitEvt = killerRem:FindFirstChild("FrenzyHitEvent")
            if hitEvt then
                table.insert(ScriptConnections, hitEvt.OnClientEvent:Connect(function()
                    if LastKillerFrenzy then
                        KillerFrenzyActiveEnd = os.clock() + 13
                    end
                end))
            end
            local cdEvt = killerRem:FindFirstChild("CooldownEvent") or killerRem:FindFirstChild("Deactivate")
            if cdEvt then
                table.insert(ScriptConnections, cdEvt.OnClientEvent:Connect(function(cdTime)
                    LastKillerFrenzy = false
                    KillerFrenzyActiveEnd = 0
                    local dur = tonumber(cdTime) or 20
                    KillerFrenzyCooldownEnd = os.clock() + dur
                end))
            end
        end

        -- 7. The Butcher (Chain Throw: 15s CD & Bear Trap)
        local butcherRem = kRem:FindFirstChild("Butcher")
        if butcherRem then
            local chainRem = butcherRem:FindFirstChild("ChainThrow")
            if chainRem then
                table.insert(ScriptConnections, chainRem.OnClientEvent:Connect(function()
