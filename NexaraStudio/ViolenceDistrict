-- Comprehensive Config Synchronizer: Runs right after autoload finishes to ensure 100% state consistency
local function SynchronizeConfigState()
    local cv = Window and Window.ConfigValues
    if not cv then return end

    if cv["Skeleton Line Width"] ~= nil then
        Config.KillerSkeletonThickness = tonumber(cv["Skeleton Line Width"]) or Config.KillerSkeletonThickness
        for _, esp in pairs(ESP_Objects) do
            for _, l in pairs(esp.Skeleton) do l.Thickness = Config.KillerSkeletonThickness end
        end
    end
    if cv["Top Killer Skill Size"] ~= nil then
        Config.TopKillerSkillSize = tonumber(cv["Top Killer Skill Size"]) or Config.TopKillerSkillSize
        TopKillerSkillText.Size = Config.TopKillerSkillSize
    end

    if cv["Pallet Max Distance"] ~= nil then
        Config.PalletMaxDist = tonumber(cv["Pallet Max Distance"]) or Config.PalletMaxDist
    end
    if cv["Window Max Distance"] ~= nil then
        Config.WindowMaxDist = tonumber(cv["Window Max Distance"]) or Config.WindowMaxDist
    end
    if cv["Bear Trap Max Distance"] ~= nil then
        Config.BearTrapMaxDist = tonumber(cv["Bear Trap Max Distance"]) or Config.BearTrapMaxDist
    end
    if cv["Field of View (FOV)"] ~= nil then
        Config.FOV = tonumber(cv["Field of View (FOV)"]) or Config.FOV
        if Config.CustomFOVEnabled then
            Camera.FieldOfView = Config.FOV
        end
    end

    if cv["Enable Custom FOV"] ~= nil then
        Config.CustomFOVEnabled = (cv["Enable Custom FOV"] == true)
        if Config.CustomFOVEnabled then
            Camera.FieldOfView = Config.FOV
        end
    end
    if cv["Fullbright (Clear Vision)"] ~= nil then
        Config.Fullbright = (cv["Fullbright (Clear Vision)"] == true)
        if Config.Fullbright then
            ApplyFullbrightNow()
        else
            RestoreOriginalLighting()
        end
    end

    local function syncCol(flag, def)
        local val = cv[flag .. "_Color"]
        local resolved = def
        if type(val) == "table" and #val >= 3 then
            local r = tonumber(val[1]) or 0
            local g = tonumber(val[2]) or 0
            local b = tonumber(val[3]) or 0
            if r > 1 or g > 1 or b > 1 then
                resolved = Color3.fromRGB(math.clamp(math.floor(r), 0, 255), math.clamp(math.floor(g), 0, 255), math.clamp(math.floor(b), 0, 255))
            else
                resolved = Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
            end
        elseif typeof(val) == "Color3" then
            resolved = val
        elseif type(val) == "string" and val:sub(1, 1) == "#" then
            resolved = Color3.fromHex(val)
        end
        cv[flag .. "_Color"] = { math.floor(resolved.R * 255), math.floor(resolved.G * 255), math.floor(resolved.B * 255) }
        if Window and Window.ConfigFlags and Window.ConfigFlags[flag] and Window.ConfigFlags[flag].SetColor then
            pcall(function() Window.ConfigFlags[flag]:SetColor(resolved, true) end)
        end
        return resolved
    end

    Config.Color_Tof_FOV = syncCol("Show FOV Circle", Config.Color_Tof_FOV)
    Config.Color_Tof_Laser = syncCol("Laser Tracer", Config.Color_Tof_Laser)
    Config.Color_Hitmarker = syncCol("Hitmarker", Config.Color_Hitmarker)

    if cv["Hitmarker"] ~= nil then Config.Hitmarker = (cv["Hitmarker"] == true) end
    if cv["Hitmarker Position"] ~= nil then Config.HitmarkerMode = tostring(cv["Hitmarker Position"]) end
    if cv["Hitmarker Sound"] ~= nil then Config.HitmarkerSound = tostring(cv["Hitmarker Sound"]) end
    if cv["Hit Sound Volume"] ~= nil then Config.HitmarkerVolume = tonumber(cv["Hit Sound Volume"]) or Config.HitmarkerVolume end
    if cv["Hit Log"] ~= nil then Config.HitLog = (cv["Hit Log"] == true) end
    if cv["Hit Log Mode"] ~= nil then Config.HitLogType = tostring(cv["Hit Log Mode"]) end

    if cv["Silent Aim"] ~= nil then Config.Tof_SilentAim = (cv["Silent Aim"] == true) end
    if cv["Aimbot"] ~= nil then
        Config.Tof_Aimbot = (cv["Aimbot"] == true)
    end
    if cv["Aimbot Toggle Key"] ~= nil then
        local kn = tostring(cv["Aimbot Toggle Key"])
        Config.Tof_AimKeyName = kn
        if kn == "None" or kn == "" then
            Config.Tof_AimKeyType = "None"
            Config.Tof_AimKeyCode = nil
        elseif kn == "MB3" or kn == "Middle Click" then
            Config.Tof_AimKeyType = "Mouse"
            Config.Tof_AimKeyCode = Enum.UserInputType.MouseButton3
        elseif Enum.KeyCode[kn] then
            Config.Tof_AimKeyType = "Keyboard"
            Config.Tof_AimKeyCode = Enum.KeyCode[kn]
        end
        if TofCombat.AimKeyBtn then TofCombat.AimKeyBtn.Text = "[" .. kn .. "]" end
    end
    if cv["Laser Tracer"] ~= nil then Config.Tof_Laser = (cv["Laser Tracer"] == true) end
    if cv["Target Killer / Player"] ~= nil then Config.Tof_TargetMode = tostring(cv["Target Killer / Player"]) end
    if cv["Show FOV Circle"] ~= nil then Config.Tof_ShowFOV = (cv["Show FOV Circle"] == true) end
    if cv["FOV Radius"] ~= nil then Config.Tof_FOV = tonumber(cv["FOV Radius"]) or Config.Tof_FOV end
    if cv["Aimbot Smoothness"] ~= nil then Config.Tof_AimbotSmooth = tonumber(cv["Aimbot Smoothness"]) or Config.Tof_AimbotSmooth end
    if cv["Laser Beam Duration"] ~= nil then Config.Tof_LaserDuration = tonumber(cv["Laser Beam Duration"]) or Config.Tof_LaserDuration end
    if cv["Show Keybinds List"] ~= nil then
        Config.ShowKeybindsList = (cv["Show Keybinds List"] == true)
        if KeybindsHUD and KeybindsHUD.SetVisible then
            KeybindsHUD.SetVisible(Config.ShowKeybindsList)
        end
        if KeybindsHUD and KeybindsHUD.UpdateSettingToggle then
            KeybindsHUD.UpdateSettingToggle(Config.ShowKeybindsList)
        end
    end
    if TofCombat.RefreshTargetDropdown then TofCombat.RefreshTargetDropdown() end

    Config.Color_SurvivorBox = syncCol("Survivor 2D Boxes", Config.Color_SurvivorBox)
    Config.Color_SurvivorSkeleton = syncCol("Survivor Skeleton", Config.Color_SurvivorSkeleton)
    Config.Color_SurvivorChams = syncCol("Survivor Chams", Config.Color_SurvivorChams)
    Config.Color_SurvivorNames = syncCol("Survivor Names & Distance", Config.Color_SurvivorNames)
    Config.Color_KillerSkeleton = syncCol("Stick Skeleton", Config.Color_KillerSkeleton)
    Config.Color_KillerChams = syncCol("Killer Chams", Config.Color_KillerChams)
    Config.Color_KillerNames = syncCol("Killer Name & Distance", Config.Color_KillerNames)
