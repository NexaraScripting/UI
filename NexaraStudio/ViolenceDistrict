-- ======== SKELETON DRAWER (R6 ANATOMICAL BONES - MODEL ACCURATE) ========
local SKEL_HEAD = Vector3.new(0, 0.4, 0)
local SKEL_NECK = Vector3.new(0, 0.9, 0)
local SKEL_PELVIS = Vector3.new(0, -0.9, 0)
local SKEL_L_SHOULDER = Vector3.new(-1.0, 0.65, 0)
local SKEL_R_SHOULDER = Vector3.new(1.0, 0.65, 0)
local SKEL_ELBOW = Vector3.new(0, 0.05, 0)
local SKEL_HAND = Vector3.new(0, -0.9, 0)
local SKEL_L_HIP = Vector3.new(-0.5, -0.95, 0)
local SKEL_R_HIP = Vector3.new(0.5, -0.95, 0)
local SKEL_KNEE = Vector3.new(0, 0.05, 0)
local SKEL_FOOT = Vector3.new(0, -0.95, 0)

local function getSkelPoint(cf, offset)
    local p = cf:PointToWorldSpace(offset)
    local sp, vis = Camera:WorldToViewportPoint(p)
    return Vector2.new(math.floor(sp.X), math.floor(sp.Y)), (vis and sp.Z > 0)
end

local function drawSkelLine(line, p1, v1, p2, v2, color, th)
    if not line then return end
    if v1 and v2 and p1 and p2 then
        line.From = p1
        line.To = p2
        if line.Color ~= color then line.Color = color end
        if line.Thickness ~= th then line.Thickness = th end
        if not line.Visible then line.Visible = true end
    else
        if line.Visible then line.Visible = false end
    end
end

local function UpdateSkeleton(char, lines, color, thickness)
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("leftarm") or char:FindFirstChild("LeftUpperArm")
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("rightarm") or char:FindFirstChild("RightUpperArm")
    local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("leftleg") or char:FindFirstChild("LeftUpperLeg")
    local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("rightleg") or char:FindFirstChild("RightUpperLeg")

    if not (head and torso) then
        for _, l in pairs(lines) do if l.Visible then l.Visible = false end end
        return false, nil, nil
    end

    local th = thickness or 1.3

    -- Core Spine
    local headPos, hVis = getSkelPoint(head.CFrame, SKEL_HEAD)
    local neckPos, nVis = getSkelPoint(torso.CFrame, SKEL_NECK)
    local pelvisPos, pVis = getSkelPoint(torso.CFrame, SKEL_PELVIS)

    drawSkelLine(lines.Head, headPos, hVis, neckPos, nVis, color, th)
    drawSkelLine(lines.Spine, neckPos, nVis, pelvisPos, pVis, color, th)

    -- Left Arm (Anatomical: Neck -> Left Shoulder -> Left Elbow -> Left Hand)
    local lShoulderPos, lsVis = getSkelPoint(torso.CFrame, SKEL_L_SHOULDER)
    drawSkelLine(lines.LeftCollar, neckPos, nVis, lShoulderPos, lsVis, color, th)
    if leftArm then
        local lElbowPos, leVis = getSkelPoint(leftArm.CFrame, SKEL_ELBOW)
        local lHandPos, lhVis = getSkelPoint(leftArm.CFrame, SKEL_HAND)
        drawSkelLine(lines.LeftArmUpper, lShoulderPos, lsVis, lElbowPos, leVis, color, th)
        drawSkelLine(lines.LeftArmLower, lElbowPos, leVis, lHandPos, lhVis, color, th)
    else
        if lines.LeftArmUpper and lines.LeftArmUpper.Visible then lines.LeftArmUpper.Visible = false end
        if lines.LeftArmLower and lines.LeftArmLower.Visible then lines.LeftArmLower.Visible = false end
    end

    -- Right Arm (Anatomical: Neck -> Right Shoulder -> Right Elbow -> Right Hand)
    local rShoulderPos, rsVis = getSkelPoint(torso.CFrame, SKEL_R_SHOULDER)
    drawSkelLine(lines.RightCollar, neckPos, nVis, rShoulderPos, rsVis, color, th)
    if rightArm then
        local rElbowPos, reVis = getSkelPoint(rightArm.CFrame, SKEL_ELBOW)
        local rHandPos, rhVis = getSkelPoint(rightArm.CFrame, SKEL_HAND)
        drawSkelLine(lines.RightArmUpper, rShoulderPos, rsVis, rElbowPos, reVis, color, th)
        drawSkelLine(lines.RightArmLower, rElbowPos, reVis, rHandPos, rhVis, color, th)
    else
        if lines.RightArmUpper and lines.RightArmUpper.Visible then lines.RightArmUpper.Visible = false end
        if lines.RightArmLower and lines.RightArmLower.Visible then lines.RightArmLower.Visible = false end
    end

    -- Left Leg (Anatomical: Pelvis -> Left Hip -> Left Knee -> Left Foot)
    local lHipPos, lhipVis = getSkelPoint(torso.CFrame, SKEL_L_HIP)
    drawSkelLine(lines.LeftPelvis, pelvisPos, pVis, lHipPos, lhipVis, color, th)
    local lowestLegPos = pelvisPos
    if leftLeg then
        local lKneePos, lkVis = getSkelPoint(leftLeg.CFrame, SKEL_KNEE)
        local lFootPos, lfVis = getSkelPoint(leftLeg.CFrame, SKEL_FOOT)
        drawSkelLine(lines.LeftLegUpper, lHipPos, lhipVis, lKneePos, lkVis, color, th)
        drawSkelLine(lines.LeftLegLower, lKneePos, lkVis, lFootPos, lfVis, color, th)
        if lfVis then lowestLegPos = lFootPos end
    else
        if lines.LeftLegUpper and lines.LeftLegUpper.Visible then lines.LeftLegUpper.Visible = false end
        if lines.LeftLegLower and lines.LeftLegLower.Visible then lines.LeftLegLower.Visible = false end
    end

    -- Right Leg (Anatomical: Pelvis -> Right Hip -> Right Knee -> Right Foot)
    local rHipPos, rhipVis = getSkelPoint(torso.CFrame, SKEL_R_HIP)
    drawSkelLine(lines.RightPelvis, pelvisPos, pVis, rHipPos, rhipVis, color, th)
    if rightLeg then
        local rKneePos, rkVis = getSkelPoint(rightLeg.CFrame, SKEL_KNEE)
        local rFootPos, rfVis = getSkelPoint(rightLeg.CFrame, SKEL_FOOT)
        drawSkelLine(lines.RightLegUpper, rHipPos, rhipVis, rKneePos, rkVis, color, th)
        drawSkelLine(lines.RightLegLower, rKneePos, rkVis, rFootPos, rfVis, color, th)
        if rfVis and not lowestLegPos then lowestLegPos = rFootPos end
    else
        if lines.RightLegUpper and lines.RightLegUpper.Visible then lines.RightLegUpper.Visible = false end
        if lines.RightLegLower and lines.RightLegLower.Visible then lines.RightLegLower.Visible = false end
    end

    return (hVis or pVis), headPos, lowestLegPos
end

-- ======== ESP RENDERING (CAMERA POST-UPDATE) ========
local RenderESP
do
local seenGens = {}
local seenPallets = {}
local seenWindows = {}
local seenGates = {}
local wasInLobby = false
local lastPalletSortTime = 0
local cachedPalletEntries = {}
local function sortPalletByDist(a, b) return a.Dist < b.Dist end
local lastPalletCheckTime = 0
local cachedDroppingHRPPos = nil

local menuPos = nil
local menuSize = nil
local function IsInMenu(sx, sy)
    if not menuPos or not menuSize then return false end
    return sx >= (menuPos.X - 20) and sx <= (menuPos.X + menuSize.X + 20) and sy >= (menuPos.Y - 45) and sy <= (menuPos.Y + menuSize.Y + 20)
end

function RenderESP()
    pcall(function()
        Camera = Workspace.CurrentCamera or Camera
        local inLobby = IsInLobby()
        local inCutscene = IsCutsceneActive()

        if inCutscene or (inLobby and not Config.ESP_LobbyEnabled) then
            HideAllESP()
            return
        end

        if inLobby and not wasInLobby then
            HideAllESP()
            table.clear(KillerPortraitCache)
            table.clear(PlayerItemCooldowns)
            table.clear(PlayerItemCache)
            table.clear(DroppedPallets)
            table.clear(BrokenPallets)
            table.clear(BlockedWindows)
            table.clear(BlockedWindowPositions)
            table.clear(cachedPalletEntries)
            lastPalletSortTime = 0
        end
        wasInLobby = inLobby
        local myRoot = GetRoot(LocalPlayer)
        local camPos = Camera.CFrame.Position
        local myPos = myRoot and myRoot.Position or camPos

        local mainFrame = Window and (Window.MainFrame or Window.Main)
        menuPos = (Window and Window.Visible and mainFrame and mainFrame.Visible) and mainFrame.AbsolutePosition or nil
        menuSize = menuPos and mainFrame.AbsoluteSize or nil

        -- Top Screen Killer Skill (Rendered directly under in-game match timer, hidden in lobby, post-match, or when playing as Killer)
        if not inLobby and not IsKiller(LocalPlayer) and Config.ESP_KillerEnabled and Config.ESP_KillerSkills then
            local killerPlr = nil
            local killerData = nil
            for p, _ in pairs(ESP_Objects) do
                local data = CachedPlayerData[p]
                if (data and data.IsKiller) or IsKiller(p) then
                    killerPlr = p
                    killerData = data
                    break
                end
            end

            if killerPlr and killerPlr.Character and killerPlr ~= LocalPlayer then
                local kSkillStr = killerData and killerData.SkillInfo
                if type(kSkillStr) == "string" and #kSkillStr > 0 then
                    local posX = math.floor(Camera.ViewportSize.X / 2)
                    local posY = math.max(tonumber(Config.TopKillerSkillYOffset) or 58, 54)
                    local timerEnded = false

                    local tl = GetMatchTimerLabel()
                    if tl and (tl.Text == "00:00" or tl.Text == "0:00") then
                        timerEnded = true
                    end

                    if timerEnded then
                        if TopKillerSkillText.Visible then TopKillerSkillText.Visible = false end
                    else
                        TopKillerSkillText.Size = Config.TopKillerSkillSize or 16
                        if TopKillerSkillText.Text ~= kSkillStr then
                            TopKillerSkillText.Text = kSkillStr
                        end
                        TopKillerSkillText.Position = Vector2.new(posX, posY)
                        TopKillerSkillText.Color = Config.Color_KillerSkills or Color3.fromRGB(80, 220, 255)
                        if not TopKillerSkillText.Visible then TopKillerSkillText.Visible = true end
                    end
                elseif TopKillerSkillText.Visible then
                    TopKillerSkillText.Visible = false
                end
            elseif TopKillerSkillText.Visible then
                TopKillerSkillText.Visible = false
            end
        elseif TopKillerSkillText.Visible then
            TopKillerSkillText.Visible = false
        end

        -- 1. Player ESP (Separated: Killer ESP vs Survivor ESP vs Lobby Players)
        for player, esp in pairs(ESP_Objects) do
            local isLocalMe = (player == LocalPlayer)
            local char = player.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
            local data = CachedPlayerData[player]
            local isDead = IsPlayerDead(player)
            local isLobbyPlr = IsPlayerInLobby(player)

            local shouldHide = isLocalMe or isDead or (not inLobby and isLobbyPlr) or (inLobby and not Config.ESP_LobbyEnabled)

            if not shouldHide and char and root and char:FindFirstChild("Head") then
                local isK = not inLobby and ((data and data.IsKiller) or IsKiller(player))
                local rootPos = root.Position
                local rootScreen, onScreen = Camera:WorldToViewportPoint(rootPos)
                local headScreen = Camera:WorldToViewportPoint(char.Head.Position)

                if onScreen and not IsInMenu(rootScreen.X, rootScreen.Y) and not IsInMenu(headScreen.X, headScreen.Y) then
                    esp.IsHidden = false
                    local dist = (myPos - rootPos).Magnitude
                    local currentX = math.floor(rootScreen.X)
                    local currentY = 0

                -- KILLER ESP BRANCH
                if isK and not inLobby then
                    if Config.ESP_KillerEnabled then
                        -- Hide 2D Box
                        if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                        if esp.Box.Visible then esp.Box.Visible = false end

                        -- Render Hot Pink Skeleton (Thin & sleek, model-accurate)
                        local topY = headScreen.Y - 14
                        local btmY = rootScreen.Y + 18
                        if Config.ESP_KillerSkeleton then
                            local anyVis, hPoint, fPoint = UpdateSkeleton(char, esp.Skeleton, Config.Color_KillerSkeleton or Color3.fromRGB(240, 60, 160), Config.KillerSkeletonThickness or 1.3)
                            currentX = hPoint and hPoint.X or currentX
                            topY = hPoint and (hPoint.Y - 14) or (headScreen.Y - 14)
                            btmY = fPoint and (fPoint.Y + 4) or (rootScreen.Y + 18)
                        else
                            for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                        end

                        -- Killer Chams (Soft, non-opaque highlight)
                        if Config.ESP_KillerChams then
                            local hl = esp.Chams
                            local aCol = Config.Color_KillerChams or Color3.fromRGB(255, 60, 60)
                            if not hl or not hl.Parent then
                                hl = Instance.new("Highlight")
                                hl.Name = "Nexara_PlayerChams"
                                hl.FillColor = aCol
                                hl.OutlineColor = aCol
                                hl.FillTransparency = 0.78
                                hl.OutlineTransparency = 0.45
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.Adornee = char
                                pcall(function() hl.Parent = char end)
                                esp.Chams = hl
                            else
                                if hl.Adornee ~= char then hl.Adornee = char end
                                if hl.FillColor ~= aCol then
                                    hl.FillColor = aCol
                                    hl.OutlineColor = aCol
                                end
                            end
                            if not hl.Enabled then hl.Enabled = true end
                        elseif esp.Chams and esp.Chams.Enabled then
                            esp.Chams.Enabled = false
                        end

                        -- Top Text: Player Name [Distance] (Clean, no [KILLER] prefix)
                        if Config.ESP_KillerNames then
                            local topStr = (data and data.DisplayName or player.DisplayName) .. " [" .. math.floor(dist) .. "m]"
                            if esp.TopText.Text ~= topStr then esp.TopText.Text = topStr end
                            esp.TopText.Position = Vector2.new(currentX, topY)
                            esp.TopText.Color = Config.Color_KillerNames or Color3.fromRGB(255, 60, 160)
                            if not esp.TopText.Visible then esp.TopText.Visible = true end
                        elseif esp.TopText.Visible then
                            esp.TopText.Visible = false
                        end

                        -- Bottom Text: [KILLER] KillerType (No CHASING)
                        if Config.ESP_KillerNames then
                            local kType = player:GetAttribute("SelectedKiller") or "The Killer"
                            local btmStr = "[KILLER] " .. kType
                            if char:GetAttribute("IsStunned") == true then btmStr = btmStr .. " [STUNNED]" end
                            if char:GetAttribute("IsCarrying") == true then btmStr = btmStr .. " [CARRYING]" end

                            if esp.BottomText.Text ~= btmStr then esp.BottomText.Text = btmStr end
                            esp.BottomText.Position = Vector2.new(currentX, btmY)
                            esp.BottomText.Color = Color3.fromRGB(255, 255, 255)
                            if not esp.BottomText.Visible then esp.BottomText.Visible = true end
                            currentY = btmY + 14
                        elseif esp.BottomText.Visible then
                            esp.BottomText.Visible = false
                            currentY = btmY + 14
                        end

                        -- Perks Text
                        if Config.ESP_KillerPerks then
                            local perksFmt = data and data.PerksFormatted
                            if perksFmt and #perksFmt > 0 then
                                local pStr = "Perks: " .. perksFmt
                                if esp.PerkText.Text ~= pStr then esp.PerkText.Text = pStr end
                                esp.PerkText.Position = Vector2.new(currentX, currentY)
                                esp.PerkText.Color = Color3.fromRGB(255, 120, 140)
                                if not esp.PerkText.Visible then esp.PerkText.Visible = true end
                                currentY = currentY + 14
                            elseif esp.PerkText.Visible then
                                esp.PerkText.Visible = false
                            end
                        elseif esp.PerkText.Visible then
                            esp.PerkText.Visible = false
                        end

                        -- Skills & Charges Text (Moved under top match timer)
                        if esp.SkillText.Visible then esp.SkillText.Visible = false end
                    else
                        hidePlayerESP(esp)
                    end

                -- SURVIVOR OR LOBBY BRANCH
                else
                    local allowESP = inLobby and (Config.ESP_LobbyEnabled ~= false) or (not inLobby and Config.ESP_SurvivorEnabled and not isLobbyPlr and not isDead)
                    if allowESP then
                        -- Carrying detection: suppress box and all intrusive drawings ONLY if this survivor is truly being carried
                        local isBeingCarriedByMe = false
                        if not inLobby and IsKiller(LocalPlayer) then
                            local myChar = GetCharacter()
                            local myIsCarrying = (myChar and myChar:GetAttribute("IsCarrying") == true)
                            local hasCarryTime = (char:GetAttribute("RemainingCarryTime") ~= nil)
                            local isCarriedAttr = (char:GetAttribute("IsCarried") == true or char:GetAttribute("Carried") == true)
                            if (myIsCarrying and dist <= 7) or (hasCarryTime and dist <= 7) or (isCarriedAttr and dist <= 7) then
                                isBeingCarriedByMe = true
                            end
                        end

                        -- Survivor Skeleton
                        if (not isBeingCarriedByMe) and Config.ESP_SurvivorSkeleton then
                            UpdateSkeleton(char, esp.Skeleton, Config.Color_SurvivorSkeleton or Color3.fromRGB(80, 255, 160), Config.SurvivorSkeletonThickness or 1.3)
                        else
                            for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                        end

                        -- Survivor Chams (Soft, non-opaque highlight)
                        if (not isBeingCarriedByMe) and Config.ESP_SurvivorChams then
                            local hl = esp.Chams
                            local aCol = inLobby and Color3.fromRGB(0, 210, 255) or (Config.Color_SurvivorChams or Color3.fromRGB(80, 255, 120))
                            if not hl or not hl.Parent then
                                hl = Instance.new("Highlight")
                                hl.Name = "Nexara_PlayerChams"
                                hl.FillColor = aCol
                                hl.OutlineColor = aCol
                                hl.FillTransparency = 0.78
                                hl.OutlineTransparency = 0.45
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.Adornee = char
                                pcall(function() hl.Parent = char end)
                                esp.Chams = hl
                            else
                                if hl.Adornee ~= char then hl.Adornee = char end
                                if hl.FillColor ~= aCol then
                                    hl.FillColor = aCol
                                    hl.OutlineColor = aCol
                                end
                            end
                            if not hl.Enabled then hl.Enabled = true end
                        elseif esp.Chams and esp.Chams.Enabled then
                            esp.Chams.Enabled = false
                        end

                        local head = char:FindFirstChild("Head")
                        local topWorld = head and (head.Position + Vector3.new(0, 0.6, 0)) or (rootPos + Vector3.new(0, 1.9, 0))
                        local btmWorld = rootPos - Vector3.new(0, 2.5, 0)
                        local topScreen, topVis = Camera:WorldToViewportPoint(topWorld)
                        local btmScreen, btmVis = Camera:WorldToViewportPoint(btmWorld)

                        if topScreen.Z > 0 and btmScreen.Z > 0 then
                            local col = inLobby and Color3.fromRGB(0, 210, 255) or (Config.Color_SurvivorBox or Color3.fromRGB(80, 255, 120))

                            local boxHeight = math.floor(math.abs(btmScreen.Y - topScreen.Y))
                            local boxWidth = math.floor(boxHeight * 0.55)
                            local boxX = math.floor(rootScreen.X - boxWidth * 0.5)
                            local boxY = math.floor(math.min(topScreen.Y, btmScreen.Y))

                            local showBox = (not isBeingCarriedByMe) and (inLobby and (Config.ESP_LobbyBoxes ~= false) or Config.ESP_SurvivorBoxes)
                            if showBox then
                                local boxPos = Vector2.new(boxX, boxY)
                                local boxSize = Vector2.new(boxWidth, boxHeight)

                                esp.BoxOutline.Size = boxSize
                                esp.BoxOutline.Position = boxPos
                                if not esp.BoxOutline.Visible then esp.BoxOutline.Visible = true end

                                esp.Box.Size = boxSize
                                esp.Box.Position = boxPos
                                esp.Box.Color = col
                                if not esp.Box.Visible then esp.Box.Visible = true end
                            else
                                if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                                if esp.Box.Visible then esp.Box.Visible = false end
                            end

                            -- Status check (Hooked, Carried, Down, Injured)
                            local statusText = nil
                            local statusColor = nil
                            if not inLobby and Config.ESP_SurvivorStatus then
                                local isHooked = (char:GetAttribute("IsHooked") == true) or (CollectionService and CollectionService:HasTag(char, "Hooked"))
                                local isCarried = (char:GetAttribute("IsCarried") == true) or (char:GetAttribute("Carried") == true)
                                local isDown = (char:GetAttribute("Knocked") == true) or (CollectionService and CollectionService:HasTag(char, "Knocked"))
                                local hum = char:FindFirstChildOfClass("Humanoid")
                                if isHooked then
                                    statusText = "[HOOKED]"
                                    statusColor = Color3.fromRGB(255, 60, 60)
                                elseif isCarried then
                                    statusText = "[CARRIED]"
                                    statusColor = Color3.fromRGB(255, 170, 0)
                                elseif isDown then
                                    statusText = "[DOWN]"
                                    statusColor = Color3.fromRGB(255, 85, 85)
                                elseif hum and hum.Health < 99 then
                                    statusText = "[Injured]"
                                    statusColor = Color3.fromRGB(255, 215, 0) -- Fixed Yellow
                                end
                            end

                            -- Top Text: Player Name [Distance] (Clean, no [SURVIVOR] prefix)
                            local showNames = (not isBeingCarriedByMe) and (inLobby and (Config.ESP_LobbyNames ~= false) or (Config.ESP_SurvivorNames or Config.ESP_SurvivorDistance))
                            if showNames then
                                local topStr = (data and data.DisplayName or player.DisplayName)
                                if not inLobby then
                                    topStr = topStr .. " [" .. math.floor(dist) .. "m]"
                                end
                                if esp.TopText.Text ~= topStr then esp.TopText.Text = topStr end
                                esp.TopText.Position = Vector2.new(rootScreen.X, boxY - 14)
                                local nameCol = inLobby and Color3.fromRGB(0, 210, 255) or (Config.Color_SurvivorNames or Color3.fromRGB(80, 255, 120))
                                if esp.TopText.Color ~= nameCol then esp.TopText.Color = nameCol end
                                if not esp.TopText.Visible then esp.TopText.Visible = true end
                            elseif esp.TopText.Visible then
                                esp.TopText.Visible = false
                            end

                            -- Bottom: Under the feet (Status [Injured] -> Item -> Perks)
                            local currentY = boxY + boxHeight + 2

                            -- Status Text: Positioned directly under feet
                            if (not isBeingCarriedByMe) and statusText then
                                if esp.BottomText.Text ~= statusText then esp.BottomText.Text = statusText end
                                esp.BottomText.Position = Vector2.new(rootScreen.X, currentY)
                                esp.BottomText.Color = statusColor
                                if not esp.BottomText.Visible then esp.BottomText.Visible = true end
                                currentY = currentY + 14
                            elseif esp.BottomText.Visible then
                                esp.BottomText.Visible = false
                            end

                            -- Survivor Item & Status
                            local sSkillStr = data and data.SkillInfo
                            local isItemReady = data and data.ItemReady
                            if (not isBeingCarriedByMe) and Config.ESP_SurvivorSkills and not inLobby and type(sSkillStr) == "string" and #sSkillStr > 0 then
                                if esp.SkillText.Text ~= sSkillStr then esp.SkillText.Text = sSkillStr end
                                esp.SkillText.Position = Vector2.new(rootScreen.X, currentY)
                                local sCol = (isItemReady == false and Color3.fromRGB(255, 75, 75)) or (isItemReady == true and Color3.fromRGB(80, 255, 80)) or Color3.fromRGB(80, 220, 255)
                                if esp.SkillText.Color ~= sCol then esp.SkillText.Color = sCol end
                                if not esp.SkillText.Visible then esp.SkillText.Visible = true end
                                currentY = currentY + 14
                            elseif esp.SkillText.Visible then
                                esp.SkillText.Visible = false
                            end

                            -- Survivor Perks
                            if Config.ESP_SurvivorPerks then
                                local perksFmt = data and data.PerksFormatted
                                if perksFmt and #perksFmt > 0 then
                                    if esp.PerkText.Text ~= perksFmt then esp.PerkText.Text = perksFmt end
                                    esp.PerkText.Position = Vector2.new(rootScreen.X, currentY)
                                    esp.PerkText.Color = Color3.fromRGB(120, 220, 255)
                                    if not esp.PerkText.Visible then esp.PerkText.Visible = true end
                                    currentY = currentY + 14
                                elseif esp.PerkText.Visible then
                                    esp.PerkText.Visible = false
                                end
                            elseif esp.PerkText.Visible then
                                esp.PerkText.Visible = false
                            end
                        else
                            hidePlayerESP(esp)
                        end
                    else
                        hidePlayerESP(esp)
                    end
                end
            else
                hidePlayerESP(esp)
            end
        else
            hidePlayerESP(esp)
        end
    end

    -- 2. Generator ESP
    table.clear(seenGens)
    if not inLobby and Config.ESP_Generators then
        for _, item in ipairs(CachedGenerators) do
            local gen = item.Model
            local root = item.Part
            if gen and gen.Parent and root and root.Parent then
                seenGens[gen] = true
                local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local txt = GenDrawings[gen]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 13
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    GenDrawings[gen] = txt
                end

                if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                    local dist = math.floor((myPos - root.Position).Magnitude)
                    local prog = tonumber(gen:GetAttribute("RepairProgress")) or 0
                    local repairers = tonumber(gen:GetAttribute("PlayersRepairingCount")) or 0

                    local label = "Generator " .. dist .. "m"
                    if Config.ESP_GenProgress then
                        label = string.format("Generator [%d%%] %dm", math.floor(prog), dist)
                        if repairers > 0 then label = label .. " (Repairing)" end
                    end

                    if txt.Text ~= label then txt.Text = label end
                    txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))

                    local gCol = (prog >= 100 and Color3.fromRGB(0, 240, 255))
                              or (repairers > 0 and Color3.fromRGB(255, 215, 0))
                              or (Config.Color_Generators or Color3.fromRGB(255, 200, 50))
                    if txt.Color ~= gCol then txt.Color = gCol end
                    if not txt.Visible then txt.Visible = true end
                elseif txt.Visible then
                    txt.Visible = false
                end
            end
        end
    end
    for gen, txt in pairs(GenDrawings) do
        if not seenGens[gen] and txt.Visible then txt.Visible = false end
    end

    -- 3. Pallet ESP & 3D Glowing Aura
    table.clear(seenPallets)
    if not inLobby and (Config.ESP_Pallets or Config.ESP_PalletAura) then
        -- Killer proximity breaking check (throttled to 0.1s to avoid N*M iterations at 144Hz)
        local nowTime = os.clock()
        if nowTime - lastPalletCheckTime > 0.1 then
            lastPalletCheckTime = nowTime
            for _, p in ipairs(Players:GetPlayers()) do
                if IsKiller(p) then
                    local kChar = p.Character
                    if kChar then
                        local isBreaking = kChar:GetAttribute("isBreakingPallet") == true
                                        or kChar:GetAttribute("isBreaking") == true
                                        or (kChar:GetAttribute("action") == true and kChar:GetAttribute("Immobile") == true)
                        if isBreaking then
                            local kRoot = kChar:FindFirstChild("HumanoidRootPart")
                            if kRoot then
                                local kPos = kRoot.Position
                                for _, item in ipairs(CachedPallets) do
                                    local pModel = item.Model
                                    local pRoot = item.Part
                                    if pModel and pRoot and pRoot.Parent and (pRoot.Position - kPos).Magnitude < 10 then
                                        MarkPalletBroken(pModel)
                                    end
                                end
                            end
                        end
                    end
                    break
                end
            end

            cachedDroppingHRPPos = nil
            for _, p in ipairs(Players:GetPlayers()) do
                local c = p.Character
                if c and (c:GetAttribute("isDroppingPallet") == true or c:GetAttribute("IsDroppingPallet") == true) then
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if r then cachedDroppingHRPPos = r.Position; break end
                end
            end
        end
        local droppingHRPPos = cachedDroppingHRPPos

        -- Throttled distance sorting (every 0.3s) - reuses pre-allocated entries to eliminate GC churn
        if (nowTime - lastPalletSortTime > 0.3) or (#cachedPalletEntries == 0) then
            lastPalletSortTime = nowTime
            local validCount = 0
            for _, item in ipairs(CachedPallets) do
                local pallet = item.Model
                local root = item.Part
                if pallet and pallet.Parent and root and root.Parent and not IsPalletBroken(pallet, root) then
                    local dist = (myPos - root.Position).Magnitude
                    validCount = validCount + 1
                    local entry = cachedPalletEntries[validCount]
                    if not entry then
                        entry = { Item = item, Dist = dist }
                        cachedPalletEntries[validCount] = entry
                    else
                        entry.Item = item
                        entry.Dist = dist
                    end
                else
                    if pallet then MarkPalletBroken(pallet) end
                end
            end
            for i = #cachedPalletEntries, validCount + 1, -1 do
                cachedPalletEntries[i] = nil
            end
            table.sort(cachedPalletEntries, sortPalletByDist)
        end

        for idx, entry in ipairs(cachedPalletEntries) do
            local item = entry.Item
            local pallet = item.Model
            local root = item.Part
            if pallet and pallet.Parent and root and root.Parent and not IsPalletBroken(pallet, root) then
                seenPallets[pallet] = true
                local dist = (myPos - root.Position).Magnitude

                -- 3D Glowing Aura through walls (Wood pallet only, capped at closest 14 to avoid Roblox 31 highlight limit)
                if Config.ESP_PalletAura and idx <= 14 and dist <= Config.PalletMaxDist then
                    local targetAdornee = item.PalletWood or pallet
                    local hl = PalletAuras[pallet]
                    local aCol = Config.Color_PalletAura or Color3.fromRGB(255, 205, 90)
                    if not hl or not hl.Parent then
                        hl = Instance.new("Highlight")
                        hl.Name = "Nexara_PalletAura"
                        hl.FillColor = aCol
                        hl.OutlineColor = aCol
                        hl.FillTransparency = 0.82
                        hl.OutlineTransparency = 0.5
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = targetAdornee
                        pcall(function() hl.Parent = targetAdornee end)
                        PalletAuras[pallet] = hl
                    else
                        if hl.Adornee ~= targetAdornee then hl.Adornee = targetAdornee end
                        if hl.FillColor ~= aCol then
                            hl.FillColor = aCol
                            hl.OutlineColor = aCol
                        end
                    end
                    if not hl.Enabled then hl.Enabled = true end
                elseif PalletAuras[pallet] and PalletAuras[pallet].Enabled then
                    PalletAuras[pallet].Enabled = false
                end

                -- Distance Text
                if Config.ESP_Pallets and dist <= Config.PalletMaxDist then
                    local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                        local txt = PalletDrawings[pallet]
                        if not txt then
                            txt = Drawing.new("Text")
                            txt.Size = 12
                            txt.Center = true
                            txt.Outline = true
                            txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                            PalletDrawings[pallet] = txt
                        end
                        local isDropped = IsPalletDropped(pallet, root)
                        local isDropping = droppingHRPPos and ((droppingHRPPos - root.Position).Magnitude < 7) or false

                        local mDist = math.floor(dist)
                        local pText = isDropping and ("Pallet Dropping " .. mDist .. "m")
                                   or isDropped and ("Pallet [Dropped] " .. mDist .. "m")
                                   or ("Pallet " .. mDist .. "m")
                        local pCol = isDropping and Color3.fromRGB(255, 80, 80)
                                  or isDropped and Color3.fromRGB(255, 140, 40)
                                  or (Config.Color_PalletNames or Color3.fromRGB(255, 180, 50))

                        if txt.Text ~= pText then txt.Text = pText end
                        if txt.Color ~= pCol then txt.Color = pCol end
                        txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                        if not txt.Visible then txt.Visible = true end
                    elseif PalletDrawings[pallet] and PalletDrawings[pallet].Visible then
                        PalletDrawings[pallet].Visible = false
                    end
                elseif PalletDrawings[pallet] and PalletDrawings[pallet].Visible then
                    PalletDrawings[pallet].Visible = false
                end
            end
        end
    end
    for pallet, hl in pairs(PalletAuras) do
        if not seenPallets[pallet] or inLobby or not Config.ESP_PalletAura or IsPalletBroken(pallet) then
            if hl.Enabled then hl.Enabled = false end
            if IsPalletBroken(pallet) then
                pcall(function() hl:Destroy() end)
                PalletAuras[pallet] = nil
            end
        end
    end
    for pallet, txt in pairs(PalletDrawings) do
        if not seenPallets[pallet] or not Config.ESP_Pallets or IsPalletBroken(pallet) then
            if txt.Visible then txt.Visible = false end
            if IsPalletBroken(pallet) then
                pcall(function() txt:Remove() end)
                PalletDrawings[pallet] = nil
            end
        end
    end

    -- 4. Window / Vault ESP & 3D Glowing Aura
    table.clear(seenWindows)
    if not inLobby and (Config.ESP_Windows or Config.ESP_WindowAura) then
        local wAuraCol = Config.Color_WindowAura or Color3.fromRGB(0, 210, 255)
        local wGlowCol = wAuraCol:Lerp(Color3.new(1, 1, 1), 0.35)

        for _, item in ipairs(CachedWindows) do
            local win = item.Model or item.Part
            local root = item.Part
            local ledge = item.VaultLedge or root
            if win and win.Parent and ledge and ledge.Parent then
                local dist = (myPos - root.Position).Magnitude
                if dist <= Config.WindowMaxDist then
                    seenWindows[win] = true
                    local sillType = item.SillType or "Auto"
                    local offsetY = ((sillType == "Trigger" or sillType == "InvisWall") and ledge.Size.Y >= 4.5) and (-(ledge.Size.Y - 2.8) / 2) or 0

                    -- Check blocked status & countdown timer
                    local isBlocked, blockTimeLeft = GetWindowBlockTime(win, root, ledge)
                    local activeBoxColor = isBlocked and Color3.fromRGB(255, 50, 50) or wAuraCol
                    local activeGlowColor = isBlocked and Color3.fromRGB(255, 100, 100) or wGlowCol

                    -- 3D Glowing Vault Sill (Dual-Layer Hologram: Solid Core + Neon Outer Glow)
                    if Config.ESP_WindowAura then
                        local sillSize, sillOffset
                        if ledge.Name == "Bottom" then
                            sillSize = ledge.Size
                            sillOffset = CFrame.new(0, 0, 0)
                        else
                            local rawW = math.max(ledge.Size.X, ledge.Size.Z)
                            local rawT = math.min(ledge.Size.X, ledge.Size.Z)
                            local width = math.clamp(rawW, 3.8, 6.0)
                            local thickness = math.clamp(rawT, 0.8, 2.0)
                            local height = (ledge.Size.Y >= 1.2 and ledge.Size.Y <= 4.0) and ledge.Size.Y or 2.8
                            sillSize = (ledge.Size.X >= ledge.Size.Z) and Vector3.new(width, height, thickness) or Vector3.new(thickness, height, width)
                            sillOffset = CFrame.new(0, offsetY, 0)
                        end

                        -- Layer 1: Core BoxHandleAdornment
                        local bha = WindowAdornments[win]
                        if not bha or not bha.Parent or not bha:IsA("BoxHandleAdornment") then
                            bha = Instance.new("BoxHandleAdornment")
                            bha.Name = "Nexara_WindowBox"
                            bha.AlwaysOnTop = true
                            bha.ZIndex = 8
                            bha.Adornee = ledge
                            bha.Size = sillSize
                            bha.CFrame = sillOffset
                            bha.Color3 = activeBoxColor
                            bha.Transparency = 0.85
                            bha.Parent = ledge
                            WindowAdornments[win] = bha
                        else
                            if bha.Adornee ~= ledge then bha.Adornee = ledge end
                            if bha.Size ~= sillSize then bha.Size = sillSize end
                            if bha.CFrame ~= sillOffset then bha.CFrame = sillOffset end
                            if bha.Color3 ~= activeBoxColor then bha.Color3 = activeBoxColor end
                        end
                        if not bha.Visible then bha.Visible = true end

                        -- Layer 2: Outer Glow Shell BoxHandleAdornment (Stored in WindowAuras)
                        local glow = WindowAuras[win]
                        if not glow or not glow.Parent or not glow:IsA("BoxHandleAdornment") then
                            if glow and glow:IsA("Highlight") then
                                pcall(function() glow:Destroy() end)
                            end

                            glow = Instance.new("BoxHandleAdornment")
                            glow.Name = "Nexara_WindowGlow"
                            glow.AlwaysOnTop = true
                            glow.ZIndex = 7
                            glow.Adornee = ledge
                            glow.Size = sillSize + Vector3.new(0.12, 0.12, 0.12)
                            glow.CFrame = sillOffset
                            glow.Color3 = activeGlowColor
                            glow.Transparency = 0.92
                            glow.Parent = ledge
                            WindowAuras[win] = glow
                        else
                            if glow.Adornee ~= ledge then glow.Adornee = ledge end
                            if glow.Size ~= (sillSize + Vector3.new(0.12, 0.12, 0.12)) then glow.Size = sillSize + Vector3.new(0.12, 0.12, 0.12) end
                            if glow.CFrame ~= sillOffset then glow.CFrame = sillOffset end
                            if glow.Color3 ~= activeGlowColor then glow.Color3 = activeGlowColor end
                        end
                        if not glow.Visible then glow.Visible = true end
                    else
                        if WindowAdornments[win] and WindowAdornments[win].Visible then WindowAdornments[win].Visible = false end
                        if WindowAuras[win] and WindowAuras[win].Visible then WindowAuras[win].Visible = false end
                    end

                    -- Distance Text & Block Timer
                    local txt = WindowDrawings[win]
                    if not txt then
                        txt = Drawing.new("Text")
                        txt.Size = 12
                        txt.Center = true
                        txt.Outline = true
                        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                        WindowDrawings[win] = txt
                    end

                    if Config.ESP_Windows then
                        local sillWorldPos = ledge.CFrame:PointToWorldSpace(Vector3.new(0, offsetY, 0))
                        local sPos, onScreen = Camera:WorldToViewportPoint(sillWorldPos)
                        if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                            local wText = isBlocked and string.format("Vault [BLOCKED %ds] %dm", math.max(1, math.ceil(blockTimeLeft)), math.floor(dist))
                                       or ("Vault " .. math.floor(dist) .. "m")
                            local wCol = isBlocked and Color3.fromRGB(255, 60, 60) or (Config.Color_WindowNames or Color3.fromRGB(80, 210, 255))
                            if txt.Text ~= wText then txt.Text = wText end
                            if txt.Color ~= wCol then txt.Color = wCol end
                            txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                            if not txt.Visible then txt.Visible = true end
                        elseif txt.Visible then
                            txt.Visible = false
                        end
                    elseif txt.Visible then
                        txt.Visible = false
                    end
                end
            end
        end
    end
    for win, glow in pairs(WindowAuras) do
        if (not seenWindows[win] or inLobby or not Config.ESP_WindowAura) and glow.Visible then
            glow.Visible = false
        end
    end
    for win, bha in pairs(WindowAdornments) do
        if (not seenWindows[win] or inLobby or not Config.ESP_WindowAura) and bha.Visible then
            bha.Visible = false
        end
    end
    for win, txt in pairs(WindowDrawings) do
        if (not seenWindows[win] or not Config.ESP_Windows) and txt.Visible then
            txt.Visible = false
        end
    end

    -- 5. Exit Gates ESP
    table.clear(seenGates)
    if not inLobby and Config.ESP_ExitGates then
        for idx, item in ipairs(CachedGates) do
            local gate = item.Model
            local root = item.Part
            if gate and gate.Parent and root and root.Parent then
                seenGates[gate] = true
                local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local txt = GateDrawings[gate]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 13
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    GateDrawings[gate] = txt
                end

                if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                    local dist = math.floor((myPos - root.Position).Magnitude)
                    local gText = string.format("Exit Gate #%d (%dm)", idx, dist)
                    if txt.Text ~= gText then txt.Text = gText end
                    txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                    local gCol = Config.Color_ExitGates or Color3.fromRGB(50, 255, 120)
                    if txt.Color ~= gCol then txt.Color = gCol end
                    if not txt.Visible then txt.Visible = true end
                elseif txt.Visible then
                    txt.Visible = false
                end
            end
        end
    end
    for gate, txt in pairs(GateDrawings) do
        if not seenGates[gate] and txt.Visible then txt.Visible = false end
    end
    end)
    end
end

-- Bind ESP rendering strictly AFTER CameraModule (200), Flashlight ShiftLock (300), and CameraShake (2001)
pcall(function() RunService:UnbindFromRenderStep("NexaraESP_Render") end)
RunService:BindToRenderStep("NexaraESP_Render", Enum.RenderPriority.Last.Value + 10, RenderESP)

