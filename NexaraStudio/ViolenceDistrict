local function SetupPlayerCooldownHooks(player)
    local function onChar(char)
        if not char then return end
        ClearPlayerCooldowns(player)
        PersistentPerksCache[player] = nil

        -- 1. Character Attribute: Fast Whitelist (ignores non-cooldown attributes like CamLook/CamPos/Speed)
        local TrackedCooldownAttrs = {
            Parry = true,
            ParrySpent = true,
            IsHooked = true,
            IsStunned = true,
            LakeMist = true,
            Pursuit = true,
            Mask = true,
            Frenzy = true,
            FrenzyEnding = true,
            Stage = true,
            StalkStage = true,
            EvolveStage = true,
            prepareflask = true,
            overridelookscript = true,
            Aiming = true,
            ChainMove1CD = true,
            ChainThrows = true,
            ChainWindupAt = true
        }
        table.insert(ScriptConnections, char.AttributeChanged:Connect(function(attrName)
            if not TrackedCooldownAttrs[attrName] then return end
            if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return end
            if attrName == "Parry" and char:GetAttribute("Parry") == true then
                SetItemCooldown(player, "Parrying Dagger", 60)
