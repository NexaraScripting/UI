-- Lighting Management (Restore proper map night lighting, prevent white fog blowout)
local function RestoreOriginalLighting()
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local ml = rs:FindFirstChild("MapLighting")
        local atmo = Lighting:FindFirstChildWhichIsA("Atmosphere")
        local function parseColor(s)
            local r, g, b = s:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
            if r and g and b then return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) end
            return Color3.new(0, 0, 0)
        end
        if ml then
            if ml:FindFirstChild("ClockTime") then Lighting.ClockTime = tonumber(ml.ClockTime.Value) or 23 end
            if ml:FindFirstChild("Brightness") then Lighting.Brightness = tonumber(ml.Brightness.Value) or 16 end
            if ml:FindFirstChild("Ambient") then Lighting.Ambient = parseColor(ml.Ambient.Value) end
            if ml:FindFirstChild("OutdoorAmbient") then Lighting.OutdoorAmbient = parseColor(ml.OutdoorAmbient.Value) end
            if ml:FindFirstChild("exposure") then Lighting.ExposureCompensation = tonumber(ml.exposure.Value) or 0 end
            if atmo then
                if ml:FindFirstChild("AtmosphereColor") then atmo.Color = parseColor(ml.AtmosphereColor.Value) end
                if ml:FindFirstChild("AtmosphereDecay") then atmo.Decay = parseColor(ml.AtmosphereDecay.Value) end
                if ml:FindFirstChild("AtmosphereDensity") then atmo.Density = tonumber(ml.AtmosphereDensity.Value) or 0.75 end
                if ml:FindFirstChild("AtmosphereHaze") then atmo.Haze = tonumber(ml.AtmosphereHaze.Value) or 0 end
                if ml:FindFirstChild("AtmosphereGlare") then atmo.Glare = tonumber(ml.AtmosphereGlare.Value) or 0 end
            end
        else
            Lighting.ClockTime = 23
            Lighting.Brightness = 2
            Lighting.GlobalShadows = true
        end
    end)
end

-- Immediately revert any blinding daytime/whiteout
RestoreOriginalLighting()

-- ======== FOV CONTROLLER & FLASHLIGHT (NO ZOOMING, 100% STEADY) ========
-- Silence SmoothCamera from constantly pulling FOV to 70 and stop flashlight from zooming!
local fovCtrl = nil
pcall(function()
    fovCtrl = require(ReplicatedStorage.Modules:WaitForChild("FOVController", 5))
    if fovCtrl then
        if not fovCtrl._nexara_orig_Set then
            fovCtrl._nexara_orig_Set = fovCtrl.Set
            fovCtrl._nexara_orig_Release = fovCtrl.Release
            fovCtrl._nexara_orig_IsOverrideActive = fovCtrl.IsOverrideActive
            fovCtrl._nexara_orig_IsTweening = fovCtrl.IsTweening
        end
        local origSet = fovCtrl._nexara_orig_Set
        local origRelease = fovCtrl._nexara_orig_Release
        local origIsOverrideActive = fovCtrl._nexara_orig_IsOverrideActive
        local origIsTweening = fovCtrl._nexara_orig_IsTweening

        -- Tell SmoothCamera that override is active so it never fights FOV
        fovCtrl.IsOverrideActive = function(self)
            if Config.CustomFOVEnabled then return true end
            if origIsOverrideActive then return origIsOverrideActive(self) end
            return false
        end
        fovCtrl.IsTweening = function(self)
            if Config.CustomFOVEnabled then return false end
            if origIsTweening then return origIsTweening(self) end
            return false
        end

        -- Flashlight calls Set(73, 0.3) when aiming: NO ZOOMING! Keep camera steady!
        fovCtrl.Set = function(self, targetFov, dur, style, dir)
            if Config.CustomFOVEnabled then
                -- Keep camera FOV steady at user custom FOV
            else
                if origSet then origSet(self, targetFov, dur, style, dir) end
            end
        end

        -- Flashlight calls Release(0.5): restore custom FOV smoothly
        fovCtrl.Release = function(self, dur, style, dir)
            if Config.CustomFOVEnabled then
                Camera.FieldOfView = Config.FOV
            else
                if origRelease then origRelease(self, dur, style, dir) end
            end
        end
    end
end)

