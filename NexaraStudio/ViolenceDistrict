function Window:SetWeather(wType)
    wType = wType or "None"
    if origSetWeather then
        pcall(function() origSetWeather(self, "None") end)
    end
    ClearReworkedWeather()
    self.ConfigValues["ThemeWeather"] = wType

    local mf = self.MainFrame
    local gui = self.Gui
