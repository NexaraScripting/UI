local function HideAllESP()
    pcall(function()
        TopKillerSkillText.Visible = false
        for _, esp in pairs(ESP_Objects) do
            esp.BoxOutline.Visible = false
            esp.Box.Visible = false
            esp.TopText.Visible = false
            esp.BottomText.Visible = false
            esp.PerkText.Visible = false
            esp.SkillText.Visible = false
            if esp.Skeleton then
                for _, l in pairs(esp.Skeleton) do l.Visible = false end
            end
            if esp.Chams then
                pcall(function() esp.Chams.Enabled = false end)
            end
        end
        for _, txt in pairs(GenDrawings) do txt.Visible = false end
        for _, txt in pairs(PalletDrawings) do txt.Visible = false end
        for _, hl in pairs(PalletAuras) do pcall(function() hl.Enabled = false end) end
        for _, txt in pairs(WindowDrawings) do txt.Visible = false end
        for _, hl in pairs(WindowAuras) do pcall(function() hl.Visible = false; hl.Enabled = false end) end
        for _, bha in pairs(WindowAdornments) do pcall(function() bha.Visible = false end) end
        for _, txt in pairs(GateDrawings) do txt.Visible = false end
    end)
end

-- ======== UNLOAD & CLEANUP SYSTEM ========
local function UnloadScript()
    ScriptRunning = false
    pcall(function() RunService:UnbindFromRenderStep("NexaraESP_Render") end)
    pcall(function() RunService:UnbindFromRenderStep("Nexara_MouseUnlock") end)
    if modalUnlockBtn then
        pcall(function() modalUnlockBtn:Destroy() end)
    end
    if CameraHooks then
        pcall(function()
            if CameraHooks.cameraUtils and CameraHooks.cameraUtils._nexara_hooked then
                if CameraHooks.origSetMouseBehavior then CameraHooks.cameraUtils.setMouseBehaviorOverride = CameraHooks.origSetMouseBehavior end
                if CameraHooks.origRestoreMouseBehavior then CameraHooks.cameraUtils.restoreMouseBehavior = CameraHooks.origRestoreMouseBehavior end
                if CameraHooks.origSetMouseIcon then CameraHooks.cameraUtils.setMouseIconOverride = CameraHooks.origSetMouseIcon end
                CameraHooks.cameraUtils._nexara_hooked = nil
            end
            if CameraHooks.cameraInput and CameraHooks.cameraInput._nexara_hooked then
                if CameraHooks.origGetRotation then CameraHooks.cameraInput.getRotation = CameraHooks.origGetRotation end
                CameraHooks.cameraInput._nexara_hooked = nil
            end
            if CameraHooks.modalGui then CameraHooks.modalGui:Destroy() end
        end)
    end
    for _, conn in ipairs(ScriptConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(ScriptConnections)
    for _, esp in pairs(ESP_Objects) do
        pcall(function() esp:Remove() end)
    end
    table.clear(ESP_Objects)
    ClearDrawingsMap(GenDrawings)
    ClearDrawingsMap(PalletDrawings)
    ClearDrawingsMap(WindowDrawings)
    ClearDrawingsMap(GateDrawings)
    pcall(function() TopKillerSkillText:Remove() end)
    for _, hl in pairs(PalletAuras) do pcall(function() hl:Destroy() end) end
    for _, hl in pairs(WindowAuras) do pcall(function() hl:Destroy() end) end
    for _, bha in pairs(WindowAdornments) do pcall(function() bha:Destroy() end) end
    table.clear(PalletAuras)
    table.clear(WindowAuras)
    table.clear(WindowAdornments)
    
    pcall(function()
        for _, d in ipairs(workspace:GetDescendants()) do
            if (d:IsA("Highlight") or d:IsA("BoxHandleAdornment") or d:IsA("SelectionBox")) and (d.Name:find("Nexara") or d.Name:find("Aura") or d.Name:find("WindowBox") or d.Name:find("WindowGlow")) then
                d:Destroy()
            end
        end
    end)

    pcall(function()
        RestoreOriginalLighting()
    end)

    pcall(function()
        Camera.FieldOfView = 70
        local rs = game:GetService("ReplicatedStorage")
        local fMod = require(rs.Modules.FOVController)
        if fMod and fMod._nexara_orig_Set then
            fMod.Set = fMod._nexara_orig_Set
            fMod.Release = fMod._nexara_orig_Release
            fMod.IsOverrideActive = fMod._nexara_orig_IsOverrideActive
            fMod.IsTweening = fMod._nexara_orig_IsTweening
            fMod._nexara_orig_Set = nil
        end
    end)

    pcall(function()
        if not IsInLobby() then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end
    end)

    pcall(function()
        if Window then
            Window.Visible = false
            Window.UnlockMouse = false
            if Window.Gui then Window.Gui:Destroy() end
        end
        if _G.Nexara_CurrentWindow then
            _G.Nexara_CurrentWindow.Visible = false
            _G.Nexara_CurrentWindow.UnlockMouse = false
            if _G.Nexara_CurrentWindow.Gui then _G.Nexara_CurrentWindow.Gui:Destroy() end
            _G.Nexara_CurrentWindow = nil
        end
        if _G.Nexara_CurrentInstance and _G.Nexara_CurrentInstance.Connections then
            for _, conn in ipairs(_G.Nexara_CurrentInstance.Connections) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(_G.Nexara_CurrentInstance.Connections)
            _G.Nexara_CurrentInstance = nil
        end
        local function clean(p)
            if not p then return end
            for _, c in ipairs(p:GetChildren()) do
                if c.Name:find("NexaraStudio") or c.Name:find("Nexara") then
                    c:Destroy()
                end
            end
        end
        clean(game:GetService("CoreGui"))
        if gethui then pcall(function() clean(gethui()) end) end
        local lp = game:GetService("Players").LocalPlayer
        if lp and lp:FindFirstChild("PlayerGui") then clean(lp.PlayerGui) end
    end)

    _G.Nexara_VD_Cleanup = nil
    print("[Nexara Studio] Violence District unloaded successfully.")
end

_G.Nexara_VD_Cleanup = UnloadScript

