-- ======== HALLOWEEN PUMPKIN DATA SCANNING ========
-- ======== EVENT TAB (HALLOWEEN PUMPKIN HUNT - SINGLE PAGE) ========
local ActivePumpkinsList = {}
local CrushedPumpkinsCache = {}
local LastPumpkinScanClock = 0

local function IsPumpkinValidAndIntact(part, model)
    if not part or not part.Parent or not part:IsDescendantOf(Workspace) then return false end
    local lobbyFolder = Workspace:FindFirstChild("Lobby")
    if lobbyFolder and part:IsDescendantOf(lobbyFolder) then return false end
    if CrushedPumpkinsCache[part] or (model and CrushedPumpkinsCache[model]) then return false end
    local cs = game:GetService("CollectionService")
    if not cs:HasTag(part, "pumpkin") then
        return false
    end
    if cs:HasTag(part, "Blocked") or cs:HasTag(part, "doing action") or (model and (cs:HasTag(model, "Blocked") or cs:HasTag(model, "doing action"))) then
        return false
    end
    if model and model:IsA("Model") then
        local shell = model:FindFirstChild("shell")
        if not shell or not shell:IsA("BasePart") or shell.Transparency >= 0.5 then
            return false
        end
    end
    return true
end

local function ScanActivePumpkins(force)
    local now = os.clock()
    if not force and (now - LastPumpkinScanClock < 0.15) then
        return ActivePumpkinsList
    end
    LastPumpkinScanClock = now

    local list = {}
    local seen = {}
    local cs = game:GetService("CollectionService")

    for _, tagged in ipairs(cs:GetTagged("pumpkin")) do
        local part = tagged:IsA("BasePart") and tagged or (tagged:IsA("Model") and tagged:FindFirstChild("HB"))
        local model = (tagged:IsA("Model") and tagged) or (part and part.Parent and part.Parent:IsA("Model") and part.Parent) or part
        if part and model and not seen[model] and IsPumpkinValidAndIntact(part, model) then
            seen[model] = true
            table.insert(list, { Model = model, Part = part })
        end
    end

    ActivePumpkinsList = list
    return list
end


