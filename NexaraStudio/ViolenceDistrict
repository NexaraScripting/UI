        if char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") or char:GetAttribute("invisible") then
            return true
        end
        -- Slasher
        if char:FindFirstChild("Katana") or char:FindFirstChild("Sword") then
            return true
        end
        -- Masked
        if char:GetAttribute("Mask") or char:GetAttribute("MaskExpired") then
            return true
        end
        -- Abysswalker
        if char:FindFirstChild("Abysswalker") then
            return true
        end
        -- Butcher
        if char:FindFirstChild("Beartrap") or char:FindFirstChild("BearTrap") or char:GetAttribute("Butcher") == true 
            or char:GetAttribute("MorphedKiller") == "Butcher" or (char:FindFirstChild("Weapon") and char.Weapon:FindFirstChild("Main")) 
