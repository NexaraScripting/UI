-- Network listeners for Pallet Drops & Pallet Breaks
pcall(function()
    local function ResolvePalletModel(p1, p2)
        local inst = (typeof(p1) == "Instance" and p1) or (typeof(p2) == "Instance" and p2)
        if inst then
            return (inst:IsA("Model") and inst) or inst:FindFirstAncestorOfClass("Model") or (inst.Parent and inst.Parent:IsA("Model") and inst.Parent) or nil
        end
        local pos = (typeof(p1) == "CFrame" and p1.Position) or (typeof(p1) == "Vector3" and p1)
                 or (typeof(p2) == "CFrame" and p2.Position) or (typeof(p2) == "Vector3" and p2)
        if pos then
            local bestModel, bestDist = nil, 12.0
            for _, item in ipairs(CachedPallets) do
                local m = item.Model
                local rPart = item.Part
                if m and rPart and rPart.Parent then
                    local d = (rPart.Position - pos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestModel = m
                    end
                end
            end
            return bestModel
        end
        return nil
    end
    local remPallet = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Pallet")
    if remPallet then
        local dropAnim = remPallet:FindFirstChild("PalletDropAnim")
        if dropAnim and dropAnim:IsA("RemoteEvent") then
            table.insert(ScriptConnections, dropAnim.OnClientEvent:Connect(function(p1, p2)
                local win = ResolvePalletModel(p1, p2)
                if win then DroppedPallets[win] = true end
            end))
        end
        local dropEvent = remPallet:FindFirstChild("PalletDropEvent")
        if dropEvent and dropEvent:IsA("RemoteEvent") then
            table.insert(ScriptConnections, dropEvent.OnClientEvent:Connect(function(p1, p2)
                local win = ResolvePalletModel(p1, p2)
                if win then DroppedPallets[win] = true end
            end))
        end
        for _, r in ipairs(remPallet:GetDescendants()) do
            if r:IsA("RemoteEvent") and (r.Name:find("Break") or r.Name:find("Destroy") or r.Name:find("Cut") or r.Name:find("Contact")) then
                table.insert(ScriptConnections, r.OnClientEvent:Connect(function(p1, p2)
                    local win = ResolvePalletModel(p1, p2)
                    if win then
                        MarkPalletBroken(win)
                    else
                        for _, p in ipairs(Players:GetPlayers()) do
                            if IsKiller(p) and p.Character then
                                local kRoot = p.Character:FindFirstChild("HumanoidRootPart")
                                if kRoot then
                                    for _, item in ipairs(CachedPallets) do
                                        local m = item.Model
                                        local rPart = item.Part
                                        if m and rPart and rPart.Parent and (rPart.Position - kRoot.Position).Magnitude < 14 then
                                            MarkPalletBroken(m)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end))
            end
        end
        local brokenEvt = remPallet:FindFirstChild("PalletBroken")
        if brokenEvt and (brokenEvt:IsA("RemoteEvent") or brokenEvt:IsA("BindableEvent")) then
            local connEvt = brokenEvt:IsA("RemoteEvent") and brokenEvt.OnClientEvent or brokenEvt.Event
            table.insert(ScriptConnections, connEvt:Connect(function(target)
                local win = ResolvePalletModel(target)
                if win then MarkPalletBroken(win) end
            end))
        end
    end
end)


