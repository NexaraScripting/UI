local function LoadUIModule()
    local localPaths = {
        "Nexara Studio/Games/ViolenceDistrict_UI.lua",
        "ViolenceDistrict_UI.lua",
        "Nexara Studio/ViolenceDistrict_UI.lua",
    }
    local rawUrls = {
        "https://raw.githubusercontent.com/Surankannig/UI/refs/heads/main/testr",
        "https://raw.githubusercontent.com/Surankannig/UI/refs/heads/main/ViolenceDistrict_UI.lua",
    }
    local code = nil

    if type(_G.Nexara_UI_Code) == "string" and #_G.Nexara_UI_Code > 0 then
        code = _G.Nexara_UI_Code
    end

    if not code and typeof(readfile) == "function" then
        for _, path in ipairs(localPaths) do
            local exists = false
            if typeof(isfile) == "function" then
                pcall(function() exists = isfile(path) end)
            end
            if exists or typeof(isfile) ~= "function" then
                local s, content = pcall(readfile, path)
                if s and type(content) == "string" and #content > 0 then
                    code = content
                    break
                end
            end
        end
    end

    if not code then
        for _, u in ipairs(rawUrls) do
            local s, res = pcall(function()
                return (typeof(HttpGet) == "function" and HttpGet(u))
                    or (game.HttpGet and game.HttpGet(game, u))
                    or game:HttpGet(u)
            end)
            if s and type(res) == "string" and #res > 1000 then
                code = res
                break
            end
        end
    end

    if not code then
        error("[Nexara Studio] Failed to load ViolenceDistrict_UI.lua from local file or GitHub!")
    end

    local fn, err = loadstring(code)
    if not fn then
        error("[Nexara Studio] Syntax error in ViolenceDistrict_UI.lua: " .. tostring(err))
    end
    return fn()
end

