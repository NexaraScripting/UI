local _cachedLobbyPart = nil
local function _GetLobbyPart()
    if _cachedLobbyPart and _cachedLobbyPart.Parent then return _cachedLobbyPart end
    local lobby = Workspace:FindFirstChild("Lobby")
    if lobby then
        local house = lobby:FindFirstChild("House")
        if house then
            _cachedLobbyPart = house:FindFirstChildWhichIsA("BasePart", true)
        end
        if not _cachedLobbyPart then
            _cachedLobbyPart = lobby:FindFirstChildWhichIsA("SpawnLocation", true) or lobby:FindFirstChildWhichIsA("BasePart", true)
        end
    end
    return _cachedLobbyPart
end

local CachedTimerLabel = nil
local function GetMatchTimerLabel()
    if CachedTimerLabel and CachedTimerLabel.Parent then
        return CachedTimerLabel
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, guiName in ipairs({"Spectator", "InGame", "HUD", "Survivor", "Killer"}) do
        local g = pg:FindFirstChild(guiName)
        if g then
            local tf = g:FindFirstChild("time") or g:FindFirstChild("Time") or g:FindFirstChild("Timer")
            if tf then
                local tl = tf:FindFirstChild("TimerLabel") or tf:FindFirstChildOfClass("TextLabel")
                if tl then
                    CachedTimerLabel = tl
                    return tl
                end
            end
        end
    end
    return nil
end

local function _IsMatchTimerZero()
    local tl = GetMatchTimerLabel()
    if tl and tl.Parent then
        local txt = tl.Text
        return (txt == "00:00" or txt == "0:00")
    end
    return false
end

local cachedInLobby = false
local lastInLobbyCheck = 0

local function IsInLobby()
    local now = os.clock()
    if now - lastInLobbyCheck < 0.15 then
        return cachedInLobby
    end
    lastInLobbyCheck = now

    -- 1. Fast World Coordinates Check (Lobby island is high in the sky: Y > 500 and Z > 2500)
    local myRoot = GetRoot(LocalPlayer)
    local pos = myRoot and myRoot.Position or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position)
    if pos then
        if pos.Y > 500 and pos.Z > 2500 then
            cachedInLobby = true
            return true
        end
    end

    -- 2. Check Match Timer: If timer is actively counting (e.g. "13:48" or any MM:SS != 00:00), we are DEFINITELY in match!
    local tl = GetMatchTimerLabel()
    if tl and tl.Parent then
        local txt = tl.Text or ""
        if txt ~= "00:00" and txt ~= "0:00" and txt:find("%d+:%d+") then
            cachedInLobby = false
            return false
        end
    end

    -- 3. Explicit lobby attributes
    if LocalPlayer:GetAttribute("InLobby") == true or LocalPlayer:GetAttribute("WaitingInLobby") == true then
        cachedInLobby = true
        return true
    end

    -- 4. Check Map folder contents (In match, Map has children; in lobby, map is empty or absent)
    local map = Workspace:FindFirstChild("Map")
    if map and map:FindFirstChildWhichIsA("Instance") then
        cachedInLobby = false
        return false
    end

    -- 5. Team check fallback
    local team = LocalPlayer.Team
    if team then
        local tName = team.Name
        if tName == "Killer" or tName == "Survivors" then
            cachedInLobby = false
            return false
        end
    end

    if pos and pos.Y < 300 then
        cachedInLobby = false
        return false
    end

    cachedInLobby = false
    return false
end

local function IsPlayerDead(player)
    if not player or not player.Parent then return true end
    local char = player.Character
    if not char or not char.Parent then return true end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and (hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead) then
        return true
    end

    if player:GetAttribute("IsDead") == true or char:GetAttribute("IsDead") == true or
       player:GetAttribute("Dead") == true or char:GetAttribute("Dead") == true or
       player:GetAttribute("Sacrificed") == true or char:GetAttribute("Sacrificed") == true or
       player:GetAttribute("Died") == true or char:GetAttribute("Died") == true or
       player:GetAttribute("Eliminated") == true or char:GetAttribute("Eliminated") == true or
       player:GetAttribute("BledOut") == true or char:GetAttribute("BledOut") == true then
        return true
    end

    if char:FindFirstChild("Died") then
        return true
    end

    if CollectionService and (CollectionService:HasTag(char, "Dead") or CollectionService:HasTag(char, "Sacrificed")) then
        return true
    end

    return false
end

local function IsPlayerInLobby(player)
    if not player or not player.Parent then return false end
    if player == LocalPlayer then return IsInLobby() end

    -- 1. If LocalPlayer is in lobby, everyone is in lobby
    if IsInLobby() then
        return true
    end

    -- 2. Dead players are out of the active round
    if IsPlayerDead(player) then
        return true
    end

    -- 3. World Coordinates Check: Any player physically on the sky lobby island
    local root = GetRoot(player)
    if root then
        local p = root.Position
        if p.Y > 500 and p.Z > 2500 then
            return true
        end
        if p.Y < 300 then
            return false
        end
    else
        return false
    end

    -- 4. Check explicit lobby attributes
    if player:GetAttribute("InLobby") == true or (player.Character and player.Character:GetAttribute("InLobby") == true) or
       player:GetAttribute("WaitingInLobby") == true then
        return true
    end

    return false
end

local cachedCutscene = false
local lastCutsceneCheck = 0

local function IsCutsceneActive()
    local now = os.clock()
    if (now - lastCutsceneCheck) < 0.15 then
        return cachedCutscene
    end
    lastCutsceneCheck = now

    -- If match countdown timer is running, match is live and NOT a global cutscene
    local tl = GetMatchTimerLabel()
    local isMatchLive = false
    if tl and tl.Parent then
        local txt = tl.Text or ""
        if txt ~= "00:00" and txt ~= "0:00" and txt:find("%d+:%d+") then
            isMatchLive = true
        end
    end

    local result = false

    -- 1. Local character mori / cutscene attributes
    local myChar = LocalPlayer.Character
    if myChar then
        if myChar:GetAttribute("Mori") == true or myChar:GetAttribute("IsMori") == true or
           myChar:GetAttribute("Cutscene") == true or myChar:GetAttribute("InCutscene") == true or
           LocalPlayer:GetAttribute("InCutscene") == true or LocalPlayer:GetAttribute("Cutscene") == true then
            result = true
        end
    end

    -- 2. Camera mode check (Only if match timer is NOT actively running, or during mori)
    if not result and not isMatchLive then
        local cam = Workspace.CurrentCamera or Camera
        if cam and cam.CameraType == Enum.CameraType.Scriptable then
            result = true
        end
    end

    -- 3. Check PlayerGui for cutscene / cinematic / black bars GUIs
    if not result and not isMatchLive then
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, name in ipairs({"Cutscene", "Cutscenes", "Cinematic", "Cinematics", "Intro", "Ending", "Outro", "Mori", "BlackBars", "Letterbox", "Bars", "CinematicBars"}) do
                local g = pg:FindFirstChild(name)
                if g and ((g:IsA("ScreenGui") and g.Enabled) or (g:IsA("GuiObject") and g.Visible)) then
                    result = true
                    break
                end
            end
        end
    end

    cachedCutscene = result
    return result
end

local CurrentKillerPlayer = nil

local function IsKiller(player)
    if not player then return false end
    if CurrentKillerPlayer ~= nil and CurrentKillerPlayer.Parent then
        return (player == CurrentKillerPlayer)
    end
    if IsInLobby() or IsPlayerInLobby(player) or IsPlayerDead(player) then return false end
    if player.Team then
        if player.Team.Name == "Killer" then return true end
        if player.Team.Name == "Survivors" or player.Team.Name == "Spectator" then return false end
    end
    local char = player.Character
    if char then
        -- Veil
        if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") or char:GetAttribute("Spears") then
            return true
        end
        -- Cure
        if char:FindFirstChild("Curetool") or char:FindFirstChild("Flask") or char:GetAttribute("corpsecharge") then
