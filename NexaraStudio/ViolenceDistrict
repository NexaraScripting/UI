local LocalKillerLevelCache = {}
local LastKillerLevelQuery = {}

local function GetResolvedKillerLevel(plr, kType)
    local cleanK = tostring(kType or "Killer"):gsub("^The%s+", "")
    local char = plr and plr.Character
    -- 1. Check any replicated KillerLevel attribute on Character or Player
    local attrLvl = (char and (char:GetAttribute("KillerLevel") or char:GetAttribute("Level") or char:GetAttribute(cleanK .. "Level")))
                 or (plr and (plr:GetAttribute("KillerLevel") or plr:GetAttribute(cleanK .. "Level")))
    if type(attrLvl) == "number" and attrLvl > 0 then
        return attrLvl
    end

    -- 2. For LocalPlayer: query ReplicatedStorage.Remotes.ShopKillers.GetKillerLevel(cleanK) with caching
    if plr == LocalPlayer then
        local now = os.clock()
        if not LocalKillerLevelCache[cleanK] or (now - (LastKillerLevelQuery[cleanK] or 0) > 15) then
            LastKillerLevelQuery[cleanK] = now
            task.spawn(function()
                pcall(function()
                    local sk = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("ShopKillers")
                    local gkl = sk and sk:FindFirstChild("GetKillerLevel")
                    if gkl and gkl:IsA("RemoteFunction") then
                        local lv = gkl:InvokeServer(cleanK)
                        if type(lv) == "number" and lv > 0 then
                            LocalKillerLevelCache[cleanK] = lv
                        end
                    end
                end)
            end)
        end
        if LocalKillerLevelCache[cleanK] then
            return LocalKillerLevelCache[cleanK]
        end
        -- Also check PlayerGui.Spectator.Inventory.Browse_loadout_killer.LevelLabel if already loaded
        local ok, guiLv = pcall(function()
            local inv = LocalPlayer.PlayerGui:FindFirstChild("Spectator") and LocalPlayer.PlayerGui.Spectator:FindFirstChild("Inventory")
            local blk = inv and inv:FindFirstChild("Browse_loadout_killer")
            local sel = inv and inv:FindFirstChild("SelectedKiller")
            if blk and sel and tostring(sel.Value):lower() == cleanK:lower() then
                local lbl = blk:FindFirstChild("LevelLabel")
                local num = lbl and tonumber(tostring(lbl.Text):match("(%d+)"))
                return num
            end
            return nil
        end)
        if ok and guiLv and guiLv > 0 then
            LocalKillerLevelCache[cleanK] = guiLv
            return guiLv
        end
    end

    return tonumber(plr and plr:GetAttribute("Level")) or 1
end

local function UpdateRoster(force)
    local allPlayers = Players:GetPlayers()
    local killerPlr = nil
    local survivors = {}

    for _, p in ipairs(allPlayers) do
        if not killerPlr and IsKiller(p) then
            killerPlr = p
        else
            table.insert(survivors, p)
        end
    end

    local inLobby = IsInLobby()
    RosterTitle.Text = "Match Info Beta"

    -- Remove left players
    for p, row in pairs(cachedRosterRows) do
        if not table.find(allPlayers, p) then
            pcall(function() row.Card:Destroy() end)
            cachedRosterRows[p] = nil
        end
    end

    -- Order: Killer at top, then LocalPlayer (if survivor), then other survivors alphabetically
    local ordered = {}
    if killerPlr then
        table.insert(ordered, killerPlr)
    end
    if table.find(survivors, LocalPlayer) then
        table.insert(ordered, LocalPlayer)
    end
    table.sort(survivors, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    for _, s in ipairs(survivors) do
        if s ~= LocalPlayer and not table.find(ordered, s) then
            table.insert(ordered, s)
        end
    end

    -- Update each player row
    for rank, plr in ipairs(ordered) do
        local ok, err = pcall(function()
            local row = cachedRosterRows[plr] or CreatePlayerRow(plr)
            row.Card.LayoutOrder = rank
            local isK = (plr == killerPlr)
            local kType = nil

        local plrLevel = tonumber(plr:GetAttribute("Level")) or 1
        local rawPlat = tostring(plr:GetAttribute("platform") or "PC")
        local platUpper = rawPlat:upper()
        local platDisplay = (platUpper == "MOBILE" and "MOBILE") or (platUpper == "CONSOLE" and "CONSOLE") or "PC"

        if isK then
            local kCol = Color3.fromRGB(255, 60, 80)
            row.AccentBar.BackgroundColor3 = kCol
            row.AvatarStroke.Color = kCol
            row.AvatarBox.BackgroundColor3 = Color3.fromRGB(45, 15, 20)

            kType = ResolveKillerType(plr)
            local cleanK = tostring(kType or "Killer"):gsub("^The%s+", "")
            local kLevel = GetResolvedKillerLevel(plr, kType)

            SetupKillerAvatar(row, kType, plr)

            if row.LvlBadge then
                row.LvlBadge.BackgroundColor3 = Color3.fromRGB(42, 12, 18)
                row.LvlStroke.Color = kCol
                row.LvlText.Text = tostring(kLevel)
                row.LvlText.TextColor3 = Color3.fromRGB(255, 210, 215)
            end

            row.RolePill.BackgroundColor3 = Color3.fromRGB(60, 15, 22)
            row.RoleText.Text = "[" .. cleanK:upper() .. " • LV." .. tostring(kLevel) .. "]"
            row.RoleText.TextColor3 = Color3.fromRGB(255, 85, 105)

            local kState = inLobby and "Lobby" or GetRosterKillerState(plr)
            row.StatusPill.BackgroundColor3 = Color3.fromRGB(50, 15, 20)
            row.StatusText.Text = kState
            row.StatusText.TextColor3 = Color3.fromRGB(255, 120, 140)

            row.PerksHeader.Text = "KILLER PERKS (3 SLOTS)"
            -- Killer Power Box (Hidden completely as requested: perks only)
            row.ItemHeader.Visible = false
            row.ItemBox.Visible = false
        else
            local accentCol = Color3.fromRGB(0, 205, 255)
            row.AccentBar.BackgroundColor3 = accentCol
            row.AvatarStroke.Color = accentCol
            row.AvatarBox.BackgroundColor3 = Window.Theme.ElementBackground
            local oldVpf = row.AvatarBox:FindFirstChild("KillerViewport")
            if oldVpf then pcall(function() oldVpf:Destroy() end) end
            if row._renderedVpf then
                pcall(function() row._renderedVpf:Destroy() end)
                row._renderedVpf = nil
            end
            row._renderedKiller = nil
            row.AvatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"
            row.AvatarImg.Visible = true
            row.AvatarText.Visible = false

            if row.LvlBadge then
                row.LvlBadge.BackgroundColor3 = Color3.fromRGB(14, 22, 32)
                row.LvlStroke.Color = accentCol
                row.LvlText.Text = tostring(plrLevel)
                row.LvlText.TextColor3 = Color3.fromRGB(240, 248, 255)
            end

            local isLobby = inLobby or IsPlayerInLobby(plr)
            row.RolePill.BackgroundColor3 = isLobby and Color3.fromRGB(15, 40, 55) or Color3.fromRGB(15, 45, 60)
            row.RoleText.Text = isLobby and "[LOBBY]" or "[SURVIVOR]"
            row.RoleText.TextColor3 = Color3.fromRGB(80, 220, 255)

            local stText, stCol, stBg = GetRosterSurvivorState(plr)
            row.StatusPill.BackgroundColor3 = stBg
            row.StatusText.Text = stText
            row.StatusText.TextColor3 = stCol

            row.PerksHeader.Text = "PERKS (3 SLOTS)"
            row.ItemHeader.Visible = true
            row.ItemBox.Visible = true
            row.ItemHeader.Text = "EQUIPPED ITEM"
            row.ItemStroke.Color = Color3.fromRGB(255, 180, 50)
        end

        if row.PlatPill and row.PlatText then
            row.PlatText.Text = platDisplay
            if platDisplay == "MOBILE" then
                row.PlatPill.BackgroundColor3 = Color3.fromRGB(48, 36, 14)
                row.PlatText.TextColor3 = Color3.fromRGB(255, 205, 80)
            elseif platDisplay == "CONSOLE" then
                row.PlatPill.BackgroundColor3 = Color3.fromRGB(36, 20, 56)
                row.PlatText.TextColor3 = Color3.fromRGB(205, 140, 255)
            else
                row.PlatPill.BackgroundColor3 = Color3.fromRGB(20, 28, 42)
                row.PlatText.TextColor3 = Color3.fromRGB(175, 210, 255)
            end
        end

        -- Perks (Icons + Names pulled from game, independent of LocalPlayer's slots)
        local perks = GetPlayerPerks(plr) or {}
        local _maxDisplaySlots = 3
        for i = 1, 3 do
            local pb = row.PerkBoxes and row.PerkBoxes[i]
            local pName = perks[i]
            local pImg = row.PerkImgs[i]
            local pLbl = row.PerkLabels[i]

            if pb then pb.Visible = true end
            if pName and pName ~= "" and pName ~= "---" then
                local pTier = (PlayerPerkTiers[plr] and PlayerPerkTiers[plr][pName]) or 3
                local pIcon = GetPerkIcon(pName, pTier) or "rbxassetid://115375812494391"
                if pIcon and pIcon ~= "" then
                    pImg.Image = pIcon
                    pImg.Visible = true
                    pLbl.Position = UDim2.fromOffset(40, 2)
                    pLbl.Size = UDim2.new(1, -42, 1, -4)
                else
                    pImg.Visible = false
                    pLbl.Position = UDim2.fromOffset(4, 2)
                    pLbl.Size = UDim2.new(1, -8, 1, -4)
                end
                pLbl.Text = pName
                pLbl.TextColor3 = Color3.fromRGB(240, 245, 250)
            else
                pImg.Visible = false
                pLbl.Position = UDim2.fromOffset(4, 2)
                pLbl.Size = UDim2.new(1, -8, 1, -4)
                pLbl.Text = "---"
                pLbl.TextColor3 = Window.Theme.SubText
            end
        end

        -- Item / Power (Icon + Details)
        local itemName, itemDet, itemCol = GetRosterItemDisplay(plr, isK)
        row.ItemNameLabel.Text = itemName or "No Item"
        row.ItemDetLabel.Text = itemDet or "---"
        row.ItemDetLabel.TextColor3 = itemCol or Window.Theme.SubText

        if isK then
            row.ItemHeader.Visible = false
            row.ItemBox.Visible = false
        else
            row.ItemHeader.Visible = true
            row.ItemBox.Visible = true
            local itIcon = GetItemIcon(itemName)
            if itIcon and itIcon ~= "" and itemName ~= "No Item" and itemName ~= "None" then
                row.ItemImg.Image = itIcon
                row.ItemImg.Visible = true
                row.ItemNameLabel.Position = UDim2.fromOffset(42, 4)
                row.ItemNameLabel.Size = UDim2.new(1, -44, 0, 16)
                row.ItemDetLabel.Position = UDim2.fromOffset(42, 21)
                row.ItemDetLabel.Size = UDim2.new(1, -44, 0, 15)
            else
                row.ItemImg.Visible = false
                row.ItemNameLabel.Position = UDim2.fromOffset(8, 4)
                row.ItemNameLabel.Size = UDim2.new(1, -12, 0, 16)
                row.ItemDetLabel.Position = UDim2.fromOffset(8, 21)
                row.ItemDetLabel.Size = UDim2.new(1, -12, 0, 15)
            end
        end
    end)
    if not ok then
        warn("Nexara: Roster render error for player " .. tostring(plr) .. ": " .. tostring(err))
    end
end

