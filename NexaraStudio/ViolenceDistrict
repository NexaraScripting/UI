-- ======== ESP DRAWING SYSTEM (SEPARATED SURVIVOR BOX & KILLER SKELETON) ========
ESP_Objects = {}
local ChamsContainer = nil

local function GetChamsContainer()
    if ChamsContainer and ChamsContainer.Parent then return ChamsContainer end
    local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
    local existing = parentGui:FindFirstChild("Nexara_ChamsContainer")
    if existing then
        ChamsContainer = existing
        return ChamsContainer
    end
    local f = Instance.new("Folder")
    f.Name = "Nexara_ChamsContainer"
    pcall(function() f.Parent = parentGui end)
    ChamsContainer = f
    return f
end

local function hidePlayerESP(esp)
    esp.IsHidden = true
    if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
    if esp.Box.Visible then esp.Box.Visible = false end
    if esp.TopText.Visible then esp.TopText.Visible = false end
    if esp.BottomText.Visible then esp.BottomText.Visible = false end
    if esp.PerkText.Visible then esp.PerkText.Visible = false end
    if esp.SkillText.Visible then
        esp.SkillText.Visible = false
        esp.SkillText.Text = ""
    end
    for _, l in pairs(esp.Skeleton) do
        if l.Visible then l.Visible = false end
    end
    if esp.Chams then
        pcall(function()
            esp.Chams.Enabled = false
            esp.Chams.Adornee = nil
        end)
    end
end

