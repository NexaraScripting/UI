-- ======== SKELETON DRAWER (DYNAMIC MODEL-ACCURATE BONES) ========
local UpdateSkeleton
do
local function getSkelPoint(cf, offset)
    local p = cf:PointToWorldSpace(offset)
    local sp, vis = Camera:WorldToViewportPoint(p)
    return Vector2.new(math.floor(sp.X), math.floor(sp.Y)), (vis and sp.Z > 0)
end

local function drawSkelLine(line, p1, v1, p2, v2, color, th, alpha)
    if not line then return end
    local a = alpha or 1
    if v1 and v2 and p1 and p2 and a > 0.01 then
        line.From = p1
        line.To = p2
        if line.Color ~= color then line.Color = color end
        if line.Thickness ~= th then line.Thickness = th end
        line.Transparency = a
        if not line.Visible then line.Visible = true end
    else
        if line.Visible then line.Visible = false end
    end
end

function UpdateSkeleton(char, lines, color, thickness, alpha)
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    local a = alpha or 1
    if not torso or a <= 0.01 then
        for _, l in pairs(lines) do if l.Visible then l.Visible = false end end
        return false
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local rootJoint = (hrp and torso ~= hrp) and hrp:FindFirstChild("RootJoint") or nil
    local torsoCF = (rootJoint and rootJoint.Part0 == hrp and rootJoint.Part1 == torso)
        and (hrp.CFrame * rootJoint.C0 * rootJoint.Transform * rootJoint.C1:Inverse())
        or torso.CFrame

    local head = char:FindFirstChild("Head")
    local neckMotor = torso:FindFirstChild("Neck")
    local headCF = (head and neckMotor and neckMotor.Part0 == torso and neckMotor.Part1 == head)
        and (torsoCF * neckMotor.C0 * neckMotor.Transform * neckMotor.C1:Inverse())
        or (head and head.CFrame)
    local headValid = head and head:IsA("BasePart") and headCF and (headCF.Position - torsoCF.Position).Magnitude <= 3.5

    local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("leftarm") or char:FindFirstChild("LeftUpperArm")
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("rightarm") or char:FindFirstChild("RightUpperArm")
    local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("leftleg") or char:FindFirstChild("LeftUpperLeg")
    local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("rightleg") or char:FindFirstChild("RightUpperLeg")

    local lShoulderMotor = torso:FindFirstChild("Left Shoulder")
    local rShoulderMotor = torso:FindFirstChild("Right Shoulder")
    local lHipMotor = torso:FindFirstChild("Left Hip")
    local rHipMotor = torso:FindFirstChild("Right Hip")

    local leftArmCF = (leftArm and lShoulderMotor and lShoulderMotor.Part0 == torso and lShoulderMotor.Part1 == leftArm)
        and (torsoCF * lShoulderMotor.C0 * lShoulderMotor.Transform * lShoulderMotor.C1:Inverse())
        or (leftArm and leftArm.CFrame)
    local rightArmCF = (rightArm and rShoulderMotor and rShoulderMotor.Part0 == torso and rShoulderMotor.Part1 == rightArm)
        and (torsoCF * rShoulderMotor.C0 * rShoulderMotor.Transform * rShoulderMotor.C1:Inverse())
        or (rightArm and rightArm.CFrame)
    local leftLegCF = (leftLeg and lHipMotor and lHipMotor.Part0 == torso and lHipMotor.Part1 == leftLeg)
        and (torsoCF * lHipMotor.C0 * lHipMotor.Transform * lHipMotor.C1:Inverse())
        or (leftLeg and leftLeg.CFrame)
    local rightLegCF = (rightLeg and rHipMotor and rHipMotor.Part0 == torso and rHipMotor.Part1 == rightLeg)
        and (torsoCF * rHipMotor.C0 * rHipMotor.Transform * rHipMotor.C1:Inverse())
        or (rightLeg and rightLeg.CFrame)

    local th = thickness or 1.3
    local tS = torso.Size
    local hS = headValid and head.Size or Vector3.new(1.2, 1.2, 1.2)

    -- Dynamic joints based on actual model proportions (fits R6, scaled killers, Stalker, Slasher, Cure, etc.)
    local neckPos, nVis = getSkelPoint(torsoCF, Vector3.new(0, tS.Y * 0.5, 0))
    local pelvisPos, pVis = getSkelPoint(torsoCF, Vector3.new(0, -tS.Y * 0.5, 0))
    local headPos, hVis
    if headValid then
        headPos, hVis = getSkelPoint(headCF, Vector3.new(0, hS.Y * 0.45, 0))
    else
        headPos, hVis = getSkelPoint(torsoCF, Vector3.new(0, tS.Y * 0.5 + hS.Y * 0.45, 0))
    end

    drawSkelLine(lines.Head, headPos, hVis, neckPos, nVis, color, th, a)
    drawSkelLine(lines.Spine, neckPos, nVis, pelvisPos, pVis, color, th, a)

    -- Left Arm (Anatomical: Neck -> Shoulder -> Elbow -> Hand)
    local lShoulderPos, lsVis = getSkelPoint(torsoCF, Vector3.new(-tS.X * 0.5, tS.Y * 0.35, 0))
    drawSkelLine(lines.LeftCollar, neckPos, nVis, lShoulderPos, lsVis, color, th, a)
    if leftArm and leftArmCF then
        local laS = leftArm.Size
        local lElbowPos, leVis = getSkelPoint(leftArmCF, Vector3.new(0, 0, 0))
        local lHandPos, lhVis = getSkelPoint(leftArmCF, Vector3.new(0, -laS.Y * 0.48, 0))
        drawSkelLine(lines.LeftArmUpper, lShoulderPos, lsVis, lElbowPos, leVis, color, th, a)
        drawSkelLine(lines.LeftArmLower, lElbowPos, leVis, lHandPos, lhVis, color, th, a)
    else
        if lines.LeftArmUpper and lines.LeftArmUpper.Visible then lines.LeftArmUpper.Visible = false end
        if lines.LeftArmLower and lines.LeftArmLower.Visible then lines.LeftArmLower.Visible = false end
    end

    -- Right Arm (Anatomical: Neck -> Shoulder -> Elbow -> Hand)
    local rShoulderPos, rsVis = getSkelPoint(torsoCF, Vector3.new(tS.X * 0.5, tS.Y * 0.35, 0))
    drawSkelLine(lines.RightCollar, neckPos, nVis, rShoulderPos, rsVis, color, th, a)
    if rightArm and rightArmCF then
        local raS = rightArm.Size
        local rElbowPos, reVis = getSkelPoint(rightArmCF, Vector3.new(0, 0, 0))
        local rHandPos, rhVis = getSkelPoint(rightArmCF, Vector3.new(0, -raS.Y * 0.48, 0))
        drawSkelLine(lines.RightArmUpper, rShoulderPos, rsVis, rElbowPos, reVis, color, th, a)
        drawSkelLine(lines.RightArmLower, rElbowPos, reVis, rHandPos, rhVis, color, th, a)
    else
        if lines.RightArmUpper and lines.RightArmUpper.Visible then lines.RightArmUpper.Visible = false end
        if lines.RightArmLower and lines.RightArmLower.Visible then lines.RightArmLower.Visible = false end
    end

    -- Left Leg (Anatomical: Pelvis -> Hip -> Knee -> Foot)
    local lHipPos, lhipVis = getSkelPoint(torsoCF, Vector3.new(-tS.X * 0.38, -tS.Y * 0.5, 0))
    drawSkelLine(lines.LeftPelvis, pelvisPos, pVis, lHipPos, lhipVis, color, th, a)
    if leftLeg and leftLegCF then
        local llS = leftLeg.Size
        local lKneePos, lkVis = getSkelPoint(leftLegCF, Vector3.new(0, 0, 0))
        local lFootPos, lfVis = getSkelPoint(leftLegCF, Vector3.new(0, -llS.Y * 0.5, 0))
        drawSkelLine(lines.LeftLegUpper, lHipPos, lhipVis, lKneePos, lkVis, color, th, a)
        drawSkelLine(lines.LeftLegLower, lKneePos, lkVis, lFootPos, lfVis, color, th, a)
    else
        if lines.LeftLegUpper and lines.LeftLegUpper.Visible then lines.LeftLegUpper.Visible = false end
        if lines.LeftLegLower and lines.LeftLegLower.Visible then lines.LeftLegLower.Visible = false end
    end

    -- Right Leg (Anatomical: Pelvis -> Hip -> Knee -> Foot)
    local rHipPos, rhipVis = getSkelPoint(torsoCF, Vector3.new(tS.X * 0.38, -tS.Y * 0.5, 0))
    drawSkelLine(lines.RightPelvis, pelvisPos, pVis, rHipPos, rhipVis, color, th, a)
    if rightLeg and rightLegCF then
        local rlS = rightLeg.Size
        local rKneePos, rkVis = getSkelPoint(rightLegCF, Vector3.new(0, 0, 0))
        local rFootPos, rfVis = getSkelPoint(rightLegCF, Vector3.new(0, -rlS.Y * 0.5, 0))
        drawSkelLine(lines.RightLegUpper, rHipPos, rhipVis, rKneePos, rkVis, color, th, a)
        drawSkelLine(lines.RightLegLower, rKneePos, rkVis, rFootPos, rfVis, color, th, a)
    else
        if lines.RightLegUpper and lines.RightLegUpper.Visible then lines.RightLegUpper.Visible = false end
        if lines.RightLegLower and lines.RightLegLower.Visible then lines.RightLegLower.Visible = false end
    end

    return (hVis or pVis)
end
end

