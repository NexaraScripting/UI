local function UpdateRoster(force)
    local allPlayers = Players:GetPlayers()
    local killerPlr = nil
    local survivors = {}

    for _, p in ipairs(allPlayers) do
        if not killerPlr and IsKiller(p) then
            killerPlr = p
        else
            table.insert(survivors, p)
        end
    end

    local inLobby = IsInLobby()
    RosterTitle.Text = "Match Info Beta"

    -- Remove left players
    for p, row in pairs(cachedRosterRows) do
        if not table.find(allPlayers, p) then
            pcall(function() row.Card:Destroy() end)
            cachedRosterRows[p] = nil
        end
    end

    -- Order: Killer at top, then LocalPlayer (if survivor), then other survivors alphabetically
    local ordered = {}
    if killerPlr then
        table.insert(ordered, killerPlr)
    end
    if table.find(survivors, LocalPlayer) then
        table.insert(ordered, LocalPlayer)
    end
    table.sort(survivors, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    for _, s in ipairs(survivors) do
        if s ~= LocalPlayer and not table.find(ordered, s) then
            table.insert(ordered, s)
        end
    end

    -- Update each player row
    for rank, plr in ipairs(ordered) do
        local ok, err = pcall(function()
            local row = cachedRosterRows[plr] or CreatePlayerRow(plr)
