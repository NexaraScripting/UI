local function SyncAllUIWithTheme(presetName, customAccent)
    if not Window or not Window.MainFrame then return end
    local mf = Window.MainFrame
    local pName = presetName or (Window.ConfigValues and Window.ConfigValues["ThemePreset"]) or "NexaraTheme"
    local pal = ThemePalettes[pName] or ThemePalettes.NexaraTheme
    local acc = customAccent or (Window.Theme and Window.Theme.Accent) or pal.Accent

    -- Update Theme table entries so new/hovered elements use synced colors
    Window.Theme.Accent = acc
    Window.Theme.Background = pal.Background
    Window.Theme.Header = pal.Header
    Window.Theme.TabBackground = pal.TabBar
    Window.Theme.Section = pal.Surface
    Window.Theme.SectionBorder = pal.Border
    Window.Theme.ElementBackground = pal.Element
    Window.Theme.ElementBorder = pal.Border:Lerp(acc, 0.14)
    Window.Theme.Inline = pal.Element:Lerp(acc, 0.16)
    Window.Theme.Text = pal.Text
    Window.Theme.SubText = pal.MutedText

    -- MainWindow background & CelestialSpaceGradient
    mf.BackgroundColor3 = pal.Background
    mf.BackgroundTransparency = Window.TransparentEnabled and 0.14 or 0.02
    local bgGrad = mf:FindFirstChild("CelestialSpaceGradient")
    if bgGrad and bgGrad:IsA("UIGradient") then
        bgGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, pal.Background:Lerp(acc, 0.08)),
            ColorSequenceKeypoint.new(0.5, pal.Background),
            ColorSequenceKeypoint.new(1.0, pal.Surface:Lerp(acc, 0.05))
        })
    end

    -- Outer CelestialBorder & InnerBorder
    if Window.OuterStrokeGrad then
        Window.OuterStrokeGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, acc:Lerp(Color3.new(1, 1, 1), 0.35)),
            ColorSequenceKeypoint.new(0.35, acc),
            ColorSequenceKeypoint.new(0.70, pal.Border),
            ColorSequenceKeypoint.new(1.0, acc:Lerp(Color3.new(1, 1, 1), 0.15))
        })
    end

    -- Header & Header AccentLine
    local header = mf:FindFirstChild("Header")
    if header then
        header.BackgroundColor3 = pal.Header
        header.BackgroundTransparency = Window.TransparentEnabled and 0.12 or 0
        local hLine = header:FindFirstChild("AccentLine")
        if hLine then
            hLine.BackgroundColor3 = acc
            local hg = hLine:FindFirstChildOfClass("UIGradient")
            if hg then
                hg.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, pal.Border),
                    ColorSequenceKeypoint.new(0.5, acc:Lerp(Color3.new(1, 1, 1), 0.25)),
                    ColorSequenceKeypoint.new(1.0, pal.Border)
                })
            end
        end
        local logo = header:FindFirstChild("Logo")
        if logo and logo:IsA("ImageLabel") then logo.ImageColor3 = acc end
        local titleLbl = header:FindFirstChild("TitleLabel")
        if titleLbl and titleLbl:IsA("TextLabel") then titleLbl.TextColor3 = pal.Text end
    end

    -- TabBar & Tabs
    local tabBar = Window.TabBar or mf:FindFirstChild("TabBar")
    if tabBar then
        tabBar.BackgroundColor3 = pal.TabBar
        tabBar.BackgroundTransparency = Window.TransparentEnabled and 0.22 or 0.04
        local tbStroke = tabBar:FindFirstChildOfClass("UIStroke")
        if tbStroke then
            tbStroke.Color = pal.Border:Lerp(acc, 0.18)
            tbStroke.Transparency = 0.25
        end
    end

    for _, tab in ipairs(Window.Tabs or {}) do
        local isAct = (Window.ActiveTab == tab)
        if tab.Button then
            tab.Button.BackgroundColor3 = isAct and pal.Surface:Lerp(acc, 0.10) or pal.TabBar
            tab.Button.BackgroundTransparency = isAct and 0.12 or 0.45
        end
        if tab.TextLabel then
            tab.TextLabel.TextColor3 = isAct and pal.Text or pal.MutedText
        end
        if tab.IconImage then
            tab.IconImage.ImageColor3 = isAct and acc or pal.MutedText
        end
        if tab.ActiveLine then
            tab.ActiveLine.BackgroundColor3 = acc
        end
    end

    -- Section Cards, Custom Cards, TopCategoryNav, Inputs, Buttons, Sliders, Dropdowns, Toggles
    local contentArea = Window.ContentArea or mf:FindFirstChild("ContentArea")
    if contentArea then
        for _, desc in ipairs(contentArea:GetDescendants()) do
            if desc:IsA("Frame") then
                local nm = desc.Name
                if nm:find("^Section_") or nm == "CustomCard" or nm == "TopCategoryNav" or nm == "TopAutoNav" or nm == "RosterHeaderCard" or nm:find("^PlayerCard_") then
                    desc.BackgroundColor3 = pal.Surface
                    desc.BackgroundTransparency = Window.TransparentEnabled and 0.20 or 0.03
                    local st = desc:FindFirstChildOfClass("UIStroke")
                    if st then
                        st.Color = pal.Border:Lerp(acc, 0.16)
                        st.Transparency = 0.22
                    end
                elseif nm == "SecAccent" or nm == "CardAccent" then
                    desc.BackgroundColor3 = acc
                    desc.Size = UDim2.new(1, 0, 0, 2)
                    desc.Position = UDim2.fromOffset(0, 0)
                    local ag = desc:FindFirstChild("NexaraAccentGrad")
                    if not ag then
                        ag = Instance.new("UIGradient")
                        ag.Name = "NexaraAccentGrad"
                        ag.Parent = desc
                    end
                    ag.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.0, acc:Lerp(Color3.new(1, 1, 1), 0.2)),
                        ColorSequenceKeypoint.new(0.45, acc),
                        ColorSequenceKeypoint.new(1.0, pal.Surface)
                    })
                    ag.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0.0, 0.0),
                        NumberSequenceKeypoint.new(0.55, 0.25),
                        NumberSequenceKeypoint.new(1.0, 0.88)
                    })
                elseif nm == "ValBadge" then
                    desc.BackgroundColor3 = pal.Element
                    local st = desc:FindFirstChildOfClass("UIStroke")
                    if st then st.Color = pal.Border:Lerp(acc, 0.22) end
                elseif nm == "Pill" and desc.Parent and desc.Parent.Name == "Trigger" then
                    -- Sync standard UI library toggles that weren't created via colored toggle hook
                    local knob = desc:FindFirstChild("Knob")
                    local isOn = knob and (knob.Position.X.Scale > 0.5 or knob.Position.X.Offset < 0)
                    local offCol = pal.Surface:Lerp(Color3.fromRGB(28, 32, 46), 0.45)
                    desc.BackgroundColor3 = isOn and acc or offCol
                    local pst = desc:FindFirstChildOfClass("UIStroke")
                    if pst then
                        pst.Color = isOn and acc:Lerp(Color3.new(1, 1, 1), 0.25) or offCol:Lerp(acc, 0.22)
                        pst.Transparency = isOn and 0.35 or 0.15
                    end
                    if knob then
                        knob.BackgroundColor3 = isOn and Color3.fromRGB(10, 12, 18) or Color3.fromRGB(132, 142, 162)
                    end
                elseif desc.BackgroundTransparency < 0.95 and desc.Parent and (desc.Parent.Name == "QuickCard" or desc.Parent.Name == "CustomCard" or desc.Parent.Name == "Frame") then
                    desc.BackgroundColor3 = pal.Element
                end
            elseif desc:IsA("TextButton") or desc:IsA("TextBox") then
                local nm = desc.Name
                if nm == "Button" or nm == "Track" or nm == "Field" or nm == "BindButton" or nm == "Btn" or nm:find("^Button_") or nm:find("^Btn_") then
                    if desc.Text ~= "Unload" then
                        desc.BackgroundColor3 = pal.Element
                    end
                    local st = desc:FindFirstChildOfClass("UIStroke")
                    if st then
                        st.Color = pal.Border:Lerp(acc, 0.18)
                        st.Transparency = 0.2
                    end
                elseif desc.Text == "Run" or desc.Text == "Copy" then
                    desc.BackgroundColor3 = acc
                    desc.TextColor3 = Color3.fromRGB(10, 12, 18)
                end
            end
        end
    end

    -- Sync Dropdown Popups in ScreenGui
    if Window.Gui then
        for _, ch in ipairs(Window.Gui:GetChildren()) do
            if ch.Name == "DropdownPopup" and ch:IsA("ScrollingFrame") then
                ch.BackgroundColor3 = pal.Surface
                ch.ScrollBarImageColor3 = acc
                local st = ch:FindFirstChildOfClass("UIStroke")
                if st then st.Color = pal.Border:Lerp(acc, 0.22) end
            end
        end
    end

    -- Sync Celestial Nebula & Constellations to current Theme & Accent
    if #rwNebulaFrames >= 3 then
        pcall(function()
            rwNebulaFrames[1].BackgroundColor3 = pal.Nebula1:Lerp(acc, 0.18)
            rwNebulaFrames[2].BackgroundColor3 = pal.Nebula2:Lerp(acc, 0.16)
            rwNebulaFrames[3].BackgroundColor3 = pal.Nebula1:Lerp(pal.Nebula2, 0.5):Lerp(acc, 0.12)
        end)
    end
    local lineCol = acc:Lerp(Color3.fromRGB(220, 235, 255), 0.55)
    for _, lf in ipairs(rwConstellationLines) do
        if lf and lf.Parent then lf.BackgroundColor3 = lineCol end
    end
    for _, bs in ipairs(rwBeaconStrokes) do
        if bs and bs.Parent then bs.Color = lineCol end
    end
end

local function ClearReworkedWeather()
    if rwWeatherConn then
        pcall(function() rwWeatherConn:Disconnect() end)
        rwWeatherConn = nil
    end
    for _, p in ipairs(rwWeatherParticles) do
        if p.Frame and p.Frame.Parent then pcall(function() p.Frame:Destroy() end) end
    end
    table.clear(rwWeatherParticles)
    for _, ss in ipairs(rwShootingStars) do
        if ss.Frame and ss.Frame.Parent then pcall(function() ss.Frame:Destroy() end) end
    end
    table.clear(rwShootingStars)
    table.clear(rwNebulaFrames)
    table.clear(rwConstellationLines)
    table.clear(rwBeaconStrokes)
    table.clear(rwCrossStars)
    if rwConstellationContainer and rwConstellationContainer.Parent then
        pcall(function() rwConstellationContainer:Destroy() end)
    end
    rwConstellationContainer = nil
    if Window and Window.WindowWeatherLayer then
        for _, ch in ipairs(Window.WindowWeatherLayer:GetChildren()) do
            if ch:IsA("GuiObject") then pcall(function() ch:Destroy() end) end
        end
    end
    if Window and Window.WeatherLayer then
        for _, ch in ipairs(Window.WeatherLayer:GetChildren()) do
            if ch:IsA("GuiObject") then pcall(function() ch:Destroy() end) end
        end
    end
    if Window and Window.MainFrame then
        local topL = Window.MainFrame:FindFirstChild("TopWeatherLayer")
        if topL then pcall(function() topL:ClearAllChildren() end) end
    end
end

