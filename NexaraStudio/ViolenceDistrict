local function GetRosterSurvivorState(plr)
    if IsInLobby() or IsPlayerInLobby(plr) then
        return "Lobby", Color3.fromRGB(0, 210, 255), Color3.fromRGB(10, 40, 55)
    end
    if IsPlayerDead(plr) then
        return "[DEAD]", Color3.fromRGB(150, 150, 150), Color3.fromRGB(35, 35, 35)
    end
    local char = plr.Character
    if not char or not char.Parent then
        return "[DEAD]", Color3.fromRGB(150, 150, 150), Color3.fromRGB(35, 35, 35)
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        return "[DEAD]", Color3.fromRGB(150, 150, 150), Color3.fromRGB(35, 35, 35)
    end

    local CollectionService = game:GetService("CollectionService")

    -- 1. Hooked on Meat Hook
    local isHooked = (char:GetAttribute("IsHooked") == true) or CollectionService:HasTag(char, "Hooked")
    if isHooked then
        return "[HOOKED]", Color3.fromRGB(255, 70, 90), Color3.fromRGB(70, 15, 25)
    end

    -- 2. Carried by Killer
    local isCarried = (char:GetAttribute("IsCarried") == true) or (char:GetAttribute("Carried") == true)
    if isCarried then
        return "[CARRIED]", Color3.fromRGB(210, 120, 255), Color3.fromRGB(55, 20, 75)
    end

    -- 3. Knocked Down (Down state on ground)
    local isDown = (char:GetAttribute("Knocked") == true) or CollectionService:HasTag(char, "Knocked")
    if isDown then
        return "[DOWN]", Color3.fromRGB(255, 150, 40), Color3.fromRGB(65, 35, 10)
    end

    -- 4. Injured (Hit 1 time - Health < 100 or <= 50)
    if hum and hum.Health < 99 then
        return "Injured (" .. math.floor(hum.Health) .. "%)", Color3.fromRGB(255, 200, 60), Color3.fromRGB(60, 50, 10)
    end

    -- 5. Healthy (Full Health)
    return "Healthy", Color3.fromRGB(60, 230, 120), Color3.fromRGB(15, 55, 30)
end

local function GetRosterKillerState(plr)
    if IsInLobby() then
        return "Lobby", Color3.fromRGB(255, 100, 120), Color3.fromRGB(55, 15, 20)
    end
    local char = plr.Character
    if char then
        if char:GetAttribute("IsStunned") == true then
            return "[STUNNED]", Color3.fromRGB(255, 200, 50), Color3.fromRGB(65, 50, 10)
        end
        if char:GetAttribute("IsCarrying") == true then
            return "[CARRYING]", Color3.fromRGB(210, 120, 255), Color3.fromRGB(55, 20, 75)
        end
    end
    return "Hunting", Color3.fromRGB(255, 70, 90), Color3.fromRGB(70, 15, 25)
end

local function GetRosterItemDisplay(plr, isK)
    local rawInfo, isReady = nil, nil
    pcall(function()
        rawInfo, isReady = GetPlayerSkillInfo(plr)
    end)
    if isK then
        local kType = plr:GetAttribute("SelectedKiller") or "The Killer"
        local pwr = kType .. " Power"
        local det = "Ready"
        if rawInfo then
            local clean = rawInfo:gsub("^%[SKILL%]%s*", "")
            pwr = clean
            det = "Active"
        end
        return pwr, det, Color3.fromRGB(255, 100, 120)
    else
        local char = plr.Character
        local bp = plr:FindFirstChild("Backpack")
        local item = plr:GetAttribute("EquippedItem") or (char and char:GetAttribute("EquippedItem"))
            or plr:GetAttribute("SelectedItem") or (char and char:GetAttribute("SelectedItem"))
            or plr:GetAttribute("Item") or (char and char:GetAttribute("Item"))

        local function scanContainer(container)
            if not container then return nil end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Model") or c:IsA("Tool") then
                    local nm = c.Name
                    if ItemIcons[nm] or nm == "Parrying Dagger" or nm == "Adrenaline Shot" or nm == "Flashlight" or nm == "Holy Water" or nm == "Riot Shield" or nm == "Gate" or nm == "WaxBound Candle" or nm == "Shadow Clone" or nm == "Twist of Fate" or nm:find("Syringe") or nm:find("Medkit") or nm == "Bandage" or nm == "Motion Tracker" then
                        return nm
                    end
                end
            end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and not c.Name:lower():find("fist") and not c.Name:lower():find("camera") and not c.Name:lower():find("phone") then
                    return c.Name
                end
            end
            return nil
        end

        if not item or item == "" or item == "None" then
            item = scanContainer(char) or scanContainer(bp)
        end

        if not item or item == "" or item == "None" then
            local ev = plr:FindFirstChild("EquippedItem") or (char and char:FindFirstChild("EquippedItem"))
                or plr:FindFirstChild("Item") or (char and char:FindFirstChild("Item"))
            if ev and (ev:IsA("StringValue") or ev:IsA("ObjectValue")) and ev.Value then
                item = typeof(ev.Value) == "Instance" and ev.Value.Name or tostring(ev.Value)
            end
        end

        if item and item ~= "" and item ~= "None" then
            PlayerItemCache[plr] = item
        elseif not IsInLobby() and PlayerItemCache[plr] then
            item = PlayerItemCache[plr]
        end

        if not item or item == "" or item == "None" then
            return "No Item", "---", Window.Theme.SubText
        end

        local det = "Ready"
        local col = Color3.fromRGB(80, 255, 120)
        if rawInfo then
            local clean = rawInfo:gsub("^%[ITEM%]%s*", "")
            det = clean
            if isReady == false then
                col = Color3.fromRGB(255, 80, 80)
            elseif isReady == true then
                col = Color3.fromRGB(80, 255, 120)
            else
                col = Color3.fromRGB(255, 195, 60)
            end
        end
        return item, det, col
    end
end

