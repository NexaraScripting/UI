local PerkIconCache = {}
local function GetPerkIcon(perkName, desiredTier)
    if not perkName or perkName == "" or perkName == "---" then return nil end
    local tierStr = tostring(desiredTier or 3)
    local cacheKey = perkName .. "_" .. tierStr
    if PerkIconCache[cacheKey] then return PerkIconCache[cacheKey] end

    local clean = perkName:lower():gsub("%s+", ""):gsub("[^%a]", "")
    local rs = game:GetService("ReplicatedStorage")
    local tiersToCheck = { tierStr }
    for _, t in ipairs({"3", "2", "1"}) do
        if t ~= tierStr then table.insert(tiersToCheck, t) end
    end

    -- 1. Search ReplicatedStorage.Perks (Survivor Perks)
    if rs:FindFirstChild("Perks") then
        for _, pFolder in ipairs(rs.Perks:GetChildren()) do
            local pClean = pFolder.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if pClean == clean then
                for _, tier in ipairs(tiersToCheck) do
                    local tObj = pFolder:FindFirstChild(tier)
                    if tObj and (tObj:IsA("ImageLabel") or tObj:IsA("ImageButton")) and tObj.Image ~= "" then
                        PerkIconCache[cacheKey] = tObj.Image
                        return tObj.Image
                    end
                end
            end
        end
    end

    -- 2. Search ReplicatedStorage.Killers (Killer Perks)
    if rs:FindFirstChild("Killers") then
        for _, kFolder in ipairs(rs.Killers:GetChildren()) do
            local kPerks = kFolder:FindFirstChild("Perks")
            if kPerks then
                for _, pFolder in ipairs(kPerks:GetChildren()) do
                    local pClean = pFolder.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                    if pClean == clean then
                        for _, tier in ipairs(tiersToCheck) do
                            local tObj = pFolder:FindFirstChild(tier)
                            if tObj and (tObj:IsA("ImageLabel") or tObj:IsA("ImageButton")) and tObj.Image ~= "" then
                                PerkIconCache[cacheKey] = tObj.Image
                                return tObj.Image
                            end
                        end
                        for _, c in ipairs(pFolder:GetChildren()) do
                            if (c:IsA("ImageLabel") or c:IsA("ImageButton")) and c.Image ~= "" then
                                PerkIconCache[cacheKey] = c.Image
                                return c.Image
                            end
                        end
                    end
                end
            end
        end
    end

    return nil
end

local ItemIconCache = {}
local function GetItemIcon(itemName)
    if not itemName or itemName == "" or itemName == "No Item" or itemName == "None" then return nil end
    if ItemIconCache[itemName] then return ItemIconCache[itemName] end
    if ItemIcons[itemName] then
