local function ResolveMaskInfo(maskName)
    if not maskName or maskName == "" then return nil end
    local clean = tostring(maskName):lower():gsub("%s+", ""):gsub("[^%a]", "")
    if MaskDatabase[clean] then
        return MaskDatabase[clean]
    end
    for k, v in pairs(MaskDatabase) do
        if clean:find(k, 1, true) or k:find(clean, 1, true) then
            return v
        end
    end

    return {
        Name = maskName,
        Animal = maskName,
        ModelName = maskName,
        Title = "THE MASKED: " .. maskName:upper(),
        Effect = maskName:upper() .. " POWER ACTIVE",
        Tip = "The Masked has activated a special mask power!",
