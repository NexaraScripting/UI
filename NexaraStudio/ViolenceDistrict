    pctStroke.Parent = PctLabel

    local blindProgress = 0
    local blindHoldUntil = 0
    local lastRawBlindness = 0
    local blindUiAlpha = 0

    pcall(function()
        local remItems = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Items")
        local remFl = remItems and remItems:FindFirstChild("Flashlight")
        local gotBlinded = remFl and remFl:FindFirstChild("GotBlinded")
        if gotBlinded and gotBlinded:IsA("RemoteEvent") then
            table.insert(ScriptConnections, gotBlinded.OnClientEvent:Connect(function()
                if Config.BlindProgressEnabled then
                    blindProgress = 1
                    blindHoldUntil = os.clock() + 1.0
                end
            end))
        end
    end)

    table.insert(ScriptConnections, RunService.Heartbeat:Connect(function(dt)
        if not ScriptRunning or IsInLobby() or IsCutsceneActive() then
            if BlindContainer.Visible then BlindContainer.Visible = false end
            return
        end

        local shouldShowBlind = Config.BlindProgressEnabled and TofCombat.IsFlashlightActive()
        if shouldShowBlind then
            blindUiAlpha = math.min(1, blindUiAlpha + dt * 4.5)
        else
            blindUiAlpha = math.max(0, blindUiAlpha - dt * 4.5)
        end

        if blindUiAlpha <= 0.01 then
            if BlindContainer.Visible then BlindContainer.Visible = false end
            blindProgress = 0
            lastRawBlindness = 0
            return
        end

        if not BlindContainer.Visible then
            BlindContainer.Visible = true
        end

        BlindTitle.TextTransparency = 1 - blindUiAlpha
        titleStroke.Transparency = 1 - (0.85 * blindUiAlpha)
        BarBg.BackgroundTransparency = 1 - (0.90 * blindUiAlpha)
        barStroke.Transparency = 1 - (0.90 * blindUiAlpha)
        BarFill.BackgroundTransparency = 1 - blindUiAlpha
        PctLabel.TextTransparency = 1 - blindUiAlpha
        pctStroke.Transparency = 1 - (0.85 * blindUiAlpha)

        local now = os.clock()
        local rawBlindness = nil

        -- Read real server-replicated Blindness (0 to 100) directly from Killer.Character.Head:GetAttribute("Blindness")
        local kp = CurrentKillerPlayer
        if kp and kp.Character and not IsPlayerDead(kp) then
            local head = kp.Character:FindFirstChild("Head")
            local bAttr = (head and head:GetAttribute("Blindness")) or kp.Character:GetAttribute("Blindness")
            if type(bAttr) == "number" then
                rawBlindness = math.clamp(bAttr, 0, 100)
            end
        end

        if rawBlindness ~= nil then
            -- Only hold 100% briefly if the server instantaneously reset Blindness from >=88% straight down to 0 (meaning 100% blind succeeded)
            if (lastRawBlindness >= 88 and rawBlindness <= 1) or rawBlindness >= 99.5 then
                blindHoldUntil = math.max(blindHoldUntil, now + 0.65)
            elseif rawBlindness > 1 and rawBlindness < 99.5 then
                blindHoldUntil = 0
            end
            lastRawBlindness = rawBlindness

            if now < blindHoldUntil and rawBlindness <= 1 then
                blindProgress = 1
            else
                local targetProg = math.clamp(rawBlindness / 100, 0, 1)
                blindProgress = blindProgress + (targetProg - blindProgress) * math.clamp(dt * 24, 0, 1)
                if targetProg == 0 and blindProgress < 0.005 then
                    blindProgress = 0
                elseif targetProg >= 0.995 then
                    blindProgress = 1
                end
            end
        else
            blindProgress = 0
            lastRawBlindness = 0
        end

        local pct = math.clamp(math.floor(blindProgress * 100 + 0.5), 0, 100)
        BarFill.Size = UDim2.new(blindProgress, 0, 1, 0)
        PctLabel.Text = tostring(pct) .. "%"
    end))
end

