        -- Stalker
        if char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") or char:GetAttribute("StalkerStage2Remaining") ~= nil or char:GetAttribute("Stage") ~= nil or char:GetAttribute("StalkStage") or char:GetAttribute("IsStalking") then
