                clone.CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(180), 0)
                clone.Parent = vpf

                local cam = Instance.new("Camera")
                cam.FieldOfView = 36
                local sz = mp.Size.Magnitude
                cam.CFrame = CFrame.new(Vector3.new(0, 0, sz * 1.35), Vector3.new(0, 0, 0))
                cam.Parent = vpf
                vpf.CurrentCamera = cam
                vpf.LightDirection = Vector3.new(0.4, 0.8, -1).Unit
                return true
            end
        end
        return false
    end)
    return ok and success
end

