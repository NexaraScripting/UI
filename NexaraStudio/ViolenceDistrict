local LastPerkScanTime = {}

-- EXACT PERKS RESOLUTION (RESPECTS EXACT SLOTS, NO FAKE FILLERS, LOBBY & IN-GAME VIEWABLE)
GetPlayerPerks = function(player)
    local perks = {}
    if not player then return perks end

    -- Lobby guard: never traverse descendants in lobby!
    if IsInLobby() or IsPlayerInLobby(player) then
        return perks
    end

    -- Fast-path: If perks already resolved in match, return immediately without re-scanning descendants!
    if PersistentPerksCache[player] and #PersistentPerksCache[player] > 0 then
        return PersistentPerksCache[player]
    end

    local now = os.clock()
    if LastPerkScanTime[player] and (now - LastPerkScanTime[player] < 5.0) then
        return PersistentPerksCache[player] or perks
    end
    LastPerkScanTime[player] = now

    local isK = IsKiller(player)
    local targetNorm = isK and KnownKillerPerksNormalized or KnownSurvivorPerksNormalized
    local otherNorm = isK and KnownSurvivorPerksNormalized or KnownKillerPerksNormalized

    local function matchPerkName(rawName)
        if not rawName then return nil end
        local str = tostring(rawName):lower()
        str = str:gsub("^script:", ""):gsub("^localscript:", "")
        str = str:gsub("^perk%d*[_%s]*", ""):gsub("^slot%d*[_%s]*", ""):gsub("^p%d*[_%s]*", "")
        str = str:gsub("[_%s]*tier[%s%d]*$", ""):gsub("[_%s]*t%d+$", ""):gsub("[_%s]*lvl[%s%d]*$", ""):gsub("[_%s]*active$", ""):gsub("[_%s]*cooldown$", ""):gsub("[_%s]*cd$", ""):gsub("[_%s]*proc$", ""):gsub("%d+$", "")
        local clean = str:gsub("%s+", ""):gsub("[^%a]", "")
        if #clean < 3 or IgnoredAttributes[clean] then return nil end
        if StatusToPerkMap[clean] then return StatusToPerkMap[clean] end
        if targetNorm and targetNorm[clean] then return targetNorm[clean] end
        if otherNorm and otherNorm[clean] then return otherNorm[clean] end
        if targetNorm then
            for k, v in pairs(targetNorm) do
                if clean == k or (clean:find(k, 1, true) and #k >= 6) or (#clean >= 6 and k:find(clean, 1, true)) then
                    return v
                end
            end
        end
        if otherNorm then
            for k, v in pairs(otherNorm) do
                if clean == k or (clean:find(k, 1, true) and #k >= 6) or (#clean >= 6 and k:find(clean, 1, true)) then
                    return v
                end
            end
        end
        return nil
    end

    local function addPerk(rawPerk, defaultTier)
        if not rawPerk or #perks >= 3 then return end
        local pName = nil
        local pTier = defaultTier or 3
        if type(rawPerk) == "table" then
            pName = rawPerk.name or rawPerk.Name or rawPerk.perk or rawPerk.Perk or rawPerk.perkName or rawPerk.PerkName or rawPerk.id or rawPerk.ID or rawPerk[1]
            pTier = rawPerk.tier or rawPerk.Tier or rawPerk.level or rawPerk.Level or rawPerk.lvl or rawPerk.Lvl or rawPerk[2] or pTier
        elseif type(rawPerk) == "string" then
            pName = rawPerk
        end
        if pName and type(pName) == "string" and pName ~= "" and pName ~= "---" and pName ~= "None" then
            local clean = pName:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if not IgnoredAttributes[clean] then
                local mapped = matchPerkName(pName) or (targetNorm and targetNorm[clean]) or (otherNorm and otherNorm[clean])
                if mapped and mapped ~= "" then
                    local cleanMapped = mapped:lower():gsub("%s+", ""):gsub("[^%a]", "")
                    if not IgnoredAttributes[cleanMapped] and not table.find(perks, mapped) and #perks < 3 then
                        table.insert(perks, mapped)
                        PlayerPerkTiers[player] = PlayerPerkTiers[player] or {}
                        PlayerPerkTiers[player][mapped] = tonumber(pTier) or 3
                    end
                end
            end
        end
    end

    local rs = game:GetService("ReplicatedStorage")
    local rem = rs:FindFirstChild("Remotes")

    -- 1. Local Player: query authoritative server remotes for exact equipped slots
    if player == LocalPlayer then
        local remoteDone = false
        if isK then
            local sk = rem and rem:FindFirstChild("ShopKillers")
            local getKiller = sk and sk:FindFirstChild("GetEquippedKillerPerks")
            local kType = player:GetAttribute("SelectedKiller") or "Veil"
            if getKiller then
                pcall(function()
                    local res = getKiller:InvokeServer(kType)
                    if type(res) == "table" then
                        remoteDone = true
                        for _, slot in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "Perk1", "Perk2", "Perk3", "1", "2", "3"}) do
                            if res[slot] then addPerk(res[slot]) end
                        end
                        for _, val in pairs(res) do
                            addPerk(val)
                        end
                    end
                end)
            end
        else
            local shop = rem and rem:FindFirstChild("Shop")
            local getSurv = shop and shop:FindFirstChild("GetEquippedPerks")
            if getSurv then
                pcall(function()
                    local res = getSurv:InvokeServer()
                    if type(res) == "table" then
                        remoteDone = true
                        for _, slot in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "Perk1", "Perk2", "Perk3", "1", "2", "3"}) do
                            if res[slot] then addPerk(res[slot]) end
                        end
                        for _, p in pairs(res) do
                            addPerk(p)
                        end
                    end
                end)
            end
            if not remoteDone and player:FindFirstChild("PlayerGui") then
                local sp = player.PlayerGui:FindFirstChild("SurvivorPerks")
                local pFolder = sp and (sp:FindFirstChild("Perks") or sp:FindFirstChild("Perkspc"))
                if pFolder then
                    for _, c in ipairs(pFolder:GetChildren()) do
                        if c:IsA("ImageLabel") and c.Name ~= "cdviz" and c.Name ~= "bg" and not c.Name:find("UI") then
                            local mapped = matchPerkName(c.Name)
                            if mapped then addPerk(mapped) end
                        end
                    end
                end
            end
        end

        if remoteDone or #perks > 0 then
            PersistentPerksCache[player] = perks
            return perks
        end
    end

    -- 2. Other Players: Check ALL in-game vectors
    -- Pre-seed from existing match cache, but sanitize against player's current role and IgnoredAttributes!
    if PersistentPerksCache[player] then
        local roleCleanCache = {}
        for _, p in ipairs(PersistentPerksCache[player]) do
            local pClean = p:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if not IgnoredAttributes[pClean] and not p:find("^%[Active Perk") then
                local isKnownKiller = KnownKillerPerksNormalized and KnownKillerPerksNormalized[pClean] ~= nil
                local isKnownSurvivor = KnownSurvivorPerksNormalized and KnownSurvivorPerksNormalized[pClean] ~= nil
                local keep = true
                if isK and isKnownSurvivor and not isKnownKiller then
                    keep = false
                elseif not isK and isKnownKiller and not isKnownSurvivor then
                    keep = false
                end
                if keep then
                    table.insert(roleCleanCache, p)
                    addPerk(p, PlayerPerkTiers[player] and PlayerPerkTiers[player][p] or 3)
                end
            end
        end
        PersistentPerksCache[player] = roleCleanCache
    end

    local char = player.Character

    -- Vector A: Explicit slot attributes (perk1, perk2, perk3, Slot1, Slot2, Slot3, p1, p2, p3)
    for _, slotKey in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "Perk1", "Perk2", "Perk3", "p1", "p2", "p3"}) do
        if #perks >= 3 then break end
        local val = player:GetAttribute(slotKey) or (char and char:GetAttribute(slotKey))
        if val and type(val) == "string" and val ~= "" and val ~= "None" then
            local mapped = matchPerkName(val)
            if mapped then addPerk(mapped) end
        end
    end

    -- Vector B: Character Descendants & Scripts (cloned perk scripts & animation/sound indicators)
    if char then
        for _, c in ipairs(char:GetDescendants()) do
            if #perks >= 3 then break end
            local cleanC = c.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if not IgnoredAttributes[cleanC] then
                local mapped = matchPerkName(c.Name)
                if mapped then
                    local t = tonumber(c.Name:match("(%d+)$")) or (c:IsA("ValueBase") and tonumber(c.Value)) or 3
                    addPerk(mapped, t)
                elseif c:IsA("ValueBase") and c.Value and c.Value ~= false and c.Value ~= 0 and c.Value ~= "" then
                    local vClean = tostring(c.Value):lower():gsub("%s+", ""):gsub("[^%a]", "")
                    if not IgnoredAttributes[vClean] then
                        local vMapped = matchPerkName(tostring(c.Value))
                        if vMapped then addPerk(vMapped, 3) end
                    end
                end
            end
        end
    end

    -- Vector C: Player Backpack (Tools/Scripts/Values)
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, c in ipairs(bp:GetChildren()) do
            if #perks >= 3 then break end
            local cleanC = c.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
            if not IgnoredAttributes[cleanC] then
                local t = tonumber(c.Name:match("(%d+)$")) or (c:IsA("ValueBase") and tonumber(c.Value)) or 3
                local mapped = matchPerkName(c.Name)
                if mapped then
                    addPerk(mapped, t)
                elseif c:IsA("ValueBase") and c.Value and c.Value ~= false and c.Value ~= 0 and c.Value ~= "" then
                    local vClean = tostring(c.Value):lower():gsub("%s+", ""):gsub("[^%a]", "")
                    if not IgnoredAttributes[vClean] then
                        local vMapped = matchPerkName(tostring(c.Value))
                        if vMapped then addPerk(vMapped, t) end
                    end
                end
            end
        end
    end

    -- Vector D: Direct Attributes on Character & Player (strict filter: ignores base physics/movement attributes)
    local function scanDirectAttrs(inst)
        if not inst then return end
        local attrs = nil
        pcall(function() attrs = inst:GetAttributes() end)
        if not attrs then return end
        for attrName, attrVal in pairs(attrs) do
            if #perks >= 3 then break end
            local cleanName = tostring(attrName):lower():gsub("%s+", ""):gsub("[^%a]", "")
            if not IgnoredAttributes[cleanName] and attrVal ~= false and attrVal ~= 0 and attrVal ~= "" and attrVal ~= "None" then
                local mappedKey = matchPerkName(attrName)
                if mappedKey then
                    local t = (type(attrVal) == "number" and attrVal >= 1 and attrVal <= 3) and attrVal or 3
                    addPerk(mappedKey, t)
                end
            end
            if type(attrVal) == "string" and attrVal ~= "" and attrVal ~= "None" then
                local cleanVal = attrVal:lower():gsub("%s+", ""):gsub("[^%a]", "")
                if not IgnoredAttributes[cleanVal] then
                    local mappedVal = matchPerkName(attrVal)
                    if mappedVal then
                        addPerk(mappedVal, 3)
                    end
                end
            end
        end
    end
    scanDirectAttrs(char)
    scanDirectAttrs(player)

    -- Vector E: Dedicated Perks / EquippedPerks container
    local pFolders = {
        player:FindFirstChild("Perks"),
        player:FindFirstChild("EquippedPerks"),
        player:FindFirstChild("SelectedPerks"),
        char and char:FindFirstChild("Perks"),
        char and char:FindFirstChild("EquippedPerks"),
    }
    for _, f in ipairs(pFolders) do
        if f then
            for _, c in ipairs(f:GetChildren()) do
                if #perks >= 3 then break end
                local cleanC = c.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                if not IgnoredAttributes[cleanC] then
                    local mapped = matchPerkName(c.Name)
                    local t = c:IsA("ValueBase") and tonumber(c.Value) or 3
                    if mapped then
                        addPerk(mapped, t)
                    elseif c:IsA("ValueBase") and c.Value and c.Value ~= false and c.Value ~= 0 and c.Value ~= "" then
                        local vClean = tostring(c.Value):lower():gsub("%s+", ""):gsub("[^%a]", "")
                        if not IgnoredAttributes[vClean] then
                            local vMapped = matchPerkName(tostring(c.Value))
                            if vMapped then addPerk(vMapped, 3) end
                        end
                    end
                end
            end
        end
    end

    -- Vector F: ReplicatedStorage player data container (if exists)
    local pData = ReplicatedStorage:FindFirstChild(player.Name) or (ReplicatedStorage:FindFirstChild("PlayerData") and ReplicatedStorage.PlayerData:FindFirstChild(player.Name)) or (ReplicatedStorage:FindFirstChild("Players") and ReplicatedStorage.Players:FindFirstChild(player.Name))
    if pData then
        local pf = pData:FindFirstChild("Perks") or pData:FindFirstChild("EquippedPerks")
        if pf then
            for _, c in ipairs(pf:GetChildren()) do
                if #perks >= 3 then break end
                local cleanC = c.Name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                if not IgnoredAttributes[cleanC] then
                    local mapped = matchPerkName(c.Name) or (c:IsA("ValueBase") and matchPerkName(tostring(c.Value)))
                    if mapped then addPerk(mapped) end
                end
            end
        end
    end

    -- Save exact equipped perks to match cache (does NOT fake-fill missing slots)
    if #perks > 0 then
        PersistentPerksCache[player] = perks
    end

    return PersistentPerksCache[player] or perks
end

-- Player disconnect cleanup: only clear caches when player genuinely leaves the server
table.insert(ScriptConnections, Players.PlayerRemoving:Connect(function(leavingPlr)
    if leavingPlr == CurrentKillerPlayer then CurrentKillerPlayer = nil end
    PersistentPerksCache[leavingPlr] = nil
    PlayerPerkTiers[leavingPlr] = nil
    if cachedRosterRows[leavingPlr] then
        pcall(function() cachedRosterRows[leavingPlr].Card:Destroy() end)
        cachedRosterRows[leavingPlr] = nil
    end
end))

-- SEPARATE SKILLS, CHARGES & COOLDOWNS
function GetPlayerSkillInfo(player)
    if not player or not player.Character then return nil end
    if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return nil end
    local char = player.Character
    if IsKiller(player) then
        PlayerItemCache[player] = nil
        local kName = player:GetAttribute("SelectedKiller") or (char and char:GetAttribute("SelectedKiller")) or (char and char:GetAttribute("MorphedKiller")) or "Killer"
        if char then
            if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") then
                kName = "Veil"
            elseif char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") or char:GetAttribute("corpsecharge") then
                kName = "Cure"
            elseif char:GetAttribute("StalkerStage2Remaining") ~= nil or char:GetAttribute("Stage") ~= nil or char:GetAttribute("StalkStage") ~= nil or char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") then
                kName = "Stalker"
            elseif char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") then
                kName = "Hidden"
            elseif char:FindFirstChild("Katana") or char:FindFirstChild("Sword") or char:FindFirstChild("pamela") or char:GetAttribute("Pursuit") ~= nil or char:GetAttribute("LakeMist") ~= nil then
                kName = "Slasher"
            elseif char:FindFirstChild("Abysswalker") or char:FindFirstChild("Wave") then
                kName = "Abysswalker"
            elseif char:GetAttribute("Mask") or char:GetAttribute("MaskExpired") then
                kName = "Masked"
            elseif char:FindFirstChild("Beartrap") or char:FindFirstChild("BearTrap") or char:GetAttribute("Butcher") == true or char:GetAttribute("MorphedKiller") == "Butcher" or (char:FindFirstChild("Weapon") and char.Weapon:FindFirstChild("Main")) or char:GetAttribute("PlacingTrap") ~= nil or char:GetAttribute("ChainLatched") ~= nil or char:GetAttribute("ChainThrowUntil") ~= nil or char:GetAttribute("ChainMove1CD") ~= nil or char:GetAttribute("Beartraps") ~= nil or kName == "Butcher" then
                kName = "Butcher"
            end
        end
        local skillEntries = {}
        local extras = {}
        local now = os.clock()

        if kName == "Cure" or char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") then
            -- Skill 1: Plague Flask (Elucidation - 15s CD)
            local flaskCD = math.max(0, math.ceil(CureFlaskCooldownEnd - now))
            local flaskStatus = flaskCD > 0 and ("CD " .. flaskCD .. "s") or "Ready"
            if char:GetAttribute("prepareflask") then flaskStatus = "[CHARGING!]" end
            table.insert(skillEntries, "Plague Flask [" .. flaskStatus .. "]")

            -- Skill 2: Corpse Syringe (I Am The Cure - 0-4 Zombies)
            local corpses = tonumber(char:GetAttribute("corpsecharge")) or 0
            local syringeStatus = tostring(corpses) .. "/4 Zombies"
            if char:GetAttribute("injecting") or char:GetAttribute("cureinject") then syringeStatus = "[INJECTING]" end
            table.insert(skillEntries, "Corpse Syringe [" .. syringeStatus .. "]")

        elseif kName == "Veil" or char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") then
            local isAiming = char:GetAttribute("spearmode") == true
            local isHoldingThrow = false
            local isFullyCharged = false

            -- Check animation tracks on killer to detect charging / holding throw (exact numeric IDs from game)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = {}
            if animator then
                pcall(function()
                    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            if hum and #tracks == 0 then
                pcall(function()
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            for _, track in ipairs(tracks) do
                local aName = (track.Animation and track.Animation.Name or ""):lower()
                local aId = (track.Animation and track.Animation.AnimationId or ""):lower()
                if aId:find("138045669415653") or aId:find("137688077908355") or aName:find("spearlunge.*op") or aName:find("1op") or aName:find("2op") then
                    isFullyCharged = true
                    break
                elseif aId:find("92098503722633") or aId:find("84093948968516") or aName:find("spearlunge") then
                    isHoldingThrow = true
                end
            end

            -- Detect particles on physical spear model in hand (enabled when holding >= 2s)
            if not isFullyCharged then
                for _, spName in ipairs({"Spear1", "Spear2"}) do
                    local sp = char:FindFirstChild(spName)
                    local hb = sp and sp:FindFirstChild("Hitbox")
                    if hb then
                        for _, pe in ipairs(hb:GetChildren()) do
                            if pe:IsA("ParticleEmitter") and pe.Enabled then
                                isFullyCharged = true
                                break
                            end
                        end
                    end
                    if isFullyCharged then break end
                end
            end

            local spears = tonumber(char:GetAttribute("Spears"))
            if spears == nil then
                local spCount = 0
                if char:FindFirstChild("Spear1") then spCount = spCount + 1 end
                if char:FindFirstChild("Spear2") then spCount = spCount + 1 end
                spears = spCount > 0 and spCount or 2
            end

            -- Animation & Spear Drop State Machine (triggers instantly when charged spear leaves hand)
            if isFullyCharged then
                LastVeilWasCharged = true
            end
            local spearsNum = tonumber(spears) or 2
            local lastSpearsNum = tonumber(LastVeilSpears) or 2
            if spearsNum < lastSpearsNum then
                if (VeilSpearCooldownEnd - now) <= 0 then
                    VeilSpearCooldownEnd = now + 15
                end
                if LastVeilWasCharged or isFullyCharged then
                    VeilVoidCooldownEnd = now + 30
                    LastVeilWasCharged = false
                end
                LastVeilSpears = spearsNum
            elseif spearsNum > lastSpearsNum then
                LastVeilSpears = spearsNum
                if spearsNum < 2 then
                    VeilSpearCooldownEnd = now + 15
                else
                    VeilSpearCooldownEnd = 0
                end
            end
            if not isAiming and not isHoldingThrow and not isFullyCharged and (VeilVoidCooldownEnd - now) <= 0 then
                LastVeilWasCharged = false
            end

            -- Skill 1: Spear (Pierced Vow - 2 max, 15s recharge per spear)
            local spearCD = math.max(0, math.ceil(VeilSpearCooldownEnd - now))
            local spearStatus = tostring(spears) .. "/2"
            if spears < 2 and spearCD > 0 then
                spearStatus = tostring(spears) .. "/2 (CD " .. spearCD .. "s)"
            else
                spearStatus = tostring(spears) .. "/2 Ready"
            end
            if isAiming then spearStatus = spearStatus .. " [Aiming]" end
            table.insert(skillEntries, "Spear [" .. spearStatus .. "]")

            -- Skill 2: Echo Void (Through the Veil - 30s cooldown after throwing veiled spear)
            local voidCD = math.max(0, math.ceil(VeilVoidCooldownEnd - now))
            local voidStatus = "Ready"
            if voidCD > 0 then
                voidStatus = "CD " .. voidCD .. "s"
            elseif isFullyCharged then
                voidStatus = "[CHARGED!]"
            elseif isHoldingThrow then
                voidStatus = "[Charging...]"
            end
            table.insert(skillEntries, "Echo Void [" .. voidStatus .. "]")

        elseif kName == "Hidden" then
            -- Real-time animations and velocity triggers for The Hidden
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = {}
            if animator then
                pcall(function()
                    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            if hum and #tracks == 0 then
                pcall(function()
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end

            local isLeapingAnim = false
            local isM2Anim = false
            for _, t in ipairs(tracks) do
                local aId = (t.Animation and t.Animation.AnimationId or ""):lower()
                local aNm = (t.Animation and t.Animation.Name or ""):lower()
                if aId:find("109928123357793") or aId:find("82153811221085") or aNm:find("jump") then
                    isLeapingAnim = true
                elseif aId:find("98163597193511") or aId:find("114699370608778") or aNm:find("m2") then
                    isM2Anim = true
                end
            end

            if root and root.AssemblyLinearVelocity then
                local vel = root.AssemblyLinearVelocity
                local horizVel = Vector3.new(vel.X, 0, vel.Z).Magnitude
                if (horizVel > 45 and vel.Y > 12) or isLeapingAnim then
                    if (HiddenLeapCooldownEnd - now) <= 0 then
                        HiddenLeapCooldownEnd = now + 25
                    end
                end
                if horizVel > 110 or isM2Anim or char:FindFirstChild("TempHitbox") then
                    if (HiddenMarkCooldownEnd - now) <= 0 then
                        HiddenMarkCooldownEnd = now + 17
                    end
                end
            end

            -- Skill 1: Shadow Leap (25s CD)
            local leapCD = math.max(0, math.ceil(HiddenLeapCooldownEnd - now))
            local leapStatus = leapCD > 0 and ("CD " .. leapCD .. "s") or "Ready"
            table.insert(skillEntries, "Shadow Leap [" .. leapStatus .. "]")

            -- Skill 2: Mark (17s CD)
            local markCD = math.max(0, math.ceil(HiddenMarkCooldownEnd - now))
            local markStatus = "Ready"
            if markCD > 0 then
                markStatus = "CD " .. markCD .. "s"
            elseif char:GetAttribute("preparem2") or char:GetAttribute("M2") then
                markStatus = "[AIMING!]"
            end
            table.insert(skillEntries, "Mark [" .. markStatus .. "]")

            if char:GetAttribute("invisible") or (char:FindFirstChild("Head") and char.Head.Transparency > 0.4) then
                table.insert(extras, "[INVISIBLE]")
            end

        elseif kName == "Slasher" then
            local sTorso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            local mistAttr = char:GetAttribute("LakeMist") == true
                          or game:GetService("CollectionService"):HasTag(char, "Undetectable")
                          or (sTorso and sTorso.Transparency > 0.5)
            if mistAttr and not LastSlasherMist then
                LastSlasherMist = true
                SlasherMistActiveEnd = now + 13
                SlasherMistCooldownEnd = 0
            elseif not mistAttr and LastSlasherMist then
                LastSlasherMist = false
                SlasherMistActiveEnd = 0
                SlasherMistCooldownEnd = now + 60
            end

            local pursuitAttr = char:GetAttribute("Pursuit") == true
            if pursuitAttr and not LastSlasherPursuit then
                LastSlasherPursuit = true
                SlasherPursuitActiveEnd = now + 20
                SlasherPursuitCooldownEnd = now + 100
            elseif not pursuitAttr and LastSlasherPursuit then
                LastSlasherPursuit = false
                SlasherPursuitActiveEnd = 0
                SlasherPursuitCooldownEnd = now + 80
            end

            -- Skill 1: Lake Mist (Q - 13s max active duration, 60s CD after deactivation)
            local mistActive = math.max(0, math.ceil(SlasherMistActiveEnd - now))
            local mistCD = math.max(0, math.ceil(SlasherMistCooldownEnd - now))
            local mistStatus = "Ready"
            if mistAttr or mistActive > 0 then
                mistStatus = mistActive > 0 and ("[ACTIVE (" .. mistActive .. "s)]") or "[ACTIVE]"
            elseif mistCD > 0 then
                mistStatus = "CD " .. mistCD .. "s"
            end
            table.insert(skillEntries, "Lake Mist [" .. mistStatus .. "]")

            -- Skill 2: Pursuit (Right-Click - 20s active duration, 80s CD after ends)
            local pursuitActive = math.max(0, math.ceil(SlasherPursuitActiveEnd - now))
            local pursuitCD = math.max(0, math.ceil(SlasherPursuitCooldownEnd - now))
            local pursuitStatus = "Ready"
            if pursuitAttr or pursuitActive > 0 then
                pursuitStatus = "[ACTIVE (" .. (pursuitActive > 0 and pursuitActive or 20) .. "s)]"
            elseif pursuitCD > 0 then
                pursuitStatus = "CD " .. pursuitCD .. "s"
            end
            table.insert(skillEntries, "Pursuit [" .. pursuitStatus .. "]")

        elseif kName == "Stalker" then
            local stage = tonumber(char:GetAttribute("Stage") or char:GetAttribute("StalkStage") or char:GetAttribute("EvolveStage")) or 1
            if stage ~= LastStalkerStage then
                LastStalkerStage = stage
                if stage >= 2 and StalkerHunterEnd <= now then
                    StalkerHunterEnd = now + 70
                end
            end

            -- Stalking Detection & True Server HUD Sync
            local isStalking = false
            if player == LocalPlayer then
                local m2Down = false
                pcall(function()
                    m2Down = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                end)
                isStalking = m2Down or StalkerIsStalking

                -- Read authoritative progress directly from Stalker GUI if available
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                local slasherGui = pg and (pg:FindFirstChild("Slasher") or pg:FindFirstChild("Slasher-mob") or pg:FindFirstChild("Slasher-con"))
                local bLeft = slasherGui and slasherGui:FindFirstChild("bottom left")
                if bLeft then
                    local moveGrad = bLeft:FindFirstChild("Move") and bLeft.Move:FindFirstChild("Bar") and bLeft.Move.Bar:FindFirstChild("UIGradient")
                    if moveGrad then
                        StalkerStalkPct = math.clamp(math.floor((1 - moveGrad.Offset.Y) * 100 + 0.5), 0, 100)
                    end
                    local moveIcon = bLeft:FindFirstChild("Move") and bLeft.Move:FindFirstChild("Icon")
                    if moveIcon then
                        StalkerGraspReady = (moveIcon.ImageColor3.R > 0.8)
                    end
                    local move1Grad = bLeft:FindFirstChild("Move1") and bLeft.Move1:FindFirstChild("Bar") and bLeft.Move1.Bar:FindFirstChild("UIGradient")
                    if move1Grad and stage >= 2 then
                        local remSec = math.clamp(math.ceil((move1Grad.Offset.Y - 0.08) / 0.84 * 70), 0, 70)
                        if remSec > 0 then
                            StalkerHunterEnd = now + remSec
                        end
                    end
                end
            else
                isStalking = (char:GetAttribute("Speed") or 18.7) <= 10.5
            end

            local pctFloor = math.floor(StalkerStalkPct)
            local stalkStatus = ""
            local hunterLeft = math.max(0, math.ceil(StalkerHunterEnd - now))

            if stage >= 2 or hunterLeft > 0 then
                stalkStatus = hunterLeft > 0 and string.format("HUNTER MODE (%ds)", hunterLeft) or "HUNTER MODE"
            elseif isStalking then
                stalkStatus = string.format("STALKING %d%%", pctFloor)
            elseif pctFloor >= 100 then
                stalkStatus = "100% (Ready to Evolve)"
            else
                stalkStatus = string.format("%d%% (Stage 1)", pctFloor)
            end
            table.insert(skillEntries, "Stalk Mode [" .. stalkStatus .. "]")

            -- Evil's Grasp Status (Lunge Grab Attack - completely decoupled from Stalk %)
            local graspCD = math.max(0, math.ceil(StalkerGraspCooldownEnd - now))
            local isGrabActive = char:GetAttribute("StalkerGrabArmVisible") == true
            local graspStatus = "Locked"

            if isGrabActive then
                graspStatus = "[LUNGE GRABBING!]"
            elseif graspCD > 0 then
                graspStatus = string.format("CD %ds", graspCD)
            elseif StalkerGraspReady or stage >= 2 then
                graspStatus = "READY"
            else
                graspStatus = "Locked"
            end
            table.insert(skillEntries, "Evil's Grasp [" .. graspStatus .. "]")

        elseif kName == "Masked" then
            -- Skill: Mask Up (Random Mask: 60s active duration countdown, swaps every 30s, 30s cooldown)
            local currentMask = char:GetAttribute("Mask") or "Richard"

            if currentMask ~= "Richard" and LastMaskedState == "Richard" then
                MaskedActiveEnd = now + 60
                MaskedCooldownEnd = 0
                LastMaskedState = currentMask
                TriggerMaskAlert(currentMask, true)
            elseif currentMask ~= "Richard" and LastMaskedState ~= "Richard" and LastMaskedState ~= currentMask then
                LastMaskedState = currentMask
                TriggerMaskAlert(currentMask, true)
            elseif currentMask == "Richard" and LastMaskedState ~= "Richard" then
                local prev = LastMaskedState
                MaskedActiveEnd = 0
                MaskedCooldownEnd = now + 30
                LastMaskedState = "Richard"
                TriggerMaskAlert(prev, false)
            end

            local activeLeft = math.max(0, math.ceil(MaskedActiveEnd - now))
            local cdLeft = math.max(0, math.ceil(MaskedCooldownEnd - now))

            if currentMask ~= "Richard" and activeLeft > 0 then
                local mInfo = ResolveMaskInfo(currentMask)
                local eff = mInfo and mInfo.Effect or currentMask
                table.insert(skillEntries, string.format("Mask: %s [%s] (%ds)", currentMask, eff, activeLeft))
            elseif cdLeft > 0 then
                table.insert(skillEntries, string.format("Mask [CD %ds]", cdLeft))
            else
                table.insert(skillEntries, "Mask [Ready]")
            end

        elseif kName == "Killer" or kName == "The Killer" then
            -- Skill 1: Frenzy Sprint (Frenzy Buff: 13s duration, 20s CD after Frenzy ends)
            local isFrenzy = char:GetAttribute("Frenzy") == true
            local isFrenzyEnding = char:GetAttribute("FrenzyEnding") == true

            -- Transition detection from replicated attributes (works for both Killer & Survivors!)
            if isFrenzy and not LastKillerFrenzy then
                LastKillerFrenzy = true
                KillerFrenzyActiveEnd = now + 13
                KillerFrenzyCooldownEnd = 0
            elseif (not isFrenzy or isFrenzyEnding) and LastKillerFrenzy then
                LastKillerFrenzy = false
                KillerFrenzyActiveEnd = 0
                KillerFrenzyCooldownEnd = now + 20
            elseif isFrenzyEnding and (KillerFrenzyCooldownEnd - now) <= 0 then
                LastKillerFrenzy = false
                KillerFrenzyActiveEnd = 0
                KillerFrenzyCooldownEnd = now + 20
            end

            -- If Frenzy is still active on character and timer ran out, keep active alive
            if isFrenzy and (KillerFrenzyActiveEnd - now) <= 0 then
                KillerFrenzyActiveEnd = now + 5
            end

            local frenzyActive = math.max(0, math.ceil(KillerFrenzyActiveEnd - now))
            local frenzyCD = math.max(0, math.ceil(KillerFrenzyCooldownEnd - now))
            local frenzyStatus = "Ready"

            if isFrenzy or (frenzyActive > 0 and not isFrenzyEnding) then
                frenzyStatus = frenzyActive > 0 and ("[ACTIVE (" .. frenzyActive .. "s)]") or "[ACTIVE]"
            elseif isFrenzyEnding then
                local cdLeft = frenzyCD > 0 and frenzyCD or 20
                frenzyStatus = "Fatigue (CD " .. cdLeft .. "s)"
            elseif frenzyCD > 0 then
                frenzyStatus = "CD " .. frenzyCD .. "s"
            else
                frenzyStatus = "Ready"
            end
            table.insert(skillEntries, "Frenzy Sprint [" .. frenzyStatus .. "]")

        elseif kName == "Abysswalker" then
            -- Check real-time playing animations on Abysswalker
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = {}
            if animator then
                pcall(function()
                    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            if hum and #tracks == 0 then
                pcall(function()
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end

            local isSlashing = false
            local isCorrupting = false
            for _, t in ipairs(tracks) do
                local aId = (t.Animation and t.Animation.AnimationId or ""):lower()
                if aId:find("80411309607666") then
                    isSlashing = true
                elseif aId:find("117886494230451") or aId:find("100092272524635") then
                    isCorrupting = true
                end
            end

            -- Skill 1 State Machine (Dark Severance - 30s CD)
            if isSlashing and not LastAbyssSlash then
                LastAbyssSlash = true
                AbyssSlashCooldownEnd = now + 33
            elseif not isSlashing and LastAbyssSlash then
                LastAbyssSlash = false
            end

            -- Skill 2 State Machine (Abyssal Burst - 30s CD)
            if isCorrupting and not LastAbyssBurst then
                LastAbyssBurst = true
                AbyssBurstCooldownEnd = now + 30
            elseif not isCorrupting and LastAbyssBurst then
                LastAbyssBurst = false
            end

            -- Skill 1: Dark Severance (Horizontal Slash - 30s CD)
            local slashCD = math.max(0, math.ceil(AbyssSlashCooldownEnd - now))
            local slashStatus = "Ready"
            if isSlashing then
                slashStatus = "[LUNGING]"
            elseif slashCD > 0 then
                slashStatus = "CD " .. slashCD .. "s"
            end
            table.insert(skillEntries, "Dark Severance [" .. slashStatus .. "]")

            -- Skill 2: Abyssal Burst (Corruption Wave - 30s CD)
            local burstCD = math.max(0, math.ceil(AbyssBurstCooldownEnd - now))
            local burstStatus = "Ready"
            if isCorrupting then
                burstStatus = "[CASTING]"
            elseif burstCD > 0 then
                burstStatus = "CD " .. burstCD .. "s"
            end
            table.insert(skillEntries, "Abyssal Burst [" .. burstStatus .. "]")

        elseif kName == "Butcher" or char:FindFirstChild("Beartrap") or char:FindFirstChild("BearTrap") or char:GetAttribute("Butcher") == true or char:GetAttribute("MorphedKiller") == "Butcher" or char:GetAttribute("PlacingTrap") ~= nil or char:GetAttribute("ChainLatched") ~= nil or char:GetAttribute("ChainMove1CD") ~= nil then
            -- Skill 1: Chain Hook / Throw (15s CD; Note: ChainMove1CD attribute is the static duration 15, NOT a live countdown!)
            local attrCD = tonumber(char:GetAttribute("ChainMove1CD")) or 0
            if attrCD <= 0 and ButcherChainCooldownEnd > now and char:GetAttribute("ChainMove1CD") ~= nil then
                ButcherChainCooldownEnd = 0
            elseif attrCD > 0 and ButcherChainCooldownEnd == 0 then
                -- Seed once if script loaded mid-cooldown
                local windupAt = tonumber(char:GetAttribute("ChainWindupAt")) or 0
                local srvNow = workspace:GetServerTimeNow()
                if windupAt > 0 and (srvNow - windupAt) >= 0 and (srvNow - windupAt) < attrCD then
                    ButcherChainCooldownEnd = now + (attrCD - (srvNow - windupAt))
                else
                    ButcherChainCooldownEnd = now + attrCD
                end
            end
            local chainCD = math.max(0, math.ceil(ButcherChainCooldownEnd - now))
            local srvNow = workspace:GetServerTimeNow()
            local windupAt = tonumber(char:GetAttribute("ChainWindupAt")) or 0
            local throwUntil = tonumber(char:GetAttribute("ChainThrowUntil")) or 0
            local chainStatus = "Ready"
            if char:GetAttribute("ChainLatched") then
                chainStatus = "[HOOKED!]"
            elseif char:GetAttribute("ChainInUse") or char:GetAttribute("ChainBusy") or (throwUntil > srvNow) or (windupAt > 0 and (srvNow - windupAt) >= 0 and (srvNow - windupAt) < 0.85) then
                chainStatus = "[THROWING!]"
            elseif chainCD > 0 then
                chainStatus = "CD " .. chainCD .. "s"
            end
            table.insert(skillEntries, "Chain Throw [" .. chainStatus .. "]")

            -- Skill 2: Bear Trap
            local trapCount = tonumber(char:GetAttribute("Beartraps"))
            local trapCountStr = trapCount and (" (" .. trapCount .. ")") or ""
            local trapEndsAt = tonumber(char:GetAttribute("TrapPlacementEndsAt")) or 0
            local trapStatus = "Ready" .. trapCountStr
            if char:GetAttribute("PlacingTrap") or (trapEndsAt > now) then
                trapStatus = "[PLACING TRAP!]"
            elseif trapCount and trapCount <= 0 then
                trapStatus = "Empty (0)"
            else
                local trapCD = math.max(0, math.ceil(ButcherTrapCooldownEnd - now))
                if trapCD > 0 then
                    trapStatus = "CD " .. trapCD .. "s" .. trapCountStr
                end
            end
            table.insert(skillEntries, "Bear Trap [" .. trapStatus .. "]")

        else
            table.insert(skillEntries, kName .. " Skill 1 [Ready]")
            table.insert(skillEntries, kName .. " Skill 2 [Ready]")
        end

        local bl = tonumber(char:GetAttribute("BloodLust")) or 0
        if bl > 0 then table.insert(extras, "Bloodlust T" .. bl) end

        if char:GetAttribute("IsStunned") == true then table.insert(extras, "[STUNNED]") end
        if char:GetAttribute("IsCarrying") == true then table.insert(extras, "[CARRYING]") end

        local str = "[SKILL] " .. table.concat(skillEntries, "  |  ")
        if #extras > 0 then
            str = str .. "  |  " .. table.concat(extras, " | ")
        end
        return str
    else
        if IsKiller(player) then return nil end
        -- Survivor item, charges, cooldowns, status
        local details = {}
        
        -- 1. Determine Item Name (Check attributes, character children, backpack, and persistent cache)
        local item = player:GetAttribute("EquippedItem") or (char and char:GetAttribute("EquippedItem"))
            or player:GetAttribute("SelectedItem") or (char and char:GetAttribute("SelectedItem"))
            or player:GetAttribute("Item") or (char and char:GetAttribute("Item"))
        local bp = player:FindFirstChild("Backpack")

        local function scanContainer(container)
            if not container then return nil end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Model") or c:IsA("Tool") then
                    local nm = c.Name
                    if ItemIcons[nm] or nm == "Parrying Dagger" or nm == "Adrenaline Shot" or nm == "Flashlight" or nm == "Holy Water" or nm == "Riot Shield" or nm == "Gate" or nm == "WaxBound Candle" or nm == "Shadow Clone" or nm == "Twist of Fate" or nm:find("Syringe") or nm:find("Medkit") or nm == "Bandage" or nm == "Motion Tracker" then
                        return nm
                    end
                end
            end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and not c.Name:lower():find("fist") and not c.Name:lower():find("camera") and not c.Name:lower():find("phone") then
                    return c.Name
                end
            end
            return nil
        end

        if not item or item == "None" or item == "" then
            item = scanContainer(char) or scanContainer(bp)
        end
        if not item or item == "None" or item == "" then
            local ev = player:FindFirstChild("EquippedItem") or (char and char:FindFirstChild("EquippedItem"))
                or player:FindFirstChild("Item") or (char and char:FindFirstChild("Item"))
            if ev and (ev:IsA("StringValue") or ev:IsA("ObjectValue")) and ev.Value then
                item = typeof(ev.Value) == "Instance" and ev.Value.Name or tostring(ev.Value)
            end
        end
        if item and item ~= "None" and item ~= "" then
            PlayerItemCache[player] = item
        elseif not IsInLobby() and PlayerItemCache[player] and not IsKiller(player) then
            item = PlayerItemCache[player]
        else
            item = nil
        end

        local isItemReady, qtyStr = true, ""
        if item and item ~= "None" and item ~= "" then
            local itemInst = char:FindFirstChild(item) or (bp and bp:FindFirstChild(item))
            if not itemInst then
                for _, c in ipairs(char:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end
            if not itemInst and bp then
                for _, c in ipairs(bp:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end

            local uses = itemInst and (itemInst:GetAttribute("uses") or itemInst:GetAttribute("Uses") or itemInst:GetAttribute("charges") or itemInst:GetAttribute("Charges") or itemInst:GetAttribute("charge") or itemInst:GetAttribute("Charge"))
            local maxUses = itemInst and (itemInst:GetAttribute("MaxUses") or itemInst:GetAttribute("maxUses") or itemInst:GetAttribute("MaxCharges") or itemInst:GetAttribute("maxCharges"))
            local rem = itemInst and (itemInst:GetAttribute("remaining") or itemInst:GetAttribute("Remaining"))
            if not rem and itemInst and (item == "Flashlight" or item:find("Flashlight")) then
                local arm = itemInst:FindFirstChild("Right Arm") or itemInst:FindFirstChild("RightHand")
                local flInner = (arm and arm:FindFirstChild("Flashlight")) or itemInst:FindFirstChild("Flashlight", true)
                if flInner then
                    rem = flInner:GetAttribute("remaining") or flInner:GetAttribute("Remaining")
                end
            end

            local usesNum, maxUsesNum = tonumber(uses), tonumber(maxUses)
            if item == "Twist of Fate" or item:find("Twist") then
                local shots = itemInst and itemInst:GetAttribute("shots")
                local maxShots = itemInst and itemInst:GetAttribute("MaxShots") or 3
                local tofState = itemInst and itemInst:GetAttribute("tofState")
                local sCount = tonumber(shots) or (tofState == "cooldown" and 0 or 3)
                qtyStr = string.format(" [%d/%d]", sCount, maxShots)
            elseif usesNum then
                if item == "Bandage" or item:find("Bandage") then
                    local pct = math.clamp(math.floor((usesNum / 20.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif maxUsesNum then
                    qtyStr = string.format(" [%d/%d]", usesNum, maxUsesNum)
                else
                    qtyStr = string.format(" [%d uses]", usesNum)
                end
            elseif rem and tonumber(rem) then
                local remNum = tonumber(rem)
                if item == "Flashlight" or item:find("Flashlight") then
                    local pct = math.clamp(math.floor((remNum / 20.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif remNum > 0 then
                    qtyStr = string.format(" (%.1fs)", remNum)
                end
            end

            local cdSec = GetItemCooldown(player, item)
            if (item == "Twist of Fate" or item:find("Twist")) and itemInst then
                local tofState = itemInst:GetAttribute("tofState")
                local tofDur = tonumber(itemInst:GetAttribute("tofStateDur")) or 80
                local tofStart = tonumber(itemInst:GetAttribute("tofStateStart")) or 0
                if tofState == "cooldown" then
                    local remTof = math.max(0, math.ceil(tofDur - (workspace:GetServerTimeNow() - tofStart)))
                    if remTof > 0 then cdSec = remTof end
                end
            end
            local itemStr = "Item: " .. item .. qtyStr

            if cdSec > 0 then
                isItemReady = false
                itemStr = itemStr .. string.format(" (CD %ds)", cdSec)
            elseif (rem and tonumber(rem) and tonumber(rem) <= 0) or (uses and tonumber(uses) and tonumber(uses) <= 0) then
                isItemReady = false
                itemStr = itemStr .. " [Empty]"
            else
                isItemReady = true
            end
            table.insert(details, itemStr)
        else
            isItemReady = nil
        end

        local otherDetails = {}
        if player == LocalPlayer then
            local debuff = player.PlayerGui:FindFirstChild("Survivor") and player.PlayerGui.Survivor:FindFirstChild("statuseffects") and player.PlayerGui.Survivor.statuseffects:FindFirstChild("Debuff")
            local winded = debuff and debuff:FindFirstChild("Winded")
            if winded and winded.Visible then
                table.insert(details, "Exhausted")
                table.insert(otherDetails, "Exhausted")
            end
        end

        -- Only show Wiggle if they are ACTUALLY being carried by the killer!
        local isCarried = char:GetAttribute("IsCarried") or char:GetAttribute("BeingCarried") or char:GetAttribute("IsBeingCarried")
        if isCarried then
            local carryTime = tonumber(char:GetAttribute("RemainingCarryTime"))
            if carryTime and carryTime > 0 then
                local wStr = string.format("Wiggling: %.1fs", carryTime)
                table.insert(details, wStr)
                table.insert(otherDetails, wStr)
            end
        end

        -- Only show Hook % if actually hooked
        local isHooked = char:GetAttribute("IsHooked") or char:GetAttribute("HookProgressDepleting")
        local hookProg = tonumber(char:GetAttribute("HookedProgress"))
        if isHooked and hookProg and hookProg < 100 then
            local hStr = string.format("Hook: %d%%", math.floor(hookProg))
            table.insert(details, hStr)
            table.insert(otherDetails, hStr)
        end

        local otherStr = #otherDetails > 0 and table.concat(otherDetails, " | ") or nil
        return (#details > 0 and table.concat(details, " | ") or nil), isItemReady, item, qtyStr, otherStr
    end
end
end

-- ======== BACKGROUND DATA CACHING (PREVENTS ESP STUTTER & LAG) ========
local _PruneDeadDrawings = nil
CachedPlayerData = {}
local CachedGenerators = {}
local CachedPallets = {}
local CachedWindows = {}
local CachedGates = {}
local lastMapScan = 0

-- Objective & World State Tracking & Cleanup
local GenDrawings = {}
local PalletDrawings = {}
local WindowDrawings = {}
local GateDrawings = {}
local TrapDrawings = {}
local PumpkinDrawings = {}
local PumpkinTracers = {}
local GenAuras = {}
local PalletAuras = {}
local WindowAuras = {}
local WindowAdornments = {}
local TrapAuras = {}
local PumpkinAuras = {}
local DroppedPallets = {}
local BrokenPallets = {}

local function MarkPalletBroken(model)
    if not model then return end
    BrokenPallets[model] = true
    DroppedPallets[model] = nil
    local hl = PalletAuras[model]
    if hl then
        pcall(function()
            hl.Enabled = false
            hl:Destroy()
        end)
        PalletAuras[model] = nil
    end
    local txt = PalletDrawings[model]
    if txt then
        pcall(function()
            txt.Visible = false
            txt:Remove()
        end)
        PalletDrawings[model] = nil
    end
end

local function IsPalletBroken(model, prim)
    if not model or not model.Parent or not model:IsDescendantOf(Workspace) then
        return true
    end
    if BrokenPallets[model] then
        return true
    end

    -- 1. Game State Attributes (Set by Violence District PalletVisualsClient & Server)
    local state = model:GetAttribute("PalletState") or model:GetAttribute("State")
    if state == "Broken" or state == "Destroyed" then
        BrokenPallets[model] = true
        return true
    end
    if model:GetAttribute("BrokenAt") ~= nil or model:GetAttribute("Destroyed") == true or model:GetAttribute("Broken") == true
       or model:GetAttribute("isBroken") == true or model:GetAttribute("isDestroyed") == true then
        BrokenPallets[model] = true
        return true
    end

    -- 2. Visual Model Check (Newpallet structure: Intact vs Broken)
    -- Only check the actual visible "Pallet" MeshPart (never fallback to FindFirstChildWhichIsA("BasePart") which grabs invisible LP/PalletPoint when streamed out!)
    local intact = model:FindFirstChild("Intact")
    if intact then
        local pIntact = intact:FindFirstChild("Pallet")
        if pIntact and pIntact:IsA("BasePart") and (pIntact.Transparency >= 0.85 or pIntact.LocalTransparencyModifier >= 0.85) then
            BrokenPallets[model] = true
            return true
        end
    end

    local broken = model:FindFirstChild("Broken")
    if broken then
        local pBroken = broken:FindFirstChild("Pallet_Broken")
        if pBroken and pBroken.Transparency < 0.85 and pBroken.LocalTransparencyModifier < 0.85 then
            BrokenPallets[model] = true
            return true
        end
    end

    return false
end

local wasCacheInLobby = false
local function UpdateBackgroundCache()
    pcall(function()
        local inLobby = IsInLobby()
        local now = os.clock()
        
        -- In Lobby: immediately bypass player perks/items scan and purge match objects ONCE
        if inLobby then
            if not wasCacheInLobby then
                wasCacheInLobby = true
                CurrentKillerPlayer = nil
                table.clear(CachedGenerators)
                table.clear(CachedPallets)
                table.clear(CachedWindows)
                table.clear(CachedGates)
                table.clear(BrokenPallets)
                table.clear(DroppedPallets)
                for _, hl in pairs(GenAuras) do pcall(function() hl:Destroy() end) end
                table.clear(GenAuras)
                for _, hl in pairs(PalletAuras) do pcall(function() hl:Destroy() end) end
                table.clear(PalletAuras)
                for _, txt in pairs(PalletDrawings) do pcall(function() txt:Remove() end) end
                table.clear(PalletDrawings)
                for _, txt in pairs(WindowDrawings) do pcall(function() txt:Remove() end) end
                table.clear(WindowDrawings)
                for _, hl in pairs(WindowAuras) do pcall(function() hl:Destroy() end) end
                table.clear(WindowAuras)
                for _, bha in pairs(WindowAdornments) do pcall(function() bha:Destroy() end) end
                table.clear(WindowAdornments)
                for _, txt in pairs(GateDrawings) do pcall(function() txt:Remove() end) end
                table.clear(GateDrawings)
                for _, txt in pairs(TrapDrawings) do pcall(function() txt:Remove() end) end
                table.clear(TrapDrawings)
                for _, hl in pairs(TrapAuras) do pcall(function() hl:Destroy() end) end
                table.clear(TrapAuras)
                for _, txt in pairs(PumpkinDrawings) do pcall(function() txt:Remove() end) end
                table.clear(PumpkinDrawings)
                for _, ln in pairs(PumpkinTracers) do pcall(function() ln:Remove() end) end
                table.clear(PumpkinTracers)
                for _, hl in pairs(PumpkinAuras) do pcall(function() hl:Destroy() end) end
                table.clear(PumpkinAuras)
            end
            return
        end
        wasCacheInLobby = false

        -- Cache killer player and player perks/skills every 0.3s (fast iteration over players only)
        local foundKiller = nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and not inLobby and not IsPlayerDead(p) and not IsPlayerInLobby(p) then
                if (p.Team and p.Team.Name == "Killer") or (p.Character and (p.Character:GetAttribute("SelectedKiller") ~= nil or p.Character:GetAttribute("MorphedKiller") ~= nil or p.Character:GetAttribute("Butcher") == true or p.Character:GetAttribute("Killer") == true or p.Character:GetAttribute("isKiller") == true)) then
                    foundKiller = p
                    break
                end
            end
        end
        if not foundKiller then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and not inLobby and not IsPlayerDead(p) and not IsPlayerInLobby(p) then
                    if IsKiller(p) then
                        foundKiller = p
                        break
                    end
                end
            end
        end
        CurrentKillerPlayer = (not inLobby) and foundKiller or nil

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if not inLobby and (IsPlayerDead(p) or IsPlayerInLobby(p)) then
                    CachedPlayerData[p] = nil
                    PlayerItemCache[p] = nil
                    ClearPlayerCooldowns(p)
                else
                    local isK = IsKiller(p)
                    if isK then
                        PlayerItemCache[p] = nil
                    end
                    local perks = (Config.ESP_SurvivorPerks or Config.ESP_KillerPerks) and GetPlayerPerks(p) or nil
                    local skill, isReady, itemNm, itemQty, otherDet = GetPlayerSkillInfo(p)
                    if isK and type(skill) == "string" then
                        if skill:find("^Skill:") then
                            skill = skill:gsub("^Skill:%s*", "[SKILL] ")
                        elseif not skill:find("^%[SKILL%]") then
                            skill = "[SKILL] " .. skill
                        end
                        skill = skill:gsub("%s*|%s*CHASING", ""):gsub("%[CHASING%]", "")
                    end
                    local entry = CachedPlayerData[p]
                    if not entry then
                        entry = {}
                        CachedPlayerData[p] = entry
                    end
                    entry.IsKiller = isK
                    entry.Perks = perks or {}
                    entry.PerksFormatted = (perks and #perks > 0) and table.concat(perks, " | ") or ""
                    entry.SkillInfo = skill or false
                    entry.ItemReady = (not isK) and (isReady == true) or false
                    entry.ItemName = not isK and itemNm or nil
                    entry.ItemQtyStr = not isK and itemQty or nil
                    entry.OtherDetails = not isK and otherDet or nil
                    entry.DisplayName = p.DisplayName
                end
            end
        end

        -- Clean up disconnected / dead / lobby players from cache
        for p in pairs(CachedPlayerData) do
            if not p or not p.Parent or (not inLobby and (IsPlayerDead(p) or IsPlayerInLobby(p))) then
                CachedPlayerData[p] = nil
                PlayerItemCache[p] = nil
            end
        end



        -- Re-scan every 2.5s to pick up newly streamed-in objects across the map (Workspace.StreamingEnabled == true)
        if now - lastMapScan < 2.5 then
            return
        end
        lastMapScan = now

        local map = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("map")
        local gens, pallets, windows, gates = {}, {}, {}, {}
        local winSeen = {}
        local genSeen = {}
        local palletSeen = {}
        local gateSeen = {}

        -- Preserve already-cached objects so streamed-out models are never lost when walking far away
        for _, item in ipairs(CachedGenerators) do
            if item.Model and item.Model.Parent then
                genSeen[item.Model] = true
                if not item.Part or not item.Part.Parent then
                    item.Part = item.Model:FindFirstChild("RootPart") or item.Model.PrimaryPart or item.Model:FindFirstChildWhichIsA("BasePart")
                end
                table.insert(gens, item)
            end
        end
        for _, item in ipairs(CachedPallets) do
            if item.Model and item.Model.Parent and not IsPalletBroken(item.Model, item.Part) then
                palletSeen[item.Model] = true
                if not item.Part or not item.Part.Parent then
                    local intact = item.Model:FindFirstChild("Intact")
                    item.Part = (intact and intact:FindFirstChild("Pallet")) or item.Model:FindFirstChild("PrimaryPartPallet") or item.Model.PrimaryPart or item.Model:FindFirstChildWhichIsA("BasePart")
                end
                table.insert(pallets, item)
            end
        end
        for _, item in ipairs(CachedWindows) do
            if item.Model and item.Model.Parent then
                winSeen[item.Model] = true
                if not item.Part or not item.Part.Parent then
                    local bestP = item.Model:FindFirstChild("Bottom") or item.Model:FindFirstChild("Ledge") or item.Model:FindFirstChild("VaultTrigger") or item.Model:FindFirstChildWhichIsA("BasePart")
                    if bestP then
                        item.Part = bestP
                        item.VaultLedge = bestP
                    end
                end
                table.insert(windows, item)
            end
        end
        for _, item in ipairs(CachedGates) do
            if item.Model and item.Model.Parent then
                gateSeen[item.Model] = true
                if not item.Part or not item.Part.Parent then
                    item.Part = item.Model.PrimaryPart or item.Model:FindFirstChildWhichIsA("BasePart")
                end
                table.insert(gates, item)
            end
        end

        local function isNearExistingVault(pos)
            for _, w in ipairs(windows) do
                if w.Part and (w.Part.Position - pos).Magnitude < 4.0 then
                    return true
                end
            end
            return false
        end

        local function registerVault(container, refPart, sillType)
            if not refPart or not refPart:IsA("BasePart") then return end
            -- Reject gigantic building structures (must be actual vault part or trigger)
            if refPart.Size.X > 10 or refPart.Size.Y > 10 or refPart.Size.Z > 10 then return end
            -- Reject non-vault objects (generators, pallets, gates, lockers, crates)
            local cName = container and container.Name:lower() or (refPart.Parent and refPart.Parent.Name:lower() or "")
            if cName:find("gen") or cName:find("pallet") or cName:find("gate") or cName:find("locker") or cName:find("barrel") or cName:find("crate") then
                return
            end
            if (refPart.Name == "Part" or refPart.Name == "Union" or refPart.Name == "MeshPart") and not (cName:find("window") or cName:find("vault")) then
                return
            end
            if isNearExistingVault(refPart.Position) then return end
            table.insert(windows, {
                Model = container or refPart.Parent,
                Part = refPart,
                VaultLedge = refPart,
                SillType = sillType or "Auto"
            })
        end

        local function findBestVaultPart(container, triggerPart)
            if not container then return triggerPart, "Trigger" end
            -- Priority 1: Specifically named bottom / ledge / sill parts
            local bottom = container:FindFirstChild("Bottom") or container:FindFirstChild("Ledge") or container:FindFirstChild("Sill") or container:FindFirstChild("VaultLedge") or container:FindFirstChild("VaultSill")
            if bottom and bottom:IsA("BasePart") and bottom.Size.X <= 10 and bottom.Size.Y <= 10 and bottom.Size.Z <= 10 then
                return bottom, "Bottom"
            end

            -- Priority 2: Horizontal sill part (low height, wide)
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("BasePart") and c.Size.Y <= 1.8 and math.max(c.Size.X, c.Size.Z) >= 2.5 and math.max(c.Size.X, c.Size.Z) <= 8 then
                    local cName = c.Name:lower()
                    if not cName:find("invis") and not cName:find("trigger") and not cName:find("collision") then
                        return c, "Sill"
                    end
                end
            end

            -- Priority 3: Trigger part itself
            if triggerPart and triggerPart:IsA("BasePart") and triggerPart.Size.X <= 10 and triggerPart.Size.Y <= 10 and triggerPart.Size.Z <= 10 then
                return triggerPart, "Trigger"
            end

            -- Priority 4: Look for any child part with "trigger" or "vault" or "bottom"
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("BasePart") and c.Size.X <= 10 and c.Size.Y <= 10 and c.Size.Z <= 10 then
                    local cName = c.Name:lower()
                    if cName:find("bottom") or cName:find("ledge") or cName:find("sill") then
                        return c, "Bottom"
                    elseif cName:find("trigger") or cName:find("vault") then
                        return c, "Trigger"
                    end
                end
            end

            -- Priority 5: inviswall (height > 2.5)
            local invis = container:FindFirstChild("inviswall") or container:FindFirstChild("InvisWall") or container:FindFirstChild("Invis")
            if invis and invis:IsA("BasePart") and invis.Size.X <= 10 and invis.Size.Y <= 10 and invis.Size.Z <= 10 then
                return invis, "InvisWall"
            end

            -- Fallback to triggerPart or container.PrimaryPart if reasonably sized
            if triggerPart and triggerPart:IsA("BasePart") then return triggerPart, "Trigger" end
            local prim = container.PrimaryPart or container:FindFirstChildWhichIsA("BasePart")
            if prim and prim.Size.X <= 10 and prim.Size.Y <= 10 and prim.Size.Z <= 10 then
                return prim, "Auto"
            end
            return nil, nil
        end

        -- 1. Universal Multi-Map Vault Detection: CollectionService tags
        pcall(function()
            local CollectionService = game:GetService("CollectionService")
            for _, tag in ipairs({"VaultPoint", "Vault", "Window", "VaultLedge", "VaultSpot", "WindowVault", "window", "vault"}) do
                for _, vt in ipairs(CollectionService:GetTagged(tag)) do
                    local directPart = vt:IsA("BasePart") and vt or vt:FindFirstChildWhichIsA("BasePart")
                    local container = nil
                    if vt:IsA("Model") then
                        container = vt
                    elseif vt.Parent and vt.Parent:IsA("Model") then
                        container = vt.Parent
                    end
                    if container and (container == Workspace or container.Name == "Map" or container.Name:lower():find("house") or container.Name:lower():find("building") or container.Name:lower():find("ruin") or (container.Name:lower() == "model" and not container:FindFirstChild("Bottom") and not container:FindFirstChild("VaultTrigger"))) then
                        container = nil
                    end
                    if not container or not winSeen[container] then
                        if container then winSeen[container] = true end
                        local bestPart, sillType = findBestVaultPart(container, directPart)
                        if bestPart then
                            registerVault(container, bestPart, sillType)
                        end
                    end
                end
            end

            -- Universal Multi-Map Pallet Detection: CollectionService tags
            for _, tag in ipairs({"PalletPoint", "PalletPointSlide", "Pallet", "Pallets", "DroppablePallet", "InteractablePallet"}) do
                for _, p in ipairs(CollectionService:GetTagged(tag)) do
                    local model = p:IsA("Model") and p or p:FindFirstAncestorOfClass("Model") or (p.Parent and p.Parent:IsA("Model") and p.Parent)
                    if model and not palletSeen[model] and not IsPalletBroken(model) then
                        palletSeen[model] = true
                        local intact = model:FindFirstChild("Intact")
                        local intactPallet = intact and (intact:FindFirstChild("Pallet") or intact:FindFirstChildWhichIsA("BasePart"))
                        local bestPart = intactPallet
                                      or model:FindFirstChild("PrimaryPartPallet")
                                      or model:FindFirstChild("Wood")
                                      or model:FindFirstChild("PalletWood")
                                      or model:FindFirstChild("Plank")
                                      or model.PrimaryPart
                        if not bestPart then
                            for _, c in ipairs(model:GetChildren()) do
                                if c:IsA("BasePart") and c.Transparency < 0.95 then
                                    bestPart = c
                                    break
                                end
                            end
                        end
                        if not bestPart then
                            bestPart = p:IsA("BasePart") and p or model:FindFirstChildWhichIsA("BasePart")
                        end
                        if bestPart then
                            local woodTarget = intact or model:FindFirstChild("Wood") or model:FindFirstChild("PalletWood") or intactPallet or model
                            table.insert(pallets, { Model = model, Part = bestPart, PalletWood = woodTarget })
                        end
                    end
                end
            end

            -- Generators CollectionService tag
            for _, g in ipairs(CollectionService:GetTagged("Generator")) do
                if not genSeen[g] then
                    genSeen[g] = true
                    local part = g:FindFirstChild("RootPart") or g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gens, { Model = g, Part = part }) end
                end
            end
        end)

        -- Fast targeted folder scan (avoids 22,000+ instance GetDescendants lag spikes!)
        if map then
            local genFolder = map:FindFirstChild("Generators")
            if genFolder then
                for _, d in ipairs(genFolder:GetChildren()) do
                    if d:IsA("Model") and not genSeen[d] then
                        genSeen[d] = true
                        local part = d:FindFirstChild("RootPart") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                        if part then table.insert(gens, { Model = d, Part = part }) end
                    end
                end
            end

            local palFolder = map:FindFirstChild("Pallets") or map:FindFirstChild("pallets")
            if palFolder then
                for _, d in ipairs(palFolder:GetChildren()) do
                    if d:IsA("Model") and not palletSeen[d] and not IsPalletBroken(d) then
                        palletSeen[d] = true
                        local intact = d:FindFirstChild("Intact")
                        local intactPallet = intact and (intact:FindFirstChild("Pallet") or intact:FindFirstChildWhichIsA("BasePart"))
                        local bestPart = intactPallet or d:FindFirstChild("PrimaryPartPallet") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                        if bestPart then
                            local woodTarget = intact or intactPallet or d
                            table.insert(pallets, { Model = d, Part = bestPart, PalletWood = woodTarget })
                        end
                    end
                end
            end

            for _, folderName in ipairs({"Vaults", "Windows", "vaults", "windows"}) do
                local vFolder = map:FindFirstChild(folderName)
                if vFolder then
                    for _, d in ipairs(vFolder:GetChildren()) do
                        if d:IsA("Model") and not winSeen[d] then
                            winSeen[d] = true
                            local trigger = d:FindFirstChild("VaultTrigger")
                            local bestPart, sillType = findBestVaultPart(d, trigger)
                            if bestPart then
                                registerVault(d, bestPart, sillType)
                            end
                        end
                    end
                end
            end

            for _, d in ipairs(map:GetChildren()) do
                if d:IsA("Model") then
                    if d.Name == "Gate" and not gateSeen[d] then
                        local part = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                        if part then
                            gateSeen[d] = true
                            table.insert(gates, { Model = d, Part = part })
                        end
                    elseif (d.Name == "Generator" or d:GetAttribute("RepairProgress") ~= nil) and not genSeen[d] then
                        genSeen[d] = true
                        local part = d:FindFirstChild("RootPart") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                        if part then table.insert(gens, { Model = d, Part = part }) end
                    end
                end
            end

            -- Fallback deep scan ONLY if dedicated folders were not found on this map (#gens == 0)
            if #gens == 0 then
                for _, d in ipairs(map:GetDescendants()) do
                    if d:IsA("Model") then
                        if not genSeen[d] and (d.Name == "Generator" or d:GetAttribute("RepairProgress") ~= nil) then
                            genSeen[d] = true
                            local part = d:FindFirstChild("RootPart") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                            if part then table.insert(gens, { Model = d, Part = part }) end
                        elseif not palletSeen[d] and (d.Name:lower():find("pallet") and not d.Name:lower():find("crate")) and not IsPalletBroken(d) then
                            palletSeen[d] = true
                            local intact = d:FindFirstChild("Intact")
                            local intactPallet = intact and (intact:FindFirstChild("Pallet") or intact:FindFirstChildWhichIsA("BasePart"))
                            local bestPart = intactPallet or d:FindFirstChild("PrimaryPartPallet") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                            if bestPart then
                                table.insert(pallets, { Model = d, Part = bestPart, PalletWood = intact or intactPallet or d })
                            end
                        elseif not winSeen[d] and (d:FindFirstChild("VaultTrigger") or d:FindFirstChild("Bottom")) then
                            winSeen[d] = true
                            local bestPart, sillType = findBestVaultPart(d, d:FindFirstChild("VaultTrigger"))
                            if bestPart then registerVault(d, bestPart, sillType) end
                        end
                    end
                end
            end
        end
        CachedGenerators = gens
        CachedPallets = pallets
        CachedWindows = windows
        CachedGates = gates
    end)
end

