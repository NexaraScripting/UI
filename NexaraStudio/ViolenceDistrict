            or char:GetAttribute("Beartraps") ~= nil or char:GetAttribute("ChainInUse") ~= nil 
            or char:GetAttribute("ChainThrows") ~= nil then
            return true
        end
        -- Generic Killer attributes
        if char:GetAttribute("BloodLust") or char:GetAttribute("IsCarrying") or char:GetAttribute("Carrying") then
            return true
        end
        if char:GetAttribute("SelectedKiller") or char:GetAttribute("MorphedKiller") then
            return true
        end
    end
    return false
