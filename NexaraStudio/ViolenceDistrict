-- ======== ESP RENDERING (CAMERA POST-UPDATE WITH SMOOTH FADE IN/OUT) ========
local RenderESP
do
local seenGens = {}
local seenPallets = {}
local seenWindows = {}
local seenGates = {}
local seenTraps = {}
local seenPumpkins = {}
local lastBearTrapScanTime = 0
local cachedBearTraps = nil
local wasInLobby = false
local lastPalletSortTime = 0
local cachedPalletEntries = {}
local function sortPalletByDist(a, b) return a.Dist < b.Dist end
local lastPalletCheckTime = 0
local cachedDroppingHRPPos = nil
local lastHighlightCleanTime = 0
local lastTopSkillUpdateTime = 0
local cachedTopKillerSkillStr = nil

local ESP_Alpha = {}
local lastRenderClock = os.clock()
local FADE_SPEED = 4.2 -- Smooth ~0.24s fade-in and fade-out

local function stepAlpha(key, isEnabled, dt)
    local cur = ESP_Alpha[key]
    if cur == nil then
        cur = isEnabled and 1 or 0
    else
        if isEnabled then
            cur = math.min(1, cur + dt * FADE_SPEED)
        else
            cur = math.max(0, cur - dt * FADE_SPEED)
        end
    end
    ESP_Alpha[key] = cur
    return cur
end

local menuPos = nil
local menuSize = nil
local function IsInMenu(sx, sy)
    if not menuPos or not menuSize then return false end
    return sx >= (menuPos.X - 20) and sx <= (menuPos.X + menuSize.X + 20) and sy >= (menuPos.Y - 45) and sy <= (menuPos.Y + menuSize.Y + 20)
end

local wasAllHidden = false

local function RenderESPCore(dtArg)
        local nowClock = os.clock()
        local doCleanHighlights = (nowClock - lastHighlightCleanTime > 0.35)
        if doCleanHighlights then lastHighlightCleanTime = nowClock end
        local dt = math.clamp(type(dtArg) == "number" and dtArg or (nowClock - lastRenderClock), 0.001, 0.1)
        lastRenderClock = nowClock

        Camera = Workspace.CurrentCamera or Camera
        local inLobby = IsInLobby()
        local inCutscene = IsCutsceneActive()

        if inCutscene or (inLobby and not Config.ESP_LobbyEnabled) then
            if not wasAllHidden then
                HideAllESP()
                wasAllHidden = true
            end
            return
        end
        wasAllHidden = false

        if inLobby and not wasInLobby then
            HideAllESP()
            table.clear(PlayerItemCooldowns)
            table.clear(PlayerItemCache)
            table.clear(DroppedPallets)
            table.clear(BrokenPallets)
            table.clear(BlockedWindows)
            table.clear(BlockedWindowPositions)
            table.clear(cachedPalletEntries)
            lastPalletSortTime = 0
        end
        wasInLobby = inLobby

        -- Smooth fade alphas (0.0 -> 1.0 on enable, 1.0 -> 0.0 on disable)
        local aKillerMaster = stepAlpha("KillerMaster", Config.ESP_KillerEnabled == true, dt)
        local aKillerSkel   = stepAlpha("KillerSkel",   Config.ESP_KillerEnabled and Config.ESP_KillerSkeleton, dt)
        local aKillerChams  = stepAlpha("KillerChams",  Config.ESP_KillerEnabled and Config.ESP_KillerChams, dt)
        local aKillerNames  = stepAlpha("KillerNames",  Config.ESP_KillerEnabled and Config.ESP_KillerNames, dt)
        local aKillerPerks  = stepAlpha("KillerPerks",  Config.ESP_KillerEnabled and Config.ESP_KillerPerks, dt)
        local aKillerSkills = stepAlpha("KillerSkills", Config.ESP_KillerSkills == true, dt)

        local aSurvMaster   = stepAlpha("SurvMaster",   Config.ESP_SurvivorEnabled == true, dt)
        local aSurvBoxes    = stepAlpha("SurvBoxes",    Config.ESP_SurvivorEnabled and Config.ESP_SurvivorBoxes, dt)
        local aSurvSkel     = stepAlpha("SurvSkel",     Config.ESP_SurvivorEnabled and Config.ESP_SurvivorSkeleton, dt)
        local aSurvChams    = stepAlpha("SurvChams",    Config.ESP_SurvivorEnabled and Config.ESP_SurvivorChams, dt)
        local aSurvNames    = stepAlpha("SurvNames",    Config.ESP_SurvivorEnabled and (Config.ESP_SurvivorNames or Config.ESP_SurvivorDistance), dt)
        local aSurvStatus   = stepAlpha("SurvStatus",   Config.ESP_SurvivorEnabled and Config.ESP_SurvivorStatus, dt)
        local aSurvSkills   = stepAlpha("SurvSkills",   Config.ESP_SurvivorEnabled and Config.ESP_SurvivorSkills, dt)
        local aSurvPerks    = stepAlpha("SurvPerks",    Config.ESP_SurvivorEnabled and Config.ESP_SurvivorPerks, dt)

        local aGenESP       = stepAlpha("GenESP",       Config.ESP_Generators == true, dt)
        local aGenChams     = stepAlpha("GenChams",     Config.ESP_GenChams == true, dt)
        local aPalletAura   = stepAlpha("PalletAura",   Config.ESP_PalletAura == true, dt)
        local aPalletESP    = stepAlpha("PalletESP",    Config.ESP_Pallets == true, dt)
        local aWindowAura   = stepAlpha("WindowAura",   Config.ESP_WindowAura == true, dt)
        local aWindowESP    = stepAlpha("WindowESP",    Config.ESP_Windows == true, dt)
        local aExitGates    = stepAlpha("ExitGates",    Config.ESP_ExitGates == true, dt)
        local aBearTraps    = stepAlpha("BearTraps",    Config.ESP_BearTraps == true, dt)
        local aPumpkinAura  = stepAlpha("PumpkinAura",  Config.ESP_PumpkinAura == true, dt)
        local aPumpkinESP   = stepAlpha("PumpkinESP",   Config.ESP_Pumpkins == true, dt)
        local aPumpkinTrace = stepAlpha("PumpkinTrace", Config.ESP_PumpkinTracer == true, dt)

        local myRoot = GetRoot(LocalPlayer)
        local camPos = Camera.CFrame.Position
        local myPos = myRoot and myRoot.Position or camPos

        local mainFrame = Window and (Window.MainFrame or Window.Main)
        menuPos = (Window and Window.Visible and mainFrame and mainFrame.Visible) and mainFrame.AbsolutePosition or nil
        menuSize = menuPos and mainFrame.AbsoluteSize or nil


        -- 1. Player ESP (Separated: Killer ESP vs Survivor ESP vs Lobby Players - VM Cached Rig & Throttled State)
        local amIKiller = (not inLobby) and (CurrentKillerPlayer == LocalPlayer)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local esp = ESP_Objects[player] or CreatePlayerESP(player)
                local char = player.Character
                local rig = char and GetCharRigCache(char)
                local root = rig and rig.Root
                local data = CachedPlayerData[player]
                local hum = rig and rig.Humanoid
                local isDead = (not char or not root) or (hum and hum.Health <= 0) or (not inLobby and data == nil and IsPlayerDead(player))
                local isLobbyPlr = (not inLobby) and (root and root.Position.Y > 500 and root.Position.Z > 2500) or false

            local shouldHide = isDead or (not inLobby and isLobbyPlr) or (inLobby and not Config.ESP_LobbyEnabled)

            if not shouldHide and char and root and rig then
                local isK = not inLobby and ((data and data.IsKiller) or (CurrentKillerPlayer == player))
                local rootPos = root.Position
                local rootScreen, onScreen = Camera:WorldToViewportPoint(rootPos)

                local torsoPart = rig.Torso
                local rj = rig.RootJoint
                local torsoCF = (rj and rj.Part0 == root and rj.Part1 == torsoPart)
                    and (root.CFrame * rj.C0 * rj.Transform * rj.C1:Inverse())
                    or (torsoPart and torsoPart.CFrame or root.CFrame)
                local head = rig.Head
                local neckM = rig.Neck
                local headCF = (head and neckM and neckM.Part0 == torsoPart and neckM.Part1 == head)
                    and (torsoCF * neckM.C0 * neckM.Transform * neckM.C1:Inverse())
                    or (head and head.CFrame)
                local headValid = head ~= nil and headCF ~= nil and (headCF.Position - torsoCF.Position).Magnitude <= 3.5
                local headPos = headValid and headCF.Position or (torsoCF.Position + Vector3.new(0, root.Size.Y * 0.5 + 1.2, 0))
                local headScreen = Camera:WorldToViewportPoint(headPos)

                local dist = (myPos - rootPos).Magnitude
                -- Carrying detection: suppress Chams, Skeleton, Box, and Text if this survivor is being carried by me
                local isBeingCarriedByMe = false
                if amIKiller and not isK and dist <= 10 then
                    local myChar = LocalPlayer.Character
                    local myIsCarrying = (myChar and (myChar:GetAttribute("IsCarrying") == true or myChar:GetAttribute("Carrying") == true))
                    local isCarriedAttr = (char:GetAttribute("IsCarried") == true or char:GetAttribute("Carried") == true or char:GetAttribute("RemainingCarryTime") ~= nil)
                    if myIsCarrying or isCarriedAttr then
                        isBeingCarriedByMe = true
                    end
                end

                -- Update 3D Chams (Always visible at full opacity across entire map)
                if isK and not inLobby then
                    local effKChams = aKillerChams
                    if effKChams > 0.01 then
                        local hl = esp.Chams
                        local aCol = Config.Color_KillerChams or Color3.fromRGB(255, 60, 60)
                        if not hl or not hl.Parent then
                            hl = Instance.new("Highlight")
                            hl.Name = "Nexara_PlayerChams"
                            hl.FillColor = aCol
                            hl.OutlineColor = aCol
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = char
                            pcall(function() hl.Parent = GetChamsContainer() end)
                            esp.Chams = hl
                        else
                            if hl.Adornee ~= char then hl.Adornee = char end
                            if hl.FillColor ~= aCol then
                                hl.FillColor = aCol
                                hl.OutlineColor = aCol
                            end
                        end
                        hl.FillTransparency = 1 - (0.28 * effKChams)
                        hl.OutlineTransparency = 1 - (0.65 * effKChams)
                        if not hl.Enabled then hl.Enabled = true end

                        -- Suppress conflicting in-game Highlights throttled to 0.35s
                        if doCleanHighlights then
                            for _, child in ipairs(char:GetChildren()) do
                                if child:IsA("Highlight") and child ~= hl then
                                    if child.Enabled then child.Enabled = false end
                                    if child.Adornee ~= Workspace.Terrain then
                                        pcall(function() child.Adornee = Workspace.Terrain end)
                                    end
                                end
                            end
                        end
                    elseif esp.Chams and esp.Chams.Enabled then
                        esp.Chams.Enabled = false
                        esp.Chams.Adornee = nil
                    end
                else
                    local sChamsAlpha = (not isBeingCarriedByMe) and (inLobby and (Config.ESP_LobbyEnabled ~= false and aSurvChams or 0) or ((not isLobbyPlr and not isDead) and aSurvChams or 0)) or 0
                    local effSChams = sChamsAlpha
                    if effSChams > 0.01 then
                        local hl = esp.Chams
                        local isSurvivorHit = not inLobby and ((hum and hum.Health < 99) or char:GetAttribute("Knocked") == true or char:GetAttribute("IsHooked") == true)
                        local aCol = inLobby and Color3.fromRGB(0, 210, 255)
                                  or (isSurvivorHit and Color3.fromRGB(255, 215, 0) or (Config.Color_SurvivorChams or Color3.fromRGB(255, 255, 255)))
                        if not hl or not hl.Parent then
                            hl = Instance.new("Highlight")
                            hl.Name = "Nexara_PlayerChams"
                            hl.FillColor = aCol
                            hl.OutlineColor = aCol
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = char
                            pcall(function() hl.Parent = GetChamsContainer() end)
                            esp.Chams = hl
                        else
                            if hl.Adornee ~= char then hl.Adornee = char end
                            if hl.FillColor ~= aCol then
                                hl.FillColor = aCol
                                hl.OutlineColor = aCol
                            end
                        end
                        hl.FillTransparency = 1 - (0.28 * effSChams)
                        hl.OutlineTransparency = 1 - (0.65 * effSChams)
                        if not hl.Enabled then hl.Enabled = true end

                        -- Suppress & decouple conflicting in-game Highlights throttled to 0.35s
                        if doCleanHighlights then
                            for _, child in ipairs(char:GetChildren()) do
                                if child:IsA("Highlight") and child ~= hl then
                                    if child.Enabled then child.Enabled = false end
                                    if child.Adornee ~= Workspace.Terrain then
                                        pcall(function() child.Adornee = Workspace.Terrain end)
                                    end
                                end
                            end
                            local mute = char:FindFirstChild("AuraMute", true)
                            if mute and mute:IsA("Highlight") then
                                if mute.Enabled then mute.Enabled = false end
                                if mute.Adornee ~= Workspace.Terrain then
                                    pcall(function() mute.Adornee = Workspace.Terrain end)
                                end
                            end
                        end
                    elseif esp.Chams and esp.Chams.Enabled then
                        esp.Chams.Enabled = false
                        esp.Chams.Adornee = nil
                    end
                end

                if onScreen and not IsInMenu(rootScreen.X, rootScreen.Y) and not IsInMenu(headScreen.X, headScreen.Y) then
                    esp.IsHidden = false
                    dist = (myPos - rootPos).Magnitude
                    local currentX = math.floor(rootScreen.X)
                    local currentY = 0

                -- KILLER ESP BRANCH
                if isK and not inLobby then
                    if aKillerMaster > 0.01 or aKillerSkel > 0.01 or aKillerNames > 0.01 or aKillerPerks > 0.01 then
                        -- Hide 2D Box
                        if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                        if esp.Box.Visible then esp.Box.Visible = false end

                        -- Rock-solid 3D World Space Top (Above Head) and Bottom (Under Feet)
                        local topWorld = headValid and (headPos + Vector3.new(0, head.Size.Y * 0.5 + 0.35, 0)) or (torsoCF.Position + Vector3.new(0, root.Size.Y * 0.5 + 1.5, 0))
                        local hipHeight = (hum and hum.HipHeight > 0) and hum.HipHeight or 2.0
                        local footBottomY = rootPos.Y - (root.Size.Y * 0.5 + hipHeight + 0.1)
                        local btmWorld = Vector3.new(rootPos.X, footBottomY, rootPos.Z)

                        local topScreen, _topVis = Camera:WorldToViewportPoint(topWorld)
                        local btmScreen, _btmVis = Camera:WorldToViewportPoint(btmWorld)

                        currentX = math.floor(rootScreen.X)
                        local topY = math.floor(topScreen.Y - 14)
                        local btmY = math.floor(btmScreen.Y + 2)

                        -- Render Hot Pink Skeleton (Thin & sleek, model-accurate)
                        if aKillerSkel > 0.01 and dist <= 2500 and onScreen then
                            UpdateSkeleton(char, esp.Skeleton, Config.Color_KillerSkeleton or Color3.fromRGB(240, 60, 160), Config.KillerSkeletonThickness or 1.3, aKillerSkel, rig)
                        else
                            for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                        end

                        -- Top Text: Player Name [Distance] (Clean, no [KILLER] prefix)
                        if aKillerNames > 0.01 then
                            local topStr = (data and data.DisplayName or player.DisplayName) .. " [" .. math.floor(dist) .. "m]"
                            if esp.TopText.Text ~= topStr then esp.TopText.Text = topStr end
                            esp.TopText.Position = Vector2.new(currentX, topY)
                            esp.TopText.Color = Config.Color_KillerNames or Color3.fromRGB(255, 60, 160)
                            esp.TopText.Transparency = aKillerNames
                            if not esp.TopText.Visible then esp.TopText.Visible = true end
                        elseif esp.TopText.Visible then
                            esp.TopText.Visible = false
                        end

                        -- Bottom Text: [KILLER] KillerType (Directly locked under feet)
                        currentY = btmY
                        if aKillerNames > 0.01 then
                            local kType = player:GetAttribute("SelectedKiller") or "The Killer"
                            local btmStr = "[KILLER] " .. kType
                            if char:GetAttribute("IsStunned") == true then btmStr = btmStr .. " [STUNNED]" end
                            if char:GetAttribute("IsCarrying") == true then btmStr = btmStr .. " [CARRYING]" end

                            if esp.BottomText.Text ~= btmStr then esp.BottomText.Text = btmStr end
                            esp.BottomText.Position = Vector2.new(currentX, currentY)
                            esp.BottomText.Color = Color3.fromRGB(255, 255, 255)
                            esp.BottomText.Transparency = aKillerNames
                            if not esp.BottomText.Visible then esp.BottomText.Visible = true end
                            currentY = currentY + 14
                        elseif esp.BottomText.Visible then
                            esp.BottomText.Visible = false
                        end

                        -- Skills & Charges Text (Suppressed under feet; rendered at top of screen under countdown timer)
                        if esp.SkillText.Visible then
                            esp.SkillText.Visible = false
                            esp.SkillText.Text = ""
                        end

                        -- Perks Text (Directly below skills under feet)
                        if aKillerPerks > 0.01 then
                            local perksFmt = data and data.PerksFormatted
                            if perksFmt and #perksFmt > 0 then
                                local pStr = "Perks: " .. perksFmt
                                if esp.PerkText.Text ~= pStr then esp.PerkText.Text = pStr end
                                esp.PerkText.Position = Vector2.new(currentX, currentY)
                                esp.PerkText.Color = Color3.fromRGB(255, 120, 140)
                                esp.PerkText.Transparency = aKillerPerks
                                if not esp.PerkText.Visible then esp.PerkText.Visible = true end
                                currentY = currentY + 14
                            elseif esp.PerkText.Visible then
                                esp.PerkText.Visible = false
                            end
                        elseif esp.PerkText.Visible then
                            esp.PerkText.Visible = false
                        end
                    else
                        if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                        if esp.Box.Visible then esp.Box.Visible = false end
                        if esp.TopText.Visible then esp.TopText.Visible = false end
                        if esp.BottomText.Visible then esp.BottomText.Visible = false end
                        if esp.SkillText.Visible then esp.SkillText.Visible = false end
                        if esp.PerkText.Visible then esp.PerkText.Visible = false end
                        for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                    end

                -- SURVIVOR OR LOBBY BRANCH
                else
                    local allowESP = inLobby and (Config.ESP_LobbyEnabled ~= false) or (not inLobby and (aSurvMaster > 0.01 or aSurvBoxes > 0.01 or aSurvSkel > 0.01 or aSurvNames > 0.01 or aSurvStatus > 0.01 or aSurvSkills > 0.01 or aSurvPerks > 0.01) and not isLobbyPlr and not isDead)
                    if allowESP then
                        -- Carrying detection already evaluated above

                        -- Survivor Skeleton
                        if (not isBeingCarriedByMe) and aSurvSkel > 0.01 and dist <= 2500 and onScreen then
                            UpdateSkeleton(char, esp.Skeleton, Config.Color_SurvivorSkeleton or Color3.fromRGB(80, 255, 160), Config.SurvivorSkeletonThickness or 1.3, aSurvSkel, rig)
                        else
                            for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                        end

                        local topWorld = headValid and (headPos + Vector3.new(0, head.Size.Y * 0.5 + 0.35, 0)) or (torsoCF.Position + Vector3.new(0, root.Size.Y * 0.5 + 1.5, 0))
                        local hipHeight = (hum and hum.HipHeight > 0) and hum.HipHeight or 2.0
                        local footBottomY = rootPos.Y - (root.Size.Y * 0.5 + hipHeight + 0.1)
                        local btmWorld = Vector3.new(rootPos.X, footBottomY, rootPos.Z)
                        local topScreen, _topVis = Camera:WorldToViewportPoint(topWorld)
                        local btmScreen, _btmVis = Camera:WorldToViewportPoint(btmWorld)

                        if topScreen.Z > 0 and btmScreen.Z > 0 then
                            local col = inLobby and Color3.fromRGB(0, 210, 255) or (Config.Color_SurvivorBox or Color3.fromRGB(80, 255, 120))

                            local rawHeight = math.abs(btmScreen.Y - topScreen.Y)
                            local boxHeight = math.floor(math.max(12, rawHeight))
                            local boxWidth = math.floor(math.max(6, boxHeight * 0.55))
                            local boxX = math.floor(rootScreen.X - boxWidth * 0.5)
                            local boxY = math.floor(math.min(topScreen.Y, btmScreen.Y))

                            local boxAlpha = inLobby and (Config.ESP_LobbyBoxes ~= false and 1 or 0) or aSurvBoxes
                            if (not isBeingCarriedByMe) and boxAlpha > 0.01 then
                                local boxPos = Vector2.new(boxX, boxY)
                                local boxSize = Vector2.new(boxWidth, boxHeight)

                                esp.BoxOutline.Size = boxSize
                                esp.BoxOutline.Position = boxPos
                                esp.BoxOutline.Transparency = boxAlpha
                                if not esp.BoxOutline.Visible then esp.BoxOutline.Visible = true end

                                esp.Box.Size = boxSize
                                esp.Box.Position = boxPos
                                esp.Box.Color = col
                                esp.Box.Transparency = boxAlpha
                                if not esp.Box.Visible then esp.Box.Visible = true end
                            else
                                if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                                if esp.Box.Visible then esp.Box.Visible = false end
                            end

                            -- Status check (Hooked, Carried, Down, Injured)
                            local statusText = nil
                            local statusColor = nil
                            if not inLobby and aSurvStatus > 0.01 then
                                local isHooked = (char:GetAttribute("IsHooked") == true) or (CollectionService and CollectionService:HasTag(char, "Hooked"))
                                local isCarried = (char:GetAttribute("IsCarried") == true) or (char:GetAttribute("Carried") == true)
                                local isDown = (char:GetAttribute("Knocked") == true) or (CollectionService and CollectionService:HasTag(char, "Knocked"))
                                if isHooked then
                                    statusText = "[HOOKED]"
                                    statusColor = Color3.fromRGB(255, 60, 60)
                                elseif isCarried then
                                    statusText = "[CARRIED]"
                                    statusColor = Color3.fromRGB(255, 170, 0)
                                elseif isDown then
                                    statusText = "[DOWN]"
                                    statusColor = Color3.fromRGB(255, 85, 85)
                                elseif hum and hum.Health < 99 then
                                    statusText = "[Injured]"
                                    statusColor = Color3.fromRGB(255, 215, 0) -- Fixed Yellow
                                end
                            end

                            -- Top Text: Player Name [Distance] (Clean, no [SURVIVOR] prefix)
                            local nameAlpha = inLobby and (Config.ESP_LobbyNames ~= false and 1 or 0) or aSurvNames
                            if (not isBeingCarriedByMe) and nameAlpha > 0.01 then
                                local topStr = (data and data.DisplayName or player.DisplayName)
                                if not inLobby then
                                    topStr = topStr .. " [" .. math.floor(dist) .. "m]"
                                end
                                if esp.TopText.Text ~= topStr then esp.TopText.Text = topStr end
                                esp.TopText.Position = Vector2.new(rootScreen.X, boxY - 14)
                                local nameCol = inLobby and Color3.fromRGB(0, 210, 255) or (Config.Color_SurvivorNames or Color3.fromRGB(80, 255, 120))
                                if esp.TopText.Color ~= nameCol then esp.TopText.Color = nameCol end
                                esp.TopText.Transparency = nameAlpha
                                if not esp.TopText.Visible then esp.TopText.Visible = true end
                            elseif esp.TopText.Visible then
                                esp.TopText.Visible = false
                            end

                            -- Bottom: Under the feet (Status [Injured] -> Item -> Perks)
                            currentY = boxY + boxHeight + 2

                            -- Status Text: Positioned directly under feet
                            if (not isBeingCarriedByMe) and statusText and aSurvStatus > 0.01 then
                                if esp.BottomText.Text ~= statusText then esp.BottomText.Text = statusText end
                                esp.BottomText.Position = Vector2.new(rootScreen.X, currentY)
                                esp.BottomText.Color = statusColor
                                esp.BottomText.Transparency = aSurvStatus
                                if not esp.BottomText.Visible then esp.BottomText.Visible = true end
                                currentY = currentY + 14
                            elseif esp.BottomText.Visible then
                                esp.BottomText.Visible = false
                            end

                            -- Survivor Item & Status
                            local sSkillStr = data and data.SkillInfo
                            local isItemReady = data and data.ItemReady
                            if data and data.ItemName then
                                local liveCD = GetItemCooldown(player, data.ItemName)
                                if liveCD > 0 then
                                    isItemReady = false
                                    sSkillStr = "Item: " .. data.ItemName .. (data.ItemQtyStr or "") .. string.format(" (CD %ds)", liveCD)
                                    if data.OtherDetails and #data.OtherDetails > 0 then
                                        sSkillStr = sSkillStr .. " | " .. data.OtherDetails
                                    end
                                end
                            end
                            if (not isBeingCarriedByMe) and aSurvSkills > 0.01 and not inLobby and not isK and type(sSkillStr) == "string" and #sSkillStr > 0 then
                                if esp.SkillText.Text ~= sSkillStr then esp.SkillText.Text = sSkillStr end
                                esp.SkillText.Position = Vector2.new(rootScreen.X, currentY)
                                local sCol = (isItemReady == false and Color3.fromRGB(255, 75, 75)) or (isItemReady == true and Color3.fromRGB(80, 255, 80)) or Color3.fromRGB(80, 220, 255)
                                if esp.SkillText.Color ~= sCol then esp.SkillText.Color = sCol end
                                esp.SkillText.Transparency = aSurvSkills
                                if not esp.SkillText.Visible then esp.SkillText.Visible = true end
                                currentY = currentY + 14
                            elseif esp.SkillText.Visible then
                                esp.SkillText.Visible = false
                                esp.SkillText.Text = ""
                            end

                            -- Survivor Perks
                            if aSurvPerks > 0.01 then
                                local perksFmt = data and data.PerksFormatted
                                if perksFmt and #perksFmt > 0 then
                                    if esp.PerkText.Text ~= perksFmt then esp.PerkText.Text = perksFmt end
                                    esp.PerkText.Position = Vector2.new(rootScreen.X, currentY)
                                    esp.PerkText.Color = Color3.fromRGB(120, 220, 255)
                                    esp.PerkText.Transparency = aSurvPerks
                                    if not esp.PerkText.Visible then esp.PerkText.Visible = true end
                                    currentY = currentY + 14
                                elseif esp.PerkText.Visible then
                                    esp.PerkText.Visible = false
                                end
                            elseif esp.PerkText.Visible then
                                esp.PerkText.Visible = false
                            end
                        else
                            if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                            if esp.Box.Visible then esp.Box.Visible = false end
                            if esp.TopText.Visible then esp.TopText.Visible = false end
                            if esp.BottomText.Visible then esp.BottomText.Visible = false end
                            if esp.SkillText.Visible then esp.SkillText.Visible = false end
                            if esp.PerkText.Visible then esp.PerkText.Visible = false end
                            for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                        end
                    else
                        if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                        if esp.Box.Visible then esp.Box.Visible = false end
                        if esp.TopText.Visible then esp.TopText.Visible = false end
                        if esp.BottomText.Visible then esp.BottomText.Visible = false end
                        if esp.SkillText.Visible then esp.SkillText.Visible = false end
                        if esp.PerkText.Visible then esp.PerkText.Visible = false end
                        for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
                    end
                end
            else
                if esp.BoxOutline.Visible then esp.BoxOutline.Visible = false end
                if esp.Box.Visible then esp.Box.Visible = false end
                if esp.TopText.Visible then esp.TopText.Visible = false end
                if esp.BottomText.Visible then esp.BottomText.Visible = false end
                if esp.SkillText.Visible then esp.SkillText.Visible = false end
                if esp.PerkText.Visible then esp.PerkText.Visible = false end
                for _, l in pairs(esp.Skeleton) do if l.Visible then l.Visible = false end end
            end
        else
            hidePlayerESP(esp)
        end
            end
    end
    
    -- Top Screen Killer Skill (Throttled to 0.15s instead of running animator/attribute scans every frame)

    local activeKillerSkillStr = cachedTopKillerSkillStr
    if aKillerSkills > 0.01 and not inCutscene and (not inLobby or Config.ESP_LobbyEnabled) then
        if nowClock - lastTopSkillUpdateTime > 0.15 then
            lastTopSkillUpdateTime = nowClock
            activeKillerSkillStr = nil
            if IsKiller(LocalPlayer) and not IsPlayerDead(LocalPlayer) then
                activeKillerSkillStr = GetPlayerSkillInfo(LocalPlayer)
            else
                local kp = CurrentKillerPlayer
                if not kp or IsPlayerDead(kp) or not IsKiller(kp) or (not inLobby and IsPlayerInLobby(kp)) then
                    kp = nil
                    CurrentKillerPlayer = nil
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and IsKiller(p) and not IsPlayerDead(p) and (inLobby or not IsPlayerInLobby(p)) then
                            kp = p
                            CurrentKillerPlayer = p
                            break
                        end
                    end
                end
                if kp and IsKiller(kp) and not IsPlayerDead(kp) then
                    activeKillerSkillStr = (CachedPlayerData[kp] and CachedPlayerData[kp].SkillInfo) or GetPlayerSkillInfo(kp)
                end
            end
            cachedTopKillerSkillStr = activeKillerSkillStr
        end
    else
        activeKillerSkillStr = nil
    end

    if aKillerSkills > 0.01 and activeKillerSkillStr and type(activeKillerSkillStr) == "string" and #activeKillerSkillStr > 0 and not inCutscene and (not inLobby or Config.ESP_LobbyEnabled) then
        if activeKillerSkillStr:find("^Skill:") then
            activeKillerSkillStr = activeKillerSkillStr:gsub("^Skill:%s*", "[SKILL] ")
        elseif not activeKillerSkillStr:find("^%[SKILL%]") then
            activeKillerSkillStr = "[SKILL] " .. activeKillerSkillStr
        end
        activeKillerSkillStr = activeKillerSkillStr:gsub("%s*|%s*CHASING", ""):gsub("%[CHASING%]", "")

        if TopKillerSkillText.Text ~= activeKillerSkillStr then TopKillerSkillText.Text = activeKillerSkillStr end
        TopKillerSkillText.Position = Vector2.new(Camera.ViewportSize.X * 0.5, Config.TopKillerSkillYOffset or 58)
        TopKillerSkillText.Color = Config.Color_KillerSkills or Color3.fromRGB(80, 220, 255)
        TopKillerSkillText.Size = Config.TopKillerSkillSize or 16
        TopKillerSkillText.Transparency = aKillerSkills
        if not TopKillerSkillText.Visible then TopKillerSkillText.Visible = true end
    elseif TopKillerSkillText.Visible then
        TopKillerSkillText.Visible = false
        TopKillerSkillText.Text = ""
    end

    -- 2. Generator ESP & 3D Chams (Auto-hides completed generators >= 100%)
    table.clear(seenGens)
    if not inLobby and (aGenESP > 0.01 or aGenChams > 0.01) then
        for _, item in ipairs(CachedGenerators) do
            local gen = item.Model
            local root = item.Part
            if gen and gen.Parent and (not root or not root.Parent) then
                root = gen:FindFirstChild("RootPart") or gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart")
                item.Part = root
            end
            if gen and gen.Parent and root and root.Parent then
                local prog = tonumber(gen:GetAttribute("RepairProgress")) or 0
                if prog < 100 then
                    seenGens[gen] = true
                    local repairers = tonumber(gen:GetAttribute("PlayersRepairingCount")) or 0
                    local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    local genVisibleInFrustum = onScreen or (sPos.Z > 0 and sPos.X >= -250 and sPos.X <= Camera.ViewportSize.X + 250 and sPos.Y >= -250 and sPos.Y <= Camera.ViewportSize.Y + 250)

                    -- 3D Generator Chams / Highlight (Frustum-culled when behind camera to save stencil passes & 31-Highlight slots)
                    if aGenChams > 0.01 and genVisibleInFrustum then
                        local genTarget = gen:FindFirstChild("GeneratorBody") or gen
                        local hl = GenAuras[gen]
                        local cCol = (repairers > 0 and Color3.fromRGB(255, 215, 0))
                                  or (Config.Color_GenChams or Config.Color_Generators or Color3.fromRGB(0, 240, 255))
                        if not hl or not hl.Parent then
                            hl = Instance.new("Highlight")
                            hl.Name = "Nexara_GenAura"
                            hl.FillColor = cCol
                            hl.OutlineColor = cCol
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = genTarget
                            local hlParent = (gethui and gethui()) or game:GetService("CoreGui") or gen
                            pcall(function() hl.Parent = hlParent end)
                            GenAuras[gen] = hl
                        else
                            if hl.Adornee ~= genTarget then hl.Adornee = genTarget end
                            if hl.FillColor ~= cCol then
                                hl.FillColor = cCol
                                hl.OutlineColor = cCol
                            end
                        end
                        hl.FillTransparency = 1 - (0.25 * aGenChams)
                        hl.OutlineTransparency = 1 - (0.60 * aGenChams)
                        if not hl.Enabled then hl.Enabled = true end

                        if doCleanHighlights then
                            for _, container in ipairs({gen, genTarget, gen.Parent}) do
                                if container then
                                    for _, child in ipairs(container:GetChildren()) do
                                        if child:IsA("Highlight") and child ~= hl then
                                            if child.Enabled then child.Enabled = false end
                                            if child.Adornee ~= Workspace.Terrain then
                                                pcall(function() child.Adornee = Workspace.Terrain end)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    elseif GenAuras[gen] and GenAuras[gen].Enabled then
                        GenAuras[gen].Enabled = false
                    end

                    -- 2D Generator Text ESP
                    if aGenESP > 0.01 then
                        local txt = GenDrawings[gen]
                        if not txt then
                            txt = Drawing.new("Text")
                            txt.Size = 13
                            txt.Center = true
                            txt.Outline = true
                            txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                            GenDrawings[gen] = txt
                        end

                        if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                            local dist = math.floor((myPos - root.Position).Magnitude)
                            local label = "Generator " .. dist .. "m"
                            if Config.ESP_GenProgress then
                                label = string.format("Generator [%d%%] %dm", math.floor(prog), dist)
                                if repairers > 0 then label = label .. " (Repairing)" end
                            end

                            if txt.Text ~= label then txt.Text = label end
                            txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))

                            local gCol = (repairers > 0 and Color3.fromRGB(255, 215, 0))
                                      or (Config.Color_Generators or Color3.fromRGB(0, 240, 255))
                            if txt.Color ~= gCol then txt.Color = gCol end
                            txt.Transparency = aGenESP
                            if not txt.Visible then txt.Visible = true end
                        elseif txt.Visible then
                            txt.Visible = false
                        end
                    elseif GenDrawings[gen] and GenDrawings[gen].Visible then
                        GenDrawings[gen].Visible = false
                    end
                end
            end
        end
    end
    for gen, txt in pairs(GenDrawings) do
        if (not seenGens[gen] or aGenESP <= 0.01) and txt.Visible then txt.Visible = false end
    end
    for gen, hl in pairs(GenAuras) do
        if not seenGens[gen] or inLobby or aGenChams <= 0.01 then
            if hl.Enabled then hl.Enabled = false end
            if gen and gen.Parent and (tonumber(gen:GetAttribute("RepairProgress")) or 0) >= 100 then
                pcall(function() hl:Destroy() end)
                GenAuras[gen] = nil
            end
        end
    end

    -- 3. Pallet ESP & 3D Glowing Aura
    table.clear(seenPallets)
    if not inLobby and (aPalletESP > 0.01 or aPalletAura > 0.01) then
        -- Killer proximity breaking check (throttled to 0.12s to avoid N*M iterations at 144Hz)
        local nowTime = os.clock()
        if nowTime - lastPalletCheckTime > 0.12 then
            lastPalletCheckTime = nowTime
            local kp = CurrentKillerPlayer
            if kp and kp.Character then
                local kChar = kp.Character
                local isBreaking = kChar:GetAttribute("isBreakingPallet") == true
                                or kChar:GetAttribute("isBreaking") == true
                if isBreaking then
                    local kRoot = kChar:FindFirstChild("HumanoidRootPart")
                    if kRoot then
                        local kPos = kRoot.Position
                        for _, item in ipairs(CachedPallets) do
                            local pModel = item.Model
                            local pRoot = item.Part
                            if pModel and pRoot and pRoot.Parent and (pRoot.Position - kPos).Magnitude < 10 then
                                MarkPalletBroken(pModel)
                            end
                        end
                    end
                end
            end

            cachedDroppingHRPPos = nil
            for _, p in ipairs(Players:GetPlayers()) do
                local c = p.Character
                if c and (c:GetAttribute("isDroppingPallet") == true or c:GetAttribute("IsDroppingPallet") == true) then
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if r then cachedDroppingHRPPos = r.Position; break end
                end
            end
        end
        local droppingHRPPos = cachedDroppingHRPPos

        -- Throttled distance sorting (every 0.3s) - reuses pre-allocated entries and respects StreamingEnabled
        if (nowTime - lastPalletSortTime > 0.3) or (#cachedPalletEntries == 0) then
            lastPalletSortTime = nowTime
            local validCount = 0
            for _, item in ipairs(CachedPallets) do
                local pallet = item.Model
                local root = item.Part
                if pallet and pallet.Parent then
                    if not root or not root.Parent then
                        local intact = pallet:FindFirstChild("Intact")
                        root = (intact and intact:FindFirstChild("Pallet")) or pallet:FindFirstChild("PrimaryPartPallet") or pallet.PrimaryPart or pallet:FindFirstChildWhichIsA("BasePart")
                        item.Part = root
                    end
                    if IsPalletBroken(pallet, root) then
                        MarkPalletBroken(pallet)
                    elseif root and root.Parent then
                        local dist = (myPos - root.Position).Magnitude
                        validCount = validCount + 1
                        local entry = cachedPalletEntries[validCount]
                        if not entry then
                            entry = { Item = item, Dist = dist }
                            cachedPalletEntries[validCount] = entry
                        else
                            entry.Item = item
                            entry.Dist = dist
                        end
                    end
                end
            end
            for i = #cachedPalletEntries, validCount + 1, -1 do
                cachedPalletEntries[i] = nil
            end
            table.sort(cachedPalletEntries, sortPalletByDist)
        end

        local activePalletHighlights = 0
        for _, entry in ipairs(cachedPalletEntries) do
            local item = entry.Item
            local pallet = item.Model
            local root = item.Part
            if pallet and pallet.Parent and root and root.Parent and not BrokenPallets[pallet] then
                seenPallets[pallet] = true
                local dist = (myPos - root.Position).Magnitude
                local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local palInFrustum = onScreen or (sPos.Z > 0 and sPos.X >= -200 and sPos.X <= Camera.ViewportSize.X + 200 and sPos.Y >= -200 and sPos.Y <= Camera.ViewportSize.Y + 200)

                -- 3D Glowing Aura through walls (Frustum-culled to active camera view so off-screen pallets never lag or steal Highlight slots)
                if aPalletAura > 0.01 and palInFrustum and activePalletHighlights < 12 and dist <= Config.PalletMaxDist then
                    activePalletHighlights = activePalletHighlights + 1
                    local targetAdornee = item.PalletWood or root or pallet
                    local hl = PalletAuras[pallet]
                    local aCol = Config.Color_PalletAura or Color3.fromRGB(255, 205, 90)
                    if not hl or not hl.Parent then
                        hl = Instance.new("Highlight")
                        hl.Name = "Nexara_PalletAura"
                        hl.FillColor = aCol
                        hl.OutlineColor = aCol
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = targetAdornee
                        local hlParent = (gethui and gethui()) or game:GetService("CoreGui") or targetAdornee
                        pcall(function() hl.Parent = hlParent end)
                        PalletAuras[pallet] = hl
                    else
                        if hl.Adornee ~= targetAdornee then hl.Adornee = targetAdornee end
                        if hl.FillColor ~= aCol then
                            hl.FillColor = aCol
                            hl.OutlineColor = aCol
                        end
                    end
                    hl.FillTransparency = 1 - (0.28 * aPalletAura)
                    hl.OutlineTransparency = 1 - (0.60 * aPalletAura)
                    if not hl.Enabled then hl.Enabled = true end
                elseif PalletAuras[pallet] and PalletAuras[pallet].Enabled then
                    PalletAuras[pallet].Enabled = false
                end

                -- Distance Text
                if aPalletESP > 0.01 and dist <= Config.PalletMaxDist then
                    if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                        local txt = PalletDrawings[pallet]
                        if not txt then
                            txt = Drawing.new("Text")
                            txt.Size = 12
                            txt.Center = true
                            txt.Outline = true
                            txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                            PalletDrawings[pallet] = txt
                        end
                        local isDropped = IsPalletDropped(pallet, root)
                        local isDropping = droppingHRPPos and ((droppingHRPPos - root.Position).Magnitude < 7) or false

                        local mDist = math.floor(dist)
                        local pText = isDropping and ("Pallet Dropping " .. mDist .. "m")
                                   or isDropped and ("Pallet [Dropped] " .. mDist .. "m")
                                   or ("Pallet " .. mDist .. "m")
                        local pCol = isDropping and Color3.fromRGB(255, 80, 80)
                                  or isDropped and Color3.fromRGB(255, 140, 40)
                                  or (Config.Color_PalletNames or Color3.fromRGB(255, 180, 50))

                        if txt.Text ~= pText then txt.Text = pText end
                        if txt.Color ~= pCol then txt.Color = pCol end
                        txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                        txt.Transparency = aPalletESP
                        if not txt.Visible then txt.Visible = true end
                    elseif PalletDrawings[pallet] and PalletDrawings[pallet].Visible then
                        PalletDrawings[pallet].Visible = false
                    end
                elseif PalletDrawings[pallet] and PalletDrawings[pallet].Visible then
                    PalletDrawings[pallet].Visible = false
                end
            end
        end
    end
    for pallet, hl in pairs(PalletAuras) do
        local isBrk = BrokenPallets[pallet] == true
        if not seenPallets[pallet] or inLobby or aPalletAura <= 0.01 or isBrk then
            if hl.Enabled then hl.Enabled = false end
            if isBrk then
                pcall(function() hl:Destroy() end)
                PalletAuras[pallet] = nil
            end
        end
    end
    for pallet, txt in pairs(PalletDrawings) do
        local isBrk = BrokenPallets[pallet] == true
        if not seenPallets[pallet] or aPalletESP <= 0.01 or isBrk then
            if txt.Visible then txt.Visible = false end
            if isBrk then
                pcall(function() txt:Remove() end)
                PalletDrawings[pallet] = nil
            end
        end
    end

    -- 4. Window / Vault ESP & 3D Glowing Aura
    table.clear(seenWindows)
    if not inLobby and (aWindowESP > 0.01 or aWindowAura > 0.01) then
        local wAuraCol = Config.Color_WindowAura or Color3.fromRGB(0, 210, 255)
        local wGlowCol = wAuraCol:Lerp(Color3.new(1, 1, 1), 0.35)

        for _, item in ipairs(CachedWindows) do
            local win = item.Model or item.Part
            local root = item.Part
            local ledge = item.VaultLedge or root
            if win and win.Parent and (not ledge or not ledge.Parent) and win:IsA("Model") then
                ledge = win:FindFirstChild("Bottom") or win:FindFirstChild("Ledge") or win:FindFirstChild("VaultTrigger") or win:FindFirstChildWhichIsA("BasePart")
                root = ledge
                item.Part = ledge
                item.VaultLedge = ledge
            end
            if win and win.Parent and ledge and ledge.Parent then
                local dist = (myPos - root.Position).Magnitude
                if dist <= Config.WindowMaxDist then
                    seenWindows[win] = true
                    local sillType = item.SillType or "Auto"
                    local offsetY = ((sillType == "Trigger" or sillType == "InvisWall") and ledge.Size.Y >= 4.5) and (-(ledge.Size.Y - 2.8) / 2) or 0

                    -- Check blocked status & countdown timer
                    local isBlocked, blockTimeLeft = GetWindowBlockTime(win, root, ledge)
                    local activeBoxColor = isBlocked and Color3.fromRGB(255, 50, 50) or wAuraCol
                    local activeGlowColor = isBlocked and Color3.fromRGB(255, 100, 100) or wGlowCol

                    -- 3D Glowing Vault Sill (Dual-Layer Hologram: Solid Core + Neon Outer Glow, always visible)
                    local sillWorldPos = ledge.CFrame:PointToWorldSpace(Vector3.new(0, offsetY, 0))
                    if aWindowAura > 0.01 then
                        local effWinAura = aWindowAura
                        if effWinAura > 0.01 then
                            local sillSize, sillOffset
                            if ledge.Name == "Bottom" then
                                sillSize = ledge.Size
                                sillOffset = CFrame.new(0, 0, 0)
                            else
                                local rawW = math.max(ledge.Size.X, ledge.Size.Z)
                                local rawT = math.min(ledge.Size.X, ledge.Size.Z)
                                local width = math.clamp(rawW, 3.8, 6.0)
                                local thickness = math.clamp(rawT, 0.8, 2.0)
                                local height = (ledge.Size.Y >= 1.2 and ledge.Size.Y <= 4.0) and ledge.Size.Y or 2.8
                                sillSize = (ledge.Size.X >= ledge.Size.Z) and Vector3.new(width, height, thickness) or Vector3.new(thickness, height, width)
                                sillOffset = CFrame.new(0, offsetY, 0)
                            end

                            -- Layer 1: Core BoxHandleAdornment
                            local bha = WindowAdornments[win]
                            if not bha or not bha.Parent or not bha:IsA("BoxHandleAdornment") then
                                bha = Instance.new("BoxHandleAdornment")
                                bha.Name = "Nexara_WindowBox"
                                bha.AlwaysOnTop = true
                                bha.ZIndex = 8
                                bha.Adornee = ledge
                                bha.Size = sillSize
                                bha.CFrame = sillOffset
                                bha.Color3 = activeBoxColor
                                bha.Parent = ledge
                                WindowAdornments[win] = bha
                            else
                                if bha.Adornee ~= ledge then bha.Adornee = ledge end
                                if bha.Size ~= sillSize then bha.Size = sillSize end
                                if bha.CFrame ~= sillOffset then bha.CFrame = sillOffset end
                                if bha.Color3 ~= activeBoxColor then bha.Color3 = activeBoxColor end
                            end
                            bha.Transparency = 1 - (0.15 * effWinAura)
                            if not bha.Visible then bha.Visible = true end

                            -- Layer 2: Outer Glow Shell BoxHandleAdornment (Stored in WindowAuras)
                            local glow = WindowAuras[win]
                            if not glow or not glow.Parent or not glow:IsA("BoxHandleAdornment") then
                                if glow and glow:IsA("Highlight") then
                                    pcall(function() glow:Destroy() end)
                                end

                                glow = Instance.new("BoxHandleAdornment")
                                glow.Name = "Nexara_WindowGlow"
                                glow.AlwaysOnTop = true
                                glow.ZIndex = 7
                                glow.Adornee = ledge
                                glow.Size = sillSize + Vector3.new(0.12, 0.12, 0.12)
                                glow.CFrame = sillOffset
                                glow.Color3 = activeGlowColor
                                glow.Parent = ledge
                                WindowAuras[win] = glow
                            else
                                if glow.Adornee ~= ledge then glow.Adornee = ledge end
                                if glow.Size ~= (sillSize + Vector3.new(0.12, 0.12, 0.12)) then glow.Size = sillSize + Vector3.new(0.12, 0.12, 0.12) end
                                if glow.CFrame ~= sillOffset then glow.CFrame = sillOffset end
                                if glow.Color3 ~= activeGlowColor then glow.Color3 = activeGlowColor end
                            end
                            glow.Transparency = 1 - (0.08 * effWinAura)
                            if not glow.Visible then glow.Visible = true end
                        else
                            if WindowAdornments[win] and WindowAdornments[win].Visible then WindowAdornments[win].Visible = false end
                            if WindowAuras[win] and WindowAuras[win].Visible then WindowAuras[win].Visible = false end
                        end
                    else
                        if WindowAdornments[win] and WindowAdornments[win].Visible then WindowAdornments[win].Visible = false end
                        if WindowAuras[win] and WindowAuras[win].Visible then WindowAuras[win].Visible = false end
                    end

                    -- Distance Text & Block Timer
                    local txt = WindowDrawings[win]
                    if not txt then
                        txt = Drawing.new("Text")
                        txt.Size = 12
                        txt.Center = true
                        txt.Outline = true
                        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                        WindowDrawings[win] = txt
                    end

                    if aWindowESP > 0.01 then
                        local sPos, onScreen = Camera:WorldToViewportPoint(sillWorldPos)
                        if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                            local wText = isBlocked and string.format("Vault [BLOCKED %ds] %dm", math.max(1, math.ceil(blockTimeLeft)), math.floor(dist))
                                       or ("Vault " .. math.floor(dist) .. "m")
                            local wCol = isBlocked and Color3.fromRGB(255, 60, 60) or (Config.Color_WindowNames or Color3.fromRGB(80, 210, 255))
                            if txt.Text ~= wText then txt.Text = wText end
                            if txt.Color ~= wCol then txt.Color = wCol end
                            txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                            txt.Transparency = aWindowESP
                            if not txt.Visible then txt.Visible = true end
                        elseif txt.Visible then
                            txt.Visible = false
                        end
                    elseif txt.Visible then
                        txt.Visible = false
                    end
                end
            end
        end
    end
    for win, glow in pairs(WindowAuras) do
        if (not seenWindows[win] or inLobby or aWindowAura <= 0.01) and glow.Visible then
            glow.Visible = false
        end
    end
    for win, bha in pairs(WindowAdornments) do
        if (not seenWindows[win] or inLobby or aWindowAura <= 0.01) and bha.Visible then
            bha.Visible = false
        end
    end
    for win, txt in pairs(WindowDrawings) do
        if (not seenWindows[win] or aWindowESP <= 0.01) and txt.Visible then
            txt.Visible = false
        end
    end

    -- 5. Exit Gates ESP
    table.clear(seenGates)
    if not inLobby and aExitGates > 0.01 then
        for idx, item in ipairs(CachedGates) do
            local gate = item.Model
            local root = item.Part
            if gate and gate.Parent and root and root.Parent then
                seenGates[gate] = true
                local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local txt = GateDrawings[gate]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 13
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    GateDrawings[gate] = txt
                end

                if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                    local dist = math.floor((myPos - root.Position).Magnitude)
                    local gText = string.format("Exit Gate #%d (%dm)", idx, dist)
                    if txt.Text ~= gText then txt.Text = gText end
                    txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                    local gCol = Config.Color_ExitGates or Color3.fromRGB(50, 255, 120)
                    if txt.Color ~= gCol then txt.Color = gCol end
                    txt.Transparency = aExitGates
                    if not txt.Visible then txt.Visible = true end
                elseif txt.Visible then
                    txt.Visible = false
                end
            end
        end
    end
    for gate, txt in pairs(GateDrawings) do
        if (not seenGates[gate] or aExitGates <= 0.01) and txt.Visible then txt.Visible = false end
    end

    -- 6. Bear Traps ESP (Butcher's placed traps)
    table.clear(seenTraps)
    if not inLobby and aBearTraps > 0.01 then
        if (nowClock - lastBearTrapScanTime > 0.4) or not cachedBearTraps then
            lastBearTrapScanTime = nowClock
            local list = {}
            local seen = {}
            for _, t in ipairs(CollectionService:GetTagged("BearTrap")) do
                if not seen[t] then
                    seen[t] = true
                    table.insert(list, t)
                end
            end
            local mapFolder = Workspace:FindFirstChild("Map")
            if mapFolder then
                for _, ch in ipairs(mapFolder:GetChildren()) do
                    if ch.Name == "BearTrap" and not seen[ch] then
                        seen[ch] = true
                        table.insert(list, ch)
                    end
                end
            end
            cachedBearTraps = list
        end

        local kChar = CurrentKillerPlayer and CurrentKillerPlayer.Character
        for _, trap in ipairs(cachedBearTraps or {}) do
            if trap and trap.Parent and (not kChar or not trap:IsDescendantOf(kChar)) then
                local root = trap:IsA("Model") and (trap:FindFirstChild("Cube") or trap.PrimaryPart or trap:FindFirstChildWhichIsA("BasePart")) or (trap:IsA("BasePart") and trap)
                if root and root.Parent then
                    seenTraps[trap] = true
                    local trapPos = root.Position
                    local dist = math.floor((myPos - trapPos).Magnitude)
                    local maxDist = Config.BearTrapMaxDist or 1000
                    local isArmed = trap:GetAttribute("Armed") ~= false

                    -- 3D AlwaysOnTop Glow Highlight for Bear Trap
                    local hl = TrapAuras[trap]
                    local tCol = Config.Color_BearTraps or Color3.fromRGB(255, 65, 65)
                    if not isArmed then
                        tCol = Color3.fromRGB(160, 160, 160)
                    end
                    if dist <= maxDist then
                        if not hl or not hl.Parent then
                            hl = Instance.new("Highlight")
                            hl.Name = "Nexara_TrapAura"
                            hl.FillColor = tCol
                            hl.OutlineColor = tCol
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Adornee = trap
                            local hlParent = (gethui and gethui()) or game:GetService("CoreGui") or trap
                            pcall(function() hl.Parent = hlParent end)
                            TrapAuras[trap] = hl
                        else
                            if hl.Adornee ~= trap then hl.Adornee = trap end
                            if hl.FillColor ~= tCol then
                                hl.FillColor = tCol
                                hl.OutlineColor = tCol
                            end
                        end
                        hl.FillTransparency = 1 - (0.35 * aBearTraps)
                        hl.OutlineTransparency = 1 - (0.75 * aBearTraps)
                        if not hl.Enabled then hl.Enabled = true end
                    elseif hl and hl.Enabled then
                        hl.Enabled = false
                    end

                    -- 2D Text Drawing
                    local txt = TrapDrawings[trap]
                    if not txt then
                        txt = Drawing.new("Text")
                        txt.Size = 13
                        txt.Center = true
                        txt.Outline = true
                        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                        TrapDrawings[trap] = txt
                    end

                    if dist <= maxDist then
                        local sPos, onScreen = Camera:WorldToViewportPoint(trapPos + Vector3.new(0, 0.8, 0))
                        if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                            local tText = isArmed and string.format("[BEAR TRAP] (%dm)", dist) or string.format("[BEAR TRAP - DISARMED] (%dm)", dist)
                            if txt.Text ~= tText then txt.Text = tText end
                            txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                            if txt.Color ~= tCol then txt.Color = tCol end
                            txt.Transparency = aBearTraps
                            if not txt.Visible then txt.Visible = true end
                        elseif txt.Visible then
                            txt.Visible = false
                        end
                    elseif txt.Visible then
                        txt.Visible = false
                    end
                end
            end
        end
    end
    for trap, txt in pairs(TrapDrawings) do
        if (not seenTraps[trap] or aBearTraps <= 0.01) and txt.Visible then txt.Visible = false end
    end
    for trap, hl in pairs(TrapAuras) do
        if not seenTraps[trap] or inLobby or aBearTraps <= 0.01 then
            if hl.Enabled then hl.Enabled = false end
            if not trap or not trap.Parent then
                pcall(function() hl:Destroy() end)
                TrapAuras[trap] = nil
            end
        end
    end

    -- 7. Halloween Pumpkins ESP (3D Aura + 2D Name/Dist + Tracer Line)
    table.clear(seenPumpkins)
    if not inLobby and (aPumpkinAura > 0.01 or aPumpkinESP > 0.01 or aPumpkinTrace > 0.01) then
        local pumpkins = ScanActivePumpkins(false)
        local maxDist = Config.PumpkinMaxDist or 3000
        local vpSize = Camera.ViewportSize
        local traceOrigin = Vector2.new(math.floor(vpSize.X * 0.5), math.floor(vpSize.Y - 12))

        for _, entry in ipairs(pumpkins) do
            local model = entry.Model
            local root = entry.Part
            if model and root and root.Parent and IsPumpkinValidAndIntact(root, model) then
                seenPumpkins[model] = true
                local pPos = root.Position
                local dist = math.floor((myPos - pPos).Magnitude)
                local sPos, onScreen = Camera:WorldToViewportPoint(pPos + Vector3.new(0, 1.4, 0))
                local pInFrustum = onScreen or (sPos.Z > 0 and sPos.X >= -180 and sPos.X <= Camera.ViewportSize.X + 180 and sPos.Y >= -180 and sPos.Y <= Camera.ViewportSize.Y + 180)

                -- 3D Aura Highlight (Frustum-culled when behind camera)
                local hl = PumpkinAuras[model]
                local auraCol = Config.Color_PumpkinAura or Color3.fromRGB(255, 135, 25)
                if aPumpkinAura > 0.01 and pInFrustum and dist <= maxDist then
                    if not hl or not hl.Parent then
                        hl = Instance.new("Highlight")
                        hl.Name = "Nexara_PumpkinAura"
                        hl.FillColor = auraCol
                        hl.OutlineColor = auraCol
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = model
                        local hlParent = (gethui and gethui()) or game:GetService("CoreGui") or model
                        pcall(function() hl.Parent = hlParent end)
                        PumpkinAuras[model] = hl
                    else
                        if hl.Adornee ~= model then hl.Adornee = model end
                        if hl.FillColor ~= auraCol then
                            hl.FillColor = auraCol
                            hl.OutlineColor = auraCol
                        end
                    end
                    hl.FillTransparency = 1 - (0.38 * aPumpkinAura)
                    hl.OutlineTransparency = 1 - (0.85 * aPumpkinAura)
                    if not hl.Enabled then hl.Enabled = true end
                elseif hl and hl.Enabled then
                    hl.Enabled = false
                end

                -- 2D Name & Distance Text
                local txt = PumpkinDrawings[model]
                if aPumpkinESP > 0.01 and dist <= maxDist then
                    if not txt then
                        txt = Drawing.new("Text")
                        txt.Size = 13
                        txt.Center = true
                        txt.Outline = true
                        txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                        PumpkinDrawings[model] = txt
                    end
                    if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                        local pText = string.format("[PUMPKIN] (%dm)", dist)
                        if txt.Text ~= pText then txt.Text = pText end
                        txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                        local nCol = Config.Color_PumpkinNames or Color3.fromRGB(255, 165, 45)
                        if txt.Color ~= nCol then txt.Color = nCol end
                        txt.Transparency = aPumpkinESP
                        if not txt.Visible then txt.Visible = true end
                    elseif txt.Visible then
                        txt.Visible = false
                    end
                elseif txt and txt.Visible then
                    txt.Visible = false
                end

                -- 2D Tracer Line
                local ln = PumpkinTracers[model]
                if aPumpkinTrace > 0.01 and dist <= maxDist then
                    if not ln then
                        ln = Drawing.new("Line")
                        ln.Thickness = 1.4
                        PumpkinTracers[model] = ln
                    end
                    if onScreen and not IsInMenu(sPos.X, sPos.Y) then
                        ln.From = traceOrigin
                        ln.To = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y + 14))
                        local trCol = Config.Color_PumpkinTracer or Color3.fromRGB(255, 135, 25)
                        if ln.Color ~= trCol then ln.Color = trCol end
                        ln.Transparency = aPumpkinTrace
                        if not ln.Visible then ln.Visible = true end
                    elseif ln.Visible then
                        ln.Visible = false
                    end
                elseif ln and ln.Visible then
                    ln.Visible = false
                end
            end
        end
    end

    for model, txt in pairs(PumpkinDrawings) do
        if (not seenPumpkins[model] or aPumpkinESP <= 0.01) and txt.Visible then txt.Visible = false end
    end
    for model, ln in pairs(PumpkinTracers) do
        if (not seenPumpkins[model] or aPumpkinTrace <= 0.01) and ln.Visible then ln.Visible = false end
    end
    for model, hl in pairs(PumpkinAuras) do
        if not seenPumpkins[model] or inLobby or aPumpkinAura <= 0.01 then
            if hl.Enabled then hl.Enabled = false end
            if not model or not model.Parent then
                pcall(function() hl:Destroy() end)
                PumpkinAuras[model] = nil
            end
        end
    end

    -- 8. 3D Neon Circle Parry Radius (Anchored to character feet in 3D world space)
    if AutoParry and AutoParry.UpdateRadiusVisual then
        pcall(AutoParry.UpdateRadiusVisual)
    end
end

