-- Dynamically ingest all in-game perks from ReplicatedStorage so newly added perks are 100% covered
local function SyncGamePerksDatabase()
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        if rs:FindFirstChild("Perks") then
            for _, c in ipairs(rs.Perks:GetChildren()) do
                local name = c.Name
                local clean = name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                KnownSurvivorPerks[name:lower()] = name
                KnownSurvivorPerksNormalized[clean] = name
            end
        end
        if rs:FindFirstChild("Killers") then
            for _, k in ipairs(rs.Killers:GetChildren()) do
                local kp = k:FindFirstChild("Perks")
                if kp then
                    for _, p in ipairs(kp:GetChildren()) do
                        local name = p.Name
                        local clean = name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                        KnownKillerPerks[name:lower()] = name
                        KnownKillerPerksNormalized[clean] = name
                    end
                end
            end
        end
    end)
end
