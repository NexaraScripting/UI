    secObj1.Box.Visible = showObj
    secObj2.Box.Visible = showObj

    secWorld1.Box.Visible = showWorld

    for _, btnData in ipairs(categoryButtons) do
        local isSelected = (btnData.Id == catId)
        if isSelected then
            TweenService:Create(btnData.Button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundTransparency = 0.45,
                TextColor3 = Window.Theme.Text
            }):Play()
            btnData.Indicator.Visible = true
            if not isInitialCategorySelect then
                btnData.Indicator.Size = UDim2.new(0, 0, 0, 2)
