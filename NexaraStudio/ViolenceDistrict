    local function IsAnyFlashlightGotPlaying()
        local myChar = LocalPlayer.Character
        if myChar then
            local fl = myChar:FindFirstChild("Flashlight")
            if fl then
                local gotSnd = fl:FindFirstChild("got", true)
                if gotSnd and gotSnd:IsA("Sound") and gotSnd.IsPlaying then
                    return true
                end
            end
        end
        return false
    end

    table.insert(ScriptConnections, RunService.Heartbeat:Connect(function(dt)
        if not ScriptRunning then
            if BlindContainer.Visible then BlindContainer.Visible = false end
            return
        end

        local shouldShowBlind = Config.BlindProgressEnabled and not IsInLobby() and not IsPlayerInLobby(LocalPlayer) and not IsKiller(LocalPlayer) and not IsPlayerDead(LocalPlayer) and not IsCutsceneActive()
        if shouldShowBlind then
            blindUiAlpha = math.min(1, blindUiAlpha + dt * 4.5)
        else
            blindUiAlpha = math.max(0, blindUiAlpha - dt * 4.5)
        end

        if blindUiAlpha <= 0.01 then
            if BlindContainer.Visible then BlindContainer.Visible = false end
            blindProgress = 0
            lastRawBlindness = 0
            return
        end

        if not BlindContainer.Visible then
            BlindContainer.Visible = true
        end

        BlindTitle.TextTransparency = 1 - blindUiAlpha
        titleStroke.Transparency = 1 - (0.85 * blindUiAlpha)
        BarBg.BackgroundTransparency = 1 - (0.90 * blindUiAlpha)
        barStroke.Transparency = 1 - (0.90 * blindUiAlpha)
        BarFill.BackgroundTransparency = 1 - blindUiAlpha
        PctLabel.TextTransparency = 1 - blindUiAlpha
        pctStroke.Transparency = 1 - (0.85 * blindUiAlpha)

        local now = os.clock()
        local rawBlindness = nil

        -- Read real server-replicated Blindness (0 to 100) directly from Killer.Character.Head:GetAttribute("Blindness")
        for _, p in ipairs(Players:GetPlayers()) do
            if IsKiller(p) and p.Character and not IsPlayerDead(p) then
                local head = p.Character:FindFirstChild("Head")
                local bAttr = (head and head:GetAttribute("Blindness")) or p.Character:GetAttribute("Blindness")
                if type(bAttr) == "number" then
                    rawBlindness = math.clamp(bAttr, 0, 100)
                    break
                end
            end
        end

        if IsAnyFlashlightGotPlaying() then
            blindHoldUntil = math.max(blindHoldUntil, now + 0.85)
        end

        if rawBlindness ~= nil then
            -- If server resets Blindness from >=85% down to 0 because the blind succeeded (100% reached), hold 100% briefly so user sees 100%
            if lastRawBlindness >= 85 and rawBlindness <= 5 then
                blindHoldUntil = math.max(blindHoldUntil, now + 0.85)
            elseif rawBlindness >= 99.5 then
                blindHoldUntil = math.max(blindHoldUntil, now + 0.85)
            end
            lastRawBlindness = rawBlindness

            if now < blindHoldUntil and rawBlindness < 10 then
                blindProgress = 1
            else
                local targetProg = math.clamp(rawBlindness / 100, 0, 1)
                blindProgress = blindProgress + (targetProg - blindProgress) * math.clamp(dt * 24, 0, 1)
                if targetProg == 0 and blindProgress < 0.005 then
                    blindProgress = 0
                elseif targetProg >= 0.995 then
                    blindProgress = 1
                end
            end
        else
            blindProgress = 0
            lastRawBlindness = 0
        end

        local pct = math.clamp(math.floor(blindProgress * 100 + 0.5), 0, 100)
        BarFill.Size = UDim2.new(blindProgress, 0, 1, 0)
        PctLabel.Text = tostring(pct) .. "%"
    end))
end

