                    if (ButcherChainCooldownEnd - os.clock()) <= 0 then
                        ButcherChainCooldownEnd = os.clock() + 15
                    end
                end))
            end
            local trapRem = butcherRem:FindFirstChild("PlaceTrap")
            if trapRem then
                table.insert(ScriptConnections, trapRem.OnClientEvent:Connect(function()
                    ButcherTrapCooldownEnd = os.clock() + 3
                end))
            end
        end
    end)
end)

