            Camera.FieldOfView = Config.FOV
        end
    end

    if cv["Enable Custom FOV"] ~= nil then
        Config.CustomFOVEnabled = (cv["Enable Custom FOV"] == true)
        if Config.CustomFOVEnabled then
            Camera.FieldOfView = Config.FOV
        end
    end
    if cv["Fullbright (Clear Vision)"] ~= nil then
        Config.Fullbright = (cv["Fullbright (Clear Vision)"] == true)
        if Config.Fullbright then
            ApplyFullbrightNow()
        else
            RestoreOriginalLighting()
        end
    end

    local function syncCol(flag, def)
        local val = cv[flag .. "_Color"]
        local resolved = def
        if type(val) == "table" and #val >= 3 then
            local r = tonumber(val[1]) or 0
            local g = tonumber(val[2]) or 0
            local b = tonumber(val[3]) or 0
            if r > 1 or g > 1 or b > 1 then
                resolved = Color3.fromRGB(math.clamp(math.floor(r), 0, 255), math.clamp(math.floor(g), 0, 255), math.clamp(math.floor(b), 0, 255))
            else
                resolved = Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
            end
        elseif typeof(val) == "Color3" then
            resolved = val
        elseif type(val) == "string" and val:sub(1, 1) == "#" then
            resolved = Color3.fromHex(val)
        end
        cv[flag .. "_Color"] = { math.floor(resolved.R * 255), math.floor(resolved.G * 255), math.floor(resolved.B * 255) }
        if Window and Window.ConfigFlags and Window.ConfigFlags[flag] and Window.ConfigFlags[flag].SetColor then
            pcall(function() Window.ConfigFlags[flag]:SetColor(resolved, true) end)
        end
        return resolved
    end

    Config.Color_SurvivorBox = syncCol("Survivor 2D Boxes", Config.Color_SurvivorBox)
    Config.Color_SurvivorSkeleton = syncCol("Survivor Skeleton", Config.Color_SurvivorSkeleton)
    Config.Color_SurvivorChams = syncCol("Survivor Chams", Config.Color_SurvivorChams)
