    Window.Theme.Text = pal.Text
    Window.Theme.SubText = pal.MutedText

    -- MainWindow background & CelestialSpaceGradient
    mf.BackgroundColor3 = pal.Background
    mf.BackgroundTransparency = Window.TransparentEnabled and 0.14 or 0.02
    local bgGrad = mf:FindFirstChild("CelestialSpaceGradient")
    if bgGrad and bgGrad:IsA("UIGradient") then
        bgGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, pal.Background:Lerp(acc, 0.08)),
            ColorSequenceKeypoint.new(0.5, pal.Background),
            ColorSequenceKeypoint.new(1.0, pal.Surface:Lerp(acc, 0.05))
        })
    end

    -- Outer CelestialBorder & InnerBorder
    if Window.OuterStrokeGrad then
        Window.OuterStrokeGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, acc:Lerp(Color3.new(1, 1, 1), 0.35)),
            ColorSequenceKeypoint.new(0.35, acc),
            ColorSequenceKeypoint.new(0.70, pal.Border),
            ColorSequenceKeypoint.new(1.0, acc:Lerp(Color3.new(1, 1, 1), 0.15))
        })
    end

    -- Header & Header AccentLine
    local header = mf:FindFirstChild("Header")
    if header then
        header.BackgroundColor3 = pal.Header
        header.BackgroundTransparency = Window.TransparentEnabled and 0.12 or 0
        local hLine = header:FindFirstChild("AccentLine")
        if hLine then
            hLine.BackgroundColor3 = acc
            local hg = hLine:FindFirstChildOfClass("UIGradient")
            if hg then
                hg.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, pal.Border),
                    ColorSequenceKeypoint.new(0.5, acc:Lerp(Color3.new(1, 1, 1), 0.25)),
                    ColorSequenceKeypoint.new(1.0, pal.Border)
                })
            end
        end
        local logo = header:FindFirstChild("Logo")
