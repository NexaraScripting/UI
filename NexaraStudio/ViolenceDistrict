-- ======== REAL MULTI-LAYER ANTI-AFK ENGINE ========
-- Fixes UI-NexaraStudio.lua's default Anti-AFK which never runs its callback on initial Default=true
-- and adds Engine C-Signal Disable (getconnections) + VirtualUser + VirtualInputManager fallback
local AntiAfkActive = true
local AntiAfkIdledConn = nil

local function ApplyAntiAfkState(enabled)
    AntiAfkActive = (enabled ~= false)
    if AntiAfkIdledConn then
        pcall(function() AntiAfkIdledConn:Disconnect() end)
        AntiAfkIdledConn = nil
    end

    -- Layer 1: Disable Roblox Engine's internal C-level 20-minute Idle kick connection directly
    pcall(function()
        local getconns = getconnections or get_signal_connections
        if getconns and LocalPlayer then
            for _, conn in ipairs(getconns(LocalPlayer.Idled)) do
                if not conn.Function then
                    if AntiAfkActive then
                        if conn.Disable then conn:Disable() elseif conn.Disconnect then conn:Disconnect() end
                    else
                        if conn.Enable then conn:Enable() end
                    end
                end
            end
        end
    end)

    -- Layer 2: Hook LocalPlayer.Idled with both VirtualUser and VirtualInputManager
    if AntiAfkActive and LocalPlayer then
        AntiAfkIdledConn = LocalPlayer.Idled:Connect(function()
            if not AntiAfkActive then return end
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:CaptureController()
                vu:ClickButton2(Vector2.new())
            end)
            pcall(function()
                VirtualInputManager:SendMouseMoveEvent(1, 1, workspace.CurrentCamera or game)
            end)
        end)
        table.insert(ScriptConnections, AntiAfkIdledConn)
    end
end

pcall(function()
    local afkItem = Window.ConfigFlags and Window.ConfigFlags["AntiAFK"]
    if afkItem and type(afkItem.Set) == "function" and not afkItem._nexaraAfkHooked then
        afkItem._nexaraAfkHooked = true
        local origAfkSet = afkItem.Set
        afkItem.Set = function(selfItem, val, silent)
            origAfkSet(selfItem, val, silent)
            ApplyAntiAfkState(val == true)
        end
    end
    local initAfk = true
    if Window.ConfigValues and Window.ConfigValues["AntiAFK"] ~= nil then
        initAfk = (Window.ConfigValues["AntiAFK"] == true)
    end
    ApplyAntiAfkState(initAfk)
end)

