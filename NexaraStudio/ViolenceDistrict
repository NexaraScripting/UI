-- ======== FOV CONTROLLER & FLASHLIGHT (NO ZOOMING, 100% STEADY) ========
-- Silence SmoothCamera from constantly pulling FOV to 70 and stop flashlight from zooming!
local fovCtrl = nil
task.spawn(function()
pcall(function()
    local modFolder = ReplicatedStorage:WaitForChild("Modules", 5)
    local fovMod = modFolder and modFolder:WaitForChild("FOVController", 5)
    fovCtrl = fovMod and require(fovMod)
    if fovCtrl then
        if not fovCtrl._nexara_orig_Set then
            fovCtrl._nexara_orig_Set = fovCtrl.Set
            fovCtrl._nexara_orig_Release = fovCtrl.Release
            fovCtrl._nexara_orig_IsOverrideActive = fovCtrl.IsOverrideActive
            fovCtrl._nexara_orig_IsTweening = fovCtrl.IsTweening
        end
        local origSet = fovCtrl._nexara_orig_Set
        local origRelease = fovCtrl._nexara_orig_Release
        local origIsOverrideActive = fovCtrl._nexara_orig_IsOverrideActive
        local origIsTweening = fovCtrl._nexara_orig_IsTweening

        -- Tell SmoothCamera that override is active so it never fights FOV
        fovCtrl.IsOverrideActive = function(self)
            if Config.CustomFOVEnabled then return true end
            if origIsOverrideActive then return origIsOverrideActive(self) end
            return false
        end
        fovCtrl.IsTweening = function(self)
            if Config.CustomFOVEnabled then return false end
            if origIsTweening then return origIsTweening(self) end
            return false
        end

        -- Flashlight calls Set(73, 0.3) when aiming: NO ZOOMING! Keep camera steady!
        fovCtrl.Set = function(self, targetFov, dur, style, dir)
            if Config.CustomFOVEnabled then
                -- Keep camera FOV steady at user custom FOV
            else
                if origSet then origSet(self, targetFov, dur, style, dir) end
            end
        end

        -- Flashlight calls Release(0.5): restore custom FOV smoothly
        fovCtrl.Release = function(self, dur, style, dir)
            if Config.CustomFOVEnabled then
                Camera.FieldOfView = Config.FOV
            else
                if origRelease then origRelease(self, dur, style, dir) end
            end
        end
    end
end)
end)

-- ======== LOBBY & TEAM HELPERS ========
local function GetCharacter(plr)
    return (plr or LocalPlayer).Character
end

local function GetRoot(plr)
    local char = GetCharacter(plr)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end

local cachedLobbyPart = nil
local function GetLobbyPart()
    if cachedLobbyPart and cachedLobbyPart.Parent then return cachedLobbyPart end
    local lobby = Workspace:FindFirstChild("Lobby")
    if lobby then
        local house = lobby:FindFirstChild("House")
        if house then
            cachedLobbyPart = house:FindFirstChildWhichIsA("BasePart", true)
        end
        if not cachedLobbyPart then
            cachedLobbyPart = lobby:FindFirstChildWhichIsA("SpawnLocation", true) or lobby:FindFirstChildWhichIsA("BasePart", true)
        end
    end
    return cachedLobbyPart
end

local CachedTimerLabel = nil
local function GetMatchTimerLabel()
    if CachedTimerLabel and CachedTimerLabel.Parent then
        return CachedTimerLabel
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, guiName in ipairs({"Spectator", "InGame", "HUD", "Survivor", "Killer"}) do
        local g = pg:FindFirstChild(guiName)
        if g then
            local tf = g:FindFirstChild("time") or g:FindFirstChild("Time") or g:FindFirstChild("Timer")
            if tf then
                local tl = tf:FindFirstChild("TimerLabel") or tf:FindFirstChildOfClass("TextLabel")
                if tl then
                    CachedTimerLabel = tl
                    return tl
                end
            end
        end
    end
    return nil
end

local function IsMatchTimerZero()
    local tl = GetMatchTimerLabel()
    if tl and tl.Parent then
        local txt = tl.Text
        return (txt == "00:00" or txt == "0:00")
    end
    return false
end

local cachedInLobby = false
local lastInLobbyCheck = 0

local function IsInLobby()
    local now = os.clock()
    if now - lastInLobbyCheck < 0.2 then
        return cachedInLobby
    end
    lastInLobbyCheck = now

    -- 1. Check physical proximity to Lobby (Fastest & 100% reliable - 0ms delay on round end teleport)
    local myRoot = GetRoot(LocalPlayer)
    local lobbyPart = GetLobbyPart()
    if myRoot and lobbyPart then
        local distToLobby = (myRoot.Position - lobbyPart.Position).Magnitude
        if distToLobby <= 350 then
            cachedInLobby = true
            return true
        end
    end

    -- 2. Check Match Timer: 00:00 means match has completed
    if IsMatchTimerZero() then
        cachedInLobby = true
        return true
    end

    -- 3. Check Map folder contents (In match, Map has children; in lobby, map is missing or empty)
    local map = Workspace:FindFirstChild("Map")
    if not map or not map:FindFirstChildWhichIsA("Instance") then
        cachedInLobby = true
        return true
    end

    -- 4. Check LocalPlayer's Team fallback
    local team = LocalPlayer.Team
    if team then
        if team.Name == "Killer" or team.Name == "Survivors" then
            cachedInLobby = false
            return false
        end
    end

    cachedInLobby = false
    return false
end

local function IsPlayerDead(player)
    if not player or not player.Parent then return true end
    local char = player.Character
    if not char or not char.Parent then return true end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and (hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead) then
        return true
    end

    if player:GetAttribute("IsDead") == true or char:GetAttribute("IsDead") == true or
       player:GetAttribute("Dead") == true or char:GetAttribute("Dead") == true or
       player:GetAttribute("Sacrificed") == true or char:GetAttribute("Sacrificed") == true or
       player:GetAttribute("Died") == true or char:GetAttribute("Died") == true or
       player:GetAttribute("Eliminated") == true or char:GetAttribute("Eliminated") == true or
       player:GetAttribute("BledOut") == true or char:GetAttribute("BledOut") == true then
        return true
    end

    if char:FindFirstChild("Died") or char:FindFirstChild("Ragdoll") then
        return true
    end

    if CollectionService and (CollectionService:HasTag(char, "Dead") or CollectionService:HasTag(char, "Sacrificed")) then
        return true
    end

    return false
end

local function IsPlayerInLobby(player)
    if not player or not player.Parent then return false end
    if player == LocalPlayer then return IsInLobby() end

    -- 1. If LocalPlayer is in lobby, everyone is in lobby
    if IsInLobby() then
        return true
    end

    -- 2. Dead players are out of the active round (dead or sent back to lobby)
    if IsPlayerDead(player) then
        return true
    end

    -- 3. Check explicit lobby attributes
    if player:GetAttribute("InLobby") == true or (player.Character and player.Character:GetAttribute("InLobby") == true) or
       player:GetAttribute("Spectating") == true or (player.Character and player.Character:GetAttribute("Spectating") == true) or
       player:GetAttribute("WaitingInLobby") == true then
        return true
    end

    -- 4. Check Team (In an active match, match participants are in 'Survivors' or 'Killer')
    if player.Team then
        local tName = player.Team.Name
        if tName == "Lobby" or tName == "Spectator" or tName == "Spectators" or tName == "Choosing" then
            return true
        end
        if tName ~= "Killer" and tName ~= "Survivors" then
            return true
        end
    end

    local root = GetRoot(player)
    if not root then return true end

    -- 5. Check physical proximity to the Lobby structure
    local lobbyPart = GetLobbyPart()
    if lobbyPart then
        local distToLobby = (root.Position - lobbyPart.Position).Magnitude
        if distToLobby <= 350 then
            return true
        end
    end

    -- 6. Match distance check: in Violence District, the lobby island is >320 studs away from the match map
    local myRoot = GetRoot(LocalPlayer)
    if myRoot then
        local distFromMe = (root.Position - myRoot.Position).Magnitude
        if distFromMe >= 320 then
            if lobbyPart then
                local distToLobby = (root.Position - lobbyPart.Position).Magnitude
                if distToLobby <= 450 then
                    return true
                end
            else
                return true
            end
        end
    end

    return false
end

local function IsCutsceneActive()
    -- 1. Camera mode check (Any cinematic, intro, mori, or round-end animation switches Camera to Scriptable)
    local cam = Workspace.CurrentCamera or Camera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        return true
    end

    -- 2. Local character mori / cutscene / dead attributes
    local myChar = LocalPlayer.Character
    if myChar then
        if myChar:GetAttribute("Mori") == true or myChar:GetAttribute("IsMori") == true or
           myChar:GetAttribute("Cutscene") == true or myChar:GetAttribute("InCutscene") == true or
           LocalPlayer:GetAttribute("InCutscene") == true or LocalPlayer:GetAttribute("Cutscene") == true then
            return true
        end
    end

    -- 3. Check PlayerGui for cutscene / cinematic / black bars GUIs
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, name in ipairs({"Cutscene", "Cutscenes", "Cinematic", "Cinematics", "Intro", "Ending", "Outro", "Mori", "BlackBars", "Letterbox", "Bars", "CinematicBars"}) do
            local g = pg:FindFirstChild(name)
            if g and ((g:IsA("ScreenGui") and g.Enabled) or (g:IsA("GuiObject") and g.Visible)) then
                return true
            end
        end

        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled and g.Name ~= "NexaraStudio" and g.Name ~= "Nexara_ScreenGui" then
                local gName = g.Name:lower()
                if gName:find("cutscene") or gName:find("cinematic") or gName:find("intro") or gName:find("mori") then
                    return true
                end
                local topBar = g:FindFirstChild("TopBar") or g:FindFirstChild("Top") or g:FindFirstChild("Bar1")
                local btmBar = g:FindFirstChild("BottomBar") or g:FindFirstChild("Bottom") or g:FindFirstChild("Bar2")
                if topBar and btmBar and topBar:IsA("GuiObject") and btmBar:IsA("GuiObject") and topBar.Visible and btmBar.Visible then
                    if topBar.BackgroundColor3 == Color3.new(0, 0, 0) or topBar.BackgroundTransparency < 0.5 then
                        return true
                    end
                end
            end
        end

        -- 4. Match HUD check: if in match (Map folder populated) but all in-game HUDs are disabled, round is in cinematic
        local map = Workspace:FindFirstChild("Map")
        if map and #map:GetChildren() >= 10 then
            local survivorGui = pg:FindFirstChild("Survivor")
            local killerGui = pg:FindFirstChild("Killer")
            local hudGui = pg:FindFirstChild("HUD") or pg:FindFirstChild("InGame")
            local hasHud = (survivorGui or killerGui or hudGui)
            local anyHudEnabled = (survivorGui and survivorGui.Enabled) or (killerGui and killerGui.Enabled) or (hudGui and hudGui.Enabled)
            if hasHud and not anyHudEnabled then
                return true
            end
        end
    end

    return false
end

local function IsKiller(player)
    if not player then return false end
    if IsInLobby() or IsPlayerInLobby(player) or IsPlayerDead(player) then return false end
    if player.Team then
        if player.Team.Name == "Killer" then return true end
        if player.Team.Name == "Survivors" then return false end
    end
    local char = player.Character
    if char then
        -- Veil
        if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") or char:GetAttribute("Spears") then
            return true
        end
        -- Cure
        if char:FindFirstChild("Curetool") or char:FindFirstChild("Flask") or char:GetAttribute("corpsecharge") then
            return true
        end
        -- Stalker
        if char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") or char:GetAttribute("StalkStage") or char:GetAttribute("IsStalking") then
            return true
        end
        -- Hidden
        if char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") or char:GetAttribute("invisible") then
            return true
        end
        -- Slasher
        if char:FindFirstChild("Katana") or char:FindFirstChild("Sword") then
            return true
        end
        -- Masked
        if char:GetAttribute("Mask") or char:GetAttribute("MaskExpired") then
            return true
        end
        -- Abysswalker
        if char:FindFirstChild("Abysswalker") then
            return true
        end
        -- Generic Killer attributes
        if char:GetAttribute("BloodLust") or char:GetAttribute("IsCarrying") or char:GetAttribute("Carrying") then
            return true
        end
        if char:GetAttribute("SelectedKiller") then
            return true
        end
    end
    return false
end

