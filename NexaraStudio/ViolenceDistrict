end

local KillerPowerIconCache = {}
local function GetKillerPowerIcon(kName)
    if not kName then return nil end
    local clean = tostring(kName):lower():gsub("%s+", ""):gsub("[^%a]", "")
    if clean:sub(1, 3) == "the" and #clean > 3 then clean = clean:sub(4) end
    if KillerPowerIcons[kName] then return KillerPowerIcons[kName] end
    for k, v in pairs(KillerPowerIcons) do
        if k:lower() == clean then return v end
    end
    if KillerPowerIconCache[clean] then return KillerPowerIconCache[clean] end

    local rs = game:GetService("ReplicatedStorage")
    if rs:FindFirstChild("Killers") then
        local kFolder = rs.Killers:FindFirstChild(kName) or rs.Killers:FindFirstChild("The " .. kName)
        if not kFolder then
            for _, kf in ipairs(rs.Killers:GetChildren()) do
                if kf.Name:lower():gsub("%s+", ""):gsub("[^%a]", "") == clean then
                    kFolder = kf
                    break
                end
            end
        end
        if kFolder and kFolder:FindFirstChild("Frame") then
            for _, c in ipairs(kFolder.Frame:GetDescendants()) do
                if (c:IsA("ImageLabel") or c:IsA("ImageButton")) and c.Image ~= "" and not c.Image:find("Placeholder") and not c.Image:find("8012052454") and not c.Image:find("13662414759") then
                    if not (c.Name:lower():find("icon") or c.Name:lower():find("portrait") or c.Name:lower():find("head") or c.Name == "Background") then
                        KillerPowerIconCache[clean] = c.Image
                        return c.Image
                    end
                end
            end
        end
    end

    return nil
end

