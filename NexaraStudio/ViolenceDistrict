    if IsRestoringConfig then return end
    pcall(function()
        if not writefile or not Window or not Window.ConfigValues then return end
        local hs = game:GetService("HttpService")
        local prof = Window.ConfigValues["SelectedConfigName"] or ActiveConfigProfile or "Default"
        if prof == "" then prof = "Default" end
        local data = {}
        for k, v in pairs(Window.ConfigValues) do
            data[k] = v
        end
        if Window.ToggleKey and Window.ToggleKey.Name then
            data["_ToggleKey"] = Window.ToggleKey.Name
        end
        if Window.Theme and Window.Theme.Accent then
            data["_AccentR"] = math.floor(Window.Theme.Accent.R * 255)
            data["_AccentG"] = math.floor(Window.Theme.Accent.G * 255)
            data["_AccentB"] = math.floor(Window.Theme.Accent.B * 255)
        end
        writefile(ConfigDirName .. "/" .. prof .. ".json", hs:JSONEncode(data))
    end)
end

