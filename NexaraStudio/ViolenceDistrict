        local str = tostring(rawName):lower()
        str = str:gsub("^perk%d*[_%s]*", ""):gsub("^slot%d*[_%s]*", ""):gsub("^p%d*[_%s]*", "")
        str = str:gsub("[_%s]*tier[%s%d]*$", ""):gsub("[_%s]*t%d+$", ""):gsub("[_%s]*lvl[%s%d]*$", ""):gsub("[_%s]*active$", ""):gsub("[_%s]*cooldown$", ""):gsub("[_%s]*cd$", ""):gsub("[_%s]*proc$", ""):gsub("%d+$", "")
        local clean = str:gsub("%s+", ""):gsub("[^%a]", "")
        if #clean < 3 then return nil end
        if StatusToPerkMap[clean] then return StatusToPerkMap[clean] end
        if targetNorm[clean] then return targetNorm[clean] end
        if otherNorm[clean] then return otherNorm[clean] end
        for k, v in pairs(targetNorm) do
            if clean == k or clean:find(k, 1, true) or (#clean >= 5 and k:find(clean, 1, true)) then
                return v
            end
        end
        for k, v in pairs(otherNorm) do
            if clean == k or clean:find(k, 1, true) or (#clean >= 5 and k:find(clean, 1, true)) then
                return v
            end
        end
        return nil
    end

    local function addPerk(rawPerk, defaultTier)
        if not rawPerk or #perks >= 3 then return end
        local pName = nil
        local pTier = defaultTier or 3
        if type(rawPerk) == "table" then
            pName = rawPerk.name or rawPerk.Name or rawPerk.perk or rawPerk.Perk or rawPerk.perkName or rawPerk.PerkName or rawPerk.id or rawPerk.ID or rawPerk[1]
            pTier = rawPerk.tier or rawPerk.Tier or rawPerk.level or rawPerk.Level or rawPerk.lvl or rawPerk.Lvl or rawPerk[2] or pTier
        elseif type(rawPerk) == "string" then
            pName = rawPerk
        end
        if pName and type(pName) == "string" and pName ~= "" and pName ~= "---" and pName ~= "None" then
            local mapped = matchPerkName(pName) or targetNorm[pName:lower():gsub("%s+", ""):gsub("[^%a]", "")]
            if mapped and mapped ~= "" and not table.find(perks, mapped) and #perks < 3 then
                table.insert(perks, mapped)
                PlayerPerkTiers[player] = PlayerPerkTiers[player] or {}
                PlayerPerkTiers[player][mapped] = tonumber(pTier) or 3
            end
        end
    end

    local rs = game:GetService("ReplicatedStorage")
    local rem = rs:FindFirstChild("Remotes")

    -- 1. Local Player: query authoritative server remotes for exact equipped slots
    if player == LocalPlayer then
        local remoteDone = false
        if isK then
            local sk = rem and rem:FindFirstChild("ShopKillers")
            local getKiller = sk and sk:FindFirstChild("GetEquippedKillerPerks")
            local kType = player:GetAttribute("SelectedKiller") or "Veil"
            if getKiller then
                pcall(function()
                    local res = getKiller:InvokeServer(kType)
                    if type(res) == "table" then
                        remoteDone = true
                        for _, slot in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "Perk1", "Perk2", "Perk3", 1, 2, 3}) do
                            if res[slot] then addPerk(res[slot]) end
                        end
                        for _, val in pairs(res) do
                            addPerk(val)
                        end
                    end
                end)
            end
        else
            local shop = rem and rem:FindFirstChild("Shop")
            local getSurv = shop and shop:FindFirstChild("GetEquippedPerks")
            if getSurv then
                pcall(function()
                    local res = getSurv:InvokeServer()
                    if type(res) == "table" then
                        remoteDone = true
                        for _, slot in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "Perk1", "Perk2", "Perk3", 1, 2, 3}) do
                            if res[slot] then addPerk(res[slot]) end
                        end
                        for _, p in pairs(res) do
                            addPerk(p)
                        end
                    end
                end)
            end
            if not remoteDone and player:FindFirstChild("PlayerGui") then
                local sp = player.PlayerGui:FindFirstChild("SurvivorPerks")
                local pFolder = sp and (sp:FindFirstChild("Perks") or sp:FindFirstChild("Perkspc"))
                if pFolder then
                    for _, c in ipairs(pFolder:GetChildren()) do
                        if c:IsA("ImageLabel") and c.Name ~= "cdviz" and c.Name ~= "bg" and not c.Name:find("UI") then
                            local mapped = matchPerkName(c.Name)
                            if mapped then addPerk(mapped) end
                        end
                    end
                end
            end
        end

        -- If server returned authoritative loadout, DO NOT run arbitrary descendant scraping!
        -- Respects players who equipped only 1 or 2 perks.
        if remoteDone or #perks > 0 then
            PersistentPerksCache[player] = perks
            return perks
        end
    end

    -- 2. Other Players (or fallback if LocalPlayer remote failed): Look for explicit perks & loadouts
    local char = player.Character

    -- A. Check explicit slot attributes (perk1, perk2, perk3, Slot1, Slot2, Slot3)
    for _, slotKey in ipairs({"perk1", "perk2", "perk3", "Slot1", "Slot2", "Slot3", "Perk1", "Perk2", "Perk3", "p1", "p2", "p3"}) do
        local val = player:GetAttribute(slotKey) or (char and char:GetAttribute(slotKey))
        if val and type(val) == "string" and val ~= "" and val ~= "None" then
            local mapped = matchPerkName(val)
            if mapped then addPerk(mapped) end
        end
    end

    -- B. Check dedicated Perks / EquippedPerks container
    local pFolders = {
        player:FindFirstChild("Perks"),
        player:FindFirstChild("EquippedPerks"),
        player:FindFirstChild("SelectedPerks"),
        char and char:FindFirstChild("Perks"),
        char and char:FindFirstChild("EquippedPerks"),
    }
    for _, f in ipairs(pFolders) do
        if f then
            for _, c in ipairs(f:GetChildren()) do
                local mapped = matchPerkName(c.Name)
                local t = c:IsA("ValueBase") and tonumber(c.Value) or 3
                if mapped then
                    addPerk(mapped, t)
                elseif c:IsA("ValueBase") and c.Value then
                    local vMapped = matchPerkName(tostring(c.Value))
                    if vMapped then addPerk(vMapped, 3) end
                end
            end
        end
    end

    -- C. Direct attributes on character or player matching exact perk names or status effects
    local function scanDirectAttrs(inst)
        if not inst then return end
        local attrs = nil
        pcall(function() attrs = inst:GetAttributes() end)
        if not attrs then return end
        for attrName, attrVal in pairs(attrs) do
            if #perks >= 3 then break end
            local mapped = matchPerkName(attrName)
            if mapped and (attrVal == true or (type(attrVal) == "number" and attrVal > 0) or type(attrVal) == "string") then
                addPerk(mapped, type(attrVal) == "number" and attrVal or 3)
            end
        end
    end
    scanDirectAttrs(char)
    scanDirectAttrs(player)

    -- D. Check ReplicatedStorage player data container
    local pData = rs:FindFirstChild(player.Name) or (rs:FindFirstChild("PlayerData") and rs.PlayerData:FindFirstChild(player.Name)) or (rs:FindFirstChild("Players") and rs.Players:FindFirstChild(player.Name))
    if pData then
        local pf = pData:FindFirstChild("Perks") or pData:FindFirstChild("EquippedPerks")
        if pf then
            for _, c in ipairs(pf:GetChildren()) do
                local mapped = matchPerkName(c.Name) or (c:IsA("ValueBase") and matchPerkName(tostring(c.Value)))
                if mapped then addPerk(mapped) end
            end
        end
    end

    -- E. Accumulate in PersistentPerksCache (never overwrite/drop perks detected during match)
    PersistentPerksCache[player] = PersistentPerksCache[player] or {}
    for _, p in ipairs(perks) do
        if not table.find(PersistentPerksCache[player], p) and #PersistentPerksCache[player] < 3 then
            table.insert(PersistentPerksCache[player], p)
        end
    end

    if #PersistentPerksCache[player] > 0 then
        return PersistentPerksCache[player]
    end

    return perks
end

-- SEPARATE SKILLS, CHARGES & COOLDOWNS
local function GetPlayerSkillInfo(player)
    if not player or not player.Character then return nil end
    if IsPlayerDead(player) or (not IsInLobby() and IsPlayerInLobby(player)) then return nil end
    local char = player.Character
    if IsKiller(player) then
        local kName = player:GetAttribute("SelectedKiller") or (char and char:GetAttribute("SelectedKiller")) or "Killer"
        if char then
            if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") then
                kName = "Veil"
            elseif char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") or char:GetAttribute("corpsecharge") then
                kName = "Cure"
            elseif char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") then
                kName = "Hidden"
            elseif char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") then
                kName = "Stalker"
            elseif char:FindFirstChild("Katana") or char:FindFirstChild("Sword") then
                kName = "Slasher"
            end
        end
        local skillEntries = {}
        local extras = {}

        if kName == "Cure" or char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") then
            -- Skill 1: Plague Flask (15s CD)
            local flaskCD = math.max(0, math.ceil(CureFlaskCooldownEnd - os.clock()))
            local flaskStatus = flaskCD > 0 and ("CD " .. flaskCD .. "s") or "Ready"
            table.insert(skillEntries, "Plague Flask [" .. flaskStatus .. "]")

            -- Skill 2: Corpse Syringe (0-3 zombies)
            local corpses = tonumber(char:GetAttribute("corpsecharge")) or 0
            table.insert(skillEntries, "Corpse Syringe [" .. tostring(corpses) .. "/3 Zombies]")

        elseif kName == "Veil" or char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") then
            local isAiming = char:GetAttribute("spearmode") == true
            local isHoldingThrow = false
            local isFullyCharged = false

            -- Check animation tracks on killer to detect charging / holding throw (exact numeric IDs from game)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = {}
            if animator then
                pcall(function()
                    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            if hum and #tracks == 0 then
                pcall(function()
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            for _, track in ipairs(tracks) do
                local aName = (track.Animation and track.Animation.Name or ""):lower()
                local aId = (track.Animation and track.Animation.AnimationId or ""):lower()
                if aId:find("138045669415653") or aId:find("137688077908355") or aName:find("spearlunge.*op") or aName:find("1op") or aName:find("2op") then
                    isFullyCharged = true
                    break
                elseif aId:find("92098503722633") or aId:find("84093948968516") or aName:find("spearlunge") then
                    isHoldingThrow = true
                end
            end

            -- Detect particles on physical spear model in hand (enabled when holding >= 2s)
            if not isFullyCharged then
                for _, spName in ipairs({"Spear1", "Spear2"}) do
                    local sp = char:FindFirstChild(spName)
                    local hb = sp and sp:FindFirstChild("Hitbox")
                    if hb then
                        for _, pe in ipairs(hb:GetChildren()) do
                            if pe:IsA("ParticleEmitter") and pe.Enabled then
                                isFullyCharged = true
                                break
                            end
                        end
                    end
                    if isFullyCharged then break end
                end
            end

            local spears = tonumber(char:GetAttribute("Spears"))
            if spears == nil then spears = 2 end

            -- Animation & Spear Drop State Machine (triggers instantly when charged spear leaves hand)
            if isFullyCharged then
                LastVeilWasCharged = true
            end
            if spears < LastVeilSpears then
                if (VeilSpearCooldownEnd - os.clock()) <= 0 then
                    VeilSpearCooldownEnd = os.clock() + 15
                end
                if LastVeilWasCharged or isFullyCharged then
                    VeilVoidCooldownEnd = os.clock() + 30
                    LastVeilWasCharged = false
                end
                LastVeilSpears = spears
            elseif spears > LastVeilSpears then
                LastVeilSpears = spears
                if spears < 2 then
                    VeilSpearCooldownEnd = os.clock() + 15
                else
                    VeilSpearCooldownEnd = 0
                end
            end
            if not isAiming and not isHoldingThrow and not isFullyCharged and (VeilVoidCooldownEnd - os.clock()) <= 0 then
                LastVeilWasCharged = false
            end

            -- Skill 1: Spear (2 max, 15s recharge per spear)
            local spearCD = math.max(0, math.ceil(VeilSpearCooldownEnd - os.clock()))
            local spearStatus = tostring(spears) .. "/2"
            if spears < 2 and spearCD > 0 then
                spearStatus = tostring(spears) .. "/2 (CD " .. spearCD .. "s)"
            else
                spearStatus = tostring(spears) .. "/2 Ready"
            end
            if isAiming then spearStatus = spearStatus .. " [Aiming]" end
            table.insert(skillEntries, "Spear [" .. spearStatus .. "]")

            -- Skill 2: Echo Void / Through the Veil (30s cooldown, requires holding throw >= 2s)
            local voidCD = math.max(0, math.ceil(VeilVoidCooldownEnd - os.clock()))
            local voidStatus = "Ready"
            if voidCD > 0 then
                voidStatus = "CD " .. voidCD .. "s"
            elseif isFullyCharged then
                voidStatus = "[CHARGED!]"
            elseif isHoldingThrow then
                voidStatus = "[Charging...]"
            end
            table.insert(skillEntries, "Echo Void [" .. voidStatus .. "]")

        elseif kName == "Hidden" then
            -- Real-time animations and velocity triggers for The Hidden
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = {}
            if animator then
                pcall(function()
                    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            if hum and #tracks == 0 then
                pcall(function()
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end

            local isLeapingAnim = false
            local isM2Anim = false
            for _, t in ipairs(tracks) do
                local aId = (t.Animation and t.Animation.AnimationId or ""):lower()
                local aNm = (t.Animation and t.Animation.Name or ""):lower()
                if aId:find("109928123357793") or aId:find("82153811221085") or aNm:find("jump") then
                    isLeapingAnim = true
                elseif aId:find("98163597193511") or aId:find("114699370608778") or aNm:find("m2") then
                    isM2Anim = true
                end
            end

            if root and root.AssemblyLinearVelocity then
                local vel = root.AssemblyLinearVelocity
                local horizVel = Vector3.new(vel.X, 0, vel.Z).Magnitude
                if (horizVel > 45 and vel.Y > 12) or isLeapingAnim then
                    if (HiddenLeapCooldownEnd - os.clock()) <= 0 then
                        HiddenLeapCooldownEnd = os.clock() + 25
                    end
                end
                if horizVel > 110 or isM2Anim or char:FindFirstChild("TempHitbox") then
                    if (HiddenMarkCooldownEnd - os.clock()) <= 0 then
                        HiddenMarkCooldownEnd = os.clock() + 17
                    end
                end
            end

            -- Skill 1: Shadow Leap (25s CD)
            local leapCD = math.max(0, math.ceil(HiddenLeapCooldownEnd - os.clock()))
            local leapStatus = leapCD > 0 and ("CD " .. leapCD .. "s") or "Ready"
            table.insert(skillEntries, "Shadow Leap [" .. leapStatus .. "]")

            -- Skill 2: Mark (17s CD)
            local markCD = math.max(0, math.ceil(HiddenMarkCooldownEnd - os.clock()))
            local markStatus = "Ready"
            if markCD > 0 then
                markStatus = "CD " .. markCD .. "s"
            elseif char:GetAttribute("preparem2") or char:GetAttribute("M2") then
                markStatus = "[AIMING!]"
            end
            table.insert(skillEntries, "Mark [" .. markStatus .. "]")

            if char:GetAttribute("invisible") or (char:FindFirstChild("Head") and char.Head.Transparency > 0.4) then
                table.insert(extras, "[INVISIBLE]")
            end

        elseif kName == "Slasher" then
            -- Skill 1: Lake Mist (80s CD)
            local mistCD = math.max(0, math.ceil(SlasherMistCooldownEnd - os.clock()))
            table.insert(skillEntries, "Lake Mist [" .. (mistCD > 0 and ("CD " .. mistCD .. "s") or "Ready") .. "]")

            -- Skill 2: Pursuit (80s CD)
            local pursuitCD = math.max(0, math.ceil(SlasherPursuitCooldownEnd - os.clock()))
            table.insert(skillEntries, "Pursuit [" .. (pursuitCD > 0 and ("CD " .. pursuitCD .. "s") or "Ready") .. "]")

        elseif kName == "Stalker" then
            -- Skill 1: Stalk Mode
            local stage = char:GetAttribute("StalkStage") or char:GetAttribute("EvolveStage") or 1
            local stalkStatus = char:GetAttribute("IsStalking") and "[STALKING]" or ("Stage " .. tostring(stage))
            table.insert(skillEntries, "Stalk Mode [" .. stalkStatus .. "]")

            -- Skill 2: Evil's Grasp (25s CD)
            local graspCD = math.max(0, math.ceil(StalkerGraspCooldownEnd - os.clock()))
            table.insert(skillEntries, "Evil's Grasp [" .. (graspCD > 0 and ("CD " .. graspCD .. "s") or "Ready") .. "]")

        elseif kName == "Masked" then
            -- Skill 1: Mask Up (30s CD)
            local swapCD = math.max(0, math.ceil(MaskedSwapCooldownEnd - os.clock()))
            table.insert(skillEntries, "Mask Up [" .. (swapCD > 0 and ("CD " .. swapCD .. "s") or "Ready") .. "]")

            -- Skill 2: Frenzy Dash (20s CD)
            local dashCD = math.max(0, math.ceil(MaskedDashCooldownEnd - os.clock()))
            local dashStatus = dashCD > 0 and ("CD " .. dashCD .. "s") or (char:GetAttribute("Dash") and "[DASHING!]" or "Ready")
            table.insert(skillEntries, "Frenzy Dash [" .. dashStatus .. "]")

        elseif kName == "Abysswalker" then
            -- Skill 1: Dark Severance (15s CD)
            local slashCD = math.max(0, math.ceil(AbyssSlashCooldownEnd - os.clock()))
            table.insert(skillEntries, "Dark Severance [" .. (slashCD > 0 and ("CD " .. slashCD .. "s") or "Ready") .. "]")

            -- Skill 2: Abyssal Burst (25s CD)
            local burstCD = math.max(0, math.ceil(AbyssBurstCooldownEnd - os.clock()))
            table.insert(skillEntries, "Abyssal Burst [" .. (burstCD > 0 and ("CD " .. burstCD .. "s") or "Ready") .. "]")

        elseif kName == "Killer" or kName == "The Killer" then
            -- Skill 1: Frenzy Sprint (20s CD)
            local frenzyCD = math.max(0, math.ceil(KillerFrenzyCooldownEnd - os.clock()))
            table.insert(skillEntries, "Frenzy Sprint [" .. (frenzyCD > 0 and ("CD " .. frenzyCD .. "s") or "Ready") .. "]")

            -- Skill 2: Bear Trap
            table.insert(skillEntries, "Bear Trap [Ready]")

        else
            table.insert(skillEntries, kName .. " Skill 1 [Ready]")
            table.insert(skillEntries, kName .. " Skill 2 [Ready]")
        end

        local bl = tonumber(char:GetAttribute("BloodLust")) or 0
        if bl > 0 then table.insert(extras, "Bloodlust T" .. bl) end

        if char:GetAttribute("IsStunned") == true then table.insert(extras, "[STUNNED]") end
        if char:GetAttribute("IsCarrying") == true then table.insert(extras, "[CARRYING]") end

        local str = "[SKILL] " .. table.concat(skillEntries, "  |  ")
        if #extras > 0 then
            str = str .. "  |  " .. table.concat(extras, " | ")
        end
        return str
    else
        -- Survivor item, charges, cooldowns, status
        local details = {}
        
        -- 1. Determine Item Name (Check attributes, character children, backpack, and persistent cache)
        local item = player:GetAttribute("EquippedItem") or (char and char:GetAttribute("EquippedItem"))
            or player:GetAttribute("SelectedItem") or (char and char:GetAttribute("SelectedItem"))
            or player:GetAttribute("Item") or (char and char:GetAttribute("Item"))
        local bp = player:FindFirstChild("Backpack")

        local function scanContainer(container)
            if not container then return nil end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Model") or c:IsA("Tool") then
                    local nm = c.Name
                    if ItemIcons[nm] or nm == "Parrying Dagger" or nm == "Adrenaline Shot" or nm == "Flashlight" or nm == "Holy Water" or nm == "Riot Shield" or nm == "Gate" or nm == "WaxBound Candle" or nm == "Shadow Clone" or nm == "Twist of Fate" or nm:find("Syringe") or nm:find("Medkit") or nm == "Bandage" or nm == "Motion Tracker" then
                        return nm
                    end
                end
            end
            for _, c in ipairs(container:GetChildren()) do
                if c:IsA("Tool") and not c.Name:lower():find("fist") and not c.Name:lower():find("camera") and not c.Name:lower():find("phone") then
                    return c.Name
                end
            end
            return nil
        end

        if not item or item == "None" or item == "" then
            item = scanContainer(char) or scanContainer(bp)
        end
        if not item or item == "None" or item == "" then
            local ev = player:FindFirstChild("EquippedItem") or (char and char:FindFirstChild("EquippedItem"))
                or player:FindFirstChild("Item") or (char and char:FindFirstChild("Item"))
            if ev and (ev:IsA("StringValue") or ev:IsA("ObjectValue")) and ev.Value then
                item = typeof(ev.Value) == "Instance" and ev.Value.Name or tostring(ev.Value)
            end
        end
        if item and item ~= "None" and item ~= "" then
            PlayerItemCache[player] = item
        elseif not IsInLobby() and PlayerItemCache[player] then
            item = PlayerItemCache[player]
        end

        local isItemReady = true
        if item and item ~= "None" and item ~= "" then
            local itemInst = char:FindFirstChild(item) or (bp and bp:FindFirstChild(item))
            if not itemInst then
                for _, c in ipairs(char:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end
            if not itemInst and bp then
                for _, c in ipairs(bp:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end

            local uses = itemInst and (itemInst:GetAttribute("uses") or itemInst:GetAttribute("Uses") or itemInst:GetAttribute("charges") or itemInst:GetAttribute("Charges") or itemInst:GetAttribute("charge") or itemInst:GetAttribute("Charge"))
            local maxUses = itemInst and (itemInst:GetAttribute("MaxUses") or itemInst:GetAttribute("maxUses") or itemInst:GetAttribute("MaxCharges") or itemInst:GetAttribute("maxCharges"))
            local rem = itemInst and (itemInst:GetAttribute("remaining") or itemInst:GetAttribute("Remaining"))

            local qtyStr = ""
            if uses and tonumber(uses) then
                if item == "Bandage" or item:find("Bandage") then
                    local pct = math.clamp(math.floor((tonumber(uses) / 20.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif maxUses and tonumber(maxUses) then
                    qtyStr = string.format(" [%d/%d]", tonumber(uses), tonumber(maxUses))
                else
                    qtyStr = string.format(" [%d uses]", tonumber(uses))
                end
            elseif rem and tonumber(rem) then
                local remNum = tonumber(rem)
                if item == "Flashlight" or item:find("Flashlight") then
                    local pct = math.clamp(math.floor((remNum / 16.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif remNum > 0 then
                    qtyStr = string.format(" (%.1fs)", remNum)
                end
            end

            local cdSec = GetItemCooldown(player, item)
            local itemStr = "Item: " .. item .. qtyStr

            if cdSec > 0 then
                isItemReady = false
                itemStr = itemStr .. string.format(" (CD %ds)", cdSec)
            elseif (rem and tonumber(rem) and tonumber(rem) <= 0) or (uses and tonumber(uses) and tonumber(uses) <= 0) then
                isItemReady = false
                itemStr = itemStr .. " [Empty]"
            else
                isItemReady = true
            end
            table.insert(details, itemStr)
        else
            isItemReady = nil
        end

        if player == LocalPlayer then
            local debuff = player.PlayerGui:FindFirstChild("Survivor") and player.PlayerGui.Survivor:FindFirstChild("statuseffects") and player.PlayerGui.Survivor.statuseffects:FindFirstChild("Debuff")
            local winded = debuff and debuff:FindFirstChild("Winded")
            if winded and winded.Visible then table.insert(details, "Exhausted") end
        end

        -- Only show Wiggle if they are ACTUALLY being carried by the killer!
        local isCarried = char:GetAttribute("IsCarried") or char:GetAttribute("BeingCarried") or char:GetAttribute("IsBeingCarried")
        if isCarried then
            local carryTime = tonumber(char:GetAttribute("RemainingCarryTime"))
            if carryTime and carryTime > 0 then
                table.insert(details, string.format("Wiggling: %.1fs", carryTime))
            end
        end

        -- Only show Hook % if actually hooked
        local isHooked = char:GetAttribute("IsHooked") or char:GetAttribute("HookProgressDepleting")
        local hookProg = tonumber(char:GetAttribute("HookedProgress"))
        if isHooked and hookProg and hookProg < 100 then
            table.insert(details, string.format("Hook: %d%%", math.floor(hookProg)))
        end

        return (#details > 0 and table.concat(details, " | ") or nil), isItemReady
    end
end

-- ======== BACKGROUND DATA CACHING (PREVENTS ESP STUTTER & LAG) ========
local PruneDeadDrawings = nil
local CachedPlayerData = {}
local CachedGenerators = {}
local CachedPallets = {}
local CachedWindows = {}
local CachedGates = {}
local lastMapScan = 0

local function UpdateBackgroundCache()
    pcall(function()
        local inLobby = IsInLobby()
        local now = os.clock()
        
        -- Cache player perks and skills every 0.3s (fast iteration over players only)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if not inLobby and (IsPlayerDead(p) or IsPlayerInLobby(p)) then
                    CachedPlayerData[p] = nil
                    ClearPlayerCooldowns(p)
                else
                    local isK = IsKiller(p)
                    local perks = GetPlayerPerks(p)
                    local skill, isReady = GetPlayerSkillInfo(p)
                    CachedPlayerData[p] = {
                        IsKiller = isK,
                        Perks = perks,
                        SkillInfo = skill,
                        ItemReady = isReady,
                        DisplayName = p.DisplayName,
                    }
                end
            end
        end

        -- Clean up disconnected / dead / lobby players from cache
        for p in pairs(CachedPlayerData) do
            if not p or not p.Parent or (not inLobby and (IsPlayerDead(p) or IsPlayerInLobby(p))) then
                CachedPlayerData[p] = nil
            end
        end

        -- Map objects: only scan when in match, throttled to every 3.0s (saves 90% CPU overhead)
        if inLobby then
            if #CachedGenerators > 0 then table.clear(CachedGenerators) end
            if #CachedPallets > 0 then table.clear(CachedPallets) end
            if #CachedWindows > 0 then table.clear(CachedWindows) end
            if #CachedGates > 0 then table.clear(CachedGates) end
            if PruneDeadDrawings then PruneDeadDrawings() end
            return
        end

        if now - lastMapScan < 3.0 and #CachedGenerators > 0 then
            return
        end
        lastMapScan = now

        local map = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("map")
        local gens, pallets, windows, gates = {}, {}, {}, {}
        local winSeen = {}
        local genSeen = {}
        local palletSeen = {}

        -- 1. Universal Multi-Map Vault Detection: CollectionService tags
        pcall(function()
            local CollectionService = game:GetService("CollectionService")
            for _, tag in ipairs({"VaultPoint", "Vault", "Window", "VaultLedge", "VaultSpot", "WindowVault"}) do
                for _, vt in ipairs(CollectionService:GetTagged(tag)) do
                    local container = vt:IsA("Model") and vt or vt:FindFirstAncestorOfClass("Model") or vt.Parent
                    if container and container:IsA("Model") and not winSeen[container] then
                        winSeen[container] = true
                        local bottomPart = container:FindFirstChild("Bottom") or container:FindFirstChild("Ledge") or container:FindFirstChild("Sill")
                        local ledge = bottomPart
                        if not ledge then
                            for _, c in ipairs(container:GetChildren()) do
                                if c:IsA("BasePart") and not c.Name:lower():find("invis") and not c.Name:lower():find("trigger") and not c.Name:lower():find("collision") then
                                    ledge = c
                                    break
                                end
                            end
                        end
                        local part = ledge or (vt:IsA("BasePart") and vt) or container.PrimaryPart or container:FindFirstChildWhichIsA("BasePart")
                        if part then
                            ledge = ledge or part
                            if ledge.Transparency >= 0.99 then ledge.Transparency = 0.98 end
                            table.insert(windows, { Model = container, Part = part, VaultLedge = ledge })
                        end
                    end
                end
            end

            -- Universal Multi-Map Pallet Detection: CollectionService tags
            for _, tag in ipairs({"Pallet", "Pallets", "DroppablePallet", "InteractablePallet"}) do
                for _, p in ipairs(CollectionService:GetTagged(tag)) do
                    local model = p:IsA("Model") and p or p:FindFirstAncestorOfClass("Model") or p.Parent
                    if model and model:IsA("Model") and not palletSeen[model] then
                        if model:GetAttribute("Destroyed") ~= true and model:GetAttribute("Broken") ~= true then
                            palletSeen[model] = true
                            local part = model:FindFirstChild("PrimaryPartPallet") or model:FindFirstChild("Wood") or model:FindFirstChild("PalletWood") or model:FindFirstChild("Hitbox") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                            if part then table.insert(pallets, { Model = model, Part = part, PalletWood = model }) end
                        end
                    end
                end
            end

            -- Generators CollectionService tag
            for _, g in ipairs(CollectionService:GetTagged("Generator")) do
                if not genSeen[g] then
                    genSeen[g] = true
                    local part = g:FindFirstChild("RootPart") or g.PrimaryPart or g:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gens, { Model = g, Part = part }) end
                end
            end
        end)

        local searchRoots = {}
        if map then table.insert(searchRoots, map) end
        table.insert(searchRoots, Workspace)

        for _, rootObj in ipairs(searchRoots) do
            for _, d in ipairs(rootObj:GetDescendants()) do
                -- Generator detection
                if d:IsA("Model") and not genSeen[d] and (d.Name == "Generator" or d.Name:lower() == "generator" or d:GetAttribute("RepairProgress") ~= nil) then
                    genSeen[d] = true
                    local part = d:FindFirstChild("RootPart") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gens, { Model = d, Part = part }) end
                end

                -- Pallet detection across all maps (ignore crate containers, ignore destroyed pallets)
                if d:IsA("Model") and not palletSeen[d] then
                    local dName = d.Name:lower()
                    local pName = d.Parent and d.Parent.Name:lower() or ""
                    local isCrate = dName:find("crate") or dName:find("container") or dName:find("stack")
                    if not isCrate then
                        local isPallet = (pName == "pallets" or pName == "pallet") or
                                         (dName:find("pallet") ~= nil) or
                                         (d:FindFirstChild("PrimaryPartPallet") ~= nil) or
                                         (d:FindFirstChild("DropPrompt", true) ~= nil)
                        if isPallet and d:GetAttribute("Destroyed") ~= true and d:GetAttribute("Broken") ~= true then
                            palletSeen[d] = true
                            local part = d:FindFirstChild("PrimaryPartPallet") or d:FindFirstChild("Wood") or d:FindFirstChild("PalletWood") or d:FindFirstChild("Hitbox") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                            if part then table.insert(pallets, { Model = d, Part = part, PalletWood = d }) end
                        end
                    end
                end

                -- Window / Vault detection across all maps (handle models inside folders named Windows or Vaults)
                if d:IsA("Model") and not winSeen[d] then
                    local dName = d.Name:lower()
                    local pName = d.Parent and d.Parent.Name:lower() or ""
                    local isWindow = dName:find("window") or dName:find("vault") or pName == "windows" or pName == "vaults" or pName == "vaultpoints"
                    if isWindow then
                        winSeen[d] = true
                        local bottomPart = d:FindFirstChild("Bottom") or d:FindFirstChild("Ledge") or d:FindFirstChild("Sill")
                        local ledge = bottomPart
                        if not ledge then
                            for _, c in ipairs(d:GetChildren()) do
                                if c:IsA("BasePart") and not c.Name:lower():find("invis") and not c.Name:lower():find("trigger") and not c.Name:lower():find("collision") then
                                    ledge = c
                                    break
                                end
                            end
                        end
                        local part = ledge or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                        if part then
                            ledge = ledge or part
                            if ledge.Transparency >= 0.99 then ledge.Transparency = 0.98 end
                            table.insert(windows, { Model = d, Part = part, VaultLedge = ledge })
                        end
                    end
                end
            end

            for _, d in ipairs(rootObj:GetChildren()) do
                if d:IsA("Model") and d.Name == "Gate" then
                    local part = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gates, { Model = d, Part = part }) end
                end
            end
        end
        CachedGenerators = gens
        CachedPallets = pallets
        CachedWindows = windows
        CachedGates = gates
    end)
end

UpdateBackgroundCache()
task.spawn(function()
    while ScriptRunning do
        task.wait(0.3)
        UpdateBackgroundCache()
    end
end)

-- ======== ESP DRAWING SYSTEM (SEPARATED SURVIVOR BOX & KILLER SKELETON) ========
local ESP_Objects = {}

local function CreatePlayerESP(player)
    local esp = {
        Player = player,
        BoxOutline = Drawing.new("Square"),
        Box = Drawing.new("Square"),
        TopText = Drawing.new("Text"),
        BottomText = Drawing.new("Text"),
        PerkText = Drawing.new("Text"),
        SkillText = Drawing.new("Text"),
        -- Killer Skeleton Lines (Sleek Hot Pink stick figure)
        Skeleton = {
            Spine = Drawing.new("Line"),
            LeftArm = Drawing.new("Line"),
            RightArm = Drawing.new("Line"),
            LeftLeg = Drawing.new("Line"),
            RightLeg = Drawing.new("Line"),
        }
    }

    esp.BoxOutline.Thickness = 3
    esp.BoxOutline.Filled = false
    esp.BoxOutline.Color = Color3.fromRGB(0, 0, 0)
    esp.BoxOutline.Visible = false

    esp.Box.Thickness = 1
    esp.Box.Filled = false
    esp.Box.Visible = false

    for _, t in ipairs({ esp.TopText, esp.BottomText, esp.PerkText, esp.SkillText }) do
        t.Size = 13
        t.Center = true
        t.Outline = true
        t.OutlineColor = Color3.fromRGB(0, 0, 0)
        t.Visible = false
    end

    for _, line in pairs(esp.Skeleton) do
        line.Thickness = Config.KillerSkeletonThickness or 1.3
        line.Color = Color3.fromRGB(240, 60, 160)
        line.Visible = false
    end

    function esp:Remove()
        pcall(function()
            self.BoxOutline:Remove()
            self.Box:Remove()
            self.TopText:Remove()
            self.BottomText:Remove()
            self.PerkText:Remove()
            self.SkillText:Remove()
            for _, line in pairs(self.Skeleton) do
                line:Remove()
            end
        end)
    end

    ESP_Objects[player] = esp
    return esp
end

local function RemovePlayerESP(player)
    if ESP_Objects[player] then
        ESP_Objects[player]:Remove()
        ESP_Objects[player] = nil
    end
    CachedPlayerData[player] = nil
end

for _, p in ipairs(Players:GetPlayers()) do
