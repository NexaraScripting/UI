local function TrackExecutionCount()
    local count = 1
    pcall(function()
        local fileName = "hps_exec_count.txt"
        if isfile and isfile(fileName) and readfile then
            local raw = readfile(fileName)
            local n = tonumber(raw)
            if n then count = n + 1 end
        elseif getgenv then
            local g = getgenv()
            if g.HPS_Executions then
                count = g.HPS_Executions + 1
            end
        end
        if writefile then
            writefile(fileName, tostring(count))
        end
        if getgenv then
            getgenv().HPS_Executions = count
        end
    end)
    return count
end
