-- Detect Executor and Version
local function DetectExecutor()
    local name = "Unknown"
    local ver = "Unknown"

    pcall(function()
        if identifyexecutor then
            local n, v = identifyexecutor()
            if n and tostring(n) ~= "" then name = tostring(n) end
            if v and tostring(v) ~= "" and tostring(v) ~= "nil" then ver = tostring(v) end
        elseif identify_executor then
            local n, v = identify_executor()
            if n and tostring(n) ~= "" then name = tostring(n) end
            if v and tostring(v) ~= "" and tostring(v) ~= "nil" then ver = tostring(v) end
        elseif getexecutorname then
            local n = getexecutorname()
            if n and tostring(n) ~= "" then name = tostring(n) end
        end
    end)

    pcall(function()
        if syn then
            if name == "Unknown" then name = "Synapse X" end
            if ver == "Unknown" and syn.version then ver = tostring(syn.version) end
        elseif KRNL_LOADED then
            if name == "Unknown" then name = "KRNL" end
        elseif is_sirhurt_closure then
            if name == "Unknown" then name = "SirHurt" end
        elseif FLUXUS_LOADED then
            if name == "Unknown" then name = "Fluxus" end
        elseif SENTINEL_LOADED then
            if name == "Unknown" then name = "Sentinel" end
        elseif shadow_env then
            if name == "Unknown" then name = "Shadow" end
        elseif OXYGEN_LOADED then
            if name == "Unknown" then name = "Oxygen U" end
        end
    end)

    if ver ~= "Unknown" and not string.find(ver, "^v") and not string.find(ver, "^V") and tonumber(string.sub(ver, 1, 1)) then
        ver = "v" .. ver
    end

    return name, ver
end

