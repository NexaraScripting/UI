local function BindMenuKey(buttonInstance, labelInstance)
    if isBindingKey then return end
    isBindingKey = true

    local prevKeyName = Config.ToggleKey.Name
    labelInstance.Text = "[ Press Key ]"
    labelInstance.TextColor3 = Theme.White
    if buttonInstance then
        Tween(buttonInstance, 0.15, { BackgroundColor3 = Color3.fromRGB(18, 42, 85) }):Play()
    end

    local conn
    conn = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode
            conn:Disconnect()

            if key ~= Enum.KeyCode.Escape and key ~= Enum.KeyCode.Unknown then
                Config.ToggleKey = key
                labelInstance.Text = key.Name
                if sysKeyLabel and sysKeyLabel ~= labelInstance then
                    sysKeyLabel.Text = key.Name
                end
                if settingsKeyLabel and settingsKeyLabel ~= labelInstance then
                    settingsKeyLabel.Text = key.Name
                end
            else
                labelInstance.Text = prevKeyName
            end

            if labelInstance == settingsKeyLabel then
                labelInstance.TextColor3 = Theme.White
            else
                labelInstance.TextColor3 = Theme.Blue
            end
            if sysKeyLabel then sysKeyLabel.TextColor3 = Theme.Blue end
            if settingsKeyLabel then settingsKeyLabel.TextColor3 = Theme.White end

            if buttonInstance then
                Tween(buttonInstance, 0.15, { BackgroundColor3 = Theme.CardInner }):Play()
                Tween(buttonInstance, 0.08, { Size = UDim2.fromOffset(76, 21) }):Play()
                task.wait(0.08)
                Tween(buttonInstance, 0.22, { Size = UDim2.fromOffset(82, 24) }, Enum.EasingStyle.Back):Play()
            end

            task.delay(0.12, function()
