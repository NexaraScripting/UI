local function ApplyBaseTheme(name)
    local b = BaseThemes[name]
    if not b then return end
    Config.ThemeName = name
    for k, v in pairs(b) do
        Theme[k] = v
    end

    Tween(main, 0.35, { BackgroundColor3 = Theme.Background }):Play()
    local isWallActive = (Config.CustomBgId ~= "" or activeThemeId ~= nil)
    if sidebarFrame then
        Tween(sidebarFrame, 0.35, {
            BackgroundColor3 = Theme.Sidebar,
            BackgroundTransparency = 0
        }):Play()
        local fill = sidebarFrame:FindFirstChild("SidebarFill")
        if fill then
            Tween(fill, 0.35, {
                BackgroundColor3 = Theme.Sidebar,
                BackgroundTransparency = 0
            }):Play()
        end
    end
    for _, c in ipairs(allCardFrames) do
        Tween(c, 0.35, {
            BackgroundColor3 = Theme.Card,
            BackgroundTransparency = isWallActive and 0.14 or 0
        }):Play()
    end
    for _, s in ipairs(allCardStrokes) do
        Tween(s, 0.35, { Color = Theme.Border }):Play()
    end
    for tName, btnData in pairs(themeModeButtons) do
        local isSel = (tName == name)
        Tween(btnData.btn, 0.25, {
            BackgroundColor3 = isSel and Theme.ActiveBg or Theme.CardInner
        }):Play()
        Tween(btnData.stroke, 0.25, {
            Color = isSel and Theme.Blue or Theme.BorderSoft
        }):Play()
        btnData.label.TextColor3 = isSel and Theme.White or Theme.Muted
    end
    UpdateRunnerColors()
end

local function UpdateGlassMode(enabled)
    local cardTrans = enabled and 0.14 or 0
    local sideTrans = enabled and 0.32 or 0
    if sidebarFrame then
        Tween(sidebarFrame, 0.35, { BackgroundTransparency = sideTrans }):Play()
        local fill = sidebarFrame:FindFirstChild("SidebarFill")
        if fill then
            Tween(fill, 0.35, { BackgroundTransparency = sideTrans }):Play()
        end
    end
    for _, c in ipairs(allCardFrames) do
        Tween(c, 0.35, { BackgroundTransparency = cardTrans }):Play()
    end
    for _, s in ipairs(allCardStrokes) do
        Tween(s, 0.35, {
            Transparency = enabled and 0.3 or 0,
            Color = enabled and Color3.fromRGB(24, 40, 64) or Theme.Border
        }):Play()
    end
end

local bgFadeTween1 = nil
local bgFadeTween2 = nil
local bgOverlayTween = nil
local bgTransitionSeq = 0

local function ApplyCustomWallpaper(rawInput, onDone)
    if not rawInput or rawInput == "" then return end
    if bgApplyBtn then bgApplyBtn.Text = "..." end
    
    bgTransitionSeq = bgTransitionSeq + 1
    local curSeq = bgTransitionSeq

    task.spawn(function()
        local resolved = ResolveDecalToTexture(rawInput)
        if curSeq ~= bgTransitionSeq then return end

        if not resolved or resolved == "" then
            if bgApplyBtn then
                bgApplyBtn.Text = "Error"
                task.delay(1.2, function()
                    if bgApplyBtn and bgApplyBtn.Parent then bgApplyBtn.Text = "Apply" end
                end)
            end
            if onDone then onDone(false) end
            return
        end

        local curIdx = activeBgIdx
        local curImg = bgImages[curIdx]

        -- If already displaying this exact image and it is visible, don't re-trigger
        if Config.CustomBgId == resolved and curImg.Visible and curImg.ImageTransparency < 0.05 then
            if bgApplyBtn then
                bgApplyBtn.Text = "Done"
                task.delay(1, function()
                    if bgApplyBtn and bgApplyBtn.Parent then bgApplyBtn.Text = "Apply" end
                end)
            end
            if onDone then onDone(true) end
            return
        end

        Config.CustomBgId = resolved

        -- 1. Cancel previous tweens properly and handle mid-transition interrupts
        if bgFadeTween1 then
            bgFadeTween1:Cancel()
            bgFadeTween1 = nil
            local pendingNextIdx = (activeBgIdx == 1) and 2 or 1
            local pendingImg = bgImages[pendingNextIdx]
            if pendingImg and pendingImg.Visible and pendingImg.ImageTransparency < 0.95 then
                bgImages[activeBgIdx].Visible = false
                bgImages[activeBgIdx].ImageTransparency = 1
                bgImages[activeBgIdx].ZIndex = 1
                pendingImg.ImageTransparency = 0
                pendingImg.ZIndex = 1
                activeBgIdx = pendingNextIdx
            end
        end
        if bgFadeTween2 then bgFadeTween2:Cancel() bgFadeTween2 = nil end
        if bgOverlayTween then bgOverlayTween:Cancel() bgOverlayTween = nil end

        local curIdx = activeBgIdx
        local curImg = bgImages[curIdx]
        local nextIdx = (curIdx == 1) and 2 or 1
        local nextImg = bgImages[nextIdx]

        -- 2. Setup incoming layer image and preload before starting fade
        nextImg.Image = resolved
        pcall(function()
            ContentProvider:PreloadAsync({ nextImg })
        end)
        if curSeq ~= bgTransitionSeq then return end

        for _, item in ipairs(bgBlurLayers[nextIdx]) do
            if item.img.Visible then
                item.img.Image = resolved
            end
        end
        ApplyWallpaperBlur(Config.BlurLevel)

        -- 3. Manage customBgOverlay (ZIndex = 3 stays strictly above both wallpapers and under UI)
        if customBgOverlay then
            customBgOverlay.ZIndex = 3
            customBgOverlay.Visible = true
            if customBgOverlay.BackgroundTransparency >= 0.95 then
                customBgOverlay.BackgroundTransparency = 1
                bgOverlayTween = Tween(customBgOverlay, 0.35, { BackgroundTransparency = 0.28 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                bgOverlayTween:Play()
            else
                customBgOverlay.BackgroundTransparency = 0.28
            end
        end

        -- 4. Single-state smooth crossfade using direct ImageTransparency:
        if not curImg.Visible or curImg.ImageTransparency >= 0.95 then
            -- Initial fade in from empty/dark base
            curImg.Visible = false
            curImg.ImageTransparency = 1
            curImg.ZIndex = 1

            nextImg.ZIndex = 2
            nextImg.ImageTransparency = 1
            nextImg.Visible = true

            bgFadeTween1 = Tween(nextImg, 0.35, { ImageTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            bgFadeTween1:Play()

            bgFadeTween1.Completed:Connect(function(playbackState)
                if playbackState == Enum.PlaybackState.Completed and curSeq == bgTransitionSeq then
                    activeBgIdx = nextIdx
                    nextImg.ZIndex = 1
                    bgFadeTween1 = nil
                end
            end)
        else
            -- Crossfade: Outgoing layer stays steady underneath (ZIndex 1) so NO dark flash
            curImg.ZIndex = 1
            curImg.Visible = true
            curImg.ImageTransparency = 0

            -- Incoming layer fades in on top (ZIndex 2) from ImageTransparency 1 -> 0
            nextImg.ZIndex = 2
            nextImg.ImageTransparency = 1
            nextImg.Visible = true

            bgFadeTween1 = Tween(nextImg, 0.35, { ImageTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            bgFadeTween1:Play()

            bgFadeTween1.Completed:Connect(function(playbackState)
                if playbackState == Enum.PlaybackState.Completed and curSeq == bgTransitionSeq then
                    curImg.Visible = false
                    curImg.ImageTransparency = 1
                    curImg.ZIndex = 1
                    nextImg.ZIndex = 1
                    activeBgIdx = nextIdx
                    bgFadeTween1 = nil
                end
            end)
        end

        UpdateGlassMode(true)
        if bgInputBox then bgInputBox.Text = tostring(rawInput) end
        if bgApplyBtn then
            bgApplyBtn.Text = "Done"
            task.delay(1, function()
                if bgApplyBtn and bgApplyBtn.Parent then bgApplyBtn.Text = "Apply" end
            end)
        end
        if onDone then onDone(true) end
    end)
end

local function ClearCustomWallpaper()
    bgTransitionSeq = bgTransitionSeq + 1
    local curSeq = bgTransitionSeq
    Config.CustomBgId = ""
    if bgInputBox then bgInputBox.Text = "" end

    if bgFadeTween1 then bgFadeTween1:Cancel() bgFadeTween1 = nil end
    if bgFadeTween2 then bgFadeTween2:Cancel() bgFadeTween2 = nil end
    if bgOverlayTween then bgOverlayTween:Cancel() bgOverlayTween = nil end

    local curImg = bgImages[activeBgIdx]
    local otherIdx = (activeBgIdx == 1) and 2 or 1
    local otherImg = bgImages[otherIdx]

    otherImg.Visible = false
    otherImg.ImageTransparency = 1
    otherImg.ZIndex = 1

    if curImg and curImg.Visible then
        curImg.ZIndex = 1
        bgFadeTween1 = Tween(curImg, 0.35, { ImageTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        bgFadeTween1:Play()
        if customBgOverlay and customBgOverlay.Visible then
            customBgOverlay.ZIndex = 3
            bgOverlayTween = Tween(customBgOverlay, 0.35, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            bgOverlayTween:Play()
        end
        bgFadeTween1.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed and curSeq == bgTransitionSeq then
                curImg.Visible = false
                curImg.ImageTransparency = 1
                if customBgOverlay then customBgOverlay.Visible = false end
                bgFadeTween1 = nil
                bgOverlayTween = nil
            end
        end)
    else
        if customBgOverlay then customBgOverlay.Visible = false end
    end

    UpdateGlassMode(false)
end


