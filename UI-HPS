-- pageAnims declared at top level

local function SwitchPage(name, forceAnim)
    if currentPage == name and not forceAnim then return end

    for pName, pg in pairs(pages) do
        if pName ~= name and pg.Visible then
            pg.Visible = false
        end
    end

    if pages[name] then
        pages[name].CanvasPosition = Vector2.new(0, 0)
        pages[name].Visible = true
        if isVisible and pageAnims[name] then
            pageAnims[name]()
        end
    end

    for bName, data in pairs(navButtons) do
        local isActive = (bName == name)
        Tween(data.bg, 0.25, {
            BackgroundColor3 = isActive and Theme.ActiveBg or Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = isActive and 0 or 1
        }):Play()
        Tween(data.icon, 0.2, { ImageColor3 = isActive and Theme.White or Theme.SubText }):Play()
        Tween(data.text, 0.2, { TextColor3 = isActive and Theme.White or Theme.SubText }):Play()
        if data.indicator then
            Tween(data.indicator, 0.25, {
                BackgroundTransparency = isActive and 0 or 1,
                Size = isActive and UDim2.new(0, 3, 0, 20) or UDim2.new(0, 3, 0, 0)
            }):Play()
        end
    end

    if setNavStroke then
        Tween(setNavStroke, 0.25, {
            Color = (name == "Settings") and Theme.BlueGlow or Theme.BorderSoft
        }):Play()
    end

    if searchContainer and settingsTitle then
        if name == "Settings" then
            searchContainer.Visible = false
            if setIcoHeader then setIcoHeader.Image = Icons.Settings end
            if setHeadTxt then setHeadTxt.Text = "Settings  <font color=\"#4a658a\">/</font>  Configuration" end
            settingsTitle.Visible = true
        else
            settingsTitle.Visible = false
            searchContainer.Visible = true
        end
    end

    currentPage = name
end

