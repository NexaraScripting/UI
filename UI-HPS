-- =================================================================
-- UNLOAD SCRIPT SYSTEM & CONFIRMATION MODAL
-- =================================================================
local isUnloading = false
local function UnloadScript()
    if isUnloading then return end
    isUnloading = true

    -- 1. Animate UI close smoothly
    if isVisible and main then
        isVisible = false
        if currentAnimTween then currentAnimTween:Cancel() end
        local closeTw = Tween(main, 0.22, {
            Size = UDim2.new(0, math.floor(Config.WindowSize.X.Offset * 0.94), 0, math.floor(Config.WindowSize.Y.Offset * 0.94))
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        closeTw:Play()
    end

    -- 2. Destroy background blur in Lighting
    if bgBlur then
        pcall(function()
            bgBlur.Enabled = false
            bgBlur:Destroy()
        end)
        bgBlur = nil
    end
    pcall(function()
        local b = Lighting:FindFirstChild("HPS_BackgroundBlur")
        if b then b:Destroy() end
    end)

    -- 3. Disconnect all registered Heartbeat / RenderStepped / Input connections
    for _, conn in ipairs(cleanupConns) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(cleanupConns)

    -- 4. Clean up global references
    if _G.HPS_Cleanup then _G.HPS_Cleanup = nil end
    if getgenv then
        pcall(function()
            if getgenv().HPS_Cleanup then getgenv().HPS_Cleanup = nil end
        end)
    end

    -- 5. Destroy HUD & Mobile toggle button
    pcall(function()
        if hudBar and hudBar.Parent then hudBar:Destroy() end
    end)
    pcall(function()
        if mobileToggle and mobileToggle.Parent then mobileToggle:Destroy() end
    end)

    -- 6. Destroy root ScreenGui after animation completes
    task.delay(0.24, function()
        pcall(function()
            if gui and gui.Parent then
                gui:Destroy()
            end
        end)
    end)
end

