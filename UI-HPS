local sessionStart = tick()
local lastElapsedSec = -1
local gameTimeConn = RunService.Heartbeat:Connect(function()
    local elapsed = math.floor(workspace.DistributedGameTime or (tick() - sessionStart))
    if elapsed <= 0 then elapsed = math.floor(tick() - sessionStart) end
    if elapsed == lastElapsedSec then return end
    lastElapsedSec = elapsed
    local hrs = math.floor(elapsed / 3600)
    local mins = math.floor((elapsed % 3600) / 60)
    local secs = elapsed % 60
    if hrs > 0 then
        timeVal.Text = string.format("<b>%dh %02dm %02ds</b>", hrs, mins, secs)
    else
        timeVal.Text = string.format("<b>%02dm %02ds</b>", mins, secs)
    end
end)
