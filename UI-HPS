                    task.wait(1)
                    vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                end)
            end)
            table.insert(cleanupConns, StreamerMeta.afkConn)
        end
    end, Icons.Zap)

