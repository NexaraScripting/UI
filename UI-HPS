local function ResolveDecalToTexture(rawInput)
    if not rawInput or rawInput == "" then return nil end
    local clean = string.gsub(tostring(rawInput), "%s+", "")
    if string.find(clean, "rbxthumb://") or string.find(clean, "rbxasset://") or string.find(clean, "rbxassetid://") or string.find(clean, "http://") or string.find(clean, "https://") then
        return clean
    end
    if decalTextureCache[clean] then
        return decalTextureCache[clean]
    end
    local numStr = string.match(clean, "(%d+)")
    if not numStr then return clean end
    if decalTextureCache[numStr] then
        return decalTextureCache[numStr]
    end
    local numId = tonumber(numStr)
    if not numId then return clean end

    local s, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. numId)
    end)
    if s and objs and #objs > 0 then
        for _, item in ipairs(objs) do
            if item:IsA("Decal") and item.Texture and item.Texture ~= "" then
                decalTextureCache[clean] = item.Texture
                decalTextureCache[numStr] = item.Texture
                return item.Texture
            end
        end
    end

    local fallback = string.format("rbxthumb://type=Asset&id=%d&w=768&h=432", numId)
    decalTextureCache[clean] = fallback
    decalTextureCache[numStr] = fallback
    return fallback
end

local function Label(parent, text, size, pos, font, color)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.RichText = true
    l.Text = text
    l.TextColor3 = color or Theme.Text
    l.TextSize = size or 12
    l.Font = font or Fonts.Medium
    l.Position = pos or UDim2.fromOffset(0, 0)
    l.Size = UDim2.fromOffset(200, 24)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function Card(parent, pos, size)
    local c = Instance.new("Frame")
    c.Position = pos; c.Size = size
    c.BackgroundColor3 = Theme.Card
    c.BackgroundTransparency = (Config.CustomBgId ~= "" and customBg and customBg.Visible) and 0.14 or 0
    c.BorderSizePixel = 0
    c.ZIndex = 1
    c.Parent = parent
    Corner(c, 10)
    local s = Stroke(c, Theme.Border, 1)
    table.insert(allCardFrames, c)
    table.insert(allCardStrokes, s)
    return c
end

local function Tween(obj, t, props, style, dir)
    return TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
end

