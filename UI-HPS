            Position = basePos + UDim2.fromOffset(0, -2)
        }):Play()
        Tween(sStroke, 0.15, { Color = Theme.Blue, Thickness = 1.2 }):Play()
    end)
    f.MouseLeave:Connect(function()
        Tween(f, 0.15, {
            BackgroundColor3 = Theme.CardInner,
            Position = basePos
        }):Play()
        Tween(sStroke, 0.15, { Color = Theme.BorderSoft, Thickness = 1 }):Play()
    end)

    -- Click bounce
    f.MouseButton1Click:Connect(function()
        Tween(f, 0.08, {
            Size = size - UDim2.fromOffset(4, 3),
            Position = basePos + UDim2.fromOffset(2, 2)
        }):Play()
        Tween(sStroke, 0.08, { Color = Theme.BlueGlow }):Play()
        task.wait(0.08)
        Tween(f, 0.22, {
            Size = size,
            Position = basePos + UDim2.fromOffset(0, -2)
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out):Play()
        Tween(sStroke, 0.2, { Color = Theme.Blue }):Play()
    end)

    table.insert(statBoxFrames, { frame = f, basePos = basePos, idx = idx })
    return f, sStroke
end

