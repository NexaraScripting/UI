local function ApplyAccent(preset)
    Config.AccentName = preset.Name
    Theme.Blue = preset.Main
    Theme.BlueGlow = preset.Glow
    Theme.ActiveBg = preset.ActiveBg

    local animDuration = 0.35

    -- 1. Main Window Border & Running Glow
    if runnerStroke then
        if Config.RunningGlow then
            runnerStroke.Color = Color3.fromRGB(255, 255, 255)
            if runnerGrad then runnerGrad.Enabled = true end
        else
            Tween(runnerStroke, animDuration, { Color = preset.Main }):Play()
            if runnerGrad then runnerGrad.Enabled = false end
        end
    end
    UpdateRunnerColors()

    -- 2. Top Neon Glow Line
    if topGlow then
        Tween(topGlow, animDuration, { BackgroundColor3 = preset.Glow }):Play()
    end
    if topGlowGrad then
        topGlowGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, preset.Main),
            ColorSequenceKeypoint.new(0.5, preset.Glow),
            ColorSequenceKeypoint.new(1, preset.Main)
        }
    end

    -- 3. Topbar and Sidebar Glowing Dividers
    if topDivGrad then
        topDivGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Theme.BorderSoft),
            ColorSequenceKeypoint.new(0.2, Color3.fromRGB(math.floor(preset.Main.R * 60), math.floor(preset.Main.G * 60), math.floor(preset.Main.B * 60))),
            ColorSequenceKeypoint.new(0.5, preset.Main),
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(math.floor(preset.Main.R * 60), math.floor(preset.Main.G * 60), math.floor(preset.Main.B * 60))),
            ColorSequenceKeypoint.new(1, Theme.BorderSoft)
        }
    end
    if sideDivGrad then
        sideDivGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Theme.BorderSoft),
            ColorSequenceKeypoint.new(0.5, preset.Main),
            ColorSequenceKeypoint.new(1, Theme.BorderSoft)
        }
    end

    -- 4. Hero Banner Gradient
    if heroGrad then
        heroGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(math.floor(preset.Main.R * 45), math.floor(preset.Main.G * 45), math.floor(preset.Main.B * 45))),
            ColorSequenceKeypoint.new(0.5, Theme.Card),
            ColorSequenceKeypoint.new(1, Theme.Background)
        }
    end

    -- 5. Navigation Buttons & Active Tab
    for bName, data in pairs(navButtons) do
        if data.indicator then
            Tween(data.indicator, animDuration, { BackgroundColor3 = preset.Glow }):Play()
        end
        if bName == currentPage then
            Tween(data.bg, animDuration, { BackgroundColor3 = preset.ActiveBg }):Play()
            if data.icon then data.icon.ImageColor3 = Theme.White end
        end
    end
    if setNavStroke and currentPage == "Settings" then
        Tween(setNavStroke, animDuration, { Color = preset.Glow }):Play()
    end

    -- 6. Page Scrollbars
    for _, pg in pairs(pages) do
        pg.ScrollBarImageColor3 = preset.Main
    end

    -- 7. ALL Active Toggles in entire GUI
    for _, tog in ipairs(registeredToggles) do
        if tog.update then tog.update(true) end
    end

    -- 8. Sliders
    if sliderFill then Tween(sliderFill, animDuration, { BackgroundColor3 = preset.Main }):Play() end
    if sliderKnobStroke then Tween(sliderKnobStroke, animDuration, { Color = preset.Main }):Play() end
    if blurValLabel then Tween(blurValLabel, animDuration, { TextColor3 = preset.Glow }):Play() end

    -- 9. Header Icons & Dynamic Labels
    if setIcoHeader then Tween(setIcoHeader, animDuration, { ImageColor3 = preset.Glow }):Play() end
    if visHeadIco then Tween(visHeadIco, animDuration, { ImageColor3 = preset.Glow }):Play() end
