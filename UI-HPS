-- Dynamic Typewriter Subtitle Effect ("Type & Backspace Simulation" - throttled when hidden)
task.spawn(function()
    local function ColorToHex(c)
        if not c then return "#38A8FF" end
        return string.format("#%02X%02X%02X", math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
    end

    local typeMessages = {
        "Cheat every day - Have fun & enjoy the game!",
        "Wishing you the best gameplay - Have fun!",
        "Currently open for testing - Beta Script",
        "UI issues or bugs? Contact us on Discord"
    }

    local msgIdx = 1
    while isVisible ~= nil do
        if not sActive or not sActive.Parent then break end

        if not isVisible then
            task.wait(0.5)
        else
            local rawMsg = typeMessages[msgIdx]
            local clusters = {}
            for first, last in utf8.graphemes(rawMsg) do
                table.insert(clusters, string.sub(rawMsg, first, last))
            end

            -- 1. Typing phase (types character by character)
            for i = 1, #clusters do
                local curText = table.concat(clusters, "", 1, i)
                local cursorColor = ColorToHex(Theme.BlueGlow)
                sActive.Text = curText .. "<font color=\"" .. cursorColor .. "\">|</font>"
                task.wait(0.045 + math.random(1, 4) * 0.008)
            end

            -- 2. Pause & blink cursor at end
            local fullText = rawMsg
            for _ = 1, 4 do
                local cursorColor = ColorToHex(Theme.BlueGlow)
                sActive.Text = fullText .. "<font color=\"" .. cursorColor .. "\">|</font>"
                task.wait(0.35)
                sActive.Text = fullText
                task.wait(0.35)
            end

            -- 3. Deleting phase (backspaces character by character)
            for i = #clusters, 0, -1 do
                local curText = (i > 0) and table.concat(clusters, "", 1, i) or ""
                local cursorColor = ColorToHex(Theme.BlueGlow)
                sActive.Text = curText .. "<font color=\"" .. cursorColor .. "\">|</font>"
                task.wait(0.02)
            end

            -- Short pause before next message
            task.wait(0.35)
            msgIdx = (msgIdx % #typeMessages) + 1
        end
    end
end)

