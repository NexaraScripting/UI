AnimClose = function()
    if not isVisible and (not main or not main.Visible) then return end
    isVisible = false
    if bgBlur then bgBlur.Enabled = false end
    if currentAnimTween then currentAnimTween:Cancel() end

    local targetSize = UDim2.new(0, math.floor(Config.WindowSize.X.Offset * 0.94), 0, math.floor(Config.WindowSize.Y.Offset * 0.94))
    currentAnimTween = Tween(main, 0.18, {
        Size = targetSize
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    currentAnimTween:Play()
    currentAnimTween.Completed:Connect(function()
        if not isVisible then
            main.Visible = false
        end
    end)
end

AnimOpen = function()
    if isVisible and main and main.Visible then return end
    isVisible = true
    if bgBlur and Config.BlurLevel > 0 then bgBlur.Enabled = true end
    if currentAnimTween then currentAnimTween:Cancel() end

    main.Size = UDim2.new(0, math.floor(Config.WindowSize.X.Offset * 0.94), 0, math.floor(Config.WindowSize.Y.Offset * 0.94))
    main.Visible = true

    currentAnimTween = Tween(main, 0.26, {
        Size = Config.WindowSize
    }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    currentAnimTween:Play()

    -- Play cards entrance concurrently with window opening (Zero delay)
    if currentPage and pageAnims[currentPage] then
        task.spawn(function()
            pcall(pageAnims[currentPage])
        end)
    end
end

