        ConfigSys.UpdateStatusLabel()
    end)

    local statusLabel = nil
    ConfigSys.UpdateStatusLabel = function()
        if statusLabel then
            statusLabel.Set("loaded: " .. (ConfigSys.CurrentProfile or "Default") .. " | autoload: " .. (ConfigSys.AutoloadProfile or "none"))
        end
    end

    ConfigsMod:AddButtonRow(
        {
            Name = "Create",
            Callback = function()
                local name = customInputName:gsub("^%s+", ""):gsub("%s+$", "")
                if name == "" then name = "Profile_" .. tostring(#GetConfigNames()) end
                ConfigSys.CurrentProfile = name
                ConfigSys.SaveProfile(name)
                configDropdown.Refresh(GetConfigNames(), name)
                ConfigSys.UpdateStatusLabel()
                print("[Nexara] Created Config:", name)
            end
        },
        {
            Name = "Save",
            Callback = function()
                local name = ConfigSys.CurrentProfile or "Default"
                ConfigSys.SaveProfile(name)
                configDropdown.Refresh(GetConfigNames(), name)
                ConfigSys.UpdateStatusLabel()
                print("[Nexara] Saved Config:", name)
            end
        }
    )

    ConfigsMod:AddButtonRow(
        {
            Name = "Load",
            Callback = function()
                local name = ConfigSys.CurrentProfile or "Default"
                local ok = ConfigSys.LoadProfile(name, false)
                print("[Nexara] Loaded Config:", name, ok)
            end
        },
        {
            Name = "Delete",
            TextColor3 = Color3.fromRGB(240, 80, 80),
            Callback = function()
                local name = ConfigSys.CurrentProfile
                if name and name ~= "Default" then
                    pcall(function()
                        local path = configFolder .. "/" .. name .. ".json"
                        if delfile and isfile and isfile(path) then delfile(path) end
                    end)
                    if ConfigSys.AutoloadProfile == name then
                        ConfigSys.AutoloadProfile = "none"
                        local accPath, globalPath = ConfigSys.GetAutoloadPaths()
                        pcall(function()
                            if delfile and isfile and isfile(accPath) then delfile(accPath) end
                            if delfile and isfile and isfile(globalPath) then delfile(globalPath) end
                        end)
                    end
                    ConfigSys.CurrentProfile = "Default"
                    configDropdown.Refresh(GetConfigNames(), "Default")
                    ConfigSys.UpdateStatusLabel()
                    print("[Nexara] Deleted Config:", name)
                end
            end
        }
    )

    ConfigsMod:AddButtonRow(
        {
            Name = "Set autoload",
            Callback = function()
                local name = ConfigSys.CurrentProfile or "Default"
                ConfigSys.AutoloadProfile = name
                local accPath, globalPath = ConfigSys.GetAutoloadPaths()
                pcall(function()
                    if writefile then
                        if Config.AutoloadMode == "Current account only" then
                            writefile(accPath, name)
                            if delfile and isfile and isfile(globalPath) then delfile(globalPath) end
                        else
                            writefile(globalPath, name)
                            if delfile and isfile and isfile(accPath) then delfile(accPath) end
                        end
                    end
                end)
                ConfigSys.UpdateStatusLabel()
                print("[Nexara] Set Autoload:", name)
            end
        },
        {
            Name = "Clear autoload",
            Callback = function()
                ConfigSys.AutoloadProfile = "none"
                local accPath, globalPath = ConfigSys.GetAutoloadPaths()
                pcall(function()
                    if makefolder and isfolder and not isfolder(ConfigSys.Folder) then
                        makefolder(ConfigSys.Folder)
                    end
                    local targetPath = (Config.AutoloadMode == "Current account only") and accPath or globalPath
                    local otherPath = (targetPath == accPath) and globalPath or accPath
                    if writefile then writefile(targetPath, "none") end
                    if delfile and isfile and isfile(otherPath) then delfile(otherPath) end
                end)
                ConfigSys.UpdateStatusLabel()
                print("[Nexara] Cleared Autoload")
            end
        }
    )

    statusLabel = ConfigsMod:AddLabel("loaded: " .. (ConfigSys.CurrentProfile or "Default") .. " | autoload: " .. (ConfigSys.AutoloadProfile or "none"))

    W.autoloadMode = ConfigsMod:AddDropdown("Autoload mode", { "All accounts", "Current account only" }, Config.AutoloadMode or "All accounts", function(v)
        Config.AutoloadMode = v
        if ConfigSys.AutoloadProfile and ConfigSys.AutoloadProfile ~= "none" then
            local accPath, globalPath = ConfigSys.GetAutoloadPaths()
            pcall(function()
                if writefile then
                    if v == "Current account only" then
                        writefile(accPath, ConfigSys.AutoloadProfile)
                        if delfile and isfile and isfile(globalPath) then delfile(globalPath) end
                    else
                        writefile(globalPath, ConfigSys.AutoloadProfile)
                        if delfile and isfile and isfile(accPath) then delfile(accPath) end
                    end
                end
            end)
        end
    end)

    ConfigsMod:AddButton("Refresh list", function()
        configDropdown.Refresh(GetConfigNames(), ConfigSys.CurrentProfile or "Default")
        ConfigSys.UpdateStatusLabel()
        print("[Nexara] Refreshed config list")
    end)

    table.insert(ConfigSys.SyncHandlers, function()
        W.menuKey.Set(Config.MenuToggleKey or Enum.KeyCode.RightControl, true)
        W.antiAfk.Set(Config.AntiAFK == true, true)
        W.minStart.Set(Config.MinimizeUIOnStart == true, true)
        W.uiAccent.Set(Config.UI_AccentColor or Theme.Accent)
        if typeof(Config.UI_AccentColor) == "Color3" and Theme.ApplyAccent then
            Theme.ApplyAccent(Config.UI_AccentColor)
        end
        if W.uiFont then
            W.uiFont.Set(Config.UI_Font or "Gotham", true)
        end
        if type(Config.UI_Font) == "string" and Theme.ApplyFont then
            Theme.ApplyFont(Config.UI_Font)
        end
        if UIState.Touch and not UIState.UserSetPlatform and Config.PlatformMode ~= "Mobile" then
            Config.PlatformMode = "Mobile"
        end
        W.platform.Set((Config.PlatformMode == "Mobile") and "Mobile" or "PC", true)
        UpdateResponsiveScale()
        W.showKb.Set(Config.ShowKeybindsList ~= false, true)
        W.streamer.Set(Config.StreamerMode == true, true)
        W.hitLog.Set(Config.HitLog == true, true)
        W.autoSave.Set(Config.ConfigAutoSaveEnabled ~= false, true)
        W.autoloadMode.Set(Config.AutoloadMode or "All accounts", true)
        configDropdown.Refresh(GetConfigNames(), ConfigSys.CurrentProfile or "Default")
    end)

    end

    task.defer(function()
        local espTab = AccordionTabs["Player ESP"]
        if espTab then
            espTab.Indicator.Visible = true
            espTab.Title.TextColor3 = Theme.Text
            espTab.Icon.ImageColor3 = Theme.Accent
            espTab.ToggleAccordion(true)
            if espTab.SubButtons["Survivor"] then
                local sBtn = espTab.SubButtons["Survivor"]
                sBtn.TextColor3 = Theme.Text
                if Theme.SetTextWeight then Theme.SetTextWeight(sBtn, "Bold") else sBtn.Font = Enum.Font.GothamBold end
                sBtn.BackgroundTransparency = 0.88
                sBtn.BackgroundColor3 = Theme.Input
            end
            SwitchToPage("Player ESP_Survivor", "Player ESP", "Survivor")
        end
    end)

    WindowObjRef = WindowObj
    WindowObj.Gui = ScreenGui
    WindowObj.MainFrame = MainFrame
    WindowObj.Theme = Theme
    WindowObj.Visible = UIState.Visible
    WindowObj.ToggleKey = Config.MenuToggleKey or Enum.KeyCode.RightControl
    WindowObj.UnlockMouse = true
    WindowObj.ToggleUI = ToggleUI
    WindowObj.SetVisible = function(self, vis)
        ToggleUI(vis)
    end
    WindowObj.RegisterAccent = function(self, obj, prop)
        if Theme and Theme.RegisterAccent then
            Theme.RegisterAccent(obj, prop)
        end
    end
    WindowObj.SetAccent = function(self, col)
        if Theme and Theme.ApplyAccent then
            Theme.ApplyAccent(col)
        end
    end
    WindowObj.SetFont = function(self, fontName)
        if Theme and Theme.ApplyFont then
            Theme.ApplyFont(fontName)
        end
    end
    WindowObj.SyncWidget = function(self, key, val, silent)
        local w = ConfigSys.KeyedWidgets[key]
        if w and w.Set then
            pcall(w.Set, val, silent ~= false)
        end
    end
    ConfigSys.ApplySideEffects = function()
        if typeof(Config.UI_AccentColor) == "Color3" and Theme.ApplyAccent then
            Theme.ApplyAccent(Config.UI_AccentColor)
        end
        if type(Config.UI_Font) == "string" and Theme.ApplyFont then
            Theme.ApplyFont(Config.UI_Font)
        end
        WindowObj.ToggleKey = Config.MenuToggleKey or Enum.KeyCode.RightControl
        if Config.SelectedWorldPreset and ctx.ApplyWorldPreset then
            pcall(ctx.ApplyWorldPreset, Config.SelectedWorldPreset)
        elseif RestoreOriginalLighting then
            pcall(RestoreOriginalLighting)
        end
        if Config.Fullbright and ApplyFullbrightNow then
            pcall(ApplyFullbrightNow)
        end
        if (Config.NoFog or Config.RemoveFog) and ctx.ApplyNoFogNow then
            pcall(ctx.ApplyNoFogNow)
        end
        if ApplyCustomRedStainNow then
            pcall(ApplyCustomRedStainNow)
        end
        if ctx.RefreshWorldCustomLighting then
            pcall(ctx.RefreshWorldCustomLighting)
        elseif ctx.ApplyWorldCustomNow then
            pcall(ctx.ApplyWorldCustomNow)
        end
        _G.__Nexara_AlwaysFastVault = (Config.AlwaysFastVault == true)
        if Config.CustomFOVEnabled then
            pcall(function() workspace.CurrentCamera.FieldOfView = Config.FOV or 80 end)
        end
        if not Config.StretchedEnabled and ctx and ctx.RestoreCameraStretch then
            pcall(ctx.RestoreCameraStretch)
        end
        if Config.Speed_Enabled then
            pcall(function()
                local c = LocalPlayer and LocalPlayer.Character
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if h then h.WalkSpeed = Config.Speed_Value or 26 end
            end)
        end
        if UIState.Touch and not UIState.UserSetPlatform and Config.PlatformMode ~= "Mobile" then
            Config.PlatformMode = "Mobile"
        end
        if UIState.SyncPlatformBtn then
            UIState.SyncPlatformBtn((Config.PlatformMode == "Mobile") and "Mobile" or "PC")
        end
        if Config.PlatformMode == "Mobile" then
            MobileToggleBtn.Visible = true
        else
            MobileToggleBtn.Visible = false
        end
        UpdateResponsiveScale()
        if Theme._syncMobileButtons then pcall(Theme._syncMobileButtons) end
        local kbVis = (Config.ShowKeybindsList ~= false) and (Config.PlatformMode ~= "Mobile")
        if ctx.SetKeybindsVisible then pcall(ctx.SetKeybindsVisible, kbVis) end
        if ctx.SetStreamerMode then pcall(ctx.SetStreamerMode, Config.StreamerMode == true) end
        if ctx.SetBlurName then pcall(ctx.SetBlurName, Config.AvatarCopy_BlurName == true) end
        if Config.AvatarCopy_Enabled and Config.AvatarCopy_Username and Config.AvatarCopy_Username ~= "" and ctx.CopyAvatarByName then
            pcall(ctx.CopyAvatarByName, Config.AvatarCopy_Username)
        elseif not Config.AvatarCopy_Enabled and _G.Nexara_AvatarManager and _G.Nexara_AvatarManager.ActiveUserId and ctx.ResetAvatar then
            pcall(ctx.ResetAvatar)
        end
        if Theme._refreshPlayerList then pcall(Theme._refreshPlayerList) end
        if ctx.ApplyAntiAfkState then pcall(ctx.ApplyAntiAfkState, Config.AntiAFK == true) end
        if _G.Nexara_VD_HitLogContainer then _G.Nexara_VD_HitLogContainer.Visible = (Config.HitLog == true) end
        if (Config.Tof_Aimbot or Config.Tof_SilentAim) and TofCombat and TofCombat.EnsureHooksActive then
            pcall(TofCombat.EnsureHooksActive)
        end
        if TofCombat and TofCombat.ApplyShootMode then pcall(TofCombat.ApplyShootMode) end
        if TofCombat and TofCombat.SyncFovWithAimbot then pcall(TofCombat.SyncFovWithAimbot, "Init") end
        if (Config.Veil_Aimbot or Config.Veil_SilentAim) and TofCombat and TofCombat.EnsureVeilHooks then
            pcall(TofCombat.EnsureVeilHooks)
        end
        if Config.Butcher_HookSilentAim and TofCombat and TofCombat.EnsureButcherHooks then
            pcall(TofCombat.EnsureButcherHooks)
        elseif TofCombat and TofCombat.HideButcherDrawings then
            pcall(TofCombat.HideButcherDrawings)
        end
        local ap = AutoParry or _G.AutoParry or (getgenv and getgenv().AutoParry) or _G.Nexara_VD_AutoParry
        if ap and ap.UpdateCircle then ap.LastCircleUpdateClock = nil; pcall(ap.UpdateCircle) end
        if PumpkinAuras and Config.Color_PumpkinAura then
            for _, hl in pairs(PumpkinAuras) do
                pcall(function() hl.FillColor = Config.Color_PumpkinAura; hl.OutlineColor = Config.Color_PumpkinAura end)
            end
        end
        if ctx.UpdateKeybindsHUD then pcall(ctx.UpdateKeybindsHUD) end
    end
    task.defer(ConfigSys.ApplySideEffects)
    WindowObj.Unload = function(self)
        if _G.Nexara_CustomUI_Cleanup then
            pcall(_G.Nexara_CustomUI_Cleanup)
        end
    end

    do
        local origApplySideEffects = ConfigSys.ApplySideEffects
        ConfigSys.ApplySideEffects = function(...)
            if origApplySideEffects then origApplySideEffects(...) end
            if Theme._syncMobileButtons then Theme._syncMobileButtons() end
        end
        task.defer(function()
            if Theme._syncMobileButtons then Theme._syncMobileButtons() end
        end)
    end

    if Config.MinimizeUIOnStart then
        MainFrame.Visible = false
        UIState.Visible = false
        WindowObj.Visible = false
        if UIState.Touch or Config.PlatformMode == "Mobile" then
            MobileToggleBtn.Visible = true
        end
    else
        UpdateResponsiveScale()
        task.defer(function()
            UpdateResponsiveScale()
            local openTargetPos = Theme._clampMainPos(UIState.SavedPos or UDim2.new(0.5, 0, 0.5, 0), UIState.BaseScale or 1.0)
            UIState.SavedPos = openTargetPos
            local openStartPos = UDim2.new(openTargetPos.X.Scale, openTargetPos.X.Offset, openTargetPos.Y.Scale, openTargetPos.Y.Offset + 18)
            MainFrame.Position = openStartPos
            MainScale.Scale = (UIState.BaseScale or 1.0) * 0.90
            MainFrame.GroupTransparency = 1
            MainFrame.Visible = true

            TweenService:Create(MainFrame, TweenInfo.new(0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = openTargetPos,
                GroupTransparency = 0
            }):Play()
            TweenService:Create(MainScale, TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = UIState.BaseScale or 1.0
            }):Play()
            task.delay(0.28, function()
                if UIState.Visible and not UIState.Animating then
                    MainScale.Scale = UIState.BaseScale or 1.0
                    Theme._refreshScaledLayouts()
                end
            end)
        end)
    end

    _G.Nexara_CustomUI_Cleanup = function()
        _G.Nexara_IsCapturingKeybind = false
        for _, conn in ipairs(UI_Connections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(UI_Connections)
        if _G._Nexara_UI_InputConns then
            for _, conn in ipairs(_G._Nexara_UI_InputConns) do
                pcall(function() conn:Disconnect() end)
            end
            table.clear(_G._Nexara_UI_InputConns)
        end
        pcall(function() ScreenGui:Destroy() end)
    end
    _G.Nexara_CurrentWindow = WindowObj
    ctx.Window = WindowObj

    return WindowObj
end

local varargs = ...
if type(varargs) == "table" and (varargs.Config or varargs.Window) then
    return CreateNexaraCustomUI(varargs)
end

return CreateNexaraCustomUI({ Config = _G.Nexara_Config or (getgenv and getgenv().Config) or {} })
