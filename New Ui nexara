    local cfgFlyoutOpen = false
    local cfgAnimTok = 0
    local cfgRowCount = 0
    local cfgTargetH = 294
    local function getFlyoutTargetPos()
        local okP, absPos, absSz = pcall(function() return ConfigPill.AbsolutePosition, ConfigPill.AbsoluteSize end)
        if not okP or not absPos then return nil, nil end
        local lx, ly = Theme._toGuiLocal(absPos.X, absPos.Y)
        local bounds = Theme._getGuiBounds()
        local fw = math.min(290, math.max(220, bounds.X - 16))
        local tx = math.clamp(lx - 2, 8, math.max(8, bounds.X - fw - 8))
        local ty = math.clamp(ly + absSz.Y + 4, 8, math.max(8, bounds.Y - cfgTargetH - 8))
        return tx, ty, fw
    end
    local function resizeCfgFlyout(animate)
        local rawH = math.max(CfgListLayout.AbsoluteContentSize.Y, cfgRowCount > 0 and (cfgRowCount * 36 - 4) or 0)
        local listH = math.clamp(rawH + 6, 38, 182)
