        return UDim2.fromOffset(cx, cy)
    end

    local function IsTouchMobileDevice()
        local okP, plat = pcall(function()
            return UserInputService:GetPlatform()
        end)
        if okP and plat ~= nil then
            local pName = tostring(plat)
            if plat == Enum.Platform.Android or plat == Enum.Platform.IOS or pName:find("Android", 1, true) or pName:find("IOS", 1, true) then
                return true
            end
            if plat == Enum.Platform.Windows or plat == Enum.Platform.OSX or pName:find("Windows", 1, true) or pName:find("OSX", 1, true) or pName:find("Linux", 1, true) or pName:find("UWP", 1, true) then
                return UserInputService.TouchEnabled and (not UserInputService.MouseEnabled) and (not UserInputService.KeyboardEnabled)
            end
        end
        if not UserInputService.TouchEnabled then
            return false
        end
        if not UserInputService.MouseEnabled or not UserInputService.KeyboardEnabled then
            return true
        end
        local okLast, lastType = pcall(function()
            return UserInputService:GetLastInputType()
        end)
        if okLast and lastType == Enum.UserInputType.Touch then
            return true
        end
        local cam = workspace.CurrentCamera
        if cam and cam.ViewportSize.Y > 0 and cam.ViewportSize.Y < 620 then
            return true
        end
        return UserInputService.AccelerometerEnabled == true
    end

