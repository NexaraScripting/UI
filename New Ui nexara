    local function trText(s, lang)
        if lang ~= "TH" then return s end
        if TH_MAP[s] then return TH_MAP[s] end
        local a, b = s:match("^(.-)%s+>%s+(.-)$")
        if a and b then
            return (TH_MAP[a] or a) .. "  >  " .. (TH_MAP[b] or b)
        end
        return s
    end

    local function ApplyLanguage(lang)
        lang = (lang == "TH") and "TH" or "EN"
        Config.UI_Language = lang
        LangBtn.Text = lang
        LangBtn.TextColor3 = (lang == "TH") and Color3.fromRGB(255, 255, 255) or Theme.TextDim
        LangStroke.Color = (lang == "TH") and Theme.Accent or Theme.CardStroke
        if SearchInput then
            local origPh = SearchInput:GetAttribute("Nexara_OrigPh")
            if not origPh then
                origPh = SearchInput.PlaceholderText
                SearchInput:SetAttribute("Nexara_OrigPh", origPh)
            end
            SearchInput.PlaceholderText = trText(origPh, lang)
        end
        for _, inst in ipairs(MainFrame:GetDescendants()) do
            if inst ~= LangBtn and (inst:IsA("TextLabel") or inst:IsA("TextButton")) then
                local orig = inst:GetAttribute("Nexara_OrigEN")
                if not orig then
                    local cur = inst.Text
                    if type(cur) == "string" and (TH_MAP[cur] or cur:find("  >  ", 1, true)) then
                        orig = cur
                        inst:SetAttribute("Nexara_OrigEN", orig)
                    end
                end
                if orig then
                    inst.Text = trText(orig, lang)
                end
            end
        end
    end

