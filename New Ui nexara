                    TweenService:Create(SliderKnob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(15, 15) }):Play()
                end
            end)
            Row.MouseLeave:Connect(function()
                isHovering = false
                TweenService:Create(Row, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
                TweenService:Create(RowStroke, TweenInfo.new(0.18), { Transparency = 1 }):Play()
                if SliderKnob and not draggingSlider then
                    TweenService:Create(SliderKnob, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(12, 12) }):Play()
                end
            end)

            local SliderHitBox = Instance.new("TextButton")
            SliderHitBox.Name = "SliderHitBox"
            SliderHitBox.Size = UDim2.new(1, 0, 0, 26)
            SliderHitBox.Position = UDim2.new(0, 0, 0, 15)
            SliderHitBox.BackgroundTransparency = 1
            SliderHitBox.Text = ""
            SliderHitBox.AutoButtonColor = false
            SliderHitBox.Active = true
            SliderHitBox.ZIndex = 5
            SliderHitBox.Parent = Row

            local draggingSlider = false
            local lastVal = initVal

            local function SetSliderVal(val, silent)
                val = math.floor(math.clamp(tonumber(val) or minVal, minVal, maxVal) + 0.5)
                local snapRel = (maxVal > minVal) and ((val - minVal) / (maxVal - minVal)) or 0
                ValueText.Text = tostring(val) .. unit
                TweenService:Create(SliderFill, TweenInfo.new(0.09, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Size = UDim2.new(snapRel, 0, 1, 0)
                }):Play()
                TweenService:Create(SliderKnob, TweenInfo.new(0.09, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Position = UDim2.new(snapRel, 0, 0.5, 0)
                }):Play()
                if val ~= lastVal then
                    lastVal = val
                    if not silent then
                        if onChange then pcall(onChange, val) end
                        ConfigSys.ScheduleAutoSave()
                    end
                end
            end

            local function UpdateSlider(x)
                local absX = SliderTrack.AbsolutePosition.X
                local absW = SliderTrack.AbsoluteSize.X
                if absW <= 0 then return end
                local rel = math.clamp((x - absX) / absW, 0, 1)
                local val = math.floor(minVal + ((maxVal - minVal) * rel) + 0.5)
                SetSliderVal(val, false)
            end

            local function StartDrag(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = true
                    TweenService:Create(SliderKnob, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Size = UDim2.fromOffset(17, 17)
                    }):Play()
                    UpdateSlider(input.Position.X)
                end
            end

            local function EndDrag(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingSlider then
                        draggingSlider = false
                        local returnSize = isHovering and UDim2.fromOffset(15, 15) or UDim2.fromOffset(12, 12)
                        TweenService:Create(SliderKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                            Size = returnSize
                        }):Play()
                    end
                end
            end

            SliderHitBox.InputBegan:Connect(StartDrag)
            SliderTrack.InputBegan:Connect(StartDrag)
            SliderKnob.InputBegan:Connect(StartDrag)

            UserInputService.InputChanged:Connect(function(input)
                if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(EndDrag)
            SliderHitBox.InputEnded:Connect(EndDrag)

            return {
                Set = SetSliderVal,
                Get = function() return lastVal end
            }
        end

