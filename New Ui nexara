        local function getBoundsSize()
            if ScreenGui and ScreenGui.AbsoluteSize.X > 0 and ScreenGui.AbsoluteSize.Y > 0 then
                return ScreenGui.AbsoluteSize
            end
            local cam = workspace.CurrentCamera
            return cam and cam.ViewportSize or Vector2.new(1280, 720)
        end

        local function applyClampPos()
            local bounds = getBoundsSize()
            local bw, bh = 132, 34
            local sx = tonumber(Config[xKey])
            local sy = tonumber(Config[yKey])
            local defX = math.max(8, bounds.X - bw - 16)
            local defY = math.clamp(96 + (orderIdx - 1) * 42, 48, math.max(48, bounds.Y - bh - 12))
            local px = math.clamp(sx or defX, 4, math.max(4, bounds.X - bw - 4))
            local py = math.clamp(sy or defY, 4, math.max(4, bounds.Y - bh - 4))
            Btn.Position = UDim2.fromOffset(math.floor(px + 0.5), math.floor(py + 0.5))
        end

        local function syncState()
            if not (Btn and Btn.Parent) then return end
            local active = (getStateFn() == true)
            Btn.BackgroundColor3 = active and Theme.Sidebar:Lerp(Theme.Accent, 0.14) or Theme.Sidebar
            Stroke.Color = active and Theme.Accent or Theme.FlyoutStroke
