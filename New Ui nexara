            TweenService:Create(CfgFlyout, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = targetPos }):Play()
        else
            CfgFlyout.Position = targetPos
        end
    end

    local function rebuildCfgFlyoutList(animate)
        for _, ch in ipairs(CfgScroll:GetChildren()) do
            if ch:IsA("Frame") or ch:IsA("TextButton") then ch:Destroy() end
        end
        local q = CfgSearchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        local active = ConfigSys.CurrentProfile or "Default"
        local autoProf = ConfigSys.AutoloadProfile
        local names = ConfigSys.GetProfileList()
        local order = 0
        for _, name in ipairs(names) do
            if q == "" or name:lower():find(q, 1, true) then
                order = order + 1
                local isActive = (name == active)
                local isAuto = (autoProf == name)
                local hasDel = (name ~= "Default")
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, -2, 0, 32)
                row.BackgroundColor3 = isActive and Color3.fromRGB(34, 36, 50) or Theme.Input
                row.BorderSizePixel = 0
                row.LayoutOrder = isAuto and 0 or order
                row.ZIndex = 132
                row.Parent = CfgScroll
                local rCor = Instance.new("UICorner"); rCor.CornerRadius = UDim.new(0, 7); rCor.Parent = row
                local rStr = Instance.new("UIStroke")
                rStr.Color = isActive and Theme.Accent or Theme.CardStroke
                rStr.Thickness = isActive and 1.2 or 1
                rStr.Transparency = isActive and 0.2 or 0.55
                rStr.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                rStr.Parent = row

                local loadHit = Instance.new("TextButton")
                loadHit.Text = ""
                loadHit.Size = UDim2.new(1, hasDel and -106 or -80, 1, 0)
                loadHit.BackgroundTransparency = 1
                loadHit.AutoButtonColor = false
                loadHit.ZIndex = 133
                loadHit.Parent = row
                local rLbl = Instance.new("TextLabel")
                rLbl.Size = UDim2.new(1, -12, 1, 0)
                rLbl.Position = UDim2.new(0, 10, 0, 0)
                rLbl.BackgroundTransparency = 1
                rLbl.Font = isActive and Enum.Font.GothamBold or Enum.Font.GothamMedium
                rLbl.TextSize = 11.5
                rLbl.TextColor3 = isActive and Theme.Text or Theme.TextDim
                rLbl.TextXAlignment = Enum.TextXAlignment.Left
                rLbl.TextTruncate = Enum.TextTruncate.AtEnd
                rLbl.Text = name
                rLbl.ZIndex = 134
                rLbl.Parent = loadHit
                loadHit.MouseButton1Click:Connect(function()
                    if ConfigSys.FlushAutoSave then ConfigSys.FlushAutoSave() end
                    ConfigSys.LoadProfile(name, false)
                    if ConfigSys.OnProfilesChanged then pcall(ConfigSys.OnProfilesChanged) end
                    if Theme.RefreshTopConfigUI then Theme.RefreshTopConfigUI() end
                    showCfgToast("Loaded: " .. name, false)
                end)

                local starB, _ = makeMiniIconBtn(row, "rbxassetid://10734966248", hasDel and -104 or -78, 133, isAuto and Color3.fromRGB(250, 200, 75) or nil)
                if isAuto then starB.BackgroundColor3 = Color3.fromRGB(58, 48, 22) end
                starB.MouseButton1Click:Connect(function()
                    if ConfigSys.AutoloadProfile == name then
                        ConfigSys.AutoloadProfile = "none"
                        writeAutoloadFile("none")
                        showCfgToast("Unfollowed: " .. name, false)
                    else
                        ConfigSys.AutoloadProfile = name
                        writeAutoloadFile(name)
                        if ConfigSys.CurrentProfile ~= name then
                            if ConfigSys.FlushAutoSave then ConfigSys.FlushAutoSave() end
                            ConfigSys.LoadProfile(name, false)
                        end
                        showCfgToast("Followed & Auto-load: " .. name, false)
                    end
                    if ConfigSys.OnProfilesChanged then pcall(ConfigSys.OnProfilesChanged) end
                    if Theme.RefreshTopConfigUI then Theme.RefreshTopConfigUI() end
                end)
                local shareB, shareIc = makeMiniIconBtn(row, "rbxassetid://10709812159", hasDel and -78 or -52, 133)
                shareB.MouseButton1Click:Connect(function()
                    local code, err = ConfigSys.ExportShareCode(name)
                    if code then
                        local clipFn = setclipboard or toclipboard or set_clipboard
                        if clipFn then pcall(clipFn, code) end
                        flashIconCheck(shareIc, "rbxassetid://10709812159", Theme.TextDim)
                        showCfgToast(clipFn and ("Copied code (" .. tostring(#code) .. " chars)") or "Clipboard unsupported", not clipFn)
                    else
                        showCfgToast(err or "Export failed", true)
                    end
                end)
                local saveB, saveIc = makeMiniIconBtn(row, "rbxassetid://10734941499", hasDel and -52 or -26, 133)
                saveB.MouseButton1Click:Connect(function()
                    ConfigSys.CurrentProfile = name
                    ConfigSys.SaveProfile(name)
                    flashIconCheck(saveIc, "rbxassetid://10734941499", Theme.TextDim)
                    if ConfigSys.OnProfilesChanged then pcall(ConfigSys.OnProfilesChanged) end
                    if Theme.RefreshTopConfigUI then Theme.RefreshTopConfigUI() end
                    showCfgToast("Saved: " .. name, false)
                end)
                if hasDel then
                    local delB, _ = makeMiniIconBtn(row, "rbxassetid://10747362393", -26, 133)
                    delB.MouseButton1Click:Connect(function()
                        pcall(function()
                            local pth = ConfigSys.Folder .. "/" .. name .. ".json"
                            if delfile and isfile and isfile(pth) then delfile(pth) end
                        end)
                        if ConfigSys.AutoloadProfile == name then
                            ConfigSys.AutoloadProfile = "none"
                            local accP, globP = ConfigSys.GetAutoloadPaths()
                            pcall(function()
                                if delfile and isfile and isfile(accP) then delfile(accP) end
                                if delfile and isfile and isfile(globP) then delfile(globP) end
                            end)
                        end
                        if ConfigSys.CurrentProfile == name then
                            ConfigSys.CurrentProfile = "Default"
                        end
                        if ConfigSys.OnProfilesChanged then pcall(ConfigSys.OnProfilesChanged) end
                        if Theme.RefreshTopConfigUI then Theme.RefreshTopConfigUI() end
                        showCfgToast("Deleted: " .. name, false)
                    end)
                end
            end
        end
        cfgRowCount = order
        syncCfgFooter()
        resizeCfgFlyout(animate)
        if cfgFlyoutOpen then positionCfgFlyout(animate) end
    end

