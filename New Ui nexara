    local function UpdateResponsiveScale()
        local vp = Theme._getGuiBounds()
        local isMobile = (Config.PlatformMode == "Mobile") or (UIState.Touch and Config.PlatformMode ~= "PC") or (UIState.Touch and not UIState.UserSetPlatform)

        if isMobile then
            -- Adapt both scale and logical aspect to fit any phone/tablet without shrinking fonts to unreadable sizes.
            local availW = math.max(280, math.min(vp.X - 18, vp.X * 0.92))
            local availH = math.max(220, math.min(vp.Y - 14, vp.Y * 0.90))
            local s = math.clamp(math.min(availW / 860, availH / 390), 0.72, 1.0)
            local fw = math.min(900, math.max(340, math.floor(availW / s)))
            local fh = math.min(560, math.max(220, math.floor(availH / s)))
            local sw = (fw >= 840) and 205 or ((fw >= 660) and 178 or 155)
            UIState.BaseScale = s
            UIState.FrameW = fw
            UIState.FrameH = fh
            UIState.SidebarW = sw
            UIState.StackCols = ((fw - (sw + 30)) < 460)
        elseif vp.X < 940 or vp.Y < 600 then
            local availW = math.max(300, vp.X - 40)
            local availH = math.max(260, vp.Y - 40)
            UIState.BaseScale = math.clamp(math.min(availW / 900, availH / 560), 0.45, 1.0)
            UIState.FrameW = 900
            UIState.FrameH = 560
            UIState.SidebarW = 205
            UIState.StackCols = false
        else
            UIState.BaseScale = 1.0
            UIState.FrameW = 900
            UIState.FrameH = 560
            UIState.SidebarW = 205
            UIState.StackCols = false
        end
        Theme._applyResponsiveGeometry()
        if not UIState.Animating then
            MainScale.Scale = UIState.BaseScale
            MainFrame.Position = Theme._clampMainPos(MainFrame.Position, UIState.BaseScale)
            UIState.SavedPos = MainFrame.Position
        end
        if MobileToggleBtn then
            MobileToggleBtn.Position = Theme._clampMobBtnPos(MobileToggleBtn.Position)
        end
        task.defer(Theme._refreshScaledLayouts)
        if Theme and Theme._syncMobileButtons then
            Theme._syncMobileButtons()
        end
    end

