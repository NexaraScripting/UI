    function Theme._applyResponsiveGeometry()
        local fw = UIState.FrameW or 900
        local fh = UIState.FrameH or 560
        local sw = UIState.SidebarW or 205
        MainFrame.Size = UDim2.fromOffset(fw, fh)
        local t = UIState.LayoutTargets
        if t.Sidebar then t.Sidebar.Size = UDim2.new(0, sw, 1, 0) end
        if t.TopBar then
            t.TopBar.Size = UDim2.new(1, -sw, 0, 52)
            t.TopBar.Position = UDim2.new(0, sw, 0, 0)
        end
        if t.SearchFrame then
            local availMid = (fw - sw) - 62 - 134
            if t.ConfigPill then
                if availMid < 164 then
                    t.SearchFrame.Visible = false
                    local pillW = math.clamp(availMid, 82, 160)
                    t.ConfigPill.Position = UDim2.new(0, 62, 0.5, -16)
                    t.ConfigPill.Size = UDim2.new(0, pillW, 0, 32)
                else
                    t.SearchFrame.Visible = true
                    local pillW = math.clamp(math.floor(availMid * 0.36), 88, 168)
                    local searchW = math.clamp(availMid - pillW - 10, 68, 250)
                    t.SearchFrame.Size = UDim2.new(0, searchW, 0, 32)
                    t.ConfigPill.Position = UDim2.new(0, 62 + searchW + 10, 0.5, -16)
                    t.ConfigPill.Size = UDim2.new(0, pillW, 0, 32)
                end
            else
                t.SearchFrame.Visible = true
                t.SearchFrame.Size = UDim2.new(0, math.clamp((fw - sw) - 150, 80, 260), 0, 32)
            end
        end
        if t.Breadcrumb then
            t.Breadcrumb.Size = UDim2.new(1, -(sw + 35), 0, 24)
            t.Breadcrumb.Position = UDim2.new(0, sw + 15, 0, 52)
        end
        if t.Content then
            t.Content.Size = UDim2.new(1, -(sw + 30), 1, -82)
            t.Content.Position = UDim2.new(0, sw + 15, 0, 78)
        end
    end

    local function SafeMainAccess()
        EnsureCap()
        if pcall(function() return MainFrame.Position end) then return true end
        -- Re-parent ScreenGui to PlayerGui if this callback thread lacks CoreGui/gethui Plugin capability.
        pcall(function()
            local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pg and ScreenGui then ScreenGui.Parent = pg end
        end)
        return pcall(function() return MainFrame.Position end)
    end

    local function UpdateResponsiveScale()
        local vp = Theme._getGuiBounds()
        local isMobile = (Config.PlatformMode == "Mobile") or (UIState.Touch and Config.PlatformMode ~= "PC") or (UIState.Touch and not UIState.UserSetPlatform)

        if isMobile then
            -- Keep compact ~65-74% phone footprint while preserving readable 0.58-0.74 UIScale text/tap sizes.
            local isPhone = (vp.Y < 600) or (vp.X < 920)
            local availW = isPhone and math.max(260, math.min(vp.X - 28, vp.X * 0.68)) or math.max(420, math.min(vp.X - 48, vp.X * 0.72))
            local availH = isPhone and math.max(200, math.min(vp.Y - 20, vp.Y * 0.74)) or math.max(300, math.min(vp.Y - 48, vp.Y * 0.70))
            local s = isPhone
                and math.clamp(math.min(availW / 780, availH / 390), 0.58, 0.74)
                or math.clamp(math.min(availW / 900, availH / 560), 0.62, 0.85)
            local fw = math.min(900, math.max(360, math.floor(availW / s)))
            local fh = math.min(560, math.max(240, math.floor(availH / s)))
            local sw = (fw >= 840) and 205 or ((fw >= 660) and 178 or 155)
            UIState.BaseScale = s
            UIState.FrameW = fw
            UIState.FrameH = fh
            UIState.SidebarW = sw
            UIState.StackCols = ((fw - (sw + 30)) < 460)
        elseif vp.X < 940 or vp.Y < 600 then
            local availW = math.max(300, vp.X - 40)
            local availH = math.max(260, vp.Y - 40)
            UIState.BaseScale = math.clamp(math.min(availW / 900, availH / 560), 0.45, 1.0)
            UIState.FrameW = 900
            UIState.FrameH = 560
            UIState.SidebarW = 205
            UIState.StackCols = false
        else
            UIState.BaseScale = 1.0
            UIState.FrameW = 900
            UIState.FrameH = 560
            UIState.SidebarW = 205
            UIState.StackCols = false
        end
        SafeMainAccess()
        Theme._applyResponsiveGeometry()
        if not UIState.Animating then
            pcall(function()
                MainScale.Scale = UIState.BaseScale
                MainFrame.Position = Theme._clampMainPos(MainFrame.Position, UIState.BaseScale)
                UIState.SavedPos = MainFrame.Position
            end)
        end
        if MobileToggleBtn then
            pcall(function()
                MobileToggleBtn.Position = Theme._clampMobBtnPos(MobileToggleBtn.Position)
            end)
        end
        task.defer(Theme._refreshScaledLayouts)
        if Theme and Theme._syncMobileButtons then
            Theme._syncMobileButtons()
        end
    end

