local function CreateNexaraCustomUI(ctx)
    ctx = ctx or {}
    local Config = ctx.Config or _G.Nexara_Config or (getgenv and getgenv().Config) or {}
    local ApplyFullbrightNow = ctx.ApplyFullbrightNow
    local RestoreOriginalLighting = ctx.RestoreOriginalLighting
    local ApplyCustomRedStainNow = ctx.ApplyCustomRedStainNow
    local TofCombat = ctx.TofCombat or _G.TofCombat or (getgenv and getgenv().TofCombat) or _G.Nexara_VD_TofCombat or {}
    local AutoParry = ctx.AutoParry or _G.AutoParry or (getgenv and getgenv().AutoParry) or _G.Nexara_VD_AutoParry or {}
    local PumpkinAuras = ctx.PumpkinAuras
    _G.Nexara_IsCapturingKeybind = false

    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local ConfigSys = {
        Folder = "Nexara Studio Config",
        CurrentProfile = "Default",
        AutoloadProfile = "none",
        Restoring = false,
        SaveToken = 0,
        SyncHandlers = {},
        KeyedWidgets = {},
    }
    do
        local HttpService = game:GetService("HttpService")
        function ConfigSys.FormatKey(key)
            if not key then return "None" end
            if key == Enum.UserInputType.MouseButton3 or key == "MouseButton3" or key == "MB3" then
                return "MB3"
            end
            if typeof(key) == "EnumItem" then return key.Name end
            return tostring(key)
        end
        function ConfigSys.ResolveKey(rawCode, rawName)
            if typeof(rawCode) == "EnumItem" then return rawCode end
            local n = (type(rawName) == "string") and rawName or (type(rawCode) == "string" and rawCode or nil)
            if not n or n == "" or n == "None" then return nil end
            if n == "MB3" or n == "Middle Click" or n == "MouseButton3" then
                return Enum.UserInputType.MouseButton3
            end
            local ok, res = pcall(function() return Enum.KeyCode[n] end)
            if ok and typeof(res) == "EnumItem" then return res end
            return nil
        end
        function ConfigSys.Serialize(tbl)
            local out = {}
            for k, v in pairs(tbl) do
                local tv = typeof(v)
                if tv == "Color3" then
                    out[k] = { __type = "Color3", R = v.R, G = v.G, B = v.B }
                elseif tv == "EnumItem" then
                    out[k] = { __type = "EnumItem", EnumType = tostring(v.EnumType), Name = v.Name }
                elseif tv == "boolean" or tv == "number" or tv == "string" then
                    out[k] = v
                end
            end
            return out
        end
        function ConfigSys.Deserialize(v)
            if type(v) == "table" and v.__type == "Color3" then
                return Color3.new(tonumber(v.R) or 1, tonumber(v.G) or 1, tonumber(v.B) or 1)
            elseif type(v) == "table" and v.__type == "EnumItem" and v.EnumType and v.Name then
                local enumName = tostring(v.EnumType):gsub("^Enum%.", "")
                local ok, res = pcall(function() return Enum[enumName][v.Name] end)
                if ok and res then return res end
            end
            return v
        end
        function ConfigSys.NormalizeConfig()
            for _, p in ipairs({ "Tof_Aim", "Veil_Aim", "AutoParry_" }) do
                local kc = ConfigSys.ResolveKey(Config[p .. "KeyCode"], Config[p .. "KeyName"])
                Config[p .. "KeyCode"] = kc
                if kc then
                    Config[p .. "KeyName"] = ConfigSys.FormatKey(kc)
                    Config[p .. "KeyType"] = (kc.EnumType == Enum.UserInputType) and "Mouse" or "Keyboard"
                else
                    Config[p .. "KeyName"] = "None"
                    Config[p .. "KeyType"] = "None"
                end
            end
            local mKey = ConfigSys.ResolveKey(Config.MenuToggleKey, type(Config.MenuToggleKey) == "string" and Config.MenuToggleKey or nil)
            Config.MenuToggleKey = mKey or Enum.KeyCode.RightControl
            if Config.NoFog ~= nil or Config.RemoveFog ~= nil then
                local nf = (Config.NoFog == true or Config.RemoveFog == true)
                Config.NoFog = nf
                Config.RemoveFog = nf
            end
            if Config.CustomFOV ~= nil or Config.CustomFOVEnabled ~= nil then
                local cf = (Config.CustomFOVEnabled == true or Config.CustomFOV == true)
                Config.CustomFOV = cf
                Config.CustomFOVEnabled = cf
            end
            if Config.FOVValue ~= nil or Config.FOV ~= nil then
                local fv = Config.FOV or Config.FOVValue or 80
                Config.FOV = fv
                Config.FOVValue = fv
            end
            if Config.Speed_Enabled ~= nil or Config.SpeedHack ~= nil then
                local se = (Config.Speed_Enabled == true or Config.SpeedHack == true)
                Config.Speed_Enabled = se
                Config.SpeedHack = se
            end
            if Config.Speed_Value ~= nil or Config.SpeedValue ~= nil then
                local sv = Config.Speed_Value or Config.SpeedValue or 26
                Config.Speed_Value = sv
                Config.SpeedValue = sv
            end
            if Config.ESP_WindowAura ~= nil or Config.ESP_WindowChams ~= nil then
                local wc = (Config.ESP_WindowAura == true or Config.ESP_WindowChams == true)
                Config.ESP_WindowAura = wc
                Config.ESP_WindowChams = wc
            end
            if Config.ESP_SurvivorSkills ~= nil or Config.ESP_SurvivorCooldown ~= nil then
                local sc = (Config.ESP_SurvivorSkills == true or Config.ESP_SurvivorCooldown == true)
                Config.ESP_SurvivorSkills = sc
                Config.ESP_SurvivorCooldown = sc
            end
            if Config.ConfigAutoSaveEnabled == nil then Config.ConfigAutoSaveEnabled = true end
            if Config.AvatarCopy_Enabled == nil then Config.AvatarCopy_Enabled = false end
            if Config.AvatarCopy_Username == nil then Config.AvatarCopy_Username = "" end
            if Config.AvatarCopy_BlurName == nil then Config.AvatarCopy_BlurName = false end
            if type(Config.AvatarCopy_SavedNames) ~= "table" then Config.AvatarCopy_SavedNames = {} end
        end
        function ConfigSys.GetAutoloadPaths()
            local uid = LocalPlayer and tostring(LocalPlayer.UserId) or "0"
            return ConfigSys.Folder .. "/autoload_" .. uid .. ".txt", ConfigSys.Folder .. "/autoload.txt"
        end
        function ConfigSys.SaveProfile(name)
            local ok = false
            pcall(function()
                if makefolder and isfolder and not isfolder(ConfigSys.Folder) then
                    makefolder(ConfigSys.Folder)
                end
                if writefile then
                    local prof = (name and name ~= "" and name) or ConfigSys.CurrentProfile or "Default"
                    local data = HttpService:JSONEncode(ConfigSys.Serialize(Config))
                    writefile(ConfigSys.Folder .. "/" .. prof .. ".json", data)
                    ok = true
                end
            end)
            return ok
        end
        function ConfigSys.ScheduleAutoSave()
            if ConfigSys.Restoring or Config.ConfigAutoSaveEnabled == false then return end
            ConfigSys.SaveToken = ConfigSys.SaveToken + 1
            local tok = ConfigSys.SaveToken
            task.delay(0.15, function()
                if tok ~= ConfigSys.SaveToken or ConfigSys.Restoring or Config.ConfigAutoSaveEnabled == false then return end
                ConfigSys.SaveProfile(ConfigSys.CurrentProfile or "Default")
            end)
        end
        _G.Nexara_ScheduleAutoSave = ConfigSys.ScheduleAutoSave
        function ConfigSys.LoadProfile(name, isStartup)
            local loaded = false
            local prof = (name and name ~= "" and name) or "Default"
            local path = ConfigSys.Folder .. "/" .. prof .. ".json"
            if not (readfile and isfile and isfile(path)) then return false end
            ConfigSys.Restoring = true
            pcall(function()
                local data = HttpService:JSONDecode(readfile(path))
                if type(data) == "table" then
                    if not isStartup then
                        Config.SelectedWorldPreset = nil
                    end
                    for k, v in pairs(data) do
                        Config[k] = ConfigSys.Deserialize(v)
                    end
                    ConfigSys.CurrentProfile = prof
                    loaded = true
                end
            end)
            ConfigSys.NormalizeConfig()
            if loaded and not isStartup then
                for _, fn in ipairs(ConfigSys.SyncHandlers) do
                    pcall(fn)
                end
                if ConfigSys.ApplySideEffects then pcall(ConfigSys.ApplySideEffects) end
                if ConfigSys.UpdateStatusLabel then pcall(ConfigSys.UpdateStatusLabel) end
            end
            ConfigSys.Restoring = false
            return loaded
        end
        pcall(function()
            if makefolder and isfolder and not isfolder(ConfigSys.Folder) then
                makefolder(ConfigSys.Folder)
            end
            local accPath, globalPath = ConfigSys.GetAutoloadPaths()
            local autoName, autoMode
            if isfile and isfile(accPath) then
                autoName = readfile(accPath)
                autoMode = "Current account only"
            elseif isfile and isfile(globalPath) then
                autoName = readfile(globalPath)
                autoMode = "All accounts"
            end
            local explicitNone = false
            if autoName then
                autoName = autoName:gsub("^%s+", ""):gsub("%s+$", "")
                if autoName == "none" then
                    explicitNone = true
                elseif autoName ~= "" then
                    ConfigSys.AutoloadProfile = autoName
                    if autoMode then Config.AutoloadMode = autoMode end
                    ConfigSys.LoadProfile(autoName, true)
                    if autoMode then Config.AutoloadMode = autoMode end
                    return
                end
            end
            if not explicitNone and isfile and readfile and isfile(ConfigSys.Folder .. "/Default.json") then
                local okDef, defData = pcall(function()
                    return HttpService:JSONDecode(readfile(ConfigSys.Folder .. "/Default.json"))
                end)
                if okDef and type(defData) == "table" and defData.ConfigAutoSaveEnabled ~= false then
                    ConfigSys.LoadProfile("Default", true)
                end
            end
        end)
    end

    local function ApplyNexaraNameBlur(guiObj, enabled)
        if not guiObj then return end
        local isTextObj = false
        pcall(function()
            isTextObj = guiObj:IsA("TextLabel") or guiObj:IsA("TextBox") or guiObj:IsA("TextButton")
        end)
        if not isTextObj then return end
        local txt = tostring(guiObj.Text or "")
        local shouldBlur = (enabled == true) and (txt ~= "") and (txt ~= "None")
        if shouldBlur then
            if guiObj:GetAttribute("Nexara_OrigTextTrans") == nil then
                guiObj:SetAttribute("Nexara_OrigTextTrans", guiObj.TextTransparency)
            end
            if guiObj:GetAttribute("Nexara_OrigStrokeTrans") == nil then
                guiObj:SetAttribute("Nexara_OrigStrokeTrans", guiObj.TextStrokeTransparency)
            end
            guiObj.TextTransparency = 1
            guiObj.TextStrokeTransparency = 1
            local blurFrame = guiObj:FindFirstChild("Nexara_NameBlur")
            local tSize = tonumber(guiObj.TextSize) or 12
            local charCount = math.clamp(#txt, 4, 20)
            local tbW = 0
            pcall(function()
                if guiObj.TextBounds and guiObj.TextBounds.X > 4 then
                    tbW = guiObj.TextBounds.X
                end
            end)
            local estW = math.floor(charCount * math.max(6.2, tSize * 0.54))
            local w = math.clamp((tbW > 0 and math.ceil(tbW) or estW), 44, 160)
            local h = math.clamp(math.floor(tSize + 4), 12, 20)
            if not blurFrame then
                blurFrame = Instance.new("Frame")
                blurFrame.Name = "Nexara_NameBlur"
                blurFrame.BackgroundTransparency = 1
                blurFrame.BorderSizePixel = 0
                local blurCol = Color3.fromRGB(220, 225, 235)
                local outerHalo = Instance.new("Frame")
                outerHalo.Name = "OuterHalo"
                outerHalo.Size = UDim2.new(1, 16, 1, 10)
                outerHalo.Position = UDim2.fromOffset(-8, -5)
                outerHalo.BackgroundColor3 = blurCol
                outerHalo.BackgroundTransparency = 0.85
                outerHalo.BorderSizePixel = 0
                outerHalo.Parent = blurFrame
                local ohCorner = Instance.new("UICorner")
                ohCorner.CornerRadius = UDim.new(1, 0)
                ohCorner.Parent = outerHalo
                local ohGrad = Instance.new("UIGradient")
                ohGrad.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.14, 0.2),
                    NumberSequenceKeypoint.new(0.86, 0.2),
                    NumberSequenceKeypoint.new(1, 1),
                })
                ohGrad.Parent = outerHalo
                local midHalo = Instance.new("Frame")
                midHalo.Name = "MidHalo"
                midHalo.Size = UDim2.new(1, 8, 1, 6)
                midHalo.Position = UDim2.fromOffset(-4, -3)
                midHalo.BackgroundColor3 = blurCol
                midHalo.BackgroundTransparency = 0.70
                midHalo.BorderSizePixel = 0
                midHalo.Parent = blurFrame
                local mhCorner = Instance.new("UICorner")
                mhCorner.CornerRadius = UDim.new(1, 0)
                mhCorner.Parent = midHalo
                local mhGrad = Instance.new("UIGradient")
                mhGrad.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 1),
                    NumberSequenceKeypoint.new(0.10, 0.1),
                    NumberSequenceKeypoint.new(0.90, 0.1),
                    NumberSequenceKeypoint.new(1, 1),
                })
                mhGrad.Parent = midHalo
                local coreBar = Instance.new("Frame")
                coreBar.Name = "CoreBar"
                coreBar.Size = UDim2.new(1, 0, 0.76, 0)
                coreBar.Position = UDim2.new(0, 0, 0.12, 0)
                coreBar.BackgroundColor3 = blurCol
                coreBar.BackgroundTransparency = 0.48
                coreBar.BorderSizePixel = 0
                coreBar.Parent = blurFrame
                local cbCorner = Instance.new("UICorner")
                cbCorner.CornerRadius = UDim.new(1, 0)
                cbCorner.Parent = coreBar
                local cbGrad = Instance.new("UIGradient")
                cbGrad.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.9),
                    NumberSequenceKeypoint.new(0.08, 0),
                    NumberSequenceKeypoint.new(0.48, 0.18),
                    NumberSequenceKeypoint.new(0.76, 0),
                    NumberSequenceKeypoint.new(0.92, 0.12),
                    NumberSequenceKeypoint.new(1, 0.9),
                })
                cbGrad.Parent = coreBar
                for idx, spec in ipairs({
                    { Name = "Blob1", Pos = UDim2.new(0.05, 0, 0.2, 0), Size = UDim2.new(0.32, 0, 0.6, 0) },
                    { Name = "Blob2", Pos = UDim2.new(0.36, 0, 0.18, 0), Size = UDim2.new(0.34, 0, 0.64, 0) },
                    { Name = "Blob3", Pos = UDim2.new(0.69, 0, 0.22, 0), Size = UDim2.new(0.25, 0, 0.56, 0) },
                }) do
                    local blob = Instance.new("Frame")
                    blob.Name = spec.Name
                    blob.Position = spec.Pos
                    blob.Size = spec.Size
                    blob.BackgroundColor3 = blurCol
                    blob.BackgroundTransparency = 0.36
                    blob.BorderSizePixel = 0
                    blob.Parent = blurFrame
                    local bCorner = Instance.new("UICorner")
                    bCorner.CornerRadius = UDim.new(1, 0)
                    bCorner.Parent = blob
                end
                blurFrame.Parent = guiObj
            end
            if guiObj.TextXAlignment == Enum.TextXAlignment.Left then
                blurFrame.AnchorPoint = Vector2.new(0, 0.5)
                blurFrame.Position = UDim2.new(0, 2, 0.5, 0)
            elseif guiObj.TextXAlignment == Enum.TextXAlignment.Right then
                blurFrame.AnchorPoint = Vector2.new(1, 0.5)
                blurFrame.Position = UDim2.new(1, -2, 0.5, 0)
            else
                blurFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                blurFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            end
            blurFrame.Size = UDim2.fromOffset(w, h)
            blurFrame.ZIndex = (guiObj.ZIndex or 1) + 2
            blurFrame.Visible = true
        else
            local blurFrame = guiObj:FindFirstChild("Nexara_NameBlur")
            if blurFrame then
                blurFrame.Visible = false
            end
            local origT = guiObj:GetAttribute("Nexara_OrigTextTrans")
            if origT ~= nil then
                guiObj.TextTransparency = origT
                guiObj:SetAttribute("Nexara_OrigTextTrans", nil)
            end
            local origS = guiObj:GetAttribute("Nexara_OrigStrokeTrans")
            if origS ~= nil then
                guiObj.TextStrokeTransparency = origS
                guiObj:SetAttribute("Nexara_OrigStrokeTrans", nil)
            end
        end
    end
    _G.Nexara_ApplyNameBlur = ApplyNexaraNameBlur

    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local CoreGui = game:GetService("CoreGui")

    local function EnsureCap()
        pcall(function()
            local g = (type(getgenv) == "function" and getgenv()) or _G
            if setthreadidentity then
                setthreadidentity(8)
            elseif g and g.syn and g.syn.set_thread_identity then
                g.syn.set_thread_identity(8)
            elseif setidentity then
                setidentity(8)
            end
        end)
    end
    EnsureCap()

    _G._Nexara_UI_InputConns = _G._Nexara_UI_InputConns or {}
    local UI_Connections = {}
    local function ConnectUI(event, fn)
        local conn = event:Connect(function(...)
            EnsureCap()
            return fn(...)
        end)
        table.insert(UI_Connections, conn)
        table.insert(_G._Nexara_UI_InputConns, conn)
        return conn
    end

    pcall(function()
        if _G.Nexara_CustomUI_Cleanup then
            local oldClean = _G.Nexara_CustomUI_Cleanup
            _G.Nexara_CustomUI_Cleanup = nil
            oldClean()
        elseif _G._Nexara_UI_InputConns then
            for _, c in ipairs(_G._Nexara_UI_InputConns) do
                pcall(function() c:Disconnect() end)
            end
            table.clear(_G._Nexara_UI_InputConns)
        end
        local parent = (gethui and gethui()) or CoreGui or (LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui"))
        if parent then
            local old = parent:FindFirstChild("Nexara_CustomUI_Screen")
            if old then old:Destroy() end
        end
    end)

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "Nexara_CustomUI_Screen"
    ScreenGui.AutoLocalize = false
    ScreenGui.ResetOnSpawn = false
    ScreenGui.DisplayOrder = 999999
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function()
        if gethui then ScreenGui.Parent = gethui()
        elseif syn and syn.protect_gui then syn.protect_gui(ScreenGui); ScreenGui.Parent = CoreGui
        elseif CoreGui then ScreenGui.Parent = CoreGui
        else ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    end)

    local Theme = {
        Background = Color3.fromRGB(18, 18, 22),
        Sidebar = Color3.fromRGB(13, 13, 17),
        Card = Color3.fromRGB(24, 24, 30),
        CardStroke = Color3.fromRGB(36, 36, 44),
        FlyoutBg = Color3.fromRGB(22, 22, 28),
        FlyoutStroke = Color3.fromRGB(48, 48, 60),
        Accent = Color3.fromRGB(124, 92, 252),
        AccentHover = Color3.fromRGB(145, 115, 255),
        Text = Color3.fromRGB(245, 245, 250),
        TextDim = Color3.fromRGB(160, 160, 175),
        TextMuted = Color3.fromRGB(95, 95, 110),
        Input = Color3.fromRGB(28, 28, 36),
        Track = Color3.fromRGB(36, 36, 46),
        Success = Color3.fromRGB(75, 220, 130),
        Font = "Gotham",
        _fontOptions = {
            "Gotham",
            "BuilderSans",
            "Ubuntu",
            "Nunito",
            "Jura",
            "Roboto",
            "RobotoMono",
            "Code",
            "SourceSans",
            "Arimo",
            "TitilliumWeb",
            "Sarpanch",
            "Michroma",
            "Oswald",
            "FredokaOne",
        },
        _fontCache = {},
        _dropdownPopups = {},
        _accentTargets = {},
        _accentHooks = {},
    }
    do
        local function getFontFaces(fontName)
            local key = tostring(fontName or "Gotham")
            if Theme._fontCache[key] then
                return Theme._fontCache[key], key
            end
            local okEnum, enumItem = pcall(function() return Enum.Font[key] end)
            if not okEnum or typeof(enumItem) ~= "EnumItem" then
                key = "Gotham"
                enumItem = Enum.Font.Gotham
                if Theme._fontCache[key] then
                    return Theme._fontCache[key], key
                end
            end
            local okFam, baseFont = pcall(function() return Font.fromEnum(enumItem) end)
            local family = (okFam and baseFont and baseFont.Family) or Font.fromEnum(Enum.Font.Gotham).Family
            local pack = {
                Regular = Font.new(family, Enum.FontWeight.Regular),
                Medium = Font.new(family, Enum.FontWeight.Medium),
                Bold = Font.new(family, Enum.FontWeight.Bold),
            }
            Theme._fontCache[key] = pack
            return pack, key
        end

        local function readWeightName(inst)
            local attr = inst:GetAttribute("NexaraFontWeight")
            if attr == "Regular" or attr == "Medium" or attr == "Bold" then
                return attr
            end
            local wName = "Regular"
            pcall(function()
                local w = inst.FontFace.Weight
                if w == Enum.FontWeight.Bold or w == Enum.FontWeight.ExtraBold or w == Enum.FontWeight.Heavy then
                    wName = "Bold"
                elseif w == Enum.FontWeight.Medium or w == Enum.FontWeight.SemiBold then
                    wName = "Medium"
                end
            end)
            inst:SetAttribute("NexaraFontWeight", wName)
            return wName
        end

        function Theme.ApplyFontToObject(inst)
            if typeof(inst) ~= "Instance" then return end
            if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then return end
            if inst:GetAttribute("NexaraFontIgnore") then return end
            local wName = readWeightName(inst)
            local faces = getFontFaces(Theme.Font)
            pcall(function()
                inst.FontFace = faces[wName] or faces.Regular
            end)
        end

        function Theme.SetTextWeight(inst, weightName)
            if typeof(inst) ~= "Instance" then return end
            local wName = (weightName == "Bold" or weightName == "Medium") and weightName or "Regular"
            inst:SetAttribute("NexaraFontWeight", wName)
            local faces = getFontFaces(Theme.Font)
            pcall(function()
                inst.FontFace = faces[wName] or faces.Regular
            end)
        end

        local fontContainers = {}
        local hookedFontContainers = {}
        local externalFontTargets = {
            Nexara_ChamsContainer = true,
            Nexara_TopKillerSkillGui = true,
            Nexara_MaskAlertGui = true,
            Nexara_BlindProgressGui = true,
        }

        local function hookFontContainer(container)
            if typeof(container) ~= "Instance" or hookedFontContainers[container] then return end
            hookedFontContainers[container] = true
            table.insert(fontContainers, container)
            for _, d in ipairs(container:GetDescendants()) do
                Theme.ApplyFontToObject(d)
            end
            ConnectUI(container.DescendantAdded, function(inst)
                if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then return end
                if inst:GetAttribute("NexaraFontIgnore") then return end
                Theme.ApplyFontToObject(inst)
                task.defer(function()
                    if not inst or not inst.Parent or inst:GetAttribute("NexaraFontIgnore") then return end
                    local faces = getFontFaces(Theme.Font)
                    local curFam = ""
                    pcall(function() curFam = inst.FontFace.Family end)
                    if curFam ~= faces.Regular.Family then
                        inst:SetAttribute("NexaraFontWeight", nil)
                        Theme.ApplyFontToObject(inst)
                    end
                end)
            end)
        end
        Theme.SyncFontContainer = hookFontContainer

        function Theme.ApplyFont(fontName)
            local _, validName = getFontFaces(fontName)
            Theme.Font = validName
            for i = #fontContainers, 1, -1 do
                local c = fontContainers[i]
                if c and c.Parent then
                    for _, d in ipairs(c:GetDescendants()) do
                        Theme.ApplyFontToObject(d)
                    end
                else
                    hookedFontContainers[c] = nil
                    table.remove(fontContainers, i)
                end
            end
        end

        hookFontContainer(ScreenGui)
        if ScreenGui.Parent then
            for _, ch in ipairs(ScreenGui.Parent:GetChildren()) do
                if ch ~= ScreenGui and externalFontTargets[ch.Name] then
                    hookFontContainer(ch)
                end
            end
            ConnectUI(ScreenGui.Parent.ChildAdded, function(ch)
                if ch ~= ScreenGui and externalFontTargets[ch.Name] then
                    hookFontContainer(ch)
                end
            end)
        end

        function Theme.CloseAllDropdownPopups(exceptPopup)
            for i = #Theme._dropdownPopups, 1, -1 do
                local entry = Theme._dropdownPopups[i]
                if not entry or not entry.popup or not entry.popup.Parent then
                    table.remove(Theme._dropdownPopups, i)
                elseif entry.popup ~= exceptPopup and entry.isOpen() then
                    pcall(entry.close)
                end
            end
        end

        function Theme.HasOpenDropdownPopup()
            for _, entry in ipairs(Theme._dropdownPopups) do
                if entry.popup and entry.popup.Parent and entry.isOpen() then
                    return true
                end
            end
            return false
        end

        function Theme.IsPosInsideOpenDropdownPopup(pos)
            local function hit(gui)
                if typeof(gui) ~= "Instance" or not gui.Parent or not gui.Visible then return false end
                local ap, as = gui.AbsolutePosition, gui.AbsoluteSize
                return pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y
            end
            for _, entry in ipairs(Theme._dropdownPopups) do
                if entry.popup and entry.popup.Parent and entry.isOpen() then
                    if hit(entry.popup) or hit(entry.button) then
                        return true
                    end
                end
            end
            return false
        end

        function Theme.RegisterAccent(obj, prop)
            if typeof(obj) ~= "Instance" or type(prop) ~= "string" then return end
            pcall(function() obj[prop] = Theme.Accent end)
            table.insert(Theme._accentTargets, { obj = obj, prop = prop })
        end
        function Theme.HookAccent(fn)
            if type(fn) ~= "function" then return end
            table.insert(Theme._accentHooks, fn)
        end
        function Theme.ApplyAccent(col)
            if typeof(col) ~= "Color3" then return end
            Theme.Accent = col
            Theme.AccentHover = col:Lerp(Color3.new(1, 1, 1), 0.18)
            for i = #Theme._accentTargets, 1, -1 do
                local t = Theme._accentTargets[i]
                if t.obj and t.obj.Parent then
                    pcall(function() t.obj[t.prop] = col end)
                else
                    table.remove(Theme._accentTargets, i)
                end
            end
            for _, fn in ipairs(Theme._accentHooks) do
                pcall(fn, col)
            end
            if ctx.UpdateKeybindsHUD then pcall(ctx.UpdateKeybindsHUD) end
        end
