    function Theme._clampMainPos(pos, targetScale)
        local vp = Theme._getGuiBounds()
        local s = math.max(targetScale or (MainScale and MainScale.Scale) or 1, 0.25)
        local fw = (UIState and UIState.FrameW) or 900
        local fh = (UIState and UIState.FrameH) or 560
        local halfW = math.floor((fw * 0.5) * s + 0.5)
        local halfH = math.floor((fh * 0.5) * s + 0.5)
        local minX = math.min(halfW + 6, math.floor(vp.X * 0.5))
        local maxX = math.max(minX, math.floor(vp.X - halfW - 6))
        local minY = math.min(halfH + 6, math.floor(vp.Y * 0.5))
        local maxY = math.max(minY, math.floor(vp.Y - halfH - 6))
        local ax = pos.X.Scale * vp.X + pos.X.Offset
        local ay = pos.Y.Scale * vp.Y + pos.Y.Offset
        local cx = math.clamp(ax, minX, maxX)
        local cy = math.clamp(ay, minY, maxY)
        return UDim2.new(0.5, math.floor(cx - vp.X * 0.5 + 0.5), 0.5, math.floor(cy - vp.Y * 0.5 + 0.5))
