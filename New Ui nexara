                    local avatarUid = plr.UserId
                    if plr == LocalPlayer and Config.AvatarCopy_Enabled and _G.Nexara_AvatarManager and _G.Nexara_AvatarManager.ActiveUserId then
                        avatarUid = _G.Nexara_AvatarManager.ActiveUserId
                    end
                    local targetAvatar = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(avatarUid) .. "&w=150&h=150"
                    local isLobby = (ctx.IsInLobby and ctx.IsInLobby()) or (ctx.IsPlayerInLobby and ctx.IsPlayerInLobby(plr)) or (not ctx.IsInLobby and plr.Team ~= nil and (plr.Team.Name == "Spectator" or plr.Team.Name == "Lobby"))
                    local cleanK = nil
