        local function ToggleAccordion(expand)
            if not subtabs or #subtabs == 0 then return end
            if expand ~= nil then
                isExpanded = expand
            else
                isExpanded = not isExpanded
            end
            local targetH = isExpanded and (42 + (#subtabs * 37) + 2) or 42
            TweenService:Create(TabItem, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, targetH)
            }):Play()
        end

