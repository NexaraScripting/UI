    local function SwitchToPage(pageName, parentName, subName)
        if Theme._closeAllFlyouts then pcall(Theme._closeAllFlyouts) end

        local targetGroup = Pages[pageName]
        if not targetGroup then return end
        if targetGroup == CurrentActivePage and targetGroup.Visible then
            return
        end

        currentTransitionId = currentTransitionId + 1
        local myTransitionId = currentTransitionId
        CurrentActivePage = targetGroup

        for _, tw in ipairs(activeTweens) do
            pcall(function() tw:Cancel() end)
        end
        activeTweens = {}

        for name, p in pairs(Pages) do
            if p ~= targetGroup then
                p.Visible = false
            end
        end

        local pageScroll = targetGroup:FindFirstChild("PageScroll")
        if pageScroll then
            pageScroll.CanvasPosition = Vector2.new(0, 0)
        end
        task.defer(Theme._refreshScaledLayouts)

        BreadcrumbLabel.TextTransparency = 0.75
        local rawBc = subName and (parentName .. "  >  " .. subName) or parentName
        BreadcrumbLabel:SetAttribute("Nexara_OrigEN", rawBc)
        BreadcrumbLabel.Text = Theme.TrText and Theme.TrText(rawBc, Config.UI_Language) or rawBc
        local bcTween = TweenService:Create(BreadcrumbLabel, TweenInfo.new(0.38, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
            TextTransparency = 0
        })
        table.insert(activeTweens, bcTween)
        bcTween:Play()

        targetGroup.Position = UDim2.new(0, 0, 0, 10)
        targetGroup.Visible = true

        VideoFadeOverlay.BackgroundTransparency = 0
        VideoFadeOverlay.Visible = true

        local fadeTween = TweenService:Create(VideoFadeOverlay, TweenInfo.new(0.42, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
            BackgroundTransparency = 1
        })
        local slideTween = TweenService:Create(targetGroup, TweenInfo.new(0.36, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0)
        })
        table.insert(activeTweens, fadeTween)
        table.insert(activeTweens, slideTween)
        fadeTween:Play()
        slideTween:Play()

        task.delay(0.42, function()
            if myTransitionId == currentTransitionId then
                VideoFadeOverlay.Visible = false
            end
        end)
    end

