    local function CleanSavedAvatarList(rawList)
        local out, seen = {}, {}
        if type(rawList) == "table" then
            for _, entry in ipairs(rawList) do
                if type(entry) == "string" then
                    local trimmed = entry:gsub("^%s+", ""):gsub("%s+$", "")
                    local key = trimmed:lower()
                    if trimmed ~= "" and trimmed ~= "None" and not seen[key] then
                        seen[key] = true
                        table.insert(out, trimmed)
                    end
                end
            end
        end
        return out
    end

    local function LoadSavedAvatarNames()
        local merged = {}
        local seen = {}
        local function addList(lst)
            for _, item in ipairs(CleanSavedAvatarList(lst)) do
                local key = item:lower()
                if not seen[key] then
                    seen[key] = true
                    table.insert(merged, item)
                end
            end
        end
        pcall(function()
            if readfile and isfile and isfile(AVATAR_SAVE_PATH) then
                local okDec, dec = pcall(function() return _avHttp:JSONDecode(readfile(AVATAR_SAVE_PATH)) end)
                if okDec and type(dec) == "table" then
                    addList(dec)
                end
            end
        end)
        addList(Config.AvatarCopy_SavedNames)
        Config.AvatarCopy_SavedNames = merged
        return merged
    end

    local function SaveSavedAvatarNames(list)
        local clean = CleanSavedAvatarList(list)
        Config.AvatarCopy_SavedNames = clean
        pcall(function()
            if makefolder and isfolder then
                if not isfolder("Nexara") then makefolder("Nexara") end
                if not isfolder(AVATAR_SAVE_DIR) then makefolder(AVATAR_SAVE_DIR) end
            end
            if writefile then
                writefile(AVATAR_SAVE_PATH, _avHttp:JSONEncode(clean))
            end
        end)
        return clean
    end

