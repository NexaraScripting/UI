                            ApplyNexaraNameBlur(row.UserLabel, false)
                            if Config.StreamerMode then
                                row.NameLabel.Text = "★ NexaraScript"
                                row.UserLabel.Text = "@NexaraScript"
                            else
                                row.NameLabel.Text = "★ " .. plr.DisplayName
                                row.UserLabel.Text = "@" .. plr.Name
                            end
                        end
                    else
                        ApplyNexaraNameBlur(row.NameLabel, false)
                        ApplyNexaraNameBlur(row.UserLabel, false)
                        row.NameLabel.Text = plr.DisplayName
                        row.UserLabel.Text = "@" .. plr.Name
