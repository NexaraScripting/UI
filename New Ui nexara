    function Theme._clampMainPos(pos, targetScale)
        local vp = Theme._getGuiBounds()
        local s = math.max(targetScale or (MainScale and MainScale.Scale) or 1, 0.25)
        local fw = (UIState and UIState.FrameW) or 900
        local fh = (UIState and UIState.FrameH) or 560
        local halfW = math.floor((fw * 0.5) * s + 0.5)
        local halfH = math.floor((fh * 0.5) * s + 0.5)
        local minX = math.min(halfW + 6, math.floor(vp.X * 0.5))
        local maxX = math.max(minX, math.floor(vp.X - halfW - 6))
        local minY = math.min(halfH + 6, math.floor(vp.Y * 0.5))
        local maxY = math.max(minY, math.floor(vp.Y - halfH - 6))
        local ax = pos.X.Scale * vp.X + pos.X.Offset
        local ay = pos.Y.Scale * vp.Y + pos.Y.Offset
        local cx = math.clamp(ax, minX, maxX)
        local cy = math.clamp(ay, minY, maxY)
        return UDim2.new(0.5, math.floor(cx - vp.X * 0.5 + 0.5), 0.5, math.floor(cy - vp.Y * 0.5 + 0.5))
    end
    function Theme._clampMobBtnPos(pos)
        local vp = Theme._getGuiBounds()
        local ax = pos.X.Scale * vp.X + pos.X.Offset
        local ay = pos.Y.Scale * vp.Y + pos.Y.Offset
        local cx = math.clamp(math.floor(ax + 0.5), 8, math.max(8, math.floor(vp.X - 54)))
        local cy = math.clamp(math.floor(ay + 0.5), 8, math.max(8, math.floor(vp.Y - 54)))
        return UDim2.fromOffset(cx, cy)
    end

    local function IsTouchMobileDevice()
        local okP, plat = pcall(function()
            return UserInputService:GetPlatform()
        end)
        if okP and plat ~= nil then
            local pName = tostring(plat)
            if plat == Enum.Platform.Android or plat == Enum.Platform.IOS or pName:find("Android", 1, true) or pName:find("IOS", 1, true) then
                return true
            end
            if plat == Enum.Platform.Windows or plat == Enum.Platform.OSX or pName:find("Windows", 1, true) or pName:find("OSX", 1, true) or pName:find("Linux", 1, true) or pName:find("UWP", 1, true) then
                return UserInputService.TouchEnabled and (not UserInputService.MouseEnabled) and (not UserInputService.KeyboardEnabled)
            end
        end
        if not UserInputService.TouchEnabled then
            return false
        end
        if not UserInputService.MouseEnabled or not UserInputService.KeyboardEnabled then
            return true
        end
        local okLast, lastType = pcall(function()
            return UserInputService:GetLastInputType()
        end)
        if okLast and lastType == Enum.UserInputType.Touch then
            return true
        end
        local cam = workspace.CurrentCamera
        if cam and cam.ViewportSize.Y > 0 and cam.ViewportSize.Y < 620 then
            return true
        end
        return UserInputService.AccelerometerEnabled == true
    end

