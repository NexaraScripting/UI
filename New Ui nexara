        local function FindPerkIconInFolder(perksRoot, clean)
            if not perksRoot then return nil end
            for _, f in ipairs(perksRoot:GetChildren()) do
                if f.Name:lower():gsub("%s+", ""):gsub("[^%a]", "") == clean then
                    for _, t in ipairs({"3", "2", "1"}) do
                        local tObj = f:FindFirstChild(t)
                        if tObj and (tObj:IsA("ImageLabel") or tObj:IsA("ImageButton")) and tObj.Image ~= "" then
                            return tObj.Image
                        end
                    end
                end
            end
            return nil
        end

        local function GetPerkIconAsset(pName)
            if not pName or pName == "" or pName == "---" then return nil end
            if ctx.GetPerkIcon then
                local ok, res = pcall(ctx.GetPerkIcon, pName, 3)
                if ok and res then return res end
            end
            local clean = pName:lower():gsub("%s+", ""):gsub("[^%a]", "")
            local rs = game:GetService("ReplicatedStorage")
            local found = FindPerkIconInFolder(rs:FindFirstChild("Perks"), clean)
            if found then return found end
            local kRoot = rs:FindFirstChild("Killers")
            if kRoot then
                for _, kFolder in ipairs(kRoot:GetChildren()) do
                    found = FindPerkIconInFolder(kFolder:FindFirstChild("Perks"), clean)
                    if found then return found end
                end
            end
            return nil
        end

        local standaloneLocalPerkKey, standaloneLocalPerkClock, standaloneLocalPerks = nil, 0, nil
        local function ResolveStandalonePerks(plr, isK)
            local list = {}
            local rs = game:GetService("ReplicatedStorage")
            if plr == LocalPlayer then
                local kType = tostring(plr:GetAttribute("SelectedKiller") or "Veil")
                local roleKey = isK and ("K_" .. kType) or "S"
                local now = os.clock()
                if standaloneLocalPerkKey == roleKey and (now - standaloneLocalPerkClock) < 2.5 and standaloneLocalPerks then
                    return standaloneLocalPerks
                end
                local rem = rs:FindFirstChild("Remotes")
                local ok, res = false, nil
                if isK then
                    local rf = rem and rem:FindFirstChild("ShopKillers") and rem.ShopKillers:FindFirstChild("GetEquippedKillerPerks")
                    if rf then ok, res = pcall(function() return rf:InvokeServer(kType) end) end
                else
                    local rf = rem and rem:FindFirstChild("Shop") and rem.Shop:FindFirstChild("GetEquippedPerks")
                    if rf then ok, res = pcall(function() return rf:InvokeServer() end) end
                end
                if ok and type(res) == "table" then
                    for i = 1, 3 do
                        local e = res[i]
                        local n = type(e) == "table" and (e.name or e.Name) or (type(e) == "string" and e)
                        if type(n) == "string" and n ~= "" and not table.find(list, n) then table.insert(list, n) end
                    end
                    for _, slot in ipairs({"perk1", "perk2", "perk3", "Perk1", "Perk2", "Perk3"}) do
                        local e = res[slot]
                        local n = type(e) == "table" and (e.name or e.Name) or (type(e) == "string" and e)
                        if type(n) == "string" and n ~= "" and not table.find(list, n) and #list < 3 then table.insert(list, n) end
                    end
                end
                standaloneLocalPerkKey = roleKey
                standaloneLocalPerkClock = now
                standaloneLocalPerks = list
                return list
            end
            local mr = rs:FindFirstChild("MatchResults")
            local entry = mr and mr:FindFirstChild(tostring(plr.UserId))
            local raw = entry and entry:GetAttribute("Perks")
            if type(raw) == "string" and raw ~= "" then
                local ok, dec = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
                if ok and type(dec) == "table" then
                    for _, e in ipairs(dec) do
                        local n = type(e) == "table" and e.name
                        if type(n) == "string" and n ~= "" and not table.find(list, n) and #list < 3 then table.insert(list, n) end
                    end
                end
            end
            return list
        end

        local function GetItemIconAsset(iName)
            if not iName or iName == "" or iName == "No Item" then return nil end
            if ctx.GetItemIcon then
