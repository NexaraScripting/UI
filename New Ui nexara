                    KeybindBtn.TextColor3 = Theme.Text
                    TweenService:Create(KBStroke, TweenInfo.new(0.18), { Color = Theme.CardStroke }):Play()
                    finishListen()
                    if activeKeybindCallback then pcall(activeKeybindCallback, keyCode) end
                    ConfigSys.ScheduleAutoSave()
                    return
                end
            elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
                activeCurrentKey = Enum.UserInputType.MouseButton3
                KeybindBtn.Text = "[MB3]"
                KeybindBtn.TextColor3 = Theme.Text
                TweenService:Create(KBStroke, TweenInfo.new(0.18), { Color = Theme.CardStroke }):Play()
                finishListen()
                if activeKeybindCallback then pcall(activeKeybindCallback, Enum.UserInputType.MouseButton3) end
                ConfigSys.ScheduleAutoSave()
                return
            end
        end)
    end)

