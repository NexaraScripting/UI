    local function IsPosInsideGui(pos, gui)
        if not SafeVis(gui) then return false end
        local absPos = gui.AbsolutePosition
        local absSize = gui.AbsoluteSize
        return pos.X >= absPos.X and pos.X <= (absPos.X + absSize.X)
           and pos.Y >= absPos.Y and pos.Y <= (absPos.Y + absSize.Y)
    end

    local function UpdateFlyoutPosition()
        if activeRowAnchor and activeRowAnchor.Parent then
            local rowX, rowY = Theme._toGuiLocal(activeRowAnchor.AbsolutePosition.X, activeRowAnchor.AbsolutePosition.Y)
            local rowW = activeRowAnchor.AbsoluteSize.X
            local bounds = Theme._getGuiBounds()
            local screenW = bounds.X
            local screenH = bounds.Y

            local flyoutW = 150
            local targetX = math.clamp(rowX + rowW + 10, 8, math.max(8, screenW - flyoutW - 8))
            local targetY = math.clamp(rowY - 2, 15, math.max(15, screenH - 45))
            ColorFlyout.Position = UDim2.fromOffset(targetX, targetY)

            local bigW = 195
            local bigH = 245
            local bigX = math.clamp(targetX, 8, math.max(8, screenW - bigW - 8))
            local bigY = targetY + 36
            if bigY + bigH > screenH - 12 then
                bigY = math.clamp(targetY - bigH - 6, 12, math.max(12, screenH - bigH - 12))
            end

            BigPicker.Position = UDim2.fromOffset(bigX, bigY)
        end
    end

