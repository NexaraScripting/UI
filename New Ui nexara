            if CurrentTabTitle ~= tabTitle then
                TweenService:Create(MainBtn, TweenInfo.new(0.18), { BackgroundTransparency = 0.88, BackgroundColor3 = Theme.Input }):Play()
                TweenService:Create(TitleLabel, TweenInfo.new(0.18), { TextColor3 = Color3.fromRGB(240, 240, 250) }):Play()
                TweenService:Create(IconImg, TweenInfo.new(0.18), { ImageColor3 = Color3.fromRGB(220, 220, 240) }):Play()
            end
        end)
        MainBtn.MouseLeave:Connect(function()
            if CurrentTabTitle ~= tabTitle then
                TweenService:Create(MainBtn, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
                TweenService:Create(TitleLabel, TweenInfo.new(0.18), { TextColor3 = Theme.TextDim }):Play()
                TweenService:Create(IconImg, TweenInfo.new(0.18), { ImageColor3 = Theme.TextDim }):Play()
            end
        end)

        MainBtn.MouseButton1Click:Connect(function()
            for otherTitle, item in pairs(AccordionTabs) do
                item.Indicator.Visible = false
                item.Title.TextColor3 = Theme.TextDim
                item.Icon.ImageColor3 = Theme.TextDim
                item.Btn.BackgroundTransparency = 1
                if otherTitle ~= tabTitle then
                    item.ToggleAccordion(false)
                end
            end
            ActiveIndicator.Visible = true
            TitleLabel.TextColor3 = Theme.Text
            IconImg.ImageColor3 = Theme.Accent
            MainBtn.BackgroundTransparency = 0.85
            MainBtn.BackgroundColor3 = Theme.Input

            if subtabs and #subtabs > 0 then
                ToggleAccordion(true)
                if subtabs[1] and subButtons[subtabs[1]] then
                    for _, b in pairs(subButtons) do
                        b.TextColor3 = Theme.TextDim
                        if Theme.SetTextWeight then Theme.SetTextWeight(b, "Regular") else b.Font = Enum.Font.Gotham end
                        b.BackgroundTransparency = 1
                    end
                    local firstBtn = subButtons[subtabs[1]]
                    firstBtn.TextColor3 = Theme.Text
                    if Theme.SetTextWeight then Theme.SetTextWeight(firstBtn, "Bold") else firstBtn.Font = Enum.Font.GothamBold end
                    firstBtn.BackgroundTransparency = 0.88
                    firstBtn.BackgroundColor3 = Theme.Input
