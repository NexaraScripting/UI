    local function SafeVis(inst)
        return typeof(inst) == "Instance" and inst.Parent ~= nil and inst.Visible == true
    end

    local function FormatKeyName(key)
        if not key then return "None" end
        if typeof(key) == "EnumItem" then return key.Name end
        return tostring(key)
    end

    local function SetRowRainbow(rowKey, enable, initCol, cb, visSync, sunSync)
        if not rowKey then return end
        if enable then
            local h, s, v = (initCol or Color3.fromRGB(255, 0, 0)):ToHSV()
            if s < 0.15 then s = 1 end
            if v < 0.15 then v = 1 end
            RainbowRows[rowKey] = {
                h = h,
                s = s,
                v = v,
                cb = cb,
                vis = visSync,
                sun = sunSync,
            }
            if sunSync then pcall(sunSync, true) end
            if not rainbowStepConn then
                rainbowStepConn = ConnectUI(RunService.RenderStepped, function(dt)
                    if not next(RainbowRows) then
                        if rainbowStepConn then rainbowStepConn:Disconnect(); rainbowStepConn = nil end
                        return
                    end
                    local step = math.min(dt or 0.016, 0.05) * 0.5
                    for rKey, entry in pairs(RainbowRows) do
                        if not (typeof(rKey) == "Instance" and rKey.Parent) then
                            RainbowRows[rKey] = nil
                        else
                            entry.h = (entry.h + step) % 1
                            local col = Color3.fromHSV(entry.h, entry.s, entry.v)
                            if entry.vis then pcall(entry.vis, col) end
                            if entry.cb then pcall(entry.cb, col) end
                            if activeRowAnchor == rKey then
                                curH, curS, curV = entry.h, entry.s, entry.v
                                SvBox.BackgroundColor3 = Color3.fromHSV(curH, 1, 1)
                                BigLiveSwatch.BackgroundColor3 = col
                                ColorDotBtn.BackgroundColor3 = col
                                HueKnob.Position = UDim2.new(curH, 0, 0.5, 0)
                                HexBox.Text = string.format("#%02X%02X%02X", math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5))
                            end
                        end
                    end
                end)
            end
        else
            local existing = RainbowRows[rowKey]
            RainbowRows[rowKey] = nil
            if sunSync then
                pcall(sunSync, false)
            elseif existing and existing.sun then
                pcall(existing.sun, false)
            end
            if not next(RainbowRows) and rainbowStepConn then
                rainbowStepConn:Disconnect()
                rainbowStepConn = nil
            end
        end
    end
    Theme._toggleRainbow = function(rowKey, initCol, cb, visSync, sunSync)
        local nowOn = not (RainbowRows[rowKey] ~= nil)
        SetRowRainbow(rowKey, nowOn, initCol, cb, visSync, sunSync)
        if activeRowAnchor == rowKey then
            isRainbowActive = nowOn
            SunIcon.ImageColor3 = nowOn and Theme.Accent or Theme.TextDim
        end
        return nowOn
    end

    local function RecalculateColor(fire)
        local col = Color3.fromHSV(curH, curS, curV)
        SvBox.BackgroundColor3 = Color3.fromHSV(curH, 1, 1)
        BigLiveSwatch.BackgroundColor3 = col
        ColorDotBtn.BackgroundColor3 = col
        HexBox.Text = string.format("#%02X%02X%02X", math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5))
        if activeVisualSync then
            pcall(activeVisualSync, col)
        end
        if fire and activeCallback then
            pcall(activeCallback, col)
        end
    end

    local function UpdateSliderFlyoutValue(relFrac, fire)
        relFrac = math.clamp(relFrac, 0, 1)
        local rawVal = sfMin + (sfMax - sfMin) * relFrac
        local intVal = math.floor(rawVal + 0.5)
        sfCur = intVal

        local visualFrac = (sfMax > sfMin) and ((intVal - sfMin) / (sfMax - sfMin)) or 0
        SFKnob.Position = UDim2.new(visualFrac, 0, 0.5, 0)
        SFFill.Size = UDim2.new(visualFrac, 0, 1, 0)
        BadgeText.Text = tostring(intVal)

        if fire and sfCallback then
            pcall(sfCallback, intVal)
        end
    end

