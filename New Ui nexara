            { name = "Mortal",    elo = 600,  crest = "rbxassetid://135108634235277", color = Color3.fromRGB(170, 170, 20) },
            { name = "Graven",    elo = 900,  crest = "rbxassetid://102394445781049", color = Color3.fromRGB(12, 208, 208) },
            { name = "Awakened",  elo = 1200, crest = "rbxassetid://128269362852644", color = Color3.fromRGB(206, 131, 10) },
            { name = "Unholy",    elo = 1500, crest = "rbxassetid://108078047560206", color = Color3.fromRGB(150, 112, 208) },
            { name = "Celestial", elo = 1800, crest = "rbxassetid://129726415843258", color = Color3.fromRGB(156, 191, 176) },
        }
        local RANK_ETERNAL = { name = "Eternal", crest = "rbxassetid://125760853919334", color = Color3.fromRGB(214, 44, 48) }
        local RANK_UNRANKED = { name = "Unranked", color = Color3.fromRGB(150, 150, 150) }
        local RANK_ROMAN = { "I", "II", "III" }
        local _HttpSvc = game:GetService("HttpService")

        local function ResolveTierFromStats(elo, games, boardPos, placementReq)
            if type(elo) ~= "number" or elo ~= elo then
                return nil, nil
            end
            if type(games) == "number" and games < (placementReq or 5) then
                return RANK_UNRANKED, nil
            end
            if elo >= 2100 and type(boardPos) == "number" and boardPos > 0 and boardPos <= 100 then
                return RANK_ETERNAL, nil
            end
            local chosen = RANK_TIERS[1]
            for _, t in ipairs(RANK_TIERS) do
                if t.elo <= elo then
                    chosen = t
                end
            end
            local div = math.clamp(math.floor((elo - chosen.elo) / 100) + 1, 1, 3)
            return chosen, RANK_ROMAN[div]
        end

        local function DecodeKillerEloMap(plr)
            local raw = plr and plr:GetAttribute("KillerElo")
            if type(raw) ~= "string" or raw == "" or raw == "[]" then
                return {}
            end
            local ok, dec = pcall(function() return _HttpSvc:JSONDecode(raw) end)
            return (ok and type(dec) == "table") and dec or {}
        end

        local function LookupKillerMapElo(kMap, name)
            if type(kMap) ~= "table" or not name or name == "" then return nil end
            local direct = tonumber(kMap[name])
            if direct then return direct end
            local targetLower = name:lower():gsub("^the%s+", "")
            for k, v in pairs(kMap) do
                if type(k) == "string" and k:lower():gsub("^the%s+", "") == targetLower then
                    local num = tonumber(v)
                    if num then return num end
                end
            end
            return nil
        end

        local function ResolvePlayerRankInfo(plr, isK, cleanK, isLobby)
            local placementReq = tonumber(plr:GetAttribute("RankedPlacementMatches")) or 5
            local lobbyRole = tostring(plr:GetAttribute("LobbyRole") or "")

            local sElo = tonumber(plr:GetAttribute("SurvivorElo"))
            local sGames = tonumber(plr:GetAttribute("SurvivorGames"))
            local sPos = tonumber(plr:GetAttribute("SurvivorBoardPosition"))

            local rawSelK = plr:GetAttribute("SelectedKiller")
            local selK = (type(rawSelK) == "string" and rawSelK ~= "") and rawSelK:gsub("^The%s+", "") or nil
            local targetK = (isK and cleanK and cleanK ~= "") and cleanK or selK
            local kMap = DecodeKillerEloMap(plr)

            local kElo, kGames, kPos = nil, nil, nil
            if targetK and selK and targetK:lower() == selK:lower() then
                kElo = tonumber(plr:GetAttribute("SelectedKillerElo"))
                kGames = tonumber(plr:GetAttribute("SelectedKillerGames"))
                kPos = tonumber(plr:GetAttribute("SelectedKillerBoardPosition"))
            elseif not targetK then
                kElo = tonumber(plr:GetAttribute("SelectedKillerElo"))
                kGames = tonumber(plr:GetAttribute("SelectedKillerGames"))
                kPos = tonumber(plr:GetAttribute("SelectedKillerBoardPosition"))
            end
            local mappedElo = LookupKillerMapElo(kMap, targetK)
            if kElo == nil and mappedElo ~= nil then
                kElo = mappedElo
            end

            local bestMapK, bestMapElo = nil, nil
            for k, v in pairs(kMap) do
                local num = tonumber(v)
                if type(k) == "string" and num and (not bestMapElo or num > bestMapElo) then
                    bestMapK, bestMapElo = k:gsub("^The%s+", ""), num
                end
            end

            local useKiller = false
            if isK then
                useKiller = true
            elseif isLobby then
                if lobbyRole == "Killer" then
                    useKiller = true
                elseif lobbyRole == "Survivor" then
                    useKiller = false
                else
                    local sRanked = (type(sGames) == "number" and sGames >= placementReq)
                    local kRanked = (type(kGames) == "number" and kGames >= placementReq)
                    if sRanked ~= kRanked then
                        useKiller = kRanked
                    elseif sElo == nil and (kElo ~= nil or bestMapElo ~= nil) then
                        useKiller = true
                    end
                end
            end

            local pElo = useKiller and (kElo or bestMapElo) or sElo
            local pGames = useKiller and kGames or sGames
            local pPos = useKiller and kPos or sPos
            local pRoleTag = useKiller and (targetK or bestMapK or "Killer") or "Surv"

            local pTier, pDiv = ResolveTierFromStats(pElo, pGames, pPos, placementReq)
            local crest = pTier and pTier.crest or nil
            local tierColor = (pTier and pTier.color) or Color3.fromRGB(150, 150, 150)
            local tierText = "NO RANK"
            if pTier then
                tierText = pTier.name:upper() .. (pDiv and (" " .. pDiv) or "")
                if pTier ~= RANK_UNRANKED and type(pPos) == "number" and pPos > 0 and pPos <= 1000 then
                    tierText = tierText .. " #" .. tostring(pPos)
                end
            end

            local eloText = "---"
            if type(pElo) == "number" then
                local rElo = math.floor(pElo + 0.5)
                if pTier == RANK_UNRANKED and type(pGames) == "number" then
                    eloText = tostring(rElo) .. " ELO (" .. tostring(pGames) .. "/" .. tostring(placementReq) .. ")"
                else
                    eloText = tostring(rElo) .. " ELO • " .. pRoleTag
                end
            end

            local altText = ""
            if useKiller then
                if type(sElo) == "number" then
                    local sTier, sDiv = ResolveTierFromStats(sElo, sGames, sPos, placementReq)
                    local sDesc = (sTier and sTier ~= RANK_UNRANKED) and (sTier.name .. (sDiv and (" " .. sDiv) or "")) or ((type(sGames) == "number" and sGames < placementReq) and (tostring(sGames) .. "/" .. tostring(placementReq)) or "")
                    altText = "Surv: " .. tostring(math.floor(sElo + 0.5)) .. (sDesc ~= "" and (" • " .. sDesc) or "")
                end
            else
                local altKName = (kElo ~= nil and (type(kGames) ~= "number" or kGames >= placementReq)) and (targetK or "Killer") or (bestMapK or targetK)
                local altKElo = (kElo ~= nil and (type(kGames) ~= "number" or kGames >= placementReq)) and kElo or (bestMapElo or kElo)
                local altKGames = (altKName and selK and altKName:lower() == selK:lower()) and kGames or nil
                local altKPos = (altKName and selK and altKName:lower() == selK:lower()) and kPos or nil
                if type(altKElo) == "number" then
                    local kTier, kDiv = ResolveTierFromStats(altKElo, altKGames, altKPos, placementReq)
                    local kDesc = (kTier and kTier ~= RANK_UNRANKED) and (kTier.name .. (kDiv and (" " .. kDiv) or "")) or ((type(altKGames) == "number" and altKGames < placementReq) and (tostring(altKGames) .. "/" .. tostring(placementReq)) or "")
                    altText = (altKName or "Killer") .. ": " .. tostring(math.floor(altKElo + 0.5)) .. (kDesc ~= "" and (" • " .. kDesc) or "")
                end
            end

            return {
                TierText = tierText,
                TierColor = tierColor,
                Crest = crest,
                EloText = eloText,
                AltText = altText,
                LobbyRole = lobbyRole,
                SelectedKiller = selK,
            }
        end

        local function UpdateRoster(force)
            local allPlayers = Players:GetPlayers()
            RhCount.Text = "Players: " .. tostring(#allPlayers)

            for p, row in pairs(cachedRosterRows) do
                if not table.find(allPlayers, p) then
                    pcall(function() row.Card:Destroy() end)
                    cachedRosterRows[p] = nil
                end
            end

            local killerPlr = nil
            local survivors = {}
            for _, p in ipairs(allPlayers) do
                if not killerPlr and ResolveIsKiller(p) then
                    killerPlr = p
                else
                    table.insert(survivors, p)
                end
            end

            local ordered = {}
            if killerPlr then table.insert(ordered, killerPlr) end
            if table.find(survivors, LocalPlayer) then table.insert(ordered, LocalPlayer) end
            table.sort(survivors, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
            for _, s in ipairs(survivors) do
                if s ~= LocalPlayer and not table.find(ordered, s) then
                    table.insert(ordered, s)
                end
            end

            for rank, plr in ipairs(ordered) do
                pcall(function()
                    local row = cachedRosterRows[plr] or CreatePlayerRow(plr)
                    row.Card.LayoutOrder = rank
                    local isK = (plr == killerPlr)

                    local plrLevel = tonumber(plr:GetAttribute("Level")) or 1
                    local rawPlat = tostring(plr:GetAttribute("platform") or "PC")
                    local platUpper = rawPlat:upper()

                    -- Platform icon lookup (PC / Mobile / Console)
                    if platUpper == "MOBILE" then
                        row.PlatIcon.Image = "rbxassetid://10734963940"
                    elseif platUpper == "CONSOLE" then
                        row.PlatIcon.Image = "rbxassetid://10723395215"
                    else
                        row.PlatIcon.Image = "rbxassetid://10734896881" -- PC Monitor
                    end

                    if plr == LocalPlayer then
