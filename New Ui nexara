            end
            local cam = workspace.CurrentCamera
            return cam and cam.ViewportSize or Vector2.new(1280, 720)
        end

        local function applyClampPos()
            local bounds = getBoundsSize()
            local bw, bh = 132, 34
            local sx = tonumber(Config[xKey])
            local sy = tonumber(Config[yKey])
            local defX = math.max(8, bounds.X - bw - 16)
            local defY = math.clamp(96 + (orderIdx - 1) * 42, 48, math.max(48, bounds.Y - bh - 12))
            local px = math.clamp(sx or defX, 4, math.max(4, bounds.X - bw - 4))
            local py = math.clamp(sy or defY, 4, math.max(4, bounds.Y - bh - 4))
            Btn.Position = UDim2.fromOffset(math.floor(px + 0.5), math.floor(py + 0.5))
        end

        local function syncState()
            if not (Btn and Btn.Parent) then return end
            local active = (getStateFn() == true)
            Btn.BackgroundColor3 = active and Theme.Sidebar:Lerp(Theme.Accent, 0.14) or Theme.Sidebar
            Stroke.Color = active and Theme.Accent or Theme.FlyoutStroke
            Stroke.Transparency = active and 0.08 or 0.25
            Dot.BackgroundColor3 = active and Theme.Accent or Theme.TextMuted
            TitleLbl.TextColor3 = active and Theme.Text or Theme.TextDim
            StateLbl.Text = active and "ON" or "OFF"
            StateLbl.BackgroundColor3 = active and Theme.Accent or Theme.Input
            StateLbl.BackgroundTransparency = active and 0.12 or 0.25
            StateLbl.TextColor3 = active and getContrastText(Theme.Accent) or Theme.TextMuted
        end

        local function syncVisibility()
            if not (Btn and Btn.Parent) then return end
            local show = Theme._isMobilePlatform() and (Config[openKey] == true)
            if show then
                applyClampPos()
                syncState()
            end
            Btn.Visible = show
        end

        Theme.HookAccent(function()
            syncState()
        end)

        local dragging = false
        local dragMoved = false
        local dragInput = nil
        local dragStart = nil
        local startX, startY = 0, 0

        Btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragMoved = false
                dragInput = input
                dragStart = input.Position
                local abs = Btn.AbsolutePosition
                startX, startY = abs.X, abs.Y
            end
        end)

        ConnectUI(UserInputService.InputChanged, function(input)
            if not dragging then return end
            if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            local delta = input.Position - dragStart
            if not dragMoved and delta.Magnitude >= 6 then
                dragMoved = true
            end
            if dragMoved then
                local bounds = getBoundsSize()
                local bw, bh = Btn.AbsoluteSize.X, Btn.AbsoluteSize.Y
                local nx = math.clamp(math.floor(startX + delta.X + 0.5), 4, math.max(4, math.floor(bounds.X - bw - 4)))
                local ny = math.clamp(math.floor(startY + delta.Y + 0.5), 4, math.max(4, math.floor(bounds.Y - bh - 4)))
                Btn.Position = UDim2.fromOffset(nx, ny)
            end
        end)

        ConnectUI(UserInputService.InputEnded, function(input)
            if not dragging then return end
            if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging = false
            dragInput = nil
            if dragMoved then
                local pos = Btn.AbsolutePosition
                Config[xKey] = math.floor(pos.X + 0.5)
                Config[yKey] = math.floor(pos.Y + 0.5)
                ConfigSys.ScheduleAutoSave()
            else
                setStateFn(not (getStateFn() == true))
                syncState()
            end
        end)

        local entry = {
            Button = Btn,
            SyncState = syncState,
            SyncVisibility = syncVisibility,
            isOpen = function() return Config[openKey] == true end,
            setOpen = function(v)
                Config[openKey] = (v == true)
                syncVisibility()
            end,
        }
        table.insert(Theme._mobileButtons, entry)
        syncVisibility()
        return entry
    end

