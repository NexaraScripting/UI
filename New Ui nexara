        ColRight.Position = UDim2.new(0.5, 8, 0, 0)
        ColRight.BackgroundTransparency = 1
        ColRight.Parent = ColContainer

        local ColFull = Instance.new("Frame")
        ColFull.Name = "ColFull"
        ColFull.Size = UDim2.new(1, -4, 1, 0)
        ColFull.Position = UDim2.new(0, 0, 0, 0)
        ColFull.BackgroundTransparency = 1
        ColFull.Parent = ColContainer

        local refreshing = false
        local function updatePageCanvas()
            if refreshing then return end
            refreshing = true
            local s = Theme._getMainScale()
            local leftLayout = ColLeft:FindFirstChildOfClass("UIListLayout")
            local rightLayout = ColRight:FindFirstChildOfClass("UIListLayout")
            local fullLayout = ColFull:FindFirstChildOfClass("UIListLayout")
            local leftLog = math.ceil((leftLayout and leftLayout.AbsoluteContentSize.Y or 0) / s)
            local rightLog = math.ceil((rightLayout and rightLayout.AbsoluteContentSize.Y or 0) / s)
            local fullLog = math.ceil((fullLayout and fullLayout.AbsoluteContentSize.Y or 0) / s)
            if UIState.StackCols then
                ColLeft.Size = UDim2.new(1, -4, 0, leftLog)
                ColLeft.Position = UDim2.new(0, 0, 0, 0)
                local rightY = (leftLog > 0 and rightLog > 0) and (leftLog + 12) or 0
                ColRight.Size = UDim2.new(1, -4, 0, rightLog)
                ColRight.Position = UDim2.new(0, 0, 0, rightY)
                local stackedLog = (leftLog > 0 and rightLog > 0) and (leftLog + 12 + rightLog) or math.max(leftLog, rightLog)
                pageFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(stackedLog, fullLog) + 30)
            else
                ColLeft.Size = UDim2.new(0.5, -8, 1, 0)
                ColLeft.Position = UDim2.new(0, 0, 0, 0)
                ColRight.Size = UDim2.new(0.5, -8, 1, 0)
                ColRight.Position = UDim2.new(0.5, 8, 0, 0)
                pageFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(leftLog, rightLog, fullLog) + 30)
            end
            refreshing = false
        end
        table.insert(Theme._layoutRefreshers, updatePageCanvas)
        for _, col in ipairs({ ColLeft, ColRight, ColFull }) do
            local layout = Instance.new("UIListLayout")
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Padding = UDim.new(0, 12)
            layout.Parent = col
            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updatePageCanvas)
        end
        task.defer(updatePageCanvas)
    end

