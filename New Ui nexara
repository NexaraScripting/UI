            StateLbl.BackgroundTransparency = active and 0.12 or 0.25
            StateLbl.TextColor3 = active and getContrastText(Theme.Accent) or Theme.TextMuted
        end

        local function syncVisibility()
            if not (Btn and Btn.Parent) then return end
            local show = Theme._isMobilePlatform() and (Config[openKey] == true)
            if show then
                applyClampPos()
                syncState()
            end
            Btn.Visible = show
        end

        Theme.HookAccent(function()
            syncState()
        end)

        local dragging = false
        local dragMoved = false
        local dragInput = nil
        local dragStart = nil
        local startX, startY = 0, 0
        local lastTapClock = 0

        local function finishQuickInput(wasCancel)
            if not dragging then return end
            local moved = dragMoved
            dragging = false
            dragInput = nil
            if moved then
                local pos = Btn.AbsolutePosition
                Config[xKey] = math.floor(pos.X + 0.5)
                Config[yKey] = math.floor(pos.Y + 0.5)
                ConfigSys.ScheduleAutoSave()
            elseif not wasCancel then
                local now = os.clock()
                if (now - lastTapClock) >= 0.2 then
                    lastTapClock = now
                    setStateFn(not (getStateFn() == true))
                    syncState()
                end
            end
        end

        Btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragMoved = false
                dragInput = input
                dragStart = input.Position
                local abs = Btn.AbsolutePosition
                startX, startY = abs.X, abs.Y
                input.Changed:Connect(function()
                    if input ~= dragInput then return end
                    if input.UserInputState == Enum.UserInputState.End then
                        finishQuickInput(false)
                    elseif input.UserInputState == Enum.UserInputState.Cancel then
                        finishQuickInput(true)
                    end
                end)
            end
        end)

        ConnectUI(UserInputService.InputChanged, function(input)
            if not dragging or Config.LockGUI then return end
            local isTouch = (input.UserInputType == Enum.UserInputType.Touch)
            if isTouch then
                if input ~= dragInput then return end
            elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end
            local delta = input.Position - dragStart
            local thresh = isTouch and 14 or 6
            if not dragMoved and delta.Magnitude >= thresh then
                dragMoved = true
            end
            if dragMoved then
                local bounds = getBoundsSize()
                local bw, bh = Btn.AbsoluteSize.X, Btn.AbsoluteSize.Y
                local nx = math.clamp(math.floor(startX + delta.X + 0.5), 4, math.max(4, math.floor(bounds.X - bw - 4)))
                local ny = math.clamp(math.floor(startY + delta.Y + 0.5), 4, math.max(4, math.floor(bounds.Y - bh - 4)))
                Btn.Position = UDim2.fromOffset(nx, ny)
            end
        end)

        ConnectUI(UserInputService.InputEnded, function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                if dragInput and dragInput.UserInputType == Enum.UserInputType.Touch and input ~= dragInput then return end
            elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end
            finishQuickInput(input.UserInputState == Enum.UserInputState.Cancel)
        end)

        local entry = {
            Button = Btn,
            SyncState = syncState,
            SyncVisibility = syncVisibility,
            isOpen = function() return Config[openKey] == true end,
            setOpen = function(v)
                Config[openKey] = (v == true)
                syncVisibility()
            end,
        }
        table.insert(Theme._mobileButtons, entry)
        syncVisibility()
        return entry
    end

