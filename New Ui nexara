    do
        local _mobToggleV2 = true
        local mobDragging = false
        local mobMoved = false
        local mobDragInput, mobDragStart, mobStartPos
        local mobLastToggle = 0
        local function fireMobToggle()
            local now = os.clock()
            if (now - mobLastToggle) < 0.25 then return end
            mobLastToggle = now
            pcall(ToggleUI)
        end
        local function finishMobInput(wasCancel)
            if not mobDragging then return end
            local moved = mobMoved
            mobDragging = false
            mobDragInput = nil
            if not moved and not wasCancel then
                fireMobToggle()
            end
        end
        ConnectUI(MobileToggleBtn.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                mobDragging = true
                mobMoved = false
                mobDragInput = input
                mobDragStart = input.Position
                mobStartPos = MobileToggleBtn.Position
                input.Changed:Connect(function()
                    if input ~= mobDragInput then return end
                    if input.UserInputState == Enum.UserInputState.End then
                        finishMobInput(false)
                    elseif input.UserInputState == Enum.UserInputState.Cancel then
                        finishMobInput(true)
                    end
                end)
            end
        end)
        ConnectUI(UserInputService.InputChanged, function(input)
            if not mobDragging or not mobDragStart or Config.LockGUI then return end
            local isTouch = (input.UserInputType == Enum.UserInputType.Touch)
            if isTouch then
                if mobDragInput and mobDragInput.UserInputType == Enum.UserInputType.Touch and input ~= mobDragInput then return end
            elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end
            local delta = input.Position - mobDragStart
            local thresh = isTouch and 14 or 6
            if not mobMoved and delta.Magnitude >= thresh then mobMoved = true end
            if mobMoved then
                MobileToggleBtn.Position = Theme._clampMobBtnPos(UDim2.new(mobStartPos.X.Scale, mobStartPos.X.Offset + delta.X, mobStartPos.Y.Scale, mobStartPos.Y.Offset + delta.Y))
            end
        end)
        ConnectUI(UserInputService.InputEnded, function(input)
            if not mobDragging then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                if mobDragInput and mobDragInput.UserInputType == Enum.UserInputType.Touch and input ~= mobDragInput then return end
            elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
                return
            end
            finishMobInput(input.UserInputState == Enum.UserInputState.Cancel)
        end)
        ConnectUI(MobileToggleBtn.Activated, function()
            if not mobMoved then
                fireMobToggle()
            end
        end)
    end

