            local wName = "Regular"
            pcall(function()
                local w = inst.FontFace.Weight
                if w == Enum.FontWeight.Bold or w == Enum.FontWeight.ExtraBold or w == Enum.FontWeight.Heavy then
                    wName = "Bold"
                elseif w == Enum.FontWeight.Medium or w == Enum.FontWeight.SemiBold then
                    wName = "Medium"
