        sfCur = intVal

        local visualFrac = (sfMax > sfMin) and ((intVal - sfMin) / (sfMax - sfMin)) or 0
        SFKnob.Position = UDim2.new(visualFrac, 0, 0.5, 0)
        SFFill.Size = UDim2.new(visualFrac, 0, 1, 0)
        BadgeText.Text = tostring(intVal)

        if fire and sfCallback then
            pcall(sfCallback, intVal)
        end
    end

