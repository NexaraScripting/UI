            PopPad.PaddingRight = UDim.new(0, 4)
            PopPad.Parent = PopScroll

            local isOpen = false
            local animToken = 0
            local popTween, popStrokeTween, arrowTween
            local function ClosePopup()
                if not isOpen then return end
                isOpen = false
                animToken = animToken + 1
                local myToken = animToken
                if popTween then pcall(function() popTween:Cancel() end) end
                if popStrokeTween then pcall(function() popStrokeTween:Cancel() end) end
                if arrowTween then pcall(function() arrowTween:Cancel() end) end

                local curWidth = (Popup.AbsoluteSize.X > 0) and Popup.AbsoluteSize.X or DropBtn.AbsoluteSize.X
                popTween = TweenService:Create(Popup, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Size = UDim2.fromOffset(curWidth, 0),
                    BackgroundTransparency = 0.4
                })
                popStrokeTween = TweenService:Create(PopStroke, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Transparency = 1
                })
                arrowTween = TweenService:Create(Arrow, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Rotation = 0,
                    TextColor3 = Theme.TextMuted
                })
                popTween:Play()
                popStrokeTween:Play()
                arrowTween:Play()
                TweenService:Create(DropStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Color = Theme.CardStroke }):Play()
                task.delay(0.16, function()
                    if not isOpen and animToken == myToken and Popup and Popup.Parent then
                        Popup.Visible = false
                    end
                end)
            end

            local function OpenPopup()
                if isOpen then ClosePopup(); return end
                if Theme.CloseAllDropdownPopups then pcall(Theme.CloseAllDropdownPopups, Popup) end
                if Theme._closeAllFlyouts then pcall(Theme._closeAllFlyouts, true) end
                isOpen = true
                animToken = animToken + 1
                if popTween then pcall(function() popTween:Cancel() end) end
                if popStrokeTween then pcall(function() popStrokeTween:Cancel() end) end
                if arrowTween then pcall(function() arrowTween:Cancel() end) end

                local absPos = DropBtn.AbsolutePosition
                local absSize = DropBtn.AbsoluteSize
                local locX, locY = Theme._toGuiLocal(absPos.X, absPos.Y)
                local count = math.min(#options, 6)
                local popHeight = (count * 28) + 8
                local bounds = Theme._getGuiBounds()
                local screenW = bounds.X
                local screenH = bounds.Y
                local popW = math.max(absSize.X, 40)
                local popX = math.clamp(locX, 8, math.max(8, screenW - popW - 8))
                local openUp = (locY + absSize.Y + 4 + popHeight > screenH - 8) and (locY - popHeight - 4 > 8)

                if openUp then
                    Popup.AnchorPoint = Vector2.new(0, 1)
                    Popup.Position = UDim2.fromOffset(popX, math.clamp(locY - 4, popHeight + 8, math.max(popHeight + 8, screenH - 8)))
                else
                    Popup.AnchorPoint = Vector2.new(0, 0)
                    local popY = math.clamp(locY + absSize.Y + 4, 8, math.max(8, screenH - popHeight - 8))
                    Popup.Position = UDim2.fromOffset(popX, popY)
                end

                PopScroll.CanvasSize = UDim2.new(0, 0, 0, (#options * 28) + 8)
                local startHeight = Popup.Visible and math.max(0, Popup.AbsoluteSize.Y) or 0
                Popup.Size = UDim2.fromOffset(absSize.X, startHeight)
                if not Popup.Visible then
                    Popup.BackgroundTransparency = 0.25
                    PopStroke.Transparency = 0.8
                    Popup.Visible = true
                end

                popTween = TweenService:Create(Popup, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Size = UDim2.fromOffset(absSize.X, popHeight),
                    BackgroundTransparency = 0
                })
                popStrokeTween = TweenService:Create(PopStroke, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Transparency = 0
                })
                arrowTween = TweenService:Create(Arrow, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Rotation = 180,
                    TextColor3 = Theme.Accent
                })
                popTween:Play()
                popStrokeTween:Play()
                arrowTween:Play()
                TweenService:Create(DropStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Color = Theme.Accent }):Play()
            end

            table.insert(Theme._dropdownPopups, {
                popup = Popup,
                button = DropBtn,
                isOpen = function() return isOpen end,
                close = ClosePopup,
            })

            local onRebuildCb = nil
            local function RebuildItems()
                for _, ch in ipairs(PopScroll:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end

                for idx, opt in ipairs(options) do
                    local ItemBtn = Instance.new("TextButton")
                    ItemBtn.Name = "Item_" .. tostring(opt)
                    ItemBtn.Size = UDim2.new(1, 0, 0, 26)
                    ItemBtn.BackgroundColor3 = (opt == curSelected) and Theme.Accent or Theme.Input
                    ItemBtn.BackgroundTransparency = (opt == curSelected) and 0.85 or 1
                    ItemBtn.BorderSizePixel = 0
                    ItemBtn.Font = (opt == curSelected) and Enum.Font.GothamBold or Enum.Font.Gotham
                    ItemBtn.Text = tostring(opt)
                    ItemBtn.TextSize = 11.5
                    ItemBtn.TextColor3 = (opt == curSelected) and Theme.Text or Theme.TextDim
                    ItemBtn.ZIndex = 502
                    ItemBtn.AutoButtonColor = false
                    ItemBtn.LayoutOrder = idx
                    ItemBtn.Parent = PopScroll
                    if Theme.SetTextWeight then
                        Theme.SetTextWeight(ItemBtn, (opt == curSelected) and "Bold" or "Regular")
                    end

                    local ItemCorner = Instance.new("UICorner")
                    ItemCorner.CornerRadius = UDim.new(0, 4)
                    ItemCorner.Parent = ItemBtn

                    ItemBtn.MouseEnter:Connect(function()
                        if opt ~= curSelected then
                            TweenService:Create(ItemBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.85, BackgroundColor3 = Theme.Input }):Play()
                        end
                    end)
                    ItemBtn.MouseLeave:Connect(function()
                        if opt ~= curSelected then
                            TweenService:Create(ItemBtn, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
                        end
                    end)

                    ItemBtn.MouseButton1Click:Connect(function()
                        curSelected = opt
                        ValText.Text = tostring(opt)
                        ClosePopup()
                        RebuildItems()
                        if onSelect then pcall(onSelect, opt) end
                        if not noAutoSave then ConfigSys.ScheduleAutoSave() end
                    end)
                end
                if onRebuildCb then pcall(onRebuildCb) end
            end

            RebuildItems()
            DropBtn.MouseButton1Click:Connect(OpenPopup)

            return {
                Get = function() return curSelected end,
                Set = function(val, silent)
                    curSelected = val
                    ValText.Text = tostring(val)
                    RebuildItems()
                    if not silent then
                        if onSelect then pcall(onSelect, val) end
                        if not noAutoSave then ConfigSys.ScheduleAutoSave() end
                    end
                end,
                Refresh = function(newOpts, newSel)
                    options = newOpts or options
                    if newSel then curSelected = newSel end
                    ValText.Text = tostring(curSelected)
                    RebuildItems()
                end,
                ValLabel = ValText,
                Popup = Popup,
                PopScroll = PopScroll,
                SetOnRebuild = function(fn)
                    onRebuildCb = fn
                    if fn then pcall(fn) end
                end,
            }
        end

