            end
            if p:GetAttribute("Role") == "Killer" or p:GetAttribute("IsKiller") == true then return true end
            local char = p.Character
            if char then
                if char:GetAttribute("Role") == "Killer" or char:GetAttribute("IsKiller") == true then return true end
