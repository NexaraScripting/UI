                    row.RankAltLabel.Text = rInfo.AltText
                    row.RankAltLabel.Visible = rInfo.AltText ~= ""
                    row.RankStroke.Color = (rInfo.TierText ~= "NO RANK") and rInfo.TierColor or Theme.CardStroke
                    if rInfo.Crest then
