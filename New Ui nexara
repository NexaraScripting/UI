    function DD.GetMetrics()
        local total = #(activeDropdownOptions or {})
        if total <= 0 then return 0, 0 end
        local visibleCount = math.min(total, 6)
        local contentH = (total * 32) + ((total - 1) * 4) + 10
        local listH = (visibleCount * 32) + ((visibleCount - 1) * 4) + 10
        return listH, contentH
    end

    local function UpdateDropdownFlyoutPosition()
        if activeDropdownRow and activeDropdownRow.Parent then
            local rowX, rowY = Theme._toGuiLocal(activeDropdownRow.AbsolutePosition.X, activeDropdownRow.AbsolutePosition.Y)
            local rowW = activeDropdownRow.AbsoluteSize.X
            local bounds = Theme._getGuiBounds()
            local screenW = bounds.X
            local screenH = bounds.Y

            local flyoutW = 196
            local flyoutH = 38
            local targetX = math.clamp(rowX + rowW + 10, 8, math.max(8, screenW - flyoutW - 8))
            local targetY = math.clamp(rowY - 4, 15, math.max(15, screenH - flyoutH - 12))
            DropdownFlyout.Position = UDim2.fromOffset(targetX, targetY)

            if DD.List then
                local listH = DD.GetMetrics()
                local listY = targetY + flyoutH + 4
                if listH > 0 and (listY + listH > screenH - 12) then
                    if targetY - listH - 4 >= 12 then
                        listY = targetY - listH - 4
                    else
                        listY = math.max(12, screenH - listH - 12)
                    end
                end
                DD.List.Position = UDim2.fromOffset(targetX, listY)
            end
        end
    end

    OpenSliderFlyout = function(anchorRow, chevronLbl, minVal, maxVal, initVal, unit, sliderTitle, callback)
        if SliderFlyout and SliderFlyout.Visible and activeSliderChevron == chevronLbl then
            CloseAllSliderFlyouts()
            return
        end

        if Theme._closeAllFlyouts then Theme._closeAllFlyouts() end

        activeSliderRow = anchorRow
        activeSliderChevron = chevronLbl
        sfCallback = callback
        sfMin = minVal or 0
        sfMax = maxVal or 100
        sfUnit = unit or ""
        SliderFlyoutTitle.Text = sliderTitle or "Amount"

        if chevronLbl then
            TweenService:Create(chevronLbl, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Rotation = 90,
                ImageColor3 = Theme.Accent
            }):Play()
        end

        local initial = math.clamp(initVal or sfMin, sfMin, sfMax)
        local initialFrac = (sfMax > sfMin) and ((initial - sfMin) / (sfMax - sfMin)) or 0
        UpdateSliderFlyoutValue(initialFrac, false)

        UpdateSliderFlyoutPosition()

        DimOverlay.Visible = true
