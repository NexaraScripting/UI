local function CreateNexaraCustomUI(ctx)
    ctx = ctx or {}
    local Config = ctx.Config or _G.Nexara_Config or (getgenv and getgenv().Config) or {}
    local ApplyFullbrightNow = ctx.ApplyFullbrightNow
    local RestoreOriginalLighting = ctx.RestoreOriginalLighting
    local ApplyCustomRedStainNow = ctx.ApplyCustomRedStainNow
    local TofCombat = ctx.TofCombat or _G.TofCombat or (getgenv and getgenv().TofCombat) or _G.Nexara_VD_TofCombat or {}
    local AutoParry = ctx.AutoParry or _G.AutoParry or (getgenv and getgenv().AutoParry) or _G.Nexara_VD_AutoParry or {}
    local PumpkinAuras = ctx.PumpkinAuras
    _G.Nexara_IsCapturingKeybind = false

    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local ConfigSys = {
        Folder = "Nexara Studio Config",
        CurrentProfile = "Default",
        AutoloadProfile = "none",
        Restoring = false,
        SaveToken = 0,
        PendingSave = false,
        Defaults = nil,
        SyncHandlers = {},
        KeyedWidgets = {},
    }
    do
        local HttpService = game:GetService("HttpService")
        function ConfigSys.FormatKey(key)
            if not key then return "None" end
            if key == Enum.UserInputType.MouseButton3 or key == "MouseButton3" or key == "MB3" then
                return "MB3"
            end
            if typeof(key) == "EnumItem" then return key.Name end
            return tostring(key)
        end
        function ConfigSys.ResolveKey(rawCode, rawName)
            if typeof(rawCode) == "EnumItem" then return rawCode end
            local n = (type(rawName) == "string") and rawName or (type(rawCode) == "string" and rawCode or nil)
            if not n or n == "" or n == "None" then return nil end
            if n == "MB3" or n == "Middle Click" or n == "MouseButton3" then
                return Enum.UserInputType.MouseButton3
            end
            local ok, res = pcall(function() return Enum.KeyCode[n] end)
            if ok and typeof(res) == "EnumItem" then return res end
            return nil
        end
        local function serializeVal(v)
            local tv = typeof(v)
            if tv == "Color3" then
                return { __type = "Color3", R = v.R, G = v.G, B = v.B }
            elseif tv == "EnumItem" then
                return { __type = "EnumItem", EnumType = tostring(v.EnumType), Name = v.Name }
            elseif tv == "boolean" or tv == "number" or tv == "string" then
                return v
            elseif tv == "table" and v.__type == nil then
                local sub = {}
                for sk, sv in pairs(v) do
                    if type(sk) == "string" or type(sk) == "number" then
                        local ser = serializeVal(sv)
                        if ser ~= nil then sub[sk] = ser end
                    end
                end
                return sub
            end
            return nil
        end
        function ConfigSys.Serialize(tbl)
            local out = {}
            for k, v in pairs(tbl) do
                local ser = serializeVal(v)
                if ser ~= nil then out[k] = ser end
            end
            return out
        end
        function ConfigSys.Deserialize(v)
            if type(v) == "table" and v.__type == "Color3" then
                return Color3.new(tonumber(v.R) or 1, tonumber(v.G) or 1, tonumber(v.B) or 1)
            elseif type(v) == "table" and v.__type == "EnumItem" and v.EnumType and v.Name then
                local enumName = tostring(v.EnumType):gsub("^Enum%.", "")
                local ok, res = pcall(function() return Enum[enumName][v.Name] end)
                if ok and res then return res end
            elseif type(v) == "table" then
                local sub = {}
                for sk, sv in pairs(v) do
                    sub[sk] = ConfigSys.Deserialize(sv)
                end
                return sub
            end
            return v
        end
        function ConfigSys.NormalizeConfig()
            for _, p in ipairs({ "Tof_Aim", "Veil_Aim", "AutoParry_" }) do
                local kc = ConfigSys.ResolveKey(Config[p .. "KeyCode"], Config[p .. "KeyName"])
                Config[p .. "KeyCode"] = kc
                if kc then
                    Config[p .. "KeyName"] = ConfigSys.FormatKey(kc)
                    Config[p .. "KeyType"] = (kc.EnumType == Enum.UserInputType) and "Mouse" or "Keyboard"
                else
                    Config[p .. "KeyName"] = "None"
                    Config[p .. "KeyType"] = "None"
                end
            end
            local mKey = ConfigSys.ResolveKey(Config.MenuToggleKey, type(Config.MenuToggleKey) == "string" and Config.MenuToggleKey or nil)
            Config.MenuToggleKey = mKey or Enum.KeyCode.RightControl
            if Config.NoFog ~= nil or Config.RemoveFog ~= nil then
                local nf = (Config.NoFog == true or Config.RemoveFog == true)
                Config.NoFog = nf
                Config.RemoveFog = nf
            end
            if Config.CustomFOV ~= nil or Config.CustomFOVEnabled ~= nil then
                local cf = (Config.CustomFOVEnabled == true or Config.CustomFOV == true)
                Config.CustomFOV = cf
                Config.CustomFOVEnabled = cf
            end
            if Config.FOVValue ~= nil or Config.FOV ~= nil then
                local fv = Config.FOV or Config.FOVValue or 80
                Config.FOV = fv
                Config.FOVValue = fv
            end
            if Config.ESP_WindowAura ~= nil or Config.ESP_WindowChams ~= nil then
                local wc = (Config.ESP_WindowAura == true or Config.ESP_WindowChams == true)
                Config.ESP_WindowAura = wc
                Config.ESP_WindowChams = wc
            end
            if Config.ESP_SurvivorSkills ~= nil or Config.ESP_SurvivorCooldown ~= nil then
                local sc = (Config.ESP_SurvivorSkills == true or Config.ESP_SurvivorCooldown == true)
                Config.ESP_SurvivorSkills = sc
                Config.ESP_SurvivorCooldown = sc
            end
            local scMode = Config.AutoSkillCheckMode
            if scMode ~= "Random" and scMode ~= "Perfect" and scMode ~= "Normal" then
                Config.AutoSkillCheckMode = "Perfect"
            end
            local avoidD = tonumber(Config.AutoFarm_AvoidDist)
            if not avoidD or avoidD ~= avoidD then
                Config.AutoFarm_AvoidDist = 48
            else
                Config.AutoFarm_AvoidDist = math.clamp(math.floor(avoidD + 0.5), 20, 90)
            end
            if Config.AutoFarm_SmartChase == nil then Config.AutoFarm_SmartChase = true end
            if Config.ServerHop_SameRegion == nil then Config.ServerHop_SameRegion = true end
            if Config.ConfigAutoSaveEnabled == nil then Config.ConfigAutoSaveEnabled = true end
            if Config.AvatarCopy_Enabled == nil then Config.AvatarCopy_Enabled = false end
            if Config.AvatarCopy_Username == nil then Config.AvatarCopy_Username = "" end
            if Config.AvatarCopy_BlurName == nil then Config.AvatarCopy_BlurName = false end
            if type(Config.AvatarCopy_SavedNames) ~= "table" then Config.AvatarCopy_SavedNames = {} end
        end
        function ConfigSys.GetAutoloadPaths()
            local uid = LocalPlayer and tostring(LocalPlayer.UserId) or "0"
            return ConfigSys.Folder .. "/autoload_" .. uid .. ".txt", ConfigSys.Folder .. "/autoload.txt"
        end
        function ConfigSys.SaveProfile(name)
            ConfigSys.PendingSave = false
            ConfigSys.SaveToken = ConfigSys.SaveToken + 1
            local ok = false
            pcall(function()
                if makefolder and isfolder and not isfolder(ConfigSys.Folder) then
                    makefolder(ConfigSys.Folder)
                end
                if writefile then
                    local prof = (name and name ~= "" and name) or ConfigSys.CurrentProfile or "Default"
                    local data = HttpService:JSONEncode(ConfigSys.Serialize(Config))
                    writefile(ConfigSys.Folder .. "/" .. prof .. ".json", data)
                    ok = true
                end
            end)
            return ok
        end
        local function CloneDefaultVal(v)
            if type(v) ~= "table" then return v end
            local out = {}
            for k, item in pairs(v) do
                out[k] = CloneDefaultVal(item)
            end
            return out
        end
        function ConfigSys.CaptureDefaults(onlyNew)
            if type(Config) ~= "table" then return end
            if not ConfigSys.Defaults then ConfigSys.Defaults = {} end
            for k, v in pairs(Config) do
                if not onlyNew or ConfigSys.Defaults[k] == nil then
                    ConfigSys.Defaults[k] = CloneDefaultVal(v)
                end
            end
        end
        function ConfigSys.FlushAutoSave()
            ConfigSys.SaveToken = ConfigSys.SaveToken + 1
            if not ConfigSys.PendingSave then return end
            ConfigSys.PendingSave = false
            if ConfigSys.Restoring or Config.ConfigAutoSaveEnabled == false then return end
            ConfigSys.SaveProfile(ConfigSys.CurrentProfile or "Default")
        end
        function ConfigSys.ScheduleAutoSave()
            if ConfigSys.Restoring or Config.ConfigAutoSaveEnabled == false then return end
            ConfigSys.PendingSave = true
            ConfigSys.SaveToken = ConfigSys.SaveToken + 1
            local tok = ConfigSys.SaveToken
            task.delay(0.15, function()
                if tok ~= ConfigSys.SaveToken or ConfigSys.Restoring or Config.ConfigAutoSaveEnabled == false then return end
                ConfigSys.PendingSave = false
                ConfigSys.SaveProfile(ConfigSys.CurrentProfile or "Default")
            end)
        end
        if type(Config) == "table" and Config.LockGUI == nil then Config.LockGUI = false end
        ConfigSys.CaptureDefaults()
        _G.Nexara_CaptureDefaults = ConfigSys.CaptureDefaults
        _G.Nexara_ScheduleAutoSave = ConfigSys.ScheduleAutoSave
        _G.Nexara_FlushAutoSave = ConfigSys.FlushAutoSave
        _G.Nexara_SafeCfgV2 = true
        function ConfigSys.LoadProfile(name, isStartup)
            local loaded = false
            local prof = (name and name ~= "" and name) or "Default"
            local path = ConfigSys.Folder .. "/" .. prof .. ".json"
            if not (readfile and isfile and isfile(path)) then return false end
            ConfigSys.SaveToken = ConfigSys.SaveToken + 1
            ConfigSys.PendingSave = false
            ConfigSys.Restoring = true
            pcall(function()
                local data = HttpService:JSONDecode(readfile(path))
                if type(data) == "table" then
                    if ConfigSys.Defaults then
                        for k, v in pairs(ConfigSys.Defaults) do
                            Config[k] = CloneDefaultVal(v)
                        end
                    end
                    if not isStartup then
                        Config.SelectedWorldPreset = nil
                    end
                    for k, v in pairs(data) do
                        Config[k] = ConfigSys.Deserialize(v)
                    end
                    ConfigSys.CurrentProfile = prof
                    loaded = true
                end
            end)
            ConfigSys.NormalizeConfig()
            if loaded and not isStartup then
                for _, fn in ipairs(ConfigSys.SyncHandlers) do
                    pcall(fn)
                end
                if ConfigSys.ApplySideEffects then pcall(ConfigSys.ApplySideEffects) end
                if ConfigSys.UpdateStatusLabel then pcall(ConfigSys.UpdateStatusLabel) end
            end
            ConfigSys.Restoring = false
            return loaded
        end
        do
            local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            local B64_INV = {}
            for i = 1, 64 do B64_INV[B64_CHARS:byte(i)] = i - 1 end
            local function b64Encode(s)
                local out = {}
                local n = #s
                local i = 1
                while i <= n do
                    local a = s:byte(i) or 0
                    local b = (i + 1 <= n) and s:byte(i + 1) or nil
                    local c = (i + 2 <= n) and s:byte(i + 2) or nil
                    local triple = bit32.lshift(a, 16) + bit32.lshift(b or 0, 8) + (c or 0)
                    out[#out + 1] = B64_CHARS:sub(bit32.band(bit32.rshift(triple, 18), 63) + 1, bit32.band(bit32.rshift(triple, 18), 63) + 1)
                    out[#out + 1] = B64_CHARS:sub(bit32.band(bit32.rshift(triple, 12), 63) + 1, bit32.band(bit32.rshift(triple, 12), 63) + 1)
                    out[#out + 1] = b and B64_CHARS:sub(bit32.band(bit32.rshift(triple, 6), 63) + 1, bit32.band(bit32.rshift(triple, 6), 63) + 1) or "="
                    out[#out + 1] = c and B64_CHARS:sub(bit32.band(triple, 63) + 1, bit32.band(triple, 63) + 1) or "="
                    i = i + 3
                end
                return table.concat(out)
            end
            local function b64Decode(s)
                local out = {}
                local n = #s
                local i = 1
                while i <= n do
                    local c1 = B64_INV[s:byte(i)]
                    local c2 = B64_INV[s:byte(i + 1)]
                    if not c1 or not c2 then return nil end
                    local b3 = s:byte(i + 2)
                    local b4 = s:byte(i + 3)
                    local c3 = (b3 and b3 ~= 61) and B64_INV[b3] or nil
                    local c4 = (b4 and b4 ~= 61) and B64_INV[b4] or nil
                    local triple = bit32.lshift(c1, 18) + bit32.lshift(c2, 12) + bit32.lshift(c3 or 0, 6) + (c4 or 0)
                    out[#out + 1] = string.char(bit32.band(bit32.rshift(triple, 16), 255))
                    if c3 then out[#out + 1] = string.char(bit32.band(bit32.rshift(triple, 8), 255)) end
                    if c4 then out[#out + 1] = string.char(bit32.band(triple, 255)) end
                    i = i + 4
                end
                return table.concat(out)
            end
            local function checksum4(s)
                local h = 21661
                for i = 1, #s do
                    h = (h * 33 + s:byte(i)) % 65536
                end
                return string.format("%04X", h)
            end
            local SHARE_PRIVATE_KEYS = {
                AvatarCopy_Enabled = true, AvatarCopy_Username = true, AvatarCopy_BlurName = true, AvatarCopy_SavedNames = true,
                StreamerMode = true, PlatformMode = true, LockGUI = true, MinimizeUIOnStart = true,
                ConfigAutoSaveEnabled = true, AutoloadMode = true, UI_Language = true,
            }
            local function shareValEqual(a, b)
                local ta, tb = typeof(a), typeof(b)
                if ta ~= tb then return false end
                if ta == "Color3" then
                    return math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
                elseif ta == "EnumItem" then
                    return a == b
                elseif ta == "table" then
                    local ca, cb = 0, 0
                    for k, v in pairs(a) do ca = ca + 1; if not shareValEqual(v, b[k]) then return false end end
                    for _ in pairs(b) do cb = cb + 1 end
                    return ca == cb
                end
                return a == b
            end
            local function compactVal(v)
                local tv = typeof(v)
                if tv == "Color3" then
                    return string.format("#%02X%02X%02X", math.clamp(math.floor(v.R * 255 + 0.5), 0, 255), math.clamp(math.floor(v.G * 255 + 0.5), 0, 255), math.clamp(math.floor(v.B * 255 + 0.5), 0, 255))
                elseif tv == "EnumItem" then
                    return "@" .. tostring(v.EnumType):gsub("^Enum%.", "") .. "." .. v.Name
                elseif tv == "table" then
                    local out = {}
                    for k, item in pairs(v) do out[k] = compactVal(item) end
                    return out
                elseif tv == "boolean" or tv == "number" or tv == "string" then
                    return v
                end
                return nil
            end
            local function expandVal(v, defVal)
                local tv = type(v)
                if tv == "string" then
                    local r, g, b = v:match("^#([0-9A-Fa-f][0-9A-Fa-f])([0-9A-Fa-f][0-9A-Fa-f])([0-9A-Fa-f][0-9A-Fa-f])$")
                    if r and g and b then
                        return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
                    end
                    local eType, eName = v:match("^@([%w_]+)%.([%w_]+)$")
                    if eType and eName then
                        local okE, resE = pcall(function() return Enum[eType][eName] end)
                        if okE and resE then return resE end
                        return defVal
                    end
                    return v
                elseif tv == "table" then
                    local out = {}
                    for k, item in pairs(v) do out[k] = expandVal(item, type(defVal) == "table" and defVal[k] or nil) end
                    return out
                end
                return v
            end
            function ConfigSys.GetProfileList()
                local list = { "Default" }
                pcall(function()
                    if listfiles and isfolder and isfolder(ConfigSys.Folder) then
                        for _, path in ipairs(listfiles(ConfigSys.Folder)) do
                            local name = path:match("([^/\\]+)%.json$")
                            if name and not table.find(list, name) then
                                table.insert(list, name)
                            end
                        end
                    end
                end)
                table.sort(list, function(a, b)
                    if a == "Default" then return true end
                    if b == "Default" then return false end
                    return a:lower() < b:lower()
                end)
                return list
            end
            local B62 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
            local function keyHash3(k)
                local h = 5381
                for i = 1, #k do h = (h * 33 + k:byte(i)) % 238328 end
                local c1 = (h % 62) + 1; h = math.floor(h / 62)
                local c2 = (h % 62) + 1; h = math.floor(h / 62)
                local c3 = (h % 62) + 1
                return B62:sub(c3, c3) .. B62:sub(c2, c2) .. B62:sub(c1, c1)
            end
            local function buildKeyMaps(defs)
                local k2h, h2k, sorted = {}, {}, {}
                for k in pairs(defs) do
                    if type(k) == "string" and not SHARE_PRIVATE_KEYS[k] then sorted[#sorted + 1] = k end
                end
                table.sort(sorted)
                for _, k in ipairs(sorted) do
                    local tag = keyHash3(k)
                    if h2k[tag] then
                        k2h[k] = k
                        h2k[k] = k
                    else
                        k2h[k] = tag
                        h2k[tag] = k
                    end
                end
                return k2h, h2k
            end
            local function encodeCompactVal(v)
                local tv = typeof(v)
                if tv == "boolean" then return v and "T" or "F"
                elseif tv == "number" then
                    local s = string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", "")
                    return "n" .. s
                elseif tv == "Color3" then
                    return string.format("c%02X%02X%02X", math.clamp(math.floor(v.R * 255 + 0.5), 0, 255), math.clamp(math.floor(v.G * 255 + 0.5), 0, 255), math.clamp(math.floor(v.B * 255 + 0.5), 0, 255))
                elseif tv == "EnumItem" then
                    return "e" .. tostring(v.EnumType):gsub("^Enum%.", "") .. "." .. v.Name
                elseif tv == "string" then
                    return "s" .. tostring(#v) .. ":" .. v
                elseif tv == "table" then
                    local okJ, js = pcall(HttpService.JSONEncode, HttpService, compactVal(v))
                    if okJ and type(js) == "string" then return "j" .. tostring(#js) .. ":" .. js end
                end
                return nil
            end
            function ConfigSys.ExportShareCode(profileName)
                local srcCfg = Config
                local prof = (profileName and profileName ~= "" and profileName) or ConfigSys.CurrentProfile or "Default"
                if prof ~= (ConfigSys.CurrentProfile or "Default") then
                    local pth = ConfigSys.Folder .. "/" .. prof .. ".json"
                    if readfile and isfile and isfile(pth) then
                        local okR, raw = pcall(function() return HttpService:JSONDecode(readfile(pth)) end)
                        if okR and type(raw) == "table" then
                            local tmp = {}
                            if ConfigSys.Defaults then
                                for k, v in pairs(ConfigSys.Defaults) do tmp[k] = CloneDefaultVal(v) end
                            end
                            for k, v in pairs(raw) do tmp[k] = ConfigSys.Deserialize(v) end
                            srcCfg = tmp
                        end
                    end
                end
                local defs = ConfigSys.Defaults or {}
                local k2h = buildKeyMaps(defs)
                local parts = {}
                for k, v in pairs(srcCfg) do
                    if type(k) == "string" and not SHARE_PRIVATE_KEYS[k] and defs[k] ~= nil then
                        if not shareValEqual(v, defs[k]) then
                            local ev = encodeCompactVal(v)
                            if ev then parts[#parts + 1] = (k2h[k] or k) .. "=" .. ev end
                        end
                    end
                end
                local rawStream = table.concat(parts, ";")
                local b64 = b64Encode(rawStream)
                return "NX2:" .. checksum4(b64) .. ":" .. b64, nil
            end
            function ConfigSys.ImportShareCode(rawStr, targetName)
                if type(rawStr) ~= "string" then return false, "Empty share code" end
                local cleaned = rawStr:gsub("%s+", "")
                local ver, chk, b64 = cleaned:match("^(NX[12]):([0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]):([A-Za-z0-9+/=]+)$")
                if not ver or not chk or not b64 then
                    return false, "Invalid code format (expect NX2:...)"
                end
                if chk:upper() ~= checksum4(b64) then
                    return false, "Incomplete or corrupted code"
                end
                local decoded = b64Decode(b64)
                if not decoded then return false, "Corrupted base64 payload" end
                local defs = ConfigSys.Defaults or {}
                local merged = {}
                for k, v in pairs(defs) do
                    if SHARE_PRIVATE_KEYS[k] and Config[k] ~= nil then
                        merged[k] = CloneDefaultVal(Config[k])
                    else
                        merged[k] = CloneDefaultVal(v)
                    end
                end
                if ver == "NX1" then
                    local okD, delta = pcall(HttpService.JSONDecode, HttpService, decoded)
                    if not okD or type(delta) ~= "table" then return false, "Invalid config payload" end
                    for k, v in pairs(delta) do
                        if type(k) == "string" and not SHARE_PRIVATE_KEYS[k] and defs[k] ~= nil then
                            local expVal = expandVal(v, defs[k])
                            if typeof(expVal) == typeof(defs[k]) then merged[k] = expVal end
                        end
                    end
                else
                    local _, h2k = buildKeyMaps(defs)
                    local pos, len = 1, #decoded
                    while pos <= len do
                        local eq = decoded:find("=", pos, true)
                        if not eq then break end
                        local tag = decoded:sub(pos, eq - 1)
                        local realK = h2k[tag] or (defs[tag] ~= nil and tag or nil)
                        local kind = decoded:sub(eq + 1, eq + 1)
                        local val, nextPos = nil, nil
                        if kind == "T" or kind == "F" then
                            val = (kind == "T")
                            nextPos = eq + 3
                        elseif kind == "s" or kind == "j" then
                            local col = decoded:find(":", eq + 2, true)
                            if not col then break end
                            local slen = tonumber(decoded:sub(eq + 2, col - 1)) or 0
                            local body = decoded:sub(col + 1, col + slen)
                            nextPos = col + slen + 2
                            if kind == "s" then
                                val = body
                            else
                                local okJ, jt = pcall(HttpService.JSONDecode, HttpService, body)
                                if okJ and type(jt) == "table" then val = expandVal(jt, realK and defs[realK] or nil) end
                            end
                        else
                            local semi = decoded:find(";", eq + 2, true)
                            local body = decoded:sub(eq + 2, semi and (semi - 1) or len)
                            nextPos = semi and (semi + 1) or (len + 1)
                            if kind == "n" then
                                val = tonumber(body)
                            elseif kind == "c" then
                                local r, g, b = body:match("^([0-9A-Fa-f][0-9A-Fa-f])([0-9A-Fa-f][0-9A-Fa-f])([0-9A-Fa-f][0-9A-Fa-f])$")
                                if r and g and b then val = Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)) end
                            elseif kind == "e" then
                                local eType, eName = body:match("^([%w_]+)%.([%w_]+)$")
                                if eType and eName then
                                    local okE, resE = pcall(function() return Enum[eType][eName] end)
                                    if okE and resE then val = resE end
                                end
                            end
                        end
                        if realK and not SHARE_PRIVATE_KEYS[realK] and defs[realK] ~= nil and val ~= nil and typeof(val) == typeof(defs[realK]) then
                            merged[realK] = val
                        end
                        pos = nextPos or (len + 1)
                    end
                end
                local prof = tostring(targetName or ""):gsub("[^%w%-%_%s]", ""):gsub("^%s+", ""):gsub("%s+$", "")
                if prof == "" then
                    local existing = ConfigSys.GetProfileList()
                    local idx = 1
                    while table.find(existing, "Shared_" .. tostring(idx)) do idx = idx + 1 end
                    prof = "Shared_" .. tostring(idx)
                end
                local okW = false
                pcall(function()
                    if makefolder and isfolder and not isfolder(ConfigSys.Folder) then
                        makefolder(ConfigSys.Folder)
                    end
                    if writefile then
                        writefile(ConfigSys.Folder .. "/" .. prof .. ".json", HttpService:JSONEncode(ConfigSys.Serialize(merged)))
                        okW = true
                    end
                end)
                if not okW then return false, "Could not save imported file" end
                ConfigSys.LoadProfile(prof, false)
