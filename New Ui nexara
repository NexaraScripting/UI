                        row.RankTierLabel.Size = UDim2.new(1, -64, 0, 16)
                        row.RankEloLabel.Position = UDim2.fromOffset(56, rInfo.AltText ~= "" and 20 or 25)
                        row.RankEloLabel.Size = UDim2.new(1, -64, 0, 14)
                        row.RankAltLabel.Position = UDim2.fromOffset(56, 34)
                        row.RankAltLabel.Size = UDim2.new(1, -64, 0, 12)
