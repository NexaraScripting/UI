                        row.RankTierLabel.Position = UDim2.fromOffset(10, rInfo.AltText ~= "" and 4 or 7)
                        row.RankTierLabel.Size = UDim2.new(1, -18, 0, 16)
                        row.RankEloLabel.Position = UDim2.fromOffset(10, rInfo.AltText ~= "" and 20 or 25)
                        row.RankEloLabel.Size = UDim2.new(1, -18, 0, 14)
                        row.RankAltLabel.Position = UDim2.fromOffset(10, 34)
                        row.RankAltLabel.Size = UDim2.new(1, -18, 0, 12)
                    end
                    if row.AvatarImg.Image ~= targetAvatar then
                        row.AvatarImg.Image = targetAvatar
                    end

                    -- Perks populate
                    local perks = {}
                    if ctx.GetPlayerPerks then
                        pcall(function() perks = ctx.GetPlayerPerks(plr) or {} end)
                    else
                        pcall(function() perks = ResolveStandalonePerks(plr, isK) or {} end)
                    end
                    for i = 1, 3 do
                        local pb = row.PerkBoxes[i]
                        local pImg = row.PerkImgs[i]
                        local pPlace = row.PerkPlaceholders[i]
                        local pName = perks[i]
