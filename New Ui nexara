    ConnectUI(UserInputService.InputBegan, function(input, _gpe)
        if UIState.Capturing or UserInputService:GetFocusedTextBox() then return end
        local curToggleKey = Config.MenuToggleKey or Enum.KeyCode.RightControl
        if typeof(curToggleKey) == "string" then
            curToggleKey = Enum.KeyCode[curToggleKey] or Enum.KeyCode.RightControl
        end
        local matched = false
        if typeof(curToggleKey) == "EnumItem" then
            if curToggleKey.EnumType == Enum.KeyCode and input.KeyCode == curToggleKey then
                matched = true
            elseif curToggleKey.EnumType == Enum.UserInputType and input.UserInputType == curToggleKey then
                matched = true
            end
        end
        if matched or input.KeyCode == Enum.KeyCode.Insert then
            ToggleUI()
        end
    end)

