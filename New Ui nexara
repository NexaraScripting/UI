    KeybindBtn.MouseButton1Click:Connect(function()
        if Theme._isMobilePlatform() and Theme._activeKeybindMobEntry then return end
        if isKeybindListening then return end
        isKeybindListening = true
        UIState.Capturing = true
        _G.Nexara_IsCapturingKeybind = true
        KeybindBtn.Text = "[...]"
        KeybindBtn.TextColor3 = Color3.fromRGB(255, 210, 80)
        TweenService:Create(KBStroke, TweenInfo.new(0.18), { Color = Theme.Accent }):Play()

        if keybindInputConn then keybindInputConn:Disconnect(); keybindInputConn = nil end
        if keybindMenuConn then keybindMenuConn:Disconnect(); keybindMenuConn = nil end

        local function finishListen()
            if keybindInputConn then keybindInputConn:Disconnect(); keybindInputConn = nil end
            if keybindMenuConn then keybindMenuConn:Disconnect(); keybindMenuConn = nil end
            -- Defer clearing capture flags so UserInputService handlers on this same Escape press do not immediately close the flyout or trigger binds
            task.defer(function()
                isKeybindListening = false
                UIState.Capturing = false
                _G.Nexara_IsCapturingKeybind = false
            end)
        end

        local function clearToNone()
            if not isKeybindListening then return end
            activeCurrentKey = nil
            KeybindBtn.Text = "[None]"
            KeybindBtn.TextColor3 = Theme.Text
            TweenService:Create(KBStroke, TweenInfo.new(0.18), { Color = Theme.CardStroke }):Play()
            finishListen()
            if activeKeybindCallback then pcall(activeKeybindCallback, nil) end
            ConfigSys.ScheduleAutoSave()
        end

        keybindMenuConn = ConnectUI(game:GetService("GuiService").MenuOpened, clearToNone)

        keybindInputConn = ConnectUI(UserInputService.InputBegan, function(input, gpe)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local keyCode = input.KeyCode
                if keyCode == Enum.KeyCode.Escape or keyCode == Enum.KeyCode.Backspace or keyCode == Enum.KeyCode.Delete then
                    clearToNone()
                    return
                elseif keyCode ~= Enum.KeyCode.Unknown then
                    activeCurrentKey = keyCode
