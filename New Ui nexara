                listening = true
                UIState.Capturing = true
                _G.Nexara_IsCapturingKeybind = true
                BindBtn.Text = "[...]"
                BindBtn.TextColor3 = Color3.fromRGB(255, 210, 80)
                TweenService:Create(Stroke, TweenInfo.new(0.18), { Color = Theme.Accent }):Play()

                local conn, menuConn
                local function finishBind()
                    if conn then conn:Disconnect(); conn = nil end
                    if menuConn then menuConn:Disconnect(); menuConn = nil end
                    task.defer(function()
                        listening = false
                        UIState.Capturing = false
                        _G.Nexara_IsCapturingKeybind = false
                    end)
                end
                local function clearBind()
                    if not listening then return end
                    currentKey = nil
                    BindBtn.Text = "[None]"
                    BindBtn.TextColor3 = Theme.Text
                    TweenService:Create(Stroke, TweenInfo.new(0.18), { Color = Theme.CardStroke }):Play()
                    finishBind()
                    if onKeyChange then pcall(onKeyChange, nil) end
                    ConfigSys.ScheduleAutoSave()
                end
                menuConn = ConnectUI(game:GetService("GuiService").MenuOpened, clearBind)
                conn = ConnectUI(UserInputService.InputBegan, function(input, gpe)
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        local keyCode = input.KeyCode
                        if keyCode == Enum.KeyCode.Escape or keyCode == Enum.KeyCode.Backspace or keyCode == Enum.KeyCode.Delete then
                            clearBind()
                            return
                        elseif keyCode ~= Enum.KeyCode.Unknown then
                            currentKey = keyCode
                            BindBtn.Text = "[" .. ConfigSys.FormatKey(currentKey) .. "]"
                            BindBtn.TextColor3 = Theme.Text
                            TweenService:Create(Stroke, TweenInfo.new(0.18), { Color = Theme.CardStroke }):Play()
                            finishBind()
                            if onKeyChange then pcall(onKeyChange, currentKey) end
                            ConfigSys.ScheduleAutoSave()
                            return
                        end
                    elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
                        currentKey = Enum.UserInputType.MouseButton3
                        BindBtn.Text = "[MB3]"
                        BindBtn.TextColor3 = Theme.Text
                        TweenService:Create(Stroke, TweenInfo.new(0.18), { Color = Theme.CardStroke }):Play()
                        finishBind()
                        if onKeyChange then pcall(onKeyChange, currentKey) end
                        ConfigSys.ScheduleAutoSave()
                        return
                    end
                end)
            end)

            return {
                Set = function(key, silent)
                    currentKey = key
                    BindBtn.Text = "[" .. ConfigSys.FormatKey(key) .. "]"
                    if not silent then
                        if onKeyChange then pcall(onKeyChange, key) end
                        ConfigSys.ScheduleAutoSave()
                    end
                end,
                Get = function() return currentKey end
            }
        end

