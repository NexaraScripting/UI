    local function ToggleUI(forceState)
        EnsureCap()
        SafeMainAccess()
        local okVis, realVis = pcall(function() return MainFrame.Visible and (not Theme._mainIsCanvas or MainFrame.GroupTransparency < 0.95) end)
        local effVisible = okVis and realVis or UIState.Visible
        local targetState = (forceState ~= nil) and forceState or (not effVisible)
        if targetState == effVisible and targetState == UIState.Visible and not UIState.Animating then return end

        UIState.Token = UIState.Token + 1
        local myToken = UIState.Token
        for _, tw in ipairs(UIState.Tweens) do
            pcall(function() tw:Cancel() end)
        end
        table.clear(UIState.Tweens)

        UIState.Animating = true
        UIState.Visible = targetState
        if WindowObjRef then
            WindowObjRef.Visible = targetState
        end
        if ctx.UpdateMouseUnlock then
            pcall(ctx.UpdateMouseUnlock)
        elseif _G.Nexara_UpdateMouseUnlock then
            pcall(_G.Nexara_UpdateMouseUnlock)
        end

        local curBaseScale = UIState.BaseScale or 1.0

        if targetState then
            if Theme._closeAllFlyouts then pcall(Theme._closeAllFlyouts) end

            local openTargetPos = Theme._clampMainPos(UIState.SavedPos or UDim2.new(0.5, 0, 0.5, 0), curBaseScale)
            UIState.SavedPos = openTargetPos
            local openStartPos = UDim2.new(openTargetPos.X.Scale, openTargetPos.X.Offset, openTargetPos.Y.Scale, openTargetPos.Y.Offset + 18)

            pcall(function()
                MainFrame.Position = openStartPos
                MainScale.Scale = curBaseScale * 0.90
                if Theme._mainIsCanvas then MainFrame.GroupTransparency = 1 end
                MainFrame.Visible = true
            end)

            local openProps = Theme._mainIsCanvas and { Position = openTargetPos, GroupTransparency = 0 } or { Position = openTargetPos }
            local okTw, tOpen, sOpen = pcall(function()
                return TweenService:Create(MainFrame, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), openProps),
                    TweenService:Create(MainScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Scale = curBaseScale
                    })
            end)
            if okTw and tOpen and sOpen then
                table.insert(UIState.Tweens, tOpen)
                table.insert(UIState.Tweens, sOpen)
                tOpen:Play()
                sOpen:Play()
                task.delay(0.24, function()
                    SafeMainAccess()
                    if myToken ~= UIState.Token then return end
                    UIState.Animating = false
                    pcall(function()
                        MainFrame.Position = openTargetPos
                        MainScale.Scale = UIState.BaseScale or curBaseScale
                        if Theme._mainIsCanvas then MainFrame.GroupTransparency = 0 end
                    end)
                    Theme._refreshScaledLayouts()
                end)
            else
                UIState.Animating = false
                pcall(function()
                    MainFrame.Position = openTargetPos
                    MainScale.Scale = UIState.BaseScale or curBaseScale
                    if Theme._mainIsCanvas then MainFrame.GroupTransparency = 0 end
                    MainFrame.Visible = true
                end)
                Theme._refreshScaledLayouts()
            end
        else
            if Theme._closeAllFlyouts then pcall(Theme._closeAllFlyouts) end

            local okPos, curPos = pcall(function() return MainFrame.Position end)
            UIState.SavedPos = (okPos and curPos) or UIState.SavedPos or UDim2.new(0.5, 0, 0.5, 0)
            local closeTargetPos = UDim2.new(UIState.SavedPos.X.Scale, UIState.SavedPos.X.Offset, UIState.SavedPos.Y.Scale, UIState.SavedPos.Y.Offset + 18)

            local function finishClose()
                SafeMainAccess()
                if myToken ~= UIState.Token then return end
                if not UIState.Visible then
                    pcall(function() MainFrame.Visible = false end)
                end
                UIState.Animating = false
                -- Never trap touch users without an on-screen reopen button.
                if MobileToggleBtn and (Config.PlatformMode == "Mobile" or UIState.Touch or UIState.SawTouch or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)) then
                    pcall(function()
                        MobileToggleBtn.Position = Theme._clampMobBtnPos(MobileToggleBtn.Position)
                        MobileToggleBtn.Visible = true
                    end)
                end
            end

            local closeProps = Theme._mainIsCanvas and { Position = closeTargetPos, GroupTransparency = 1 } or { Position = closeTargetPos }
            local okTw, tClose, sClose = pcall(function()
                return TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), closeProps),
                    TweenService:Create(MainScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Scale = curBaseScale * 0.90
                    })
            end)
            if okTw and tClose and sClose then
                table.insert(UIState.Tweens, tClose)
                table.insert(UIState.Tweens, sClose)
                tClose:Play()
                sClose:Play()
                task.delay(0.18, finishClose)
            else
                finishClose()
            end
        end
    end

