    local function ToggleUI(forceState)
        EnsureCap()
        local targetState = (forceState ~= nil) and forceState or (not UIState.Visible)
        if targetState == UIState.Visible and not UIState.Animating then return end

        UIState.Token = UIState.Token + 1
        local myToken = UIState.Token
        for _, tw in ipairs(UIState.Tweens) do
            pcall(function() tw:Cancel() end)
        end
        table.clear(UIState.Tweens)

        UIState.Animating = true
        UIState.Visible = targetState
        if WindowObjRef then
            WindowObjRef.Visible = targetState
        end
        if ctx.UpdateMouseUnlock then
            pcall(ctx.UpdateMouseUnlock)
        elseif _G.Nexara_UpdateMouseUnlock then
            pcall(_G.Nexara_UpdateMouseUnlock)
        end
        EnsureCap()

        local curBaseScale = UIState.BaseScale or 1.0

        if targetState then
            if Theme._closeAllFlyouts then pcall(Theme._closeAllFlyouts) end

            local openTargetPos = Theme._clampMainPos(UIState.SavedPos or UDim2.new(0.5, 0, 0.5, 0), curBaseScale)
            UIState.SavedPos = openTargetPos
            local openStartPos = UDim2.new(openTargetPos.X.Scale, openTargetPos.X.Offset, openTargetPos.Y.Scale, openTargetPos.Y.Offset + 18)

            MainFrame.Position = openStartPos
            MainScale.Scale = curBaseScale * 0.90
            MainFrame.GroupTransparency = 1
            MainFrame.Visible = true

            local tOpen = TweenService:Create(MainFrame, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = openTargetPos,
                GroupTransparency = 0
            })
            local sOpen = TweenService:Create(MainScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Scale = curBaseScale
            })
            table.insert(UIState.Tweens, tOpen)
            table.insert(UIState.Tweens, sOpen)
            tOpen:Play()
            sOpen:Play()

            task.delay(0.24, function()
                EnsureCap()
                if myToken ~= UIState.Token then return end
                UIState.Animating = false
                MainFrame.Position = openTargetPos
                MainScale.Scale = UIState.BaseScale or curBaseScale
                MainFrame.GroupTransparency = 0
                Theme._refreshScaledLayouts()
            end)
        else
            if Theme._closeAllFlyouts then pcall(Theme._closeAllFlyouts) end

            UIState.SavedPos = MainFrame.Position
            local closeTargetPos = UDim2.new(UIState.SavedPos.X.Scale, UIState.SavedPos.X.Offset, UIState.SavedPos.Y.Scale, UIState.SavedPos.Y.Offset + 18)

            local tClose = TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = closeTargetPos,
                GroupTransparency = 1
            })
            local sClose = TweenService:Create(MainScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Scale = curBaseScale * 0.90
            })
            table.insert(UIState.Tweens, tClose)
            table.insert(UIState.Tweens, sClose)
            tClose:Play()
            sClose:Play()

            task.delay(0.18, function()
                EnsureCap()
                if myToken ~= UIState.Token then return end
                if not UIState.Visible then
                    MainFrame.Visible = false
                end
                UIState.Animating = false
                if (Config.PlatformMode == "Mobile" or (UIState.Touch and Config.PlatformMode ~= "PC")) and MobileToggleBtn then
                    MobileToggleBtn.Visible = true
                end
            end)
        end
    end

