            if ctx.GetRosterItemDisplay then
                local ok, name, det, col = pcall(ctx.GetRosterItemDisplay, plr, isK)
                if ok and name then return name, det, col end
            end
            if isK then
                local kType = ResolveKillerType(plr)
                return kType .. " Power", "Ready", Color3.fromRGB(255, 100, 120)
            end
            local char = plr.Character
            local bp = plr:FindFirstChild("Backpack")
            local it = plr:GetAttribute("EquippedItem") or (char and char:GetAttribute("EquippedItem"))
            if not it and bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") and not t.Name:lower():find("fist") then it = t.Name; break end
                end
            end
            if not it and char then
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") and not t.Name:lower():find("fist") then it = t.Name; break end
                end
            end
            if it and it ~= "" then
