        Theme.Accent = newColor
        HeaderAccent.BackgroundColor3 = newColor
        if Logo then Logo.ImageColor3 = newColor end
        for _, item in ipairs(self.AccentElements) do
            pcall(function()
                if item.Inst and item.Inst.Parent then
                    item.Inst[item.Prop] = newColor
                end
            end)
        end
        if self.ActiveTab then
            if self.ActiveTab.ActiveLine then self.ActiveTab.ActiveLine.BackgroundColor3 = newColor end
            if self.ActiveTab.IconImage then self.ActiveTab.IconImage.ImageColor3 = newColor end
        end
        for _, cb in ipairs(self.AccentCallbacks or {}) do
