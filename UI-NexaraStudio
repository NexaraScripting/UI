    local isTweeningVis = false
    function WindowObj:SetVisible(state, instant)
        if self.Visible == state and not isTweeningVis then return end
        self.Visible = state

        if state then
            MainFrame.Visible = true
            if not instant and uiScale then
                uiScale.Scale = 0.88
                local openTween = TweenService:Create(uiScale, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
                openTween:Play()
            elseif uiScale then
                uiScale.Scale = 1
            end
            if self.ActiveTab and self.ActiveTab.View then
                self.ActiveTab.View.Position = UDim2.new(0, 0, 0, not instant and 8 or 0)
                if not instant then
                    TweenService:Create(self.ActiveTab.View, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0, 0, 0, 0)
                    }):Play()
                end
            end
            if self.DimEnabled and self.DimOverlay then
                self.DimOverlay.Visible = true
                if instant then
                    self.DimOverlay.BackgroundTransparency = 0.5
                else
                    Tween(self.DimOverlay, TweenInfo.new(0.2), { BackgroundTransparency = 0.5 })
                end
            end
            if self.ActiveBlur then
                self.ActiveBlur.Enabled = true
            end
            if self.WeatherLayer then
                self.WeatherLayer.Visible = true
            end
            if self.PreviewWindow and self.PreviewWindow.MainFrame then
                self.PreviewWindow.MainFrame.Visible = true
            end
            EnforceMouseState()
        else
            if self.WeatherLayer then
                self.WeatherLayer.Visible = false
            end
            if self.DimOverlay then
                if instant then
                    self.DimOverlay.BackgroundTransparency = 1
                    self.DimOverlay.Visible = false
                else
                    Tween(self.DimOverlay, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
                    task.delay(0.2, function()
                        if not WindowObj.Visible then self.DimOverlay.Visible = false end
                    end)
                end
            end
            if self.ActiveBlur then
                self.ActiveBlur.Enabled = false
            end
            if instant then
                MainFrame.Visible = false
                if uiScale then uiScale.Scale = 0.88 end
                if self.PreviewWindow and self.PreviewWindow.MainFrame then
                    self.PreviewWindow.MainFrame.Visible = false
                end
            elseif uiScale then
                isTweeningVis = true
                local closeTween = TweenService:Create(uiScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.88 })
                closeTween:Play()
                closeTween.Completed:Connect(function()
                    if not WindowObj.Visible then
                        MainFrame.Visible = false
                        if WindowObj.PreviewWindow and WindowObj.PreviewWindow.MainFrame then
                            WindowObj.PreviewWindow.MainFrame.Visible = false
                        end
                    end
                    isTweeningVis = false
                end)
            else
                MainFrame.Visible = false
                if self.PreviewWindow and self.PreviewWindow.MainFrame then
                    self.PreviewWindow.MainFrame.Visible = false
                end
            end
        end
    end

