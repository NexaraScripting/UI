local function Tween(instance, info, properties)
    local tw = TweenService:Create(instance, info, properties)
    tw:Play()
    return tw
end

local function MakeDraggable(dragHandle, frameToMove, getDragStyle, getAccentColor)
    local dragging = false
    local dragStart, startPos
    local ghostOutline = nil

    local function EndDrag()
        if not dragging then return end
        dragging = false
        if ghostOutline then
            local finalPos = ghostOutline.Position
            ghostOutline:Destroy()
            ghostOutline = nil
            TweenService:Create(frameToMove, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = finalPos
            }):Play()
        end
    end

    local function StartDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if Nexara.ActiveDropdown then pcall(function() Nexara.ActiveDropdown:Close(false) end) end
            if Nexara.ActiveColorpicker then pcall(function() Nexara.ActiveColorpicker:Close(false) end) end
            dragging = true
            dragStart = input.Position
            startPos = frameToMove.Position

            local style = getDragStyle and getDragStyle() or "Outline"
            if style == "Outline" then
                if ghostOutline then
                    ghostOutline:Destroy()
                    ghostOutline = nil
                end
                ghostOutline = Instance.new("Frame")
                ghostOutline.Name = "DragGhost"
                ghostOutline.AnchorPoint = frameToMove.AnchorPoint
                ghostOutline.Size = frameToMove.Size
                ghostOutline.Position = frameToMove.Position
                ghostOutline.BackgroundTransparency = 0.88
                ghostOutline.BackgroundColor3 = getAccentColor and getAccentColor() or Color3.fromRGB(46, 213, 192)
                ghostOutline.BorderSizePixel = 0
                ghostOutline.ZIndex = 999
                ghostOutline.Parent = frameToMove.Parent

                local s = Instance.new("UIStroke")
                s.Color = getAccentColor and getAccentColor() or Color3.fromRGB(46, 213, 192)
                s.Thickness = 1.5
                s.Parent = ghostOutline

                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, 10)
                c.Parent = ghostOutline
            end
        end
    end

    dragHandle.InputBegan:Connect(StartDrag)
    for _, child in ipairs(dragHandle:GetChildren()) do
        if child:IsA("GuiObject") and not child:IsA("TextButton") and not child:IsA("ImageButton") then
            child.InputBegan:Connect(StartDrag)
        end
    end
    dragHandle.ChildAdded:Connect(function(child)
        if child:IsA("GuiObject") and not child:IsA("TextButton") and not child:IsA("ImageButton") then
            child.InputBegan:Connect(StartDrag)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            EndDrag()
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local targetPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
            if ghostOutline then
                ghostOutline.Position = targetPos
            else
                frameToMove.Position = targetPos
            end
        end
    end)
end

