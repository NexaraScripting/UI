local function GetConfigList()
    local list = {"Default"}
    pcall(function()
        if listfiles and isfolder and isfolder(ConfigDirectory) then
            for _, path in ipairs(listfiles(ConfigDirectory)) do
                local name = path:match("([^/\\]+)%.json$")
                if name and not table.find(list, name) then
                    table.insert(list, name)
                end
            end
        end
    end)
    return list
end

