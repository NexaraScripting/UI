                    PopPad.PaddingRight = UDim.new(0, 3)
                    PopPad.Parent = Popup

                    local isOpen = false
                    local selectedVal = dDefault
                    local selectedMulti = {}
                    if dMulti and type(dDefault) == "table" then
                        for _, item in ipairs(dDefault) do selectedMulti[item] = true end
                    end

                    local RebuildOptions
                    local currentTween = nil
                    local isPopupHovered = false

                    local DropItem = {
                        Value = selectedVal,
                        Flag = dFlag,
                    }

                    function DropItem:Close(animate)
                        if not isOpen and not currentTween then return end
                        isOpen = false
                        Arrow.Text = "▼"
                        if Nexara.ActiveDropdown == DropItem then
                            Nexara.ActiveDropdown = nil
                        end
                        if animate == false then
                            if currentTween then currentTween:Cancel(); currentTween = nil end
                            Popup.Size = UDim2.fromOffset(DropBtn.AbsoluteSize.X, 0)
                            Popup.Visible = false
                            return
                        end
                        if currentTween then currentTween:Cancel() end
                        currentTween = TweenService:Create(Popup, TweenInfo.new(0.14, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {
                            Size = UDim2.fromOffset(DropBtn.AbsoluteSize.X, 0)
                        })
                        currentTween:Play()
                        currentTween.Completed:Connect(function(playbackState)
                            if not isOpen and playbackState == Enum.PlaybackState.Completed then
                                Popup.Visible = false
                            end
                            currentTween = nil
                        end)
                    end

                    function DropItem:Open()
                        if Nexara.ActiveDropdown and Nexara.ActiveDropdown ~= DropItem then
                            Nexara.ActiveDropdown:Close(false)
                        end
                        RebuildOptions()
                        isOpen = true
                        Nexara.ActiveDropdown = DropItem
                        Arrow.Text = "▲"

                        local mw = WindowObj.MainFrame
                        local mwTop = (mw and mw.AbsolutePosition.Y + 34) or 10
                        local mwBottom = (mw and (mw.AbsolutePosition.Y + mw.AbsoluteSize.Y - 6)) or 1070
                        local btnX = DropBtn.AbsolutePosition.X
                        local btnY = DropBtn.AbsolutePosition.Y
                        local btnW = DropBtn.AbsoluteSize.X
                        local btnH = DropBtn.AbsoluteSize.Y

                        local maxItems = math.min(#dOptions, 5)
                        local itemHeight = 24
                        local itemSpacing = 1
                        local padVertical = 6
                        local idealHeight = maxItems * (itemHeight + itemSpacing) + padVertical
                        local popHeight = idealHeight

                        local gs = game:GetService("GuiService")
                        local insetY = gs:GetGuiInset().Y

                        local targetScreenY = btnY + btnH + 2
                        local spaceBelow = mwBottom - targetScreenY
                        if popHeight > spaceBelow then
                            popHeight = math.clamp(spaceBelow - 2, 75, idealHeight)
                        end

                        Popup.CanvasPosition = Vector2.new(0, 0)
                        Popup.Position = UDim2.fromOffset(btnX, targetScreenY + insetY)
                        Popup.CanvasSize = UDim2.fromOffset(0, #dOptions * (itemHeight + itemSpacing) + padVertical)
                        Popup.Size = UDim2.fromOffset(btnW, 0)
                        Popup.Visible = true

                        if currentTween then currentTween:Cancel() end
                        currentTween = TweenService:Create(Popup, TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                            Size = UDim2.fromOffset(btnW, popHeight)
                        })
                        currentTween:Play()
                        currentTween.Completed:Connect(function()
                            currentTween = nil
                        end)
                    end

                    local lastToggle = 0
                    local function ToggleDropdown()
                        if os.clock() - lastToggle < 0.1 then return end
                        lastToggle = os.clock()
                        if isOpen then
                            DropItem:Close()
                        else
                            DropItem:Open()
                        end
                    end
                    DropBtn.MouseButton1Click:Connect(ToggleDropdown)

                    Popup.MouseEnter:Connect(function() isPopupHovered = true end)
                    Popup.MouseLeave:Connect(function() isPopupHovered = false end)

                    if Col then
                        local scrollConn = Col:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
                            if isOpen and not isPopupHovered then
                                DropItem:Close(false)
                            end
                        end)
                        table.insert(WindowObj.Library.Connections, scrollConn)
                    end

                    local winMoveConn = WindowObj.MainFrame:GetPropertyChangedSignal("Position"):Connect(function()
                        if isOpen then DropItem:Close(false) end
                    end)
                    table.insert(WindowObj.Library.Connections, winMoveConn)

                    local outsideConn = UserInputService.InputBegan:Connect(function(input)
                        if isOpen and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                            local mPos = input.Position
                            local pPos = Popup.AbsolutePosition
                            local pSize = Popup.AbsoluteSize
                            local bPos = DropBtn.AbsolutePosition
                            local bSize = DropBtn.AbsoluteSize
                            local inP = (mPos.X >= pPos.X and mPos.X <= pPos.X + pSize.X and mPos.Y >= pPos.Y and mPos.Y <= pPos.Y + pSize.Y)
                            local inB = (mPos.X >= bPos.X and mPos.X <= bPos.X + bSize.X and mPos.Y >= bPos.Y and mPos.Y <= bPos.Y + bSize.Y)
                            if inB then
                                return
                            end
                            if not inP then
                                DropItem:Close()
                            end
                        end
                    end)
                    table.insert(WindowObj.Library.Connections, outsideConn)

                    RebuildOptions = function()
                        for _, child in ipairs(Popup:GetChildren()) do
                            if child:IsA("TextButton") then child:Destroy() end
                        end
                        for _, opt in ipairs(dOptions) do
                            local isSel = dMulti and selectedMulti[opt] or (selectedVal == opt)
                            local optBtn = Instance.new("TextButton")
                            optBtn.Name = "Option_" .. tostring(opt)
                            optBtn.Size = UDim2.new(1, -4, 0, 24)
                            optBtn.BackgroundTransparency = isSel and 0.82 or 1
                            optBtn.BackgroundColor3 = isSel and Theme.Accent or Theme.Inline
                            optBtn.BorderSizePixel = 0
                            optBtn.Text = "  " .. tostring(opt)
                            optBtn.TextSize = 11
                            optBtn.TextXAlignment = Enum.TextXAlignment.Left
                            optBtn.FontFace = GetPreferredFont()
                            optBtn.ZIndex = 71
                            optBtn.AutoButtonColor = false
                            optBtn.Parent = Popup

                            local optCorner = Instance.new("UICorner")
                            optCorner.CornerRadius = UDim.new(0, 4)
                            optCorner.Parent = optBtn

                            optBtn.TextColor3 = isSel and Theme.Accent or Theme.Text

                            optBtn.MouseEnter:Connect(function()
                                local selNow = dMulti and selectedMulti[opt] or (selectedVal == opt)
                                if not selNow then
                                    optBtn.BackgroundTransparency = 0.2
                                    optBtn.BackgroundColor3 = Theme.Inline
                                end
                            end)
                            optBtn.MouseLeave:Connect(function()
                                local selNow = dMulti and selectedMulti[opt] or (selectedVal == opt)
                                if selNow then
                                    optBtn.BackgroundTransparency = 0.82
                                    optBtn.BackgroundColor3 = Theme.Accent
                                else
                                    optBtn.BackgroundTransparency = 1
                                end
                            end)

                            local function SelectThis()
                                if dMulti then
                                    selectedMulti[opt] = not selectedMulti[opt]
                                    optBtn.TextColor3 = selectedMulti[opt] and Theme.Accent or Theme.Text
                                    optBtn.BackgroundTransparency = selectedMulti[opt] and 0.82 or 1
                                    optBtn.BackgroundColor3 = selectedMulti[opt] and Theme.Accent or Theme.Inline
                                    local picked = {}
                                    for k, v in pairs(selectedMulti) do if v then table.insert(picked, k) end end
                                    SelectedText.Text = #picked > 0 and table.concat(picked, ", ") or "None"
                                    WindowObj.ConfigValues[dFlag] = picked
                                    dCallback(picked)
                                    if WindowObj.OnSilentAutoSave then WindowObj.OnSilentAutoSave() end
                                else
                                    selectedVal = opt
                                    SelectedText.Text = tostring(opt)
                                    DropItem:Close()
                                    WindowObj.ConfigValues[dFlag] = opt
                                    dCallback(opt)
                                    if WindowObj.OnSilentAutoSave then WindowObj.OnSilentAutoSave() end
                                end
                            end

                            local lastSelect = 0
                            optBtn.MouseButton1Click:Connect(function()
                                if os.clock() - lastSelect < 0.1 then return end
                                lastSelect = os.clock()
                                SelectThis()
                            end)
                        end
                    end

                    RebuildOptions()
                    WindowObj:OnAccentChanged(function()
                        RebuildOptions()
                    end)

                    function DropItem:Set(val, silent)
                        if dMulti and type(val) == "table" then
                            selectedMulti = {}
                            for _, it in ipairs(val) do selectedMulti[it] = true end
                            local picked = {}
                            for k, v in pairs(selectedMulti) do if v then table.insert(picked, k) end end
                            SelectedText.Text = #picked > 0 and table.concat(picked, ", ") or "None"
                            selectedVal = picked
                        else
                            selectedVal = val
                            SelectedText.Text = tostring(val)
                        end
                        WindowObj.ConfigValues[dFlag] = val
                        RebuildOptions()
                        dCallback(val)
                        if not silent and WindowObj.OnSilentAutoSave then
                            WindowObj.OnSilentAutoSave()
                        end
                    end

                    function DropItem:Refresh(newOptions)
                        dOptions = newOptions
                        RebuildOptions()
                    end

                    WindowObj.ConfigFlags[dFlag] = DropItem
                    WindowObj.ConfigValues[dFlag] = dDefault
                    return DropItem
                end

