        local mwLeft = (mw and mw.AbsolutePosition.X + 6) or 10
        local mwRight = (mw and (mw.AbsolutePosition.X + mw.AbsoluteSize.X - 6)) or 1900

        local aPos = anchorInstance.AbsolutePosition
        local aSize = anchorInstance.AbsoluteSize

