    function WindowObj:ApplyCustomBackground(imageSource, opacity)
        if not self.CustomBg then return false, "No CustomBg" end
        if not imageSource or imageSource == "" then
            imageSource = "91856257706497"
        end

        local raw = string.gsub(tostring(imageSource), "^%s*(.-)%s*$", "%1")
        if raw == "" then raw = "91856257706497" end
        local resolved = nil

        local extractedId = nil
        if raw:match("^%d+$") then
            extractedId = raw
        elseif raw:match("^rbxassetid://(%d+)$") then
            extractedId = raw:match("^rbxassetid://(%d+)$")
        elseif raw:match("robloxden%.com/decal%-ids/(%d+)") then
            extractedId = raw:match("robloxden%.com/decal%-ids/(%d+)")
        elseif raw:match("robloxden%.com/.*(%d+)") then
            extractedId = raw:match("robloxden%.com/.*(%d+)")
        elseif raw:match("roblox%.com/asset/%?id=(%d+)") then
            extractedId = raw:match("roblox%.com/asset/%?id=(%d+)")
        elseif raw:match("roblox%.com/library/(%d+)") then
            extractedId = raw:match("roblox%.com/library/(%d+)")
        elseif raw:match("roblox%.com/catalog/(%d+)") then
            extractedId = raw:match("roblox%.com/catalog/(%d+)")
        elseif raw:match("assetdelivery%.roblox%.com/v1/asset/%?id=(%d+)") then
            extractedId = raw:match("assetdelivery%.roblox%.com/v1/asset/%?id=(%d+)")
        end

        if extractedId then

            resolved = "rbxthumb://type=Asset&id=" .. extractedId .. "&w=768&h=432"

        elseif raw:match("^rbxthumb://") or raw:match("^rbxasset://") or raw:match("^rbxassetid://") then
            resolved = raw

        elseif (isfile and isfile(raw)) and getcustomasset then
            local success, asset = pcall(getcustomasset, raw)
            if success and asset then
                resolved = asset
            end

        elseif raw:match("^https?://") then
            local req = (syn and syn.request) or request or http_request or (http and http.request)
            if req and writefile and getcustomasset then
                local success, res = pcall(function()
                    return req({
                        Url = raw,
                        Method = "GET",
                        Headers = {
                            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
                        }
                    })
                end)
                if success and res then
                    local body = res.Body or res.body or res.Response
                    local status = res.StatusCode or res.status_code or 200
                    if status == 200 and body and #body > 0 then
                        local head = tostring(body:sub(1, 25)):lower()
                        if head:find("<!doctype") or head:find("<html") then
                            return false, "URL is a webpage, not a direct image (use Decal ID or direct image link)"
                        end
                        local cacheDir = self.ConfigDir or "Nexara Studio Config"
                        pcall(function()
                            if makefolder and isfolder and not isfolder(cacheDir) then
                                makefolder(cacheDir)
                            end
                        end)
                        local cachePath = cacheDir .. "/bg_custom.png"
                        pcall(writefile, cachePath, body)
                        local cSuccess, asset = pcall(getcustomasset, cachePath)
                        if cSuccess and asset then
                            resolved = asset
                        end
                    end
                end
            end
            if not resolved then
                return false, "Web image download failed (requires direct image URL & executor getcustomasset)"
            end
        else
            resolved = raw
        end

        if resolved then
            self.CustomBg.Image = resolved
            self.CustomBg.Visible = true
            if opacity ~= nil then
                self.CustomBg.ImageTransparency = math.clamp((100 - opacity) / 100, 0, 1)
            end
            self.ConfigValues["ThemeBgCustomImage"] = raw
            return true, resolved
        end

        return false, "Invalid image format"
    end

    local activeWeatherParticles = {}
    local weatherRunConn = nil
    local currentWeatherType = "None"

    local function ClearWeather()
        if weatherRunConn then
            weatherRunConn:Disconnect()
            weatherRunConn = nil
        end
        for _, p in ipairs(activeWeatherParticles) do
            pcall(function() p.Frame:Destroy() end)
        end
        activeWeatherParticles = {}
        currentWeatherType = "None"
    end

    function WindowObj:SetWeather(wType)
        ClearWeather()
        currentWeatherType = wType or "None"
        if currentWeatherType == "None" then return end
        if WeatherLayer then
            WeatherLayer.Visible = WindowObj.Visible
        end

        local screenW = gui.AbsoluteSize.X > 0 and gui.AbsoluteSize.X or 1920
        local screenH = gui.AbsoluteSize.Y > 0 and gui.AbsoluteSize.Y or 1080
        local maxP = 35

        local function SpawnP()
            local p = Instance.new("Frame")
            p.BorderSizePixel = 0
            p.AnchorPoint = Vector2.new(0.5, 0.5)
            local sx = math.random(0, screenW)
            local sy = -15
            local spdX = 0
            local spdY = 0
            local rotSpd = 0
            local cr = Instance.new("UICorner")

            if wType == "Snow" then
                local sz = math.random(3, 6)
                p.Size = UDim2.fromOffset(sz, sz)
                p.BackgroundColor3 = Color3.fromRGB(240, 245, 255)
                p.BackgroundTransparency = math.random(20, 50) / 100
                cr.CornerRadius = UDim.new(1, 0)
                cr.Parent = p
                spdY = math.random(40, 95)
                spdX = math.random(-15, 15)
            elseif wType == "Rain" then
                p.Size = UDim2.fromOffset(1, math.random(10, 18))
                p.BackgroundColor3 = Color3.fromRGB(180, 215, 255)
                p.BackgroundTransparency = math.random(30, 60) / 100
                spdY = math.random(360, 560)
                spdX = -20
            elseif wType == "Sakura" then
                local sz = math.random(5, 8)
                p.Size = UDim2.fromOffset(sz, math.floor(sz * 0.75))
                p.BackgroundColor3 = Color3.fromRGB(255, 183, 197)
                p.BackgroundTransparency = math.random(15, 40) / 100
                cr.CornerRadius = UDim.new(0, 3)
                cr.Parent = p
                p.Rotation = math.random(0, 360)
                spdY = math.random(50, 90)
                spdX = math.random(15, 40)
                rotSpd = math.random(-50, 50)
            elseif wType == "Leaves" then
                local sz = math.random(6, 9)
                p.Size = UDim2.fromOffset(sz, math.floor(sz * 0.8))
                local cols = {Color3.fromRGB(230, 126, 34), Color3.fromRGB(243, 156, 18), Color3.fromRGB(192, 57, 43)}
                p.BackgroundColor3 = cols[math.random(1, #cols)]
                p.BackgroundTransparency = math.random(10, 35) / 100
                cr.CornerRadius = UDim.new(0, 2)
                cr.Parent = p
                p.Rotation = math.random(0, 360)
                spdY = math.random(45, 90)
                spdX = math.random(-25, 25)
                rotSpd = math.random(-60, 60)
            end

            p.Position = UDim2.fromOffset(sx, sy)
            p.Parent = WeatherLayer
            table.insert(activeWeatherParticles, {
                Frame = p,
                X = sx,
                Y = sy,
                SpdX = spdX,
                SpdY = spdY,
                RotSpd = rotSpd
            })
        end

        for _ = 1, maxP do
            SpawnP()
            local last = activeWeatherParticles[#activeWeatherParticles]
            last.Y = math.random(0, screenH)
            last.Frame.Position = UDim2.fromOffset(last.X, last.Y)
        end

        weatherRunConn = RunService.RenderStepped:Connect(function(dt)
            if not WindowObj.Visible then return end
            screenW = gui.AbsoluteSize.X > 0 and gui.AbsoluteSize.X or 1920
            screenH = gui.AbsoluteSize.Y > 0 and gui.AbsoluteSize.Y or 1080
            for i = #activeWeatherParticles, 1, -1 do
                local pt = activeWeatherParticles[i]
                pt.Y = pt.Y + pt.SpdY * dt
                pt.X = pt.X + pt.SpdX * dt
                if pt.RotSpd ~= 0 then
                    pt.Frame.Rotation = (pt.Frame.Rotation + pt.RotSpd * dt) % 360
                end
                if pt.Y > screenH + 20 or pt.X < -20 or pt.X > screenW + 20 then
                    pt.Y = -15
                    pt.X = math.random(0, screenW)
                end
                pt.Frame.Position = UDim2.fromOffset(pt.X, pt.Y)
            end
        end)
        table.insert(self.Connections, weatherRunConn)
    end

