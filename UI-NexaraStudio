        local HexStroke = Instance.new("UIStroke")
        HexStroke.Color = Color3.fromRGB(0, 0, 0)
        HexStroke.Thickness = 1
        HexStroke.Parent = HexBox

        local curCol = initialColor
        local pickerObj = { _hovered = false, _closing = false }
        local draggingSV = false
        local draggingHue = false

        local outsideConn
        local moveConn
        local endConn
        local anchorMoveConn
        local scrollConn

        local parentScroller = anchorInstance:FindFirstAncestorWhichIsA("ScrollingFrame")
        if parentScroller then
            scrollConn = parentScroller:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
                pickerObj:Close(false)
            end)
        end

        function pickerObj:Close(animate)
            if pickerObj._closing then return end
            pickerObj._closing = true
            if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
            if moveConn then moveConn:Disconnect(); moveConn = nil end
            if endConn then endConn:Disconnect(); endConn = nil end
            if anchorMoveConn then anchorMoveConn:Disconnect(); anchorMoveConn = nil end
            if scrollConn then scrollConn:Disconnect(); scrollConn = nil end
            if Nexara.ActiveColorpicker == pickerObj then Nexara.ActiveColorpicker = nil end
            Nexara.ActiveColorpickerAnchor = nil

            if animate == false then
                PickerFrame:Destroy()
                return
            end

            local tw = TweenService:Create(uiScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.8 })
            tw:Play()
            tw.Completed:Connect(function()
                PickerFrame:Destroy()
            end)
        end

        anchorMoveConn = anchorInstance:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            pickerObj:Close(false)
        end)

        outsideConn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if draggingSV or draggingHue then return end
                local mPos = input.Position
                local pPos = PickerFrame.AbsolutePosition
                local pSize = PickerFrame.AbsoluteSize
                local anchorPos = anchorInstance.AbsolutePosition
                local anchorSize = anchorInstance.AbsoluteSize
                local inP = (mPos.X >= pPos.X and mPos.X <= pPos.X + pSize.X and mPos.Y >= pPos.Y and mPos.Y <= pPos.Y + pSize.Y)
                local inA = (mPos.X >= anchorPos.X and mPos.X <= anchorPos.X + anchorSize.X and mPos.Y >= anchorPos.Y and mPos.Y <= anchorPos.Y + anchorSize.Y)
                if inA then
                    return
                end
                if not inP then
                    pickerObj:Close()
                end
            end
        end)

        local function UpdateColor()
            curCol = Color3.fromHSV(h, s, v)
            SatValBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            PreviewBox.BackgroundColor3 = curCol
            if not HexBox:IsFocused() then
                HexBox.Text = "#" .. curCol:ToHex():upper()
            end
            HueCursor.Position = UDim2.new(0.5, 0, math.clamp(h, 0, 1), 0)
            SatValCursor.Position = UDim2.new(math.clamp(s, 0, 1), 0, math.clamp(1 - v, 0, 1), 0)
            callback(curCol)
        end

        HexBox.FocusLost:Connect(function()
            local text = HexBox.Text:gsub("#", ""):gsub("%s+", "")
            if #text == 6 then
                local success, newCol = pcall(function() return Color3.fromHex(text) end)
                if success and typeof(newCol) == "Color3" then
                    local newH, newS, newV = Color3.toHSV(newCol)
                    h = newH
                    s = newS
                    v = newV
                    UpdateColor()
                else
                    HexBox.Text = "#" .. curCol:ToHex():upper()
                end
            else
                HexBox.Text = "#" .. curCol:ToHex():upper()
            end
        end)

        SatValBox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV = true
                local px = math.clamp((input.Position.X - SatValBox.AbsolutePosition.X) / SatValBox.AbsoluteSize.X, 0, 1)
                local py = math.clamp((input.Position.Y - SatValBox.AbsolutePosition.Y) / SatValBox.AbsoluteSize.Y, 0, 1)
                s = px
                v = 1 - py
                UpdateColor()
            end
        end)

        HueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingHue = true
                local py = math.clamp((input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                h = py
                UpdateColor()
            end
        end)

        endConn = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                draggingSV = false
                draggingHue = false
            end
        end)

        moveConn = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                if draggingSV then
                    local px = math.clamp((input.Position.X - SatValBox.AbsolutePosition.X) / SatValBox.AbsoluteSize.X, 0, 1)
                    local py = math.clamp((input.Position.Y - SatValBox.AbsolutePosition.Y) / SatValBox.AbsoluteSize.Y, 0, 1)
                    s = px
                    v = 1 - py
                    UpdateColor()
                elseif draggingHue then
                    local py = math.clamp((input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                    h = py
                    UpdateColor()
                end
            end
        end)

        self.ActiveColorpicker = pickerObj
        self.ActiveColorpickerAnchor = anchorInstance
        return pickerObj
    end

