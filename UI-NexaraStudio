local function GetSafeParent()
    local target = nil
    if gethui then
        local success, result = pcall(gethui)
        if success and result then
            if result:IsA("ScreenGui") then
                target = result.Parent or CoreGui
            else
                target = result
            end
        end
    end
    if not target then
        pcall(function() target = CoreGui end)
    end
    if not target and LocalPlayer then
        target = LocalPlayer:FindFirstChild("PlayerGui")
    end
    return target or CoreGui
end

