                if not isfolder(configDir .. "/Themes") then makefolder(configDir .. "/Themes") end
            end
        end)

        local function GetAutoloadFile()
            local mode = self.ConfigValues["AutoloadMode"] or "All accounts"
            if mode == "This account only" and LocalPlayer then
                return configDir .. "/_autoload_" .. tostring(LocalPlayer.UserId) .. ".txt"
            end
            return configDir .. "/_autoload.txt"
        end

        pcall(function()
            local alPath = GetAutoloadFile()
            if isfile and isfile(alPath) then
                local al = readfile(alPath):gsub("%s+", "")
                if al ~= "" then
                    autoloadProfile = al
                    currentConfig = al
                end
            end
            local earlyTarget = autoloadProfile
            if not earlyTarget or earlyTarget == "none" or earlyTarget == "" then earlyTarget = "Default" end
            local earlyFile = configDir .. "/" .. earlyTarget .. ".json"
            if isfile and isfile(earlyFile) then
                local raw = readfile(earlyFile)
                local dec = HttpService:JSONDecode(raw)
                if dec and dec["MinimizeUIOnStart"] == true then
                    self:SetVisible(false, true)
                end
            end
        end)

        local function GetConfigList()
            local list = {"Default"}
            pcall(function()
                if listfiles and isfolder and isfolder(configDir) then
                    for _, path in ipairs(listfiles(configDir)) do
                        local name = path:match("([^/\\]+)%.json$")
                        if name and not table.find(list, name) then
                            table.insert(list, name)
                        end
                    end
                end
            end)
            return list
        end

        local function GetThemeList()
            local list = {"no themes"}
            pcall(function()
                local tDir = configDir .. "/Themes"
                if listfiles and isfolder and isfolder(tDir) then
                    local files = {}
                    for _, path in ipairs(listfiles(tDir)) do
                        local name = path:match("([^/\\]+)%.json$")
                        if name then table.insert(files, name) end
                    end
                    if #files > 0 then list = files end
                end
            end)
            return list
        end

        local function SaveConfigData(name, silent)
            pcall(function()
                name = name or currentConfig or "Default"
                local filePath = configDir .. "/" .. name .. ".json"
                local data = {}
                for k, v in pairs(self.ConfigValues) do
                    data[k] = v
                end
                data["_ToggleKey"] = self.ToggleKey.Name
                data["_AccentR"] = math.floor(self.Theme.Accent.R * 255)
                data["_AccentG"] = math.floor(self.Theme.Accent.G * 255)
                data["_AccentB"] = math.floor(self.Theme.Accent.B * 255)

                local encoded = HttpService:JSONEncode(data)
                if writefile then
                    writefile(filePath, encoded)
                end
                if not silent then
                    self.Library:Notify({ Title = "Configs", Content = "Saved config: " .. name, Duration = 2 })
                end
            end)
        end

        local function LoadConfigData(name, silent)
            pcall(function()
                name = name or currentConfig or "Default"
                local filePath = configDir .. "/" .. name .. ".json"
                if readfile and isfile and isfile(filePath) then
                    local content = readfile(filePath)
                    local success, decoded = pcall(function() return HttpService:JSONDecode(content) end)
                    if success and decoded then
                        for flag, val in pairs(decoded) do
                            local item = self.ConfigFlags[flag]
                            if item and item.Set then
                                pcall(function() item:Set(val, true) end)
                            end
                            self.ConfigValues[flag] = val
                        end
                        if decoded["_ToggleKey"] then
                            local kEnum = Enum.KeyCode[decoded["_ToggleKey"]]
                            if kEnum then
                                self.ToggleKey = kEnum
                                local bindItem = self.ConfigFlags["MenuToggleKey"]
                                if bindItem and bindItem.Set then bindItem:Set(kEnum, true) end
                            end
                        end
                        if decoded["_AccentR"] and decoded["_AccentG"] and decoded["_AccentB"] then
                            local acc = Color3.fromRGB(decoded["_AccentR"], decoded["_AccentG"], decoded["_AccentB"])
                            self:SetAccent(acc)
                        end
                        if decoded["ThemeBackgroundType"] == "Custom Image" then
                            local bgImg = decoded["ThemeBgCustomImage"]
                            if not bgImg or bgImg == "" then bgImg = "91856257706497" end
                            self:ApplyCustomBackground(bgImg, decoded["ThemeBgOpacity"] or 65)
                        elseif decoded["ThemeBackgroundType"] == "None" or decoded["ThemeBackgroundType"] == "Blur" then
                            if self.CustomBg then self.CustomBg.Visible = false end
                        end
                        if not silent then
                            self.Library:Notify({ Title = "Configs", Content = "Loaded config: " .. name, Duration = 2 })
                        end
                    end
                end
            end)
        end

