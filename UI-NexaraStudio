                    local function UpdateSlider(inputX, silent)
                        local trackAbsPos = Track.AbsolutePosition.X
                        local trackAbsWidth = Track.AbsoluteSize.X
                        local pct = math.clamp((inputX - trackAbsPos) / trackAbsWidth, 0, 1)
                        local rawVal = sMin + (sMax - sMin) * pct
                        local step = 10 ^ sDecimals
                        local rounded = math.floor(rawVal * step + 0.5) / step
                        currentValue = rounded

                        Fill.Size = UDim2.new(pct, 0, 1, 0)
                        Thumb.Position = UDim2.new(pct, 0, 0.5, 0)
                        ValLabel.Text = string.format("%." .. tostring(sDecimals) .. "f%s", currentValue, sSuffix)
                        WindowObj.ConfigValues[sFlag] = currentValue
                        if not silent then
                            sCallback(currentValue)
                            if WindowObj.OnSilentAutoSave then WindowObj.OnSilentAutoSave() end
                        end
                    end

                    Track.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            UpdateSlider(input.Position.X)
                        end
                    end)

                    local endConn = UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = false
                        end
                    end)
                    table.insert(WindowObj.Library.Connections, endConn)

                    local moveConn = UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                            UpdateSlider(input.Position.X)
                        end
                    end)
                    table.insert(WindowObj.Library.Connections, moveConn)

                    local SliderItem = { Value = currentValue, Flag = sFlag }
                    function SliderItem:Set(val, silent)
                        local clamped = math.clamp(val, sMin, sMax)
                        local pct = (clamped - sMin) / (sMax - sMin)
                        currentValue = clamped
                        Fill.Size = UDim2.new(pct, 0, 1, 0)
                        Thumb.Position = UDim2.new(pct, 0, 0.5, 0)
                        ValLabel.Text = string.format("%." .. tostring(sDecimals) .. "f%s", currentValue, sSuffix)
                        WindowObj.ConfigValues[sFlag] = currentValue
                        if not silent then
                            sCallback(currentValue)
                            if WindowObj.OnSilentAutoSave then WindowObj.OnSilentAutoSave() end
                        end
                    end

                    WindowObj.ConfigFlags[sFlag] = SliderItem
                    WindowObj.ConfigValues[sFlag] = sDefault
                    return SliderItem
                end

