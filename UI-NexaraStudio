                    local filePath = configDir .. "/" .. currentConfig .. ".json"
                    if delfile and isfile and isfile(filePath) then
                        delfile(filePath)
                    end
                end)
                self.Library:Notify({ Title = "Config", Content = "Deleted profile: " .. currentConfig, Duration = 2 })
                currentConfig = "Default"
                activeProfileName = "Default"
                configDropdown:Refresh(GetConfigList())
                configDropdown:Set("Default")
                UpdateProfileStatus()
            end
        })

        SecConfig:AddButtonRow({
            Name = "Set autoload",
            Callback = function()
                autoloadProfileName = currentConfig
                pcall(function()
                    if writefile then writefile(GetAutoloadFile(), currentConfig) end
                end)
                UpdateProfileStatus()
                self.Library:Notify({ Title = "Config", Content = "Autoload set to: " .. currentConfig, Duration = 2 })
            end
        }, {
            Name = "Clear autoload",
            Callback = function()
                autoloadProfileName = "none"
                pcall(function()
                    local alPath = GetAutoloadFile()
                    if delfile and isfile and isfile(alPath) then
                        delfile(alPath)
                    elseif writefile then
                        writefile(alPath, "none")
                    end
                end)
                UpdateProfileStatus()
                self.Library:Notify({ Title = "Config", Content = "Autoload profile cleared", Duration = 2 })
            end
        })

        statusLabel = SecConfig:AddLabel("loaded: " .. activeProfileName .. " | autoload: " .. autoloadProfileName, { Height = 18 })

        SecConfig:AddDropdown({
            Name = "Autoload mode",
            Options = {"All accounts", "This account only"},
            Default = "All accounts",
            Flag = "AutoloadMode",
            Callback = function(val)
                pcall(function()
                    local alPath = GetAutoloadFile()
                    if isfile and isfile(alPath) then
                        local al = readfile(alPath):gsub("%s+", "")
                        if al ~= "" then
                            autoloadProfileName = al
                            UpdateProfileStatus()
                        end
                    end
                end)
            end
        })

        SecConfig:AddButton({
            Name = "Refresh list",
            Callback = function()
                local list = GetConfigList()
                configDropdown:Refresh(list)
                UpdateProfileStatus()
                self.Library:Notify({ Title = "Config", Content = "Refreshed list (" .. tostring(#list) .. ")", Duration = 2 })
            end
        })

        task.defer(function()
            local target = autoloadProfile
            if not target or target == "none" or target == "" then target = "Default" end
            if isfile and isfile(configDir .. "/" .. target .. ".json") then
                LoadConfigData(target, true)
                currentConfig = target
                activeProfileName = target
                UpdateProfileStatus()
            end
            pcall(function()
                local defFile = configDir .. "/Themes/_default.txt"
                if isfile and isfile(defFile) then
                    local dt = readfile(defFile):gsub("%s+", "")
                    if dt ~= "" and isfile(configDir .. "/Themes/" .. dt .. ".json") then
                        local data = HttpService:JSONDecode(readfile(configDir .. "/Themes/" .. dt .. ".json"))
                        if data.Accent then self:SetAccent(Color3.fromRGB(data.Accent[1], data.Accent[2], data.Accent[3])) end
                    end
                end
            end)
            if self.ConfigValues["MinimizeUIOnStart"] == true then
                self:SetVisible(false, true)
            end
        end)

        isSettingsInit = false
        return {
            Tab = SettingsTab,
            Col1 = SetCol1,
            Col2 = SetCol2
        }
    end

    table.insert(self.Windows, WindowObj)
    return WindowObj
end

