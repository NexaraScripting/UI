    local mk = tostring(killerChar:GetAttribute("MorphedKiller") or ""):lower()
    if mk:find("abyss") then return true end
    if killerChar:FindFirstChild("Abysswalker") or killerChar:FindFirstChild("Wave") then return true end
    if killerChar:GetAttribute("corrupt") ~= nil or killerChar:GetAttribute("prepcorrupt") ~= nil or killerChar:GetAttribute("AbysswalkerSlashViewmodelLevel") ~= nil then return true end
    local kp = Players:GetPlayerFromCharacter(killerChar)
    if kp then
        local pmk = tostring(kp:GetAttribute("MorphedKiller") or ""):lower()
        if pmk:find("abyss") then return true end
        if kp:GetAttribute("corrupt") ~= nil or kp:GetAttribute("prepcorrupt") ~= nil then return true end
    end
    return false
end
function AutoParry.IsDarkSeveranceActive(killerChar)
    if not killerChar then return false end
    local hum = killerChar:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if anim then
        local tracks = anim:GetPlayingAnimationTracks()
        for i = 1, #tracks do
            local tr = tracks[i]
            if tr.IsPlaying and tr.Animation then
                local meta = GetTrackMeta(tr)
                local aid = meta.aid
                if aid == "100014992013740" or aid == "80411309607666" then
                    return true
                end
                local anm = meta.anm
                local tnm = meta.tnm
                if anm:find("severance") or tnm:find("severance") or anm:find("slashvm") or tnm:find("slashvm") then
                    return true
                end
                if AutoParry.IsAbysswalker(killerChar) and (anm == "slash" or tnm == "slash") then
                    return true
                end
            end
        end
    end
    return false
end
function AutoParry.IsShadowLeapActive(killerChar)
