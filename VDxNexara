        if #clean < 3 or IgnoredAttributes[clean] then return nil end
        if StatusToPerkMap[clean] then return StatusToPerkMap[clean] end
        if targetNorm and targetNorm[clean] then return targetNorm[clean] end
        if otherNorm and otherNorm[clean] then return otherNorm[clean] end
        if targetNorm then
            for k, v in pairs(targetNorm) do
                if clean == k or (clean:find(k, 1, true) and #k >= 6) or (#clean >= 6 and k:find(clean, 1, true)) then
                    return v
                end
            end
        end
        if otherNorm then
            for k, v in pairs(otherNorm) do
                if clean == k or (clean:find(k, 1, true) and #k >= 6) or (#clean >= 6 and k:find(clean, 1, true)) then
                    return v
