    if aName:find("frenzyend") or tName:find("frenzyend") or aName:find("frenzy_end") or tName:find("frenzy_end")
       or aName:find("fatigue") or tName:find("fatigue") or aName:find("exhaust") or tName:find("exhaust")
       or aName:find("stun") or tName:find("stun") or aName:find("wallhit") or tName:find("wallhit")
       or aName:find("hurt") or tName:find("hurt") or aName:find("pain") or tName:find("pain")
       or aName:find("groan") or tName:find("groan") or aName:find("tantrum") or tName:find("tantrum")
       or aName:find("cancel") or tName:find("cancel") or aName:find("parried") or tName:find("parried")
       or aName:find("corrupt") or tName:find("corrupt")
       or aName:find("wipe") or tName:find("wipe") or aName:find("break") or aName:find("kick")
       or aName:find("vault") or tName:find("vault") or aName:find("climb") or aName:find("fall")
       or aName:find("pickup") or aName:find("carry") or aName:find("slide") or tName:find("slide") then
