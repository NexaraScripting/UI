            origClearCd(selfClient, ...)
            if ap and ap.UpdateCircle then
                ap.LastCircleUpdateClock = nil
                ap.UpdateCircle()
            end
        end
    end
    client._nexaraHookedLowHealth = true
    client._isLowHealth = function(selfClient)
        return false
    end
    client._nexaraHookedFaceLook = true
    client._faceLookDirection = function(selfClient, ...)
