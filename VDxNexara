        AutoParry.CircleTween = nil
    end
    AutoParry.CircleIsCollapsed = true
    local TweenService = game:GetService("TweenService")
    local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(ad, ti, {
        Radius = 0.01,
        InnerRadius = 0,
        Transparency = 1
    })
    AutoParry.CircleTween = tween
    tween.Completed:Connect(function()
        if AutoParry.CircleTween == tween then
            AutoParry.CircleTween = nil
            if AutoParry.CircleIsCollapsed and ad and ad.Parent then
                ad.Visible = false
                ad.Radius = 0.01
                ad.InnerRadius = 0
                ad.Transparency = 1
            end
        end
    end)
