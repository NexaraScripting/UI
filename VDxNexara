    function TofCombat.StepHitmarker(dt)
        local lines = TofCombat.HitmarkerLines
        if not lines or #lines == 0 then return end
        if TofCombat.HitmarkerAlpha and TofCombat.HitmarkerAlpha > 0.01 then
            local stepDt = (type(dt) == "number" and dt) or 0.016
            TofCombat.HitmarkerAlpha = math.max(0, TofCombat.HitmarkerAlpha - (stepDt * 3.8))
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local vp = cam.ViewportSize
            local cx, cy = vp.X * 0.5, vp.Y * 0.5;
            local isModeOnKiller = (Config.HitmarkerMode ~= "Screen Center")
            if isModeOnKiller then
                local targetWorld = nil
                local tp = TofCombat.HitmarkerTargetPart
                if tp and tp.Parent then
                    targetWorld = tp.Position
                elseif typeof(TofCombat.HitmarkerWorldPos) == "Vector3" then
                    targetWorld = TofCombat.HitmarkerWorldPos
                end
                if targetWorld then
                    local sPos, onScreen = cam:WorldToViewportPoint(targetWorld)
                    if onScreen and sPos.Z > 0 then
                        cx, cy = sPos.X, sPos.Y
                    else
                        for _, l in ipairs(lines) do
                            if l.Visible then l.Visible = false end
                        end
                        return
                    end
                end
            end
            local gap = 4.5
            local len = 11.5
            local col = TofCombat.HitmarkerIsCrit and Color3.fromRGB(255, 65, 65) or (Config.Color_Hitmarker or Color3.fromRGB(255, 255, 255))
            local a = TofCombat.HitmarkerAlpha
            lines[1].From = Vector2.new(cx - gap, cy - gap)
            lines[1].To = Vector2.new(cx - len, cy - len)
            lines[2].From = Vector2.new(cx + gap, cy - gap)
            lines[2].To = Vector2.new(cx + len, cy - len)
            lines[3].From = Vector2.new(cx - gap, cy + gap)
            lines[3].To = Vector2.new(cx - len, cy + len)
            lines[4].From = Vector2.new(cx + gap, cy + gap)
            lines[4].To = Vector2.new(cx + len, cy + len)
            for _, l in ipairs(lines) do
                l.Color = col
                l.Transparency = a
                if not l.Visible then l.Visible = true end
            end
        else
            TofCombat.HitmarkerWorldPos = nil
            TofCombat.HitmarkerTargetPart = nil
            for _, l in ipairs(lines) do
                if l.Visible then l.Visible = false end
            end
        end
    end
    function TofCombat.GetGunCooldown()
        local char = LocalPlayer.Character
        local tof = char and char:FindFirstChild("Twist of Fate")
        if not tof then
            local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
            tof = bp and bp:FindFirstChild("Twist of Fate")
        end
        if not tof then return false, 0, 0 end
        local state = tof:GetAttribute("tofState")
        local dur = tonumber(tof:GetAttribute("tofStateDur")) or 70
        local start = tonumber(tof:GetAttribute("tofStateStart")) or 0
        local rawShots = tof:GetAttribute("shots")
        local shots = (rawShots == nil) and 1 or (tonumber(rawShots) or 0)
        if tof:GetAttribute("tofHalf") == true then
            shots = shots + 0.5
        end
        if state == "cooldown" then
            local now = workspace:GetServerTimeNow()
            local remaining = math.max(0, math.ceil(dur - (now - start)))
            if remaining > 0 then
                return true, remaining, shots
            end
        end
        return false, 0, shots
    end
    function TofCombat.UpdateTargetVelocities()
        local now = os.clock()
        local validPlrs = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                validPlrs[p] = true
                local char = p.Character
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
                if root and root:IsA("BasePart") then
                    local pos = root.Position
                    local record = TofCombat.TargetVelocities[p]
                    if not record then
                        TofCombat.TargetVelocities[p] = {
                            lastPos = pos,
                            lastTime = now,
                            smoothVel = Vector3.zero,
                            fastVel = Vector3.zero,
                            accel = Vector3.zero,
                            dirStability = 1.0,
                        }
                    else
                        local elapsed = now - record.lastTime
                        if elapsed >= 0.012 then
                            local instVel = (pos - record.lastPos) / elapsed
                            if instVel.Magnitude < 90 then
                                local prevFast = record.fastVel or record.smoothVel or Vector3.zero
                                local rawAccel = (instVel - prevFast) / math.max(elapsed, 0.016)
                                if rawAccel.Magnitude < 250 then
                                    record.accel = (record.accel or Vector3.zero):Lerp(rawAccel, 0.35)
                                else
                                    record.accel = Vector3.zero
                                end
                                local hInst = Vector3.new(instVel.X, 0, instVel.Z)
                                local hPrev = Vector3.new(prevFast.X, 0, prevFast.Z)
                                if hInst.Magnitude < 0.5 then
                                    record.fastVel = instVel
                                    record.smoothVel = record.smoothVel * 0.35
                                    record.dirStability = math.min(1.0, (record.dirStability or 1.0) + elapsed * 3.0)
                                else
                                    local dot = (hPrev.Magnitude > 1.0) and hInst.Unit:Dot(hPrev.Unit) or 1.0
                                    if dot < 0.25 then
                                        record.fastVel = instVel
                                        record.smoothVel = record.smoothVel:Lerp(instVel, 0.85)
                                        record.dirStability = math.max(0.50, (record.dirStability or 1.0) * 0.60)
                                    else
                                        record.fastVel = prevFast:Lerp(instVel, 0.78)
                                        record.smoothVel = record.smoothVel:Lerp(instVel, 0.58)
                                        record.dirStability = math.min(1.0, (record.dirStability or 1.0) + elapsed * 2.5)
                                    end
                                end
                            else
                                record.smoothVel = Vector3.zero
                                record.fastVel = Vector3.zero
                                record.accel = Vector3.zero
                            end
                            record.lastPos = pos
                            record.lastTime = now
                        end
                    end
                else
                    TofCombat.TargetVelocities[p] = nil
                end
            end
        end
        for p in pairs(TofCombat.TargetVelocities) do
            if not validPlrs[p] then
                TofCombat.TargetVelocities[p] = nil
            end
        end
    end
    function TofCombat.GetPlayerVelocity(p, char)
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local snap = (AutoParry and AutoParry.GetKillerServerState and char and root) and AutoParry.GetKillerServerState(char, root) or nil
        local snapVel = (snap and snap.vel and (tick() - (snap.time or 0)) <= 0.24 and snap.vel.Magnitude < 90) and snap.vel or nil
        local record = p and TofCombat.TargetVelocities[p]
        local recFresh = record and ((os.clock() - (record.lastTime or 0)) <= 0.22)
        local measVel = recFresh and ((record.fastVel or record.smoothVel or Vector3.zero) * 0.65 + (record.smoothVel or Vector3.zero) * 0.35) or nil
        local stability = (recFresh and record.dirStability) or 1.0
        local asmVel = (root and root:IsA("BasePart") and root.AssemblyLinearVelocity) or Vector3.zero
        if asmVel.Magnitude >= 90 then asmVel = Vector3.zero end

        local vel = Vector3.zero
        if snapVel and snapVel.Magnitude > 0.4 and measVel and measVel.Magnitude > 0.4 then
            vel = (snapVel * 0.72) + (measVel * 0.28)
        elseif snapVel and snapVel.Magnitude > 0.4 then
            vel = snapVel
        elseif measVel and measVel.Magnitude > 0.4 then
            vel = measVel
        elseif asmVel.Magnitude > 0.4 then
            vel = asmVel
        end

        local moveDir = hum and hum.MoveDirection
        if moveDir and moveDir.Magnitude > 0.05 then
            local baseSpd = tonumber(char:GetAttribute("Speed")) or 18.7
            local boost = tonumber(char:GetAttribute("speedboost")) or 1
            local swift = tonumber(char:GetAttribute("swift")) or 1
            local bl = tonumber(char:GetAttribute("BloodLust")) or 0
            local expectedSpeed = math.max((hum and hum.WalkSpeed) or 0, (baseSpd * boost * swift) + (bl * 0.8))
            local hVel = Vector3.new(vel.X, 0, vel.Z)
            if hVel.Magnitude > 1.2 then
                local mUnit = Vector3.new(moveDir.X, 0, moveDir.Z)
                if mUnit.Magnitude > 0.05 then
                    mUnit = mUnit.Unit
                    local dot = hVel.Unit:Dot(mUnit)
                    if dot < 0.35 then
                        stability = math.min(stability, 0.65)
                        local blendedDir = (hVel.Unit * 0.65 + mUnit * 0.35)
                        if blendedDir.Magnitude > 0.05 then
                            local spd = hVel.Magnitude
                            vel = Vector3.new(blendedDir.Unit.X * spd, vel.Y, blendedDir.Unit.Z * spd)
                        end
                    else
                        local blendedDir = (hVel.Unit * 0.82 + mUnit * 0.18)
                        if blendedDir.Magnitude > 0.05 then
                            local spd = hVel.Magnitude
                            vel = Vector3.new(blendedDir.Unit.X * spd, vel.Y, blendedDir.Unit.Z * spd)
                        end
                    end
                end
            elseif not recFresh and (not snapVel or snapVel.Magnitude <= 0.4) and asmVel.Magnitude > 0.5 then
                vel = moveDir.Unit * expectedSpeed
            end
        end
        return vel, stability
    end
    function TofCombat.BuildTargetOptions()
        local opts = { "Auto (Killer)" }
        local killerOpts = {}
        local otherOpts = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local isK = IsKiller(p)
                if isK then
                    local char = p.Character
                    local kName = p:GetAttribute("SelectedKiller") or (char and char:GetAttribute("SelectedKiller")) or "Killer"
                    if char then
                        if char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2") or char:GetAttribute("spearmode") then
                            kName = "Veil"
                        elseif char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") or char:GetAttribute("corpsecharge") then
                            kName = "Cure"
                        elseif char:GetAttribute("StalkerStage2Remaining") ~= nil or char:GetAttribute("Stage") ~= nil or char:GetAttribute("StalkStage") ~= nil or char:FindFirstChild("Chainsaw") or char:FindFirstChild("Stalker") then
                            kName = "Stalker"
                        elseif char:FindFirstChild("Knide") or char:FindFirstChild("Knife") or char:GetAttribute("preparem2") then
                            kName = "Hidden"
                        elseif char:FindFirstChild("Katana") or char:FindFirstChild("Sword") or char:FindFirstChild("pamela") or char:GetAttribute("Pursuit") ~= nil or char:GetAttribute("LakeMist") ~= nil then
                            kName = "Slasher"
                        elseif char:FindFirstChild("Abysswalker") or char:GetAttribute("corrupt") ~= nil then
                            kName = "Abysswalker"
                        elseif char:FindFirstChild("Mask") or char:GetAttribute("Mask") ~= nil then
                            kName = "Masked"
                        elseif char:FindFirstChild("Beartrap") or char:FindFirstChild("BearTrap") or char:GetAttribute("Butcher") == true or char:GetAttribute("MorphedKiller") == "Butcher" or char:GetAttribute("PlacingTrap") ~= nil or char:GetAttribute("ChainLatched") ~= nil or char:GetAttribute("ChainThrowUntil") ~= nil or kName == "Butcher" then
                            kName = "Butcher"
                        end
                    end
                    table.insert(killerOpts, string.format("%s [Killer - %s]", p.Name, tostring(kName)))
                else
                    table.insert(otherOpts, p.Name)
                end
            end
        end
        table.sort(killerOpts)
        table.sort(otherOpts)
        for _, v in ipairs(killerOpts) do table.insert(opts, v) end
        for _, v in ipairs(otherOpts) do table.insert(opts, v) end
        return opts
    end
