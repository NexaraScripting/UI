                    AutoParry.LastDamagedTick = tick()
                    AutoParry.MarkActiveKillerTracksResolved()
                end
                AutoParry.LastCircleUpdateClock = nil
                if AutoParry.UpdateCircle then AutoParry.UpdateCircle() end
            end)
