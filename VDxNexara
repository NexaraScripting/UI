                        AutoParry.LastDamagedTick = tick()
                        AutoParry.MarkActiveKillerTracksResolved()
                    elseif attr == "isVaulting" or attr == "IsVaulting" or attr == "Vaulting" or attr == "isSliding" or attr == "IsSliding" then
                        AutoParry.LastLocalVaultTick = tick()
                        AutoParry.MarkActiveKillerTracksResolved()
                    end
                elseif attr == "isVaulting" or attr == "IsVaulting" or attr == "Vaulting" or attr == "isSliding" or attr == "IsSliding" then
                    AutoParry.LastLocalVaultTick = tick()
                    AutoParry.MarkActiveKillerTracksResolved()
                end
            end)
            table.insert(ScriptConnections, cAttr)
            task.spawn(function()
                local ci = char:WaitForChild("CheckInterractable", 5)
                if ci then
                    local cCi = ci.AttributeChanged:Connect(function(attr)
                        if attr == "isVaulting" or attr == "IsVaulting" or attr == "isSliding" or attr == "IsSliding" or attr == "isDroppingPallet" then
                            AutoParry.LastLocalVaultTick = tick()
