function AutoParry.SyncLookToKillerNow(myChar, myHrp, kHrp)
    if not myChar or not myHrp or not kHrp then return end
    local kChar = kHrp.Parent
    local snap = AutoParry.GetKillerServerState(kChar, kHrp)
    local targetPos = (snap and snap.pos) or kHrp.Position
    local diff = Vector3.new(targetPos.X - myHrp.Position.X, 0, targetPos.Z - myHrp.Position.Z)
    if diff.Magnitude <= 0.001 then return end
    local unitDir = diff.Unit
    myHrp.CFrame = CFrame.new(myHrp.Position, myHrp.Position + unitDir)

    pcall(function()
        local netPack, pushRem = AutoParry.GetNetPackAndPushRemote()
        if netPack and pushRem then
            local yaw = netPack.lookToYaw(unitDir)
            local packet = netPack.encodePush(workspace:GetServerTimeNow(), myHrp.Position, yaw)
            pushRem:FireServer(packet)
        end
    end)
    pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        local gameRem = rem and rem:FindFirstChild("Game")
        local updateLook = gameRem and gameRem:FindFirstChild("UpdateCharacterLook")
        local torso = myChar:FindFirstChild("Torso")
        if updateLook and torso then
            local neck = torso:FindFirstChild("Neck")
            local rootJoint = myHrp:FindFirstChild("RootJoint")
            local rHip = torso:FindFirstChild("Right Hip")
            local lHip = torso:FindFirstChild("Left Hip")
            local rShoulder = torso:FindFirstChild("Right Shoulder")
            if neck and rootJoint and rHip and lHip and rShoulder then
                local c0Neck = neck:GetAttribute("PortraitNeutralC0") or neck.C0
                local c0Root = rootJoint:GetAttribute("PortraitNeutralC0") or rootJoint.C0
                local c0RHip = rHip:GetAttribute("PortraitNeutralC0") or rHip.C0
                local c0LHip = lHip:GetAttribute("PortraitNeutralC0") or lHip.C0
                local c0RSh = rShoulder:GetAttribute("PortraitNeutralC0") or rShoulder.C0
                updateLook:FireServer(c0Neck, c0Root, c0RHip, c0LHip, c0RSh, unitDir, nil, false)
            end
        end
    end)
end
function AutoParry.FaceKillerAndSyncServer(killerChar)
    if not killerChar or not killerChar.Parent then return end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local kHrp = killerChar:FindFirstChild("HumanoidRootPart")
    if not myHrp or not kHrp then return end
    local client = AutoParry.GetNativeClient()
    if client then
        client.faceToken = (client.faceToken or 0) + 1
        if client.faceTween then
            pcall(function() client.faceTween:Cancel() end)
        end
    end
    AutoParry.CurrentTargetKiller = killerChar
    AutoParry.IsFaceLockActive = true
    AutoParry.FaceLockUntil = tick() + 0.55
    pcall(function() myChar:SetAttribute("overridelookscript", true) end)
    local hum = myChar:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = false
    end
    if _G.Nexara_VD_SetNamecallActive then
        pcall(_G.Nexara_VD_SetNamecallActive, true)
    end
    AutoParry.SyncLookToKillerNow(myChar, myHrp, kHrp)
    if AutoParry.FaceRenderConn then
        pcall(function() AutoParry.FaceRenderConn:Disconnect() end)
        AutoParry.FaceRenderConn = nil
    end
    if AutoParry.FaceHeartbeatConn then
        pcall(function() AutoParry.FaceHeartbeatConn:Disconnect() end)
        AutoParry.FaceHeartbeatConn = nil
    end
    if AutoParry.FacePostSimConn then
        pcall(function() AutoParry.FacePostSimConn:Disconnect() end)
        AutoParry.FacePostSimConn = nil
    end
    local lastNetSync = tick()
    local function stepFaceSync()
        if not ScriptRunning or tick() >= (AutoParry.FaceLockUntil or 0) then
            AutoParry.StopKillerFaceLock()
            return
        end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        local kc = AutoParry.CurrentTargetKiller
        local kh = kc and kc.Parent and kc:FindFirstChild("HumanoidRootPart")
        local isDeadOrDown = not c or not c.Parent or c:GetAttribute("Knocked") == true or c:GetAttribute("IsHooked") == true or c:GetAttribute("IsCarried") == true or c:GetAttribute("IsDead") == true
        if not h or not kh or isDeadOrDown then
            AutoParry.StopKillerFaceLock()
            return
        end
        if c:GetAttribute("overridelookscript") ~= true then
            pcall(function() c:SetAttribute("overridelookscript", true) end)
        end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if hum and hum.AutoRotate then
            hum.AutoRotate = false
        end
        local snap = AutoParry.GetKillerServerState(kc, kh)
        local targetPos = (snap and snap.pos) or kh.Position
        local d = Vector3.new(targetPos.X - h.Position.X, 0, targetPos.Z - h.Position.Z)
        if d.Magnitude > 0.001 then
            local u = d.Unit
            h.CFrame = CFrame.new(h.Position, h.Position + u)

            local nowT = tick()
            if (nowT - lastNetSync) >= 0.025 then
                lastNetSync = nowT
                AutoParry.SyncLookToKillerNow(c, h, kh)
            end
        end
    end
    AutoParry.FaceRenderConn = RunService.RenderStepped:Connect(stepFaceSync)
    AutoParry.FaceHeartbeatConn = (RunService.PreSimulation or RunService.Heartbeat):Connect(stepFaceSync)
    if RunService.PostSimulation then
        AutoParry.FacePostSimConn = RunService.PostSimulation:Connect(stepFaceSync)
    end
    task.delay(0.55, function()
        AutoParry.StopKillerFaceLock()
        AutoParry.ReleaseParryMovementLock(client)
    end)
end
