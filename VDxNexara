    function TofCombat.HasClearShot(origin, targetChar, targetPos)
        local delta = targetPos - origin
        if delta.Magnitude < 0.5 then return true end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        local filter = { LocalPlayer.Character, targetChar, Workspace.CurrentCamera }
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character ~= targetChar and not IsKiller(p) then
                table.insert(filter, p.Character)
            end
        end
        rp.FilterDescendantsInstances = filter
        local hit = Workspace:Raycast(origin, delta, rp)
        if hit and hit.Instance and hit.Instance.CanCollide and hit.Instance.Transparency <= 0.01 and hit.Distance < (delta.Magnitude - 1.2) then
            return false
        end
        return true
    end
    function TofCombat.GetTarget(maxFov, isSilentAim)
        local cam = Workspace.CurrentCamera
        if not cam then return nil, nil end
        local vp = cam.ViewportSize
        local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
        local ignoreFov = (isSilentAim == true) or (Config.Tof_SilentAim == true and maxFov == nil)
        local fovLimit = ignoreFov and math.huge or (maxFov or Config.Tof_FOV or 220)
        local bestTarget, bestPart = nil, nil
        local bestScore = math.huge
        local shootOrigin = TofCombat.GetShootOrigin and TofCombat.GetShootOrigin() or cam.CFrame.Position
        local mode = Config.Tof_TargetMode or "Auto (Killer)"
        if mode ~= "Auto (Killer)" then
            local targetName = mode:match("^([^%s%[]+)")
            if targetName then
                local sp = Players:FindFirstChild(targetName)
                if sp and sp ~= LocalPlayer and sp.Character and not IsPlayerDead(sp) then
                    local part = TofCombat.GetPreferredBasePart(sp.Character)
                    if part then
                        if ignoreFov then
                            return sp, part
                        end
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= fovLimit then
                                return sp, part
                            end
                        end
                    end
                end
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                if IsKiller(p) or (AutoParry and AutoParry.IsKillerChar and AutoParry.IsKillerChar(p.Character)) then
                    local part = TofCombat.GetPreferredBasePart(p.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                        if ignoreFov then
                            local dist3d = (part.Position - shootOrigin).Magnitude
                            if dist3d <= 950 then
                                local hasLos = TofCombat.HasClearShot(shootOrigin, p.Character, part.Position)
                                local score = (sPos.Z > 0 and d2d or (2000 + dist3d)) + (hasLos and 0 or 5000)
                                if score < bestScore then
                                    bestScore = score
                                    bestTarget = p
                                    bestPart = part
                                end
                            end
                        elseif onScreen and sPos.Z > 0 and d2d <= fovLimit then
                            if d2d < bestScore then
                                bestScore = d2d
                                bestTarget = p
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
        if bestTarget and bestPart then
            return bestTarget, bestPart
        end
        bestScore = fovLimit
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                local isCandidate = false
                if IsInLobby() then
                    isCandidate = true
                elseif p.Team and LocalPlayer.Team and p.Team ~= LocalPlayer.Team then
                    isCandidate = true
                elseif not p.Team or p.Team.Name ~= "Survivors" then
                    isCandidate = true
                end
                if isCandidate then
                    local part = TofCombat.GetPreferredBasePart(p.Character)
                    if part then
                        local sPos, onScreen = cam:WorldToViewportPoint(part.Position)
                        if (onScreen or ignoreFov) and sPos.Z > 0 then
                            local d2d = (Vector2.new(sPos.X, sPos.Y) - screenCenter).Magnitude
                            if d2d <= bestScore then
                                bestScore = d2d
                                bestTarget = p
                                bestPart = part
                            end
                        end
                    end
                end
            end
        end
        return bestTarget, bestPart
    end
    TofCombat.ServerOriginLocalOffset = Vector3.new(0.7, 1.373, -2.5)
    TofCombat.BulletSpeed = 800
    function TofCombat.GetOptimalHitPosition(tChar, fallbackPart, shootOrigin)
        if not tChar then return fallbackPart and fallbackPart.Position or shootOrigin end
        local hrp = tChar:FindFirstChild("HumanoidRootPart")
        local torso = tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso") or hrp or fallbackPart
        if not torso then return fallbackPart and fallbackPart.Position or shootOrigin end
        local isInvisibleChar = (torso.Transparency > 0.01) or (tChar:GetAttribute("invisible") == true)
        local primaryPart = (isInvisibleChar and hrp) and hrp or torso
        local head = tChar:FindFirstChild("Head")

        local excludeList = { LocalPlayer.Character, Workspace.CurrentCamera }
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character ~= tChar and not IsKiller(p) then
                table.insert(excludeList, p.Character)
            end
        end
        local rpChar = RaycastParams.new()
        rpChar.FilterType = Enum.RaycastFilterType.Include
        rpChar.FilterDescendantsInstances = { tChar }
        local rpWorld = RaycastParams.new()
        rpWorld.FilterType = Enum.RaycastFilterType.Exclude
        rpWorld.IgnoreWater = true
        rpWorld.FilterDescendantsInstances = excludeList

        local candidates = {
            hrp and hrp.Position or primaryPart.Position,
            primaryPart.Position,
            primaryPart.Position + Vector3.new(0, -0.05, 0),
            primaryPart.Position + Vector3.new(0, 0.20, 0),
            primaryPart.Position + Vector3.new(0, -0.25, 0),
        }
        local headIndex = nil
        if head and head:IsA("BasePart") and not isInvisibleChar then
            table.insert(candidates, head.Position)
            headIndex = #candidates
        end

        local bestTorsoPt = nil
        local fallbackDirectPt = nil
        for idx, rawPt in ipairs(candidates) do
            local dirVec = rawPt - shootOrigin
            local dist = dirVec.Magnitude
            if dist > 0.1 then
                local unitDir = dirVec / dist
                local charHit = Workspace:Raycast(shootOrigin, unitDir * (dist + 8), rpChar)
                if charHit and charHit.Instance and charHit.Instance:IsDescendantOf(tChar) then
                    local isBodyCandidate = (idx ~= headIndex)
                    if not fallbackDirectPt then
                        fallbackDirectPt = rawPt
                    end
                    local worldHit = Workspace:Raycast(shootOrigin, unitDir * (dist + 6), rpWorld)
                    if not worldHit or (worldHit.Instance and worldHit.Instance:IsDescendantOf(tChar)) then
                        if isBodyCandidate then
                            bestTorsoPt = rawPt
                            break
                        elseif not bestTorsoPt then
                            bestTorsoPt = rawPt
                        end
                    end
                end
            end
        end
        local chosenBase = bestTorsoPt or fallbackDirectPt or (hrp and hrp.Position) or primaryPart.Position

        local snapOffset = Vector3.zero
        local snapAge = nil
        if AutoParry and AutoParry.GetKillerServerState and hrp then
            local snap = AutoParry.GetKillerServerState(tChar, hrp)
            if snap and snap.pos and (tick() - (snap.time or 0)) <= 0.22 then
                local rawDiff = snap.pos - hrp.Position
                local cappedDiff = Vector3.new(rawDiff.X, math.clamp(rawDiff.Y, -1.5, 1.5), rawDiff.Z)
                if cappedDiff.Magnitude <= 7.5 then
                    snapOffset = cappedDiff
                    snapAge = math.clamp(tick() - snap.time, 0, 0.14)
                end
            end
        end

        local velLead = snapOffset
        if Config.Tof_Prediction ~= false then
            local targetPlr = Players:GetPlayerFromCharacter(tChar)
            local targetVel, stability = TofCombat.GetPlayerVelocity(targetPlr, tChar)
            local hVel = Vector3.new(targetVel.X, 0, targetVel.Z)
            local hSpeed = hVel.Magnitude
            if hSpeed > 0.5 or math.abs(targetVel.Y) > 1.5 then
                local clampedHSpeed = math.min(hSpeed, 46.0)
                local hDir = (hSpeed > 0.01) and (hVel / hSpeed) or Vector3.zero
                local effVel = Vector3.new(hDir.X * clampedHSpeed, math.clamp(targetVel.Y, -16, 16), hDir.Z * clampedHSpeed)

                local baseAtServer = chosenBase + snapOffset
                local dist0 = (baseAtServer - shootOrigin).Magnitude
                local ping = math.clamp(tonumber(TofCombat.CachedPing) or (AutoParry and AutoParry.GetPingSeconds and AutoParry.GetPingSeconds()) or 0.05, 0.015, 0.45)
                local netLead
                if snapAge ~= nil then
                    netLead = math.clamp(snapAge + (ping * 0.95), 0.02, 0.35)
                else
                    local renderedAt = tonumber(tChar:GetAttribute("VeilRenderedAt"))
                    local renderLag = (renderedAt and renderedAt > 0) and math.clamp(workspace:GetServerTimeNow() - renderedAt, 0.02, 0.20) or 0.06
                    netLead = math.clamp(renderLag + (ping * 0.95), 0.04, 0.38)
                end

                local leadScale = math.clamp(stability or 1.0, 0.65, 1.0)
                local dynLead = effVel * (netLead * leadScale)
                local totalHoriz = Vector3.new(snapOffset.X + dynLead.X, 0, snapOffset.Z + dynLead.Z)
                local maxHorizLead = math.clamp(dist0 * 0.45, 2.5, 12.0)
                if totalHoriz.Magnitude > maxHorizLead then
                    totalHoriz = totalHoriz.Unit * maxHorizLead
                end
                local totalVert = math.clamp(snapOffset.Y + (dynLead.Y * 0.55), -2.2, 2.2)
                velLead = Vector3.new(totalHoriz.X, totalVert, totalHoriz.Z)

                local toBase = chosenBase - shootOrigin
                local baseDist = toBase.Magnitude
                if baseDist > 0.5 and baseDist < 14.0 then
                    local radialProj = velLead:Dot(toBase.Unit)
                    if radialProj < -(baseDist - 2.2) then
                        velLead = velLead - toBase.Unit * (radialProj + (baseDist - 2.2))
                    end
                end
            end
        end

        local finalHitPos = chosenBase + velLead
        if velLead.Magnitude > 0.25 then
            local wallExclude = { LocalPlayer.Character, tChar, Workspace.CurrentCamera }
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then table.insert(wallExclude, p.Character) end
            end
            local rpWall = RaycastParams.new()
            rpWall.FilterType = Enum.RaycastFilterType.Exclude
            rpWall.IgnoreWater = true
            rpWall.FilterDescendantsInstances = wallExclude

            local pathHit = Workspace:Raycast(chosenBase, velLead, rpWall)
            if pathHit and pathHit.Instance and pathHit.Instance.CanCollide and pathHit.Instance.Transparency <= 0.01 then
                local safeDist = math.max(0, pathHit.Distance - 0.9)
                velLead = velLead.Unit * safeDist
                finalHitPos = chosenBase + velLead
            end

            local function isLineBlocked(pt)
                local toPt = pt - shootOrigin
                if toPt.Magnitude < 0.5 then return false end
                local wHit = Workspace:Raycast(shootOrigin, toPt, rpWall)
                return (wHit and wHit.Instance and wHit.Instance.CanCollide and wHit.Instance.Transparency <= 0.01 and wHit.Distance < (toPt.Magnitude - 1.2)) == true
            end
            if isLineBlocked(finalHitPos) then
                for _, frac in ipairs({ 0.75, 0.50, 0.25, 0.0 }) do
                    local testPt = chosenBase + (velLead * frac)
                    if not isLineBlocked(testPt) then
                        finalHitPos = testPt
                        break
                    end
                end
            end
        end
        return finalHitPos
    end
