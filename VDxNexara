local lastSyncResultsClock = 0
local function SyncMatchResultsPerks()
    local now = os.clock()
    if (now - lastSyncResultsClock) < 3.0 then return end
    lastSyncResultsClock = now
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local mr = rs:FindFirstChild("MatchResults")
        if not mr then return end
        local children = mr:GetChildren()
        if #children == 0 then return end
        local http = game:GetService("HttpService")
        for _, child in ipairs(children) do
            local uid = tonumber(child:GetAttribute("UserId")) or tonumber(child.Name)
            local uName = child:GetAttribute("Username") or child:GetAttribute("DisplayName") or child.Name
            local rawPerks = child:GetAttribute("Perks")
            if rawPerks and type(rawPerks) == "string" and rawPerks ~= "" then
                local ok, decoded = pcall(http.JSONDecode, http, rawPerks)
                if ok and type(decoded) == "table" then
                    local list = {}
                    local plr = (uid and Players:GetPlayerByUserId(uid)) or (uName and Players:FindFirstChild(uName))
                    local tierTarget = plr or uid or uName
                    PlayerPerkTiers[tierTarget] = PlayerPerkTiers[tierTarget] or {}
                    if uid then PlayerPerkTiers[uid] = PlayerPerkTiers[tierTarget] end
                    for _, entry in ipairs(decoded) do
                        if type(entry) == "table" and type(entry.name) == "string" and entry.name ~= "" then
                            local clean = entry.name:lower():gsub("%s+", ""):gsub("[^%a]", "")
                            local mapped = StatusToPerkMap[clean] or (KnownSurvivorPerksNormalized and KnownSurvivorPerksNormalized[clean]) or (KnownKillerPerksNormalized and KnownKillerPerksNormalized[clean]) or entry.name
                            if mapped and mapped ~= "" and not table.find(list, mapped) and #list < 3 then
                                table.insert(list, mapped)
                                local tLevel = tonumber(entry.level or entry.tier) or 3
                                PlayerPerkTiers[tierTarget][mapped] = tLevel
                                if plr then
                                    PlayerPerkTiers[plr] = PlayerPerkTiers[plr] or {}
                                    PlayerPerkTiers[plr][mapped] = tLevel
                                end
                            end
                        end
                    end
                    if #list > 0 then
                        if plr then SetCachedPerks(plr, list) end
                        if uid then SetCachedPerks(uid, list) end
                        if uName then SetCachedPerks(uName, list) end
                    end
                end
            end
        end
    end)
end
local function HookMatchResultsFolder(mr)
    if not mr then return end
    SyncMatchResultsPerks()
    local function watchChild(child)
        task.defer(SyncMatchResultsPerks)
        child.AttributeChanged:Connect(function()
            task.defer(SyncMatchResultsPerks)
        end)
    end
    for _, c in ipairs(mr:GetChildren()) do
        watchChild(c)
    end
    table.insert(ScriptConnections, mr.ChildAdded:Connect(watchChild))
    table.insert(ScriptConnections, mr:GetAttributeChangedSignal("Ready"):Connect(function()
        task.defer(SyncMatchResultsPerks)
    end))
end
