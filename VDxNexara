AutoParry.KillerLastHeading = AutoParry.KillerLastHeading or {}
AutoParry.KillerLastSpinTick = AutoParry.KillerLastSpinTick or {}
AutoParry.KillerLastTurnTick = AutoParry.KillerLastTurnTick or {}
function AutoParry.UpdateKillerAngularState(kChar, kHrp, toMe)
    if not kChar or not kHrp then return false, 0, 0, 0 end
    local now = tick()
    local camLook, rawCamLook, hrpUnit = AutoParry.GetKillerAimData(kChar, kHrp)
    local camAngle = math.atan2(camLook.X, camLook.Z)
    local hrpAngle = math.atan2(hrpUnit.X, hrpUnit.Z)
    local curDot = toMe and camLook:Dot(toMe) or 0
    local lastData = AutoParry.KillerLastHeading[kChar]
    local function shortestDelta(a, b)
        return ((a - b + math.pi) % (2 * math.pi)) - math.pi
    end
    if not lastData or type(lastData) ~= "table" or not lastData.time then
        lastData = {
            cam = camAngle,
            hrp = hrpAngle,
            dot = curDot,
            hasToMe = (toMe ~= nil),
            camVel = 0,
            hrpVel = 0,
            dotVel = 0,
            time = now
        }
        AutoParry.KillerLastHeading[kChar] = lastData
        return false, 0, 0, 0
    end

    local dt = now - lastData.time
    local camVel = lastData.camVel or 0
    local hrpVel = lastData.hrpVel or 0
    local dotVel = lastData.dotVel or 0

    if dt >= 0.008 and dt <= 0.25 then
        local dCam = shortestDelta(camAngle, lastData.cam)
        local dHrp = shortestDelta(hrpAngle, lastData.hrp)
        local rawCamVel = (math.abs(dCam) >= 0.004) and (dCam / dt) or 0
        local rawHrpVel = (math.abs(dHrp) >= 0.004) and (dHrp / dt) or 0
        camVel = (rawCamVel * 0.68) + (camVel * 0.32)
        hrpVel = (rawHrpVel * 0.68) + (hrpVel * 0.32)
        if toMe and lastData.hasToMe then
            local dDot = curDot - (lastData.dot or curDot)
            local rawDotVel = (math.abs(dDot) >= 0.003) and (dDot / dt) or 0
            dotVel = (rawDotVel * 0.68) + (dotVel * 0.32)
        elseif toMe then
            lastData.dot = curDot
            lastData.hasToMe = true
        end
        lastData.cam = camAngle
        lastData.hrp = hrpAngle
        if toMe then
            lastData.dot = curDot
            lastData.hasToMe = true
        end
        lastData.camVel = camVel
        lastData.hrpVel = hrpVel
        lastData.dotVel = dotVel
        lastData.time = now
    elseif dt > 0.25 then
        lastData.cam = camAngle
        lastData.hrp = hrpAngle
        lastData.dot = curDot
        lastData.hasToMe = (toMe ~= nil)
        lastData.camVel = 0
        lastData.hrpVel = 0
        lastData.dotVel = 0
        lastData.time = now
        camVel, hrpVel, dotVel = 0, 0, 0
    end

    if math.abs(camVel) >= 2.2 or math.abs(hrpVel) >= 2.2 then
        AutoParry.KillerLastTurnTick[kChar] = now
    end
    if dotVel >= 1.1 and (math.abs(camVel) >= 2.2 or math.abs(hrpVel) >= 2.2) then
        AutoParry.KillerLastSpinTick[kChar] = now
    end
    local isFlickingTowardMe = (dotVel >= 1.0) and (math.abs(camVel) >= 2.2 or math.abs(hrpVel) >= 2.2)
    return isFlickingTowardMe, camVel, hrpVel, dotVel
end
function AutoParry.IsKillerSpinning(kChar, kHrp)
    if not kChar or not kHrp then return false end
    local lastData = AutoParry.KillerLastHeading[kChar]
    if not lastData then return false end
    return math.abs(lastData.camVel or 0) >= 2.4 or math.abs(lastData.hrpVel or 0) >= 2.4
end
function AutoParry.CanTrackStillHitUs(tr, meta, kChar, kHrp, myHrp)
    if not tr or not kChar or not kHrp or not myHrp then return false end
    local now = tick()
    local startT = AutoParry.TrackStartTick[tr]
    if not startT then
        startT = now - (tr.TimePosition or 0)
        AutoParry.TrackStartTick[tr] = startT
    end
    local primaryLook = AutoParry.GetKillerAimData(kChar, kHrp)
    local diff = Vector3.new(myHrp.Position.X - kHrp.Position.X, 0, myHrp.Position.Z - kHrp.Position.Z)
    local toMe = diff.Magnitude > 0.001 and diff.Unit or primaryLook
    local curDot = primaryLook:Dot(toMe)
    local startDot = AutoParry.TrackStartDot[tr]
    if startDot == nil then
        startDot = curDot
        AutoParry.TrackStartDot[tr] = startDot
    end
    if meta and meta.isSkillAnim then
        return true
    end
    local elapsed = math.max(now - startT, tr.TimePosition or 0)
    -- Only expire if killer started M1 facing > 72 deg away from us AND 0.26s has already elapsed
    if startDot < 0.30 and elapsed > 0.26 then
        AutoParry.ResolvedTracks[tr] = true
        return false
    end
    return true
end
function AutoParry.IsClosestTargetToKiller(kHrp, myHrp, myDist)
