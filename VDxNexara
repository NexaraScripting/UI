function AutoParry.FindDaggerObject()
    local now = os.clock()
    if AutoParry.CachedDaggerObj and AutoParry.CachedDaggerObj.Parent then
        local p = AutoParry.CachedDaggerObj.Parent
        if p == LocalPlayer.Character or (p:IsA("Backpack") and p.Parent == LocalPlayer) then
            return AutoParry.CachedDaggerObj
        end
    end
    if AutoParry.LastDaggerSearchClock and (now - AutoParry.LastDaggerSearchClock) < 0.25 then
        return AutoParry.CachedDaggerObj
    end
    AutoParry.LastDaggerSearchClock = now
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    local containers = { char, bp }
    for i = 1, 2 do
        local cont = containers[i]
        if cont then
            local t = cont:FindFirstChild("Parrying Dagger") or cont:FindFirstChild("Parry Dagger")
            if t and (t:IsA("Tool") or t:IsA("Model")) then
                AutoParry.CachedDaggerObj = t
                return t
            end
            for _, obj in ipairs(cont:GetChildren()) do
                if obj:IsA("Tool") or obj:IsA("Model") then
                    local l = obj.Name:lower()
                    if l:find("parry") or l:find("dagger") then
                        AutoParry.CachedDaggerObj = obj
                        return obj
                    end
                end
            end
        end
    end
    AutoParry.CachedDaggerObj = nil
    return nil
end
