        local tracks = anim:GetPlayingAnimationTracks()
        for i = 1, #tracks do
            local tr = tracks[i]
            if tr.IsPlaying and tr.Animation then
                local meta = GetTrackMeta(tr)
                local aid = meta.aid
                if aid == "96839438835309" or aid == "121652792485491" or aid == "111799506306582" or aid == "126230221638196" then
                    AutoParry.LastRealVaultTick[killerChar] = now
                    return true
                end
                local nm = meta.anm
                local tnm = meta.tnm
                if (nm:find("vault") or nm:find("window") or tnm:find("vault") or tnm:find("window"))
                   and not nm:find("attack") and not tnm:find("attack") then
                    AutoParry.LastRealVaultTick[killerChar] = now
                    return true
                end
            end
        end
    end
    return false
end
function AutoParry.IsLocalPlayerBusy(char)
