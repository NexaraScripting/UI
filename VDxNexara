                local tnm = meta.tnm
                if (anm:find("leap") and (anm:find("dash") or anm:find("attack") or anm:find("m2")))
                   or (tnm:find("leap") and (tnm:find("dash") or tnm:find("attack") or tnm:find("m2"))) then
