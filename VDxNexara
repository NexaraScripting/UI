            local cHp = hum.HealthChanged:Connect(function(newHp)
                local isBleedOut = (char:GetAttribute("Knocked") == true) or (lastHp < 50 and newHp < 50)
                if newHp < lastHp - 0.5 and not isBleedOut then
                    AutoParry.LastDamagedTick = tick()
                    AutoParry.MarkActiveKillerTracksResolved()
                end
                lastHp = newHp
