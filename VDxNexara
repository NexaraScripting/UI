function AutoParry.GetNativeClient()
    local myChar = LocalPlayer.Character
    if AutoParry.CachedNativeClient and type(AutoParry.CachedNativeClient) == "table" then
        local client = AutoParry.CachedNativeClient
        if myChar and client.character ~= myChar then
            pcall(function() client:_bindCharacter(myChar) end)
        end
        if client.character == myChar and (not client.tool or client.tool.Parent) then
            return client
        end
    end
    local now = os.clock()
    if AutoParry.LastNativeClientLookupClock and (now - AutoParry.LastNativeClientLookupClock) < 0.25 then
        return AutoParry.CachedNativeClient
    end
    AutoParry.LastNativeClientLookupClock = now
    local rem = ReplicatedStorage:FindFirstChild("Remotes")
    local items = rem and rem:FindFirstChild("Items")
    local pd = items and (items:FindFirstChild("Parrying Dagger") or items:FindFirstChild("Parry Dagger"))
    local resEvent = pd and (pd:FindFirstChild("parryResult") or pd:FindFirstChild("ParryResult"))
    if resEvent and resEvent:IsA("RemoteEvent") and type(getconnections) == "function" and type(getupvalues) == "function" then
        for _, conn in ipairs(getconnections(resEvent.OnClientEvent)) do
            if type(conn.Function) == "function" then
                local vals = getupvalues(conn.Function)
                for _, obj in pairs(vals) do
                    if type(obj) == "table" and ((rawget(obj, "isParryOnCooldown") ~= nil and rawget(obj, "tool") ~= nil) or type(obj.Parry) == "function") then
                        AutoParry.SetupClient(obj, myChar)
                        AutoParry.CachedNativeClient = obj
                        if not AutoParry.CachedDaggerObj and obj.tool then
                            AutoParry.CachedDaggerObj = obj.tool
                        end
                        return obj
                    end
                end
            end
        end
    end
    if type(getgc) == "function" then
        for _, obj in pairs(getgc(true)) do
            if type(obj) == "table" then
                local meta = getmetatable(obj)
                if (type(meta) == "table" and rawget(meta, "Parry") ~= nil and rawget(meta, "CanUse") ~= nil) or (rawget(obj, "Parry") ~= nil and rawget(obj, "isParryOnCooldown") ~= nil) then
                    AutoParry.SetupClient(obj, myChar)
                    AutoParry.CachedNativeClient = obj
                    if not AutoParry.CachedDaggerObj and obj.tool then
                        AutoParry.CachedDaggerObj = obj.tool
                    end
                    return obj
                end
            end
        end
    end
    return AutoParry.CachedNativeClient
end
function AutoParry.ExecuteNativeParry()
    local client = AutoParry.GetNativeClient()
    if client then
        if client.isParryOnCooldown or client.isParryLocked or client.isSilenced then
            return false
        end
        local now = tick()
        if client.isParryResolving then
            if (now - (AutoParry.LastNativeParryTick or 0)) > 3.0 then
                client.isParryResolving = false
            else
                return false
            end
        end
        if not AutoParry.IsDaggerEquipped() then
            AutoParry.EquipDagger()
        end
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then
            pcall(function() CollectionService:RemoveTag(myHrp, "doing action") end)
        end
        client._nexaraHookedFaceLook = true
        client._faceLookDirection = function(selfClient, ...)
            selfClient.faceToken = (selfClient.faceToken or 0) + 1
            if selfClient.faceTween then
                pcall(function() selfClient.faceTween:Cancel() end)
            end
            return
        end
        local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        AutoParry.LastNativeParryTick = now
        local kc = AutoParry.CurrentTargetKiller
        local kh = kc and kc.Parent and kc:FindFirstChild("HumanoidRootPart")
        if myChar and myHrp and kh then
            AutoParry.SyncLookToKillerNow(myChar, myHrp, kh)
        end
        coroutine.resume(coroutine.create(function()
            pcall(client.Parry, client)
            if tick() >= (AutoParry.FaceLockUntil or 0) then
                AutoParry.StopKillerFaceLock()
                AutoParry.ReleaseParryMovementLock(client)
            end
        end))
        if myChar and myHrp and kh then
            AutoParry.SyncLookToKillerNow(myChar, myHrp, kh)
        end
        if AutoParry.UpdateCircle then
            task.delay(0.05, AutoParry.UpdateCircle)
        end
        if hum and tick() < (AutoParry.FaceLockUntil or 0) then
            hum.AutoRotate = false
        end
        task.delay(0.55, function()
            AutoParry.StopKillerFaceLock()
            AutoParry.ReleaseParryMovementLock(client)
        end)
        return true
    end
    return false
end
function AutoParry.IsKillerVaulting(killerChar)
