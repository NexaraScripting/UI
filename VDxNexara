function AutoParry.ClassifyKillerAnimEntry(keyName, rawVal)
    local id = tostring(rawVal or ""):match("%d+")
    if not id or id == "" then return end
    local kl = tostring(keyName or ""):lower()
    if (kl:find("attackfr") or kl:find("frenzyattack") or kl:find("frenzyslash")
       or kl:find("attack") or kl:find("swing") or kl:find("slash")
       or kl:find("strike") or kl:find("throwchain")
       or kl:find("smash") or kl:find("dash") or kl:find("leap")
       or kl:find("m1") or kl:find("stab") or kl:find("cleave") or kl:find("rush"))
       and not kl:find("vm") and not kl:find("hold") and not kl:find("windup")
       and not kl:find("end") and not kl:find("wipe") and not kl:find("wallhit")
       and not kl:find("stun") and not kl:find("cancel") and not kl:find("pickup")
       and not kl:find("carry") and not kl:find("slide") and not kl:find("vault")
       and not kl:find("fatigue") and not kl:find("hurt") and not kl:find("pain") then
        AutoParry.AttackAnimIds[id] = true
        AutoParry.IgnoredAnimIds[id] = nil
    elseif AutoParry.IsLungeHold(id, kl, "") then
        AutoParry.IgnoredAnimIds[id] = true
        AutoParry.AttackAnimIds[id] = nil
        AutoParry.LungeHoldAnimIds[id] = true
    elseif AutoParry.IsIgnoredTrackName(kl, "") then
        AutoParry.IgnoredAnimIds[id] = true
        AutoParry.AttackAnimIds[id] = nil
    end
end
function AutoParry.ScanKillerAnims(char)
    local animate = char:FindFirstChild("Animate")
    if animate then
        for _, d in ipairs(animate:GetDescendants()) do
            if d:IsA("Animation") then
                local id = tostring(d.AnimationId):match("%d+")
                if id then AutoParry.IgnoredAnimIds[id] = true end
            end
        end
    end
    local dropAnim = char:FindFirstChild("PreloadedDropAnim")
    if dropAnim and dropAnim:IsA("Animation") then
        local id = tostring(dropAnim.AnimationId):match("%d+")
        if id then AutoParry.IgnoredAnimIds[id] = true end
    end
    local animScript = char:FindFirstChild("Animations")
    if animScript and animScript:IsA("ModuleScript") then
        local okReq, animTbl = pcall(require, animScript)
        if okReq and type(animTbl) == "table" then
            local function walkTbl(t, prefix)
                for k, v in pairs(t) do
                    local fullKey = prefix ~= "" and (prefix .. "_" .. tostring(k)) or tostring(k)
                    if type(v) == "string" or type(v) == "number" then
                        AutoParry.ClassifyKillerAnimEntry(fullKey, v)
                    elseif type(v) == "table" then
                        walkTbl(v, fullKey)
                    end
                end
            end
            pcall(walkTbl, animTbl, "")
        end
        if type(decompile) == "function" then
            task.spawn(function()
                local ok, src = pcall(decompile, animScript)
                if ok and type(src) == "string" then
                    for k, id in src:gmatch("([%w_]+)%s*=%s*['\"][%a%d%-_/:]-(%d+)['\"]") do
                        AutoParry.ClassifyKillerAnimEntry(k, id)
                    end
                end
            end)
        end
    end
end
function AutoParry.HookCharacter(char)
    if not char or AutoParry.HookedCharacters[char] then return end
    if char == LocalPlayer.Character or char.Name == LocalPlayer.Name then return end
    local p = Players:GetPlayerFromCharacter(char)
    if p then
        if p.Team and p.Team.Name == "Survivors" then return end
        if not (IsKiller(p) or AutoParry.IsKillerChar(char)) then return end
    else
        if not AutoParry.IsKillerChar(char) then return end
    end
    AutoParry.HookedCharacters[char] = true
    AutoParry.CharacterConnections[char] = {}
    pcall(AutoParry.ScanKillerAnims, char)
    local connAncestry = char.AncestryChanged:Connect(function(_, parent)
        if not parent then
            AutoParry.UnhookCharacter(char)
        end
    end)
    table.insert(AutoParry.CharacterConnections[char], connAncestry)
    local function onChild(child)
        if child:IsA("Humanoid") then
            local anim = child:FindFirstChildOfClass("Animator")
            if anim then AutoParry.HookAnimator(anim, char) end
            local conn = child.ChildAdded:Connect(function(sub)
                if sub:IsA("Animator") then AutoParry.HookAnimator(sub, char) end
            end)
            if AutoParry.CharacterConnections[char] then
                table.insert(AutoParry.CharacterConnections[char], conn)
            end
        elseif child:IsA("Tool") or child:IsA("Model") then
            local nm = child.Name:lower()
            local isWep = child:IsA("Tool") or nm:find("weapon") or nm:find("axe") or nm:find("knife") or nm:find("blade") or nm:find("spear")
            if not isWep then
                isWep = nm:find("chainsaw") or nm:find("katana") or nm:find("sword") or nm:find("bat") or nm:find("staff") or nm:find("main")
            end
            if isWep then
                AutoParry.HookKillerWeapon(child, char)
            end
        elseif child.Name == "Animate" or child.Name == "Animations" then
            pcall(AutoParry.ScanKillerAnims, char)
        end
    end
    for _, c in ipairs(char:GetChildren()) do onChild(c) end
    local conn = char.ChildAdded:Connect(onChild)
    table.insert(AutoParry.CharacterConnections[char], conn)
    local connCamLook = char:GetAttributeChangedSignal("CamLook"):Connect(function()
        if Config.AutoParry_Enabled and AutoParry.CheckKillersNow then
            AutoParry.CheckKillersNow("CamLookInstant")
        end
    end)
    table.insert(AutoParry.CharacterConnections[char], connCamLook)
end
function AutoParry.AnimateCircleCollapse()
