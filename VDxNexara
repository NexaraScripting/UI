end
AutoParry.MyPosHistory = AutoParry.MyPosHistory or {}
function AutoParry.RecordMyPosHistory(myHrp)
    if not myHrp then return end
    local now = tick()
    local hist = AutoParry.MyPosHistory
    if #hist == 0 or (now - hist[#hist].time) >= 0.015 then
        local mv = myHrp.AssemblyLinearVelocity or Vector3.zero
        local flatV = Vector3.new(mv.X, 0, mv.Z)
        local lv = myHrp.CFrame.LookVector
        local flatL = Vector3.new(lv.X, 0, lv.Z)
        hist[#hist + 1] = {
            pos = myHrp.Position,
            vel = flatV.Magnitude > 1.5 and flatV.Unit or nil,
            speed = flatV.Magnitude,
            look = flatL.Magnitude > 0.01 and flatL.Unit or nil,
            time = now
        }
    end
    while #hist > 1 and (now - hist[1].time) > 0.42 do
        table.remove(hist, 1)
    end
end
