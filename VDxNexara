function AutoParry.IsKillerChar(char)
    if not char or not char.Parent then return false end
    if char == LocalPlayer.Character or char.Name == LocalPlayer.Name then return false end
    local p = Players:GetPlayerFromCharacter(char)
    if p then
        if p.Team and p.Team.Name == "Survivors" then return false end
        if IsKiller(p) then return true end
        if p:GetAttribute("IsKiller") == true then return true end
    end
    if char:FindFirstChild("Skillcheck-gen") or char:FindFirstChild("ProgressBar") then
        return false
    end
    if char.Parent and char.Parent.Name == "Killers" then return true end
    if char:FindFirstChild("Lookscriptkiller") then return true end
    local morph = tostring(char:GetAttribute("MorphedKiller") or char:GetAttribute("SelectedKiller") or ""):lower()
    if morph ~= "" and morph ~= "nil" and morph ~= "none" and not morph:find("survivor") then
        return true
    end
    if char:GetAttribute("BloodLust") ~= nil or char:GetAttribute("LakeMist") ~= nil or char:GetAttribute("Pursuit") ~= nil
       or char:GetAttribute("Frenzy") ~= nil or char:GetAttribute("Mask") ~= nil or char:GetAttribute("Stage") ~= nil
       or char:GetAttribute("Butcher") ~= nil or char:GetAttribute("corrupt") ~= nil or char:GetAttribute("spearmode") ~= nil
       or char:GetAttribute("invisible") ~= nil or char:GetAttribute("preparem2") ~= nil then
        return true
    end
    if char:FindFirstChild("Killerost") or char:FindFirstChild("pamela") or char:FindFirstChild("PursuitPalletPredict")
       or char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") or char:FindFirstChild("Spear2")
       or char:FindFirstChild("Curetool") or char:FindFirstChild("Flask") or char:FindFirstChild("Chainsaw")
       or char:FindFirstChild("Abysswalker") or char:FindFirstChild("Katana") or char:FindFirstChild("Sword") then
        return true
    end
    if char:FindFirstChild("Weapon") and not char:FindFirstChild("Lookscript") then
        return true
    end
    local nm = char.Name:lower()
    if nm:find("killer") or nm:find("slasher") or nm:find("monster") or nm:find("zombie")
       or nm:find("stalker") or nm:find("abysswalker") or nm:find("veil") or nm:find("masked")
       or nm:find("butcher") or nm:find("cure") or nm:find("hidden") then
        if char:FindFirstChildOfClass("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            return true
        end
    end
    return false
end
function AutoParry.GetKillerCharacters()
    local now = os.clock()
    if AutoParry.CachedKillerChars and AutoParry.LastKillerScanClock and (now - AutoParry.LastKillerScanClock) < 0.20 then
        return AutoParry.CachedKillerChars
    end
    AutoParry.LastKillerScanClock = now
    local list = AutoParry.CachedKillerChars or {}
    table.clear(list)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p.Team and p.Team.Name == "Survivors" then
            elseif IsKiller(p) or AutoParry.IsKillerChar(p.Character) then
                if not table.find(list, p.Character) then
                    table.insert(list, p.Character)
                end
                if CurrentKillerPlayer ~= p and not IsPlayerDead(p) then
                    CurrentKillerPlayer = p
                end
            end
        end
    end
    local wKillers = workspace:FindFirstChild("Killers")
    if wKillers then
        for _, obj in ipairs(wKillers:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
                if not table.find(list, obj) then
                    table.insert(list, obj)
                end
            end
        end
    end
    local wChars = workspace:FindFirstChild("Characters")
    if wChars then
        for _, obj in ipairs(wChars:GetChildren()) do
            if obj:IsA("Model") and AutoParry.IsKillerChar(obj) then
                if not table.find(list, obj) then
                    table.insert(list, obj)
                end
            end
        end
    end
    AutoParry.CachedKillerChars = list
    return list
end
function AutoParry.CheckLineOfSight(kHrp, myHrp)
    if not kHrp or not myHrp then return false end
    local origin = kHrp.Position + Vector3.new(0, 0.45, 0)
    local target = myHrp.Position + Vector3.new(0, 0.45, 0)
    local dir = target - origin
    local dirDist = dir.Magnitude
    if dirDist < 0.01 then return true end

    if not AutoParry.LosRayParams then
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        AutoParry.LosRayParams = rp
    end
    local curMyChar = myHrp.Parent
    local curKChar = kHrp.Parent
    if AutoParry.LastLosFilterMyChar ~= curMyChar or AutoParry.LastLosFilterKChar ~= curKChar then
        AutoParry.LastLosFilterMyChar = curMyChar
        AutoParry.LastLosFilterKChar = curKChar
        local filter = { curKChar, curMyChar }
        local wChars = workspace:FindFirstChild("Characters")
        if wChars then table.insert(filter, wChars) end
        local wKillers = workspace:FindFirstChild("Killers")
        if wKillers then table.insert(filter, wKillers) end
        local curCam = workspace.CurrentCamera
        if curCam then table.insert(filter, curCam) end
        AutoParry.LosRayParams.FilterDescendantsInstances = filter
    end

    local function isWindowOrVaultObstacle(inst)
        if not inst then return false end
        if CollectionService:HasTag(inst, "vaultbox") or CollectionService:HasTag(inst, "window") then return true end
        local nm = inst.Name:lower()
        if nm == "bottom" or nm:find("window") or nm:find("vault") or nm:find("sill") or nm:find("pallet") then return true end
        local p = inst.Parent
        if p then
            local pnm = p.Name:lower()
            if pnm:find("window") or pnm:find("vault") or pnm:find("pallet") then return true end
        end
        return false
    end

    local hit = workspace:Raycast(origin, dir, AutoParry.LosRayParams)
    if hit and hit.Instance then
        local inst = hit.Instance
        if inst.CanCollide or isWindowOrVaultObstacle(inst) then
            return false
        end
    end

    local hitLow = workspace:Raycast(kHrp.Position + Vector3.new(0, -0.4, 0), (myHrp.Position + Vector3.new(0, -0.4, 0)) - (kHrp.Position + Vector3.new(0, -0.4, 0)), AutoParry.LosRayParams)
    if hitLow and hitLow.Instance then
        local inst = hitLow.Instance
        if inst.CanCollide or isWindowOrVaultObstacle(inst) then
            return false
        end
    end

    return true
end
function AutoParry.GetKillerAimData(killerChar, kHrp)
    local hrpUnit = Vector3.new(0, 0, -1)
    if kHrp then
        local raw = Vector3.new(kHrp.CFrame.LookVector.X, 0, kHrp.CFrame.LookVector.Z)
        if raw.Magnitude > 0.01 then
            hrpUnit = raw.Unit
        end
    end
    if not killerChar then
        return hrpUnit, nil, hrpUnit, 0
    end
    local snap = AutoParry.GetKillerServerState(killerChar, kHrp)
    local snapLook = (snap and snap.look and snap.look.Magnitude > 0.01) and snap.look or nil
    local snapYawVel = (snap and snap.yawVel) or 0
    local attrLook = nil
    local camLook = killerChar:GetAttribute("CamLook")
    if typeof(camLook) == "Vector3" then
        local raw = Vector3.new(camLook.X, 0, camLook.Z)
        if raw.Magnitude > 0.01 then
            attrLook = raw.Unit
        end
    elseif type(camLook) == "string" then
        local x, _y, z = camLook:match("([^,]+),%s*([^,]+),%s*([^,]+)")
        if x and z then
            local raw = Vector3.new(tonumber(x) or 0, 0, tonumber(z) or 0)
            if raw.Magnitude > 0.01 then
                attrLook = raw.Unit
            end
        end
    end
    local authoritativeAim = snapLook or attrLook
    local primaryLook = authoritativeAim or hrpUnit
    return primaryLook, authoritativeAim, hrpUnit, snapYawVel
end
function AutoParry.GetKillerAimLook(killerChar, kHrp)
