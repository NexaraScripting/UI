    local nowT = tick()
    local client = AutoParry.GetNativeClient()
    if (not char or char:GetAttribute("ParrySpent") ~= true) and (nowT - (AutoParry.LastParryTick or 0)) > 2.0 then
        if (AutoParry.CooldownUntil or 0) > nowT or GetItemCooldown(LocalPlayer, "Parrying Dagger") > 0 then
            AutoParry.CooldownUntil = 0
            SetItemCooldown(LocalPlayer, "Parrying Dagger", 0)
        end
    end
    local isOnCooldown = ((AutoParry.CooldownUntil or 0) > nowT) or (GetItemCooldown(LocalPlayer, "Parrying Dagger") > 0) or (char and char:GetAttribute("ParrySpent") == true)
    local hasDaggerReady = hasDagger
        and not isKnockedOrDown
        and not isLowHealth
        and not isOnCooldown
    if client then
        if client.isParryOnCooldown or client.isParryLocked or client.isParryResolving or client.isSilenced then
            hasDaggerReady = false
        end
    end
    local inLobby = IsInLobby() or IsPlayerInLobby(LocalPlayer)
    if not enabled or not hrp or IsPlayerDead(LocalPlayer) or inLobby or isLocalKiller or not hasDagger then
        if AutoParry.RangeAdornment then
            pcall(function() AutoParry.RangeAdornment:Destroy() end)
            AutoParry.RangeAdornment = nil
        end
        if char then
            for _, obj in ipairs(char:GetDescendants()) do
                if obj.Name == "Nexara_ParryRadiusCircle" then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        return
    end
    for _, obj in ipairs(hrp:GetChildren()) do
        if obj.Name == "Nexara_ParryRadiusCircle" and obj ~= AutoParry.RangeAdornment then
            pcall(function() obj:Destroy() end)
        end
    end
    local r = tonumber(Config.AutoParry_Radius) or 11.5
    local baseCol = Config.Color_AutoParry_Radius or Color3.fromRGB(80, 200, 255)

    if not AutoParry.RangeAdornment or AutoParry.RangeAdornment.Parent ~= hrp then
        if AutoParry.RangeAdornment then pcall(function() AutoParry.RangeAdornment:Destroy() end) end
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj.Name == "Nexara_ParryRadiusCircle" then
                pcall(function() obj:Destroy() end)
            end
        end
        local ad = Instance.new("CylinderHandleAdornment")
        ad.Name = "Nexara_ParryRadiusCircle"
        ad.Height = 0.05
        ad.Transparency = hasDaggerReady and 0.6 or 1
        ad.AlwaysOnTop = true
        ad.ZIndex = 10
        ad.CFrame = CFrame.new(0, -3.1, 0) * CFrame.Angles(math.rad(90), 0, 0)
        ad.Adornee = hrp
        ad.Parent = hrp
        ad.Radius = hasDaggerReady and r or 0.01
        ad.InnerRadius = hasDaggerReady and math.max(r - 0.2, 0) or 0
        ad.Color3 = baseCol
        ad.Visible = hasDaggerReady
        AutoParry.RangeAdornment = ad
        AutoParry.LastCircleState = hasDaggerReady
        AutoParry.LastCircleRadius = r
        AutoParry.CircleIsCollapsed = not hasDaggerReady
    end
    if AutoParry.LastCircleState ~= hasDaggerReady then
        AutoParry.LastCircleState = hasDaggerReady
        if hasDaggerReady then
            AutoParry.AnimateCircleExpand()
        else
            AutoParry.AnimateCircleCollapse()
        end
    end
    if not hasDaggerReady then
        local ad = AutoParry.RangeAdornment
        if ad and not AutoParry.CircleTween then
            ad.Visible = false
            ad.Transparency = 1
        end
        return
    end
    if hasDaggerReady and not AutoParry.CircleIsCollapsed then
        local ad = AutoParry.RangeAdornment
        if not AutoParry.CircleTween and (ad.Transparency > 0.7 or not ad.Visible or ad.Radius < 1.0) then
            AutoParry.AnimateCircleExpand()
        else
            if AutoParry.LastCircleRadius ~= r then
                AutoParry.LastCircleRadius = r
                if AutoParry.CircleTween then
                    pcall(function() AutoParry.CircleTween:Cancel() end)
                    AutoParry.CircleTween = nil
                end
                ad.Radius = r
                ad.InnerRadius = math.max(r - 0.2, 0)
                ad.Transparency = 0.6
                ad.Visible = true
            end
            if ad.Color3 ~= baseCol then
                ad.Color3 = baseCol
            end
        end
    end
end
function AutoParry.CleanupMatch()
    AutoParry.StopKillerFaceLock()
    if AutoParry.RangeAdornment then
        pcall(function() AutoParry.RangeAdornment:Destroy() end)
        AutoParry.RangeAdornment = nil
    end
    local myChar = LocalPlayer.Character
    if myChar then
        for _, obj in ipairs(myChar:GetDescendants()) do
            if obj.Name == "Nexara_ParryRadiusCircle" then
                pcall(function() obj:Destroy() end)
            end
        end
    end
    AutoParry.CachedNativeClient = nil
    AutoParry.CurrentTargetKiller = nil
end
function AutoParry.Init()
