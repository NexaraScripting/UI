    AutoParry.EnsureGradients(client)
    if rawget(client, "_startCooldown") ~= nil and not client._nexaraHookedStartCd then
        rawset(client, "_startCooldown", nil)
    end
    if client._nexaraHookedParry then
        client._nexaraHookedParry = nil
    end
    if type(client._refreshVisual) == "function" then
        local origRefresh = client._nexaraOrigRefreshVisual or client._refreshVisual
        client._nexaraOrigRefreshVisual = origRefresh
        client._nexaraHookedRefreshVisual = true
        client._refreshVisual = function(selfClient, ...)
            origRefresh(selfClient, ...)
            local ap = (getgenv and getgenv().AutoParry) or AutoParry
            if ap and ap.UpdateCircle then
                ap.LastCircleUpdateClock = nil
                ap.UpdateCircle()
