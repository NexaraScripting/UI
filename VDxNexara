function AutoParry.GetKillerServerPos(kChar, kHrp)
    local kPosVis = kHrp.Position
    local snap = AutoParry.GetKillerServerState(kChar, kHrp)
    if snap and snap.pos then
        local age = tick() - (snap.time or 0)
        if age <= 0.18 then
            local extrapPos = snap.pos
            if snap.vel and snap.vel.Magnitude > 0.5 then
                extrapPos = extrapPos + Vector3.new(snap.vel.X, 0, snap.vel.Z) * math.min(age, 0.08)
            end
            local dSnap = extrapPos - kPosVis
            if dSnap.Magnitude <= 2.20 then
                return extrapPos
            else
                return kPosVis + (dSnap.Unit * 2.20)
            end
        end
    end
    return kPosVis
end
function AutoParry.GetMyLaggedTrailPos(myHrp, kPos)
    local myPos = myHrp.Position
    local pingSec = AutoParry.GetPingSeconds()
    local rewindWindow = math.clamp(pingSec * 1.25 + 0.06, 0.08, 0.20)
    local hist = AutoParry.MyPosHistory
    local now = tick()
    local bestPos = myPos
    local minDist = (kPos - myPos).Magnitude
    local peakToward = 0
    local toMeNow = Vector3.new(myPos.X - kPos.X, 0, myPos.Z - kPos.Z)
    local toMeUnit = toMeNow.Magnitude > 0.001 and toMeNow.Unit or nil
    if hist then
        for i = #hist, 1, -1 do
            local entry = hist[i]
            local age = now - (entry.time or 0)
            if age > rewindWindow then
                break
            end
            if entry.pos then
                local d = (kPos - entry.pos).Magnitude
                if d < minDist then
                    minDist = d
                    bestPos = entry.pos
                end
            end
            if toMeUnit and entry.vel and entry.speed and age <= 0.14 then
                local spdToward = -((entry.vel * entry.speed):Dot(toMeUnit))
                if spdToward > peakToward then
                    peakToward = spdToward
                end
            end
        end
    end
    local myVel = myHrp.AssemblyLinearVelocity or Vector3.zero
    local myFlatVel = Vector3.new(myVel.X, 0, myVel.Z)
    if myFlatVel.Magnitude > 0.5 then
        local backVec = myFlatVel * math.clamp(pingSec * 1.10, 0.04, 0.14)
        if backVec.Magnitude > 1.15 then
            backVec = backVec.Unit * 1.15
        end
        local extrapBack = myPos - backVec
        if (kPos - extrapBack).Magnitude < minDist then
            bestPos = extrapBack
        end
    end
    local trailDiff = bestPos - myPos
    if trailDiff.Magnitude > 1.35 then
        bestPos = myPos + (trailDiff.Unit * 1.35)
    end
    return bestPos, peakToward
end
function AutoParry.EvaluateSweptHitbox(myHrp, kHrp)
    AutoParry.RecordMyPosHistory(myHrp)
    local kChar = kHrp.Parent
    local kPosVis = kHrp.Position
    local kPosSrv = AutoParry.GetKillerServerPos(kChar, kHrp)
    local primaryLook, rawCamLook, hrpUnit = AutoParry.GetKillerAimData(kChar, kHrp)

    local myPos = myHrp.Position
    local myVel = myHrp.AssemblyLinearVelocity or Vector3.zero
    local myFlatVel = Vector3.new(myVel.X, 0, myVel.Z)
    local mySpeed = myFlatVel.Magnitude
    local pingSec = AutoParry.GetPingSeconds()
    local rawDirectDist = math.min((kPosVis - myPos).Magnitude, (kPosSrv - myPos).Magnitude)

    local diffDirect = Vector3.new(myPos.X - kPosVis.X, 0, myPos.Z - kPosVis.Z)
    local toMeDirect = diffDirect.Magnitude > 0.001 and diffDirect.Unit or primaryLook
    local mySpeedTowardNow = math.max(-myFlatVel:Dot(toMeDirect), 0)

    local trailTarget, peakToward = AutoParry.GetMyLaggedTrailPos(myHrp, kPosSrv)

    local myLookRaw = myHrp.CFrame.LookVector
    local myLookFlat = Vector3.new(myLookRaw.X, 0, myLookRaw.Z)
    local myLookUnit = myLookFlat.Magnitude > 0.01 and myLookFlat.Unit or toMeDirect
    local isMoonwalking = (mySpeed >= 3.0 and (myFlatVel.Unit:Dot(myLookUnit) < -0.10 or mySpeedTowardNow >= 2.5)) or (peakToward >= 3.5)

    local isFlickingTowardMe, camVel, hrpVel, dotVel = AutoParry.UpdateKillerAngularState(kChar, kHrp, toMeDirect)
    local activeAngVel = (math.abs(camVel) >= math.abs(hrpVel)) and camVel or hrpVel

    local lookVectors = { primaryLook }
    if hrpUnit ~= primaryLook and (not rawCamLook or rawCamLook:Dot(hrpUnit) >= 0.65) then
        lookVectors[#lookVectors + 1] = hrpUnit
    end

    local candidates = { myPos }
    if (trailTarget - myPos).Magnitude > 0.05 then
        candidates[#candidates + 1] = trailTarget
        local midTarget = (myPos + trailTarget) * 0.5
        if (midTarget - myPos).Magnitude > 0.05 then
            candidates[#candidates + 1] = midTarget
        end
    end

    local isZigZagOrSpin = false
    if rawDirectDist <= 7.8 and diffDirect.Magnitude > 0.1 then
        if isMoonwalking then
            isZigZagOrSpin = true
        elseif mySpeed >= 4.2 then
            local radialUnit = diffDirect.Unit
            local perpUnit = Vector3.new(-radialUnit.Z, 0, radialUnit.X)
            local orbitSpeed = math.abs(myFlatVel:Dot(perpUnit))
            if orbitSpeed >= 3.8 then
                isZigZagOrSpin = true
            end
        end
    end

    local minAllowedDist = math.max(0, rawDirectDist - 1.35)
    local minCapsuleDist = math.max(minAllowedDist, math.min((kPosVis - trailTarget).Magnitude, (kPosSrv - trailTarget).Magnitude))

    local minDotClose = isZigZagOrSpin and 0.24 or math.cos(math.rad(55))
    local minDotMid = isZigZagOrSpin and 0.36 or math.cos(math.rad(48))

    local hitConfirmed = false
    local isPanSweepHit = false
    local bestAimDot = -1.0
    local kOrigins = { kPosVis }
    if (kPosSrv - kPosVis).Magnitude > 0.10 then
        kOrigins[#kOrigins + 1] = kPosSrv
        kOrigins[#kOrigins + 1] = (kPosVis + kPosSrv) * 0.5
    end

    for cIdx = 1, #candidates do
        local P = candidates[cIdx]
        for oIdx = 1, #kOrigins do
            local kP = kOrigins[oIdx]
            local df = Vector3.new(P.X - kP.X, 0, P.Z - kP.Z)
            local d = df.Magnitude
            if d > 0.05 then
                local u = df.Unit
                for lIdx = 1, #lookVectors do
                    local L = lookVectors[lIdx]
                    local dot = L:Dot(u)
                    if dot > bestAimDot then
                        bestAimDot = dot
                    end
                    local fwd = df:Dot(L)
                    local side = (df - (L * fwd)).Magnitude

                    -- 1) Anti-Bait Flick-Away Rejection (only at range d > 5.2 and NOT when juking/moonwalking)
                    local isFlickingAway = false
                    if not isZigZagOrSpin and d > 5.2 and math.abs(activeAngVel) >= 2.6 and dotVel <= -1.1 then
                        local baseAng = math.atan2(L.X, L.Z)
                        local stepAng = baseAng + (activeAngVel * 0.05)
                        local stepL = Vector3.new(math.sin(stepAng), 0, math.cos(stepAng))
                        local stepDot = stepL:Dot(u)
                        if (stepDot < dot - 0.08) and stepDot < 0.62 then
                            isFlickingAway = true
                        end
                    end

                    if not isFlickingAway then
                        -- 2) Close-Range Melee & Moonwalk/Juke Hitbox:
                        if d <= 6.2 then
                            local closeReqFwd = (d <= 4.0) and -0.20 or 0.05
                            local closeMaxSide = isZigZagOrSpin and 4.30 or 3.75
                            local closeReqDot = isZigZagOrSpin and 0.24 or 0.52
                            if fwd >= closeReqFwd and side <= closeMaxSide and dot >= closeReqDot then
                                hitConfirmed = true
                            end
                        end

                        -- 3) Mid / Long Range Direct Aim Cone (d > 6.2)
                        if not hitConfirmed then
                            local reqFwd = 0.30
                            local maxSide = math.max(3.35, math.min(d * 0.54, 4.50))
                            local reqDot = minDotMid
                            if fwd >= reqFwd and side <= maxSide and dot >= reqDot then
                                hitConfirmed = true
                            end
                        end

                        -- 4) Converging Flick Lead
                        local minFlickStartDot = isZigZagOrSpin and 0.22 or 0.38
                        if not hitConfirmed and isFlickingTowardMe and math.abs(activeAngVel) >= 1.8 and dotVel >= 0.7 and dot >= minFlickStartDot then
                            local maxLead = math.clamp(pingSec * 0.95 + 0.06, 0.08, 0.16)
                            local baseAng = math.atan2(L.X, L.Z)
                            for step = 1, 4 do
                                local dtSweep = (maxLead / 4) * step
                                local sAng = baseAng + (activeAngVel * dtSweep)
                                local sL = Vector3.new(math.sin(sAng), 0, math.cos(sAng))
                                local sDot = sL:Dot(u)
                                local sFwd = df:Dot(sL)
                                local sSide = (df - (sL * sFwd)).Magnitude
                                local flickMaxSide = (d <= 6.2) and 4.30 or 3.90
                                if sFwd >= 0.10 and sSide <= flickMaxSide and sDot >= 0.68 then
                                    hitConfirmed = true
                                    isPanSweepHit = true
                                    if sDot > bestAimDot then
                                        bestAimDot = sDot
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return hitConfirmed, minCapsuleDist, bestAimDot, isPanSweepHit, isZigZagOrSpin
end
function AutoParry.SampleSpinHistory(myHrp, kHrp, _kServerPos, _camLook, _hrpUnit)
    local _hitConfirmed, minCapsuleDist, bestAimDot, _isPanSweepHit, isZigZagOrSpin = AutoParry.EvaluateSweptHitbox(myHrp, kHrp)
    return minCapsuleDist, bestAimDot, isZigZagOrSpin
end
function AutoParry.CheckFacing(kHrp, myHrp)
    if not kHrp or not myHrp then return false end
    if Config.AutoParry_FacingCheck == false then
        return AutoParry.CheckLineOfSight(kHrp, myHrp)
    end
    local hitConfirmed = AutoParry.EvaluateSweptHitbox(myHrp, kHrp)
    if not hitConfirmed then
        return false
    end
    return AutoParry.CheckLineOfSight(kHrp, myHrp)
end
function AutoParry.Trigger(reason, dist, killerChar, delayOverride)
    if not AutoParry.CanParry(killerChar) then return end
    local now = tick()
    AutoParry.LastParryTick = now
    AutoParry.CooldownUntil = now + 60
    SetItemCooldown(LocalPlayer, "Parrying Dagger", 60)
    AutoParry.LastCircleUpdateClock = nil
    if AutoParry.UpdateCircle then
        AutoParry.UpdateCircle()
    end
    MadiumLog("AutoParry", string.format("TRIGGERED! Reason=%s | Dist=%.1fm | Killer=%s", tostring(reason), tonumber(dist) or 0, tostring(killerChar and killerChar.Name or "Unknown")))
    AutoParry.MarkActiveKillerTracksResolved(killerChar)
    local isDelayedExec = false
    local function executeNow()
        if not ScriptRunning then return end
        local char = LocalPlayer.Character
        if not char or not char.Parent or IsPlayerDead(LocalPlayer) then return end
        local now = tick()
        if AutoParry.IsLocalPlayerBusy(char) then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return end
        if killerChar and AutoParry.IsKillerVaulting(killerChar) then return end
        if not AutoParry.IsDaggerEquipped() then
            AutoParry.EquipDagger()
        end
        if killerChar then
            AutoParry.FaceKillerAndSyncServer(killerChar)
        end
        local client = AutoParry.GetNativeClient()
        local rem = AutoParry.FindParryRemote()
        if rem and rem:IsA("RemoteEvent") then
            pcall(function() rem:FireServer(char) end)
        elseif rem and rem:IsA("RemoteFunction") then
            task.spawn(function() pcall(function() rem:InvokeServer(char) end) end)
        end
        if client and client.parryEvent and client.parryEvent ~= rem and client.parryEvent:IsA("RemoteEvent") then
            pcall(function() client.parryEvent:FireServer(char) end)
        end
        local nativeSuccess = AutoParry.ExecuteNativeParry()
        task.spawn(function()
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(0, 0, 1, true, game, 0)
                task.wait(0.015)
                vim:SendMouseButtonEvent(0, 0, 1, false, game, 0)
            end)
            task.delay(0.48, AutoParry.ReleaseParryMovementLock, nil)
        end)
    end
    local rawDelay = (delayOverride ~= nil) and delayOverride or 0.0
    if rawDelay > 0.005 then
        local pingSec = AutoParry.GetPingSeconds()
        local delaySec = math.max(0.0, rawDelay - (pingSec * 1.6))
        if delaySec > 0.005 then
            isDelayedExec = true
            task.delay(delaySec, executeNow)
        else
            executeNow()
        end
    else
        executeNow()
    end
end
function AutoParry.IsTrackAttack(track, killerChar, optionalMeta)
    if not track or not killerChar then return false, "" end
    if track.Looped then return false, "" end
    if (track.WeightCurrent or 1) <= 0.001 and (track.WeightTarget or 1) <= 0.001 then return false, "" end
    local p = Players:GetPlayerFromCharacter(killerChar)
    if p and p.Team and p.Team.Name == "Survivors" then return false, "" end
    if not AutoParry.IsKillerChar(killerChar) then return false, "" end
    if AutoParry.IsKillerVaulting(killerChar) then return false, "" end
    local anim = track.Animation
    if not anim then return false, "" end
    local meta = optionalMeta or GetTrackMeta(track)
    local aName = meta.anm
    local tName = meta.tnm
    local animId = meta.aid
    if AutoParry.IsIgnoredTrackName(aName, tName) then
        return false, ""
    end
    if animId ~= "" and (meta.isIgnoredExplicit or AutoParry.IgnoredAnimIds[animId]) then
        return false, animId
    end
    if meta.isLungeHold or AutoParry.IsLungeHold(animId, aName, tName) then
        return false, animId
    end
    local skillAllowed = AutoParry.IsTrackAllowedSkill(animId, aName, killerChar, tName, track)
    if skillAllowed ~= nil then
        return skillAllowed, animId ~= "" and animId or aName
    end
    local animateFolder = killerChar:FindFirstChild("Animate")
    if animateFolder and anim:IsDescendantOf(animateFolder) then
        AutoParry.IgnoredAnimIds[animId] = true
        return false, animId
    end
    if animId ~= "" and (meta.isAttackExplicit or AutoParry.AttackAnimIds[animId]) then
        return true, animId
    end
    if ((aName:find("attack") or aName:find("swing") or aName:find("slash")
       or tName:find("attack") or tName:find("swing") or tName:find("slash")
       or aName:find("strike") or tName:find("strike")
       or aName:find("smash") or tName:find("smash") or aName:find("throwchain") or tName:find("throwchain")
       or aName:find("stab") or tName:find("stab") or aName:find("cleave") or tName:find("cleave")
       or aName:find("attackfr") or tName:find("attackfr") or aName:find("frenzyattack") or tName:find("frenzyattack") or aName:find("frenzyslash") or tName:find("frenzyslash"))
       and not (aName:find("corrupt") or tName:find("corrupt")
       or aName:find("hold") or tName:find("hold")
       or aName:find("end") or tName:find("end")
       or aName:find("fatigue") or tName:find("fatigue")
       or aName:find("hurt") or tName:find("hurt")
       or aName:find("pain") or tName:find("pain")
       or aName:find("vault") or tName:find("vault")
       or aName:find("window") or tName:find("window")
       or aName:find("break") or tName:find("break")
       or aName:find("kick") or tName:find("kick")
       or aName:find("stun") or tName:find("stun")
       or aName:find("wipe") or tName:find("wipe")
       or aName:find("idle") or tName:find("idle")
       or aName:find("walk") or tName:find("walk")
       or aName:find("run") or tName:find("run")
       or aName:find("slide") or tName:find("slide")
       or aName:find("pickup") or tName:find("pickup")
       or aName:find("carry") or tName:find("carry"))) then
        return true, animId ~= "" and animId or aName
    end
    local prio = track.Priority
    local len = track.Length or 0
    if (prio == Enum.AnimationPriority.Action or prio == Enum.AnimationPriority.Action2 or prio == Enum.AnimationPriority.Action3 or prio == Enum.AnimationPriority.Action4)
       and len >= 0.35 and len <= 2.45 then
