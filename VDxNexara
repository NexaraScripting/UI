    local now = tick()
    if (now - (AutoParry.LastRealVaultTick[killerChar] or 0)) < 0.45 then
        return true
    end
    if killerChar:GetAttribute("isvaulting") == true or killerChar:GetAttribute("isVaulting") == true or killerChar:GetAttribute("IsVaulting") == true
       or killerChar:GetAttribute("vaultending") == true or killerChar:GetAttribute("VaultReason") ~= nil then
        AutoParry.LastRealVaultTick[killerChar] = now
        return true
    end
    local actState = tostring(killerChar:GetAttribute("ActionState") or ""):lower()
    if actState == "vault" or actState:find("vault") then
        AutoParry.LastRealVaultTick[killerChar] = now
        return true
    end
    local checkInt = killerChar:FindFirstChild("CheckInterractable")
    if checkInt then
        if checkInt:GetAttribute("isvaulting") == true or checkInt:GetAttribute("isVaulting") == true or checkInt:GetAttribute("IsVaulting") == true
           or checkInt:GetAttribute("InteractionKind") == "vault" then
            AutoParry.LastRealVaultTick[killerChar] = now
            return true
        end
    end
    local hum = killerChar:FindFirstChildOfClass("Humanoid")
