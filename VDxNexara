end
function AutoParry.GetStandingBladeReach(killerChar)
    local standing = 5.50
    if killerChar then
        local nm = tostring(killerChar.Name):lower()
        local morph = tostring(killerChar:GetAttribute("MorphedKiller") or killerChar:GetAttribute("SelectedKiller") or ""):lower()
        local stage = tonumber(killerChar:GetAttribute("Stage")) or 1
        if morph == "stalker" or nm:find("stalker") or killerChar:GetAttribute("Stalker") == true or killerChar:GetAttribute("Stage") ~= nil then
            if stage == 1 then
                standing = 5.25
            elseif stage == 2 then
                standing = 5.50
            else
                standing = 5.85
            end
        elseif AutoParry.IsAbysswalker(killerChar) or nm:find("abyss") or morph:find("abyss") or killerChar:FindFirstChild("Greatsword") or killerChar:FindFirstChild("Blade") then
            standing = 5.65
        elseif morph == "butcher" or nm:find("butcher") or killerChar:GetAttribute("Butcher") == true then
            standing = 5.55
        elseif morph == "slasher" or nm:find("slasher") or killerChar:GetAttribute("Slasher") == true or killerChar:FindFirstChild("PursuitPalletPredict") then
            standing = (killerChar:GetAttribute("Pursuit") == true) and 5.75 or 5.45
        elseif morph == "veil" or nm:find("veil") or killerChar:GetAttribute("Veil") == true or killerChar:FindFirstChild("spearmanager") then
            standing = (killerChar:GetAttribute("spearmode") == true) and 5.90 or 5.45
        elseif morph == "hidden" or nm:find("hidden") or killerChar:GetAttribute("Hidden") == true then
            standing = 5.45
        elseif morph == "killer" or nm:find("killer") or killerChar:GetAttribute("Frenzy") ~= nil then
            standing = (killerChar:GetAttribute("Frenzy") == true) and 5.70 or 5.45
        elseif morph == "masked" or nm:find("masked") or killerChar:GetAttribute("Mask") ~= nil then
            local mask = tostring(killerChar:GetAttribute("Mask") or ""):lower()
            standing = (mask == "alex" or mask == "duck" or mask == "swan" or killerChar:FindFirstChild("Chainsaw")) and 5.85 or 5.45
        elseif morph == "cure" or nm:find("cure") or killerChar:GetAttribute("Cure") == true or killerChar:FindFirstChild("Curetool") then
            standing = 5.45
        end
    end
    return standing
end
function AutoParry.GetEffectiveMaxRange(killerChar)
    local cfgRadius = tonumber(Config.AutoParry_Radius) or 11.5
    if AutoParry.IsDarkSeveranceActive(killerChar) or AutoParry.IsShadowLeapActive(killerChar) or AutoParry.IsChainsawDashActive(killerChar) then
        return cfgRadius + 1.2
    elseif AutoParry.IsKillerLunging(killerChar) then
        return cfgRadius + 0.5
    end
    return cfgRadius
end
function AutoParry.ComputePredictedDistance(kHrp, myHrp)
    local kChar = kHrp.Parent
    local snap = AutoParry.GetKillerServerState(kChar, kHrp)
    local pingSec = AutoParry.GetPingSeconds()

    local myVel = myHrp.AssemblyLinearVelocity or Vector3.zero
    local myFlatVel = Vector3.new(myVel.X, 0, myVel.Z)
    local kVelRaw = (snap and snap.vel and snap.vel.Magnitude > 1.0) and snap.vel or (kHrp.AssemblyLinearVelocity or Vector3.zero)
    local kFlatVel = Vector3.new(kVelRaw.X, 0, kVelRaw.Z)

    local visualDist = (kHrp.Position - myHrp.Position).Magnitude
    local kServerPos = AutoParry.GetKillerServerPos(kChar, kHrp)
    local trailPos, peakToward = AutoParry.GetMyLaggedTrailPos(myHrp, kServerPos)

    local diffDirect = Vector3.new(myHrp.Position.X - kServerPos.X, 0, myHrp.Position.Z - kServerPos.Z)
    local toMe = diffDirect.Magnitude > 0.001 and diffDirect.Unit or Vector3.new(0, 0, -1)
    local mySpeedAlongToMe = myFlatVel:Dot(toMe)
    local mySpeedTowardKiller = math.max(-mySpeedAlongToMe, 0)
    local effectiveToward = math.max(mySpeedTowardKiller, peakToward * 0.85)
    local mySpeedAway = math.max(mySpeedAlongToMe, 0)

    local isLunging = AutoParry.IsKillerLunging(kChar)
    local srvDist = (kServerPos - myHrp.Position).Magnitude
    local trailDist = math.min((kHrp.Position - trailPos).Magnitude, (kServerPos - trailPos).Magnitude)
    local curDist = math.max(visualDist - 1.2, math.min(visualDist, srvDist, trailDist))

    local rawKillerToward = kFlatVel:Dot(toMe)
    local killerSpeedTowardMe = AutoParry.UpdateKillerPeakSpeed(kChar, rawKillerToward)
    if isLunging and killerSpeedTowardMe < 14.0 then
        killerSpeedTowardMe = math.max(killerSpeedTowardMe, 14.0)
    end
    local awayFactor = isLunging and 0.50 or (effectiveToward >= 2.5 and 0.40 or 0.75)
    local closingSpeed = killerSpeedTowardMe - (mySpeedAway * awayFactor) + (effectiveToward * 1.05)
    local hitLeadTime = math.clamp(pingSec * 1.25 + (isLunging and 0.16 or 0.12), 0.12, 0.24)
    local predDist = math.max(curDist - (closingSpeed * hitLeadTime), 0)
    return curDist, closingSpeed, predDist, killerSpeedTowardMe, effectiveToward, visualDist, srvDist, mySpeedAway
end
function AutoParry.WillAttackConnect(kHrp, myHrp, maxRange)
    local kChar = kHrp and kHrp.Parent
    local cfgRadius = maxRange or (tonumber(Config.AutoParry_Radius) or 11.5)
    local curDist, closingSpeed, predDist, killerSpeedTowardMe, effectiveToward, visualDist, _srvDist, mySpeedAway = AutoParry.ComputePredictedDistance(kHrp, myHrp)

    -- 1. Hard Range Filter: Killer must be within the configured parry circle radius
    if curDist > cfgRadius then
        return false, false, curDist, closingSpeed, predDist
    end

    if not AutoParry.IsClosestTargetToKiller(kHrp, myHrp, curDist) and curDist > 4.5 then
        return false, false, curDist, closingSpeed, predDist
    end

    local standingReach = AutoParry.GetStandingBladeReach(kChar)
    local isDashSkill = AutoParry.IsDarkSeveranceActive(kChar) or AutoParry.IsShadowLeapActive(kChar) or AutoParry.IsChainsawDashActive(kChar)
    local isLunging = AutoParry.IsKillerLunging(kChar)

    -- If survivor is sprinting away faster than killer and already outside weapon reach, cannot connect
    if not isDashSkill and not isLunging and effectiveToward < 2.0 and mySpeedAway > (killerSpeedTowardMe + 2.5) and curDist > (standingReach + 1.2) and visualDist > (standingReach + 1.5) then
        return false, false, curDist, closingSpeed, predDist
    end

    local hitConfirmed, minCapsuleDist, bestAimDot, isPanSweepHit, isZigZagOrSpin = AutoParry.EvaluateSweptHitbox(myHrp, kHrp)
    if Config.AutoParry_FacingCheck ~= false and not hitConfirmed then
        return false, false, curDist, closingSpeed, predDist
    end

    local pingSec = AutoParry.GetPingSeconds()
    local pingLeadStuds = (Config.AutoParry_PingComp ~= false) and math.clamp(pingSec * 16.0, 0.3, 2.5) or 0.2

    -- 2. Immediate Standing Strike Impact Zone:
    local directStrikeReach = standingReach + 0.35 + pingLeadStuds
    if curDist <= directStrikeReach then
        return true, true, curDist, closingSpeed, predDist
    end

    -- 3. Dash Skill Reach (Chainsaw Dash, Shadow Leap, Dark Severance):
    if isDashSkill then
        local dashReach = standingReach + 3.0 + pingLeadStuds
        local timeToImpact = (curDist - standingReach) / math.max(closingSpeed, killerSpeedTowardMe, 15.0)
        local readyForImpact = (curDist <= dashReach) or (timeToImpact <= (0.12 + pingSec))
        return true, readyForImpact, curDist, closingSpeed, predDist
    end

    -- 4. Committed Lunge / Closing Melee Strike:
    local isRushingTowardMe = (closingSpeed >= 3.5 or killerSpeedTowardMe >= 3.5 or isLunging)
    if isRushingTowardMe then
        local maxLungeReach = standingReach + 1.85 + pingLeadStuds
        local timeToImpact = (curDist - standingReach) / math.max(closingSpeed, killerSpeedTowardMe, 6.0)
        local readyForImpact = (curDist <= maxLungeReach) or (timeToImpact <= (0.10 + (pingSec * 0.9)))
        return true, readyForImpact, curDist, closingSpeed, predDist
    end

    -- 5. Outside actual reaching distance and not rushing forward:
    return false, false, curDist, closingSpeed, predDist
end
function AutoParry.HookAnimator(animator, killerChar)
    if not animator or not killerChar then return end
    local conn = animator.AnimationPlayed:Connect(function(track)
        local animObj = track.Animation
        local animId = tostring(animObj and animObj.AnimationId):match("%d+") or "none"
        local animName = tostring(animObj and animObj.Name)
        local trackName = tostring(track.Name)
        local prio = tostring(track.Priority):gsub("Enum.AnimationPriority.", "")
        AutoParry.ResolvedTracks[track] = nil
        local isAttack = AutoParry.IsTrackAttack(track, killerChar)
        MadiumLog("KILLER-ANIM", string.format("ID: %s | Prio: %s | Len: %.2fs | Spd: %.2f | IsAtk: %s | Name: %s/%s", animId, prio, track.Length or 0, track.Speed or 0, tostring(isAttack), animName, trackName))
        local isLungeHold = AutoParry.IsLungeHold(animId, animName:lower(), trackName:lower())
        if isLungeHold then
            AutoParry.RecordKillerLunge(killerChar, track)
            MadiumLog("LUNGE-HOLD", string.format("ID: %s | Len: %.2fs (Lunge windup tracked - feint protected)", animId, track.Length or 0))
            local stopConn
            stopConn = track.Stopped:Connect(function()
                AutoParry.KillerLungeUntil[killerChar] = tick() + 0.85
                AutoParry.ResolvedTracks[track] = nil
                AutoParry.TrackStartDot[track] = nil
                if stopConn then pcall(function() stopConn:Disconnect() end) end
            end)
            return -- NEVER trigger parry on windup / lunge hold!
        end
        if not Config.AutoParry_Enabled then return end
        if not isAttack then return end
        if AutoParry.IsKillerVaulting(killerChar) then return end
        local meta = GetTrackMeta(track)
        local rawMinPos = meta.minPos or 0.0
        local maxTimePos = meta.maxPos or 0.68
        local maxDuration = maxTimePos + 0.05
        local maxRatio = meta.maxRatio or 0.72
        if track.TimePosition > maxTimePos or (track.Length > 0 and (track.TimePosition / track.Length) > maxRatio) then
            AutoParry.ResolvedTracks[track] = true
            return
        end
        AutoParry.TrackStartTick[track] = tick()
        AutoParry.TrackStartDot[track] = nil
        AutoParry.ResolvedTracks[track] = nil
        local stopConn
        stopConn = track.Stopped:Connect(function()
            AutoParry.ResolvedTracks[track] = nil
            AutoParry.TrackStartDot[track] = nil
            if stopConn then pcall(function() stopConn:Disconnect() end) end
        end)
        local function evaluateTrackAndParry(tr)
            if AutoParry.IsLocalPlayerBusy() then
                AutoParry.ResolvedTracks[tr] = true
                return false
            end
            if not AutoParry.CanParry(killerChar) then return false end
            if rawMinPos > 0 then
                local minReady = math.max(0.08, rawMinPos - (AutoParry.GetPingSeconds() * 1.15))
                local elapsed = tick() - (AutoParry.TrackStartTick[tr] or tick())
                if tr.TimePosition < minReady and elapsed < minReady then
                    return false
                end
            end
            local curMyChar = LocalPlayer.Character
            local curMyHrp = curMyChar and curMyChar:FindFirstChild("HumanoidRootPart")
            local curKHrp = killerChar:FindFirstChild("HumanoidRootPart")
            if not curMyHrp or not curKHrp then return false end
            if not AutoParry.CanTrackStillHitUs(tr, meta, killerChar, curKHrp, curMyHrp) then
                return false
            end
            local maxRange = AutoParry.GetEffectiveMaxRange(killerChar)
            local connNow, trigNow, dNow = AutoParry.WillAttackConnect(curKHrp, curMyHrp, maxRange)
            if connNow and trigNow then
                if AutoParry.CheckLineOfSight(curKHrp, curMyHrp) then
                    AutoParry.ResolvedTracks[tr] = true
                    AutoParry.Trigger("Anim: " .. animId, dNow, killerChar, 0.0)
                    return true
                end
            end
            return false
        end
        if evaluateTrackAndParry(track) then return end
        task.spawn(function()
            local startT = AutoParry.TrackStartTick[track] or tick()
            while ScriptRunning and (tick() - startT <= maxDuration) do
                if not track.IsPlaying or track.TimePosition > maxTimePos or (track.Length > 0 and (track.TimePosition / track.Length) > maxRatio) or AutoParry.ResolvedTracks[track] or AutoParry.IsKillerVaulting(killerChar) then break end
                if evaluateTrackAndParry(track) then break end
                RunService.Heartbeat:Wait()
            end
            AutoParry.ResolvedTracks[track] = true
        end)
    end)
    if AutoParry.CharacterConnections[killerChar] then
        table.insert(AutoParry.CharacterConnections[killerChar], conn)
    else
        table.insert(ScriptConnections, conn)
    end
end
function AutoParry.HookKillerWeapon(weapon, killerChar)
    if not weapon or weapon:GetAttribute("Nexara_ParryHooked") then return end
