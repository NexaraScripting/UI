function AutoParry.GetPingSeconds()
    local now = os.clock()
    if AutoParry.CachedPingSec and AutoParry.LastPingFetchClock and (now - AutoParry.LastPingFetchClock) < 0.08 then
        return AutoParry.CachedPingSec
    end
    AutoParry.LastPingFetchClock = now
    local pingSec = 0.06
    pcall(function()
        local p = LocalPlayer:GetNetworkPing()
        if type(p) == "number" and p > 0 then
            pingSec = math.clamp(p, 0.015, 0.45)
        else
            local pingMs = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
            if type(pingMs) == "number" and pingMs > 0 then
                pingSec = math.clamp(pingMs / 1000, 0.015, 0.45)
            end
        end
    end)
    if AutoParry.LiveSnapshotLag and (tick() - (AutoParry.LastSnapshotTick or 0)) < 1.0 then
        pingSec = math.max(pingSec, AutoParry.LiveSnapshotLag)
    end
    local prevRaw = AutoParry.LastRawPingSec or pingSec
    local instJitter = math.abs(pingSec - prevRaw)
    AutoParry.LastRawPingSec = pingSec
    local curJitter = AutoParry.PingJitterSec or 0
    if instJitter > curJitter then
        curJitter = instJitter
    else
        curJitter = curJitter * 0.88
    end
    AutoParry.PingJitterSec = math.clamp(curJitter, 0, 0.18)
    local effectivePing = math.clamp(pingSec + (AutoParry.PingJitterSec * 1.35), 0.02, 0.45)
    AutoParry.CachedPingSec = effectivePing
    return effectivePing
end
