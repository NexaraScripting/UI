AutoParry.KillerLungeUntil = setmetatable({}, { __mode = "k" })
AutoParry.KillerLungeStartTick = setmetatable({}, { __mode = "k" })
AutoParry.KillerPeakSpeed = setmetatable({}, { __mode = "k" })
function AutoParry.RecordKillerLunge(killerChar, track)
    if not killerChar then return end
    local now = tick()
    if (now - (AutoParry.KillerLungeUntil[killerChar] or 0)) > 0.15 then
        AutoParry.KillerLungeStartTick[killerChar] = now - (track and track.TimePosition or 0)
    end
    AutoParry.KillerLungeUntil[killerChar] = now + 0.85
end
function AutoParry.IsKillerLunging(killerChar)
    if not killerChar then return false end
    local now = tick()
    if (AutoParry.KillerLungeUntil[killerChar] or 0) > now then
        return true
    end
    if killerChar:GetAttribute("Pursuit") == true or killerChar:GetAttribute("FrenzyLungePending") == true
       or killerChar:GetAttribute("isLunging") == true or killerChar:GetAttribute("isAttacking") == true
       or killerChar:GetAttribute("holdingAttack") == true then
        AutoParry.KillerLungeUntil[killerChar] = now + 0.65
        return true
    end
    local hum = killerChar:FindFirstChildOfClass("Humanoid")
    if hum and hum.WalkSpeed >= 19.5 then
        AutoParry.KillerLungeUntil[killerChar] = now + 0.55
        return true
    end
    local hrp = killerChar:FindFirstChild("HumanoidRootPart")
    if hrp then
        local v = hrp.AssemblyLinearVelocity or Vector3.zero
        if Vector3.new(v.X, 0, v.Z).Magnitude >= 18.5 then
            AutoParry.KillerLungeUntil[killerChar] = now + 0.50
            return true
        end
    end
    return false
end
function AutoParry.UpdateKillerPeakSpeed(killerChar, speedTowardMe)
    if not killerChar then return speedTowardMe end
    local now = tick()
    local prev = AutoParry.KillerPeakSpeed[killerChar]
    if not prev or speedTowardMe >= (prev.speed or 0) or (now - (prev.time or 0)) > 0.26 then
        AutoParry.KillerPeakSpeed[killerChar] = { speed = speedTowardMe, time = now }
        return speedTowardMe
    end
    return math.max(speedTowardMe, prev.speed * 0.90)
end
function AutoParry.CanParry(killerChar)
    if not Config.AutoParry_Enabled then return false end
    if IsKiller(LocalPlayer) then return false end
    if killerChar then
        local p = Players:GetPlayerFromCharacter(killerChar)
        if p and p.Team and p.Team.Name == "Survivors" then return false end
        if not AutoParry.IsKillerChar(killerChar) then return false end
    end
    local char = LocalPlayer.Character
    if not char or not char.Parent then return false end
    if IsPlayerDead(LocalPlayer) then return false end
    if not AutoParry.HasDagger() then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local now = tick()
    local client = AutoParry.GetNativeClient()
    if client and not client.isParryOnCooldown and not client.isParryLocked and not client.isParryResolving and char:GetAttribute("ParrySpent") ~= true and (now - (AutoParry.LastParryTick or 0)) > 1.2 then
        if (AutoParry.CooldownUntil or 0) > now or GetItemCooldown(LocalPlayer, "Parrying Dagger") > 0 then
            AutoParry.CooldownUntil = 0
            SetItemCooldown(LocalPlayer, "Parrying Dagger", 0)
        end
    end
    if (AutoParry.CooldownUntil or 0) > now then return false end
    if GetItemCooldown(LocalPlayer, "Parrying Dagger") > 0 then return false end
    if client then
        if client.isParryOnCooldown or client.isParryLocked or client.isSilenced then
            return false
        end
        if client.isParryResolving then
            if (now - (AutoParry.LastNativeParryTick or 0)) > 3.0 then
                client.isParryResolving = false
            else
                return false
            end
        end
    end
    if (now - (AutoParry.LastDamagedTick or 0)) < 1.50 then return false end
    if (now - (AutoParry.LastLocalVaultTick or 0)) < 1.15 then return false end
    if (now - (AutoParry.LastBusyTick or 0)) < 0.35 then return false end
    if killerChar and (now - (AutoParry.KillerLastVaultEndTick[killerChar] or 0)) < 0.20 then return false end
    if (now - AutoParry.LastParryTick) < 0.50 then return false end
    if AutoParry.IsLocalPlayerBusy(char) then return false end
    if killerChar and AutoParry.IsKillerVaulting(killerChar) then
        return false
    end
    if killerChar then
        if killerChar:GetAttribute("FrenzyEnding") == true
           or killerChar:GetAttribute("FrenzyCancelAttackLocked") == true
           or killerChar:GetAttribute("IsStunned") == true
           or killerChar:GetAttribute("Stunned") == true
           or killerChar:GetAttribute("Fatigue") == true
           or killerChar:GetAttribute("isFatigued") == true
           or killerChar:GetAttribute("isBreaking") == true
           or killerChar:GetAttribute("isBreakingPallet") == true
           or killerChar:GetAttribute("Immobile") == true then
            return false
        end
    end
    if not Config.AutoParry_Skill_Frenzy then
        if killerChar then
            if killerChar:GetAttribute("Frenzy") == true then return false end
            local kp = Players:GetPlayerFromCharacter(killerChar)
            if kp and kp:GetAttribute("Frenzy") == true then return false end
        else
            local kChars = AutoParry.GetKillerCharacters()
            for _, kc in ipairs(kChars) do
                if kc:GetAttribute("Frenzy") == true then return false end
                local kp = Players:GetPlayerFromCharacter(kc)
                if kp and kp:GetAttribute("Frenzy") == true then return false end
            end
        end
    end
    if Config.AutoParry_Skill_DarkSeverance == false then
        if killerChar then
            if AutoParry.IsDarkSeveranceActive(killerChar) then return false end
        else
            local kChars = AutoParry.GetKillerCharacters()
            for _, kc in ipairs(kChars) do
                if AutoParry.IsDarkSeveranceActive(kc) then return false end
            end
        end
    end
    if Config.AutoParry_Skill_ShadowLeap == false then
        if killerChar then
            if AutoParry.IsShadowLeapActive(killerChar) then return false end
        else
            local kChars = AutoParry.GetKillerCharacters()
            for _, kc in ipairs(kChars) do
                if AutoParry.IsShadowLeapActive(kc) then return false end
            end
        end
    end
    if Config.AutoParry_Skill_ChainsawDash == false then
        if killerChar then
            if AutoParry.IsChainsawDashActive(killerChar) then return false end
        else
            local kChars = AutoParry.GetKillerCharacters()
            for _, kc in ipairs(kChars) do
                if AutoParry.IsChainsawDashActive(kc) then return false end
            end
        end
    end
    return true
end
function AutoParry.IsIgnoredTrackName(aName, tName)
