           and killerChar:GetAttribute("Fatigue") ~= true and killerChar:GetAttribute("isFatigued") ~= true
           and killerChar:GetAttribute("isVaulting") ~= true and killerChar:GetAttribute("Immobile") ~= true then
            return true, animId ~= "" and animId or (aName ~= "" and aName or "ActionSwing")
        end
