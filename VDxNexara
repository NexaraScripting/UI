    TofCombat.HrpHistory = TofCombat.HrpHistory or {}
    TofCombat.ServerReplicationDelay = TofCombat.ServerReplicationDelay or 0.045
    function TofCombat.RecordHrpHistory()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local now = os.clock()
        local hist = TofCombat.HrpHistory
        table.insert(hist, { t = now, cf = hrp.CFrame })
        if #hist > 65 then
            local cutoff = now - 0.75
            local keepIdx = 1
            for i = 1, #hist do
                if hist[i].t >= cutoff then
                    keepIdx = i
                    break
                end
            end
            if keepIdx > 1 then
                local newHist = {}
                for i = keepIdx, #hist do
                    newHist[#newHist + 1] = hist[i]
                end
                TofCombat.HrpHistory = newHist
            end
        end
    end
    function TofCombat.GetHistoricalHrpCFrame(targetClock)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local fallbackCF = hrp and hrp.CFrame or CFrame.identity
        local hist = TofCombat.HrpHistory
        if not hist or #hist == 0 then return fallbackCF end
        for i = #hist, 1, -1 do
            local e = hist[i]
            if e.t <= targetClock then
                local nextE = hist[i + 1]
                if nextE and (nextE.t - e.t) > 0.0001 then
                    local alpha = math.clamp((targetClock - e.t) / (nextE.t - e.t), 0, 1)
                    return e.cf:Lerp(nextE.cf, alpha)
                end
                return e.cf
            end
        end
        return hist[1].cf
    end
    function TofCombat.GetShootOrigin()
        local char = LocalPlayer.Character
        if not char then
            local cam = Workspace.CurrentCamera
            return cam and cam.CFrame.Position or Vector3.zero
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local startOrigin = hrp.Position + Vector3.new(0, 1.373, 0)
            local targetOrigin = (hrp.CFrame * CFrame.new(0.7, 1.373, -2.5)).Position
            local delta = targetOrigin - startOrigin
            if delta.Magnitude >= 0.001 then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = { char }
                rp.IgnoreWater = true
                local hit = Workspace:Blockcast(CFrame.new(startOrigin, targetOrigin), Vector3.new(0.5, 0.5, 0.5), delta, rp)
                if hit then
                    return hit.Position - delta.Unit * 0.5
                end
            end
            return targetOrigin
        end
        local head = char:FindFirstChild("Head")
        if head then return head.Position end
        local cam = Workspace.CurrentCamera
        return cam and cam.CFrame.Position or Vector3.zero
    end
    function TofCombat.GetGunMuzzlePosition()
        local char = LocalPlayer.Character
        local tof = char and char:FindFirstChild("Twist of Fate")
        if tof then
            local barrel = tof:FindFirstChild("barrel")
            if barrel then
                local eff = barrel:FindFirstChild("Effect")
                if eff and eff:IsA("Attachment") then
                    return eff.WorldPosition, eff
                elseif barrel:IsA("BasePart") then
                    return barrel.Position, barrel
                end
            end
            local smoke = tof:FindFirstChild("SmokePart")
            if smoke and smoke:IsA("BasePart") then
                return smoke.Position, smoke
            end
            local pp = tof:FindFirstChild("Primarypart") or tof.PrimaryPart
            if pp and pp:IsA("BasePart") then
                return pp.Position, pp
            end
        end
        return TofCombat.GetShootOrigin(), nil
    end
    function TofCombat.SpawnLaserTracer(startPos, endPos)
        pcall(function()
            local now = os.clock()
            if TofCombat.LastLaserSpawnClock and (now - TofCombat.LastLaserSpawnClock) < 0.25 then
                return
            end
            TofCombat.LastLaserSpawnClock = now
            for _, d in ipairs(Workspace:GetChildren()) do
                if d.Name == "Nexara_TofLaser" then
                    pcall(function() d:Destroy() end)
                end
            end
            local muzzlePos, muzzleRef = TofCombat.GetGunMuzzlePosition()
            local actualStart = muzzlePos or startPos
            local dist = (endPos - actualStart).Magnitude
            if dist < 0.5 then return end
            local col = Config.Color_Tof_Laser or Color3.fromRGB(255, 60, 60)
            local beamPart = Instance.new("Part")
            beamPart.Name = "Nexara_TofLaser"
            beamPart.Shape = Enum.PartType.Cylinder
            beamPart.Material = Enum.Material.Neon
            beamPart.Color = col
            beamPart.Transparency = 0.02
            beamPart.Anchored = true
            beamPart.CanCollide = false
            beamPart.CanQuery = false
            beamPart.CanTouch = false
            beamPart.CastShadow = false
            beamPart.Size = Vector3.new(dist, 0.11, 0.11)
            beamPart.CFrame = CFrame.lookAt((actualStart + endPos) / 2, endPos) * CFrame.Angles(0, math.rad(90), 0)
            beamPart.Parent = Workspace
            local dur = Config.Tof_LaserDuration or 0.6
            task.spawn(function()
                local startT = os.clock()
                while true do
                    local elapsed = os.clock() - startT
                    if elapsed >= dur or not beamPart.Parent then break end
                    if elapsed < 0.12 and muzzleRef and muzzleRef.Parent then
                        local curMuzzle = muzzleRef:IsA("Attachment") and muzzleRef.WorldPosition or muzzleRef.Position
                        local curDist = (endPos - curMuzzle).Magnitude
                        if curDist >= 0.5 then
                            beamPart.Size = Vector3.new(curDist, 0.11, 0.11)
                            beamPart.CFrame = CFrame.lookAt((curMuzzle + endPos) / 2, endPos) * CFrame.Angles(0, math.rad(90), 0)
                        end
                    end
                    local fade = elapsed / dur
                    beamPart.Transparency = 0.02 + (0.98 * (fade * fade))
                    task.wait()
                end
                pcall(function() beamPart:Destroy() end)
            end)
        end)
    end
    function TofCombat.ConfirmBulletHit(u3, u4)
        if IsKiller(LocalPlayer) then return false end
        if typeof(u4) ~= "Vector3" then return false end
        local now = os.clock()
        if (now - (TofCombat.LastConfirmedHitClock or 0)) < 0.22 then
            return false
        end
        local candidateChars = {}
        local seenChar = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not IsPlayerDead(p) then
                if IsKiller(p) or (AutoParry and AutoParry.IsKillerChar and AutoParry.IsKillerChar(p.Character)) then
                    seenChar[p.Character] = true
                    table.insert(candidateChars, p.Character)
                end
            end
        end
        if AutoParry and AutoParry.GetKillerCharacters then
            for _, kc in ipairs(AutoParry.GetKillerCharacters()) do
                if kc and kc.Parent and not seenChar[kc] then
                    seenChar[kc] = true
                    table.insert(candidateChars, kc)
                end
            end
        end
        local hitTarget = false
        local hitPart = nil
        local hitPlayer = nil
        local hitChar = nil
        local seg = (typeof(u3) == "Vector3") and (u4 - u3) or nil
        local segLen = seg and seg.Magnitude or 0
        local segUnit = (segLen > 0.5) and (seg / segLen) or nil
        for _, kChar in ipairs(candidateChars) do
            local kHrp = kChar:FindFirstChild("HumanoidRootPart")
            local kTorso = kChar:FindFirstChild("Torso") or kChar:FindFirstChild("UpperTorso") or kHrp
            if kHrp then
                local snap = (AutoParry and AutoParry.GetKillerServerState) and AutoParry.GetKillerServerState(kChar, kHrp) or nil
                local snapPos = (snap and snap.pos and (tick() - (snap.time or 0)) <= 0.30) and snap.pos or nil
                local dHrp = (u4 - kHrp.Position).Magnitude
                local dTorso = kTorso and (u4 - kTorso.Position).Magnitude or dHrp
                local dSnap = snapPos and (u4 - snapPos).Magnitude or 999
                local minEndDist = math.min(dHrp, dTorso, dSnap)
                local matched = (minEndDist <= 12.0)
                if not matched and segUnit and segLen < 990 then
                    for _, refPos in ipairs({ snapPos, kHrp.Position, kTorso and kTorso.Position }) do
                        if refPos then
                            local toRef = refPos - u3
                            local proj = toRef:Dot(segUnit)
                            if proj >= -2.0 and math.abs(proj - segLen) <= 15.0 then
                                local closestPt = u3 + segUnit * math.clamp(proj, 0, segLen)
                                if (refPos - closestPt).Magnitude <= 6.5 then
                                    matched = true
                                    break
                                end
                            end
                        end
                    end
                end
                if matched then
                    hitTarget = true
                    hitChar = kChar
                    hitPlayer = Players:GetPlayerFromCharacter(kChar)
                    hitPart = kTorso or kHrp
                    break
                end
            end
        end
        if hitTarget then
            TofCombat.LastConfirmedHitClock = now
            if TofCombat.TriggerHitmarker then
                TofCombat.TriggerHitmarker(false, u4, hitPart)
            end
            if TofCombat.LogHit then
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local dist = (myHrp and (u4 - myHrp.Position).Magnitude) or 0
                TofCombat.LogHit(hitPlayer, hitChar, hitPart, dist, false)
            end
            return true
        end
        return false
    end
    function TofCombat.EnsureHooksActive()
        if _G.Nexara_VD_SetNamecallActive then
            pcall(_G.Nexara_VD_SetNamecallActive, true)
        end
        if not TofCombat.HookedTwistEffects then
            pcall(function()
                local modFolder = ReplicatedStorage:FindFirstChild("Modules")
                local itemsFolder = modFolder and modFolder:FindFirstChild("Items")
                local tofFolder = itemsFolder and itemsFolder:FindFirstChild("TwistOfFate")
                local effModScript = tofFolder and tofFolder:FindFirstChild("TwistoffateEffects")
                if effModScript and effModScript:IsA("ModuleScript") then
                    local effMod = require(effModScript)
                    if type(effMod) == "table" and type(effMod.aimDirection) == "function" then
                        if not effMod._nexaraOrigAimDirection then
                            effMod._nexaraOrigAimDirection = effMod.aimDirection
                        end
                        local origAimDir = effMod._nexaraOrigAimDirection
                        effMod.aimDirection = function(argChar, argCamCF, ...)
                            local fallbackDir = origAimDir(argChar, argCamCF, ...)
                            if not ScriptRunning or not TofCombat.IsTwistOfFateActive() then
                                return fallbackDir
                            end
                            local useSilent = (Config.Tof_SilentAim == true)
                            local useAimbot = (not useSilent) and (Config.Tof_Aimbot == true)
                            if useSilent or useAimbot then
                                local _, targetPart = TofCombat.GetTarget(useSilent and math.huge or Config.Tof_FOV, useSilent)
                                if targetPart and targetPart.Parent then
                                    local shootOrigin = TofCombat.GetShootOrigin()
                                    local hitPos = TofCombat.GetOptimalHitPosition(targetPart.Parent, targetPart, shootOrigin)
                                    local delta = hitPos - shootOrigin
                                    if delta.Magnitude > 0.05 then
                                        local dir = delta.Unit
                                        TofCombat.LastSilentAimDir = dir
                                        TofCombat.LastSilentAimHitPos = hitPos
                                        TofCombat.LastSilentAimOrigin = shootOrigin
                                        TofCombat.LastSilentAimClock = os.clock()
                                        TofCombat.PendingLaserHitPos = hitPos
                                        TofCombat.PendingLaserOrigin = shootOrigin
                                        TofCombat.PendingLaserTick = tick()
                                        return dir
                                    end
                                end
                            end
                            return fallbackDir
                        end
                        if type(effMod.own) == "function" then
                            if not effMod._nexaraOrigOwn then
                                effMod._nexaraOrigOwn = effMod.own
                            end
                            local origOwn = effMod._nexaraOrigOwn
                            effMod.own = function(argChar, argTool, argDir, ...)
                                local res = origOwn(argChar, argTool, argDir, ...)
                                if ScriptRunning and argChar == LocalPlayer.Character and typeof(argDir) == "Vector3" and argDir.Magnitude > 0.01 then
                                    local originAtShot = TofCombat.GetShootOrigin()
                                    local dirUnit = argDir.Unit
                                    task.delay(0.11, function()
                                        if not ScriptRunning then return end
                                        if (os.clock() - (TofCombat.LastConfirmedHitClock or 0)) < 0.22 then return end
                                        local exclude = { LocalPlayer.Character, Workspace.CurrentCamera }
                                        for _, p in ipairs(Players:GetPlayers()) do
                                            if p ~= LocalPlayer and p.Character and not IsKiller(p) and not (AutoParry and AutoParry.IsKillerChar and AutoParry.IsKillerChar(p.Character)) then
                                                table.insert(exclude, p.Character)
                                            end
                                        end
                                        local rp = RaycastParams.new()
                                        rp.FilterType = Enum.RaycastFilterType.Exclude
                                        rp.FilterDescendantsInstances = exclude
                                        rp.IgnoreWater = true
                                        local bHit = Workspace:Blockcast(CFrame.new(originAtShot, originAtShot + dirUnit), Vector3.new(0.5, 0.5, 0.5), dirUnit * 1000, rp)
                                        local endPos = bHit and bHit.Position or (originAtShot + dirUnit * 1000)
                                        TofCombat.ConfirmBulletHit(originAtShot, endPos)
                                    end)
                                end
                                return res
                            end
                        end
                        TofCombat.HookedTwistEffects = effMod
                    end
                end
            end)
        end
    end
    function TofCombat.SyncFovWithAimbot(source)
        pcall(function()
            local silentOn = (Config.Tof_SilentAim == true)
            local aimbotOn = (Config.Tof_Aimbot == true)
            local fovToggle = Window and Window.ConfigFlags and Window.ConfigFlags["Show FOV Circle"]
            if silentOn then
                Config.Tof_ShowFOV = false
                if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                    TofCombat.FovCircle.Visible = false
                end
                if fovToggle and fovToggle.State == true and fovToggle.Set then
                    fovToggle:Set(false, true)
                end
            else
                if source == "Aimbot" or source == "SilentAim" or source == "Init" or not aimbotOn then
                    Config.Tof_ShowFOV = aimbotOn
                    if fovToggle and fovToggle.State ~= aimbotOn and fovToggle.Set then
                        fovToggle:Set(aimbotOn, true)
                    end
                end
                if not Config.Tof_ShowFOV and TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                    TofCombat.FovCircle.Visible = false
                end
            end
            if Window and Window.Gui then
                for _, d in ipairs(Window.Gui:GetDescendants()) do
                    if d.Name == "ToggleRow_Show FOV Circle" or d.Name == "SliderRow_FOV Radius" then
                        for _, sub in ipairs(d:GetDescendants()) do
                            if sub:IsA("TextLabel") then
                                sub.TextTransparency = silentOn and 0.55 or 0
                            elseif sub:IsA("TextButton") then
                                sub.Active = not silentOn
                            end
                        end
                    end
                end
            end
        end)
    end
    function TofCombat.StepAimbotAndFOV(dt)
        if IsInLobby() or IsCutsceneActive() then
            if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                TofCombat.FovCircle.Visible = false
            end
            return
        end
        if TofCombat.StepHitmarker then
            TofCombat.StepHitmarker(dt)
        end
        if TofCombat.StepHitLogs then
            TofCombat.StepHitLogs(dt)
        end
        local hasActiveGun = TofCombat.IsTwistOfFateActive()
        local hasAnyGun = hasActiveGun or (Config.Tof_SilentAim or Config.Tof_Aimbot)
        if hasAnyGun then
            pcall(function()
                TofCombat.CachedPing = math.clamp(LocalPlayer:GetNetworkPing(), 0.015, 0.20)
                TofCombat.RecordHrpHistory()
                TofCombat.UpdateTargetVelocities()
                TofCombat.EnsureHooksActive()
            end)
        end
        if not hasActiveGun then
            if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                TofCombat.FovCircle.Visible = false
            end
            return
        end
        local cam = Workspace.CurrentCamera
        if not cam then
            if TofCombat.FovCircle and TofCombat.FovCircle.Visible then
                TofCombat.FovCircle.Visible = false
            end
            return
        end
        local inMenu = (Window and Window.Visible) == true
        local c = TofCombat.FovCircle
        local isCD, remCD = TofCombat.GetGunCooldown()
        local shouldShowFov = Config.Tof_Aimbot and (not Config.Tof_SilentAim) and (Config.Tof_ShowFOV ~= false) and hasActiveGun and not inMenu
        if c then
            if shouldShowFov then
                local vp = cam.ViewportSize
                local center = Vector2.new(vp.X / 2, vp.Y / 2)
                c.Position = center
                c.Radius = Config.Tof_FOV or 220
                if isCD and remCD > 0 then
                    c.Color = Color3.fromRGB(255, 75, 75)
                    c.Transparency = 0.55
                else
                    c.Color = Config.Color_Tof_FOV or Color3.fromRGB(255, 175, 45)
                    c.Transparency = 1
                end
                if not c.Visible then c.Visible = true end
            else
                if c.Visible then c.Visible = false end
            end
        end
        local char = LocalPlayer.Character
        local isRightClickDown = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        local isCharAiming = (char and char:GetAttribute("Aiming") == true) or false
        local isAimHeld = (isRightClickDown or isCharAiming) and hasActiveGun and not inMenu
        if isAimHeld then
            if not TofCombat.IsAiming then
                TofCombat.IsAiming = true
                TofCombat.AimStartTime = os.clock()
            end
        else
            TofCombat.IsAiming = false
            TofCombat.AimStartTime = 0
        end
        if not hasActiveGun or not char then
            return
        end
        if Config.Tof_Aimbot and not inMenu and (not isCD or remCD <= 0) then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local useNoFov = (Config.Tof_SilentAim == true)
                local _, targetPart = TofCombat.GetTarget(useNoFov and math.huge or Config.Tof_FOV, useNoFov)
                if targetPart then
                    local shootOrigin = TofCombat.GetShootOrigin()
                    local aimPos = TofCombat.GetOptimalHitPosition(targetPart.Parent, targetPart, shootOrigin)
                    local targetCF = CFrame.lookAt(cam.CFrame.Position, aimPos)
                    local smooth = math.clamp(Config.Tof_AimbotSmooth or 10, 1, 30)
                    local step = math.clamp((type(dt) == "number" and dt or 0.016) * smooth, 0.05, 1)
                    cam.CFrame = cam.CFrame:Lerp(targetCF, step)
                end
            end
        end
    end
    function TofCombat.Cleanup()
        if TofCombat.HookedTwistEffects then
            pcall(function()
                if TofCombat.HookedTwistEffects._nexaraOrigAimDirection then
                    TofCombat.HookedTwistEffects.aimDirection = TofCombat.HookedTwistEffects._nexaraOrigAimDirection
                end
                if TofCombat.HookedTwistEffects._nexaraOrigOwn then
                    TofCombat.HookedTwistEffects.own = TofCombat.HookedTwistEffects._nexaraOrigOwn
                end
            end)
            TofCombat.HookedTwistEffects = nil
        end
        if TofCombat.FovCircle then
            pcall(function() TofCombat.FovCircle:Remove() end)
            TofCombat.FovCircle = nil
        end
        if TofCombat.StatusText then
            pcall(function() TofCombat.StatusText:Remove() end)
            TofCombat.StatusText = nil
        end
        if TofCombat.AimChargeText then
            pcall(function() TofCombat.AimChargeText:Remove() end)
            TofCombat.AimChargeText = nil
        end
        if TofCombat.HitmarkerLines then
            for _, l in ipairs(TofCombat.HitmarkerLines) do
                pcall(function() l:Remove() end)
            end
            TofCombat.HitmarkerLines = {}
        end
        if TofCombat.ActiveHitLogs then
            for _, entry in ipairs(TofCombat.ActiveHitLogs) do
                if entry.drawing then
                    pcall(function() entry.drawing:Remove() end)
                end
            end
            TofCombat.ActiveHitLogs = {}
        end
