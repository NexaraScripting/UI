        local origStartCd = client._nexaraOrigStartCd or client._startCooldown
        client._nexaraOrigStartCd = origStartCd
        client._nexaraHookedStartCd = true
        client._startCooldown = function(selfClient, dur, ...)
            local ap = (getgenv and getgenv().AutoParry) or AutoParry
            local sec = tonumber(dur) or 60
            if ap then ap.CooldownUntil = tick() + sec end
            SetItemCooldown(LocalPlayer, "Parrying Dagger", sec)
            origStartCd(selfClient, dur, ...)
            if ap then
                ap.StopKillerFaceLock()
                ap.ReleaseParryMovementLock(selfClient)
                if ap.UpdateCircle then
                    ap.LastCircleUpdateClock = nil
                    ap.UpdateCircle()
                end
            end
        end
    end
    if type(client._startPermanentCooldown) == "function" then
        local origPermCd = client._nexaraOrigPermCd or client._startPermanentCooldown
