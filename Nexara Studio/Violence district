local function IsKiller(player)
    if not player then return false end
    if IsInLobby() then return false end
    if player.Team and player.Team.Name == "Killer" then
        return true
    end
    local char = player.Character
    if char then
        if char:GetAttribute("TerrorRadius") or char:GetAttribute("Chasemusic") or char:GetAttribute("BloodLust") then
            return true
        end
        if char:FindFirstChild("spearmanager") or char:FindFirstChild("Curetool") or char:FindFirstChild("Flask") then
            return true
        end
    end
    return false
end

-- Cooldown Trackers & Multi-Client Replicated Item Tracker
local KillerPerkCooldowns = {}
local SurvivorPerkCooldowns = {}
local PlayerItemCooldowns = {}
local CureFlaskCooldownEnd = 0
local VeilSpearCooldownEnd = 0
local VeilVoidCooldownEnd = 0
local LastVeilSpears = 2
local LastVeilWasCharged = false

local function SetItemCooldown(player, itemName, duration)
    if not itemName or not duration then return end
    local endTime = os.clock() + tonumber(duration)
    if player then
        local pName = typeof(player) == "Instance" and player.Name or tostring(player)
        PlayerItemCooldowns[pName .. "_" .. itemName] = endTime
        if not PlayerItemCooldowns[pName] then
            PlayerItemCooldowns[pName] = {}
        end
        PlayerItemCooldowns[pName][itemName] = endTime
    end
    PlayerItemCooldowns[itemName] = endTime
end

local function GetItemCooldown(player, itemName)
    local now = os.clock()
    local t = nil
    if player then
        local pName = typeof(player) == "Instance" and player.Name or tostring(player)
        t = PlayerItemCooldowns[pName .. "_" .. itemName]
        if not t and PlayerItemCooldowns[pName] then
            t = PlayerItemCooldowns[pName][itemName]
        end
    end
    if not t and itemName then
        t = PlayerItemCooldowns[itemName]
    end
    if t and t > now then
        return math.ceil(t - now)
    end
    return 0
end

