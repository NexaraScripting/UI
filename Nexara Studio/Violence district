end

-- SEPARATE SKILLS, CHARGES & COOLDOWNS
local function GetPlayerSkillInfo(player)
    if not player or not player.Character then return nil end
    local char = player.Character
    
    if IsKiller(player) then
        local kName = player:GetAttribute("SelectedKiller") or "Killer"
        local skills = {}
        local details = {}

        if kName == "Cure" or char:FindFirstChild("Flask") or char:FindFirstChild("Curetool") then
            table.insert(skills, "Plague Flask")
            local flaskCD = math.max(0, math.ceil(CureFlaskCooldownEnd - os.clock()))
            if flaskCD > 0 then
                table.insert(details, "Flask: CD " .. flaskCD .. "s")
            else
                table.insert(details, "Flask: Ready")
            end
            local corpses = tonumber(char:GetAttribute("corpsecharge")) or 0
            if corpses > 0 then
                table.insert(details, corpses .. " Zombies Ready")
            else
                table.insert(details, "Zombies: 0/3")
            end
        elseif kName == "Veil" or char:FindFirstChild("spearmanager") or char:FindFirstChild("Spear1") then
            local isAiming = char:GetAttribute("spearmode") == true
            local isHoldingThrow = false
            local isFullyCharged = false

            -- Check animation tracks on killer to detect charging / holding throw (exact numeric IDs from game)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            local tracks = {}
            if animator then
                pcall(function()
                    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            if hum and #tracks == 0 then
                pcall(function()
                    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do table.insert(tracks, t) end
                end)
            end
            for _, track in ipairs(tracks) do
                local aName = (track.Animation and track.Animation.Name or ""):lower()
                local aId = (track.Animation and track.Animation.AnimationId or ""):lower()
                if aId:find("138045669415653") or aId:find("137688077908355") or aName:find("spearlunge.*op") or aName:find("1op") or aName:find("2op") then
                    isFullyCharged = true
                    break
                elseif aId:find("92098503722633") or aId:find("84093948968516") or aName:find("spearlunge") then
                    isHoldingThrow = true
                end
            end

            -- Detect particles on physical spear model in hand (enabled when holding >= 2s)
            if not isFullyCharged then
                for _, spName in ipairs({"Spear1", "Spear2"}) do
                    local sp = char:FindFirstChild(spName)
                    local hb = sp and sp:FindFirstChild("Hitbox")
                    if hb then
                        for _, pe in ipairs(hb:GetChildren()) do
                            if pe:IsA("ParticleEmitter") and pe.Enabled then
                                isFullyCharged = true
                                break
                            end
                        end
                    end
                    if isFullyCharged then break end
                end
            end

            table.insert(skills, "Spear" .. (isAiming and " (Aiming)" or ""))
            local spears = tonumber(char:GetAttribute("Spears"))
            if spears == nil then spears = 2 end

            -- Animation & Spear Drop State Machine (triggers instantly when charged spear leaves hand)
            if isFullyCharged then
                LastVeilWasCharged = true
            end
            if spears < LastVeilSpears then
                if (VeilSpearCooldownEnd - os.clock()) <= 0 then
                    VeilSpearCooldownEnd = os.clock() + 15
                end
                if LastVeilWasCharged or isFullyCharged then
                    VeilVoidCooldownEnd = os.clock() + 30
                    LastVeilWasCharged = false
                end
                LastVeilSpears = spears
            elseif spears > LastVeilSpears then
                LastVeilSpears = spears
                if spears < 2 then
                    VeilSpearCooldownEnd = os.clock() + 15
                else
                    VeilSpearCooldownEnd = 0
                end
            end
            if not isAiming and not isHoldingThrow and not isFullyCharged and (VeilVoidCooldownEnd - os.clock()) <= 0 then
                LastVeilWasCharged = false
            end

            table.insert(details, spears .. "/2 Spears")

            -- Spear recharge countdown (15s per spear)
            if spears < 2 then
                if (VeilSpearCooldownEnd - os.clock()) <= 0 then
                    VeilSpearCooldownEnd = os.clock() + 15
                end
                local spearCD = math.max(0, math.ceil(VeilSpearCooldownEnd - os.clock()))
                table.insert(details, "Recharge: " .. spearCD .. "s")
            else
                VeilSpearCooldownEnd = 0
            end

            -- Skill 2: Echo Void / Through the Veil (30s cooldown, requires holding throw >= 2s)
            local voidCD = math.max(0, math.ceil(VeilVoidCooldownEnd - os.clock()))
            if voidCD > 0 then
                table.insert(details, "Echo Void: CD " .. voidCD .. "s")
            elseif isFullyCharged then
                table.insert(details, "Echo Void: [CHARGED!]")
            elseif isHoldingThrow then
                table.insert(details, "Echo Void: [Charging...]")
            else
                table.insert(details, "Echo Void: Ready")
            end
        elseif kName == "Hidden" then
            table.insert(skills, "Shadow Leap")
            if char:GetAttribute("preparem2") or char:GetAttribute("M2") then
                table.insert(details, "Aiming Leap")
            end
        elseif kName == "Stalker" then
            table.insert(skills, "Evil Stalk")
            local stage = char:GetAttribute("StalkStage") or char:GetAttribute("EvolveStage")
            if stage then table.insert(details, "Stage " .. tostring(stage)) end
            if char:GetAttribute("IsStalking") then table.insert(details, "Stalking") end
        elseif kName == "Masked" then
            table.insert(skills, "Frenzy Dash")
            if char:GetAttribute("Dash") then table.insert(details, "Dashing") end
        elseif kName == "Abysswalker" then
            table.insert(skills, "Abyss Portal")
        elseif kName == "Slasher" then
            table.insert(skills, "Slash & Dash")
        else
            table.insert(skills, kName .. " Power")
        end

        local bl = tonumber(char:GetAttribute("BloodLust")) or 0
        if bl > 0 then table.insert(details, "Bloodlust T" .. bl) end

        if char:GetAttribute("IsStunned") == true then table.insert(details, "STUNNED") end
        if char:GetAttribute("IsCarrying") == true then table.insert(details, "CARRYING") end

        local str = "[SKILL] " .. table.concat(skills, ", ")
        if #details > 0 then str = str .. " [" .. table.concat(details, " | ") .. "]" end
        return str
    else
        -- Survivor item, charges, cooldowns, status
        local details = {}
        
        -- 1. Determine Item Name (Check attribute, then character children)
        local item = player:GetAttribute("EquippedItem")
        if not item or item == "None" or item == "" then
            for _, c in ipairs(char:GetChildren()) do
                if c:IsA("Model") or c:IsA("Tool") then
                    local nm = c.Name
                    if nm == "Parrying Dagger" or nm == "Adrenaline Shot" or nm == "Flashlight" or nm == "Holy Water" or nm == "Riot Shield" or nm == "Gate" or nm == "WaxBound Candle" or nm == "Shadow Clone" or nm == "Twist of Fate" or nm:find("Syringe") or nm:find("Medkit") or nm == "Bandage" or nm == "Motion Tracker" then
                        item = nm
                        break
                    end
                end
            end
        end

        local isItemReady = true
        if item and item ~= "None" and item ~= "" then
            local itemInst = char:FindFirstChild(item)
            if not itemInst then
                for _, c in ipairs(char:GetChildren()) do
                    if (c:IsA("Model") or c:IsA("Tool")) and (c.Name == item or c.Name:find(item) or (item:find(c.Name) and #c.Name > 3)) then
                        itemInst = c
                        break
                    end
                end
            end

            local uses = itemInst and (itemInst:GetAttribute("uses") or itemInst:GetAttribute("Uses") or itemInst:GetAttribute("charges") or itemInst:GetAttribute("Charges") or itemInst:GetAttribute("charge") or itemInst:GetAttribute("Charge"))
            local maxUses = itemInst and (itemInst:GetAttribute("MaxUses") or itemInst:GetAttribute("maxUses") or itemInst:GetAttribute("MaxCharges") or itemInst:GetAttribute("maxCharges"))
            local rem = itemInst and (itemInst:GetAttribute("remaining") or itemInst:GetAttribute("Remaining"))

            local qtyStr = ""
            if uses and tonumber(uses) then
                if item == "Bandage" or item:find("Bandage") then
                    local pct = math.clamp(math.floor((tonumber(uses) / 20.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif maxUses and tonumber(maxUses) then
                    qtyStr = string.format(" [%d/%d]", tonumber(uses), tonumber(maxUses))
                else
                    qtyStr = string.format(" [%d uses]", tonumber(uses))
                end
            elseif rem and tonumber(rem) then
                local remNum = tonumber(rem)
                if item == "Flashlight" or item:find("Flashlight") then
                    local pct = math.clamp(math.floor((remNum / 16.0) * 100), 0, 100)
                    qtyStr = string.format(" [%d%%]", pct)
                elseif remNum > 0 then
                    qtyStr = string.format(" (%.1fs)", remNum)
                end
            end

            local cdSec = GetItemCooldown(player, item)
            local itemStr = "Item: " .. item .. qtyStr

            if cdSec > 0 then
                isItemReady = false
                itemStr = itemStr .. string.format(" (CD %ds)", cdSec)
            elseif (rem and tonumber(rem) and tonumber(rem) <= 0) or (uses and tonumber(uses) and tonumber(uses) <= 0) then
                isItemReady = false
                itemStr = itemStr .. " [Empty]"
            else
                isItemReady = true
            end
            table.insert(details, itemStr)
        else
            isItemReady = nil
        end

        if player == LocalPlayer then
            local debuff = player.PlayerGui:FindFirstChild("Survivor") and player.PlayerGui.Survivor:FindFirstChild("statuseffects") and player.PlayerGui.Survivor.statuseffects:FindFirstChild("Debuff")
            local winded = debuff and debuff:FindFirstChild("Winded")
            if winded and winded.Visible then table.insert(details, "Exhausted") end
        end

        -- Only show Wiggle if they are ACTUALLY being carried by the killer!
        local isCarried = char:GetAttribute("IsCarried") or char:GetAttribute("BeingCarried") or char:GetAttribute("IsBeingCarried")
        if isCarried then
            local carryTime = tonumber(char:GetAttribute("RemainingCarryTime"))
            if carryTime and carryTime > 0 then
                table.insert(details, string.format("Wiggling: %.1fs", carryTime))
            end
        end

        -- Only show Hook % if actually hooked
        local isHooked = char:GetAttribute("IsHooked") or char:GetAttribute("HookProgressDepleting")
        local hookProg = tonumber(char:GetAttribute("HookedProgress"))
        if isHooked and hookProg and hookProg < 100 then
            table.insert(details, string.format("Hook: %d%%", math.floor(hookProg)))
        end

        return (#details > 0 and table.concat(details, " | ") or nil), isItemReady
    end
end

-- ======== BACKGROUND DATA CACHING (PREVENTS ESP STUTTER & LAG) ========
local PruneDeadDrawings = nil
local CachedPlayerData = {}
local CachedGenerators = {}
local CachedPallets = {}
local CachedWindows = {}
local CachedGates = {}
local lastMapScan = 0

local function UpdateBackgroundCache()
    pcall(function()
        local inLobby = IsInLobby()
        local now = os.clock()
        
        -- Cache player perks and skills every 0.3s (fast iteration over players only)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local isK = IsKiller(p)
                local perks = GetPlayerPerks(p)
                local skill, isReady = GetPlayerSkillInfo(p)
                CachedPlayerData[p] = {
                    IsKiller = isK,
                    Perks = perks,
                    SkillInfo = skill,
                    ItemReady = isReady,
                    DisplayName = p.DisplayName,
                }
            end
        end

        -- Clean up disconnected / dead players from cache
        for p in pairs(CachedPlayerData) do
            if not p or not p.Parent then
                CachedPlayerData[p] = nil
            end
        end

        -- Map objects: only scan when in match, throttled to every 3.0s (saves 90% CPU overhead)
        if inLobby then
            if #CachedGenerators > 0 then table.clear(CachedGenerators) end
            if #CachedPallets > 0 then table.clear(CachedPallets) end
            if #CachedWindows > 0 then table.clear(CachedWindows) end
            if #CachedGates > 0 then table.clear(CachedGates) end
            if PruneDeadDrawings then PruneDeadDrawings() end
            return
        end

        if now - lastMapScan < 3.0 and #CachedGenerators > 0 then
            return
        end
        lastMapScan = now

        local map = Workspace:FindFirstChild("Map")
        local gens, pallets, windows, gates = {}, {}, {}, {}
        local winSeen = {}

        -- 1. Universal Multi-Map Vault Detection: CollectionService 'VaultPoint'
        -- (This is the official engine tag Violence District uses across all maps to trigger player vaults)
        pcall(function()
            local CollectionService = game:GetService("CollectionService")
            for _, vt in ipairs(CollectionService:GetTagged("VaultPoint")) do
                local container = vt:FindFirstAncestorOfClass("Model") or vt.Parent
                if container and not winSeen[container] then
                    winSeen[container] = true
                    local bottomPart = container:FindFirstChild("Bottom")
                    local ledge = bottomPart
                    if not ledge then
                        for _, c in ipairs(container:GetChildren()) do
                            if c:IsA("BasePart") and not c.Name:lower():find("invis") and not c.Name:lower():find("trigger") then
                                ledge = c
                                break
                            end
                        end
                    end
                    local part = ledge or (vt:IsA("BasePart") and vt) or container:FindFirstChildWhichIsA("BasePart")
                    if part then
                        ledge = ledge or part
                        if ledge.Transparency >= 0.99 then ledge.Transparency = 0.98 end
                        table.insert(windows, { Model = container, Part = part, VaultLedge = ledge })
                    end
                end
            end
        end)

        if map then
            for _, d in ipairs(map:GetDescendants()) do
                if d:IsA("Model") and (d.Name == "Generator" or d:GetAttribute("RepairProgress") ~= nil) then
                    local part = d:FindFirstChild("RootPart") or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gens, { Model = d, Part = part }) end
                end
                -- Real pallets only (Filter out 35+ PalletCrate shipping containers!)
                local isPallet = (d.Parent and d.Parent.Name == "Pallets") or (d:FindFirstChild("PrimaryPartPallet") and not d.Name:lower():find("crate"))
                if d:IsA("Model") and isPallet then
                    local part = d:FindFirstChild("PrimaryPartPallet") or d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(pallets, { Model = d, Part = part, PalletWood = d }) end
                end

                -- 2. Fallback Scan: Any Model or Folder with 'window' or 'vault' across various maps
                local dName = d.Name:lower()
                if (d:IsA("Model") or d:IsA("Folder")) and (dName:find("window") or dName == "vault" or dName:find("vault")) and not winSeen[d] then
                    winSeen[d] = true
                    local bottomPart = d:FindFirstChild("Bottom")
                    local ledge = bottomPart
                    if not ledge then
                        for _, c in ipairs(d:GetChildren()) do
                            if c:IsA("BasePart") and not c.Name:lower():find("invis") and not c.Name:lower():find("trigger") then
                                ledge = c
                                break
                            end
                        end
                    end
                    local part = ledge or (d:IsA("Model") and d.PrimaryPart) or d:FindFirstChildWhichIsA("BasePart")
                    if part then
                        ledge = ledge or part
                        if ledge.Transparency >= 0.99 then ledge.Transparency = 0.98 end
                        table.insert(windows, { Model = d, Part = part, VaultLedge = ledge })
                    end
                end
            end
            for _, d in ipairs(map:GetChildren()) do
                if d:IsA("Model") and d.Name == "Gate" then
                    local part = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart")
                    if part then table.insert(gates, { Model = d, Part = part }) end
                end
            end
        end
        CachedGenerators = gens
        CachedPallets = pallets
        CachedWindows = windows
        CachedGates = gates
    end)
end

