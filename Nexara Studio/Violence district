-- EXACT 3 PERKS (NO DUPLICATES, ACCURATE ATTRIBUTES & SCRIPT DETECTION)
local function GetPlayerPerks(player)
    local perks = {}
    if not player then return perks end
    
    -- Local Player Survivor Perks from GUI
    if player == LocalPlayer then
        local sp = player.PlayerGui:FindFirstChild("SurvivorPerks")
        local pFolder = sp and (sp:FindFirstChild("Perks") or sp:FindFirstChild("Perkspc"))
        if pFolder then
            for _, c in ipairs(pFolder:GetChildren()) do
                if c:IsA("ImageLabel") and c.Name ~= "cdviz" and c.Name ~= "bg" and not c.Name:find("UI") then
                    local cleanName = KnownSurvivorPerks[c.Name:lower()] or c.Name
                    if not table.find(perks, cleanName) and #perks < 3 then
                        table.insert(perks, cleanName)
                    end
                end
            end
        end
        return perks
    end

    local char = player.Character
    if not char then return perks end

    -- Killer Perks: Always cloned as Scripts inside Character named "<PerkName> <Level>"
    if IsKiller(player) then
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("LuaSourceContainer") and #perks < 3 then
                local rawName = c.Name:match("^(.-)%s+%d+$")
                if rawName then
                    local mapped = KnownKillerPerks[rawName:lower()]
                    if mapped and not table.find(perks, mapped) then
                        table.insert(perks, mapped)
                    end
                end
            end
        end
        return perks
    end

    -- Other Survivor Perks (from Character attributes like nopainnogain=true, builtdifferent=true, and scripts)
    for attrName, attrVal in pairs(char:GetAttributes()) do
        if attrVal == true and #perks < 3 then
            local clean = attrName:lower():gsub("%s+", ""):gsub("[^%a]", "")
            local mapped = KnownSurvivorPerksNormalized[clean]
            if mapped and not table.find(perks, mapped) then
                table.insert(perks, mapped)
            end
        end
    end
    for _, c in ipairs(char:GetChildren()) do
        if #perks < 3 then
            local rawName = c.Name:match("^(.-)%s+%d+$") or c.Name
            local clean = rawName:lower():gsub("%s+", ""):gsub("[^%a]", "")
            local mapped = KnownSurvivorPerksNormalized[clean]
            if mapped and not table.find(perks, mapped) then
                table.insert(perks, mapped)
            end
        end
    end

