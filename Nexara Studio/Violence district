local function RenderESP()
    pcall(function()
        Camera = Workspace.CurrentCamera or Camera
        local inLobby = IsInLobby()
        local myRoot = GetRoot(LocalPlayer)
        local camPos = Camera.CFrame.Position
        local myPos = myRoot and myRoot.Position or camPos

        -- Top Screen Killer Skill (Rendered directly under in-game match timer, hidden in lobby or post-match)
        if not inLobby and Config.ESP_KillerEnabled and Config.ESP_KillerSkills then
            local killerPlr = nil
            for p, _ in pairs(ESP_Objects) do
                local data = CachedPlayerData[p]
                if (data and data.IsKiller) or IsKiller(p) then
                    killerPlr = p
                    break
                end
            end
            if not killerPlr and IsKiller(LocalPlayer) then
                killerPlr = LocalPlayer
            end

            if killerPlr and killerPlr.Character then
                local kSkillStr = GetPlayerSkillInfo(killerPlr)
                if kSkillStr and #kSkillStr > 0 then
                    local posX = math.floor(Camera.ViewportSize.X / 2)
                    local posY = Config.TopKillerSkillYOffset or 58
                    local timerEnded = false

                    pcall(function()
                        local pg = LocalPlayer:FindFirstChild("PlayerGui")
                        if pg then
                            local timeFrame = nil
                            local tl = nil
                            for _, guiName in ipairs({"Survivor", "Killer", "Spectator", "HUD", "InGame"}) do
                                local g = pg:FindFirstChild(guiName)
                                if g then
                                    local tf = g:FindFirstChild("time") or g:FindFirstChild("Time") or g:FindFirstChild("Timer")
                                    if tf then
                                        timeFrame = tf
                                        tl = tf:FindFirstChild("TimerLabel") or tf:FindFirstChildOfClass("TextLabel")
                                        break
                                    end
                                end
                            end
                            if not timeFrame then
                                for _, gui in ipairs(pg:GetChildren()) do
                                    if gui:IsA("ScreenGui") and gui.Name ~= "NexaraStudio" and gui.Name ~= "Nexara_ScreenGui" then
                                        local tf = gui:FindFirstChild("time", true)
                                        if tf then
                                            timeFrame = tf
                                            tl = tf:FindFirstChild("TimerLabel") or tf:FindFirstChildOfClass("TextLabel")
                                            break
                                        end
                                    end
                                end
                            end

                            if tl and (tl.Text == "00:00" or tl.Text == "0:00") then
                                timerEnded = true
                            end
                            posX = math.floor(Camera.ViewportSize.X / 2)
                            posY = math.max(tonumber(Config.TopKillerSkillYOffset) or 58, 54)
                        end
                    end)

                    if timerEnded then
                        TopKillerSkillText.Visible = false
                    else
                        TopKillerSkillText.Size = Config.TopKillerSkillSize or 16
                        local formattedText = kSkillStr
                        if formattedText:find("^Skill:") then
                            formattedText = formattedText:gsub("^Skill:%s*", "[SKILL] ")
                        elseif not formattedText:find("^%[SKILL%]") then
                            formattedText = "[SKILL] " .. formattedText
                        end
                        -- Clean any accidental CHASING status
                        formattedText = formattedText:gsub("%s*|%s*CHASING", ""):gsub("%[CHASING%]", "")
                        TopKillerSkillText.Text = formattedText
                        TopKillerSkillText.Position = Vector2.new(posX, posY)
                        TopKillerSkillText.Visible = true
                    end
                else
                    TopKillerSkillText.Visible = false
                end
            else
                TopKillerSkillText.Visible = false
            end
        else
            TopKillerSkillText.Visible = false
        end

        -- 1. Player ESP (Separated: Killer ESP vs Survivor ESP vs Lobby Players)
        for player, esp in pairs(ESP_Objects) do
            local char = player.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
            local data = CachedPlayerData[player]

            if char and root and char:FindFirstChild("Head") then
                local isK = not inLobby and ((data and data.IsKiller) or IsKiller(player))
                local rootPos = root.Position
                local rootScreen, onScreen = Camera:WorldToViewportPoint(rootPos)

                if onScreen then
                    local dist = (myPos - rootPos).Magnitude
                    local headScreen = Camera:WorldToViewportPoint(char.Head.Position)
                    local currentX = math.floor(rootScreen.X)
                    local currentY = 0

                -- KILLER ESP BRANCH
                if isK and not inLobby then
                    if Config.ESP_KillerEnabled then
                        -- Hide 2D Box
                        esp.BoxOutline.Visible = false
                        esp.Box.Visible = false

                        -- Render Hot Pink Skeleton (Thin & sleek)
                        local topY = headScreen.Y - 24
                        local btmY = rootScreen.Y + 24
                        if Config.ESP_KillerSkeleton then
                            local anyVis, hPoint, fPoint = UpdateSkeleton(char, esp.Skeleton, Color3.fromRGB(240, 60, 160), Config.KillerSkeletonThickness or 1.3)
                            currentX = hPoint and hPoint.X or currentX
                            topY = hPoint and (hPoint.Y - 24) or (headScreen.Y - 24)
                            btmY = fPoint and (fPoint.Y + 6) or (rootScreen.Y + 24)
                        else
                            for _, l in pairs(esp.Skeleton) do l.Visible = false end
                        end

                        -- Top Text: Player Name [Distance] (Clean, no [KILLER] prefix)
                        if Config.ESP_KillerNames then
                            local topStr = (data and data.DisplayName or player.DisplayName) .. " [" .. math.floor(dist) .. "m]"
                            esp.TopText.Text = topStr
                            esp.TopText.Position = Vector2.new(currentX, topY)
                            esp.TopText.Color = Color3.fromRGB(255, 60, 160)
                            esp.TopText.Visible = true
                        else
                            esp.TopText.Visible = false
                        end

                        -- Bottom Text: [KILLER] KillerType (No CHASING)
                        if Config.ESP_KillerNames then
                            local kType = player:GetAttribute("SelectedKiller") or "The Killer"
                            local btmStr = "[KILLER] " .. kType
                            if char:GetAttribute("IsStunned") == true then btmStr = btmStr .. " [STUNNED]" end
                            if char:GetAttribute("IsCarrying") == true then btmStr = btmStr .. " [CARRYING]" end

                            esp.BottomText.Text = btmStr
                            esp.BottomText.Position = Vector2.new(currentX, btmY)
                            esp.BottomText.Color = Color3.fromRGB(255, 255, 255)
                            esp.BottomText.Visible = true
                            currentY = btmY + 14
                        else
                            esp.BottomText.Visible = false
                            currentY = btmY + 14
                        end

                        -- Perks Text (Disabled)
                        esp.PerkText.Visible = false

                        -- Skills & Charges Text (Moved under top match timer)
                        esp.SkillText.Visible = false
                    else
                        esp.BoxOutline.Visible = false
                        esp.Box.Visible = false
                        esp.TopText.Visible = false
                        esp.BottomText.Visible = false
                        esp.PerkText.Visible = false
                        esp.SkillText.Visible = false
                        for _, l in pairs(esp.Skeleton) do l.Visible = false end
                    end

                -- SURVIVOR OR LOBBY BRANCH
                else
                    local allowESP = inLobby and (Config.ESP_LobbyEnabled ~= false) or (not inLobby and Config.ESP_SurvivorEnabled)
                    if allowESP then
                        -- Hide Skeleton lines
                        for _, l in pairs(esp.Skeleton) do l.Visible = false end

                        local topWorld = rootPos + Vector3.new(0, 2.5, 0)
                        local btmWorld = rootPos - Vector3.new(0, 3.1, 0)
                        local topScreen, topVis = Camera:WorldToViewportPoint(topWorld)
                        local btmScreen, btmVis = Camera:WorldToViewportPoint(btmWorld)

                        if topVis and btmVis then
                            local col = inLobby and Color3.fromRGB(0, 210, 255) or Color3.fromRGB(80, 255, 120)
                            if char:GetAttribute("Knocked") == true then
                                col = Color3.fromRGB(255, 150, 40)
                            elseif char:GetAttribute("HookProgressDepleting") == true then
                                col = Color3.fromRGB(200, 80, 255)
                            end

                            local boxHeight = math.floor(math.abs(btmScreen.Y - topScreen.Y))
                            local boxWidth = math.floor(boxHeight * 0.55)
                            local boxX = math.floor(rootScreen.X - boxWidth * 0.5)
                            local boxY = math.floor(math.min(topScreen.Y, btmScreen.Y))

                            local showBox = inLobby and (Config.ESP_LobbyBoxes ~= false) or Config.ESP_SurvivorBoxes
                            if showBox then
                                local boxPos = Vector2.new(boxX, boxY)
                                local boxSize = Vector2.new(boxWidth, boxHeight)

                                esp.BoxOutline.Size = boxSize
                                esp.BoxOutline.Position = boxPos
                                esp.BoxOutline.Visible = true

                                esp.Box.Size = boxSize
                                esp.Box.Position = boxPos
                                esp.Box.Color = col
                                esp.Box.Visible = true
                            else
                                esp.BoxOutline.Visible = false
                                esp.Box.Visible = false
                            end

                            -- Top Text: [SURVIVOR] Name (or [LOBBY] Name)
                            local showNames = inLobby and (Config.ESP_LobbyNames ~= false) or Config.ESP_SurvivorNames
                            if showNames then
                                local topStr = inLobby and "[LOBBY] " or "[SURVIVOR] "
                                topStr = topStr .. (data and data.DisplayName or player.DisplayName)
                                esp.TopText.Text = topStr
                                esp.TopText.Position = Vector2.new(rootScreen.X, boxY - 16)
                                esp.TopText.Color = col
                                esp.TopText.Visible = true
                            else
                                esp.TopText.Visible = false
                            end

                            -- Bottom Text: Distance + Status
                            local currentY = boxY + boxHeight + 2
                            if showNames then
                                local btmStr = math.floor(dist) .. "m"
                                if not inLobby and Config.ESP_SurvivorStatus then
                                    if char:GetAttribute("Knocked") == true then btmStr = btmStr .. " [KNOCKED]"
                                    elseif char:GetAttribute("HookProgressDepleting") == true then btmStr = btmStr .. " [HOOKED]" end
                                end

                                esp.BottomText.Text = btmStr
                                esp.BottomText.Position = Vector2.new(rootScreen.X, currentY)
                                esp.BottomText.Color = Color3.fromRGB(255, 255, 255)
                                esp.BottomText.Visible = true
                                currentY = currentY + 14
                            else
                                esp.BottomText.Visible = false
                            end

                            -- Survivor Item & Status (Live Real-Time Cooldown Countdown)
                            local sSkillStr, isItemReady = GetPlayerSkillInfo(player)
                            if not sSkillStr and data then
                                sSkillStr = data.SkillInfo
                                isItemReady = data.ItemReady
                            end
                            if Config.ESP_SurvivorSkills and not inLobby and sSkillStr then
                                esp.SkillText.Text = sSkillStr
                                esp.SkillText.Position = Vector2.new(rootScreen.X, currentY)
                                if isItemReady == false then
                                    esp.SkillText.Color = Color3.fromRGB(255, 75, 75) -- Red when used/cooling down/empty
                                elseif isItemReady == true then
                                    esp.SkillText.Color = Color3.fromRGB(80, 255, 80) -- Green when ready to use
                                else
                                    esp.SkillText.Color = Color3.fromRGB(80, 220, 255)
                                end
                                esp.SkillText.Visible = true
                                currentY = currentY + 14
                            else
                                esp.SkillText.Visible = false
                            end

                            -- Survivor Perks (Disabled)
                            esp.PerkText.Visible = false
                        else
                            esp.BoxOutline.Visible = false
                            esp.Box.Visible = false
                            esp.TopText.Visible = false
                            esp.BottomText.Visible = false
                            esp.PerkText.Visible = false
                            esp.SkillText.Visible = false
                        end
                    else
                        esp.BoxOutline.Visible = false
                        esp.Box.Visible = false
                        esp.TopText.Visible = false
                        esp.BottomText.Visible = false
                        esp.PerkText.Visible = false
                        esp.SkillText.Visible = false
                        for _, l in pairs(esp.Skeleton) do l.Visible = false end
                    end
                end
            else
                esp.BoxOutline.Visible = false
                esp.Box.Visible = false
                esp.TopText.Visible = false
                esp.BottomText.Visible = false
                esp.PerkText.Visible = false
                esp.SkillText.Visible = false
                for _, l in pairs(esp.Skeleton) do l.Visible = false end
            end
        else
            esp.BoxOutline.Visible = false
            esp.Box.Visible = false
            esp.TopText.Visible = false
            esp.BottomText.Visible = false
            esp.PerkText.Visible = false
            esp.SkillText.Visible = false
            for _, l in pairs(esp.Skeleton) do l.Visible = false end
        end
    end

    -- 2. Generator ESP
    table.clear(seenGens)
    if not inLobby and Config.ESP_Generators then
        for _, item in ipairs(CachedGenerators) do
            local gen = item.Model
            local root = item.Part
            if gen and gen.Parent and root and root.Parent then
                seenGens[gen] = true
                local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local txt = GenDrawings[gen]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 13
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    GenDrawings[gen] = txt
                end

                if onScreen then
                    local dist = math.floor((myPos - root.Position).Magnitude)
                    local prog = tonumber(gen:GetAttribute("RepairProgress")) or 0
                    local repairers = tonumber(gen:GetAttribute("PlayersRepairingCount")) or 0

                    local label = "Generator " .. dist .. "m"
                    if Config.ESP_GenProgress then
                        label = string.format("Generator [%d%%] %dm", math.floor(prog), dist)
                        if repairers > 0 then label = label .. " (Repairing)" end
                    end

                    txt.Text = label
                    txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))

                    if prog >= 100 then
                        txt.Color = Color3.fromRGB(0, 240, 255)
                    elseif repairers > 0 then
                        txt.Color = Color3.fromRGB(255, 215, 0)
                    elseif prog >= 50 then
                        txt.Color = Color3.fromRGB(80, 255, 80)
                    else
                        txt.Color = Color3.fromRGB(255, 90, 90)
                    end
                    txt.Visible = true
                else
                    txt.Visible = false
                end
            end
        end
    end
    for gen, txt in pairs(GenDrawings) do
        if not seenGens[gen] then txt.Visible = false end
    end

    -- 3. Pallet ESP & 3D Glowing Aura
    table.clear(seenPallets)
    if not inLobby and Config.ESP_Pallets then
        for _, item in ipairs(CachedPallets) do
            local pallet = item.Model
            local root = item.Part
            if pallet and pallet.Parent and root and root.Parent then
                seenPallets[pallet] = true
                local dist = (myPos - root.Position).Magnitude

                -- 3D Glowing Aura through walls (Wood pallet only)
                if Config.ESP_PalletAura and dist <= Config.PalletMaxDist then
                    local targetAdornee = item.PalletWood or pallet
                    local hl = PalletAuras[pallet]
                    if not hl or not hl.Parent then
                        hl = Instance.new("Highlight")
                        hl.Name = "Nexara_PalletAura"
                        hl.FillColor = Color3.fromRGB(255, 170, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 230, 100)
                        hl.FillTransparency = 0.65
                        hl.OutlineTransparency = 0.1
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = targetAdornee
                        hl.Parent = targetAdornee
                        PalletAuras[pallet] = hl
                    end
                    hl.Enabled = true
                elseif PalletAuras[pallet] then
                    pcall(function() PalletAuras[pallet].Enabled = false end)
                end

                -- Distance Text
                local txt = PalletDrawings[pallet]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 12
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    PalletDrawings[pallet] = txt
                end

                if dist <= Config.PalletMaxDist then
                    local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        txt.Text = "Pallet " .. math.floor(dist) .. "m"
                        txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                        txt.Color = Color3.fromRGB(255, 180, 50)
                        txt.Visible = true
                    else
                        txt.Visible = false
                    end
                else
                    txt.Visible = false
                end
            end
        end
    end
    for pallet, hl in pairs(PalletAuras) do
        if not seenPallets[pallet] or inLobby or not Config.ESP_Pallets or not Config.ESP_PalletAura then
            pcall(function() hl.Enabled = false end)
        end
    end
    for pallet, txt in pairs(PalletDrawings) do
        if not seenPallets[pallet] then txt.Visible = false end
    end

    -- 4. Window / Vault ESP & 3D Glowing Aura (Image 3: Vault Sill Ledge Only, NOT the wall!)
    table.clear(seenWindows)
    if not inLobby and Config.ESP_Windows then
        for _, item in ipairs(CachedWindows) do
            local win = item.Model
            local root = item.Part
            local ledge = item.VaultLedge
            if win and win.Parent and root and root.Parent then
                seenWindows[win] = true
                local dist = (myPos - root.Position).Magnitude

                -- 3D Glowing Aura on ONLY the vault sill ledge (Dual-Layer: BoxHandleAdornment + Highlight)
                if Config.ESP_WindowAura and dist <= Config.WindowMaxDist and ledge and ledge.Parent then
                    if ledge.Transparency >= 0.99 then
                        ledge.Transparency = 0.98
                    end

                    -- Layer 1: BoxHandleAdornment (Immune to Roblox 31-highlight limit, 100% visible through walls)
                    local bha = WindowAdornments[win]
                    if not bha or not bha.Parent then
                        bha = Instance.new("BoxHandleAdornment")
                        bha.Name = "Nexara_WindowBox"
                        bha.Size = ledge.Size + Vector3.new(0.06, 0.06, 0.06)
                        bha.Color3 = Color3.fromRGB(0, 210, 255)
                        bha.Transparency = 0.55
                        bha.AlwaysOnTop = true
                        bha.ZIndex = 5
                        bha.Adornee = ledge
                        bha.Parent = ledge
                        WindowAdornments[win] = bha
                    end
                    bha.Visible = true

                    -- Layer 2: Highlight (For rich outer neon glow)
                    local hl = WindowAuras[win]
                    if not hl or not hl.Parent then
                        hl = Instance.new("Highlight")
                        hl.Name = "Nexara_WindowAura"
                        hl.FillColor = Color3.fromRGB(0, 190, 255)
                        hl.OutlineColor = Color3.fromRGB(100, 230, 255)
                        hl.FillTransparency = 0.65
                        hl.OutlineTransparency = 0.1
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = ledge
                        hl.Parent = ledge
                        WindowAuras[win] = hl
                    end
                    hl.Enabled = true
                else
                    if WindowAuras[win] then pcall(function() WindowAuras[win].Enabled = false end) end
                    if WindowAdornments[win] then pcall(function() WindowAdornments[win].Visible = false end) end
                end

                -- Distance Text
                local txt = WindowDrawings[win]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 12
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    WindowDrawings[win] = txt
                end

                if dist <= Config.WindowMaxDist then
                    local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        txt.Text = "Vault " .. math.floor(dist) .. "m"
                        txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                        txt.Color = Color3.fromRGB(80, 210, 255)
                        txt.Visible = true
                    else
                        txt.Visible = false
                    end
                else
                    txt.Visible = false
                end
            end
        end
    end
    for win, hl in pairs(WindowAuras) do
        if not seenWindows[win] or inLobby or not Config.ESP_Windows or not Config.ESP_WindowAura then
            pcall(function() hl.Enabled = false end)
        end
    end
    for win, bha in pairs(WindowAdornments) do
        if not seenWindows[win] or inLobby or not Config.ESP_Windows or not Config.ESP_WindowAura then
            pcall(function() bha.Visible = false end)
        end
    end
    for win, txt in pairs(WindowDrawings) do
        if not seenWindows[win] then txt.Visible = false end
    end

    -- 5. Exit Gates ESP
    table.clear(seenGates)
    if not inLobby and Config.ESP_ExitGates then
        for idx, item in ipairs(CachedGates) do
            local gate = item.Model
            local root = item.Part
            if gate and gate.Parent and root and root.Parent then
                seenGates[gate] = true
                local sPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local txt = GateDrawings[gate]
                if not txt then
                    txt = Drawing.new("Text")
                    txt.Size = 13
                    txt.Center = true
                    txt.Outline = true
                    txt.OutlineColor = Color3.fromRGB(0, 0, 0)
                    GateDrawings[gate] = txt
                end

                if onScreen then
                    local dist = math.floor((myPos - root.Position).Magnitude)
                    txt.Text = string.format("Exit Gate #%d (%dm)", idx, dist)
                    txt.Position = Vector2.new(math.floor(sPos.X), math.floor(sPos.Y))
                    txt.Color = Color3.fromRGB(50, 255, 120)
                    txt.Visible = true
                else
                    txt.Visible = false
                end
            end
        end
    end
    for gate, txt in pairs(GateDrawings) do
        if not seenGates[gate] then txt.Visible = false end
    end
    end)
end

-- Bind ESP rendering strictly AFTER CameraModule (200), Flashlight ShiftLock (300), and CameraShake (2001)
pcall(function() RunService:UnbindFromRenderStep("NexaraESP_Render") end)
RunService:BindToRenderStep("NexaraESP_Render", Enum.RenderPriority.Last.Value + 10, RenderESP)

print("[Nexara Studio] Violence District V 1.0.0-a912beta loaded successfully.")
