-- ======== SKELETON DRAWER (R6 BONES - THIN & SLEEK) ========
local function UpdateSkeleton(char, lines, color, thickness)
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("leftarm")
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("rightarm")
    local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("leftleg")
    local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("rightleg")

    if not (head and torso) then
        for _, l in pairs(lines) do l.Visible = false end
        return false, nil, nil
    end

    local function getPoint(part, offset)
        if not part then return nil, false end
        local p = part.Position + (offset or Vector3.new())
        local sp, vis = Camera:WorldToViewportPoint(p)
        return Vector2.new(math.floor(sp.X), math.floor(sp.Y)), vis
    end

    local headPos, hVis = getPoint(head)
    local neckPos, nVis = getPoint(torso, Vector3.new(0, 0.8, 0))
    local waistPos, wVis = getPoint(torso, Vector3.new(0, -0.9, 0))
    local lArmPos, laVis = getPoint(leftArm, Vector3.new(0, -0.6, 0))
    local rArmPos, raVis = getPoint(rightArm, Vector3.new(0, -0.6, 0))
    local lLegPos, llVis = getPoint(leftLeg, Vector3.new(0, -1.0, 0))
    local rLegPos, rlVis = getPoint(rightLeg, Vector3.new(0, -1.0, 0))

    local function drawL(line, p1, v1, p2, v2)
        if v1 and v2 and p1 and p2 then
            line.From = p1
            line.To = p2
            line.Color = color
            line.Thickness = thickness or 1.3
            line.Visible = true
        else
            line.Visible = false
        end
    end

    drawL(lines.Spine, headPos, hVis, waistPos, wVis)
    drawL(lines.LeftArm, neckPos, nVis, lArmPos, laVis)
    drawL(lines.RightArm, neckPos, nVis, rArmPos, raVis)
    drawL(lines.LeftLeg, waistPos, wVis, lLegPos, llVis)
    drawL(lines.RightLeg, waistPos, wVis, rLegPos, rlVis)

    return (hVis or wVis), headPos, (lLegPos or waistPos)
end

