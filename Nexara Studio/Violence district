end
table.insert(ScriptConnections, Players.PlayerAdded:Connect(SetupPlayerCooldownHooks))

-- Successful Parry Stun Upgrade: if killer is stunned within 1.5s of parry, upgrade CD to 90s
local function CheckKillerStunned()
    for _, p in ipairs(Players:GetPlayers()) do
        if not IsKiller(p) and p.Character then
            local cd = GetItemCooldown(p, "Parrying Dagger")
            if cd >= 57 then
                SetItemCooldown(p, "Parrying Dagger", 90)
            end
        end
    end
end

