-- Replicated Character Hooks: Catches item use on ANY survivor across the network!
local function SetupPlayerCooldownHooks(player)
    local function onChar(char)
        if not char then return end

        -- 1. Character Attribute: Parry (triggers on Parrying Dagger use) & Item Aiming/Overridelook
        table.insert(ScriptConnections, char.AttributeChanged:Connect(function(attrName)
            if attrName == "Parry" and char:GetAttribute("Parry") == true then
                SetItemCooldown(player, "Parrying Dagger", 60)
            elseif (attrName == "overridelookscript" or attrName == "Aiming") and char:GetAttribute(attrName) == true then
                local eqItem = player:GetAttribute("EquippedItem")
                if eqItem == "Riot Shield" or char:FindFirstChild("Riot Shield") then
                    SetItemCooldown(player, "Riot Shield", 50)
                elseif eqItem == "Gate" or char:FindFirstChild("Gate") then
                    SetItemCooldown(player, "Gate", 60)
                elseif eqItem == "Shadow Clone" or char:FindFirstChild("Shadow Clone") then
                    SetItemCooldown(player, "Shadow Clone", 60)
                elseif eqItem == "WaxBound Candle" or char:FindFirstChild("WaxBound Candle") then
                    SetItemCooldown(player, "WaxBound Candle", 35)
                end
            end
        end))

        -- 2. Humanoid.Animator AnimationPlayed (replicated to all clients across whole map)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10)
            local animator = hum and hum:WaitForChild("Animator", 10)
            if animator then
                table.insert(ScriptConnections, animator.AnimationPlayed:Connect(function(track)
                    local anim = track.Animation
                    local id = anim and tostring(anim.AnimationId) or ""

                    -- Parrying Dagger animation (81793464499285)
                    if id:find("81793464499285") then
                        SetItemCooldown(player, "Parrying Dagger", 60)
                    -- Riot Shield animations: 74984154565270 (startup), 121423371398811 (rush), 79311585097396 (hit wall), 104947844641383 (stop/stun)
                    elseif id:find("74984154565270") or id:find("121423371398811") or id:find("79311585097396") or id:find("104947844641383") then
                        SetItemCooldown(player, "Riot Shield", 50)
                    -- Holy Water throw animation: 108808628680823
                    elseif id:find("108808628680823") then
                        SetItemCooldown(player, "Holy Water", 60)
                    -- Gate activation animation: 101003929747834
                    elseif id:find("101003929747834") then
                        SetItemCooldown(player, "Gate", 60)
                    -- Adrenaline Shot animations
                    elseif id:find("81862329683527") or id:find("130738331331686") then
                        SetItemCooldown(player, "Adrenaline Shot", 60)
                    -- WaxBound Candle active animation: 135093388666935 (5s use duration + 30s cd = 35s total)
                    elseif id:find("135093388666935") then
                        SetItemCooldown(player, "WaxBound Candle", 35)
                    -- Shadow Clone hand signs animation: 106585152202320 (60s cd)
                    elseif id:find("106585152202320") then
                        SetItemCooldown(player, "Shadow Clone", 60)
                    end
                end))

                -- Gate & Shadow Clone interrupt detection: if hit within 2s of channel start, cooldown drops to 5s
                table.insert(ScriptConnections, hum:GetPropertyChangedSignal("Health"):Connect(function()
                    local cd = GetItemCooldown(player, "Gate")
                    if cd >= 58 then
                        SetItemCooldown(player, "Gate", 5)
                    end
                    local cdSC = GetItemCooldown(player, "Shadow Clone")
                    if cdSC >= 58 then
                        SetItemCooldown(player, "Shadow Clone", 5)
                    end
                end))
            end
        end)

        -- 3. HumanoidRootPart linear velocity / rush attachment detection (distance-independent)
        task.spawn(function()
            local hrp = char:WaitForChild("HumanoidRootPart", 10)
            if hrp then
                table.insert(ScriptConnections, hrp.ChildAdded:Connect(function(child)
                    if child.Name == "RushVelocity" or child.Name == "RushAttachment" then
                        SetItemCooldown(player, "Riot Shield", 50)
                    end
                end))
            end
        end)

        -- 4. Consumable Item Removal (Adrenaline Shot consumed on use)
        table.insert(ScriptConnections, char.ChildRemoved:Connect(function(child)
            if child.Name == "Adrenaline Shot" and player:GetAttribute("IsDead") ~= true then
                SetItemCooldown(player, "Adrenaline Shot", 60)
            end
        end))

        -- 5. Item Attribute Tracking (detect uses/charges decrements for WaxBound Candle etc.)
        task.spawn(function()
            local function hookItem(c)
                if not c or not (c:IsA("Model") or c:IsA("Tool")) then return end
                local lastUses = tonumber(c:GetAttribute("uses") or c:GetAttribute("Uses"))
                table.insert(ScriptConnections, c.AttributeChanged:Connect(function(attr)
                    if attr == "uses" or attr == "Uses" then
                        local cur = tonumber(c:GetAttribute(attr))
                        if lastUses and cur and cur < lastUses then
                            if c.Name == "WaxBound Candle" then
                                SetItemCooldown(player, "WaxBound Candle", 35)
                            end
                        end
                        lastUses = cur
                    end
                end))
            end

            for _, c in ipairs(char:GetChildren()) do
                hookItem(c)
            end
            table.insert(ScriptConnections, char.ChildAdded:Connect(hookItem))
        end)
    end

    if player.Character then
        task.spawn(onChar, player.Character)
    end
    table.insert(ScriptConnections, player.CharacterAdded:Connect(onChar))
end

for _, p in ipairs(Players:GetPlayers()) do
