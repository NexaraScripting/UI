local function UpdateThreatIndicators()
    if not Settings.ThreatPointersEnabled or not threatGui then
        if threatGui then threatGui.Enabled = false end
        return
    end
    threatGui.Enabled = true

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
    if not myTorso then return end

    local myPos = myTorso.Position
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local marginX = 85
    local marginY = 60
    local halfW = (vp.X / 2) - marginX
    local halfH = (vp.Y / 2) - marginY

    local activeSet = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsPlayerAlive(plr) then
            local char = plr.Character or Workspace:FindFirstChild(plr.Name)
            local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local curHp = math.floor(hum and hum.Health or 100)

            if torso then
                local distStuds = (torso.Position - myPos).Magnitude
                local distM = math.floor(distStuds * 0.28)

                if distM <= Settings.ThreatMaxDistance then
                    activeSet[plr] = true
                    local widget = threatIndicators[plr]
                    if not widget or not widget.Root.Parent then
                        widget = CreateThreatWidget(plr)
                        threatIndicators[plr] = widget
                    end

                    local color = Theme.NativeGreen
                    if Settings.ThreatColorMode == "Danger Red" then
                        color = Color3.fromRGB(255, 60, 75)
                    elseif Settings.ThreatColorMode == "Distance Dynamic" then
                        if distM <= 35 then color = Color3.fromRGB(255, 55, 70)
                        elseif distM <= 90 then color = Color3.fromRGB(255, 175, 40)
                        else color = Theme.NativeGreen end
                    end

                    local sc, onScreen = Camera:WorldToViewportPoint(torso.Position)
                    local isTrulyOnScreen = onScreen and sc.Z > 0 and (sc.X >= marginX and sc.X <= vp.X - marginX) and (sc.Y >= marginY and sc.Y <= vp.Y - marginY)

                    if not isTrulyOnScreen then
                        local dir2D = Vector2.new(sc.X - center.X, sc.Y - center.Y)
                        if sc.Z <= 0 then dir2D = -dir2D end
                        if dir2D.Magnitude == 0 then dir2D = Vector2.new(0, -1) end
                        local unitDir = dir2D.Unit

                        local scaleX = halfW / math.abs(unitDir.X)
                        local scaleY = halfH / math.abs(unitDir.Y)
                        local scale = math.min(scaleX, scaleY)
                        local edgeX = center.X + unitDir.X * scale
                        local edgeY = center.Y + unitDir.Y * scale

                        local angleDeg = math.deg(math.atan2(unitDir.Y, unitDir.X))

                        widget.Root.Position = UDim2.fromOffset(edgeX, edgeY)
                        widget.ArrowFrame.Rotation = angleDeg
                        widget.ArrowImage.ImageColor3 = color
                        widget.LeftTick.BackgroundColor3 = color
                        widget.RightTick.BackgroundColor3 = color
                        widget.TextLabel.TextColor3 = color
                        widget.TextLabel.Text = string.format("%s  [%d HP]  %d m", string.upper(plr.DisplayName), curHp, distM)
                        widget.Root.Visible = true
                    elseif Settings.ThreatShowOnScreen then
                        local headSc = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.8, 0)) or sc
                        widget.Root.Position = UDim2.fromOffset(headSc.X, headSc.Y - 26)
                        widget.ArrowFrame.Rotation = 90 -- Arrow points down at enemy head
                        widget.ArrowImage.ImageColor3 = color
                        widget.LeftTick.BackgroundColor3 = color
                        widget.RightTick.BackgroundColor3 = color
                        widget.TextLabel.TextColor3 = color
                        widget.TextLabel.Text = string.format("%s  [%d HP]  %d m", string.upper(plr.DisplayName), curHp, distM)
                        widget.Root.Visible = true
                    else
                        widget.Root.Visible = false
                    end
                end
            end
        end
    end

    for plr, w in pairs(threatIndicators) do
        if not activeSet[plr] then
            if w.Root then w.Root:Destroy() end
            threatIndicators[plr] = nil
        end
    end
end

