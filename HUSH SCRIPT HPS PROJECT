local function SpawnDamagePopup(worldPos, dmgAmount, curHp, maxHp, isArmored, isHeadshot)
    if not Settings.ZombieDmgPopup or not lootGui then return end
    local sc, onScreen = Camera:WorldToViewportPoint(worldPos + Vector3.new(math.random(-6, 6) * 0.06, 2.6 + math.random(0, 6) * 0.05, math.random(-6, 6) * 0.06))
    if not onScreen or sc.Z <= 0 then return end

    local popup = Instance.new("Frame")
    popup.Name = "DmgPopup"
    popup.Size = UDim2.fromOffset(150, 32)
    popup.Position = UDim2.fromOffset(sc.X - 75, sc.Y - 16)
    popup.BackgroundTransparency = 1 -- NO BOX / NO FRAME
    popup.BorderSizePixel = 0
    popup.ZIndex = 25
    popup.Parent = lootGui

    local dmgLabel = Instance.new("TextLabel")
    dmgLabel.Name = "DmgText"
    dmgLabel.Size = UDim2.new(1, 0, 0, 18)
    dmgLabel.Position = UDim2.fromOffset(0, 0)
    dmgLabel.BackgroundTransparency = 1
    dmgLabel.Font = Fonts.Bold
    dmgLabel.TextSize = (curHp and curHp <= 0) and 19 or (isHeadshot and 19 or (dmgAmount >= 70 and 18 or 15))
    dmgLabel.TextStrokeTransparency = 0
    dmgLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    dmgLabel.TextXAlignment = Enum.TextXAlignment.Center
    dmgLabel.TextYAlignment = Enum.TextYAlignment.Center
    dmgLabel.ZIndex = 26
    dmgLabel.Parent = popup

    local reduceLabel = Instance.new("TextLabel")
    reduceLabel.Name = "ReduceText"
    reduceLabel.Size = UDim2.new(1, 0, 0, 14)
    reduceLabel.Position = UDim2.fromOffset(0, 16)
    reduceLabel.BackgroundTransparency = 1
    reduceLabel.Font = Fonts.Medium
    reduceLabel.TextSize = 11
    reduceLabel.TextStrokeTransparency = 0
    reduceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    reduceLabel.TextXAlignment = Enum.TextXAlignment.Center
    reduceLabel.TextYAlignment = Enum.TextYAlignment.Center
    reduceLabel.ZIndex = 26
    reduceLabel.Parent = popup

    if curHp and curHp <= 0 then
        dmgLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
        dmgLabel.Text = string.format("-%d [KILL]", dmgAmount)
        reduceLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        reduceLabel.Text = "HP: 0 [DEAD]"
    elseif isHeadshot then
        dmgLabel.TextColor3 = Color3.fromRGB(255, 65, 65)
        dmgLabel.Text = string.format("-%d [HEADSHOT]", dmgAmount)
        reduceLabel.TextColor3 = Color3.fromRGB(255, 130, 130)
        reduceLabel.Text = (curHp and maxHp) and string.format("HP: %d/%d [CRIT]", curHp, maxHp) or string.format("HP: -%d", dmgAmount)
    elseif isArmored then
        dmgLabel.TextColor3 = Color3.fromRGB(70, 205, 255)
        dmgLabel.Text = string.format("-%d [ARMOR]", dmgAmount)
        reduceLabel.TextColor3 = Color3.fromRGB(150, 225, 255)
        reduceLabel.Text = (curHp and maxHp) and string.format("HP: %d/%d [ARMOR REDUCE]", curHp, maxHp) or string.format("ARMOR: -%d", dmgAmount)
    elseif dmgAmount >= 70 then
        dmgLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
        dmgLabel.Text = string.format("-%d [CRIT]", dmgAmount)
        reduceLabel.TextColor3 = Color3.fromRGB(255, 140, 140)
        reduceLabel.Text = (curHp and maxHp) and string.format("HP: %d/%d (-%d)", curHp, maxHp, dmgAmount) or string.format("HP: -%d", dmgAmount)
    else
        dmgLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        dmgLabel.Text = string.format("-%d DMG", dmgAmount)
        reduceLabel.TextColor3 = Color3.fromRGB(255, 205, 110)
        reduceLabel.Text = (curHp and maxHp) and string.format("HP: %d/%d (-%d)", curHp, maxHp, dmgAmount) or string.format("HP: -%d", dmgAmount)
    end

    table.insert(zombieDmgPopups, popup)

    local tw1 = Tween(popup, 0.85, {
        Position = UDim2.fromOffset(sc.X - 75, sc.Y - 55),
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tw2 = Tween(dmgLabel, 0.45, {
        TextTransparency = 1,
        TextStrokeTransparency = 1,
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local tw3 = Tween(reduceLabel, 0.45, {
        TextTransparency = 1,
        TextStrokeTransparency = 1,
    }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    tw1:Play()
    task.delay(0.4, function()
        tw2:Play()
        tw3:Play()
    end)
    task.delay(0.9, function()
        pcall(function() popup:Destroy() end)
        for i, p in ipairs(zombieDmgPopups) do
            if p == popup then table.remove(zombieDmgPopups, i) break end
        end
    end)
end

local lastHitTimes = {}
local lastAimedZombieId = nil
local lastAimedZombieTime = 0

local function ApplyZombieDamage(zId, rawDmg, pos, forceArmor, forceHeadshot, isServerConfirmed, serverHitDmg, hitPart)
    if not zId then return end
    local now = os.clock()
        -- debounce duplicate network packets
    if lastHitTimes[zId] and (now - lastHitTimes[zId]) < 0.04 then
        return
    end
    lastHitTimes[zId] = now

    local maxHp, isArmoredZ, zTypeName, tObj, armorFactor, headY, prof = GetZombieMaxHP(zId)
    local typeKey = zTypeName or "walker"
    local isHeadshot = (forceHeadshot == true) or (hitPart == "head")
    local isArmored = (forceArmor ~= nil) and forceArmor or isArmoredZ
    if hitPart == "shield" then isArmored = true end

    if not zombieHealthTrack[zId] then
        zombieHealthTrack[zId] = maxHp
    end

    local finalDmg
    if serverHitDmg and serverHitDmg > 0 then
        finalDmg = math.floor(serverHitDmg)
    else
        local baseDmg, headMul, wDef = GetCurrentWeaponDamage()
        baseDmg = rawDmg or baseDmg or 35
        headMul = headMul or 2.0

        local partMul = 1.0
        if HushZombieTypes and type(HushZombieTypes.partMul) == "function" then
            partMul = HushZombieTypes.partMul(hitPart, headMul, isArmored)
        else
            if isHeadshot then
                partMul = isArmored and math.max(1.6, headMul) or math.max(3.0, headMul)
            elseif hitPart == "arm" then
                partMul = 0.6
            elseif hitPart == "leg" then
                partMul = 0.7
            else
                partMul = 1.0
            end
        end

        finalDmg = math.floor(baseDmg * partMul)

        local isRifleOneShot = false
        if isHeadshot and (not isArmored) and wDef and (wDef.kind == "firearm" or wDef.caliber) then
            if HushZombieTypes and HushZombieTypes.RIFLE_ONESHOT and HushZombieTypes.RIFLE_ONESHOT[typeKey] then
                isRifleOneShot = true
                finalDmg = maxHp
            end
        end

        if wDef and wDef.pellets and wDef.pellets > 1 then
            local estPellets = math.clamp(math.floor(wDef.pellets * 0.75), 1, wDef.pellets)
            finalDmg = math.floor(baseDmg * estPellets * (isHeadshot and 1.5 or 1.0))
        end

        if isArmored and not isHeadshot then
            finalDmg = math.max(6, math.floor(finalDmg * (armorFactor or 0.65)))
        elseif isArmored and isHeadshot and not isRifleOneShot then
            finalDmg = math.floor(finalDmg * 0.6)
        end
    end

    local prevHp = zombieHealthTrack[zId] or maxHp
        -- clamp min hp to 1 until server confirms kill
    local minAllowedHp = isServerConfirmed and 0 or 1
    local newHp = math.max(minAllowedHp, prevHp - finalDmg)
    zombieHealthTrack[zId] = newHp

    zombieRecentHit[zId] = {
        dmg = finalDmg,
        prevHp = prevHp,
        newHp = newHp,
        time = now,
        isArmored = isArmored and (not isHeadshot),
        isHeadshot = isHeadshot
    }

    if pos then
        pcall(function()
            SpawnDamagePopup(pos, finalDmg, newHp, maxHp, isArmored and (not isHeadshot), isHeadshot)
        end)
    end
end

-- // combat hooks
pcall(function()
    local rs = game:GetService("ReplicatedStorage")
    local hushFolder = rs:WaitForChild("Hush", 3)
    local sharedFolder = hushFolder and hushFolder:WaitForChild("Shared", 3)
    local hushNet = sharedFolder and require(sharedFolder:WaitForChild("Net", 3))
    if not hushNet then return end

    local function ProcessOutgoingAttack(op, payload)
        if not (op == "combat.fire" or op == "combat.melee" or op == "combat.throw") then return end

        if op == "combat.fire" and type(payload) == "table" then
            local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
            local origin = payload.o or (myChar and myChar:GetPivot().Position)
            local dir = payload.d
            if origin and dir and typeof(dir) == "Vector3" then
                local targets = GetAllLivingZombies()
                local bestZ = nil
                local bestPerp = 4.5
                for _, t in ipairs(targets) do
                    local isEngineDead = (t.zRaw and t.zRaw.dead == true)
                    if t.position and not isEngineDead then
                        local toZ = t.position - origin
                        local proj = toZ:Dot(dir)
                        if proj > 0 and proj <= 350 then
                            local perp = (toZ - dir * proj).Magnitude
                            if perp < bestPerp then
                                bestPerp = perp
                                bestZ = t
                            end
                        end
                    end
                end
                if bestZ then
                    lastAimedZombieId = bestZ.id
                    lastAimedZombieTime = os.clock()
                end
            end
        end

        if op == "combat.fire" or op == "combat.melee" then
            local shouldRedirect = Settings.ZombieSilentAim or Settings.ZombieAimbot or Settings.AimbotEnabled
            if shouldRedirect then
                local targetPos = nil
                local targetZombieObj = nil
                local targetPlayerObj = nil

                if lockedTargetZombie and Settings.ZombieAimbot then
                    targetZombieObj = lockedTargetZombie
                    targetPos = GetZombieHeadPosition(lockedTargetZombie)
                elseif Settings.ZombieSilentAim or Settings.ZombieAimbot then
                    local zObj, zHeadPos = GetClosestZombieToCrosshair(Settings.ZombieAimFOV or 400)
                    if zObj and zHeadPos then
                        targetZombieObj = zObj
                        targetPos = zHeadPos
                    end
                elseif lockedTargetPlayer and Settings.AimbotEnabled then
                    local char = lockedTargetPlayer.Character or Workspace:FindFirstChild(lockedTargetPlayer.Name)
                    local targetPart = GetPlayerTorsoOrHead(char, Settings.AimPart)
                    if targetPart then
                        targetPlayerObj = lockedTargetPlayer
                        targetPos = targetPart.Position
                    end
                elseif Settings.AimbotEnabled then
                    local targetPlr = GetClosestPlayerToCrosshair(Settings.AimbotFOV)
                    if targetPlr then
                        local char = targetPlr.Character or Workspace:FindFirstChild(targetPlr.Name)
                        local targetPart = GetPlayerTorsoOrHead(char, Settings.AimPart)
                        if targetPart then
                            targetPlayerObj = targetPlr
                            targetPos = targetPart.Position
                        end
                    end
                end

                if targetPos then
                    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
                    local origin = (myChar and myChar:GetPivot().Position) or targetPos
                    local distToTarget = (targetPos - origin).Magnitude

                    if op == "combat.melee" and distToTarget > 7.5 then
                        return
                    end

                    local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
                    local eyePos = myTorso and (myTorso.Position + Vector3.new(0, 1.2, 0)) or origin
                    local wallBlocked = false
                    if targetZombieObj and Settings.ZombieWallCheck then
                        wallBlocked = not IsTargetVisibleThroughWalls(eyePos, targetPos, targetZombieObj.model)
                    elseif targetPlayerObj and Settings.WallCheck then
                        wallBlocked = not IsTargetVisibleThroughWalls(eyePos, targetPos, targetPlayerObj.Character)
                    end

                    if not wallBlocked and type(payload) == "table" then
                        if op == "combat.fire" then
                            local fireOrigin = payload.o or origin
                            payload.d = (targetPos - fireOrigin).Unit
                            payload.ay = math.atan2(-(targetPos.X - fireOrigin.X), -(targetPos.Z - fireOrigin.Z))
                            payload.a = true
                        elseif op == "combat.melee" then
                            local flatDir = Vector3.new(targetPos.X - origin.X, 0, targetPos.Z - origin.Z)
                            if flatDir.Magnitude > 0 then payload.d = flatDir.Unit end
                        end

                        if targetZombieObj then
                            payload.targetId = targetZombieObj.id
                            payload.zombieId = targetZombieObj.id
                            payload.part = "head"
                            payload.hitPart = "head"
                            payload.headshot = true
                            payload.isHeadshot = true
                            payload.hitPos = targetPos
                            payload.targetPos = targetPos
                            payload.pos = targetPos
                            if type(payload.hits) == "table" then
                                for _, h in ipairs(payload.hits) do
                                    if type(h) == "table" then
                                        h.targetId = targetZombieObj.id
                                        h.zombieId = targetZombieObj.id
                                        h.part = "head"
                                        h.hitPart = "head"
                                        h.headshot = true
                                        h.pos = targetPos
                                    end
                                end
                            end
                            lastAimedZombieId = targetZombieObj.id
                            lastAimedZombieTime = os.clock()
                        end
                        return
                    end
                end
            end
        end
    end

    if type(hushNet.fire) == "function" then
        if _G.HPS_OrigNetFire then hushNet.fire = _G.HPS_OrigNetFire end
        _G.HPS_OrigNetFire = hushNet.fire
        local origFire = _G.HPS_OrigNetFire
        hushNet.fire = function(op, payload, ...)
            pcall(ProcessOutgoingAttack, op, payload)
            return origFire(op, payload, ...)
        end
    end

    if type(hushNet.send) == "function" then
        if _G.HPS_OrigNetSend then hushNet.send = _G.HPS_OrigNetSend end
        _G.HPS_OrigNetSend = hushNet.send
        local origSend = _G.HPS_OrigNetSend
        hushNet.send = function(op, payload, ...)
            pcall(ProcessOutgoingAttack, op, payload)
            return origSend(op, payload, ...)
        end
    end

    if type(hushNet.listen) == "function" then
        if _G.HPS_ZombieEventListener then pcall(function() _G.HPS_ZombieEventListener:Disconnect() end) end
        if _G.HPS_CombatHitListener then pcall(function() _G.HPS_CombatHitListener:Disconnect() end) end

        local localPlayerHitTimes = {}

        _G.HPS_ZombieEventListener = hushNet.listen("zombie.event", function(evType, zId, ...)
            if not zId then return end
            local zIdStr = tostring(zId)
            local zIdNum = tonumber(zId)

            if evType == "die" then
                zombieHealthTrack[zIdStr] = 0
                if zIdNum then zombieHealthTrack[zIdNum] = 0 end
                if zombieRecentHit[zIdStr] then zombieRecentHit[zIdStr].newHp = 0 end
                if zIdNum and zombieRecentHit[zIdNum] then zombieRecentHit[zIdNum].newHp = 0 end

                if zombieBadges[zIdStr] and zombieBadges[zIdStr].Root then
                    pcall(function() zombieBadges[zIdStr].Root:Destroy() end)
                    zombieBadges[zIdStr] = nil
                end
                if zIdNum and zombieBadges[zIdNum] and zombieBadges[zIdNum].Root then
                    pcall(function() zombieBadges[zIdNum].Root:Destroy() end)
                    zombieBadges[zIdNum] = nil
                end

                if zombieHighlights[zIdStr] then
                    pcall(function() zombieHighlights[zIdStr]:Destroy() end)
                    zombieHighlights[zIdStr] = nil
                end
                if zIdNum and zombieHighlights[zIdNum] then
                    pcall(function() zombieHighlights[zIdNum]:Destroy() end)
                    zombieHighlights[zIdNum] = nil
                end

                pcall(function()
                    if Workspace:FindFirstChild("HushLocal") and Workspace.HushLocal:FindFirstChild("Zombies") then
                        for _, m in ipairs(Workspace.HushLocal.Zombies:GetChildren()) do
                            local hl = m:FindFirstChild("HPS_ZombieChams")
                            if hl and (m.Name == zIdStr or m:GetAttribute("Corpse") == true or m:GetAttribute("Dead") == true) then
                                hl:Destroy()
                            end
                        end
                    end
                end)
            elseif evType == "hit" then
                local wasOurHit = localPlayerHitTimes[zIdStr] and (os.clock() - localPlayerHitTimes[zIdStr] < 0.25)
                if wasOurHit then
                    return
                end

                local hitArgs = {...}
                local isHead = (hitArgs[6] == true)
                local part = tostring(hitArgs[8] or ""):lower()
                if part == "head" then isHead = true end

                local maxHp, isArmoredZ = GetZombieMaxHP(zIdStr)
                local curHp = zombieHealthTrack[zIdStr] or maxHp

                local allyDmg = isHead and 40 or ((part == "arm" or part == "leg") and 12 or 22)
                if isArmoredZ and not isHead then
                    allyDmg = math.floor(allyDmg * 0.65)
                end

                local newHp = math.max(5, curHp - allyDmg)
                zombieHealthTrack[zIdStr] = newHp
                if zIdNum then zombieHealthTrack[zIdNum] = newHp end

                zombieRecentHit[zIdStr] = {
                    dmg = allyDmg,
                    prevHp = curHp,
                    newHp = newHp,
                    time = os.clock(),
                    isArmored = isArmoredZ and (not isHead),
                    isHeadshot = isHead,
                    isAlly = true
                }
            end
        end)

        _G.HPS_CombatHitListener = hushNet.listen("combat.hit", function(hitData)
            if type(hitData) ~= "table" then return end
            local hitPos = hitData.pos
            local kind = hitData.kind
            local hitTargetId = hitData.targetId or hitData.id or hitData.zombieId
            local targets = GetAllLivingZombies()
            local matchedId = nil

            if hitTargetId then
                hitTargetId = tostring(hitTargetId)
                for _, t in ipairs(targets) do
                    if tostring(t.id) == hitTargetId then matchedId = tostring(t.id) break end
                end
            end

            if not matchedId and lastAimedZombieId and (os.clock() - lastAimedZombieTime < 0.45) then
                local aimedStr = tostring(lastAimedZombieId)
                for _, t in ipairs(targets) do
                    if tostring(t.id) == aimedStr then matchedId = aimedStr break end
                end
            end

            if not matchedId and typeof(hitPos) == "Vector3" then
                local minDist = 14
                for _, t in ipairs(targets) do
                    if t.position then
                        local d = (t.position - hitPos).Magnitude
                        if d < minDist then
                            minDist = d
                            matchedId = tostring(t.id)
                        end
                    end
                end
            end

            if matchedId then
                localPlayerHitTimes[matchedId] = os.clock()
                local maxHp, isArmoredZ = GetZombieMaxHP(matchedId)

                if kind == "kill" then
                    zombieHealthTrack[matchedId] = 0
                    if zombieRecentHit[matchedId] then
                        zombieRecentHit[matchedId].newHp = 0
                    end
                    if zombieBadges[matchedId] and zombieBadges[matchedId].Root then
                        pcall(function() zombieBadges[matchedId].Root:Destroy() end)
                        zombieBadges[matchedId] = nil
                    end
                    if zombieHighlights[matchedId] then
                        pcall(function() zombieHighlights[matchedId]:Destroy() end)
                        zombieHighlights[matchedId] = nil
                    end
                    for _, t in ipairs(targets) do
                        if tostring(t.id) == matchedId and t.model then
                            local hl = t.model:FindFirstChild("HPS_ZombieChams")
                            if hl then pcall(function() hl:Destroy() end) end
                        end
                    end
                    local popPos = (typeof(hitPos) == "Vector3") and hitPos or nil
                    if not popPos then
                        for _, t in ipairs(targets) do
                            if tostring(t.id) == matchedId then popPos = GetZombieHeadPosition(t) break end
                        end
                    end
                    if popPos then
                        pcall(function() SpawnDamagePopup(popPos, 100, 0, maxHp, false, false) end)
                    end
                else
                    local part = tostring(hitData.part or ""):lower()
                    local isHead = (hitData.headshot == true or hitData.isHeadshot == true or part == "head")
                    local isArmored = (hitData.armor == true or part == "shield")

                    ApplyZombieDamage(matchedId, nil, (typeof(hitPos) == "Vector3") and hitPos or nil, isArmored, isHead, false, nil, part)

                    if zombieHealthTrack[matchedId] and zombieHealthTrack[matchedId] <= 1 then
                        zombieHealthTrack[matchedId] = math.max(25, math.floor(maxHp * 0.35))
                        if zombieRecentHit[matchedId] then
                            zombieRecentHit[matchedId].newHp = zombieHealthTrack[matchedId]
                        end
                    end
                end
            end
        end)
    end

    _G.HPS_RestoreNetHooks = function()
        if _G.HPS_OrigNetFire and hushNet and hushNet.fire then hushNet.fire = _G.HPS_OrigNetFire end
        if _G.HPS_OrigNetSend and hushNet and hushNet.send then hushNet.send = _G.HPS_OrigNetSend end
        if _G.HPS_ZombieEventListener then pcall(function() _G.HPS_ZombieEventListener:Disconnect() end) end
        if _G.HPS_CombatHitListener then pcall(function() _G.HPS_CombatHitListener:Disconnect() end) end
    end
end)

local lastCorpseSweepTime = 0
local function UpdateZombieESP()
    if not lootGui then return end

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position or Vector3.new(0, 0, 0)

    local activeZBadges = {}
    local activeZRadar = {}
    local activeZHighlights = {}
    local placedZombieSlots = {}
    local range = Settings.RadarRange or 800
    local radius = (Settings.RadarSize or 180) / 2
    local usableRadius = radius - 10
    local isPlayerFacing = (Settings.RadarOrientation == "Player-Facing")
    local fwd = isPlayerFacing and (Camera.CFrame.LookVector) or Vector3.new(0, 0, -1)
    fwd = Vector3.new(fwd.X, 0, fwd.Z).Unit
    local rgt = isPlayerFacing and (Camera.CFrame.RightVector) or Vector3.new(1, 0, 0)
    rgt = Vector3.new(rgt.X, 0, rgt.Z).Unit

    local maxZHighlights = 12
    local activeZChamsCount = 0
    local maxZBadges = 25
    local renderedZBadgeCount = 0

    local rawTargets = GetAllLivingZombies()
    local livingZombieIds = {}
    local targets = {}

    for _, t in ipairs(rawTargets) do
        local zId = tostring(t.id)
        if zId then
            livingZombieIds[zId] = true
        end

        if t.position and zId then
            local distStuds = (t.position - myPos).Magnitude
            if distStuds <= (Settings.ZombieMaxDistance or 1200) then
                t.distStuds = distStuds
                t.distM = math.floor(distStuds * 0.28)
                table.insert(targets, t)
            end
        end
    end

    table.sort(targets, function(a, b)
        return a.distStuds < b.distStuds
    end)

    for _, t in ipairs(targets) do
        local zId = tostring(t.id)
        local zPos = t.position
        local distStuds = t.distStuds
        local distM = t.distM

        local typeId = (t.typeId or "walker"):lower()
        local maxHp, isArmoredZ, zTypeName, tObj, armorFactor, headY, prof = GetZombieMaxHP(zId)
        prof = prof or GetZombieProfile(typeId)
        if not zombieHealthTrack[zId] then
            zombieHealthTrack[zId] = maxHp
        end
        local curHp = zombieHealthTrack[zId]

        local isEngineDead = (t.zRaw and (t.zRaw.dead == true or t.zRaw.state == 7 or t.zRaw.actState == 7 or (t.zRaw.deadAt and t.zRaw.deadAt > 0)))
        if t.model and (t.model:GetAttribute("Corpse") == true or t.model:GetAttribute("Dead") == true) then
            isEngineDead = true
        end
        if curHp <= 0 then
            isEngineDead = true
        end

        if not isEngineDead then
            curHp = math.max(1, curHp)
            local zLabel = prof.label or ("[" .. typeId:upper() .. "]")
            if t.isLying then
                zLabel = zLabel .. " [AMBUSH]"
            end
            local zColor = prof.color or Color3.fromRGB(255, 90, 90)

            if Settings.ZombieChams and t.model and (distStuds <= 350) and (activeZChamsCount < maxZHighlights) then
                activeZChamsCount = activeZChamsCount + 1
                activeZHighlights[zId] = true
                local hl = zombieHighlights[zId]
                if not hl or hl.Parent ~= t.model then
                    if hl then pcall(function() hl:Destroy() end) end
                    hl = Instance.new("Highlight")
                    hl.Name = "HPS_ZombieChams"
                    hl.FillTransparency = 0.55
                    hl.OutlineTransparency = 0.05
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Adornee = t.model
                    hl.Parent = t.model
                    zombieHighlights[zId] = hl
                end
                local hpPct = math.clamp(curHp / maxHp, 0, 1)
                hl.FillColor = zColor
                hl.OutlineColor = isArmoredZ and Color3.fromRGB(70, 210, 255) or Color3.fromHSV(hpPct * 0.33, 1, 1)
                hl.Enabled = true
            else
                if zombieHighlights[zId] and zombieHighlights[zId].Enabled then
                    zombieHighlights[zId].Enabled = false
                end
            end

            if Settings.ZombieESP and (renderedZBadgeCount < maxZBadges) then
                local toZ = zPos - Camera.CFrame.Position
                if Camera.CFrame.LookVector:Dot(toZ) > 0 then
                    local sc, onScreen = Camera:WorldToViewportPoint(zPos + Vector3.new(0, 3.2, 0))
                    if onScreen and sc.Z > 0 then
                        renderedZBadgeCount = renderedZBadgeCount + 1
                        activeZBadges[zId] = true
                        local badge = zombieBadges[zId]
                        if not badge or not badge.Root.Parent then
                            badge = CreateZombieBadge("z_" .. tostring(zId))
                            zombieBadges[zId] = badge
                        end

                        local hpPct = math.clamp(curHp / maxHp, 0, 1)
                        local hpColor = Color3.fromHSV(hpPct * 0.33, 1, 1)

                        local placeX, placeY = GetNonOverlappingScreenPos(sc.X, sc.Y - 6, placedZombieSlots, 120, 28)
                                badge.Root.Position = UDim2.fromOffset(placeX, placeY)
                                badge.TopLabel.TextColor3 = zColor
                                badge.TopLabel.Text = string.format("%s  %dm", zLabel, distM)
                                local hitInfo = zombieRecentHit[zId]
                                local isRecentlyHit = hitInfo and (os.clock() - hitInfo.time < 1.6)

                                if isRecentlyHit then
                                    if hitInfo.isHeadshot then
                                        badge.SubLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
                                        badge.SubLabel.Text = string.format("HP: %d / %d  (-%d [HEADSHOT])", curHp, maxHp, hitInfo.dmg)
                                    elseif hitInfo.isArmored then
                                        badge.SubLabel.TextColor3 = Color3.fromRGB(75, 210, 255)
                                        badge.SubLabel.Text = string.format("HP: %d / %d  (-%d [ARMOR])", curHp, maxHp, hitInfo.dmg)
                                    else
                                        badge.SubLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
                                        badge.SubLabel.Text = string.format("HP: %d / %d  (-%d HP)", curHp, maxHp, hitInfo.dmg)
                                    end
                                else
                                    badge.SubLabel.TextColor3 = (curHp <= 1) and Color3.fromRGB(255, 50, 50) or hpColor
                                    if curHp <= 1 then
                                        badge.SubLabel.Text = string.format("HP: 1 / %d  [CRITICAL]", maxHp)
                                    elseif isArmoredZ then
                                        badge.SubLabel.Text = string.format("HP: %d / %d  [%s]", curHp, maxHp, prof.tag or "ARMORED")
                                    else
                                        badge.SubLabel.Text = string.format("HP: %d / %d", curHp, maxHp)
                                    end
                                end
                                badge.Root.Visible = true
                            end
                        end
                    end

                    if Settings.ZombieRadar and radarFrame and distStuds <= range then
                        local zFlat = Vector3.new(zPos.X - myPos.X, 0, zPos.Z - myPos.Z)
                        local zRelX = zFlat:Dot(rgt)
                        local zRelY = zFlat:Dot(fwd)
                        local zNormX = zRelX / range
                        local zNormY = zRelY / range
                        local zDistRatio = math.sqrt(zNormX * zNormX + zNormY * zNormY)

                        if zDistRatio <= 1.0 then
                            activeZRadar[zId] = true
                            local blip = zombieRadarBlips[zId]
                            if not blip or not blip.Dot.Parent then
                                local dot = Instance.new("Frame")
                                dot.Size = UDim2.fromOffset(4, 4)
                                dot.BorderSizePixel = 0
                                dot.ZIndex = 4
                                dot.Parent = radarFrame
                                Corner(dot, 2)
                                blip = { Dot = dot }
                                zombieRadarBlips[zId] = blip
                            end
                            local blipX = radius + (zNormX * usableRadius) - 2
                            local blipY = radius - (zNormY * usableRadius) - 2
                            blip.Dot.Position = UDim2.fromOffset(blipX, blipY)
                            blip.Dot.BackgroundColor3 = zColor
                            blip.Dot.Visible = true
                        end
                    end
                end
            end

    for zId, badge in pairs(zombieBadges) do
        if not activeZBadges[zId] then
            if not livingZombieIds[zId] then
                if badge.Root then badge.Root:Destroy() end
                zombieBadges[zId] = nil
            else
                if badge.Root.Visible then badge.Root.Visible = false end
            end
        end
    end
    for zId, blip in pairs(zombieRadarBlips) do
        if not activeZRadar[zId] then
            if not livingZombieIds[zId] then
                if blip.Dot then blip.Dot:Destroy() end
                zombieRadarBlips[zId] = nil
            else
                if blip.Dot.Visible then blip.Dot.Visible = false end
            end
        end
    end
    for zId, hl in pairs(zombieHighlights) do
        if not activeZHighlights[zId] then
            if not livingZombieIds[zId] then
                if hl then pcall(function() hl:Destroy() end) end
                zombieHighlights[zId] = nil
            else
                if hl.Enabled then hl.Enabled = false end
            end
        end
    end

    local nowClock = os.clock()
    if nowClock - lastCorpseSweepTime >= 2.0 then
        lastCorpseSweepTime = nowClock
        pcall(function()
            if Workspace:FindFirstChild("HushLocal") and Workspace.HushLocal:FindFirstChild("Zombies") then
                for _, zm in ipairs(Workspace.HushLocal.Zombies:GetChildren()) do
                    if zm:GetAttribute("Corpse") == true or zm:GetAttribute("Dead") == true or zm:GetPivot().Position.Y < -1000 then
                        local ch = zm:FindFirstChild("HPS_ZombieChams")
                        if ch then pcall(function() ch:Destroy() end) end
                    end
                end
            end
        end)
    end

    for zId in pairs(zombieHealthTrack) do
        if not livingZombieIds[zId] then
            zombieHealthTrack[zId] = nil
            zombieRecentHit[zId] = nil
        end
    end
end

