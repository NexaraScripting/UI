local function GetPlayerTorsoOrHead(char, preference)
    if not char then return nil end
    if preference == "Head" then
        return char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    end
end

local function IsPlayerAlive(plr)
    if not plr or plr == LocalPlayer then return false end
    local char = plr.Character or Workspace:FindFirstChild(plr.Name)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = GetPlayerTorsoOrHead(char, "Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    if not root then return false end
    if hum and hum.Health <= 0 then return false end
    if char:GetAttribute("Dead") == true or char:GetAttribute("Dying") == true then return false end
    return true
end

