local function IsPlaceholderViewport(vpFrame)
    if not vpFrame then return true end
    local parts = {}
    for _, desc in ipairs(vpFrame:GetDescendants()) do
        if desc:IsA("BasePart") then
            table.insert(parts, desc)
        end
    end
    if #parts <= 1 then
        if #parts == 0 then return true end
        local c = parts[1].Color
        if math.abs(c.R - 70/255) < 0.05 and math.abs(c.G - 73/255) < 0.05 and math.abs(c.B - 77/255) < 0.05 then
            return true
        end
    end
    return false
end

