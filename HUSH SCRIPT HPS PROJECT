local cachedLivingZombies = {}
local lastLivingZombiesFrame = -1

local function GetAllLivingZombies()
    if lastLivingZombiesFrame == frameCount and #cachedLivingZombies > 0 then
        return cachedLivingZombies
    end
    lastLivingZombiesFrame = frameCount

    local list = {}
    local seen = {}

    pcall(function()
        if HushZombieRender and getupvalues then
            local uvs = getupvalues(HushZombieRender.targets)
            local allTable = uvs and uvs[1]
            if allTable and type(allTable) == "table" then
                for id, z in pairs(allTable) do
                    if type(z) == "table" then
                        local zId = tostring(z.id or id)
                        local isBossKind = tostring(z.kind or ""):lower():find("boss") ~= nil
                        local isDead = (z.dead == true)
                            or (z.state == 7)
                            or (z.actState == 7)
                            or (z.deadAt and z.deadAt > 0)

                        if not isBossKind and (zombieHealthTrack[zId] == 0) then
                            isDead = true
                        end

                        if z.rig and z.rig.model then
                            if z.rig.model:GetAttribute("Corpse") == true or z.rig.model:GetAttribute("Dead") == true then
                                isDead = true
                            end
                        end

                        if not isDead then
                            seen[zId] = true

                            local pos = nil
                            if z.rig and z.rig.root and z.rig.root:IsA("BasePart") then
                                pos = z.rig.root.Position
                            elseif z.rig and z.rig.model and z.rig.model:IsA("Model") then
                                pos = z.rig.model:GetPivot().Position
                            elseif z.x and z.z then
                                local myChar = LocalPlayer and (LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name)))
                                local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso"))
                                local refY = myRoot and myRoot.Position.Y or (Camera and Camera.CFrame.Position.Y - 20) or 5.0
                                local groundY = (z.y and z.y ~= 0) and z.y or refY
                                local h = (z.def and z.def.height) or 5.0
                                local isL = (z.wasLying == true or (z.state and tostring(z.state):lower():find("lying")) or (z.kind == "crawler"))
                                if isL then h = h * 0.35 end
                                pos = Vector3.new(z.x, groundY + h, z.z)
                            end

                            if pos then
                                local isLying = (z.wasLying == true or (z.state and tostring(z.state):lower():find("lying")) or (z.kind == "crawler"))
                                table.insert(list, {
                                    id = zId,
                                    position = pos,
                                    typeId = z.kind or "walker",
                                    isLying = isLying,
                                    model = z.rig and z.rig.model,
                                    zRaw = z
                                })
                            end
                        else
                            if zombieBadges[zId] then
                                if zombieBadges[zId].Root then
                                    pcall(function() zombieBadges[zId].Root:Destroy() end)
                                end
                                zombieBadges[zId] = nil
                            end
                            if zombieHighlights[zId] then
                                pcall(function() zombieHighlights[zId]:Destroy() end)
                                zombieHighlights[zId] = nil
                            end
                        end
                    end
                end
            end
        end
    end)

    if #list == 0 and HushZombieRender and HushZombieRender.targets then
        for _, t in ipairs(HushZombieRender.targets()) do
            local zId = tostring(t.id)
            local isCorpse = false
            if t.model and (t.model:GetAttribute("Corpse") == true or t.model:GetAttribute("Dead") == true) then
                isCorpse = true
            end
            if not seen[zId] and t.position and not isCorpse and zombieHealthTrack[zId] ~= 0 then
                seen[zId] = true
                table.insert(list, {
                    id = zId,
                    position = t.position,
                    typeId = t.typeId or "walker",
                    isLying = (t.typeId == "crawler"),
                    model = t.model
                })
            end
        end
    end

    cachedLivingZombies = list
    return list
end

