local cachedShopItems = nil
local lastShopItemsFetchTime = 0

local function GetShopDatabase(forceFresh)
    local nowClock = os.clock()
    if cachedShopItems and not forceFresh and (nowClock - lastShopItemsFetchTime < 2.0) then
        return cachedShopItems
    end

    local Rep = game:GetService("ReplicatedStorage")
    local hush = Rep:FindFirstChild("Hush")
    local shared = hush and hush:FindFirstChild("Shared")
    local TradersMod = shared and shared:FindFirstChild("Traders")
    local ItemsMod = shared and shared:FindFirstChild("Items")
    if not (TradersMod and ItemsMod) then return cachedShopItems or {} end

    local okT, traders = pcall(require, TradersMod)
    local okI, items = pcall(require, ItemsMod)
    if not (okT and okI and traders and items and traders.defs) then return cachedShopItems or {} end

    local function getBasePrice(id)
        local it = items.get(id)
        return it and it.value or 0
    end

    local CAT_MAP = {
        firearm    = "weapons",
        melee      = "weapons",
        throwable  = "weapons",
        ammo       = "ammo",
        attachment = "attachments",
        medical    = "medical",
        food       = "medical",
        armor      = "gear",
        helmet     = "gear",
        bag        = "gear",
        secure     = "gear",
        key        = "gear",
        quest      = "gear",
        valuable   = "valuables",
        material   = "valuables",
    }

    local serverData = FetchTradersServerData(forceFresh)
    local list = {}

    for _, tId in ipairs({"doc", "gunner", "scrapper"}) do
        local def = traders.defs[tId]
        local baseOffers = (def and def.offers) or {}
        local serverOffers = (serverData and serverData.traders and serverData.traders[tId] and serverData.traders[tId].offers) or {}

        local staticKeys = {}
        local combinedOffers = {}

        for _, off in ipairs(baseOffers) do
            staticKeys[off.key] = off
            table.insert(combinedOffers, off)
        end

        for _, sOff in ipairs(serverOffers) do
            if not staticKeys[sOff.key] then
                table.insert(combinedOffers, sOff)
            end
        end

        local serverStateByKey = {}
        for _, sOff in ipairs(serverOffers) do
            serverStateByKey[sOff.key] = sOff
        end

        for _, off in ipairs(combinedOffers) do
            local liveState = serverStateByKey[off.key]
            local baseRef = staticKeys[off.key:gsub("_l%d+$", "")] or off

            local itemId = off.id or (off.items and off.items[1] and off.items[1].id)
            if not itemId and baseRef then
                itemId = baseRef.id or (baseRef.items and baseRef.items[1] and baseRef.items[1].id)
            end

            local it = itemId and items.get(itemId)
            local rawCat = it and it.category or "unknown"
            local mappedCat = CAT_MAP[rawCat] or "valuables"

            local price = (liveState and liveState.price) or off.price or 0
            if price <= 0 then
                pcall(function()
                    price = traders.buyPrice(off, getBasePrice)
                end)
            end
            if price <= 0 and liveState and liveState.basePrice then
                price = liveState.basePrice
            end
            if price <= 0 then
                local baseVal = (it and it.value) or 100
                local mul = off.mul or 1.0
                local nQty = (liveState and liveState.n) or off.n or 1
                price = math.floor(baseVal * mul * ((off.kind == "ammo" or mappedCat == "ammo") and 1 or nQty))
            end

            local nQty = (liveState and liveState.n) or off.n or 1
            local stockLeft = liveState and liveState.left
            local offerLvl = (liveState and liveState.lvl) or off.lvl or 1
            local offerLimit = (liveState and liveState.limit) or off.limit

            local displayName = off.name or (it and it.name) or (baseRef and baseRef.name) or off.key or "Item"
            local desc = it and it.desc or ""
            local weight = it and it.weight or 0
            local rarity = it and it.rarity or 1

            local details = {}
            if mappedCat == "ammo" then
                local cal = it and it.tags and (it.tags["9mm"] and "9mm" or it.tags["45"] and ".45" or it.tags["556"] and "5.56" or it.tags["762"] and "7.62" or it.tags["12ga"] and "12ga" or it.tags["308"] and ".308")
                if not cal and (off.key:match("762") or (itemId and itemId:match("762"))) then
                    cal = "7.62"
                end
                if cal then table.insert(details, "Cal: " .. cal) end
                if nQty > 1 then table.insert(details, "Pack: x" .. tostring(nQty)) end
            elseif mappedCat == "medical" then
                if it and it.use and it.use.heal then
                    table.insert(details, "Heal +" .. tostring(it.use.heal) .. " HP")
                end
            elseif mappedCat == "gear" then
                if it and it.armor then table.insert(details, "Armor: " .. tostring(it.armor)) end
                if it and it.slots then table.insert(details, "Slots: " .. tostring(it.slots)) end
            end
            if weight > 0 then
                table.insert(details, string.format("%.2f kg", weight))
            end

            local catColor = Color3.fromRGB(175, 200, 230)
            for _, cDef in ipairs(SHOP_CATEGORIES) do
                if cDef.id == mappedCat then
                    catColor = cDef.color
                    break
                end
            end

            local icon = off.icon or off.image or (it and (it.icon or it.image or it.thumbnail or it.texture or it.assetId))
            local isCustom = true
            if not icon then
                isCustom = false
                icon = (mappedCat == "weapons" and Icons.Combat)
                    or (mappedCat == "ammo" and Icons.Zap)
                    or (mappedCat == "medical" and Icons.Shield)
                    or (mappedCat == "gear" and Icons.Player)
                    or (mappedCat == "attachments" and Icons.Crosshair)
                    or Icons.Loot
            elseif type(icon) == "number" or not tostring(icon):match("://") then
                icon = "rbxassetid://" .. tostring(icon)
            end

            table.insert(list, {
                key        = off.key,
                itemId     = itemId,
                trader     = tId,
                traderName = def.name or tId:upper(),
                name       = displayName,
                desc       = desc,
                cat        = mappedCat,
                catColor   = catColor,
                rawCat     = rawCat,
                price      = price,
                lvl        = offerLvl,
                n          = nQty,
                limit      = offerLimit,
                stockLeft  = stockLeft,
                rarity     = rarity,
                icon       = icon,
                isCustom   = isCustom,
                details    = table.concat(details, "  •  ")
            })
        end
    end

    cachedShopItems = list
    lastShopItemsFetchTime = nowClock
    return list
end

local function GetTraderCountdown(tId)
    local tData = FetchTradersServerData(false)
    local now = os.time()
    if not tData then return nil end

    if tId and tId ~= "all" then
        local tInfo = tData.traders and tData.traders[tId]
        local restockAt = tInfo and tonumber(tInfo.restockAt) or tonumber(tData.restockAt)
        if restockAt then
            return math.max(0, restockAt - now), restockAt
        end
    else
        local minSec = nil
        local nearestTrader = nil
        local nearestAt = nil
        if tData.traders then
            for id, info in pairs(tData.traders) do
                local at = tonumber(info.restockAt) or tonumber(tData.restockAt)
                if at then
                    local diff = math.max(0, at - now)
                    if minSec == nil or diff < minSec then
                        minSec = diff
                        nearestTrader = id
                        nearestAt = at
                    end
                end
            end
        end
        if minSec == nil and tData.restockAt then
            minSec = math.max(0, tonumber(tData.restockAt) - now)
            nearestAt = tonumber(tData.restockAt)
        end
        return minSec, nearestAt, nearestTrader
    end
    return nil
end

