local function UpdateExtractESP()
    local now = os.clock()
    if now - lastExtractScan < 0.25 then return end
    lastExtractScan = now

    local raid = Workspace:FindFirstChild("Raid")
    local extracts = raid and raid:FindFirstChild("Extracts")
    if not extracts then
        for _, bb in pairs(extractBadges) do if bb then bb.Enabled = false end end
        for _, hl in pairs(extractHighlights) do if hl then hl.Enabled = false end end
        return
    end

    local myChar = LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name))
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position or Vector3.zero

    for _, part in ipairs(extracts:GetChildren()) do
