local cachedBuildingStatics = {}
local function GetBuildingStatic(b)
    local bId = (b.GetAttribute and b:GetAttribute("BuildingId")) or b.Name or "Building"
    local cached = cachedBuildingStatics[bId]
    if not cached or not cached.Model.Parent then
        local cf, size
        if b:IsA("Model") then
            cf, size = b:GetBoundingBox()
        elseif b:IsA("BasePart") then
            cf, size = b.CFrame, b.Size
        else
            local p = b:FindFirstChildWhichIsA("BasePart", true)
            if p then
                cf, size = p.CFrame, p.Size
            else
                cf = CFrame.new(0, 0, 0)
                size = Vector3.new(0, 0, 0)
            end
        end
        local roofPos = Vector3.new(cf.Position.X, cf.Position.Y + size.Y / 2 + 5, cf.Position.Z)
        cached = {
            Model = b,
            Id = bId,
            Name = FormatBuildingName(b.Name, bId),
            Position = roofPos,
            GroundPos = cf.Position
        }
        cachedBuildingStatics[bId] = cached
    end
    return cached
end

local function ScanLootWorld()
    if not ItemsDatabase then
        pcall(function()
            local rs = game:GetService("ReplicatedStorage")
            ItemsDatabase = require(rs:WaitForChild("Hush", 3):WaitForChild("Shared", 3):WaitForChild("Items", 3))
        end)
    end
    if not ItemsDatabase then return end

    local newLoot = {}
    local seenInstances = {}
    local buildingsMap = {}

    for _, b in ipairs(CollectionService:GetTagged("HushBuilding")) do
        pcall(function()
            local bStatic = GetBuildingStatic(b)
            if bStatic and bStatic.Id then
                buildingsMap[bStatic.Id] = {
                    Model = bStatic.Model,
                    Id = bStatic.Id,
                    Name = bStatic.Name,
                    Position = bStatic.Position,
                    GroundPos = bStatic.GroundPos,
                    TotalValue = 0,
                    ContainersCount = 0,
                    TopItem = nil,
                    TopItemValue = 0,
                    ItemsList = {}
                }
            end
        end)
    end

    if Settings.LootContainers then
        local containerSources = {}
        for _, c in ipairs(CollectionService:GetTagged("HushContainer")) do
            table.insert(containerSources, c)
        end
        local raid = Workspace:FindFirstChild("Raid")
        local cFolder = raid and raid:FindFirstChild("Containers")
        if cFolder then
            for _, c in ipairs(cFolder:GetChildren()) do
                if not seenInstances[c] then
                    table.insert(containerSources, c)
                end
            end
        end

        for _, c in ipairs(containerSources) do
            if not seenInstances[c] and c.Parent ~= nil then
                seenInstances[c] = true
                local isLooted = c:GetAttribute("Looted") == true
                local carried = c:GetAttribute("CarriedByZombie") == true

                if not isLooted and not carried then
                    local lootIdsStr = c:GetAttribute("LootIds")
                    local totalVal = 0
                    local topItemName = nil
                    local topItemVal = 0
                    local itemsList = {}
                    local hasStreamed = false

                    local itemsWithPrices = {}
                    if lootIdsStr and lootIdsStr ~= "" then
                        hasStreamed = true
                        for id in lootIdsStr:gmatch("[^,]+") do
                            local it = ItemsDatabase.get(id)
                            if it then
                                local v = it.value or 0
                                totalVal = totalVal + v
                                table.insert(itemsList, it.name)
                                table.insert(itemsWithPrices, string.format("%s (%s)", it.name, FormatPrice(v)))
                                if v > topItemVal then
                                    topItemVal = v
                                    topItemName = it.name
                                end
                            end
                        end
                    end

                    local kind = c:GetAttribute("Kind") or c:GetAttribute("Container") or c.Name
                    local bId = c:GetAttribute("BuildingId") or "outside"

                    if not hasStreamed then
                        local baseVal = CONTAINER_BASELINE_VALUES[kind] or 100
                        totalVal = baseVal
                        topItemVal = baseVal
                        topItemName = kind
                        table.insert(itemsList, kind)
                    end

                    local pos = c:IsA("Model") and c:GetPivot().Position or (c:IsA("BasePart") and c.Position or Vector3.new(0, 0, 0))

                    if totalVal > 0 and bId ~= "outside" then
                        local bEntry = buildingsMap[bId]
                        if not bEntry then
                            bEntry = {
                                Id = bId,
                                Name = FormatBuildingName(bId, bId),
                                Position = pos + Vector3.new(0, 16, 0),
                                GroundPos = pos,
                                TotalValue = 0,
                                ContainersCount = 0,
                                TopItem = nil,
                                TopItemValue = 0,
                                ItemsList = {}
                            }
                            buildingsMap[bId] = bEntry
                        end
                        bEntry.TotalValue = bEntry.TotalValue + totalVal
                        bEntry.ContainersCount = bEntry.ContainersCount + 1
                        if topItemVal > bEntry.TopItemValue then
                            bEntry.TopItemValue = topItemVal
                            bEntry.TopItem = topItemName
                        end
                    end

                    local isJackpotKind = JACKPOT_CONTAINER_KINDS[kind] == true
                    local isCorpse = (kind == "Body" or kind == "Corpse" or c.Name:lower():find("body") or c.Name:lower():find("corpse"))
                    local passJackpotFilter = true

                    if isCorpse and not Settings.ShowCorpses then
                        passJackpotFilter = false
                    elseif Settings.JackpotOnly then
                        if not isJackpotKind and not hasStreamed then
                            passJackpotFilter = false
                        elseif hasStreamed and totalVal < 1500 then
                            passJackpotFilter = false
                        end
                    end

                    if passJackpotFilter and totalVal >= Settings.MinLootValue then
                        table.insert(newLoot, {
                            Instance = c,
                            Position = pos,
                            Type = "Container",
                            BuildingId = bId,
                            Kind = kind,
                            TotalValue = totalVal,
                            TopItem = topItemName,
                            TopItemValue = topItemVal,
                            ItemsCount = #itemsList,
                            ItemsList = itemsList,
                            ItemsWithPrices = itemsWithPrices,
                            HasStreamed = hasStreamed
                        })
                    end
                end
            end
        end
    end

    if Settings.LootGroundItems then
        local groundSources = {}
        for _, item in ipairs(CollectionService:GetTagged("HushItem")) do
            table.insert(groundSources, item)
        end
        local raid = Workspace:FindFirstChild("Raid")
        local gFolder = Workspace:FindFirstChild("Items") or (raid and raid:FindFirstChild("Items"))
        if gFolder then
            for _, item in ipairs(gFolder:GetChildren()) do
                if not seenInstances[item] then table.insert(groundSources, item) end
            end
        end

        for _, item in ipairs(groundSources) do
            if not seenInstances[item] and item.Parent ~= nil then
                seenInstances[item] = true
                local itemId = item:GetAttribute("ItemId")
                if itemId then
                    local it = ItemsDatabase.get(itemId)
                    if it then
                        local v = it.value or 0
                        if v >= Settings.MinLootValue then
                            local pos = item:IsA("Model") and item:GetPivot().Position or (item:IsA("BasePart") and item.Position or Vector3.new(0, 0, 0))
                            table.insert(newLoot, {
                                Instance = item,
                                Position = pos,
                                Type = "Ground",
                                BuildingId = "outside",
                                Kind = it.name or "Item",
                                TotalValue = v,
                                TopItem = it.name,
                                TopItemValue = v,
                                ItemsCount = 1,
                                HasStreamed = true
                            })
                        end
                    end
                end
            end
        end
    end

    table.sort(newLoot, function(a, b) return a.TotalValue > b.TotalValue end)
    cachedLootData = newLoot

    local newBuildingLoot = {}
    for bId, bData in pairs(buildingsMap) do
        if bData.TotalValue > 0 and bData.ContainersCount > 0 then
            table.insert(newBuildingLoot, bData)
        end
    end
    table.sort(newBuildingLoot, function(a, b) return a.TotalValue > b.TotalValue end)
    cachedBuildingLoot = newBuildingLoot
end

local function GetNonOverlappingScreenPos(rawX, rawY, placedBoxes, boxW, boxH)
    boxW = boxW or 120
    boxH = boxH or 28
    local finalX = rawX
    local finalY = rawY
    local maxShifts = 4
    local shifted = 0

    while shifted < maxShifts do
        local collides = false
        for _, p in ipairs(placedBoxes) do
            if math.abs(finalX - p.x) < boxW and math.abs(finalY - p.y) < boxH then
                finalY = p.y - boxH
                collides = true
                shifted = shifted + 1
                break
            end
        end
        if not collides then
            break
        end
    end

    table.insert(placedBoxes, { x = finalX, y = finalY })
    return finalX, finalY
end

local function UpdateLootESP()
    if not Settings.LootESPEnabled or not lootGui then
        if lootGui then lootGui.Enabled = false end
        if hotspotGui then hotspotGui.Enabled = false end
        for _, hl in pairs(lootHighlights) do if hl then hl.Enabled = false end end
        return
    end
    lootGui.Enabled = true

    if #cachedLootData == 0 then
        task.spawn(ScanLootWorld)
    end

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local marginX = 85
    local marginY = 55
    local halfW = (vp.X / 2) - marginX
    local halfH = (vp.Y / 2) - marginY

    local camCF = Camera.CFrame
    local camRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    local camForward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit

    if frameCount % 15 == 0 then
        pcall(function() UpdateHotspotsHUD(myPos, camRight, camForward) end)
    end

    local activeBadges = {}
    local activeBuildingBadges = {}
    local activeWaypoints = {}
    local activeHighlights = {}
    local offscreenCandidates = {}
    local placedLootSlots = {}
    local maxLootBadges = 36
    local renderedBadgeCount = 0
    local maxChams = 16
    local activeChamsCount = 0
    local maxOffscreenSlots = 16

    if Settings.BuildingLootESP then
        for _, bData in ipairs(cachedBuildingLoot) do
            local distStuds = (bData.GroundPos - myPos).Magnitude
            local distM = math.floor(distStuds * 0.28)

            if distStuds <= Settings.LootMaxDistance then
                local tierColor = GetLootColor(bData.TotalValue)
                local sc, onScreen = Camera:WorldToViewportPoint(bData.Position)
                local isTrulyOnScreen = onScreen and sc.Z > 0 and (sc.X >= 10 and sc.X <= vp.X - 10) and (sc.Y >= 10 and sc.Y <= vp.Y - 10)

                if distM > 8 and isTrulyOnScreen then
                    activeBuildingBadges[bData.Id] = true
                    local badge = buildingBadges[bData.Id]
                    if not badge or not badge.Root.Parent then
                        badge = CreateBuildingBadge(bData.Id)
                        buildingBadges[bData.Id] = badge
                    end

                    local bx, by = GetNonOverlappingScreenPos(sc.X, sc.Y - 10, placedLootSlots, 140, 28)
                    badge.Root.Position = UDim2.fromOffset(bx, by)
                    badge.TopLabel.TextColor3 = tierColor
                    badge.TopLabel.Text = string.format("[%s]  %s  (%d Crates)", string.upper(bData.Name), FormatPrice(bData.TotalValue), bData.ContainersCount)

                    if bData.TopItem and Settings.ShowTopItemName then
                        badge.SubLabel.Text = string.format("%s  [%dm]", bData.TopItem, distM)
                    else
                        badge.SubLabel.Text = string.format("[%dm]", distM)
                    end
                    badge.Root.Visible = true
                end
            end
        end
    end

    for _, loot in ipairs(cachedLootData) do
        local inst = loot.Instance
        if inst and inst.Parent then
            local distStuds = (loot.Position - myPos).Magnitude

            if distStuds <= Settings.LootMaxDistance then
                local isPriorityLoot = (distStuds <= 140) or (loot.TotalValue >= 1000) or (JACKPOT_CONTAINER_KINDS[loot.Kind] == true)
                local isOffscreenEligible = Settings.LootWaypoints and (distStuds <= 650) and ((loot.TotalValue >= 1500) or JACKPOT_CONTAINER_KINDS[loot.Kind]) and (#offscreenCandidates < maxOffscreenSlots)

                if isPriorityLoot or isOffscreenEligible then
                    local tierColor = GetLootColor(loot.TotalValue)
                    local sc, onScreen = Camera:WorldToViewportPoint(loot.Position + Vector3.new(0, 1.2, 0))
                    local isTrulyOnScreen = onScreen and sc.Z > 0 and (sc.X >= 10 and sc.X <= vp.X - 10) and (sc.Y >= 10 and sc.Y <= vp.Y - 10)

                    if isTrulyOnScreen and isPriorityLoot and (renderedBadgeCount < maxLootBadges) then
                        renderedBadgeCount = renderedBadgeCount + 1
                        activeBadges[inst] = true
                        local badge = lootBadges[inst]
                        if not badge or not badge.Root.Parent then
                            badge = CreateLootBadge(inst)
                            lootBadges[inst] = badge
                        end

                        local crateName = FormatCrateName(loot.Kind)
                        local lx, ly = GetNonOverlappingScreenPos(sc.X, sc.Y - 10, placedLootSlots, 140, 28)
                        badge.Root.Position = UDim2.fromOffset(lx, ly)
                        badge.TopLabel.TextColor3 = tierColor

                        local distM = math.floor(distStuds * 0.28)
                        if loot.HasStreamed then
                            if loot.TotalValue > 0 then
                                badge.TopLabel.Text = string.format("[%s]  %s", string.upper(crateName), FormatPrice(loot.TotalValue))
                                local itemsText = (loot.ItemsWithPrices and #loot.ItemsWithPrices > 0) and table.concat(loot.ItemsWithPrices, " · ") or (loot.TopItem or "Looted")
                                badge.SubLabel.Text = string.format("%s  [%dm]", itemsText, distM)
                            else
                                badge.TopLabel.Text = string.format("[%s]  EMPTY ($0)", string.upper(crateName))
                                badge.TopLabel.TextColor3 = Theme.SubText
                                badge.SubLabel.Text = string.format("No Items  [%dm]", distM)
                            end
                        else
                            local poolHint = "Pool: High Loot"
                            if loot.Kind == "Safe" then poolHint = "Pool: Gold / Keys / Cash"
                            elseif loot.Kind == "WeaponCrate" then poolHint = "Pool: Guns / Scopes / Ammo"
                            elseif loot.Kind == "Register" then poolHint = "Pool: Cash / Coins"
                            elseif loot.Kind == "Duffel" then poolHint = "Pool: Weapons / Bags"
                            elseif loot.Kind == "MedCabinet" then poolHint = "Pool: Medical / Stims"
                            end
                            badge.TopLabel.Text = string.format("[%s]  UNOPENED", string.upper(crateName))
                            badge.SubLabel.Text = string.format("[%s]  [%dm]", poolHint, distM)
                        end
                        badge.Root.Visible = true
                    elseif (not isTrulyOnScreen) and isOffscreenEligible then
                        local distM = math.floor(distStuds * 0.28)
                        local crateName = FormatCrateName(loot.Kind)
                        local wpTitle = ""
                        if loot.HasStreamed then
                            if loot.TotalValue > 0 then
                                local topItemSuffix = loot.TopItem and (" (" .. loot.TopItem:sub(1, 10) .. ")") or ""
                                wpTitle = string.format("[%s] %s%s %dm", string.upper(crateName), FormatPrice(loot.TotalValue), topItemSuffix, distM)
                            else
                                wpTitle = string.format("[%s] EMPTY %dm", string.upper(crateName), distM)
                            end
                        else
                            wpTitle = string.format("[%s] UNOPENED %dm", string.upper(crateName), distM)
                        end
                        table.insert(offscreenCandidates, {
                            key = "inst_" .. tostring(inst),
                            title = wpTitle,
                            distStuds = distStuds,
                            distM = distM,
                            tierColor = tierColor,
                            sc = sc,
                            totalVal = loot.TotalValue
                        })
                    end
                end

                if Settings.LootChams and loot.TotalValue >= Settings.MinLootValue and distStuds <= 350 and activeChamsCount < maxChams then
                    activeChamsCount = activeChamsCount + 1
                    activeHighlights[inst] = true
                    local hl = lootHighlights[inst]
                    if not hl or hl.Parent ~= inst then
                        if hl then pcall(function() hl:Destroy() end) end
                        hl = Instance.new("Highlight")
                        hl.Name = "HPS_LootHighlight"
                        hl.FillTransparency = 0.75
                        hl.OutlineTransparency = 0.05
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = inst
                        hl.Parent = inst
                        lootHighlights[inst] = hl
                    end
                    local tierColor = GetLootColor(loot.TotalValue)
                    hl.FillColor = tierColor
                    hl.OutlineColor = tierColor
                    hl.Enabled = true
                else
                    if lootHighlights[inst] and lootHighlights[inst].Enabled then
                        lootHighlights[inst].Enabled = false
                    end
                end
            end
        end
    end

    if Settings.LootWaypoints and #offscreenCandidates > 0 then
        table.sort(offscreenCandidates, function(a, b)
            local scoreA = a.totalVal / (1 + (a.distStuds / 250))
            local scoreB = b.totalVal / (1 + (b.distStuds / 250))
            return scoreA > scoreB
        end)

        local selected = {}
        for i = 1, math.min(#offscreenCandidates, 16) do
            local cand = offscreenCandidates[i]
            local sc = cand.sc
            local dir2D = Vector2.new(sc.X - center.X, sc.Y - center.Y)
            if sc.Z <= 0 then dir2D = -dir2D end
            if dir2D.Magnitude == 0 then dir2D = Vector2.new(0, -1) end
            local unitDir = dir2D.Unit

            local scaleX = halfW / math.abs(unitDir.X)
            local scaleY = halfH / math.abs(unitDir.Y)
            local scale = math.min(scaleX, scaleY)
            local rawEdgeX = center.X + unitDir.X * scale
            local rawEdgeY = center.Y + unitDir.Y * scale

            local angleDeg = math.deg(math.atan2(unitDir.Y, unitDir.X))
            table.insert(selected, {
                cand = cand,
                x = rawEdgeX,
                y = rawEdgeY,
                angle = angleDeg
            })
        end

        table.sort(selected, function(a, b) return a.x < b.x end)
        for i = 2, #selected do
            local prev = selected[i - 1]
            local curr = selected[i]
            local dx = math.abs(curr.x - prev.x)
            local dy = math.abs(curr.y - prev.y)
            if dx < 48 and dy < 28 then
                if curr.x <= center.X then
                    curr.x = math.max(marginX, prev.x - 48)
                else
                    curr.x = math.min(vp.X - marginX, prev.x + 48)
                end
            end
        end

        for _, item in ipairs(selected) do
            local cand = item.cand
            activeWaypoints[cand.key] = true
            local wp = buildingWaypoints[cand.key]
            if not wp or not wp.Root.Parent then
                wp = CreateLootWaypoint(cand.key)
                buildingWaypoints[cand.key] = wp
            end

            wp.Root.Position = UDim2.fromOffset(item.x, item.y)
            wp.ArrowFrame.Rotation = item.angle
            wp.ArrowImage.ImageColor3 = cand.tierColor
            wp.TextLabel.TextColor3 = cand.tierColor
            wp.TextLabel.Text = cand.title
            wp.Root.Visible = true
        end
    end

    for inst, b in pairs(lootBadges) do
        if not activeBadges[inst] then
            if not inst.Parent then
                if b.Root then b.Root:Destroy() end
                lootBadges[inst] = nil
            else
                if b.Root.Visible then b.Root.Visible = false end
            end
        end
    end
    for bId, b in pairs(buildingBadges) do
        if not activeBuildingBadges[bId] then
            if b.Root and b.Root.Visible then b.Root.Visible = false end
        end
    end
    for key, w in pairs(buildingWaypoints) do
        if not activeWaypoints[key] then
            if w.Root and w.Root.Visible then w.Root.Visible = false end
        end
    end
    for inst, hl in pairs(lootHighlights) do
        if not activeHighlights[inst] then
            if not inst.Parent then
                if hl then hl:Destroy() end
                lootHighlights[inst] = nil
            else
                if hl.Enabled then hl.Enabled = false end
            end
        end
    end
end

