        end

        Tween(switch, 0.2, { BackgroundColor3 = val and Theme.Blue or Theme.ToggleOff }):Play()
        Tween(sStroke, 0.2, { Color = val and Theme.BlueGlow or Theme.CardBorder }):Play()
        Tween(knob, 0.2, {
