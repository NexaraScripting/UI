local function UpdateBossHunt()
    if not Settings.BossHuntEnabled then
        if bossHuntGui then bossHuntGui.Enabled = false end
        if bossHuntFrame then bossHuntFrame.Visible = false end
        for _, wp in pairs(bossWaypoints) do if wp.Root then wp.Root.Visible = false end end
        for _, blip in pairs(bossRadarBlips) do if blip.Dot then blip.Dot.Visible = false end end
        for _, bg in pairs(bossBadges) do if bg.Root then bg.Root.Visible = false end end
        for _, hl in pairs(bossHighlights) do if hl then hl.Enabled = false end end
        return
    end

    if not bossHuntGui or not bossHuntGui.Parent then
        BuildBossHuntGui()
    end
    if bossHuntGui then bossHuntGui.Enabled = true end

    local myChar = LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name))
    local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
    if not myTorso then
        if bossHuntFrame then bossHuntFrame.Visible = false end
        return
    end

    local myPos = myTorso.Position
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local marginX = 90
    local marginY = 65
    local halfW = (vp.X / 2) - marginX
    local halfH = (vp.Y / 2) - marginY

    local radius = Settings.RadarSize and (Settings.RadarSize / 2) or 82.5
    local usableRadius = radius - 8
    local range = Settings.RadarRange or 650
    local isPlayerFacing = (Settings.RadarOrientation == "Player-Facing")
    local fwd, rgt
    if isPlayerFacing then
        local myHeading = myTorso.CFrame.LookVector
        fwd = Vector3.new(myHeading.X, 0, myHeading.Z).Unit
        rgt = Vector3.new(-fwd.Z, 0, fwd.X)
    else
        local camCF = Camera.CFrame
        fwd = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
        rgt = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    end

    local targets = GetAllLivingZombies()
    local activeBosses = {}
    local activeBossIds = {}
    local deadBosses = {}

    for _, t in ipairs(targets) do
        local bossInfo = GetBossInfo(t.typeId, t.model)
        if bossInfo then
            local zId = tostring(t.id)
            local isEngineDead = (t.zRaw and (t.zRaw.dead == true or t.zRaw.state == 7 or t.zRaw.actState == 7 or (t.zRaw.deadAt and t.zRaw.deadAt > 0)))
            if t.model and (t.model:GetAttribute("Corpse") == true or t.model:GetAttribute("Dead") == true) then
                isEngineDead = true
            end

            if not isEngineDead and t.position then
                local distStuds = (t.position - myPos).Magnitude
                if distStuds <= (Settings.BossMaxDistance or 4000) then
                    local distM = math.floor(distStuds * 0.28 + 0.5)
                    local curHp = zombieHealthTrack[zId] or bossInfo.maxHp
                    curHp = math.clamp(curHp, 1, bossInfo.maxHp)
                    local bossData = {
                        id = zId,
                        target = t,
                        info = bossInfo,
                        position = t.position,
                        model = t.model,
                        distStuds = distStuds,
                        distM = distM,
                        curHp = curHp,
                        maxHp = bossInfo.maxHp or 2600,
                        isDead = false,
                    }
                    table.insert(activeBosses, bossData)
                    activeBossIds[zId] = true
                end
            end
        end
    end

    if Settings.BossCorpseTracker then
        pcall(function()
            if HushZombieRender and getupvalues then
                local uvs = getupvalues(HushZombieRender.targets)
                local allTable = uvs and uvs[1]
                if allTable and type(allTable) == "table" then
                    for id, z in pairs(allTable) do
                        local zId = tostring(z.id or id)
                        if not activeBossIds[zId] and tostring(z.kind or ""):lower():find("boss") then
                            local bossInfo = GetBossInfo(z.kind, z.rig and z.rig.model)
                            if bossInfo then
                                local isDead = (z.dead == true) or (z.state == 7) or (z.actState == 7) or (z.deadAt and z.deadAt > 0)
                                if isDead then
                                    local pos = nil
                                    if z.rig and z.rig.root and z.rig.root:IsA("BasePart") then
                                        pos = z.rig.root.Position
                                    elseif z.rig and z.rig.model and z.rig.model:IsA("Model") then
                                        pos = z.rig.model:GetPivot().Position
                                    elseif z.x and z.z then
                                        local groundY = (z.y and z.y ~= 0) and z.y or myPos.Y
                                        pos = Vector3.new(z.x, groundY + 2.5, z.z)
                                    end

                                    if pos then
                                        local distStuds = (pos - myPos).Magnitude
                                        local distM = math.floor(distStuds * 0.28 + 0.5)
                                        local deadData = {
                                            id = "dead_" .. zId,
                                            realId = zId,
                                            target = { id = zId, position = pos, model = z.rig and z.rig.model },
                                            info = bossInfo,
                                            position = pos,
                                            model = z.rig and z.rig.model,
                                            distStuds = distStuds,
                                            distM = distM,
                                            curHp = 0,
                                            maxHp = bossInfo.maxHp or 2600,
                                            isDead = true,
                                        }
                                        table.insert(deadBosses, deadData)
                                        activeBossIds["dead_" .. zId] = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    table.sort(activeBosses, function(a, b) return a.distStuds < b.distStuds end)
    table.sort(deadBosses, function(a, b) return a.distStuds < b.distStuds end)

    local displayBoss = activeBosses[1] or deadBosses[1]

    if not displayBoss then
        if bossHuntFrame then bossHuntFrame.Visible = false end
        for zId, wp in pairs(bossWaypoints) do
            if wp.Root then wp.Root.Visible = false end
        end
        for zId, blip in pairs(bossRadarBlips) do
            if blip.Dot then blip.Dot.Visible = false end
        end
        for zId, bg in pairs(bossBadges) do
            if bg.Root then bg.Root.Visible = false end
        end
        for zId, hl in pairs(bossHighlights) do
            if hl then hl.Enabled = false end
        end
        return
    end

    if bossHuntFrame then
        if Settings.BossHUD then
            bossHuntFrame.Visible = true
            local subH = bossHuntFrame:FindFirstChild("SubHeader")
            local nameL = bossHuntFrame:FindFirstChild("NameLabel")
            local hpFill = bossHuntFrame:FindFirstChild("HpFill", true) or bossHuntFrame:FindFirstChild("HealthFill", true)
            local hpText = bossHuntFrame:FindFirstChild("HpText", true)
            local countL = bossHuntFrame:FindFirstChild("CountLabel", true)

            if displayBoss.isDead then
                if subH then
                    subH.Text = string.format("[RAID BOSS ELIMINATED]  •  %s", string.upper(displayBoss.info.zone or "CHECKPOINT"))
                    subH.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
                if nameL then
                    nameL.Text = string.format("%s (CORPSE)  •  %dm", string.upper(displayBoss.info.name), displayBoss.distM)
                    nameL.TextColor3 = Color3.fromRGB(255, 180, 180)
                end
                if countL then
                    countL.Text = "DEFEATED"
                    countL.TextColor3 = Color3.fromRGB(180, 180, 180)
                end
                if hpFill then
                    hpFill.Size = UDim2.fromScale(0, 1)
                end
                if hpText then
                    hpText.Text = "DEFEATED • LOOTABLE CORPSE"
                end
            else
                if subH then
                    subH.Text = string.format("[RAID BOSS ENCOUNTER]  •  %s", string.upper(displayBoss.info.zone or "HOSTILE SECTOR"))
                    subH.TextColor3 = Color3.fromRGB(255, 215, 0)
                end
                if nameL then
                    nameL.Text = string.format("%s  •  %dm", string.upper(displayBoss.info.name), displayBoss.distM)
                    nameL.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
                if countL then
                    countL.Text = string.format("%d ACTIVE", #activeBosses)
                    countL.TextColor3 = Color3.fromRGB(255, 90, 90)
                end
                local pct = math.clamp(displayBoss.curHp / displayBoss.maxHp, 0, 1)
                if hpFill then
                    hpFill.Size = UDim2.fromScale(pct, 1)
                end
                if hpText then
                    hpText.Text = string.format("%d / %d HP (%d%%)", displayBoss.curHp, displayBoss.maxHp, math.floor(pct * 100))
                end
            end
        else
            bossHuntFrame.Visible = false
        end
    end

    local renderList = {}
    for _, b in ipairs(activeBosses) do table.insert(renderList, b) end
    for _, b in ipairs(deadBosses) do table.insert(renderList, b) end

    for _, boss in ipairs(renderList) do
        local zId = boss.id
        local zPos = boss.position

        if Settings.BossRadarIcon and radarFrame then
            local zFlat = Vector3.new(zPos.X - myPos.X, 0, zPos.Z - myPos.Z)
            local zRelX = zFlat:Dot(rgt)
            local zRelY = zFlat:Dot(fwd)
            local zNormX = zRelX / range
            local zNormY = zRelY / range
            local zDistRatio = math.sqrt(zNormX * zNormX + zNormY * zNormY)

            if zDistRatio > 1.0 then
                zNormX = (zNormX / zDistRatio) * 0.93
                zNormY = (zNormY / zDistRatio) * 0.93
            end

            local blip = bossRadarBlips[zId]
            if not blip or not blip.Dot.Parent then
                blip = CreateBossRadarBlip(zId)
                bossRadarBlips[zId] = blip
            end

            if blip and blip.Dot then
                local blipX = radius + (zNormX * usableRadius) - 8
                local blipY = radius - (zNormY * usableRadius) - 8
                blip.Dot.Position = UDim2.fromOffset(blipX, blipY)
                blip.Dot.Visible = true

                if boss.isDead then
                    blip.Crown.Image = "rbxassetid://6031075931" -- Skull emblem
                    blip.Crown.ImageColor3 = Color3.fromRGB(255, 75, 75)
                    local txt = string.format("[CORPSE] %s %dm", boss.info.name, boss.distM)
                    blip.Label.Text = txt
                    local pillW = math.clamp(#txt * 5.8 + 12, 34, 115)
                    blip.Pill.Size = UDim2.fromOffset(pillW, 13)
                else
                    blip.Crown.Image = "rbxassetid://6031082533" -- Crown emblem
                    blip.Crown.ImageColor3 = Color3.fromRGB(255, 215, 0)
                    local txt = string.format("[BOSS] %s %dm", boss.info.name, boss.distM)
                    blip.Label.Text = txt
                    local pillW = math.clamp(#txt * 5.8 + 12, 34, 110)
                    blip.Pill.Size = UDim2.fromOffset(pillW, 13)
                end

                local anchorY = (zNormY > 0.2) and 0 or 1
                local posY = (zNormY > 0.2) and 18 or -5
                blip.Pill.Position = UDim2.new(0.5, -blip.Pill.Size.X.Offset / 2, anchorY, posY)
            end
        else
            if bossRadarBlips[zId] and bossRadarBlips[zId].Dot then
                bossRadarBlips[zId].Dot.Visible = false
            end
        end

        local sc, onScreen = Camera:WorldToViewportPoint(zPos + Vector3.new(0, 3.2, 0))
        local isTrulyOnScreen = onScreen and sc.Z > 0 and (sc.X >= marginX and sc.X <= vp.X - marginX) and (sc.Y >= marginY and sc.Y <= vp.Y - marginY)

        if not isTrulyOnScreen then
            if Settings.BossWaypoints and bossHuntGui then
                local wp = bossWaypoints[zId]
                if not wp or not wp.Root.Parent then
                    wp = CreateBossWaypoint(zId)
                    bossWaypoints[zId] = wp
                end

                local dir2D = Vector2.new(sc.X - center.X, sc.Y - center.Y)
                if sc.Z <= 0 then dir2D = -dir2D end
                if dir2D.Magnitude == 0 then dir2D = Vector2.new(0, -1) end
                local unitDir = dir2D.Unit

                local scaleX = halfW / math.abs(unitDir.X)
                local scaleY = halfH / math.abs(unitDir.Y)
                local scale = math.min(scaleX, scaleY)
                local edgeX = center.X + unitDir.X * scale
                local edgeY = center.Y + unitDir.Y * scale
                local angleDeg = math.deg(math.atan2(unitDir.Y, unitDir.X))

                wp.Root.Position = UDim2.fromOffset(edgeX, edgeY)
                wp.ArrowFrame.Rotation = angleDeg
                if boss.isDead then
                    wp.TagText.Text = string.format("[CORPSE] %s  %dm", string.upper(boss.info.name), boss.distM)
                    wp.TagText.TextColor3 = Color3.fromRGB(255, 150, 150)
                else
                    wp.TagText.Text = string.format("%s  [%d HP]  %dm", string.upper(boss.info.name), boss.curHp, boss.distM)
                    wp.TagText.TextColor3 = Color3.fromRGB(255, 230, 120)
                end
                wp.Root.Visible = true
            else
                if bossWaypoints[zId] and bossWaypoints[zId].Root then
                    bossWaypoints[zId].Root.Visible = false
                end
            end

            if bossBadges[zId] and bossBadges[zId].Root then
                bossBadges[zId].Root.Visible = false
            end
        else
            if bossWaypoints[zId] and bossWaypoints[zId].Root then
                bossWaypoints[zId].Root.Visible = false
            end

            if Settings.BossOverheadBadge then
                local badge = bossBadges[zId]
                if not badge or not badge.Root.Parent then
                    badge = CreateBossBadge(zId)
                    bossBadges[zId] = badge
                end

                badge.Root.Position = UDim2.fromOffset(sc.X, sc.Y - 14)
                if boss.isDead then
                    badge.TopLabel.Text = string.format("[DEFEATED BOSS] %s  %dm", string.upper(boss.info.name), boss.distM)
                    badge.TopLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
                    badge.SubLabel.Text = "CORPSE • LOOTABLE"
                else
                    badge.TopLabel.Text = string.format("[RAID BOSS] %s  %dm", string.upper(boss.info.name), boss.distM)
                    badge.TopLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                    badge.SubLabel.Text = string.format("%s  •  HP: %d / %d", boss.info.zone or "ZONE", boss.curHp, boss.maxHp)
                end
                badge.Root.Visible = true
            else
                if bossBadges[zId] and bossBadges[zId].Root then
                    bossBadges[zId].Root.Visible = false
                end
            end
        end

        if not boss.isDead and Settings.BossChams and boss.model then
            local hl = bossHighlights[zId]
            if not hl or hl.Parent ~= boss.model then
                if hl then pcall(function() hl:Destroy() end) end
                hl = Instance.new("Highlight")
                hl.Name = "HPS_BossChams"
                hl.FillTransparency = 0.45
                hl.OutlineTransparency = 0.05
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = boss.model
                hl.Parent = boss.model
                bossHighlights[zId] = hl
            end
            hl.FillColor = boss.info.border or Color3.fromRGB(255, 215, 0)
            hl.OutlineColor = boss.info.color or Color3.fromRGB(255, 60, 60)
            hl.Enabled = true
        else
            if bossHighlights[zId] and bossHighlights[zId].Enabled then
                bossHighlights[zId].Enabled = false
            end
        end
    end

    for zId, wp in pairs(bossWaypoints) do
        if not activeBossIds[zId] then
            if wp.Root then wp.Root:Destroy() end
            bossWaypoints[zId] = nil
        end
    end
    for zId, blip in pairs(bossRadarBlips) do
        if not activeBossIds[zId] then
            if blip.Dot then blip.Dot:Destroy() end
            bossRadarBlips[zId] = nil
        end
    end
    for zId, bg in pairs(bossBadges) do
        if not activeBossIds[zId] then
            if bg.Root then bg.Root:Destroy() end
            bossBadges[zId] = nil
        end
    end
    for zId, hl in pairs(bossHighlights) do
        if not activeBossIds[zId] then
            if hl then pcall(function() hl:Destroy() end) end
            bossHighlights[zId] = nil
        end
    end
end

