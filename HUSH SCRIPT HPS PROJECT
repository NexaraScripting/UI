local function UpdateRadar()
    if not Settings.RadarEnabled or not radarFrame then
        if radarGui then radarGui.Enabled = false end
        return
    end
    radarGui.Enabled = true

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    if not myRoot then return end

    local myPos = myRoot.Position
    local radius = Settings.RadarSize / 2
    local usableRadius = radius - 8
    local range = Settings.RadarRange
    local activeSet = {}

    local isPlayerFacing = (Settings.RadarOrientation == "Player-Facing")
    local fwd, rgt
    if isPlayerFacing then
        local myHeading = myRoot.CFrame.LookVector
        fwd = Vector3.new(myHeading.X, 0, myHeading.Z).Unit
        rgt = Vector3.new(-fwd.Z, 0, fwd.X)
    else
        local camCF = Camera.CFrame
        fwd = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
        rgt = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    end

    local headingIcon = radarFrame:FindFirstChild("Heading", true)
    if headingIcon then
        if isPlayerFacing then
            headingIcon.Rotation = 0
        else
            local myHeading = myRoot.CFrame.LookVector
            local myFlatHeading = Vector3.new(myHeading.X, 0, myHeading.Z).Unit
            local hX = myFlatHeading:Dot(rgt)
            local hY = myFlatHeading:Dot(fwd)
            headingIcon.Rotation = math.deg(math.atan2(hX, hY))
        end
    end

    local fullW = radius * 2
    local myCharAttrs = myChar and myChar:GetAttributes() or {}
    local mySquad = myCharAttrs.SquadId

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsPlayerAlive(plr) then
            local char = plr.Character or Workspace:FindFirstChild(plr.Name)
            local root = GetPlayerTorsoOrHead(char, "Torso") or (char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")))
            if root then
                local diff = root.Position - myPos
                local flatDiff = Vector3.new(diff.X, 0, diff.Z)
                local distStuds = flatDiff.Magnitude
                local distM = math.floor(distStuds * 0.28 + 0.5)

                local relX = flatDiff:Dot(rgt)
                local relY = flatDiff:Dot(fwd)

                local normX = relX / range
                local normY = relY / range
                local distRatio = math.sqrt(normX * normX + normY * normY)

                local showBlip = false
                if distRatio <= 1.0 then
                    showBlip = true
                elseif Settings.RadarClampOffscreen then
                    showBlip = true
                    normX = (normX / distRatio) * 0.94
                    normY = (normY / distRatio) * 0.94
                end

                if showBlip then
                    activeSet[plr] = true
                    local blipData = radarBlips[plr]
                    if not blipData or not blipData.Dot.Parent then
                        local dot = Instance.new("Frame")
                        dot.Size = UDim2.fromOffset(8, 8)
                        dot.BackgroundColor3 = Theme.Danger
                        dot.BorderSizePixel = 0
                        dot.ZIndex = 5
                        dot.Parent = radarFrame
                        Corner(dot, 4)
                        Stroke(dot, Color3.fromRGB(255, 255, 255), 0.8)

                        local pill = Instance.new("Frame")
                        pill.Name = "Pill"
                        pill.BackgroundColor3 = Color3.fromRGB(8, 14, 22)
                        pill.BackgroundTransparency = 0.2
                        pill.BorderSizePixel = 0
                        pill.ZIndex = 6
                        pill.Parent = dot
                        Corner(pill, 3)

                        local lbl = Instance.new("TextLabel")
                        lbl.Name = "Text"
                        lbl.Size = UDim2.fromScale(1, 1)
                        lbl.BackgroundTransparency = 1
                        lbl.Font = Fonts.Bold
                        lbl.TextColor3 = Theme.Text
                        lbl.TextSize = 8
                        lbl.TextStrokeTransparency = 0.4
                        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        lbl.ZIndex = 7
                        lbl.Parent = pill

                        blipData = { Dot = dot, Pill = pill, Label = lbl }
                        radarBlips[plr] = blipData
                    end

                    local blipX = radius + (normX * usableRadius) - 4
                    local blipY = radius - (normY * usableRadius) - 4

                    blipData.Dot.Position = UDim2.fromOffset(blipX, blipY)
                    blipData.Dot.Visible = true

                    local isDowned = (char:GetAttribute("Downed") == true)
                    local plrSquad = char:GetAttribute("SquadId")
                    local isTeammate = (mySquad and plrSquad and mySquad == plrSquad and mySquad ~= "")

                    if isTeammate then
                        blipData.Dot.BackgroundColor3 = Theme.Success
                    elseif isDowned then
                        blipData.Dot.BackgroundColor3 = Color3.fromRGB(245, 166, 35)
                    else
                        blipData.Dot.BackgroundColor3 = Theme.Danger
                    end

                    local mode = Settings.RadarLabelMode or "Name & Dist"
                    if mode == "Clean Dots" then
                        blipData.Pill.Visible = false
                    else
                        local pName = plr.DisplayName
                        if not pName or pName == "" then pName = plr.Name end
                        local txt = ""
                        local pillW = 24
                        if mode == "Distance Only" then
                            txt = string.format("%dm", distM)
                            if isDowned then txt = txt .. " +" end
                            pillW = math.clamp(#txt * 5.8 + 8, 22, 38)
                        else -- "Name & Dist"
                            local shortName = pName:sub(1, 6)
                            if isDowned then
                                txt = string.format("%s %dm+", shortName, distM)
                            else
                                txt = string.format("%s %dm", shortName, distM)
                            end
                            pillW = math.clamp(#txt * 5.5 + 8, 28, 62)
                        end
                        blipData.Pill.Size = UDim2.fromOffset(pillW, 12)
                        blipData.Label.Text = txt

                        if isDowned then
                            blipData.Label.TextColor3 = Color3.fromRGB(255, 210, 110)
                        elseif isTeammate then
                            blipData.Label.TextColor3 = Color3.fromRGB(130, 255, 170)
                        else
                            blipData.Label.TextColor3 = Theme.Text
                        end

                        local anchorY = (normY > 0.2) and 0 or 1
                        local posY = (normY > 0.2) and 10 or -3

                        local anchorX = 0.5
                        local posX = 4
                        if blipX < (pillW / 2 + 4) then
                            anchorX = 0
                            posX = 0
                        elseif blipX > (fullW - (pillW / 2 + 4)) then
                            anchorX = 1
                            posX = 8
                        end

                        blipData.Pill.AnchorPoint = Vector2.new(anchorX, anchorY)
                        blipData.Pill.Position = UDim2.fromOffset(posX, posY)
                        blipData.Pill.Visible = true
                    end
                end
            end
        end
    end

    for plr, b in pairs(radarBlips) do
        if not activeSet[plr] then
            if not plr.Parent or not IsPlayerAlive(plr) then
                if b.Dot then b.Dot:Destroy() end
                radarBlips[plr] = nil
            else
                if b.Dot.Visible then b.Dot.Visible = false end
            end
        end
    end

    local activeLootBlips = {}
    if Settings.LootOnRadar and radarFrame then
        local lootCount = 0
        for _, loot in ipairs(cachedLootData) do
            if loot.TotalValue >= Settings.MinLootValue and lootCount < 30 then
                local lDiff = loot.Position - myPos
                local lFlat = Vector3.new(lDiff.X, 0, lDiff.Z)
                local lDist = lFlat.Magnitude

                if lDist <= range then
                    lootCount = lootCount + 1
                    local inst = loot.Instance
                    activeLootBlips[inst] = true
                    local blip = lootRadarBlips[inst]
                    if not blip or not blip.Dot.Parent then
                        local dot = Instance.new("Frame")
                        dot.Size = UDim2.fromOffset(5, 5)
                        dot.BorderSizePixel = 0
                        dot.ZIndex = 3
                        dot.Parent = radarFrame
                        Corner(dot, 2)
                        blip = { Dot = dot }
                        lootRadarBlips[inst] = blip
                    end

                    local lRelX = lFlat:Dot(rgt)
                    local lRelY = lFlat:Dot(fwd)
                    local lNormX = lRelX / range
                    local lNormY = lRelY / range

                    local blipX = radius + (lNormX * usableRadius) - 2.5
                    local blipY = radius - (lNormY * usableRadius) - 2.5

                    blip.Dot.Position = UDim2.fromOffset(blipX, blipY)
                    blip.Dot.BackgroundColor3 = GetLootColor(loot.TotalValue)
                    blip.Dot.Visible = true
                end
            end
        end
    end

    for inst, b in pairs(lootRadarBlips) do
        if not activeLootBlips[inst] then
            if not inst.Parent then
                if b.Dot then b.Dot:Destroy() end
                lootRadarBlips[inst] = nil
            else
                if b.Dot.Visible then b.Dot.Visible = false end
            end
        end
    end
end

