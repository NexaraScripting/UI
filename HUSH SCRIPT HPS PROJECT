local UpdateConfigCardStatus = nil

local function EnsureConfigFolder()
    pcall(function()
        if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        elseif makefolder and not isfolder then
            pcall(makefolder, CONFIG_FOLDER)
        end
    end)
end

local function SaveConfig()
    EnsureConfigFolder()
    if writefile then
        pcall(function()
            local encoded = HttpService:JSONEncode(Settings)
            writefile(CONFIG_FILE, encoded)
            writefile("Hush_Config.json", encoded)
        end)
    end
    if UpdateConfigCardStatus then pcall(UpdateConfigCardStatus) end
end

local function LoadConfig()
    EnsureConfigFolder()
    local ok, content = pcall(function()
        if isfile and isfile(CONFIG_FILE) then return readfile(CONFIG_FILE) end
        if isfile and isfile("Hush_Config.json") then return readfile("Hush_Config.json") end
        if readfile then return readfile(CONFIG_FILE) end
    end)
    if ok and content and #content > 5 then
        local success, decoded = pcall(HttpService.JSONDecode, HttpService, content)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                if Settings[k] ~= nil then Settings[k] = v end
            end
            if UpdateConfigCardStatus then pcall(UpdateConfigCardStatus) end
            return true
        end
    end
    if UpdateConfigCardStatus then pcall(UpdateConfigCardStatus) end
    return false
end

