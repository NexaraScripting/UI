local function IsTeammate(plr)
    if not plr or plr == LocalPlayer then return true end
    if LocalPlayer:IsFriendsWith(plr.UserId) then return true end
    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local plrChar = plr.Character or Workspace:FindFirstChild(plr.Name)
    if myChar and plrChar then
        local mySquad = myChar:GetAttribute("SquadId")
        local plrSquad = plrChar:GetAttribute("SquadId")
        if mySquad and plrSquad and mySquad == plrSquad then
            return true
        end
    end
    if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
        return true
    end
    return false
end

local function UpdateESP()
    if not Settings.ESPEnabled then
        for _, esp in pairs(espDrawings) do
            for _, d in pairs(esp) do if d then d.Visible = false end end
        end
        for _, hl in pairs(espHighlights) do if hl then hl.Enabled = false end end
        for _, bb in pairs(espBillboards) do if bb then bb.Enabled = false end end
        return
    end

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
    local myPos = myTorso and myTorso.Position or Camera.CFrame.Position
    local myScreenPos, myOnScreen = nil, false
    if myTorso then myScreenPos, myOnScreen = Camera:WorldToViewportPoint(myTorso.Position) end
    local viewportSize = Camera.ViewportSize

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local esp = espDrawings[plr]
            if not esp and Drawing then CreatePlayerDrawingESP(plr); esp = espDrawings[plr] end

            local char = plr.Character or Workspace:FindFirstChild(plr.Name)
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart"))
            local head = char and char:FindFirstChild("Head")

            if char and hum and torso and hum.Health > 0 and char:GetAttribute("Dead") ~= true and char:GetAttribute("Dying") ~= true then
                local distStuds = (torso.Position - myPos).Magnitude
                local distM = math.floor(distStuds * 0.28)
                local curHp = math.floor(hum.Health)
                local maxHp = math.floor(hum.MaxHealth)

                local isTeam = IsTeammate(plr)
                local teamFriendColor = Color3.fromRGB(75, 235, 140)
                local playerColor = isTeam and teamFriendColor or Theme.EnemyColor

                if Settings.ESPChams then
                    local hl = espHighlights[plr]
                    if not hl or hl.Parent ~= char then
                        if hl then pcall(function() hl:Destroy() end) end
                        hl = Instance.new("Highlight")
                        hl.Name = "HPS_PlayerChams"
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = isTeam and Color3.fromRGB(180, 255, 200) or Color3.fromRGB(255, 255, 255)
                        hl.OutlineTransparency = 0.05
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = char
                        hl.Parent = char
                        espHighlights[plr] = hl
                    end
                    hl.FillColor = playerColor
                    hl.Enabled = (distStuds <= Settings.ESPMaxDistance)
                else
                    if espHighlights[plr] then espHighlights[plr].Enabled = false end
                end

                if Settings.ESPOverheadTags then
                    local bb = espBillboards[plr]
                    if not bb or not bb.Parent then bb = CreateOverheadBillboard(plr, char) end
                    if bb then
                        bb.Enabled = (distStuds <= Settings.ESPMaxDistance)
                        local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        local hpFill = bb:FindFirstChild("HpBg", true) and bb.HpBg:FindFirstChild("HpFill")
                        if hpFill then
                            hpFill.Size = UDim2.fromScale(hpPct, 1)
                            hpFill.BackgroundColor3 = isTeam and teamFriendColor or Color3.fromHSV(hpPct * 0.33, 1, 1)
                        end
                        local pNameLbl = bb:FindFirstChild("PlayerName", true)
                        if pNameLbl then
                            pNameLbl.TextColor3 = playerColor
                            pNameLbl.Text = isTeam and string.format("%s [SQUAD]", plr.DisplayName) or string.format("%s [ENEMY]", plr.DisplayName)
                        end
                        local dLbl = bb:FindFirstChild("Distance", true)
                        if dLbl then dLbl.Text = string.format("[%d m]  %d HP", distM, curHp) end
                    end
                else
                    if espBillboards[plr] then espBillboards[plr].Enabled = false end
                end

                if esp and Drawing and (distStuds <= Settings.ESPMaxDistance) then
                    local torsoPos, onScreenTorso = Camera:WorldToViewportPoint(torso.Position)
                    local headPos, onScreenHead = Camera:WorldToViewportPoint(head and head.Position or (torso.Position + Vector3.new(0, 1.5, 0)))
                    local legPos, onScreenLeg = Camera:WorldToViewportPoint(torso.Position - Vector3.new(0, 2.5, 0))

                    if onScreenTorso and torsoPos.Z > 0 then
                        local boxH = math.abs(headPos.Y - legPos.Y)
                        local boxW = math.clamp(boxH * 0.75, 12, 350)
                        local boxX = torsoPos.X - (boxW / 2)
                        local boxY = headPos.Y

                        if Settings.ESPBoxes and esp.Box and esp.BoxOutline then
                            esp.BoxOutline.Size = Vector2.new(boxW, boxH)
                            esp.BoxOutline.Position = Vector2.new(boxX, boxY)
                            esp.BoxOutline.Visible = true

                            esp.Box.Size = Vector2.new(boxW, boxH)
                            esp.Box.Position = Vector2.new(boxX, boxY)
                            esp.Box.Color = playerColor
                            esp.Box.Visible = true
                        else
                            if esp.Box then esp.Box.Visible = false end
                            if esp.BoxOutline then esp.BoxOutline.Visible = false end
                        end

                        local show2DLabels = not Settings.ESPOverheadTags

                        if show2DLabels and Settings.ESPNames and esp.Name then
                            esp.Name.Text = isTeam and string.format("[SQUAD] %s  [%d HP]", plr.DisplayName, curHp) or string.format("[ENEMY] %s  [%d HP]", plr.DisplayName, curHp)
                            esp.Name.Color = playerColor
                            esp.Name.Position = Vector2.new(torsoPos.X, boxY - 16)
                            esp.Name.Visible = true
                        else
                            if esp.Name then esp.Name.Visible = false end
                        end

                        if show2DLabels and Settings.ESPDistance and esp.Distance then
                            esp.Distance.Text = string.format("[%d m]  %d/%d HP", distM, curHp, maxHp)
                            esp.Distance.Position = Vector2.new(torsoPos.X, boxY + boxH + 2)
                            esp.Distance.Visible = true
                        else
                            if esp.Distance then esp.Distance.Visible = false end
                        end

                        if Settings.ESPHealth and esp.HealthBar and esp.HealthBarOutline then
                            local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                            local barW = 3
                            local barX = boxX - barW - 4
                            local barH = boxH * hpPct

                            esp.HealthBarOutline.Size = Vector2.new(barW + 2, boxH + 2)
                            esp.HealthBarOutline.Position = Vector2.new(barX - 1, boxY - 1)
                            esp.HealthBarOutline.Visible = true

                            esp.HealthBar.Size = Vector2.new(barW, barH)
                            esp.HealthBar.Position = Vector2.new(barX, boxY + (boxH - barH))
                            esp.HealthBar.Color = isTeam and teamFriendColor or Color3.fromHSV(hpPct * 0.33, 1, 1)
                            esp.HealthBar.Visible = true
                        else
                            if esp.HealthBar then esp.HealthBar.Visible = false end
                            if esp.HealthBarOutline then esp.HealthBarOutline.Visible = false end
                        end

                        if (not isTeam) and Settings.ESPTracers and esp.Tracer then
                            local originVec = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                            if Settings.TracerOrigin == "Player" and myScreenPos and myOnScreen then
                                originVec = Vector2.new(myScreenPos.X, myScreenPos.Y)
                            elseif Settings.TracerOrigin == "Center" then
                                originVec = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                            end

                            esp.Tracer.From = originVec
                            esp.Tracer.To = Vector2.new(torsoPos.X, torsoPos.Y)
                            esp.Tracer.Color = Theme.EnemyColor
                            esp.Tracer.Visible = true
                        else
                            if esp.Tracer then esp.Tracer.Visible = false end
                        end
                    else
                        if esp.Box then esp.Box.Visible = false end
                        if esp.BoxOutline then esp.BoxOutline.Visible = false end
                        if esp.Name then esp.Name.Visible = false end
                        if esp.Distance then esp.Distance.Visible = false end
                        if esp.HealthBar then esp.HealthBar.Visible = false end
                        if esp.HealthBarOutline then esp.HealthBarOutline.Visible = false end
                        if esp.Tracer then esp.Tracer.Visible = false end
                    end
                end
            else
                if espHighlights[plr] then espHighlights[plr].Enabled = false end
                if espBillboards[plr] then espBillboards[plr].Enabled = false end
                if esp then
                    for _, d in pairs(esp) do if d then d.Visible = false end end
                end
            end
        end
    end
end

