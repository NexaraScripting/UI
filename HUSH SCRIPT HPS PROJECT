local function FormatPrice(amount)
    local n = math.floor(tonumber(amount) or 0)
    local formatted = tostring(n)
    while true do
        local k
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return "$" .. formatted
end

local function GetLootColor(val)
    if val >= 10000 then return Color3.fromRGB(255, 215, 0) -- Pure Gold ($10k+)
    elseif val >= 5000 then return Color3.fromRGB(190, 80, 255) -- Mystic Purple ($5k+)
    elseif val >= 2000 then return Color3.fromRGB(0, 230, 255) -- Cyber Cyan ($2k+)
    elseif val >= 500 then return Color3.fromRGB(95, 225, 130) -- Vivid Emerald ($500+)
    else return Color3.fromRGB(180, 195, 215) -- Muted Gray (<$500)
    end
end

