UpdateRestockTimerUI = function()
    if not restockTimerLabel then return end
    local activeTrader = selectedShopTrader or "all"
    local secLeft, _, nearestTrader = GetTraderCountdown(activeTrader)
    if secLeft then
        local mins = math.floor(secLeft / 60)
        local secs = secLeft % 60
        if activeTrader ~= "all" then
            restockTimerLabel.Text = string.format("%02d:%02d (%s)", mins, secs, activeTrader:upper())
        else
            local tag = nearestTrader and nearestTrader:upper() or "RESTOCK"
            restockTimerLabel.Text = string.format("%02d:%02d (%s)", mins, secs, tag)
        end
    end
end

task.spawn(function()
    local lastTraderRestockAt = {}
    local lastStockScanTime = 0

    while true do
        task.wait(1)
        pcall(function()
            local inHideout = IsInHideout()
            UpdateAutoBuyHeader()

            UpdateRestockTimerUI()
            for tId, btnData in pairs(traderButtons) do
                if tId ~= "all" and btnData and btnData.Text then
                    local sLeft = GetTraderCountdown(tId)
                    if sLeft then
                        local m = math.floor(sLeft / 60)
                        local s = sLeft % 60
                        local baseLabel = btnData.Def and btnData.Def.label or tId:upper()
                        btnData.Text.Text = string.format("  %s (%02d:%02d)  ", baseLabel, m, s)
                    end
                end
            end

            if not inHideout then return end
            if not Settings.AutoBuyEnabled then return end
            if CountTickedItems() == 0 then return end
            if isAutoBuyingActive then return end

            local now = os.time()
            local nowClock = os.clock()

            local triggeredTrader = nil
            for _, tId in ipairs({"doc", "gunner", "scrapper"}) do
                local secLeft, restockAt = GetTraderCountdown(tId)
                if secLeft and restockAt then
                    if lastTraderRestockAt[tId] == nil then
                        lastTraderRestockAt[tId] = restockAt
                    elseif restockAt ~= lastTraderRestockAt[tId] then
                        lastTraderRestockAt[tId] = restockAt
                        triggeredTrader = tId
                    end
                end
            end

            if triggeredTrader then
                cachedTradersServerData = nil
                FetchTradersServerData(true)
                task.delay(1.0, function()
                    TriggerAutoBuyProcess("Restock Rollover " .. triggeredTrader, triggeredTrader)
                end)
                return
            end

            if nowClock - lastStockScanTime >= 2.0 then
                lastStockScanTime = nowClock
                local curCash = FetchPlayerCash()
                if curCash > 0 then
                    local tData = FetchTradersServerData(false)
                    if tData and tData.traders then
                        local hasInStockItem = false
                        for tId, tInfo in pairs(tData.traders) do
                            if tInfo.offers then
                                for _, off in ipairs(tInfo.offers) do
                                    if Settings.AutoBuyItems and Settings.AutoBuyItems[off.key] == true then
                                        if off.left == nil or off.left > 0 then
                                            hasInStockItem = true
                                            break
                                        end
                                    end
                                end
                            end
                            if hasInStockItem then break end
                        end

                        if hasInStockItem then
                            TriggerAutoBuyProcess("Hideout In-Stock Arrival Scan", "all")
                        end
                    end
                end
            end
        end)
    end
end)
end
