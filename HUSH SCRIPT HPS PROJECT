                    tTop.BackgroundTransparency = 1
                    tTop.Font = Fonts.Bold
                    tTop.TextSize = 13
                    tTop.Parent = frame

                    local tSub = Instance.new("TextLabel")
                    tSub.Name = "SubInfo"
                    tSub.Size = UDim2.new(1, -10, 0, 18)
                    tSub.Position = UDim2.fromOffset(5, 26)
                    tSub.BackgroundTransparency = 1
                    tSub.Font = Fonts.Medium
                    tSub.TextSize = 11
                    tSub.TextColor3 = Color3.fromRGB(200, 215, 230)
                    tSub.Parent = frame

                    extractBadges[pName] = bb
                end

                bb.Enabled = true
                local frame = bb:FindFirstChild("Bg")
                local stroke = frame and frame:FindFirstChild("Stroke")
                local tTop = frame and frame:FindFirstChild("TopTitle")
                local tSub = frame and frame:FindFirstChild("SubInfo")

                local dist = myRoot and math.floor((myPos - part.Position).Magnitude) or 0
                local col = isAlways and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(255, 200, 50)
                if not isOpen then col = Color3.fromRGB(255, 80, 80) end

                if stroke then stroke.Color = col end
                if tTop then
                    tTop.Text = string.format("%s  [%dm]", title, dist)
                    tTop.TextColor3 = col
                end
                if tSub then
                    tSub.Text = string.format("[%s]", cond)
                end
            else
                if extractBadges[pName] then extractBadges[pName].Enabled = false end
            end

            if Settings.ExtractChams then
                local hl = extractHighlights[pName]
                if not hl or not hl.Parent then
                    hl = Instance.new("Highlight")
                    hl.Name = "HPS_ExtractHL"
                    hl.Adornee = part
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = part
                    extractHighlights[pName] = hl
                end
                hl.Enabled = true
                local col = isAlways and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(255, 190, 40)
                if not isOpen then col = Color3.fromRGB(255, 70, 70) end
                hl.FillColor = col
                hl.OutlineColor = col
            else
                if extractHighlights[pName] then extractHighlights[pName].Enabled = false end
            end
        end
    end
end

local function FindTargetExtract()
    local raid = Workspace:FindFirstChild("Raid")
    local extracts = raid and raid:FindFirstChild("Extracts")
    if not extracts then return nil end

    local targetPref = Settings.ExtractTarget or "Auto (Nearest Open)"
    if targetPref ~= "Auto (Nearest Open)" then
        local p = extracts:FindFirstChild(targetPref)
        if p and p:IsA("BasePart") then return p end
    end

    local myChar = LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name))
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("UpperTorso"))
    local myPos = myRoot and myRoot.Position or Vector3.zero

    local bestPart = nil
    local bestDist = math.huge

    for _, part in ipairs(extracts:GetChildren()) do
        if part:IsA("BasePart") and part:GetAttribute("Condition") == "Always open" and part:GetAttribute("Open") ~= false then
            local dist = (myPos - part.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestPart = part
            end
        end
    end

    if bestPart then return bestPart end

    for _, part in ipairs(extracts:GetChildren()) do
        if part:IsA("BasePart") and part:GetAttribute("Open") ~= false then
            local dist = (myPos - part.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestPart = part
            end
        end
    end

    return bestPart
end

local function RestoreCharacterCollision(char)
    if not char then return end
    local standardCollide = {
        ["HumanoidRootPart"] = true,
        ["UpperTorso"] = true,
        ["LowerTorso"] = true,
        ["Torso"] = true,
        ["Head"] = true,
    }
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            if standardCollide[p.Name] then
                pcall(function() p.CanCollide = true end)
            else
                pcall(function() p.CanCollide = false end)
            end
        end
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("BodyVelocity") or c:IsA("BodyGyro") or c.Name == "HPS_FlyVelocity" or c.Name == "HPS_SkyGlideForce" then
                pcall(function() c:Destroy() end)
            end
        end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
end

local function StopSkyGlide()
    isGliding = false
    if activeGlideBV then
        pcall(function() activeGlideBV:Destroy() end)
        activeGlideBV = nil
    end
    if glideNoclipConn then
        pcall(function() glideNoclipConn:Disconnect() end)
        glideNoclipConn = nil
    end
    if glideBtnRef then
        glideBtnRef.Text = "Execute"
        glideBtnRef.BackgroundColor3 = Theme.BlueGlow
    end
    local myChar = LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name))
    if myChar then
        local root = myChar:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            for _, c in ipairs(root:GetChildren()) do
                if c:IsA("BodyVelocity") or c:IsA("BodyGyro") or c.Name == "HPS_SkyGlideForce" then
                    pcall(function() c:Destroy() end)
                end
            end
        end
        RestoreCharacterCollision(myChar)
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end
end

local function StartSkyGlide(btn)
    if isGliding then
        StopSkyGlide()
        return
    end

    local myChar = LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name))
    local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not (myChar and root and hum and hum.Health > 0) then
        return
    end

    local targetPart = FindTargetExtract()
    if not targetPart then
        return
    end

    isGliding = true
    glideBtnRef = btn
    if btn then
        btn.Text = "STOP"
        btn.BackgroundColor3 = Color3.fromRGB(240, 60, 60)
    end

    task.spawn(function()
        -- Continuous NoClip so character glides straight through towers, roofs & obstacles
        glideNoclipConn = RunService.Stepped:Connect(function()
            if not isGliding or not myChar then return end
            for _, p in ipairs(myChar:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end)

        local flyAltitude = math.max(root.Position.Y + 20, targetPart.Position.Y + 18)

        local bv = Instance.new("BodyVelocity")
        bv.Name = "HPS_SkyGlideForce"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.new(0, 16, 0)
        bv.Parent = root
        activeGlideBV = bv

        -- Phase 1: Smooth lift to flight altitude
        local liftStart = os.clock()
        while isGliding and root.Parent and hum.Health > 0 and root.Position.Y < flyAltitude and (os.clock() - liftStart < 2.5) do
            bv.Velocity = Vector3.new(0, 16, 0)
            task.wait(0.04)
        end

        -- Phase 2: Horizontal flight at safe speed (server hard-cap is ~24 studs/s)
        local safeSpeed = math.clamp(tonumber(Settings.GlideSpeed) or 23, 10, 24)

        while isGliding and root.Parent and hum.Health > 0 do
            local currentPos = root.Position
            local targetPos = targetPart.Position
            local horizontalDiff = Vector3.new(targetPos.X - currentPos.X, 0, targetPos.Z - currentPos.Z)
            local horizontalDist = horizontalDiff.Magnitude

            if horizontalDist <= 14 then
                break -- Directly above extraction zone
            end

            local yDiff = flyAltitude - currentPos.Y
            local yVel = math.clamp(yDiff * 2, -10, 10)
            local hDir = horizontalDiff.Unit

            bv.Velocity = (hDir * safeSpeed) + Vector3.new(0, yVel, 0)
            task.wait(0.04)
        end

        -- Phase 3: Smooth descent into extraction zone
        if isGliding and root.Parent and hum.Health > 0 then
            local landY = targetPart.Position.Y + 2.5
            local landStart = os.clock()
            while isGliding and root.Parent and root.Position.Y > landY and hum.Health > 0 and (os.clock() - landStart < 3.5) do
                bv.Velocity = Vector3.new(0, -12, 0)
                task.wait(0.04)
            end
        end

        StopSkyGlide()
    end)
end

