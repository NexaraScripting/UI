local function GetZombieHeadPosition(t)
    if not t then return nil end
    if t.model and t.model:IsA("Model") then
        local head = t.model:FindFirstChild("Head") or t.model:FindFirstChild("head")
        if head and head:IsA("BasePart") then
            return head.Position
        end
    end
    if t.position then
        if t.isLying then
            return t.position + Vector3.new(0, 0.45, 0)
        end
        local prof = GetZombieProfile(t.typeId)
        local headY = prof.headY or 1.70
        return t.position + Vector3.new(0, headY, 0)
    end
    return nil
end

local function GetClosestZombieToCrosshair(fovRadius)
    local bestZombie = nil
    local bestHeadPos = nil
    local bestDist = fovRadius or Settings.ZombieAimFOV or 400
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local mousePos = GetPhysicalMouseLocation()
    local refPoint = mousePos or center

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
    local myEyePos = myTorso and (myTorso.Position + Vector3.new(0, 1.2, 0)) or Camera.CFrame.Position

    local targets = GetAllLivingZombies()
    local camPos = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector

    if Settings.BossAimbotPriority then
        local bestBoss = nil
        local bestBossHeadPos = nil
        local bestBossDist = bestDist
        for _, t in ipairs(targets) do
            local bossInfo = GetBossInfo(t.typeId, t.model)
            if bossInfo then
                local zId = tostring(t.id)
                local isEngineDead = (t.zRaw and t.zRaw.dead == true)
                if zId and not isEngineDead and zombieHealthTrack[zId] ~= 0 then
                    local headPos = GetZombieHeadPosition(t)
                    if headPos then
                        local isVisible = true
                        if Settings.ZombieWallCheck then
                            isVisible = IsTargetVisibleThroughWalls(myEyePos, headPos, t.model)
                            if not isVisible then
                                local bodyPos = headPos - Vector3.new(0, 0.8, 0)
                                isVisible = IsTargetVisibleThroughWalls(myEyePos, bodyPos, t.model)
                            end
                        end
                        if isVisible then
                            local toHead = headPos - camPos
                            if camLook:Dot(toHead) > 0 then
                                local sc = Camera:WorldToViewportPoint(headPos)
                                if sc.Z > 0 then
                                    local screenDist = (Vector2.new(sc.X, sc.Y) - refPoint).Magnitude
                                    if screenDist <= bestBossDist then
                                        bestBossDist = screenDist
                                        bestBoss = t
                                        bestBossHeadPos = headPos
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if bestBoss and bestBossHeadPos then
            return bestBoss, bestBossHeadPos
        end
    end

    for _, t in ipairs(targets) do
        local zId = tostring(t.id)
        local isEngineDead = (t.zRaw and t.zRaw.dead == true)
        if zId and not isEngineDead then
            local headPos = GetZombieHeadPosition(t)
            if headPos then
                local isVisible = true
                if Settings.ZombieWallCheck then
                    isVisible = IsTargetVisibleThroughWalls(myEyePos, headPos, t.model)
                    if not isVisible then
                        local bodyPos = headPos - Vector3.new(0, 0.8, 0)
                        isVisible = IsTargetVisibleThroughWalls(myEyePos, bodyPos, t.model)
                    end
                end

                if isVisible then
                    local toHead = headPos - camPos
                    if camLook:Dot(toHead) > 0 then
                        local sc = Camera:WorldToViewportPoint(headPos)
                        if sc.Z > 0 then
                            local screenDist = (Vector2.new(sc.X, sc.Y) - refPoint).Magnitude
                            if screenDist <= bestDist then
                                bestDist = screenDist
                                bestZombie = t
                                bestHeadPos = headPos
                            end
                        end
                    end
                end
            end
        end
    end

    return bestZombie, bestHeadPos
end

