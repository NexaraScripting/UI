local function ExecuteShopPurchase(item, count, callback)
    count = count or 1

    if not IsInHideout() then
        if callback then callback(false, "Blocked: Inside raid match") end
        return false
    end

    local playerCash = FetchPlayerCash()
    local unitPrice = tonumber(item.price) or 0
    local totalPrice = unitPrice * count
    if playerCash > 0 and totalPrice > 0 and playerCash < totalPrice then
        if callback then callback(false, "Insufficient Cash ($" .. tostring(playerCash) .. ")") end
        return false
    end

    local api = GetMenuApi()
    if api and api.op then
        local okBuy = false
        pcall(function()
            api.op({
                op     = "buy",
                trader = item.trader,
                offer  = item.key,
                count  = count
            })
            okBuy = true
        end)
        if okBuy then
            if callback then callback(true, "Purchased via Menu Controller") end
            return true
        end
    end

    local Rep = game:GetService("ReplicatedStorage")
    local HushNet = Rep:FindFirstChild("HushNet")
    local buyRemote = HushNet and HushNet:FindFirstChild("menu.op")
    local resultRemote = HushNet and HushNet:FindFirstChild("menu.result")

    if not buyRemote then
        if callback then callback(false, "Remote missing") end
        return false
    end

    local conn
    local timeoutTask
    if resultRemote then
        conn = resultRemote.OnClientEvent:Connect(function(res)
            if type(res) == "table" and res.op == "buy" then
                if conn then conn:Disconnect() conn = nil end
                if timeoutTask then task.cancel(timeoutTask) end
                if callback then
                    callback(res.ok == true, res.msg or (res.ok and "Purchased" or "Error"))
                end
            end
        end)
        timeoutTask = task.delay(3.5, function()
            if conn then conn:Disconnect() conn = nil end
            if callback then callback(false, "Timeout") end
        end)
    end

    pcall(function()
        buyRemote:FireServer({
            op     = "buy",
            trader = item.trader,
            offer  = item.key,
            count  = count,
            req    = math.floor(tick() * 100) % 1000000
        })
    end)
    return true
end

