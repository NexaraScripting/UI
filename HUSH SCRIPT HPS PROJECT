local itemViewportModelCache = {}
local function BuildItem3DViewport(id)
    if not id then return nil end
    local rs = game:GetService("ReplicatedStorage")
    local shared = rs:FindFirstChild("Hush") and rs.Hush:FindFirstChild("Shared")
    if not shared then return nil end
    local Items = shared:FindFirstChild("Items") and require(shared.Items)
    if not Items then return nil end
    local itemDef = Items.get(id)
    if not itemDef then return nil end

    local vf = Instance.new("ViewportFrame")
    vf.Name = "Item3DIcon"
    vf.Size = UDim2.fromScale(1, 1)
    vf.Position = UDim2.fromScale(0, 0)
    vf.BackgroundTransparency = 1
    vf.BorderSizePixel = 0
    vf.Ambient = Color3.fromRGB(150, 155, 160)
    vf.LightColor = Color3.fromRGB(255, 250, 240)
    vf.LightDirection = Vector3.new(-0.6, -1, -0.35)

    local cam = Instance.new("Camera")
    cam.FieldOfView = 24
    cam.Parent = vf
    vf.CurrentCamera = cam

    local newModel = nil
    if itemViewportModelCache[id] then
        newModel = itemViewportModelCache[id]:Clone()
    else
        local hushAssets = rs:FindFirstChild("HushAssets")
        if hushAssets then
            if itemDef.category == "melee" and hushAssets:FindFirstChild("Melee") and hushAssets.Melee:FindFirstChild(id) then
                newModel = hushAssets.Melee[id]:Clone()
            elseif itemDef.category == "firearm" and hushAssets:FindFirstChild("Weapon") and hushAssets.Weapon:FindFirstChild(id) then
                newModel = hushAssets.Weapon[id]:Clone()
            elseif hushAssets:FindFirstChild("Item") and hushAssets.Item:FindFirstChild(id) then
                newModel = hushAssets.Item[id]:Clone()
            end
        end

        local fbItemMod = shared:FindFirstChild("Fallbacks") and shared.Fallbacks:FindFirstChild("Item")
        local fbItem = fbItemMod and require(fbItemMod)
        local fbUps = fbItem and debug.getupvalues(fbItem.default)
        local normalise = fbUps and fbUps[5]
        local builders = fbUps and fbUps[6]

        if not newModel and builders then
            local b = builders[itemDef.category] or builders.material
            newModel = Instance.new("Model")
            newModel.Name = id
            pcall(b, newModel, itemDef)
        end

        if newModel and normalise then
            pcall(normalise, newModel, itemDef.w or 1, itemDef.h or 1, false)
            itemViewportModelCache[id] = newModel:Clone()
        end
    end

    if newModel then
        newModel.Parent = vf

        local lib = LocalPlayer.PlayerScripts:FindFirstChild("HushClient") and LocalPlayer.PlayerScripts.HushClient:FindFirstChild("Lib")
        local itemIconsMod = lib and lib:FindFirstChild("ItemIcons")
        local itemIcons = itemIconsMod and require(itemIconsMod)
        local getUps = itemIcons and debug.getupvalues(itemIcons.get)
        local aimFunc = getUps and getUps[6]

        local cframe, size = newModel:GetBoundingBox()
        local data = {
            id = id,
            model = newModel,
            cam = cam,
            rotated = false,
            key = id,
            ext = size,
            center = cframe.Position
        }
        if aimFunc then
            pcall(aimFunc, vf, data)
        else
            local maxDim = math.max(size.X, size.Y, size.Z, 0.5)
            local dist = maxDim / (2 * math.tan(math.rad(cam.FieldOfView / 2)))
            cam.CFrame = CFrame.new(cframe.Position + Vector3.new(0, 0, dist * 1.3), cframe.Position)
        end
        return vf
    end
    return nil
end

