local lastDoorCheck = 0

local function EnforceDoorBypass()
    local now = tick()
    if now - lastDoorCheck < 0.5 then return end
    lastDoorCheck = now

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position or Vector3.new(0, 0, 0)

    local cs = game:GetService("CollectionService")
    local activeDoorBadges = {}

    for _, d in ipairs(cs:GetTagged("HushDoor")) do
        local lockedKey = d:GetAttribute("Locked")
        if lockedKey then
            if Settings.BypassLockedDoors then
                for _, p in ipairs(d:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then
                        p.CanCollide = false
                    end
                end
            end

            local pivot = d:GetPivot()
            local distStuds = (pivot.Position - myPos).Magnitude
            local distM = math.floor(distStuds * 0.28)
            if distStuds <= 400 and lootGui then
                local sc, onScreen = Camera:WorldToViewportPoint(pivot.Position + Vector3.new(0, 3, 0))
                if onScreen and sc.Z > 0 then
                    activeDoorBadges[d] = true
                    local badge = doorBadges[d]
                    if not badge or not badge.Root.Parent then
                        badge = CreateLootBadge(d)
                        doorBadges[d] = badge
                    end

                    local doorTitle = "KEYCARD DOOR"
                    local bId = d:GetAttribute("BuildingId") or ""
                    if bId == "police" then doorTitle = "POLICE ARMORY"
                    elseif bId == "gunstore" then doorTitle = "GUN STORE ARMORY"
                    elseif bId == "pharmacy" then doorTitle = "PHARMACY LAB"
                    elseif bId == "townhall" then doorTitle = "MAYOR OFFICE"
                    end

                    badge.Root.Position = UDim2.fromOffset(sc.X, sc.Y - 10)
                    badge.TopLabel.TextColor3 = Color3.fromRGB(0, 240, 255)
                    badge.TopLabel.Text = string.format("[%s]  WALK IN", doorTitle)
                    badge.SubLabel.Text = string.format("[KEY: %s]  [%dm]", lockedKey:gsub("key_", ""), distM)
                    badge.Root.Visible = true
                end
            end
        end
    end

    for d, badge in pairs(doorBadges) do
        if not activeDoorBadges[d] then
            if badge.Root then badge.Root:Destroy() end
            doorBadges[d] = nil
        end
    end
end

