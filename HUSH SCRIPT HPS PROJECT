local function RunAimbotStep()
    if (HPS_Main and HPS_Main.Visible)
    or (LocalPlayer and LocalPlayer:GetAttribute("InvUIOpen") == true)
    or (HushInput and HushInput.gameBlocked and HushInput.gameBlocked())
    or (HushInput and HushInput._panelOpen and HushInput._panelOpen())
    or UserInputService:GetFocusedTextBox() then
        currentAimLockScreenPos = nil
        if lockedTargetPlayer ~= nil or lockedTargetZombie ~= nil then
            lockedTargetPlayer = nil
            lockedTargetZombie = nil
            currentLerpedAimPos = nil
            pcall(function() HushInput.setAimOverride(nil) end)
        end
        if lockTracerDrawing then lockTracerDrawing.Visible = false end
        return
    end

    if not HushInput or not HushInput.setAimOverride then
        currentLockedTargetPos = nil
        if lockTracerDrawing then lockTracerDrawing.Visible = false end
        return
    end

    local isFiring = (HushInput.isFiring and HushInput.isFiring()) or false
    local isAiming = (HushInput.isAiming and HushInput.isAiming()) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    local isTriggerActive = IsAimTriggerActive() or (Settings.ZombieAutoLockOnFire and isFiring) or isAiming

    if isTriggerActive then
        local targetWorldPos = nil
        local isZombieTarget = false

        if Settings.ZombieAimbot then
            local zObj, zHeadPos = GetClosestZombieToCrosshair(Settings.ZombieAimFOV or 400)
            if zObj and zHeadPos then
                lockedTargetZombie = zObj
                lockedTargetPlayer = nil
                targetWorldPos = zHeadPos
                isZombieTarget = true
            end
        end

        if not targetWorldPos and Settings.AimbotEnabled then
            local targetPlr = GetClosestPlayerToCrosshair(Settings.AimbotFOV)
            if targetPlr then
                local char = targetPlr.Character or Workspace:FindFirstChild(targetPlr.Name)
                local targetPart = GetPlayerTorsoOrHead(char, Settings.AimPart)
                if targetPart then
                    lockedTargetPlayer = targetPlr
                    lockedTargetZombie = nil
                    targetWorldPos = targetPart.Position
                end
            end
        end

        if targetWorldPos then
            currentLockedTargetPos = targetWorldPos
            local smoothness = math.clamp(Settings.AimbotSmoothness or 1, 1, 20)
            if (isFiring and Settings.ZombieAutoLockOnFire and isZombieTarget) then
                smoothness = 1
            end

            if not currentLerpedAimPos or smoothness <= 1 then
                currentLerpedAimPos = targetWorldPos
            else
                currentLerpedAimPos = currentLerpedAimPos:Lerp(targetWorldPos, 1 / smoothness)
            end

            pcall(function() HushInput.setAimOverride(currentLerpedAimPos) end)

            local sc = Camera:WorldToViewportPoint(targetWorldPos)
            if sc.Z > 0 then
                local guiInset = GuiService:GetGuiInset()
                local screenX = sc.X
                local screenY = sc.Y + (guiInset and guiInset.Y or 58)

                if mousemoveabs then
                    pcall(mousemoveabs, screenX, screenY)
                elseif mousemoverel then
                    local curMouse = UserInputService:GetMouseLocation()
                    pcall(mousemoverel, (screenX - curMouse.X) / smoothness, (screenY - curMouse.Y) / smoothness)
                end
            end

            if Settings.DrawLockLine and lockTracerDrawing then
                local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
                local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
                if myTorso then
                    local mySc, myOn = Camera:WorldToViewportPoint(myTorso.Position)
                    local tgSc, tgOn = Camera:WorldToViewportPoint(targetWorldPos)
                    if tgSc.Z > 0 then
                        local fromPt = myOn and Vector2.new(mySc.X, mySc.Y) or Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        lockTracerDrawing.From = fromPt
                        lockTracerDrawing.To = Vector2.new(tgSc.X, tgSc.Y)
                        lockTracerDrawing.Color = isZombieTarget and Color3.fromRGB(255, 60, 60) or Theme.LockColor
                        lockTracerDrawing.Visible = true
                    else
                        lockTracerDrawing.Visible = false
                    end
                end
            end
            return
        end
    end

    currentLockedTargetPos = nil
    if lockedTargetPlayer ~= nil or lockedTargetZombie ~= nil then
        lockedTargetPlayer = nil
        lockedTargetZombie = nil
        currentLerpedAimPos = nil
        pcall(function() HushInput.setAimOverride(nil) end)
    end
    if lockTracerDrawing then lockTracerDrawing.Visible = false end
end

