local function GetCompassArrow(flatDiff, camRight, camForward)
    local relX = flatDiff:Dot(camRight)
    local relY = flatDiff:Dot(camForward)
    local angle = math.deg(math.atan2(relX, relY))
    if angle >= -22.5 and angle < 22.5 then return "▲"
    elseif angle >= 22.5 and angle < 67.5 then return "↗"
    elseif angle >= 67.5 and angle < 112.5 then return "▶"
    elseif angle >= 112.5 and angle < 157.5 then return "↘"
    elseif angle >= -67.5 and angle < -22.5 then return "↖"
    elseif angle >= -112.5 and angle < -67.5 then return "◀"
    elseif angle >= -157.5 and angle < -112.5 then return "↙"
    else return "▼" end
end

local function UpdateHotspotsHUD(myPos, camRight, camForward)
    if not hotspotGui or not hotspotFrame then return end
    if not Settings.LootESPEnabled or not Settings.LootHotspotsHUD then
        hotspotGui.Enabled = false
        return
    end
    hotspotGui.Enabled = true

    local cratesWithDist = {}
    for _, loot in ipairs(cachedLootData) do
        if loot.TotalValue >= 2500 then
            local distStuds = (loot.Position - myPos).Magnitude
            local distM = math.floor(distStuds * 0.28)
            table.insert(cratesWithDist, {
                loot = loot,
                distStuds = distStuds,
                distM = distM
            })
        end
    end

    if #cratesWithDist < 5 then
        for _, loot in ipairs(cachedLootData) do
            if loot.TotalValue < 2500 and loot.TotalValue > 0 then
                local distStuds = (loot.Position - myPos).Magnitude
                local distM = math.floor(distStuds * 0.28)
                table.insert(cratesWithDist, {
                    loot = loot,
                    distStuds = distStuds,
                    distM = distM
                })
            end
        end
    end

    table.sort(cratesWithDist, function(a, b)
        return a.distStuds < b.distStuds
    end)

    for i = 1, 5 do
        local rowUI = hotspotRows[i]
        local item = cratesWithDist[i]
        if item and item.loot.TotalValue > 0 then
            local loot = item.loot
            local diff = loot.Position - myPos
            local flatDiff = Vector3.new(diff.X, 0, diff.Z)
            if flatDiff.Magnitude > 0 then flatDiff = flatDiff.Unit else flatDiff = Vector3.new(0,0,1) end
            local arrow = GetCompassArrow(flatDiff, camRight, camForward)
            local tierColor = GetLootColor(loot.TotalValue)
            local crateName = FormatCrateName(loot.Kind)
            local bldName = FormatBuildingName(loot.BuildingId, loot.BuildingId)

            if loot.HasStreamed then
                if loot.TotalValue > 0 then
                    rowUI.Line1.Text = string.format("%d. [%s] %s  [%dm %s]", i, string.upper(crateName), FormatPrice(loot.TotalValue), item.distM, arrow)
                    rowUI.Line1.TextColor3 = tierColor
                    local itemsText = (loot.ItemsWithPrices and #loot.ItemsWithPrices > 0) and table.concat(loot.ItemsWithPrices, " · ") or (loot.TopItem or "Looted")
                    rowUI.Line2.Text = string.format("   %s · %s", itemsText:sub(1, 26), bldName:sub(1, 14))
                else
                    rowUI.Line1.Text = string.format("%d. [%s] EMPTY ($0)  [%dm %s]", i, string.upper(crateName), item.distM, arrow)
                    rowUI.Line1.TextColor3 = Theme.SubText
                    rowUI.Line2.Text = string.format("   [-] No Items · %s", bldName:sub(1, 18))
                end
            else
                rowUI.Line1.Text = string.format("%d. [%s] UNOPENED  [%dm %s]", i, string.upper(crateName), item.distM, arrow)
                rowUI.Line1.TextColor3 = tierColor
                local poolHint = "Pool: High Loot"
                if loot.Kind == "Safe" then poolHint = "Pool: Gold / Keys / Cash"
                elseif loot.Kind == "WeaponCrate" then poolHint = "Pool: Guns / Scopes / Ammo"
                elseif loot.Kind == "Register" then poolHint = "Pool: Cash / Coins"
                elseif loot.Kind == "Duffel" then poolHint = "Pool: Weapons / Bags"
                elseif loot.Kind == "MedCabinet" then poolHint = "Pool: Medical / Stims"
                end
                rowUI.Line2.Text = string.format("   [%s] · %s", poolHint, bldName:sub(1, 14))
            end
            rowUI.Row.Visible = true
        else
            if rowUI then rowUI.Row.Visible = false end
        end
    end
end

