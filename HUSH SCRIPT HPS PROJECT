    local char = LocalPlayer.Character or (Workspace and Workspace:FindFirstChild(LocalPlayer.Name))
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (char and root and hum and hum.Health > 0) then return end

    isFlying = true
    Settings.FlyEnabled = true

    -- Prevent falling state flailing
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    local targetAltitude = root.Position.Y + (tonumber(Settings.FlyAltitude) or 12)

    local bv = Instance.new("BodyVelocity")
    bv.Name = "HPS_FlyVelocity"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    flyBV = bv

    task.spawn(function()
        local lastTime = os.clock()
        while isFlying and root.Parent and hum.Health > 0 do
            local now = os.clock()
            local dt = math.clamp(now - lastTime, 0.01, 0.1)
            lastTime = now

            local isTyping = (UserInputService:GetFocusedTextBox() ~= nil)
            if HushInput and HushInput.isTyping and HushInput.isTyping() then
                isTyping = true
            end

            local cam = Workspace.CurrentCamera
            local camCF = cam and cam.CFrame or CFrame.identity

            -- Horizontal movement strictly parallel to ground (Y = 0)
            local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
            local right = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
            forward = forward.Magnitude > 0.001 and forward.Unit or Vector3.new(0, 0, -1)
            right = right.Magnitude > 0.001 and right.Unit or Vector3.new(1, 0, 0)

            local hMove = Vector3.zero
            if not isTyping then
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then hMove = hMove + forward end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then hMove = hMove - forward end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then hMove = hMove + right end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then hMove = hMove - right end

                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    targetAltitude = targetAltitude + (14 * dt)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
                    targetAltitude = targetAltitude - (14 * dt)
                end
            end

            local maxSpeed = math.clamp(tonumber(Settings.FlySpeed) or 20, 10, 24)
            local hVel = Vector3.zero
            if hMove.Magnitude > 0.01 then
                hVel = hMove.Unit * maxSpeed
            end

            -- Smooth vertical lock to target altitude (Suspended Hover)
            local yDiff = targetAltitude - root.Position.Y
            local yVel = math.clamp(yDiff * 7, -16, 16)

            bv.Velocity = hVel + Vector3.new(0, yVel, 0)
            task.wait(0.02)
        end
        StopFly()
    end)
end

local function ToggleFly()
    if isFlying then
        StopFly()
    else
        StartFly()
    end
    if registeredToggleSetters["FlyEnabled"] then
        pcall(registeredToggleSetters["FlyEnabled"], isFlying)
    end
end

-- // Infinite Stamina System
local staminaConns = {}
local function EnforceCharStamina(char)
    if not char or not Settings.InfiniteStamina then return end
    pcall(function()
        if char:GetAttribute("Stamina") ~= 100 then char:SetAttribute("Stamina", 100) end
        if char:GetAttribute("SprintDrain") ~= 0 then char:SetAttribute("SprintDrain", 0) end
        if char:GetAttribute("Exhausted") ~= false then char:SetAttribute("Exhausted", false) end
        if char:GetAttribute("ExhaustedWalkMul") ~= 1 then char:SetAttribute("ExhaustedWalkMul", 1) end
    end)
end

local function BindCharStamina(char)
    for _, c in ipairs(staminaConns) do pcall(function() c:Disconnect() end) end
    table.clear(staminaConns)
    if not char then return end

    EnforceCharStamina(char)
    table.insert(staminaConns, char:GetAttributeChangedSignal("Stamina"):Connect(function()
        EnforceCharStamina(char)
    end))
    table.insert(staminaConns, char:GetAttributeChangedSignal("Exhausted"):Connect(function()
        EnforceCharStamina(char)
    end))
    table.insert(staminaConns, char:GetAttributeChangedSignal("SprintDrain"):Connect(function()
        EnforceCharStamina(char)
    end))
    table.insert(staminaConns, char:GetAttributeChangedSignal("ExhaustedWalkMul"):Connect(function()
        EnforceCharStamina(char)
    end))
end

if LocalPlayer.Character then
