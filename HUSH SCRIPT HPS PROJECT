local function GetZombieMaxHP(zId)
    local zIdStr = tostring(zId)
    local targets = GetAllLivingZombies()
    for _, t in ipairs(targets) do
        if tostring(t.id) == zIdStr then
            local typeId = (t.typeId or "walker"):lower()
            local prof, typeKey = GetZombieProfile(typeId)
            local zDef = HushZombieTypes and HushZombieTypes.get and HushZombieTypes.get(typeId)
            local bossInfo = GetBossInfo(typeId, t.model)
            local maxHp = (bossInfo and bossInfo.maxHp) or (zDef and zDef.hp) or prof.hp or ZOMBIE_MAX_HP[typeKey] or 100
            local armorFactor = (zDef and zDef.armor) or prof.armor or 1.0
            local isArmored = prof.isArmored or (armorFactor < 1)
            if t.model and t.model:IsA("Model") then
                if t.model:GetAttribute("Armored") or t.model:GetAttribute("Armor") or t.model:GetAttribute("HasArmor") then
                    isArmored = true
                elseif t.model:FindFirstChild("Vest") or t.model:FindFirstChild("Helmet") or t.model:FindFirstChild("Armor") or t.model:FindFirstChild("RiotShield") or t.model:FindFirstChild("Plate") then
                    isArmored = true
                end
            end
            local headY = prof.headY or 1.70
            return maxHp, isArmored, typeKey, t, armorFactor, headY, prof
        end
    end
    local defaultProf = GetZombieProfile("walker")
    return 100, false, "walker", nil, 1.0, 1.70, defaultProf
end

