local currentLockedTargetPos = nil

local function GetPhysicalMouseLocation()
    return UserInputService:GetMouseLocation()
end

local function IsTargetVisibleThroughWalls(originPos, targetPos, targetModel)
    if not originPos or not targetPos then return false end
    local diff = targetPos - originPos
    local dist = diff.Magnitude
    if dist < 0.5 then return true end

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local ignoreList = { myChar }
    if targetModel then
        table.insert(ignoreList, targetModel)
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    rayParams.FilterDescendantsInstances = ignoreList

    local curOrigin = originPos
    local curDir = diff

    for _ = 1, 6 do
        local result = Workspace:Raycast(curOrigin, curDir, rayParams)
        if not result then
            return true
        end

        local hitPart = result.Instance
        if not hitPart then return true end

        if targetModel and (hitPart:IsDescendantOf(targetModel) or hitPart == targetModel) then
            return true
        end

        local isWall = false
        if CollectionService:HasTag(hitPart, "HushWall")
           or CollectionService:HasTag(hitPart, "HushWallBase")
           or hitPart.Name == "Border" then
            isWall = true
        else
            local doorModel = hitPart:FindFirstAncestorOfClass("Model")
            while doorModel do
                if CollectionService:HasTag(doorModel, "HushDoor") then
                    local state = doorModel:GetAttribute("State")
                    if state == "Closed" or state == "Locked" or hitPart.CanCollide then
                        isWall = true
                        break
                    end
                end
                doorModel = doorModel:FindFirstAncestorOfClass("Model")
            end
        end

        if not isWall and hitPart.CanCollide and hitPart.Transparency < 0.8 then
            if not CollectionService:HasTag(hitPart, "HushWindow")
               and not hitPart.Name:lower():find("glass")
               and not hitPart.Name:lower():find("window") then
                isWall = true
            end
        end

        if isWall then
            return false
        end

        table.insert(ignoreList, hitPart)
        rayParams.FilterDescendantsInstances = ignoreList
        curOrigin = result.Position + diff.Unit * 0.05
        curDir = targetPos - curOrigin
        if curDir.Magnitude < 0.2 then
            return true
        end
    end

    return false
end

local function IsAimTriggerActive()
    if Settings.AimTrigger == "Always Active" then return true
    elseif Settings.AimTrigger == "Right Mouse" then
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    elseif Settings.AimTrigger == "Left Alt" then
        return UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)
    elseif Settings.AimTrigger == "E Key" then
        return UserInputService:IsKeyDown(Enum.KeyCode.E)
    end
    return false
end

local function GetClosestPlayerToCrosshair(fovRadius)
    local bestPlr = nil
    local bestDist = fovRadius or Settings.AimbotFOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local mousePos = GetPhysicalMouseLocation()
    local refPoint = mousePos or center

    local myChar = LocalPlayer.Character or Workspace:FindFirstChild(LocalPlayer.Name)
    local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
    local myEyePos = myTorso and (myTorso.Position + Vector3.new(0, 1.2, 0)) or Camera.CFrame.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and IsPlayerAlive(plr) and not IsTeammate(plr) then
            local char = plr.Character or Workspace:FindFirstChild(plr.Name)
            local targetPart = GetPlayerTorsoOrHead(char, Settings.AimPart)
            if targetPart then
                local isVisible = true
                if Settings.WallCheck then
                    isVisible = IsTargetVisibleThroughWalls(myEyePos, targetPart.Position, char)
                    if not isVisible then
                        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
                        if torso and torso ~= targetPart then
                            isVisible = IsTargetVisibleThroughWalls(myEyePos, torso.Position, char)
                        end
                    end
                end

                if isVisible then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen and screenPos.Z > 0 then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - refPoint).Magnitude
                        if screenDist <= bestDist then
                            bestDist = screenDist
                            bestPlr = plr
                        end
                    end
                end
            end
        end
    end

    return bestPlr
end

