local function PlayCardEntranceAnimation(pageName)
    local cards = PageCards[pageName]
    if not cards or #cards == 0 then return end
    for i, card in ipairs(cards) do
        card.Position = UDim2.fromOffset(0, 16)
        card.GroupTransparency = 1
        local delayTime = (i - 1) * 0.03
        task.delay(delayTime, function()
            if card and card.Parent then
                Tween(card, 0.25, {
                    Position = UDim2.fromOffset(0, 0),
                    GroupTransparency = 0
                }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out):Play()
            end
        end)
    end
end

local function SwitchTab(targetName)
    currentActiveTab = targetName

    local pageHome = PageHolder:FindFirstChild("Page_Home")
    if pageHome then pageHome.Visible = (targetName == "Home") end

    local pageSettings = PageHolder:FindFirstChild("Page_Settings")
    if pageSettings then pageSettings.Visible = (targetName == "Settings") end

    for _, child in ipairs(PageHolder:GetChildren()) do
        if child:IsA("ScrollingFrame") and child.Name:match("^Page_") then
            child.Visible = (child.Name == "Page_" .. targetName)
        end
    end

    local settingsTitle = HPS_Main and HPS_Main:FindFirstChild("SettingsTitleContainer", true)
    if settingsTitle then
        settingsTitle.Visible = (targetName == "Settings")
    end
    if searchContainer then
        searchContainer.Visible = (targetName == "Home")
    end
    if TitleContainer then
        TitleContainer.Visible = (targetName ~= "Home" and targetName ~= "Settings")
        if TopbarTitle then
            TopbarTitle.Text = targetName
        end
        if TopbarIcon and (Icons[targetName] or Icons.Crosshair) then
            TopbarIcon.Image = Icons[targetName] or Icons.Crosshair
        end
    end

    if HomeBtn then
        local hBg = HomeBtn:FindFirstChild("Frame")
        local hInd = HomeBtn:FindFirstChild("Indicator")
        local hTxt = HomeBtn:FindFirstChildOfClass("TextLabel")
        local isHome = (targetName == "Home")
        if hBg then
            Tween(hBg, 0.2, {
                BackgroundColor3 = isHome and Theme.ActiveBg or Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = isHome and 0 or 1
            }):Play()
        end
        if hInd then
            Tween(hInd, 0.2, { BackgroundTransparency = isHome and 0 or 1 }):Play()
        end
        if hTxt then
            hTxt.TextColor3 = isHome and Theme.Text or Theme.SubText
        end
    end

    if SettingsBtn then
        local sBg = SettingsBtn:FindFirstChild("Frame")
        local sTxt = SettingsBtn:FindFirstChildOfClass("TextLabel")
        local isSettings = (targetName == "Settings")
        if sBg then
            Tween(sBg, 0.2, {
                BackgroundColor3 = isSettings and Theme.ActiveBg or Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = isSettings and 0 or 1
            }):Play()
        end
        if sTxt then
            sTxt.TextColor3 = isSettings and Theme.Text or Theme.SubText
        end
    end

    for name, data in pairs(InjectedTabs) do
        local isSel = (name == targetName)
        if data.Bg then
            Tween(data.Bg, 0.2, {
                BackgroundColor3 = isSel and Theme.ActiveBg or Color3.fromRGB(0, 0, 0),
                BackgroundTransparency = isSel and 0 or 1
            }):Play()
        end
        if data.Indicator then
            Tween(data.Indicator, 0.2, { BackgroundTransparency = isSel and 0 or 1 }):Play()
        end
        if data.Icon then
            Tween(data.Icon, 0.2, { ImageColor3 = isSel and Theme.Text or Theme.SubText }):Play()
        end
        if data.Title then
            Tween(data.Title, 0.2, { TextColor3 = isSel and Theme.Text or Theme.SubText }):Play()
            data.Title.Font = isSel and Fonts.Bold or Fonts.Medium
        end
    end

    PlayCardEntranceAnimation(targetName)
end

