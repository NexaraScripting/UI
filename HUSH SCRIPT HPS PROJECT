local RefreshShopItems
local isAutoBuyingActive = false
local function TriggerAutoBuyProcess(sourceName, targetTrader)
    if isAutoBuyingActive then return end

    if not IsInHideout() then
        UpdateAutoBuyHeader()
        return
    end

    local curCash = FetchPlayerCash()
    if curCash <= 0 then return end

    local tData = FetchTradersServerData(true)
    if not (tData and tData.traders) then return end

    local allItems = GetShopDatabase()
    local toBuy = {}

    for _, item in ipairs(allItems) do
        if Settings.AutoBuyItems and Settings.AutoBuyItems[item.key] == true then
            if not targetTrader or targetTrader == "all" or item.trader == targetTrader then
                local liveOffer = nil
                local tInfo = tData.traders[item.trader]
                if tInfo and tInfo.offers then
                    for _, off in ipairs(tInfo.offers) do
                        if off.key == item.key then
                            liveOffer = off
                            break
                        end
                    end
                end

                local stockLeft = liveOffer and liveOffer.left
                if stockLeft == nil or stockLeft > 0 then
                    local itemCopy = table.clone(item)
                    if liveOffer and liveOffer.price then
                        itemCopy.price = liveOffer.price
                    end
                    itemCopy.stockLeft = stockLeft
                    table.insert(toBuy, itemCopy)
                end
            end
        end
    end

    if #toBuy == 0 then return end
    isAutoBuyingActive = true

    if quickBuyTxt then quickBuyTxt.Text = "Buying..." end
    if quickBuyBtn then Tween(quickBuyBtn, 0.2, { BackgroundColor3 = Theme.ActiveBg }):Play() end

    task.spawn(function()
        local purchasedCount = 0
        for _, item in ipairs(toBuy) do
            if not IsInHideout() then break end

            local curCashNow = FetchPlayerCash()
            local unitPrice = tonumber(item.price) or 0
            if curCashNow <= 0 or (unitPrice > 0 and curCashNow < unitPrice) then break end

            local maxAllowed = item.stockLeft or item.limit or (item.cat == "ammo" and 5 or 3)
            local qty = math.clamp(maxAllowed, 1, 10)

            if unitPrice > 0 and curCashNow < (unitPrice * qty) then
                qty = math.max(1, math.floor(curCashNow / unitPrice))
            end

            local ok = ExecuteShopPurchase(item, qty)
            if ok then
                purchasedCount = purchasedCount + 1
            end

            task.wait(0.35 + math.random() * 0.3)
        end

        task.wait(0.4)
        RefreshCashUI()
        cachedTradersServerData = nil
        FetchTradersServerData(true)
        pcall(RefreshShopItems)

        if quickBuyTxt then quickBuyTxt.Text = purchasedCount > 0 and ("Bought (" .. purchasedCount .. ")") or "Done" end
        if quickBuyBtn then Tween(quickBuyBtn, 0.2, { BackgroundColor3 = Theme.Success }):Play() end
        task.delay(1.5, function()
            if quickBuyTxt then quickBuyTxt.Text = "Buy Selected" end
            if quickBuyBtn then Tween(quickBuyBtn, 0.2, { BackgroundColor3 = Color3.fromRGB(20, 42, 32) }):Play() end
            isAutoBuyingActive = false
        end)
    end)
end

