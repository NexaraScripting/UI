RefreshShopItems = function(forceReload)
    for _, child in ipairs(ShopLeft:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("^ItemCard_") then child:Destroy() end
    end
    for _, child in ipairs(ShopRight:GetChildren()) do
        if child:IsA("Frame") and child.Name:match("^ItemCard_") then child:Destroy() end
    end

    local allItems = GetShopDatabase(forceReload)
    local filtered = {}
    local query = ""
    pcall(function()
        if searchInput and searchInput.Text then
            query = searchInput.Text:lower():gsub("^%s*(.-)%s*$", "%1")
        end
    end)

    for _, item in ipairs(allItems) do
        local matchCat = (selectedShopCategory == "all") or (item.cat == selectedShopCategory)
        local matchTrader = (selectedShopTrader == "all") or (item.trader == selectedShopTrader)
        local matchQuery = (query == "")
            or (item.name:lower():find(query, 1, true))
            or (item.desc:lower():find(query, 1, true))
            or (item.details:lower():find(query, 1, true))
            or (item.key:lower():find(query, 1, true))
            or (item.itemId and item.itemId:lower():find(query, 1, true))

        if matchCat and matchTrader and matchQuery then
            table.insert(filtered, item)
        end
    end

    statsLabel.Text = string.format("Items: %d", #filtered)

    for i, item in ipairs(filtered) do
        local col = (i % 2 == 1) and ShopLeft or ShopRight
        CreateItemCard(col, item, i)
    end
end

